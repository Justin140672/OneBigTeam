@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<div class="app-shell">

    <SfSidebar Width="280px"
               DockSize="64px"
               EnableDock="true"
               Type="SidebarType.Push"
               Target=".main-content"
               @bind-IsOpen="SidebarOpen"
               CssClass="app-sidebar">

        <ChildContent>
            <div class="sidebar-header">
                <button class="sidebar-toggle" @onclick="ToggleSidebar">
                    ☰
                </button>

                @if (SidebarOpen)
                {
                    <span class="app-title">One Big Team</span>
                }
            </div>

            <SfMenu TValue="MenuItem" Orientation="Orientation.Vertical">
                <MenuItems>
                    <MenuItem Text = "Dashboard" IconCss = "e-icons e-home" Url = "/" />
                    <MenuItem Text="People" IconCss="e-icons e-people">
                        <MenuItems>
                            <MenuItem Text="Employees" Url="@MenuItems["Employees"]"/>
                            <MenuItem Text="Departments" Url="@MenuItems["Departments"]"/>
                        </MenuItems>
                    </MenuItem>
                </MenuItems>
            </SfMenu>

        </ChildContent>

    </SfSidebar>

    <main class="main-content">
        <div class="top-bar">
            <button class="mobile-menu-button" @onclick="ToggleSidebar">
                ☰
            </button>
            <span class="page-title">Dashboard</span>
            <div class="top-bar-actions">
                <button class="theme-toggle" @onclick="ToggleTheme" title="@(IsDark ? "Switch to light mode" : "Switch to dark mode")">
                    @if (IsDark)
                    {
                        <span class="e-icons e-brightness"></span>
                    }
                    else
                    {
                        <span class="e-icons e-contrast"></span>
                    }
                </button>
            </div>
        </div>

        <section class="content-area">
            @Body
        </section>
    </main>

</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

    
@code {
    private bool SidebarOpen { get; set; } = true;
    private bool IsDark { get; set; }

    private void ToggleTheme()
    {
        IsDark = !IsDark;
        JS.InvokeAsync<object>("setTheme", IsDark);
    }

