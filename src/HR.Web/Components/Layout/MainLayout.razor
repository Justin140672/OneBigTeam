@inherits LayoutComponentBase
@implements IDisposable
@using HR.Web.Components.Pages.Tasks
@using HR.SharedKernel.Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject AppSession Session
@inject NotificationService NotificationService
@inject DevAuthService DevAuth
@inject HR.Web.Services.AuthHandoffStore HandoffStore
@inject IWebHostEnvironment Env

@if (Session.LayoutMode == MainLayoutMode.Loading)
{
    <div class="app-loading">
        <div class="app-loading-spinner">
            <div class="spinner-border text-primary" role="status"></div>
            <span class="app-loading-label">Loading…</span>
        </div>
    </div>
}
else if (Session.LayoutMode == MainLayoutMode.CompleteProfile)
{
    <EmployeeCompletionDialog OnCompleted="@(() => StateHasChanged())" />
}
else
{

    <div class="app-shell" data-nav-mode="@_nav.ModeName" data-nav-open="@(_nav.IsOpen ? "true" : "false")">

        @if (ShowSidebar)
        {
            <SfSidebar @key="_nav.UsesDrawer"
                       ID="app-sidebar"
                       Width="280px"
                       Type="@(_nav.UsesDrawer ? SidebarType.Over : SidebarType.Push)"
                       ShowBackdrop="@_nav.UsesDrawer"
                       CloseOnDocumentClick="@_nav.UsesDrawer"
                       @bind-IsOpen="SidebarOpen"
                       CssClass="app-sidebar">

                <ChildContent>
                    <div @onkeydown="OnSidebarKeyDown">
                    <div class="sidebar-header">
                        <button class="sidebar-toggle" @onclick="ToggleSidebar" aria-label="@(_nav.UsesDrawer ? "Close navigation" : "Collapse navigation")" aria-expanded="true" aria-controls="app-sidebar">
                            <i class="fa-solid fa-bars" aria-hidden="true"></i>
                        </button>
                        @if (SidebarOpen)
                        {
                            <img src="/images/logo.png" alt="One Big Team" class="sidebar-logo" />
                        }
                        else
                        {
                            <img src="/images/logo-icon.png" alt="One Big Team" class="sidebar-logo-icon" />
                        }
                    </div>

                    <SfMenu TValue="MenuItem"
                            Orientation="Syncfusion.Blazor.Navigations.Orientation.Vertical"
                            CssClass="app-nav-menu"
                            ShowItemOnClick="true">
                        <MenuItems>
                            @if (Session.ShowGettingStarted && (Session.IsHrAdministrator || Session.CanViewOnboarding))
                            {
                                <MenuItem Text="Getting Started" IconCss="fa-solid fa-list-check" Url="/getting-started" />
                            }
                            @if (Session.IsHrAdministrator)
                            {
                                <MenuItem Text="HR Dashboard" IconCss="fa-solid fa-house" Url="/dashboard/hr" />
                            }
                            @if (Session.IsManager)
                            {
                                <MenuItem Text="My Team" IconCss="fa-solid fa-gauge" Url="/dashboard/manager" />
                            }
                            @if (Session.CanManageRecruitment)
                            {
                                <MenuItem Text="Dashboard" IconCss="fa-solid fa-chart-line" Url="/dashboard/recruitment" />
                                <MenuItem Text="Vacancies" IconCss="fa-solid fa-briefcase" Url="@_menuItems["Vacancies"]" />
                                <MenuItem Text="Candidates" IconCss="fa-solid fa-user-tie" Url="@_menuItems["Candidates"]" />
                                <MenuItem Text="Recruiters" IconCss="fa-solid fa-people-arrows" Url="@_menuItems["ExternalRecruiters"]" />
                                <MenuItem Text="Recruitment Stages" IconCss="fa-solid fa-gear" Url="@_menuItems["RecruitmentStages"]" />
                                @if (IsRecruiterOnly && Session.CanViewReporting)
                                {
                                    <MenuItem Text="Reports" IconCss="fa-solid fa-chart-column" Url="@_menuItems["Reporting"]" />
                                }
                            }
                            @if (!IsRecruiterOnly)
                            {
                                @foreach (var section in _adminSections)
                                {
                                    @if (section.Group is AdminNavGroup.CompanyAdministration or AdminNavGroup.Reports)
                                    {
                                        @* Company administration never holds more than a couple of destinations
                                           (Company Profile & Addresses, Subscription & Billing) — for a Company
                                           Administrator this fly-out was one of only three destinations in the
                                           entire app, so nesting it added a click for no organisational benefit.
                                           Rendered as direct top-level items for every role that sees this
                                           section instead of wrapping it in a single-purpose fly-out. *@
                                        @foreach (var dest in section.Destinations)
                                        {
                                            <MenuItem Text="@dest.Title" IconCss="@dest.IconCss" Url="@dest.Url" />
                                        }
                                    }
                                    else
                                    {
                                        <MenuItem Text="@section.Label" IconCss="@SectionIcon(section.Group)">
                                            <MenuItems>
                                                @foreach (var dest in section.Destinations)
                                                {
                                                    <MenuItem Text="@dest.Title" IconCss="@dest.IconCss" Url="@dest.Url" />
                                                }
                                            </MenuItems>
                                        </MenuItem>
                                    }
                                }
                            }
                            @if (_navReady && (Session.IsHrAdministrator || Session.CanManageSupport))
                            {
                                <MenuItem Text="Support Requests" IconCss="fa-solid fa-headset" Url="@_menuItems["SupportQueue"]" />
                            }
                        </MenuItems>
                    </SfMenu>
                    </div>

                </ChildContent>

            </SfSidebar>
        }

        <main class="main-content">
            <SupportSessionBanner />
            <div class="top-bar">
                @if (ShowSidebar && !SidebarOpen)
                {
                    <button id="nav-open-button" class="mobile-menu-button" @onclick="ToggleSidebar" aria-label="Open navigation" aria-expanded="false" aria-controls="app-sidebar">
                        <i class="fa-solid fa-bars" aria-hidden="true"></i>
                    </button>
                }
                <span class="page-title">@CurrentPageTitle</span>
                <div class="top-bar-actions">
                    <AdminQuickNav />
                    <button class="theme-toggle" @onclick="ToggleTheme" title="@(IsDark ? "Switch to light mode" : "Switch to dark mode")" aria-label="@(IsDark ? "Switch to light mode" : "Switch to dark mode")">
                        @if (IsDark)
                        {
                            <i class="fa-solid fa-sun" aria-hidden="true"></i>
                        }
                        else
                        {
                            <i class="fa-solid fa-moon" aria-hidden="true"></i>
                        }
                    </button>
                    @if (Session.IsLoaded && Session.EmployeeId.HasValue && (Session.IsHrAdministrator || Session.CanViewOnboarding || Session.CanManageSupport))
                    {
                        <div class="help-menu @(_helpOpen ? "help-open" : "")">
                            <button class="help-btn" @onclick="ToggleHelp" title="Help" aria-label="Help" aria-haspopup="true" aria-expanded="@_helpOpen">
                                <i class="fa-solid fa-circle-question" aria-hidden="true"></i>
                            </button>
                            @if (_helpOpen)
                            {
                                <div class="help-dropdown">
                                    @if (Session.IsHrAdministrator || Session.CanViewOnboarding)
                                    {
                                        <a class="help-item" href="/getting-started" @onclick="CloseHelp">
                                            <i class="fa-solid fa-list-check me-2"></i>Getting Started
                                        </a>
                                    }
                                    @if (Session.IsHrAdministrator || Session.CanManageSupport)
                                    {
                                        <a class="help-item" href="/companies/@Session.CompanyId/support" @onclick="CloseHelp">
                                            <i class="fa-solid fa-life-ring me-2"></i>Help &amp; Feedback
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @if (Session.IsLoaded && Session.EmployeeId.HasValue)
                    {
                        <div class="notif-bell @(_notifOpen ? "notif-open" : "")" @onmouseenter="CancelNotifAutoClose" @onmouseleave="ScheduleNotifAutoClose">
                            <button class="notif-btn" @onclick="ToggleNotifications" title="Notifications" aria-label="@(_unreadCount > 0 ? $"Notifications, {_unreadCount} unread" : "Notifications")" aria-haspopup="true" aria-expanded="@_notifOpen">
                                <i class="fa-solid fa-bell" aria-hidden="true"></i>
                                @if (_unreadCount > 0)
                                {
                                    <span class="notif-badge">@(_unreadCount > 99 ? "99+" : _unreadCount.ToString())</span>
                                }
                            </button>
                            @if (_notifOpen)
                            {
                                <div class="notif-dropdown">
                                    <div class="notif-header">
                                        <span class="notif-header-title">Notifications</span>
                                        @if (_unreadCount > 0)
                                        {
                                            <button class="notif-mark-all" @onclick="MarkAllRead">Mark all read</button>
                                        }
                                    </div>
                                    <div class="notif-list">
                                        @if (_notifLoading)
                                        {
                                            <div class="notif-loading">Loading…</div>
                                        }
                                        else if (_notifError is not null && _notifications.Count == 0)
                                        {
                                            <div class="notif-empty" role="alert" data-testid="notif-error">
                                                @_notifError.Message
                                                @if (_notifError.IsRetryable)
                                                {
                                                    <button class="notif-load-more" @onclick="LoadNotificationsAsync" data-testid="notif-retry">Try again</button>
                                                }
                                            </div>
                                        }
                                        else if (_notifications.Count == 0)
                                        {
                                            <div class="notif-empty">No notifications</div>
                                        }
                                        else
                                        {
                                            @foreach (var n in _notifications)
                                            {
                                                var notif = n;
                                                var (typeIcon, typeLabel, typeCss) = NotifTypeInfo(notif.Type);
                                                var hasAction = !string.IsNullOrEmpty(notif.ActionUrl);
                                                <div class="notif-item @(notif.IsRead ? "" : "notif-unread") notif-type--@notif.Type.ToLowerInvariant()"
                                                     role="button"
                                                     tabindex="0"
                                                     aria-label="@($"{NotifTypeInfo(notif.Type).Label}: {notif.Title}{(hasAction ? "" : " (no further detail available)")}")"
                                                     title="@(hasAction ? null : "No further detail available")"
                                                     @onclick="() => OnNotificationClick(notif)"
                                                     @onkeydown="e => OnNotificationKeyDown(e, notif)">
                                                    <div class="notif-item-header">
                                                        <i class="@typeIcon notif-type-icon"></i>
                                                        <span class="notif-type-label @typeCss">@typeLabel</span>
                                                        <span class="notif-item-time ms-auto">@FormatTime(notif.CreatedAt)</span>
                                                    </div>
                                                    <div class="notif-item-title">@notif.Title</div>
                                                    @if (notif.Body is not null)
                                                    {
                                                        <div class="notif-item-body">@notif.Body</div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                    @if (_notifError is not null && _notifications.Count > 0)
                                    {
                                        <div class="notif-empty" role="alert" data-testid="notif-error">@_notifError.Message</div>
                                    }
                                    @if (_notifications.Count > 0 && _notifHasMore)
                                    {
                                        <div class="notif-footer">
                                            <button class="notif-load-more" disabled="@_notifLoadingMore" @onclick="LoadMoreNotificationsAsync">
                                                @(_notifLoadingMore ? "Loading…" : "Load more")
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @if (Session.IsLoaded && Session.EmployeeId.HasValue)
                    {
                        <a href="/companies/@Session.CompanyId/employees/@Session.EmployeeId/profile" class="top-bar-user">
                            @if (Session.ProfileImageUrl is not null)
                            {
                                <img src="@Session.ProfileImageUrl" alt="" class="top-bar-avatar" />
                            }
                            else
                            {
                                <span class="top-bar-avatar top-bar-avatar--initials">@Session.Initials</span>
                            }
                            <span class="top-bar-user-info">
                                @Session.DisplayName
                                @if (Session.JobTitle is not null)
                                {
                                    <span class="top-bar-job-title">@Session.JobTitle</span>
                                }
                            </span>
                        </a>
                    }
                    @if (Session.IsLoaded)
                    {
                        <button type="button" class="topbar-logout" @onclick="LogoutAsync" title="Log out" aria-label="Log out" data-testid="topbar-logout">
                            <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
                        </button>
                    }
                    @if (Env.IsDevelopment())
                    {
                        <div class="dev-persona-switcher">
                            <label for="dev-persona-select" class="visually-hidden">Switch user</label>
                            <SfDropDownList TValue="string?" TItem="PersonaOption"
                                            CssClass="dev-persona-select"
                                            HtmlAttributes="@(new Dictionary<string, object> { ["id"] = "dev-persona-select", ["aria-label"] = "Switch user" })"
                                            DataSource="@_personaOptions"
                                            Placeholder="Switch user…"
                                            ValueChanged="OnPersonaSwitchAsync">
                                <DropDownListFieldSettings Value="UserId" Text="DisplayName" />
                            </SfDropDownList>
                        </div>
                    }
                </div>
            </div>

            <SubscriptionStatusAlert />

            <section class="content-area">
                <ErrorBoundary @ref="_errorBoundary">
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent Context="ex">
                        @{ RecordClientError(ex); }
                        <div class="container py-4">
                            <div class="alert alert-danger d-flex align-items-start gap-3">
                                <i class="fa-solid fa-triangle-exclamation fa-lg mt-1"></i>
                                <div>
                                    <h5 class="mb-1">Something went wrong</h5>
                                    <p class="mb-2">An unexpected error occurred. You can try refreshing the page or navigating away.</p>
                                    <SfButton CssClass="e-small me-2" OnClick="@(() => NavigationManager.NavigateTo(".", forceLoad: true))">Refresh</SfButton>
                                    @ex
                                    <SfButton CssClass="e-small" OnClick="ClearError">Try again</SfButton>
                                </div>
                            </div>
                        </div>
                    </ErrorContent>
                </ErrorBoundary>
            </section>
        </main>

    </div>

    @if (Session.IsLoaded && Session.EmployeeId.HasValue)
    {
        <TaskViewDialog CompanyId="Session.CompanyId"
                        TaskId="_selectedTaskId"
                        IsOpen="_taskDialogOpen"
                        OnClosed="CloseTaskDialogAsync" />
    }

}

@code {
    private ErrorBoundary? _errorBoundary;

    private readonly ShellNavState _nav = new();
    private DotNetObjectReference<MainLayout>? _shellRef;
    private string? _pendingFocusSelector;

    private bool SidebarOpen
    {
        get => _nav.IsOpen;
        set
        {
            if (value == _nav.IsOpen)
                return;

            _nav.SetOpen(value);
            _ = PersistPreferenceAsync();
        }
    }
    private bool IsDark { get; set; }

    private bool ShowSidebar => Session.IsHrAdministrator || Session.IsRecruiter || Session.CanManageCompany;

    private bool IsRecruiterOnly =>
        Session.IsRecruiter && !Session.IsHrAdministrator && !Session.IsManager
        && !Session.CanManageCompany;

    private int _unreadCount;
    private List<NotificationDto> _notifications = [];
    private bool _notifOpen;
    private bool _notifLoading;
    private bool _helpOpen;

    private Guid? _selectedTaskId;
    private bool _taskDialogOpen;

    private static readonly HashSet<string> TaskBackedNotificationTypes =
    [
        "TaskAssigned", "TaskDueSoon", "TaskOverdue", "TaskCompleted", "TaskDateChanged",
    ];

    private const int NotifPageSize = 20;
    private int _notifPageNumber = 1;
    private bool _notifHasMore;
    private bool _notifLoadingMore;
    private ApiFailurePresentation? _notifError;

    private IReadOnlyList<DevPersonaDto> _personas = [];
    private List<PersonaOption> _personaOptions = [];

    private sealed record PersonaOption(string UserId, string DisplayName);

    private IReadOnlyList<AdminNavSection> _adminSections = [];
    private bool _navReady;

    private static string SectionIcon(AdminNavGroup group) => group switch
    {
        AdminNavGroup.PeopleAndUsers => "fa-solid fa-users",
        AdminNavGroup.CompanyAdministration => "fa-solid fa-building",
        AdminNavGroup.HrConfiguration => "fa-solid fa-sliders",
        AdminNavGroup.Reports => "fa-solid fa-chart-column",
        AdminNavGroup.PlatformOperations => "fa-solid fa-server",
        _ => "fa-solid fa-gears",
    };

    private readonly Dictionary<string, string> _menuItems = new()
    {
        ["Employees"] = "/",
        ["Departments"] = "/",
        ["LocationTypes"] = "/",
        ["Locations"] = "/",
        ["PositionProfiles"] = "/",
        ["OnboardingTemplates"] = "/",
        ["EmploymentTypes"] = "/",
        ["Assets"] = "/",
        ["AssetCategories"] = "/",
        ["LeaveTypes"] = "/",
        ["LeavePolicies"] = "/",
        ["PublicHolidays"] = "/",
        ["DocumentTypes"] = "/",
        ["SharedDocuments"] = "/",
        ["DataImport"] = "/",
        ["SicknessCategories"] = "/",
        ["OrganisationChart"] = "/",
        ["Vacancies"] = "/",
        ["Candidates"] = "/",
        ["ExternalRecruiters"] = "/",
        ["RecruitmentStages"] = "/",
        ["Reporting"] = "/",
        ["HrSettings"] = "/",
        ["UserAdministration"] = "/",
        ["SupportQueue"] = "/",
    };

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;

        Session.Changed += OnSessionChanged;

        await Session.InitialiseAsync();

        var companyId = Session.CompanyId;
        _adminSections = AdminNavigation.Sections(AdminNavCapabilities.From(Session), companyId);
        _navReady = true;
        _menuItems["Employees"] = $"/companies/{companyId}/employees";
        _menuItems["Departments"] = $"/companies/{companyId}/departments";
        _menuItems["LocationTypes"] = $"/companies/{companyId}/location-types";
        _menuItems["Locations"] = $"/companies/{companyId}/locations";
        _menuItems["PositionProfiles"] = $"/companies/{companyId}/position-profiles";
        _menuItems["OnboardingTemplates"] = $"/companies/{companyId}/onboarding-templates";
        _menuItems["EmploymentTypes"] = $"/companies/{companyId}/employment-types";
        _menuItems["Assets"] = $"/companies/{companyId}/assets";
        _menuItems["AssetCategories"] = $"/companies/{companyId}/asset-categories";
        _menuItems["LeaveTypes"] = $"/companies/{companyId}/leave-types";
        _menuItems["LeavePolicies"] = $"/companies/{companyId}/leave-policies";
        _menuItems["PublicHolidays"] = $"/companies/{companyId}/public-holidays";
        _menuItems["DocumentTypes"] = $"/companies/{companyId}/document-types";
        _menuItems["SharedDocuments"] = $"/companies/{companyId}/shared-documents";
        _menuItems["DataImport"] = $"/companies/{companyId}/data-import/employees";
        _menuItems["SicknessCategories"] = $"/companies/{companyId}/sickness-categories";
        _menuItems["OrganisationChart"] = $"/companies/{companyId}/organisation-chart";
        _menuItems["Vacancies"] = $"/companies/{companyId}/vacancies";
        _menuItems["Candidates"] = $"/companies/{companyId}/candidates";
        _menuItems["ExternalRecruiters"] = $"/companies/{companyId}/external-recruiters";
        _menuItems["RecruitmentStages"] = $"/companies/{companyId}/recruitment-stages";
        _menuItems["Reporting"] = $"/companies/{companyId}/reporting";
        _menuItems["HrSettings"] = $"/companies/{companyId}/hr-settings";
        _menuItems["UserAdministration"] = $"/companies/{companyId}/user-administration";
        _menuItems["SupportQueue"] = $"/companies/{companyId}/support/admin/queue";

        await LoadUnreadCountAsync();

        if (Env.IsDevelopment())
        {
            try
            {
                _personas = await DevAuth.GetPersonasAsync();
                _personaOptions = _personas.Select(p => new PersonaOption(p.UserId, $"{p.Name} ({p.JobTitle})")).ToList();
            }
            catch
            {
            }
        }
    }

    private async Task LoadUnreadCountAsync()
    {
        if (!Session.EmployeeId.HasValue) return;

        // The badge is a passive, polled indicator: a failed fetch keeps the last known count rather than
        // showing a misleading "0" or interrupting the user (the service already logs operational failures).
        // Cancellation (circuit teardown) propagates.
        var result = await NotificationService.GetUnreadCountAsync(Session.CompanyId);
        if (result.Success)
            _unreadCount = result.Value;
    }

    private async Task LoadNotificationsAsync()
    {
        if (!Session.EmployeeId.HasValue) return;
        _notifPageNumber = 1;
        _notifLoading = true;
        try
        {
            var result = await NotificationService.GetAsync(Session.CompanyId, _notifPageNumber, NotifPageSize);
            if (!result.Success || result.Value is null)
            {
                _notifError = ApiFailurePresenter.Present(
                    result.Success ? ApiResult<NotificationsResponse>.Fail(ApiFailureKind.InvalidResponse, null) : result,
                    "load your notifications");
                return;
            }

            _notifError = null;
            _unreadCount = result.Value.UnreadCount;
            _notifications = result.Value.Items;
            _notifHasMore = result.Value.PageNumber < result.Value.TotalPages;
        }
        finally
        {
            _notifLoading = false;
        }
    }

    private async Task LoadMoreNotificationsAsync()
    {
        if (!Session.EmployeeId.HasValue || _notifLoadingMore || !_notifHasMore) return;

        _notifLoadingMore = true;
        try
        {
            var nextPage = _notifPageNumber + 1;
            var result = await NotificationService.GetAsync(Session.CompanyId, nextPage, NotifPageSize);
            if (!result.Success || result.Value is null)
            {
                _notifError = ApiFailurePresenter.Present(
                    result.Success ? ApiResult<NotificationsResponse>.Fail(ApiFailureKind.InvalidResponse, null) : result,
                    "load more notifications");
                return;
            }

            _notifError = null;
            _notifPageNumber = nextPage;
            _unreadCount = result.Value.UnreadCount;
            _notifications.AddRange(result.Value.Items);
            _notifHasMore = result.Value.PageNumber < result.Value.TotalPages;
        }
        finally
        {
            _notifLoadingMore = false;
        }
    }

    private async Task ToggleNotifications()
    {
        _notifCloseCts?.Cancel();
        _notifOpen = !_notifOpen;
        if (_notifOpen)
            await LoadNotificationsAsync();
    }

    private CancellationTokenSource? _notifCloseCts;

    private void ScheduleNotifAutoClose()
    {
        if (!_notifOpen) return;

        _notifCloseCts?.Cancel();
        var cts = new CancellationTokenSource();
        _notifCloseCts = cts;

        _ = CloseNotifAfterDelayAsync(cts.Token);
    }

    private async Task CloseNotifAfterDelayAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(500, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (token.IsCancellationRequested) return;

        _notifOpen = false;
        await InvokeAsync(StateHasChanged);
    }

    private void CancelNotifAutoClose() => _notifCloseCts?.Cancel();

    private void ToggleHelp() => _helpOpen = !_helpOpen;

    private void CloseHelp() => _helpOpen = false;

    private async Task OnNotificationKeyDown(KeyboardEventArgs e, NotificationDto notification)
    {
        if (e.Key is "Enter" or " ")
            await OnNotificationClick(notification);
    }

    private async Task OnNotificationClick(NotificationDto notification)
    {
        _notifOpen = false;
        if (!notification.IsRead)
        {
            var markResult = await NotificationService.MarkReadAsync(Session.CompanyId, notification.Id);
            if (markResult.Success)
            {
                _notifError = null;
                _unreadCount = Math.Max(0, _unreadCount - 1);
                var idx = _notifications.IndexOf(notification);
                if (idx >= 0)
                    _notifications[idx] = notification with { IsRead = true };
            }
            else
            {
                // Do not pretend it was marked read: leave it unread and keep the panel open with the
                // reason. The user can still reach the linked item below.
                _notifError = ApiFailurePresenter.Present(markResult, "mark this notification as read");
                _notifOpen = true;
            }
        }

        if (TaskBackedNotificationTypes.Contains(notification.Type))
        {
            _selectedTaskId = notification.SourceEntityId;
            _taskDialogOpen = true;
            return;
        }

        if (!string.IsNullOrEmpty(notification.ActionUrl))
        {
            NavigationManager.NavigateTo(notification.ActionUrl);
        }
    }

    private Task CloseTaskDialogAsync()
    {
        _taskDialogOpen = false;
        return Task.CompletedTask;
    }

    private async Task MarkAllRead()
    {
        if (!Session.EmployeeId.HasValue) return;
        var markAllResult = await NotificationService.MarkAllReadAsync(Session.CompanyId, Session.EmployeeId.Value);
        if (!markAllResult.Success)
        {
            _notifError = ApiFailurePresenter.Present(markAllResult, "mark your notifications as read");
            return;
        }

        _notifError = null;
        _unreadCount = 0;
        _notifications = _notifications.Select(n => n with { IsRead = true }).ToList();
    }

    private static (string Icon, string Label, string Css) NotifTypeInfo(string type) => type switch
    {
        "TaskDueSoon" => ("fa-solid fa-clock", "Due Soon", "notif-type-label--due-soon"),
        "TaskOverdue" => ("fa-solid fa-triangle-exclamation", "Overdue", "notif-type-label--overdue"),
        _ => ("fa-solid fa-bell", "Assigned", "notif-type-label--assigned"),
    };

    private static string FormatTime(DateTimeOffset dt)
    {
        var diff = DateTimeOffset.UtcNow - dt;
        if (diff.TotalMinutes < 1) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return dt.ToString("d MMM");
    }

    private void ClearError() => _errorBoundary?.Recover();

    // Feeds the same client-error buffer the Help & Feedback "include diagnostics" submission
    // reads from (see getRecentClientErrors in app.js), so a staff-visible crash the user hit
    // just before filing a ticket shows up without them having to describe it. Fire-and-forget:
    // this renders inside ErrorContent, so it must not throw or await.
    private void RecordClientError(Exception ex) =>
        _ = JS.InvokeVoidAsync("pushClientError", $"{ex.GetType().Name}: {ex.Message}");

    protected override void OnParametersSet() => _errorBoundary?.Recover();

    private void ToggleSidebar()
    {
        var wasOpen = _nav.IsOpen;
        SidebarOpen = !wasOpen;
        _pendingFocusSelector = wasOpen ? "#nav-open-button" : "#app-sidebar .sidebar-toggle";
    }

    private void OnSidebarKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && _nav.UsesDrawer && _nav.IsOpen)
        {
            SidebarOpen = false;
            _pendingFocusSelector = "#nav-open-button";
        }
    }

    private async Task PersistPreferenceAsync()
    {
        if (!_nav.IsWide)
            return;

        try
        {
            await JS.InvokeVoidAsync("hrShell.setExpandedPreference", _nav.PreferenceExpanded);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    [JSInvokable]
    public async Task OnShellModeChanged(string mode)
    {
        if (!Enum.TryParse<ShellLayoutMode>(mode, out var parsed))
            return;

        if (_nav.SetMode(parsed))
            await InvokeAsync(StateHasChanged);
    }

    private async Task LogoutAsync() => await JS.InvokeVoidAsync("hardNavigate", "/logout");

    private async Task OnPersonaSwitchAsync(string? userId)
    {
        if (string.IsNullOrEmpty(userId)) return;
        var session = await DevAuth.SwitchAsync(userId);
        if (session is null) return;

        var code = HandoffStore.Issue(new HR.Web.Services.AuthHandoffStore.Session(
            session.AccessToken, session.RefreshToken, session.ExpiresIn));
        await JS.InvokeVoidAsync("hardNavigate", $"/dev/persona-cookie?code={Uri.EscapeDataString(code)}");
    }

    private bool _themeSynced;
    private bool _sidebarSynced;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_sidebarSynced)
        {
            try
            {
                _shellRef ??= DotNetObjectReference.Create(this);
                var preference = await JS.InvokeAsync<bool>("hrShell.getExpandedPreference");
                var mode = await JS.InvokeAsync<string>("hrShell.init", _shellRef, ShellBreakpoints.WideQuery, ShellBreakpoints.CompactQuery);
                _sidebarSynced = true;

                _nav.RestorePreference(preference);
                _nav.SetMode(Enum.Parse<ShellLayoutMode>(mode));
                StateHasChanged();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
            }
            catch (Exception)
            {
                _sidebarSynced = true;
                _nav.SetMode(ShellLayoutMode.Wide);
            }
        }

        if (_pendingFocusSelector is not null)
        {
            var selector = _pendingFocusSelector;
            _pendingFocusSelector = null;
            try
            {
                await JS.InvokeVoidAsync("hrShell.focus", selector);
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (_themeSynced)
            return;

        try
        {
            var stored = await JS.InvokeAsync<string>("getTheme");
            _themeSynced = true;

            if (stored == "dark" != IsDark)
            {
                IsDark = stored == "dark";
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task ToggleTheme()
    {
        IsDark = !IsDark;
        await JS.InvokeVoidAsync("setTheme", IsDark);
    }

    private string CurrentPageTitle => PageTitleResolver.Resolve(NavigationManager.Uri);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(async () =>
        {
            _nav.CloseDrawer();
            StateHasChanged();
            try
            {
                await JS.InvokeVoidAsync("hrShell.resetHorizontalScroll");
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
            }
        });

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _shellRef?.Dispose();
        try
        {
            _ = JS.InvokeVoidAsync("hrShell.dispose").AsTask().ContinueWith(_ => { }, TaskScheduler.Default);
        }
        catch (InvalidOperationException)
        {
        }
        NavigationManager.LocationChanged -= OnLocationChanged;
        Session.Changed -= OnSessionChanged;
    }
}
