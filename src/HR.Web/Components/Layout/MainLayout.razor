@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject AppSession Session

<div class="app-shell">

    <SfSidebar Width="280px"
               Type="SidebarType.Push"
               @bind-IsOpen="SidebarOpen"
               CssClass="app-sidebar">

        <ChildContent>
            <div class="sidebar-header">
                <button class="sidebar-toggle" @onclick="ToggleSidebar">
                    ☰
                </button>
                @if (SidebarOpen)
                {
                    <span class="app-title">One Big Team</span>
                }
            </div>

            <SfMenu TValue="MenuItem"
                    Orientation="Orientation.Vertical"
                    CssClass="app-nav-menu"
                    ShowItemOnClick="true">
                <MenuItems>
                    <MenuItem Text="Dashboard" IconCss="e-icons e-home" Url="/" />
                    <MenuItem Text="People" IconCss="e-icons e-people">
                        <MenuItems>
                            <MenuItem Text="Employees"         Url="@_menuItems["Employees"]" />
                            <MenuItem Text="Departments"       Url="@_menuItems["Departments"]" />
                            <MenuItem Text="Position Profiles" Url="@_menuItems["PositionProfiles"]" />
                        </MenuItems>
                    </MenuItem>
                    <MenuItem Text="Leave" IconCss="e-icons e-calendar">
                        <MenuItems>
                            <MenuItem Text="Public Holidays" Url="@_menuItems["PublicHolidays"]" />
                        </MenuItems>
                    </MenuItem>
                </MenuItems>
            </SfMenu>

        </ChildContent>

    </SfSidebar>

    <main class="main-content">
        <div class="top-bar">
            <button class="mobile-menu-button" @onclick="ToggleSidebar">
                ☰
            </button>
            <span class="page-title">Dashboard</span>
            <div class="top-bar-actions">
                @if (Session.IsLoaded && Session.EmployeeId.HasValue)
                {
                    <a href="@_menuItems["MyProfile"]" class="top-bar-user">
                        @if (Session.ProfileImageUrl is not null)
                        {
                            <img src="@Session.ProfileImageUrl" alt="@Session.DisplayName" class="top-bar-avatar" />
                        }
                        else
                        {
                            <span class="top-bar-avatar top-bar-avatar--initials">@Session.Initials</span>
                        }
                        <span class="top-bar-user-info">
                            @Session.DisplayName
                            @if (Session.JobTitle is not null)
                            {
                                <span class="top-bar-job-title">@Session.JobTitle</span>
                            }
                        </span>
                    </a>
                }
                <button class="theme-toggle" @onclick="ToggleTheme" title="@(IsDark ? "Switch to light mode" : "Switch to dark mode")">
                    @if (IsDark)
                    {
                        <span class="e-icons e-brightness"></span>
                    }
                    else
                    {
                        <span class="e-icons e-contrast"></span>
                    }
                </button>
            </div>
        </div>

        <section class="content-area">
            @Body
        </section>
    </main>

</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool SidebarOpen { get; set; } = true;
    private bool IsDark { get; set; }

    private readonly Dictionary<string, string> _menuItems = new()
    {
        ["Employees"]        = "/",
        ["Departments"]      = "/",
        ["PositionProfiles"] = "/",
        ["PublicHolidays"]   = "/",
        ["MyProfile"]        = "/",
    };

    protected override async Task OnInitializedAsync()
    {
        await Session.InitialiseAsync();

        var companyId = Session.CompanyId;
        _menuItems["Employees"]        = $"/companies/{companyId}/employees";
        _menuItems["Departments"]      = $"/companies/{companyId}/departments";
        _menuItems["PositionProfiles"] = $"/companies/{companyId}/position-profiles";
        _menuItems["PublicHolidays"]   = $"/companies/{companyId}/public-holidays";
        _menuItems["MyProfile"]        = Session.EmployeeId.HasValue
            ? $"/companies/{companyId}/employees/{Session.EmployeeId}/profile"
            : "/";
    }

    private void ToggleSidebar() => SidebarOpen = !SidebarOpen;

    private void ToggleTheme()
    {
        IsDark = !IsDark;
        JS.InvokeAsync<object>("setTheme", IsDark);
    }
}
