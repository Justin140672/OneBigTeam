    private void ToggleSidebar()
    {
        SidebarOpen = !SidebarOpen;
    }

    private void OnMenuItemSelected(MenuEventArgs<MenuItemModel> args)
    {
        var url = args.Item.Url;

        if (!string.IsNullOrWhiteSpace(url))
        {
            NavigationManager.NavigateTo(url);
        }
