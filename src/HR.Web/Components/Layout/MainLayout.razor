@inherits LayoutComponentBase
@implements IDisposable
@using HR.Web.Components.Pages.Tasks
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject AppSession Session
@inject NotificationService NotificationService
@inject DevAuthService DevAuth
@inject IWebHostEnvironment Env

@if (!Session.IsLoaded)
{
    <div class="app-loading">
        <div class="app-loading-spinner">
            <div class="spinner-border text-primary" role="status"></div>
            <span class="app-loading-label">Loading…</span>
        </div>
    </div>
}
else
{

    <div class="app-shell">

        @if (ShowSidebar)
        {
            <SfSidebar Width="280px"
                       Type="SidebarType.Push"
                       MediaQuery="@("(min-width: 768px)")"
                       @bind-IsOpen="SidebarOpen"
                       CssClass="app-sidebar">

                <ChildContent>
                    <div class="sidebar-header">
                        <button class="sidebar-toggle" @onclick="ToggleSidebar">
                            <i class="fa-solid fa-bars"></i>
                        </button>
                        @if (SidebarOpen)
                        {
                            <img src="/images/one-big-team-logo.png" alt="One Big Team" class="sidebar-logo" />
                        }
                    </div>

                    <SfMenu TValue="MenuItem"
                            Orientation="Syncfusion.Blazor.Navigations.Orientation.Vertical"
                            CssClass="app-nav-menu"
                            ShowItemOnClick="true">
                        <MenuItems>
                            @if (Session.IsHrAdministrator)
                            {
                                <MenuItem Text="Dashboard" IconCss="fa-solid fa-house" Url="/dashboard/hr" />
                            }
                            @if (Session.IsManager)
                            {
                                <MenuItem Text="Manager Dashboard" IconCss="fa-solid fa-gauge" Url="/dashboard/manager" />
                            }
                            @if (Session.IsRecruiter)
                            {
                                <MenuItem Text="Recruitment Dashboard" IconCss="fa-solid fa-chart-line" Url="/dashboard/recruitment" />
                            }
                            @if (Session.CanManageEmployees)
                            {
                                <MenuItem Text="People" IconCss="fa-solid fa-users">
                                    <MenuItems>
                                        <MenuItem Text="Employees" Url="@_menuItems["Employees"]" />
                                        <MenuItem Text="Position Profiles" Url="@_menuItems["PositionProfiles"]" />
                                        <MenuItem Text="Departments" Url="@_menuItems["Departments"]" />
                                        <MenuItem Text="Location Types" Url="@_menuItems["LocationTypes"]" />
                                        <MenuItem Text="Locations" Url="@_menuItems["Locations"]" />
                                        <MenuItem Text="Onboarding Templates" Url="@_menuItems["OnboardingTemplates"]" />
                                        <MenuItem Text="Employment Types" Url="@_menuItems["EmploymentTypes"]" />
                                        <MenuItem Text="Document Types" Url="@_menuItems["DocumentTypes"]" />
                                        <MenuItem Text="Shared Documents" Url="@_menuItems["SharedDocuments"]" />
                                        <MenuItem Text="Data Import" Url="@_menuItems["DataImport"]" />
                                        <MenuItem Text="Import History" Url="@_menuItems["ImportHistory"]" />
                                        <MenuItem Text="Organisation Chart" Url="@_menuItems["OrganisationChart"]" />
                                    </MenuItems>
                                </MenuItem>
                                <MenuItem Text="Assets" IconCss="fa-solid fa-box">
                                    <MenuItems>
                                        <MenuItem Text="Assets" Url="@_menuItems["Assets"]" />
                                        <MenuItem Text="Asset Categories" Url="@_menuItems["AssetCategories"]" />
                                    </MenuItems>
                                </MenuItem>
                                <MenuItem Text="Leave" IconCss="fa-solid fa-calendar-days">
                                    <MenuItems>
                                        <MenuItem Text="Leave Types" Url="@_menuItems["LeaveTypes"]" />
                                        <MenuItem Text="Leave Policies" Url="@_menuItems["LeavePolicies"]" />
                                        <MenuItem Text="Public Holidays" Url="@_menuItems["PublicHolidays"]" />
                                        <MenuItem Text="Sickness Categories" Url="@_menuItems["SicknessCategories"]" />
                                    </MenuItems>
                                </MenuItem>
                            }
                            @if (Session.CanManageCompany)
                            {
                                <MenuItem Text="Company" IconCss="fa-solid fa-building" Url="@_menuItems["Company"]" />
                            }
                            @if (Session.IsHrAdministrator || Session.CanManageCompany)
                            {
                                <MenuItem Text="User Administration" IconCss="fa-solid fa-user-shield" Url="@_menuItems["UserAdministration"]" />
                            }
                        </MenuItems>
                    </SfMenu>

                </ChildContent>

            </SfSidebar>
        }

        <main class="main-content">
            <div class="top-bar">
                @if (ShowSidebar && !SidebarOpen)
                {
                    <button class="mobile-menu-button" @onclick="ToggleSidebar">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                }
                <span class="page-title">@CurrentPageTitle</span>
                <div class="top-bar-actions">
                    <button class="theme-toggle" @onclick="ToggleTheme" title="@(IsDark ? "Switch to light mode" : "Switch to dark mode")">
                        @if (IsDark)
                        {
                            <i class="fa-solid fa-sun"></i>
                        }
                        else
                        {
                            <i class="fa-solid fa-moon"></i>
                        }
                    </button>
                    @if (Session.IsLoaded && Session.EmployeeId.HasValue)
                    {
                        <div class="notif-bell @(_notifOpen ? "notif-open" : "")">
                            <button class="notif-btn" @onclick="ToggleNotifications" title="Notifications">
                                <i class="fa-solid fa-bell"></i>
                                @if (_unreadCount > 0)
                                {
                                    <span class="notif-badge">@(_unreadCount > 99 ? "99+" : _unreadCount.ToString())</span>
                                }
                            </button>
                            @if (_notifOpen)
                            {
                                <div class="notif-dropdown">
                                    <div class="notif-header">
                                        <span class="notif-header-title">Notifications</span>
                                        @if (_unreadCount > 0)
                                        {
                                            <button class="notif-mark-all" @onclick="MarkAllRead">Mark all read</button>
                                        }
                                    </div>
                                    <div class="notif-list">
                                        @if (_notifications.Count == 0)
                                        {
                                            <div class="notif-empty">No notifications</div>
                                        }
                                        else
                                        {
                                            @foreach (var n in _notifications)
                                            {
                                                var notif = n;
                                                var (typeIcon, typeLabel, typeCss) = NotifTypeInfo(notif.Type);
                                                <div class="notif-item @(notif.IsRead ? "" : "notif-unread") notif-type--@notif.Type.ToLowerInvariant()"
                                                     @onclick="() => OnNotificationClick(notif)">
                                                    <div class="notif-item-header">
                                                        <i class="@typeIcon notif-type-icon"></i>
                                                        <span class="notif-type-label @typeCss">@typeLabel</span>
                                                        <span class="notif-item-time ms-auto">@FormatTime(notif.CreatedAt)</span>
                                                    </div>
                                                    <div class="notif-item-title">@notif.Title</div>
                                                    @if (notif.Body is not null)
                                                    {
                                                        <div class="notif-item-body">@notif.Body</div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    @if (Session.IsLoaded && Session.EmployeeId.HasValue)
                    {
                        <a href="/companies/@Session.CompanyId/employees/@Session.EmployeeId/profile" class="top-bar-user">
                            @if (Session.ProfileImageUrl is not null)
                            {
                                <img src="@Session.ProfileImageUrl" alt="@Session.DisplayName" class="top-bar-avatar" />
                            }
                            else
                            {
                                <span class="top-bar-avatar top-bar-avatar--initials">@Session.Initials</span>
                            }
                            <span class="top-bar-user-info">
                                @Session.DisplayName
                                @if (Session.JobTitle is not null)
                                {
                                    <span class="top-bar-job-title">@Session.JobTitle</span>
                                }
                            </span>
                        </a>
                    }
                    @if (Env.IsDevelopment())
                    {
                        <div class="dev-persona-switcher">
                            <select class="form-select form-select-sm dev-persona-select"
                                    @onchange="OnPersonaSwitchAsync"
                                    title="Switch dev persona">
                                <option value="">Switch user…</option>
                                @foreach (var p in _personas)
                                {
                                    <option value="@p.UserId">@p.Name (@p.JobTitle)</option>
                                }
                            </select>
                        </div>
                    }
                </div>
            </div>

            <section class="content-area">
                <ErrorBoundary @ref="_errorBoundary">
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent Context="ex">
                        <div class="container py-4">
                            <div class="alert alert-danger d-flex align-items-start gap-3">
                                <i class="fa-solid fa-triangle-exclamation fa-lg mt-1"></i>
                                <div>
                                    <h5 class="mb-1">Something went wrong</h5>
                                    <p class="mb-2">An unexpected error occurred. You can try refreshing the page or navigating away.</p>
                                    <SfButton CssClass="e-small me-2" OnClick="@(() => NavigationManager.NavigateTo(".", forceLoad: true))">Refresh</SfButton>
                                    @ex
                                    <SfButton CssClass="e-small" OnClick="ClearError">Try again</SfButton>
                                </div>
                            </div>
                        </div>
                    </ErrorContent>
                </ErrorBoundary>
            </section>
        </main>

    </div>

    <TaskViewDialog CompanyId="Session.CompanyId"
                    TaskId="_notifiedTaskId"
                    IsOpen="_taskDialogOpen"
                    OnClosed="@(() => _taskDialogOpen = false)" />

}

@code {
    private ErrorBoundary? _errorBoundary;

    private bool SidebarOpen { get; set; } = true;
    private bool IsDark { get; set; }

    // Shown whenever the signed-in user has a role with actual menu content below — a plain
    // Employee, a plain Manager (whose dashboard IS their home, with no separate admin
    // sections), and a plain Recruiter (whose Recruitment Dashboard is their home, with
    // Vacancies/Candidates reached via buttons on that dashboard instead of the sidebar) all
    // get no sidebar at all, same as pre-dashboards behavior for Employees. Individual menu
    // sections inside the sidebar are independently role-gated so combined roles (e.g. an
    // HR Administrator who is also a Manager or Recruiter) merge without duplicates.
    //
    // A Company Administrator with no other role also gets no sidebar — their whole job is
    // company profile/settings plus User Administration, both reachable directly from the
    // Company Settings page (their landing screen, see AppSession.LandingUrl), so a full nav
    // menu is unnecessary surface area. CanManageCompany is deliberately excluded here; if they
    // also hold a role that grants CanManageEmployees/IsHrAdministrator the sidebar still shows
    // (with the Company/User Administration items already gated in below).
    private bool ShowSidebar =>
        Session.CanManageEmployees || Session.IsHrAdministrator;

    private int _unreadCount;
    private List<NotificationDto> _notifications = [];
    private bool _notifOpen;

    private Guid? _notifiedTaskId;
    private bool _taskDialogOpen;

    private IReadOnlyList<DevPersonaDto> _personas = [];

    private readonly Dictionary<string, string> _menuItems = new()
    {
        ["Employees"] = "/",
        ["Departments"] = "/",
        ["LocationTypes"] = "/",
        ["Locations"] = "/",
        ["PositionProfiles"] = "/",
        ["OnboardingTemplates"] = "/",
        ["EmploymentTypes"] = "/",
        ["Assets"] = "/",
        ["AssetCategories"] = "/",
        ["LeaveTypes"] = "/",
        ["LeavePolicies"] = "/",
        ["PublicHolidays"] = "/",
        ["DocumentTypes"] = "/",
        ["SharedDocuments"] = "/",
        ["DataImport"] = "/",
        ["ImportHistory"] = "/",
        ["SicknessCategories"] = "/",
        ["OrganisationChart"] = "/",
        ["Company"] = "/",
        ["UserAdministration"] = "/",
    };

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;

        await Session.InitialiseAsync();

        var companyId = Session.CompanyId;
        _menuItems["Employees"] = $"/companies/{companyId}/employees";
        _menuItems["Departments"] = $"/companies/{companyId}/departments";
        _menuItems["LocationTypes"] = $"/companies/{companyId}/location-types";
        _menuItems["Locations"] = $"/companies/{companyId}/locations";
        _menuItems["PositionProfiles"] = $"/companies/{companyId}/position-profiles";
        _menuItems["OnboardingTemplates"] = $"/companies/{companyId}/onboarding-templates";
        _menuItems["EmploymentTypes"] = $"/companies/{companyId}/employment-types";
        _menuItems["Assets"] = $"/companies/{companyId}/assets";
        _menuItems["AssetCategories"] = $"/companies/{companyId}/asset-categories";
        _menuItems["LeaveTypes"] = $"/companies/{companyId}/leave-types";
        _menuItems["LeavePolicies"] = $"/companies/{companyId}/leave-policies";
        _menuItems["PublicHolidays"] = $"/companies/{companyId}/public-holidays";
        _menuItems["DocumentTypes"] = $"/companies/{companyId}/document-types";
        _menuItems["SharedDocuments"] = $"/companies/{companyId}/shared-documents";
        _menuItems["DataImport"] = $"/companies/{companyId}/data-import/employees";
        _menuItems["ImportHistory"] = $"/companies/{companyId}/data-import/history";
        _menuItems["SicknessCategories"] = $"/companies/{companyId}/sickness-categories";
        _menuItems["OrganisationChart"] = $"/companies/{companyId}/organisation-chart";
        _menuItems["Company"] = $"/companies/{companyId}/edit";
        _menuItems["UserAdministration"] = $"/companies/{companyId}/user-administration";

        await LoadUnreadCountAsync();

        if (Env.IsDevelopment())
            _personas = await DevAuth.GetPersonasAsync();
    }

    private async Task LoadUnreadCountAsync()
    {
        if (!Session.EmployeeId.HasValue) return;
        _unreadCount = await NotificationService.GetUnreadCountAsync(Session.CompanyId);
    }

    private async Task LoadNotificationsAsync()
    {
        if (!Session.EmployeeId.HasValue) return;
        var result = await NotificationService.GetAsync(Session.CompanyId);
        if (result is null) return;
        _unreadCount = result.UnreadCount;
        _notifications = result.Items;
    }

    private async Task ToggleNotifications()
    {
        _notifOpen = !_notifOpen;
        if (_notifOpen)
            await LoadNotificationsAsync();
    }

    private async Task OnNotificationClick(NotificationDto notification)
    {
        _notifOpen = false;
        if (!notification.IsRead)
        {
            await NotificationService.MarkReadAsync(Session.CompanyId, notification.Id);
            _unreadCount = Math.Max(0, _unreadCount - 1);
            var idx = _notifications.IndexOf(notification);
            if (idx >= 0)
                _notifications[idx] = notification with { IsRead = true };
        }
        _notifiedTaskId = notification.SourceEntityId;
        _taskDialogOpen = true;
    }

    private async Task MarkAllRead()
    {
        if (!Session.EmployeeId.HasValue) return;
        await NotificationService.MarkAllReadAsync(Session.CompanyId, Session.EmployeeId.Value);
        _unreadCount = 0;
        _notifications = _notifications.Select(n => n with { IsRead = true }).ToList();
    }

    private static (string Icon, string Label, string Css) NotifTypeInfo(string type) => type switch
    {
        "TaskDueSoon" => ("fa-solid fa-clock", "Due Soon", "notif-type-label--due-soon"),
        "TaskOverdue" => ("fa-solid fa-triangle-exclamation", "Overdue", "notif-type-label--overdue"),
        _ => ("fa-solid fa-bell", "Assigned", "notif-type-label--assigned"),
    };

    private static string FormatTime(DateTimeOffset dt)
    {
        var diff = DateTimeOffset.UtcNow - dt;
        if (diff.TotalMinutes < 1) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return dt.ToString("d MMM");
    }

    private void ClearError() => _errorBoundary?.Recover();

    protected override void OnParametersSet() => _errorBoundary?.Recover();

    private void ToggleSidebar() => SidebarOpen = !SidebarOpen;

    private async Task OnPersonaSwitchAsync(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        var userId = e.Value?.ToString();
        if (string.IsNullOrEmpty(userId)) return;
        var ok = await DevAuth.SwitchAsync(userId);
        if (ok) NavigationManager.NavigateTo("/", forceLoad: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var stored = await JS.InvokeAsync<string>("getTheme");
            if (stored == "dark" && !IsDark)
            {
                IsDark = true;
                StateHasChanged();
            }
        }
    }

    private async Task ToggleTheme()
    {
        IsDark = !IsDark;
        await JS.InvokeVoidAsync("setTheme", IsDark);
    }

    // Top-bar title reacts to the current route rather than just the user's role, so it stays
    // accurate as users move between their role dashboard(s) and the Company screen. Recomputed
    // on every render; refreshed on client-side navigation via LocationChanged below.
    private string CurrentPageTitle => GetPageTitle(NavigationManager.Uri, Session.CanManageEmployees);

    private static string GetPageTitle(string uri, bool canManageEmployees)
    {
        var path = new Uri(uri).AbsolutePath.Trim('/').ToLowerInvariant();
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);

        return path switch
        {
            "dashboard/hr" => "HR Dashboard",
            "dashboard/recruitment" => "Recruitment Dashboard",
            "dashboard/manager" => "Manager Dashboard",
            // Company edit/view routes are "/companies/{id}/edit" or "/companies/{id}/view" —
            // exactly 3 segments, unlike every other companies/{id}/{resource}/... route.
            _ when segments.Length == 3 && segments[0] == "companies" && (segments[2] == "edit" || segments[2] == "view") => "Company",
            // Every other admin subpage (Employees, Departments, Vacancies, Leave Types, etc.) keeps
            // the pre-dashboards generic "Dashboard" title for CanManageEmployees users; everyone else
            // (a plain Employee browsing their own linked pages) sees "My Profile".
            _ => canManageEmployees ? "Dashboard" : "My Profile",
        };
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
