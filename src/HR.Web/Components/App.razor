<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>One Big Team</title>
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="lib/fontawesome/css/fontawesome.min.css" rel="stylesheet" />
    <link href="lib/fontawesome/css/solid.min.css" rel="stylesheet" />
    <link href="_content/Syncfusion.Blazor.Themes/bootstrap5.css" rel="stylesheet" />
    <link id="sf-dark-theme" href="_content/Syncfusion.Blazor.Themes/bootstrap5-dark.css" rel="stylesheet" disabled />
    <!-- app.css must load after Bootstrap/Syncfusion so its --bs-* / design-token
         overrides win the cascade instead of being clobbered by the theme defaults. -->
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["HR.Web.styles.css"]" />
    <script>
        (function () {
            try {
                var t = localStorage.getItem('theme');
                // No explicit stored choice (t is neither 'dark' nor 'light') falls back to the
                // OS/browser's current preference, same as app.js's getTheme() — otherwise a
                // visitor with a dark system theme and no prior toggle-button choice would see a
                // flash of the light theme before app.js runs and corrects it.
                var isDark = t === 'dark' || (t !== 'light' && window.matchMedia &&
                    window.matchMedia('(prefers-color-scheme: dark)').matches);
                if (isDark) {
                    document.documentElement.setAttribute('data-theme', 'dark');
                    document.documentElement.setAttribute('data-bs-theme', 'dark');
                    var l = document.getElementById('sf-dark-theme');
                    if (l) l.disabled = false;
                }
            } catch {}
        })();
    </script>
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" href="favicon-dark.png" media="(prefers-color-scheme: dark)" />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <ReconnectModal />
    <div id="blazor-error-ui" data-nosnippet>
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>Something went wrong.</span>
        <a href="." class="reload">Reload</a>
        <button class="dismiss" aria-label="Dismiss">&#10005;</button>
    </div>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/Syncfusion.Blazor.Core/scripts/syncfusion-blazor.min.js" type="text/javascript"></script>
    <script src="app.js"></script>
</body>

</html>
