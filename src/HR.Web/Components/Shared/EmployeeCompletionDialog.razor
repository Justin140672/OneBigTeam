@rendermode InteractiveServer
@inject EmployeeService EmployeeService
@inject AppSession Session
@inject IJSRuntime JS
@using HR.Web.Models

<SfDialog Visible="true"
          IsModal="true"
          Width="720px"
          ShowCloseIcon="false"
          CloseOnEscape="false"
          AllowDragging="false"
          CssClass="employee-completion-dialog">
    <DialogTemplates>
        <Header>
            <h2 class="ecd-heading">Welcome, @Session.FirstName — let's complete your profile</h2>
        </Header>
        <Content>
            <p class="text-muted mb-2">
                We already have some of your details. Please add the remaining information below so we can
                finish setting up your employee account. Required fields are marked with an asterisk, and
                you can update optional information later.
            </p>
            <p class="text-muted ecd-why">
                We need this information to complete your employee record and keep your HR details accurate. Setup takes about 2 minutes — any optional details you
                skip can be added later from your profile.
            </p>

            @if (!string.IsNullOrEmpty(GlobalError))
            {
                <div class="alert alert-danger">@GlobalError</div>
            }

            <EditForm EditContext="_editContext">
                <DataAnnotationsValidator />

                <section class="ecd-section" aria-labelledby="ecd-name-heading">
                    <h3 id="ecd-name-heading" class="ecd-section-heading">Your name</h3>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <span class="form-label d-block" id="ecd-firstname-label">First Name</span>
                            <div class="ecd-readonly" role="text" aria-labelledby="ecd-firstname-label">@Model.FirstName</div>
                        </div>
                        <div class="col-md-6">
                            <span class="form-label d-block" id="ecd-lastname-label">Last Name</span>
                            <div class="ecd-readonly" role="text" aria-labelledby="ecd-lastname-label">@Model.LastName</div>
                        </div>
                        <div class="col-12">
                            <p class="text-muted ecd-note mb-0">Need to correct your name? Contact your HR administrator after setup.</p>
                        </div>
                    </div>
                </section>

                <section class="ecd-section" aria-labelledby="ecd-personal-heading">
                    <h3 id="ecd-personal-heading" class="ecd-section-heading">Personal details</h3>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="ecd-preferredname">Preferred Name <span class="text-muted">(optional)</span></label>
                            <HrTextBox ID="ecd-preferredname" @bind-Value="Model.PreferredName" Placeholder="Defaults to first name" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ecd-dob">Date of Birth <span class="text-danger">*</span></label>
                            <SfDatePicker ID="ecd-dob" TValue="DateOnly?" @bind-Value="Model.DateOfBirth" Placeholder="dd/mm/yyyy" Format="dd/MM/yyyy"
                                          HtmlAttributes="@_ariaRequired" />
                            <ValidationMessage For="@(() => Model.DateOfBirth)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ecd-nationality">Nationality <span class="text-danger">*</span></label>
                            <SfDropDownList ID="ecd-nationality"
                                            TValue="string"
                                            TItem="NationalityListItem"
                                            DataSource="@_nationalities"
                                            @bind-Value="Model.Nationality"
                                            Placeholder="Select nationality"
                                            AllowFiltering="true"
                                            HtmlAttributes="@_ariaRequired">
                                <DropDownListFieldSettings Value="Name" Text="Name" />
                            </SfDropDownList>
                            <ValidationMessage For="@(() => Model.Nationality)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ecd-gender">Gender <span class="text-danger">*</span></label>
                            <SfDropDownList ID="ecd-gender"
                                            TValue="string"
                                            TItem="string"
                                            DataSource="@_genderOptions"
                                            @bind-Value="Model.Gender"
                                            Placeholder="Select gender"
                                            HtmlAttributes="@_ariaRequired">
                            </SfDropDownList>
                            <ValidationMessage For="@(() => Model.Gender)" />
                            @if (Model.Gender == "Other")
                            {
                                <div class="mt-2">
                                    <label class="form-label" for="ecd-genderother">Please specify your gender <span class="text-danger">*</span></label>
                                    <HrTextBox ID="ecd-genderother" @bind-Value="Model.GenderOther" Placeholder="Please specify" />
                                </div>
                            }
                        </div>
                    </div>
                </section>

                <section class="ecd-section" aria-labelledby="ecd-contact-heading">
                    <h3 id="ecd-contact-heading" class="ecd-section-heading">Contact details</h3>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="ecd-personalemail">Personal Email <span class="text-muted">(optional)</span></label>
                            <HrTextBox ID="ecd-personalemail" @bind-Value="Model.PersonalEmail" Placeholder="personal@example.com" />
                            <ValidationMessage For="@(() => Model.PersonalEmail)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ecd-phonenumber">Phone Number <span class="text-muted">(optional)</span></label>
                            <HrTextBox ID="ecd-phonenumber" @bind-Value="Model.PhoneNumber" Placeholder="e.g. 07700 900000" />
                            <ValidationMessage For="@(() => Model.PhoneNumber)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ecd-homephone">Home Phone <span class="text-muted">(optional)</span></label>
                            <HrTextBox ID="ecd-homephone" @bind-Value="Model.HomePhone" Placeholder="e.g. 01234 567890" />
                            <ValidationMessage For="@(() => Model.HomePhone)" />
                        </div>
                    </div>
                </section>

                <section class="ecd-section" aria-labelledby="ecd-address-heading">
                    <h3 id="ecd-address-heading" class="ecd-section-heading">Home address</h3>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="ecd-address1">Address Line 1 <span class="text-danger">*</span></label>
                            <HrTextBox ID="ecd-address1" @bind-Value="Model.AddressLine1" Placeholder="Street address" HtmlAttributes="@_ariaRequired" />
                            <ValidationMessage For="@(() => Model.AddressLine1)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ecd-address2">Address Line 2 <span class="text-muted">(optional)</span></label>
                            <HrTextBox ID="ecd-address2" @bind-Value="Model.AddressLine2" Placeholder="Apartment, suite, etc." />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ecd-city">City <span class="text-danger">*</span></label>
                            <HrTextBox ID="ecd-city" @bind-Value="Model.City" Placeholder="e.g. London" HtmlAttributes="@_ariaRequired" />
                            <ValidationMessage For="@(() => Model.City)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ecd-county">County <span class="text-muted">(optional)</span></label>
                            <HrTextBox ID="ecd-county" @bind-Value="Model.County" Placeholder="e.g. Greater London" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ecd-postcode">Postcode <span class="text-danger">*</span></label>
                            <HrTextBox ID="ecd-postcode" @bind-Value="Model.PostCode" Placeholder="e.g. SW1A 1AA" HtmlAttributes="@_ariaRequired" />
                            <ValidationMessage For="@(() => Model.PostCode)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ecd-country">Country <span class="text-muted">(optional)</span></label>
                            <HrTextBox ID="ecd-country" @bind-Value="Model.Country" Placeholder="e.g. United Kingdom" />
                        </div>
                    </div>
                </section>
            </EditForm>
        </Content>
        <FooterTemplate>
            <div class="d-flex justify-content-between align-items-center w-100">
                <a href="javascript:void(0)" @onclick="LogoutAsync">Log out</a>
                <SfButton CssClass="e-primary" OnClick="SaveAsync" Disabled="_saving">
                    @(_saving ? "Completing…" : "Complete setup")
                </SfButton>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter] public EventCallback OnCompleted { get; set; }

    private EmployeeInitialSetupModel Model { get; } = new();
    private EditContext _editContext = default!;
    private bool _saving;
    private string? GlobalError;

    private static readonly Dictionary<string, object> _ariaRequired = new() { ["aria-required"] = "true" };

    private static readonly string[] _genderOptions = ["Male", "Female", "Non-binary", "Prefer not to say", "Other"];
    private List<NationalityListItem> _nationalities = [];

    protected override void OnInitialized()
    {
        _editContext = new EditContext(Model);
    }

    protected override async Task OnParametersSetAsync()
    {
        Model.FirstName = Session.FirstName ?? string.Empty;
        Model.LastName = Session.LastName ?? string.Empty;

        Model.PostcodeRegexPattern = Session.PostcodeRegex;
        Model.TelephoneRegexPattern = Session.TelephoneRegex;
        Model.MobileRegexPattern = Session.MobileRegex;

        // Best-effort: this dialog blocks the entire app shell (MainLayout renders ONLY this when
        // Session.RequiresInitialEmployeeSetup is true), so a transient failure fetching the
        // nationality list must not throw out of OnParametersSetAsync and take the dialog's whole
        // render down — the field just falls back to an empty list.
        try
        {
            var natResult = await EmployeeService.ListNationalitiesAsync();
            _nationalities = natResult?.Items.ToList() ?? [];
        }
        catch
        {
            _nationalities = [];
        }
    }

    private async Task SaveAsync()
    {
        GlobalError = null;

        if (!_editContext.Validate())
        {
            GlobalError = "Please correct the highlighted fields below.";
            return;
        }

        _saving = true;
        StateHasChanged();

        var request = new CompleteInitialEmployeeSetupRequest(
            Model.FirstName.Trim(),
            Model.LastName.Trim(),
            string.IsNullOrWhiteSpace(Model.PreferredName) ? null : Model.PreferredName.Trim(),
            Model.DateOfBirth ?? default,
            Model.Nationality.Trim(),
            Model.Gender.Trim(),
            string.IsNullOrWhiteSpace(Model.GenderOther) ? null : Model.GenderOther.Trim(),
            string.IsNullOrWhiteSpace(Model.PersonalEmail) ? null : Model.PersonalEmail.Trim(),
            string.IsNullOrWhiteSpace(Model.PhoneNumber) ? null : Model.PhoneNumber.Trim(),
            string.IsNullOrWhiteSpace(Model.HomePhone) ? null : Model.HomePhone.Trim(),
            Model.AddressLine1.Trim(),
            string.IsNullOrWhiteSpace(Model.AddressLine2) ? null : Model.AddressLine2.Trim(),
            Model.City.Trim(),
            string.IsNullOrWhiteSpace(Model.County) ? null : Model.County.Trim(),
            Model.PostCode.Trim(),
            string.IsNullOrWhiteSpace(Model.Country) ? null : Model.Country.Trim());

        var (success, error) = await EmployeeService.CompleteInitialSetupAsync(Session.CompanyId, request);

        _saving = false;

        if (success)
        {
            Session.MarkInitialEmployeeSetupComplete();
            await OnCompleted.InvokeAsync();
        }
        else
        {
            GlobalError = error ?? "Failed to save your details.";
            StateHasChanged();
        }
    }

    // Uses the same hardNavigate pattern as MainLayout's OnPersonaSwitchAsync — a genuine browser
    // navigation is required to reach /logout since Blazor Server's interactive circuit can't
    // set/clear the Supabase session cookie mid-render. This is the ONLY other way out of this
    // blocking dialog besides a successful save.
    private async Task LogoutAsync() => await JS.InvokeVoidAsync("hardNavigate", "/logout");

    // Mirrors the server-side validator's rule (DateOfBirth must be strictly after 1900-01-01) so
    // the client catches the placeholder DOB before it ever reaches the server.
    private sealed class DateAfter1900Attribute : System.ComponentModel.DataAnnotations.ValidationAttribute
    {
        protected override System.ComponentModel.DataAnnotations.ValidationResult? IsValid(
            object? value, System.ComponentModel.DataAnnotations.ValidationContext validationContext)
        {
            if (value is not DateOnly date)
                return System.ComponentModel.DataAnnotations.ValidationResult.Success;

            return date > new DateOnly(1900, 1, 1)
                ? System.ComponentModel.DataAnnotations.ValidationResult.Success
                : new System.ComponentModel.DataAnnotations.ValidationResult(
                    ErrorMessage ?? "Date of birth must be after 1 January 1900.",
                    validationContext.MemberName is null ? null : [validationContext.MemberName]);
        }
    }

    private sealed class EmployeeInitialSetupModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "First name is required.")]
        public string FirstName { get; set; } = string.Empty;
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Last name is required.")]
        public string LastName { get; set; } = string.Empty;
        public string PreferredName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Date of birth is required.")]
        [DateAfter1900(ErrorMessage = "Date of birth must be after 1 January 1900.")]
        public DateOnly? DateOfBirth { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Nationality is required.")]
        public string Nationality { get; set; } = string.Empty;
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Gender is required.")]
        public string Gender { get; set; } = string.Empty;
        public string GenderOther { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string PersonalEmail { get; set; } = string.Empty;

        [DynamicRegex(nameof(MobileRegexPattern), ErrorMessage = "Enter a valid mobile number.")]
        public string PhoneNumber { get; set; } = string.Empty;
        [DynamicRegex(nameof(TelephoneRegexPattern), ErrorMessage = "Enter a valid phone number.")]
        public string HomePhone { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Address line 1 is required.")]
        public string AddressLine1 { get; set; } = string.Empty;
        public string AddressLine2 { get; set; } = string.Empty;
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "City is required.")]
        public string City { get; set; } = string.Empty;
        public string County { get; set; } = string.Empty;

        private string _postCode = string.Empty;
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Postcode is required.")]
        [DynamicRegex(nameof(PostcodeRegexPattern), ErrorMessage = "Enter a valid postcode.")]
        public string PostCode
        {
            get => _postCode;
            set => _postCode = value.ToUpperInvariant();
        }

        public string Country { get; set; } = string.Empty;

        public string? PostcodeRegexPattern { get; set; }
        public string? TelephoneRegexPattern { get; set; }
        public string? MobileRegexPattern { get; set; }
    }
}
