@* HR-only employee search palette (Ctrl+K / Cmd+K). Renders only for HR administrators. *@
@implements IAsyncDisposable
@inject AppSession Session
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject EmployeeService Employees

@if (Session.IsHrAdministrator)
{
    <button type="button"
            class="quick-nav-trigger"
            @ref="_triggerButton"
            @onclick="Open"
            aria-label="Search employees"
            title="Search employees (Ctrl+K)">
        <i class="fa-solid fa-magnifying-glass"></i>
    </button>

    @if (_open)
    {
        <div class="quick-nav-overlay" @onclick="Close">
            <div class="quick-nav-panel"
                 role="dialog"
                 aria-modal="true"
                 aria-label="Search employees"
                 @onclick:stopPropagation="true"
                 @onkeydown="OnKeyDown">
                <div class="quick-nav-input-row">
                    <i class="fa-solid fa-magnifying-glass quick-nav-input-icon"></i>
                    <input @ref="_input"
                           type="text"
                           class="quick-nav-input"
                           role="combobox"
                           aria-expanded="true"
                           aria-controls="quick-nav-listbox"
                           aria-activedescendant="@ActiveOptionId"
                           placeholder="Search employees..."
                           autocomplete="off"
                           value="@_term"
                           @oninput="OnInput" />
                </div>

                <label class="quick-nav-leavers-toggle">
                    <input type="checkbox"
                           checked="@_includeLeavers"
                           @onchange="OnIncludeLeaversChanged" />
                    <span>Include leavers / archived employees</span>
                </label>

                <ul class="quick-nav-results" id="quick-nav-listbox" role="listbox">
                    @if (_loading)
                    {
                        <li class="quick-nav-empty">Searching…</li>
                    }
                    else if (_results.Count == 0)
                    {
                        <li class="quick-nav-empty">
                            @(string.IsNullOrWhiteSpace(_term) ? "Start typing to search employees" : "No matching employees")
                        </li>
                    }
                    else
                    {
                        @for (var i = 0; i < _results.Count; i++)
                        {
                            var index = i;
                            var item = _results[index];
                            var isActive = index == _activeIndex;
                            <li id="@OptionId(index)"
                                role="option"
                                aria-selected="@(isActive ? "true" : "false")"
                                class="quick-nav-option @(isActive ? "is-active" : "")"
                                @onclick="() => Navigate(item)"
                                @onmouseenter="() => SetActive(index)">
                                <i class="fa-solid fa-user quick-nav-option-icon"></i>
                                <span class="quick-nav-option-text">
                                    <span class="quick-nav-option-title">
                                        @item.FullName
                                        @if (!string.IsNullOrWhiteSpace(item.EmployeeNumber))
                                        {
                                            <span class="quick-nav-option-group">@item.EmployeeNumber</span>
                                        }
                                    </span>
                                    @if (PositionDepartment(item) is { Length: > 0 } sub)
                                    {
                                        <span class="quick-nav-option-group">@sub</span>
                                    }
                                </span>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>
    }
}

@code {
    private bool _open;
    private bool _shouldFocusInput;
    private string _term = string.Empty;
    private bool _includeLeavers;
    private int _activeIndex;
    private bool _loading;

    private List<EmployeeDirectorySearchItem> _results = new();

    private CancellationTokenSource? _debounceCts;

    private ElementReference _input;
    private ElementReference _triggerButton;
    private DotNetObjectReference<AdminQuickNav>? _selfRef;
    private bool _registered;

    protected override async Task OnInitializedAsync()
    {
        // On a cold circuit this component's OnInitialized can run before MainLayout's
        // Session.InitialiseAsync() await has completed, so re-render if the session changes later.
        Session.Changed += OnSessionChanged;
        await Session.InitialiseAsync();
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Session.IsHrAdministrator)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registerAdminQuickNav", _selfRef);
            _registered = true;
        }

        if (_open && _shouldFocusInput)
        {
            _shouldFocusInput = false;
            try { await _input.FocusAsync(); } catch { }
        }
    }

    [JSInvokable]
    public Task OpenFromJs() => InvokeAsync(Open);

    private void Open()
    {
        _open = true;
        _term = string.Empty;
        _includeLeavers = false;
        _activeIndex = 0;
        _results = new();
        _loading = false;
        _shouldFocusInput = true;
        StateHasChanged();
    }

    private void Close()
    {
        if (!_open) return;
        _open = false;
        _debounceCts?.Cancel();
        StateHasChanged();
        _ = FocusTriggerAsync();
    }

    private async Task FocusTriggerAsync()
    {
        try { await _triggerButton.FocusAsync(); } catch { }
    }

    private void OnInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _term = e.Value?.ToString() ?? string.Empty;
        _activeIndex = 0;
        QueueSearch();
    }

    private void OnIncludeLeaversChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _includeLeavers = e.Value is true || (e.Value?.ToString() == "true");
        _activeIndex = 0;
        QueueSearch();
    }

    private void SetActive(int index) => _activeIndex = index;

    private void QueueSearch()
    {
        _debounceCts?.Cancel();
        var cts = new CancellationTokenSource();
        _debounceCts = cts;

        if (string.IsNullOrWhiteSpace(_term))
        {
            _loading = false;
            _results = new();
            StateHasChanged();
            return;
        }

        _loading = true;
        StateHasChanged();

        _ = RunSearchAsync(_term, _includeLeavers, cts.Token);
    }

    private async Task RunSearchAsync(string term, bool includeLeavers, CancellationToken ct)
    {
        try
        {
            await Task.Delay(250, ct);
            var response = await Employees.SearchEmployeeDirectoryAsync(Session.CompanyId, term, includeLeavers, ct: ct);
            if (ct.IsCancellationRequested) return;

            _results = response?.Items?.ToList() ?? new();
            if (_activeIndex >= _results.Count)
                _activeIndex = Math.Max(0, _results.Count - 1);
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { }
        catch (OperationCanceledException) { }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                Close();
                break;
            case "ArrowDown":
                if (_results.Count > 0)
                    _activeIndex = (_activeIndex + 1) % _results.Count;
                break;
            case "ArrowUp":
                if (_results.Count > 0)
                    _activeIndex = (_activeIndex - 1 + _results.Count) % _results.Count;
                break;
            case "Enter":
                if (_activeIndex >= 0 && _activeIndex < _results.Count)
                    Navigate(_results[_activeIndex]);
                break;
        }
    }

    private void Navigate(EmployeeDirectorySearchItem item)
    {
        _open = false;
        _debounceCts?.Cancel();
        Navigation.NavigateTo($"/companies/{Session.CompanyId}/employees/{item.Id}/profile");
    }

    private static string? PositionDepartment(EmployeeDirectorySearchItem item)
    {
        var parts = new[] { item.PositionProfileTitle, item.DepartmentName }
            .Where(p => !string.IsNullOrWhiteSpace(p));
        return string.Join(" • ", parts);
    }

    private static string OptionId(int index) => $"quick-nav-option-{index}";

    private string? ActiveOptionId =>
        _activeIndex >= 0 && _activeIndex < _results.Count ? OptionId(_activeIndex) : null;

    public async ValueTask DisposeAsync()
    {
        Session.Changed -= OnSessionChanged;
        _debounceCts?.Cancel();

        if (_registered)
        {
            try { await JS.InvokeVoidAsync("unregisterAdminQuickNav"); } catch { }
        }
        _selfRef?.Dispose();
    }
}
