@inject IWebHostEnvironment Env
@inject IHttpClientFactory HttpClientFactory
@inject AppSession Session

@* Full-page block — a real user cannot get past this without clicking the confirmation link
   sent to their email address (real Supabase Auth + email delivery is out of scope for now,
   see ApplicationUser.IsEmailConfirmed remarks). There's deliberately no "confirm now" button
   here: only email confirms an account in the real system, so offering one would be misleading.
   The dev-only link below (visible in Development only, mirrors MainLayout's existing dev persona
   switcher gating) exists purely so local testing/demos aren't permanently stuck. *@
<div class="app-loading email-confirmation-required">
    <div class="email-confirmation-panel">
        <i class="fa-solid fa-envelope-circle-check email-confirmation-icon"></i>
        <h1>Confirm your email to continue</h1>
        <p>
            We've sent a confirmation link to <strong>@Session.Email</strong>. Click the link in
            that email to activate your account — you won't be able to use One Big Team until
            it's confirmed.
        </p>
        @if (Env.IsDevelopment())
        {
            <button class="dev-confirm-link" type="button" disabled="@_confirming" @onclick="DevConfirmAsync">
                @(_confirming ? "Confirming…" : "Dev tool: confirm this account")
            </button>
        }
    </div>
</div>

@code {
    private bool _confirming;

    private async Task DevConfirmAsync()
    {
        _confirming = true;
        try
        {
            var http = HttpClientFactory.CreateClient("hrapi");
            var response = await http.PostAsync("api/dev/confirm-email", null);
            if (response.IsSuccessStatusCode)
            {
                Session.SetEmailConfirmed();
            }
        }
        finally
        {
            _confirming = false;
        }
    }
}
