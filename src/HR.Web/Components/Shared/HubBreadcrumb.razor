@* Shared breadcrumb for settings/detail screens. The former "Administration" root crumb was
   removed with the Administration Home hub — the trail now starts at the parent list (or the
   current page when there is no parent). *@
@using HR.SharedKernel.Http
@inject NavigationManager Navigation

<SfBreadcrumb Class="mb-3">
    <BreadcrumbItems>
        @if (Parent is { } parent)
        {
            <BreadcrumbItem Text="@parent.Text" Url="@ParentUrl(parent.Url)" />
        }
        <BreadcrumbItem Text="@CurrentPage" />
    </BreadcrumbItems>
</SfBreadcrumb>

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public string CurrentPage { get; set; } = string.Empty;
    [Parameter] public (string Text, string Url)? Parent { get; set; }

    private string ParentUrl(string fallback)
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(
            Navigation.ToAbsoluteUri(Navigation.Uri).Query);

        if (query.TryGetValue("returnUrl", out var value))
        {
            var validatedUrl = ReturnUrlValidator.ValidateInternalPath(value.ToString());
            if (validatedUrl is not null)
                return validatedUrl;
        }

        return fallback;
    }
}
