@using Microsoft.AspNetCore.Components.Authorization
@using HR.Web.Services
@inject NavigationManager Navigation
@inject IWebHostEnvironment Env
@inject SupabaseSessionAccessor SessionAccessor

<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                    <NotAuthorized>
                        @{
                            if (!Navigation.Uri.EndsWith("/login", StringComparison.OrdinalIgnoreCase))
                                Navigation.NavigateTo("/login", replace: true);
                        }
                    </NotAuthorized>
                </AuthorizeRouteView>
            </ChildContent>
            <ErrorContent Context="ex">
                @if (Env.IsDevelopment())
                {
                    <div class="dev-error-boundary">
                        <h2>Unhandled exception (dev only)</h2>
                        <p><strong>@ex.GetType().FullName</strong></p>
                        <pre class="dev-error-message">@ex.Message</pre>
                        <pre class="dev-error-stacktrace">@ex.StackTrace</pre>
                        <button @onclick="() => _errorBoundary?.Recover()">Recover</button>
                    </div>
                }
            </ErrorContent>
        </ErrorBoundary>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    private ErrorBoundary? _errorBoundary;

    // Reads the "st" (session token) query-string param that /dev/persona-cookie and
    // /login-complete append to their redirect targets (see Program.cs) — /verify-email-complete
    // deliberately does NOT do this (see its remarks) since carrying a session over that hop risks
    // landing the visitor in a stale circuit's existing session instead of the one they just
    // verified. NavigationManager.Uri
    // — unlike IHttpContextAccessor.HttpContext — is reliably available inside a Blazor Server
    // interactive circuit even when that circuit persists across a full browser navigation (confirmed
    // via live diagnosis: the circuit's own SupabaseSessionAccessor instance otherwise never gets a
    // chance to see a fresh cookie again). Immediately scrubs the token from the URL/browser history
    // afterward — it must not linger as a bookmarkable/shareable link.
    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("st", out var token) && !string.IsNullOrEmpty(token))
        {
            SessionAccessor.Initialize(token!);
            Navigation.NavigateTo(uri.GetLeftPart(UriPartial.Path), replace: true);
        }
    }
}
