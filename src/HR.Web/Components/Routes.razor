@using Microsoft.AspNetCore.Components.Authorization
@using HR.Web.Services
@inject NavigationManager Navigation
@inject IWebHostEnvironment Env

<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                    <NotAuthorized>
                        @{
                            if (!Navigation.Uri.EndsWith("/login", StringComparison.OrdinalIgnoreCase))
                                Navigation.NavigateTo("/login", replace: true);
                        }
                    </NotAuthorized>
                </AuthorizeRouteView>
            </ChildContent>
            <ErrorContent Context="ex">
                @if (Env.IsDevelopment())
                {
                    <div class="dev-error-boundary">
                        <h2>Unhandled exception (dev only)</h2>
                        <p><strong>@ex.GetType().FullName</strong></p>
                        <pre class="dev-error-message">@ex.Message</pre>
                        <pre class="dev-error-stacktrace">@ex.StackTrace</pre>
                        <button @onclick="() => _errorBoundary?.Recover()">Recover</button>
                    </div>
                }
            </ErrorContent>
        </ErrorBoundary>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    private ErrorBoundary? _errorBoundary;
}
