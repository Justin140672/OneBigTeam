@page "/reset-password-complete"
@layout HR.Web.Components.Layout.LoginLayout
@rendermode @(new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject PasswordResetService PasswordResetService
@inject HR.Web.Services.AuthHandoffStore HandoffStore
@inject IJSRuntime JS

<PageTitle>Reset your password — One Big Team</PageTitle>

<div class="login-card">
    <div class="login-brand">
        <img src="/images/logo.png" alt="One Big Team" class="login-logo-img" />
    </div>

    @if (string.IsNullOrWhiteSpace(_accessToken) || _linkInvalid)
    {
        <h1 class="login-heading">Password reset link no longer valid</h1>
        <p class="login-subheading" data-testid="reset-link-invalid">
            This password reset link is no longer valid. Please request a new one.
        </p>
        <a href="/forgot-password" class="login-back-link" data-testid="request-new-link">Back to Forgot Password</a>
    }
    else
    {
        <h1 class="login-heading">Choose a new password</h1>
        <p class="login-subheading">Enter a new password for your account.</p>

        <EditForm Model="_form" OnValidSubmit="SubmitAsync" FormName="reset-password-complete">
            <DataAnnotationsValidator />

            @if (_error is not null)
            {
                <div class="login-error">
                    <i class="fa-solid fa-circle-exclamation"></i> @_error
                </div>
            }

            <div class="login-field">
                <label class="login-label">New Password</label>
                <HrTextBox @bind-Value="_form.NewPassword"
                           Placeholder="••••••••"
                           Type="InputType.Password" />
                <ValidationMessage For="() => _form.NewPassword" class="login-validation" />
            </div>

            <div class="login-field">
                <label class="login-label">Confirm New Password</label>
                <HrTextBox @bind-Value="_form.ConfirmPassword"
                           Placeholder="••••••••"
                           Type="InputType.Password" />
                <ValidationMessage For="() => _form.ConfirmPassword" class="login-validation" />
            </div>

            <SfButton IsPrimary="true"
                      Type="ButtonType.Submit"
                      Disabled="@_busy"
                      CssClass="login-btn">
                @if (_busy)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                }
                Update Password
            </SfButton>
        </EditForm>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public string? code { get; set; }

    private readonly ResetPasswordForm _form = new();
    private string? _error;
    private bool _busy;
    private bool _linkInvalid;
    private string? _accessToken;

    protected override void OnInitialized()
        => _accessToken = HandoffStore.Redeem(code)?.AccessToken;

    private async Task SubmitAsync()
    {
        _error = null;
        _busy = true;

        var (success, error) = await PasswordResetService.ResetPasswordAsync(_accessToken!, _form.NewPassword);

        _busy = false;

        if (!success)
        {
            _linkInvalid = true;
            _error = error;
            return;
        }

        await JS.InvokeVoidAsync("hardNavigate", "/login?reset=true");
    }

    private sealed class ResetPasswordForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "New password is required.")]
        [System.ComponentModel.DataAnnotations.MinLength(8, ErrorMessage = "Password must be at least 8 characters.")]
        public string NewPassword { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please confirm your new password.")]
        [System.ComponentModel.DataAnnotations.Compare(nameof(NewPassword), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
