@page "/reset-password-complete"
@layout HR.Web.Components.Layout.LoginLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject PasswordResetService PasswordResetService

<PageTitle>Reset your password — One Big Team</PageTitle>

<div class="login-card">
    <div class="login-brand">
        <img src="/images/logo.png" alt="One Big Team" class="login-logo-img" />
    </div>

    @if (string.IsNullOrWhiteSpace(access_token))
    {
        <h1 class="login-heading">This link is invalid or has expired</h1>
        <p class="login-subheading">
            Password reset links only work once and expire after a while. Request a fresh one below.
        </p>
        <a href="/forgot-password" class="login-back-link" data-testid="request-new-link">Request a new link</a>
    }
    else if (_done)
    {
        <h1 class="login-heading">Password updated</h1>
        <p class="login-subheading">Your password has been changed. Sign in with your new password.</p>
        <a href="/login" class="login-back-link" data-testid="back-to-login">Back to sign in</a>
    }
    else
    {
        <h1 class="login-heading">Choose a new password</h1>
        <p class="login-subheading">Enter a new password for your account.</p>

        <EditForm Model="_form" OnValidSubmit="SubmitAsync" FormName="reset-password-complete">
            <DataAnnotationsValidator />

            @if (_error is not null)
            {
                <div class="login-error">
                    <i class="fa-solid fa-circle-exclamation"></i> @_error
                </div>
            }

            <div class="login-field">
                <label class="login-label">New password</label>
                <SfTextBox @bind-Value="_form.NewPassword"
                           Placeholder="••••••••"
                           Type="InputType.Password" />
                <ValidationMessage For="() => _form.NewPassword" class="login-validation" />
            </div>

            <div class="login-field">
                <label class="login-label">Confirm new password</label>
                <SfTextBox @bind-Value="_form.ConfirmPassword"
                           Placeholder="••••••••"
                           Type="InputType.Password" />
                <ValidationMessage For="() => _form.ConfirmPassword" class="login-validation" />
            </div>

            <SfButton IsPrimary="true"
                      Type="ButtonType.Submit"
                      Disabled="@_busy"
                      CssClass="login-btn">
                @if (_busy)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                }
                Reset password
            </SfButton>
        </EditForm>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public string? access_token { get; set; }

    private readonly ResetPasswordForm _form = new();
    private string? _error;
    private bool _busy;
    private bool _done;

    private async Task SubmitAsync()
    {
        if (_form.NewPassword != _form.ConfirmPassword)
        {
            _error = "Passwords do not match.";
            return;
        }

        _error = null;
        _busy = true;

        var (success, error) = await PasswordResetService.ResetPasswordAsync(access_token!, _form.NewPassword);

        _busy = false;

        if (!success)
        {
            _error = error;
            return;
        }

        _done = true;
    }

    private sealed class ResetPasswordForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "New password is required.")]
        [System.ComponentModel.DataAnnotations.MinLength(8, ErrorMessage = "Password must be at least 8 characters.")]
        public string NewPassword { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please confirm your new password.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
