@page "/companies/{CompanyId:guid}/user-administration"
@rendermode InteractiveServer
@inherits SearchPageBase<UserListItemModel>
@inject UserAdministrationService UserAdministrationService
@inject AppSession Session

<PageTitle>User Administration</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex align-items-start justify-content-between mb-1">
        <div>
            <h1 class="mb-1">User Administration</h1>
            <p class="text-muted mb-3">Manage who can sign in to this company and what roles they hold.</p>
        </div>
    </div>

    <div class="mb-3 col-md-4 px-0">
        <HrTextBox Value="@SearchTerm"
                   ValueChanged="@OnSearchChanged"
                   Placeholder="Search by name or email" />
    </div>

    @if (IsLoading)
    {
        <HrLoadingIndicator Label="Loading users…" />
    }
    else if (Error is not null)
    {
        <div class="alert alert-danger">@Error</div>
    }
    else
    {
        @if (ActionError is not null)
        {
            <div class="alert alert-danger alert-dismissible">
                @ActionError
                <button type="button" class="btn-close" @onclick="ClearActionError"></button>
            </div>
        }

        @if (Items.Count == 0)
        {
            <div class="alert alert-info">No users found for this company.</div>
        }
        else
        {
            <HrGrid @ref="Grid"
                    TValue="UserListItemModel"
                    DataSource="@Items"
                    Toolbar="@GridToolbar"
                    AllowPaging="true"
                    AllowSorting="true"
                    AllowFiltering="true">
                <GridEvents TValue="UserListItemModel" OnToolbarClick="HandleToolbarClick"
                            RowSelected="OnRowSelected" RowDeselected="OnRowDeselected" />
                <GridPageSettings PageSize="20" />
                <GridColumns>
                    <GridColumn Field="@nameof(UserListItemModel.Name)" HeaderText="Name" Width="180">
                        <Template>
                            @{
                                var row = (context as UserListItemModel)!;
                                <a href="/companies/@CompanyId/user-administration/@row.EmployeeId">@row.Name</a>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(UserListItemModel.Email)" HeaderText="Email" Width="220" />
                    <GridColumn Field="@nameof(UserListItemModel.PositionTitle)" HeaderText="Position" Width="180">
                        <Template>
                            @{
                                var row = (context as UserListItemModel)!;
                            }
                            @(string.IsNullOrEmpty(row.PositionTitle) ? "—" : row.PositionTitle)
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="Roles" Width="220" AllowSorting="false" AllowFiltering="false">
                        <Template>
                            @{
                                var row = (context as UserListItemModel)!;
                            }
                            @if (row.RoleNames.Count == 0)
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                @foreach (var roleName in row.RoleNames)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis me-1">@roleName</span>
                                }
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(UserListItemModel.AccountStatus)" HeaderText="Account Status" Width="140">
                        <Template>
                            @{
                                var row = (context as UserListItemModel)!;
                                <span class="badge @AccountStatusBadgeClass(row.AccountStatus)">@row.AccountStatus</span>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(UserListItemModel.InvitationStatus)" HeaderText="Invitation Status" Width="150">
                        <Template>
                            @{
                                var row = (context as UserListItemModel)!;
                            }
                            @if (string.IsNullOrEmpty(row.InvitationStatus))
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                <span class="badge @InvitationStatusBadgeClass(row.InvitationStatus)">@row.InvitationStatus</span>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(UserListItemModel.LastLoginAt)" HeaderText="Last Login" Width="160">
                        <Template>
                            @{
                                var row = (context as UserListItemModel)!;
                            }
                            @(row.LastLoginAt is { } lastLogin ? lastLogin.ToString("dd MMM yyyy HH:mm") : "Never")
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(UserListItemModel.CreatedAt)" HeaderText="Created" Width="130" Format="d" />
                </GridColumns>
            </HrGrid>

            <p class="text-muted small mt-2">@Items.Count user(s)</p>
        }
    }

    <InviteUserWizard CompanyId="CompanyId"
                      IsOpen="_showInviteWizard"
                      OnCancelled="CloseInviteWizard"
                      OnCompleted="OnInviteCompleted" />
</div>

@code {
    protected override Task OnBeforeLoadAsync()
    {
        if (!Session.CanViewUsers)
            Navigation.NavigateTo("/access-denied", replace: true);
        return Task.CompletedTask;
    }

    // Resend/Cancel only make sense for a still-pending (or expired-but-not-yet-cancelled)
    // invite — an active user has already claimed theirs and has no InviteId left to act on.
    private static bool HasActionableInvite(UserListItemModel row) =>
        row.InviteId is not null && row.InvitationStatus is "Pending" or "Expired";

    private bool _showInviteWizard;

    private void CloseInviteWizard() => _showInviteWizard = false;

    private async Task OnInviteCompleted()
    {
        _showInviteWizard = false;
        await LoadAsync();
    }

    private async Task HandleToolbarClick(Syncfusion.Blazor.Navigations.ClickEventArgs args)
    {
        if (args.Item.Id == "hr-invite-user")
        {
            if (!Session.CanManageUsers)
            {
                SetActionError("You do not have permission to invite users.");
                return;
            }

            ClearActionError();
            _showInviteWizard = true;
            StateHasChanged();
            return;
        }

        await OnToolbarClick(args);
    }

    protected override void ConfigureToolbar()
    {
        if (Session.CanManageUsers)
        {
            AddToolbarAction(
                id:               "hr-invite-user",
                text:             "Invite User",
                icon:             "fa-solid fa-user-plus",
                onClick:          _ => Task.CompletedTask,
                tooltip:          "Invite an existing employee to create a sign-in account",
                selectionDependent: false);
        }

        AddToolbarAction(
            id:      "hr-resend-invite",
            text:    "Resend Invitation",
            icon:    "fa-solid fa-paper-plane",
            onClick: ResendInviteAsync,
            tooltip: "Resend the invitation email to the selected user");

        AddToolbarAction(
            id:      "hr-cancel-invite",
            text:    "Cancel Invitation",
            icon:    "fa-solid fa-ban",
            onClick: CancelInviteAsync,
            tooltip: "Cancel the selected user's pending invitation");
    }

    protected override async Task<IReadOnlyList<UserListItemModel>?> FetchItemsAsync(string? search)
    {
        var result = await UserAdministrationService.ListAllUsersAsync(CompanyId, search: search);
        return result?.Items;
    }

    protected override string LoadErrorMessage => "Failed to load users.";

    // No in-list "create user" flow exists — users are invited from the Employee edit page, not
    // from here — so Add stays disabled rather than rendering an enabled button that no-ops.
    protected override bool IsAddDisabled => true;

    // UserDetail.razor is a single combined view/manage page (account details plus the
    // invite/deactivate/reactivate actions), not a separate view-only vs edit-only pair, so both
    // default toolbar actions point at the same route the Name column link already uses.
    protected override string? GetEditUrl(UserListItemModel item) => $"/companies/{CompanyId}/user-administration/{item.EmployeeId}";
    protected override string? GetViewUrl(UserListItemModel item) => $"/companies/{CompanyId}/user-administration/{item.EmployeeId}";

    private async Task ResendInviteAsync(UserListItemModel row)
    {
        if (!HasActionableInvite(row))
        {
            SetActionError("The selected user does not have a pending invitation to resend.");
            return;
        }

        var inviteId = row.InviteId!.Value;
        ClearActionError();
        var (success, error) = await UserAdministrationService.ResendInviteAsync(CompanyId, inviteId);

        if (!success)
        {
            SetActionError(error ?? "Failed to resend the invitation.");
            return;
        }

        await LoadAsync();
    }

    private async Task CancelInviteAsync(UserListItemModel row)
    {
        if (!HasActionableInvite(row))
        {
            SetActionError("The selected user does not have a pending invitation to cancel.");
            return;
        }

        var inviteId = row.InviteId!.Value;
        ClearActionError();
        var (success, error) = await UserAdministrationService.CancelInviteAsync(CompanyId, inviteId);

        if (!success)
        {
            SetActionError(error ?? "Failed to cancel the invitation.");
            return;
        }

        await LoadAsync();
    }

    private static string AccountStatusBadgeClass(string status) => status switch
    {
        "Active"    => "bg-success",
        "Disabled"  => "bg-danger",
        "NoAccount" => "bg-secondary",
        _           => "bg-light text-dark"
    };

    private static string InvitationStatusBadgeClass(string status) => status switch
    {
        "Pending"   => "bg-warning text-dark",
        "Expired"   => "bg-danger",
        "Claimed"   => "bg-success",
        "Cancelled" => "bg-secondary",
        _           => "bg-light text-dark"
    };
}
