@inject UserAdministrationService UserAdministrationService

<SfDialog Visible="IsOpen" IsModal="true" Width="480px" ShowCloseIcon="false">
    <DialogTemplates>
        <Header>Manage Roles</Header>
        <Content>
            <div class="mb-3">
                <label class="form-label">Roles <span class="text-danger">*</span></label>
                <table class="table table-sm table-borderless mb-1">
                    <tbody>
                        @foreach (var role in _roleOptions)
                        {
                            var isEmployeeRole = role.Id == SystemRoleOptions.EmployeeRoleId;
                            <tr>
                                <td class="ps-0" style="width: 2.5rem;">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           id="@($"role-{role.Id}")"
                                           checked="@_selectedRoleIds.Contains(role.Id)"
                                           disabled="@isEmployeeRole"
                                           @onchange="@(e => OnRoleCheckedChanged(role.Id, e.Value is bool b && b))" />
                                </td>
                                <td class="align-middle">
                                    <label class="form-check-label mb-0" for="@($"role-{role.Id}")">
                                        @role.Name
                                        @if (isEmployeeRole)
                                        {
                                            <span class="text-muted small ms-1">(always assigned)</span>
                                        }
                                    </label>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="text-muted small mt-2 mb-0">Employee is required for every user and can't be removed.</p>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger py-2">@_error</div>
            }
        </Content>
        <FooterTemplate>
            <SfButton IsPrimary="true" Disabled="@_saving" OnClick="SaveAsync">
                @if (_saving)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                Save
            </SfButton>
            <SfButton Disabled="@_saving" OnClick="CancelAsync">Cancel</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public Guid UserId { get; set; }
    [Parameter] public List<Guid> CurrentRoleIds { get; set; } = [];
    [Parameter] public EventCallback OnCancelled { get; set; }
    [Parameter] public EventCallback OnCompleted { get; set; }

    private bool _wasOpen;
    private bool _saving;
    private string? _error;
    private List<Guid> _selectedRoleIds = [];

    private readonly List<RoleOption> _roleOptions = SystemRoleOptions.All.ToList();

    protected override void OnParametersSet()
    {
        if (IsOpen && !_wasOpen)
        {
            _selectedRoleIds = CurrentRoleIds.ToList();
            EnsureEmployeeRoleSelected();
            _error = null;
            _saving = false;
        }

        _wasOpen = IsOpen;
    }

    private void EnsureEmployeeRoleSelected()
    {
        if (!_selectedRoleIds.Contains(SystemRoleOptions.EmployeeRoleId))
            _selectedRoleIds.Add(SystemRoleOptions.EmployeeRoleId);
    }

    // The Employee row's checkbox is rendered disabled (see the table above), so this only ever
    // runs for the other, genuinely toggleable roles.
    private void OnRoleCheckedChanged(Guid roleId, bool isChecked)
    {
        if (isChecked)
        {
            if (!_selectedRoleIds.Contains(roleId))
                _selectedRoleIds.Add(roleId);
        }
        else
        {
            _selectedRoleIds.Remove(roleId);
        }
    }

    private async Task SaveAsync()
    {
        if (_selectedRoleIds.Count == 0)
        {
            _error = "A user must always retain at least one role.";
            return;
        }

        _saving = true;
        _error = null;

        var (success, error) = await UserAdministrationService.UpdateUserRolesAsync(CompanyId, UserId, _selectedRoleIds);

        _saving = false;

        if (!success)
        {
            _error = error ?? "Failed to update this user's roles.";
            return;
        }

        await OnCompleted.InvokeAsync();
    }

    private async Task CancelAsync()
    {
        await OnCancelled.InvokeAsync();
    }
}
