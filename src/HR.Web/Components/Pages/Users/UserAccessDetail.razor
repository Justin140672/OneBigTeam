@page "/companies/{CompanyId:guid}/user-administration/{EmployeeId:guid}/access-details"
@rendermode InteractiveServer
@inject UserAdministrationService UserAdministrationService
@inject AppSession Session
@inject NavigationManager Navigation

<PageTitle>@(_user?.Name is { } name ? $"{name} - Access Details" : "Access Details")</PageTitle>

<div class="container py-4">
    <SfBreadcrumb Class="mb-3">
        <BreadcrumbItems>
            <BreadcrumbItem Text="User Administration" Url="@($"/companies/{CompanyId}/user-administration")" />
            <BreadcrumbItem Text="@(_user?.Name ?? "User")" Url="@($"/companies/{CompanyId}/user-administration/{EmployeeId}")" />
            <BreadcrumbItem Text="Access Details" />
        </BreadcrumbItems>
    </SfBreadcrumb>

    @if (IsLoading)
    {
        <HrLoadingIndicator />
    }
    else if (_notFound)
    {
        <div class="alert alert-warning">No user administration record was found for this employee.</div>
    }
    else if (_user is not null)
    {
        <div class="d-flex align-items-center gap-2 mb-1">
            <h1 class="mb-0 fs-4">@_user.Name</h1>
            <span class="text-muted fs-6">Access Details & History</span>
        </div>
        <p class="text-muted mb-4">
            <a href="/companies/@CompanyId/user-administration/@EmployeeId">&larr; Back to @_user.Name</a>
        </p>

        @if (!string.IsNullOrEmpty(_globalError))
        {
            <div class="alert alert-danger">@_globalError</div>
        }
        @if (!string.IsNullOrEmpty(_globalSuccess))
        {
            <div class="alert alert-success alert-dismissible">
                @_globalSuccess
                <button type="button" class="btn-close" @onclick="@(() => _globalSuccess = null)"></button>
            </div>
        }

        <div class="row">
            <div class="col-lg-8">
                @if (_user.UserId is not null)
                {
                    <div class="card mb-4">
                        <div class="card-header d-flex align-items-center justify-content-between">
                            <h5 class="mb-0">Permission Overrides</h5>
                            @if (_canManage)
                            {
                                <SfButton Disabled="@_actionInProgress" OnClick="OpenAddOverrideDialog">+ Add Override</SfButton>
                            }
                        </div>
                        <div class="card-body">
                            @if (_overrides.Count == 0)
                            {
                                <p class="text-muted mb-0">No permission overrides for this user.</p>
                            }
                            else
                            {
                                <ul class="list-unstyled mb-0">
                                    @foreach (var ov in _overrides)
                                    {
                                        <li class="mb-3 d-flex align-items-start justify-content-between">
                                            <div>
                                                <div>
                                                    <span class="fw-semibold">@SystemRoleOptions.NameFor(ov.RoleId)</span>
                                                    <span class="badge @(ov.OverrideType == EmployeeRoleOverrideType.Grant ? "bg-success" : "bg-danger") ms-1">@ov.OverrideType</span>
                                                </div>
                                                <div class="text-muted small">@ov.Reason</div>
                                                <div class="text-muted small">
                                                    Expires: @(ov.ExpiresAt is { } expiresAt ? expiresAt.ToString("dd MMM yyyy") : "Permanent")
                                                </div>
                                            </div>
                                            @if (_canManage)
                                            {
                                                <SfButton Disabled="@_actionInProgress" OnClick="@(() => RemoveOverrideAsync(ov.RoleId))">Remove</SfButton>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                }

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Effective Access</h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(_effectiveAccessError))
                        {
                            <div class="alert alert-warning mb-0">@_effectiveAccessError</div>
                        }
                        else if (_effectiveAccess is null)
                        {
                            <HrLoadingIndicator />
                        }
                        else
                        {
                            <div class="mb-4">
                                <h6 class="text-muted text-uppercase small fw-semibold mb-2">Position Profile</h6>
                                @if (_effectiveAccess.Position is null)
                                {
                                    <span class="text-muted">No position assigned.</span>
                                }
                                else
                                {
                                    <span class="fw-semibold">@_effectiveAccess.Position.Name</span>
                                }
                            </div>

                            <div class="row mb-4">
                                <div class="col-md-4">
                                    <h6 class="text-muted text-uppercase small fw-semibold mb-2">Direct Roles</h6>
                                    @if (_effectiveAccess.DirectRoles.Count == 0)
                                    {
                                        <span class="text-muted">None</span>
                                    }
                                    else
                                    {
                                        @foreach (var role in _effectiveAccess.DirectRoles)
                                        {
                                            <div class="mb-1"><span class="badge bg-secondary-subtle text-secondary-emphasis">@role.Name</span></div>
                                        }
                                    }
                                </div>
                                <div class="col-md-4">
                                    <h6 class="text-muted text-uppercase small fw-semibold mb-2">Inherited Roles</h6>
                                    @if (_effectiveAccess.InheritedRoles.Count == 0)
                                    {
                                        <span class="text-muted">None</span>
                                    }
                                    else
                                    {
                                        @foreach (var role in _effectiveAccess.InheritedRoles)
                                        {
                                            <div class="mb-1">
                                                <span class="badge bg-info-subtle text-info-emphasis">@role.RoleName</span>
                                                <span class="text-muted small">via @role.PositionName</span>
                                            </div>
                                        }
                                    }
                                </div>
                                <div class="col-md-4">
                                    <h6 class="text-muted text-uppercase small fw-semibold mb-2">Overrides</h6>
                                    @if (_effectiveAccess.Overrides.Count == 0)
                                    {
                                        <span class="text-muted">None</span>
                                    }
                                    else
                                    {
                                        @foreach (var ov in _effectiveAccess.Overrides)
                                        {
                                            <div class="mb-1">
                                                <span class="fw-semibold">@ov.RoleName</span>
                                                <span class="badge @(ov.OverrideType == "Grant" ? "bg-success" : "bg-danger")">@ov.OverrideType</span>
                                                @if (!ov.IsActive)
                                                {
                                                    <span class="badge bg-secondary">Inactive</span>
                                                }
                                                <div class="text-muted small">@ov.Reason</div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>

                            <div class="mb-4">
                                <h6 class="text-muted text-uppercase small fw-semibold mb-2">Effective Roles</h6>
                                @if (_effectiveAccess.EffectiveRoles.Count == 0)
                                {
                                    <span class="text-muted">None</span>
                                }
                                else
                                {
                                    <ul class="list-unstyled mb-0">
                                        @foreach (var role in _effectiveAccess.EffectiveRoles)
                                        {
                                            <li class="mb-2">
                                                <span class="fw-semibold">@role.RoleName</span>
                                                @foreach (var source in role.Sources)
                                                {
                                                    <span class="badge bg-light text-dark border ms-1">@source</span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>

                            <div class="mb-4">
                                <h6 class="text-muted text-uppercase small fw-semibold mb-2">Effective Permissions</h6>
                                @if (_effectiveAccess.EffectivePermissions.Count == 0)
                                {
                                    <span class="text-muted">None</span>
                                }
                                else
                                {
                                    <ul class="list-unstyled mb-0">
                                        @foreach (var perm in _effectiveAccess.EffectivePermissions)
                                        {
                                            <li class="mb-2">
                                                <span class="fw-semibold">@perm.PermissionName</span>
                                                <span class="badge @(perm.Scope == "Company" ? "bg-primary-subtle text-primary-emphasis" : "bg-secondary-subtle text-secondary-emphasis") ms-1">@perm.Scope</span>
                                                <div class="text-muted small">
                                                    Granted by @string.Join(", ", perm.Sources.Select(s => $"{s.RoleName} ({s.Origin})"))
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>

                            <div>
                                <h6 class="text-muted text-uppercase small fw-semibold mb-2">Denied Permissions</h6>
                                @if (_effectiveAccess.DeniedPermissions.Count == 0)
                                {
                                    <span class="text-muted">None</span>
                                }
                                else
                                {
                                    <ul class="list-unstyled mb-0">
                                        @foreach (var denied in _effectiveAccess.DeniedPermissions)
                                        {
                                            <li class="mb-2 p-2 bg-danger-subtle rounded">
                                                <span class="fw-semibold text-danger-emphasis">@denied.PermissionName</span>
                                                <span class="badge bg-secondary-subtle text-secondary-emphasis ms-1">@denied.Scope</span>
                                                <div class="text-muted small">
                                                    Would be granted by @denied.DeniedByRoleName, but denied by an override: @denied.Reason
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Audit History</h5>
                    </div>
                    <div class="card-body">
                        @if (_auditHistory.Count == 0)
                        {
                            <p class="text-muted mb-0">No audit history recorded for this user.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var entry in _auditHistory)
                                {
                                    <li class="mb-3">
                                        <div class="d-flex justify-content-between">
                                            <span class="fw-semibold">@entry.EventType</span>
                                            <span class="text-muted small">@entry.OccurredAt.ToString("dd MMM yyyy HH:mm")</span>
                                        </div>
                                        <div>@entry.Summary</div>
                                        @if (!string.IsNullOrEmpty(entry.PerformedBy))
                                        {
                                            <div class="text-muted small">By @entry.PerformedBy</div>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>

                <SfButton OnClick="BackToUserDetail">Back</SfButton>
            </div>
        </div>

        @if (_user.UserId is not null)
        {
            <AddRoleOverrideDialog CompanyId="CompanyId"
                                   UserId="_user.UserId.Value"
                                   ExistingOverrideRoleIds="@(_overrides.Select(o => o.RoleId).ToList())"
                                   IsOpen="_showAddOverrideDialog"
                                   OnCancelled="CloseAddOverrideDialog"
                                   OnCompleted="OnOverrideAdded" />
        }
    }
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid EmployeeId { get; set; }

    private bool IsLoading = true;
    private bool _notFound;
    private GetUserDetailResponse? _user;
    private List<UserAuditHistoryItemModel> _auditHistory = [];
    private string? _globalError;
    private string? _globalSuccess;
    private bool _actionInProgress;
    private bool _showAddOverrideDialog;
    private List<EmployeeRoleOverrideModel> _overrides = [];
    private GetEffectiveAccessResponse? _effectiveAccess;
    private string? _effectiveAccessError;

    private bool _canManage => Session.CanManageUsers;

    protected override async Task OnParametersSetAsync()
    {
        if (!Session.CanViewUsers)
        {
            Navigation.NavigateTo("/access-denied", replace: true);
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        _notFound = false;
        _globalError = null;

        _user = await UserAdministrationService.GetUserAsync(CompanyId, EmployeeId);

        if (_user is null)
        {
            _notFound = true;
            IsLoading = false;
            return;
        }

        var history = await UserAdministrationService.GetAuditHistoryAsync(CompanyId, EmployeeId);
        _auditHistory = history?.Items ?? [];

        _overrides = _user.UserId is { } userId
            ? await UserAdministrationService.GetRoleOverridesAsync(CompanyId, userId) ?? []
            : [];

        var (effectiveAccess, effectiveAccessError) = await UserAdministrationService.GetEffectiveAccessAsync(CompanyId, EmployeeId);
        _effectiveAccess = effectiveAccess;
        _effectiveAccessError = effectiveAccessError;

        IsLoading = false;
    }

    private void BackToUserDetail() => Navigation.NavigateTo($"/companies/{CompanyId}/user-administration/{EmployeeId}");

    private void OpenAddOverrideDialog()
    {
        _globalError = null;
        _showAddOverrideDialog = true;
    }

    private void CloseAddOverrideDialog() => _showAddOverrideDialog = false;

    private async Task OnOverrideAdded()
    {
        _showAddOverrideDialog = false;
        _globalSuccess = "Permission override added.";
        await LoadAsync();
    }

    private async Task RemoveOverrideAsync(Guid roleId)
    {
        if (_user?.UserId is null) return;
        _actionInProgress = true;
        _globalError = null;

        var (success, error) = await UserAdministrationService.RemoveRoleOverrideAsync(CompanyId, _user.UserId.Value, roleId);

        _actionInProgress = false;

        if (!success)
            _globalError = error;
        else
        {
            _globalSuccess = "Permission override removed.";
            await LoadAsync();
        }
    }
}
