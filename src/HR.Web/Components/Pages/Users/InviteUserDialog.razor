@inject UserAdministrationService UserAdministrationService

<SfDialog Visible="IsOpen" IsModal="true" Width="560px" ShowCloseIcon="false">
    <DialogTemplates>
        <Header>Invite Employee</Header>
        <Content>
            <dl class="row mb-3">
                <dt class="col-sm-4 text-muted fw-normal">Employee</dt>
                <dd class="col-sm-8">@PreselectedEmployeeName</dd>
            </dl>

            @if (string.IsNullOrWhiteSpace(_email))
            {
                <div class="alert alert-danger py-2">
                    This employee has no work email on file. Add one on their profile before inviting them.
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Roles <span class="text-danger">*</span></label>
                <div class="mb-2">
                    <span class="badge bg-secondary-subtle text-secondary-emphasis">Employee</span>
                    <span class="text-muted small ms-1">— every user always has this role</span>
                </div>
                <table class="table table-sm table-borderless mb-0">
                    <tbody>
                        @foreach (var role in _additionalRoleOptions)
                        {
                            <tr>
                                <td class="ps-0" style="width: 2.5rem;">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           id="@($"additional-role-{role.Id}")"
                                           checked="@_selectedAdditionalRoleIds.Contains(role.Id)"
                                           @onchange="@(e => OnAdditionalRoleCheckedChanged(role.Id, e.Value is bool b && b))" />
                                </td>
                                <td class="align-middle">
                                    <label class="form-check-label mb-0" for="@($"additional-role-{role.Id}")">@role.Name</label>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!string.IsNullOrEmpty(_globalError))
            {
                <div class="alert alert-danger py-2">@_globalError</div>
            }
        </Content>
        <FooterTemplate>
            <SfButton IsPrimary="true" Disabled="@(_submitting || string.IsNullOrWhiteSpace(_email))" OnClick="ConfirmAsync">
                @if (_submitting)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                Send Invite
            </SfButton>
            <SfButton Disabled="@_submitting" OnClick="CancelAsync">Cancel</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public Guid PreselectedEmployeeId { get; set; }
    [Parameter, EditorRequired] public string PreselectedEmployeeName { get; set; } = string.Empty;
    [Parameter] public string? PreselectedEmployeeEmail { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }
    [Parameter] public EventCallback<InviteEmployeeUserResponse> OnCompleted { get; set; }

    private bool _wasOpen;
    private bool _submitting;
    private string? _globalError;
    private string _email = string.Empty;

    // The Employee role is mandatory for every invited user and is always applied — it's shown as
    // a fixed, non-removable badge rather than a selectable multiselect item, which avoids the
    // multiselect having to represent a "checked but disabled" item (Syncfusion's SfMultiSelect
    // doesn't support disabling individual items, and mutating the bound list in @bind-Value:after
    // previously caused a NullReferenceException when re-selecting the Employee entry).
    // _selectedAdditionalRoleIds holds only roles beyond Employee.
    private List<Guid> _selectedAdditionalRoleIds = [];

    private readonly List<RoleOption> _additionalRoleOptions =
        SystemRoleOptions.All.Where(r => r.Id != SystemRoleOptions.EmployeeRoleId).ToList();

    private List<Guid> AllSelectedRoleIds =>
        _selectedAdditionalRoleIds.Prepend(SystemRoleOptions.EmployeeRoleId).Distinct().ToList();

    protected override void OnParametersSet()
    {
        if (IsOpen && !_wasOpen)
            ResetState();

        _wasOpen = IsOpen;
    }

    private void ResetState()
    {
        _submitting = false;
        _globalError = null;
        _selectedAdditionalRoleIds = [];
        _email = PreselectedEmployeeEmail ?? string.Empty;
    }

    private void OnAdditionalRoleCheckedChanged(Guid roleId, bool isChecked)
    {
        if (isChecked)
        {
            if (!_selectedAdditionalRoleIds.Contains(roleId))
                _selectedAdditionalRoleIds.Add(roleId);
        }
        else
        {
            _selectedAdditionalRoleIds.Remove(roleId);
        }
    }

    private async Task ConfirmAsync()
    {
        if (string.IsNullOrWhiteSpace(_email))
        {
            _globalError = "This employee has no work email on file. Add one on their profile before inviting them.";
            return;
        }

        _submitting = true;
        _globalError = null;

        var (result, error) = await UserAdministrationService.InviteEmployeeUserAsync(
            CompanyId, PreselectedEmployeeId, _email.Trim(), AllSelectedRoleIds);

        _submitting = false;

        if (result is null)
        {
            _globalError = error ?? "Failed to invite this employee.";
            return;
        }

        await OnCompleted.InvokeAsync(result);
    }

    private async Task CancelAsync()
    {
        await OnCancelled.InvokeAsync();
    }
}
