@* ADM-08 — shared UI for the three governance audit reports (User Activity,
   Administrative Changes, Security Events). They share an identical filter and
   response shape; only the title, catalog id and service calls differ. *@
@using System.Text.Json
@using HR.Infrastructure.Abstractions
@using HR.Web.Components.Controls
@using HR.Web.Models
@using HR.Web.Services
@inject ReportingService ReportingService
@inject IJSRuntime JS

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-start mb-1">
        <h1 class="mb-0">@Title</h1>
        <button type="button"
                class="btn btn-link p-0 fs-4 governance-favourite @(_isFavourite ? "governance-favourite--active" : "")"
                title="@(_isFavourite ? "Remove from favourites" : "Add to favourites")"
                @onclick="ToggleFavouriteAsync">
            <i class="@(_isFavourite ? "fa-solid" : "fa-regular") fa-star"></i>
        </button>
    </div>
    <p class="text-muted mb-3">@Description</p>

    @if (_exportError is not null)
    {
        <div class="alert alert-danger alert-dismissible">
            @_exportError
            <button type="button" class="btn-close" @onclick="@(() => _exportError = null)"></button>
        </div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3 align-items-end mb-2">
                <div class="col-md-4">
                    <label class="form-label">Saved views</label>
                    <SfDropDownList TValue="Guid?"
                                    TItem="SavedViewOption"
                                    DataSource="@_savedViewOptions"
                                    Value="@_selectedViewId"
                                    ValueChanged="OnSavedViewSelectedAsync"
                                    Placeholder="Select a saved view"
                                    AllowFiltering="true"
                                    ShowClearButton="true">
                        <DropDownListFieldSettings Value="Id" Text="DisplayText" />
                    </SfDropDownList>
                </div>
                @if (_selectedView is not null)
                {
                    <div class="col-md-auto d-flex gap-2 pb-1">
                        <SfButton OnClick="StartRename">Rename</SfButton>
                        <SfButton Disabled="_selectedView.IsDefault" OnClick="SetDefaultAsync">Set default</SfButton>
                        <SfButton CssClass="e-outline e-small e-danger" OnClick="DeleteSelectedViewAsync">Delete</SfButton>
                    </div>
                }
                <div class="col-md-auto pb-1">
                    <SfButton OnClick="@(() => _showSaveAs = !_showSaveAs)">Save current filters as view</SfButton>
                </div>
            </div>
            @if (_showSaveAs)
            {
                <div class="row g-3 align-items-end mb-2">
                    <div class="col-md-4">
                        <HrTextBox @bind-Value="_newViewName" Placeholder="View name" />
                    </div>
                    <div class="col-md-auto pb-1 d-flex gap-2">
                        <SfButton IsPrimary="true" Disabled="@(string.IsNullOrWhiteSpace(_newViewName))" OnClick="SaveCurrentAsViewAsync">Save</SfButton>
                        <SfButton OnClick="@(() => _showSaveAs = false)">Cancel</SfButton>
                    </div>
                </div>
            }
            @if (_showRename)
            {
                <div class="row g-3 align-items-end mb-2">
                    <div class="col-md-4">
                        <HrTextBox @bind-Value="_renameViewName" Placeholder="View name" />
                    </div>
                    <div class="col-md-auto pb-1 d-flex gap-2">
                        <SfButton IsPrimary="true" Disabled="@(string.IsNullOrWhiteSpace(_renameViewName))" OnClick="ConfirmRenameAsync">Save name</SfButton>
                        <SfButton OnClick="@(() => _showRename = false)">Cancel</SfButton>
                    </div>
                </div>
            }
            @if (_savedViewError is not null)
            {
                <div class="alert alert-danger alert-dismissible py-2">
                    @_savedViewError
                    <button type="button" class="btn-close" @onclick="@(() => _savedViewError = null)"></button>
                </div>
            }

            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Event type</label>
                    <HrTextBox @bind-Value="_eventType" Placeholder="Any event type" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <SfDropDownList TValue="string?"
                                    TItem="StatusOption"
                                    DataSource="@_statusOptions"
                                    @bind-Value="_status">
                        <DropDownListFieldSettings Value="Value" Text="Label" />
                    </SfDropDownList>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Actor user ID</label>
                    <HrTextBox @bind-Value="_actorUserId" Placeholder="Any actor" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Employee ID</label>
                    <HrTextBox @bind-Value="_employeeId" Placeholder="Any employee" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">From date</label>
                    <SfDatePicker TValue="DateOnly?" @bind-Value="_fromDate" Format="dd/MM/yyyy" Placeholder="dd/mm/yyyy" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">To date</label>
                    <SfDatePicker TValue="DateOnly?" @bind-Value="_toDate" Format="dd/MM/yyyy" Placeholder="dd/mm/yyyy" />
                </div>
            </div>

            @if (_filterError is not null)
            {
                <div class="alert alert-warning py-2 mt-2 mb-0">@_filterError</div>
            }

            <div class="mt-3 d-flex gap-2">
                <SfButton IsPrimary="true" OnClick="ApplyFiltersAsync">Apply filters</SfButton>
                <SfButton OnClick="ClearFiltersAsync">Clear</SfButton>
            </div>
        </div>
    </div>

    @if (_isLoading)
    {
        <HrLoadingIndicator Label="Loading report…" />
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else
    {
        @if (_isTruncated)
        {
            <div class="alert alert-warning">
                Showing the first @_items.Count of @_totalCount events. Narrow the filters to see the rest.
            </div>
        }

        <HrGrid TValue="GovernanceAuditReportRowModel"
                Toolbar="@Toolbar"
                DataSource="@_items"
                TotalItemCount="@_totalCount"
                AllowPaging="true"
                AllowSorting="true">
            <GridEvents TValue="GovernanceAuditReportRowModel" OnActionBegin="OnGridActionBeginAsync" />
            <GridPageSettings PageSize="@PageSize" />
            <GridColumns>
                <GridColumn Field="@nameof(GovernanceAuditReportRowModel.OccurredAt)" HeaderText="Occurred" Width="170" Format="g" />
                <GridColumn Field="@nameof(GovernanceAuditReportRowModel.EventType)" HeaderText="Event Type" Width="170" />
                <GridColumn Field="@nameof(GovernanceAuditReportRowModel.EntityType)" HeaderText="Entity Type" Width="150" />
                <GridColumn Field="@nameof(GovernanceAuditReportRowModel.ActorEmail)" HeaderText="Actor" Width="200" />
                <GridColumn Field="@nameof(GovernanceAuditReportRowModel.Status)" HeaderText="Status" Width="110" />
                <GridColumn Field="@nameof(GovernanceAuditReportRowModel.Summary)" HeaderText="Summary" Width="280" />
            </GridColumns>
        </HrGrid>

        <div class="mt-3">@_totalCount event(s)</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Description { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string CatalogId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public Func<Guid, GovernanceAuditReportFilter, Task<(GetGovernanceAuditReportResponse? Response, string? Error)>> Load { get; set; } = default!;
    [Parameter, EditorRequired] public Func<Guid, GovernanceAuditReportFilter, ReportExportFormat, Task<(byte[]? Bytes, string? ContentType, string? FileName, string? Error)>> Export { get; set; } = default!;

    private List<GovernanceAuditReportRowModel> _items = [];
    private int _totalCount;
    private bool _isTruncated;
    private int _page = 1;
    private const int PageSize = 20;

    private bool _isLoading = true;
    private string? _error;
    private string? _exportError;
    private string? _filterError;

    private string? _eventType;
    private string? _status;
    private string? _actorUserId;
    private string? _employeeId;
    private DateOnly? _fromDate;
    private DateOnly? _toDate;

    private GovernanceAuditReportFilter _appliedFilter = new();

    private sealed record StatusOption(string? Value, string Label);
    private static readonly StatusOption[] _statusOptions =
    [
        new(null, "Any status"),
        new("Success", "Success"),
        new("Failed", "Failed"),
    ];

    private sealed record SavedViewOption(Guid Id, string DisplayText, SavedReportViewModel View);
    private sealed record SavedFilterState(
        string? EventType,
        string? Status,
        string? ActorUserId,
        string? EmployeeId,
        DateOnly? FromDate,
        DateOnly? ToDate);

    private List<SavedReportViewModel> _savedViews = [];
    private List<SavedViewOption> _savedViewOptions = [];
    private Guid? _selectedViewId;
    private SavedReportViewModel? _selectedView;
    private string? _savedViewError;
    private bool _showSaveAs;
    private string _newViewName = string.Empty;
    private bool _showRename;
    private string _renameViewName = string.Empty;

    private bool _isFavourite;

    private string? _loadedForCatalogId;

    protected override async Task OnParametersSetAsync()
    {
        // Guarded by the host page; this component only renders once access is confirmed.
        if (_loadedForCatalogId == CatalogId) return;
        _loadedForCatalogId = CatalogId;

        await LoadAsync();
        await LoadSavedViewsAsync();
        await LoadFavouriteAsync();
    }

    private bool TryBuildFilter(out GovernanceAuditReportFilter filter)
    {
        _filterError = null;
        Guid? actor = null;
        Guid? employee = null;

        if (!string.IsNullOrWhiteSpace(_actorUserId))
        {
            if (Guid.TryParse(_actorUserId.Trim(), out var a)) actor = a;
            else { _filterError = "Actor user ID must be a valid GUID."; filter = _appliedFilter; return false; }
        }

        if (!string.IsNullOrWhiteSpace(_employeeId))
        {
            if (Guid.TryParse(_employeeId.Trim(), out var e)) employee = e;
            else { _filterError = "Employee ID must be a valid GUID."; filter = _appliedFilter; return false; }
        }

        filter = new GovernanceAuditReportFilter(
            ActorUserId: actor,
            EventType: string.IsNullOrWhiteSpace(_eventType) ? null : _eventType.Trim(),
            EmployeeId: employee,
            FromDate: _fromDate,
            ToDate: _toDate,
            Status: _status,
            Page: _page,
            PageSize: PageSize);
        return true;
    }

    private async Task ApplyFiltersAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _eventType = null;
        _status = null;
        _actorUserId = null;
        _employeeId = null;
        _fromDate = null;
        _toDate = null;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnGridActionBeginAsync(Syncfusion.Blazor.Grids.ActionEventArgs<GovernanceAuditReportRowModel> args)
    {
        if (args.RequestType != Syncfusion.Blazor.Grids.Action.Paging) return;
        args.Cancel = true;
        _page = args.CurrentPage;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!TryBuildFilter(out var filter))
        {
            StateHasChanged();
            return;
        }

        _isLoading = true;
        _error = null;
        StateHasChanged();

        _appliedFilter = filter;
        var (response, error) = await Load(CompanyId, filter);
        if (response is null)
        {
            _error = error ?? "Failed to load the report.";
        }
        else
        {
            _items = response.Items;
            _totalCount = response.TotalCount;
            _isTruncated = response.IsTruncated;
        }

        _isLoading = false;
        StateHasChanged();
    }

    // ── Export ───────────────────────────────────────────────────────────────

    private RenderFragment ExportMenuTemplate => @<ExportMenu OnItemSelected="HandleExportItemSelected" />;

    private IEnumerable<object> Toolbar => new List<object>
    {
        "Print",
        new Syncfusion.Blazor.Navigations.ItemModel { Id = "export", Type = Syncfusion.Blazor.Navigations.ItemType.Input, Template = ExportMenuTemplate, TooltipText = "Export" },
    };

    private async Task HandleExportItemSelected(string id)
    {
        var format = id switch
        {
            "hr-csv" => ReportExportFormat.Csv,
            "hr-excel" => ReportExportFormat.Excel,
            "hr-pdf" => ReportExportFormat.Pdf,
            _ => ReportExportFormat.Csv,
        };

        if (!TryBuildFilter(out var filter))
        {
            StateHasChanged();
            return;
        }

        _exportError = null;
        StateHasChanged();

        var (bytes, contentType, fileName, error) = await Export(CompanyId, filter, format);
        if (bytes is null)
        {
            _exportError = error ?? "Failed to export the report.";
        }
        else
        {
            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                fileName ?? $"{CatalogId}.{format.ToString().ToLowerInvariant()}",
                contentType ?? "application/octet-stream",
                Convert.ToBase64String(bytes));
        }

        StateHasChanged();
    }

    // ── Favourites ───────────────────────────────────────────────────────────

    private async Task LoadFavouriteAsync()
    {
        var response = await ReportingService.GetReportFavouritesAsync(CompanyId);
        _isFavourite = response?.ReportIds.Contains(CatalogId) ?? false;
    }

    private async Task ToggleFavouriteAsync()
    {
        var success = _isFavourite
            ? await ReportingService.RemoveReportFavouriteAsync(CompanyId, CatalogId)
            : await ReportingService.AddReportFavouriteAsync(CompanyId, CatalogId);
        if (success) _isFavourite = !_isFavourite;
    }

    // ── Saved views ──────────────────────────────────────────────────────────

    private async Task LoadSavedViewsAsync()
    {
        var response = await ReportingService.GetReportViewsAsync(CompanyId, CatalogId);
        _savedViews = response?.Views ?? [];
        _savedViewOptions = _savedViews
            .Select(v => new SavedViewOption(v.Id, v.IsDefault ? $"{v.Name} (Default)" : v.Name, v))
            .OrderBy(o => o.View.Name)
            .ToList();
    }

    private async Task OnSavedViewSelectedAsync(Guid? viewId)
    {
        _selectedViewId = viewId;
        _showRename = false;
        _selectedView = _savedViews.FirstOrDefault(v => v.Id == viewId);
        if (_selectedView is null) return;

        try
        {
            var state = JsonSerializer.Deserialize<SavedFilterState>(_selectedView.FilterCriteriaJson);
            if (state is not null)
            {
                _eventType = state.EventType;
                _status = state.Status;
                _actorUserId = state.ActorUserId;
                _employeeId = state.EmployeeId;
                _fromDate = state.FromDate;
                _toDate = state.ToDate;
            }
        }
        catch (JsonException)
        {
            _savedViewError = "Failed to apply the saved view's filters.";
            return;
        }

        _page = 1;
        await LoadAsync();
    }

    private SavedFilterState BuildSavedFilterState() => new(
        _eventType, _status, _actorUserId, _employeeId, _fromDate, _toDate);

    private async Task SaveCurrentAsViewAsync()
    {
        if (string.IsNullOrWhiteSpace(_newViewName)) return;

        _savedViewError = null;
        var json = JsonSerializer.Serialize(BuildSavedFilterState());
        var request = new SaveReportViewRequest(CatalogId, _newViewName.Trim(), json, null);
        var (result, error) = await ReportingService.SaveReportViewAsync(CompanyId, request);
        if (result is null)
        {
            _savedViewError = error ?? "Failed to save the current filters as a view.";
            return;
        }

        _newViewName = string.Empty;
        _showSaveAs = false;
        await LoadSavedViewsAsync();
        _selectedViewId = result.Id;
        _selectedView = _savedViews.FirstOrDefault(v => v.Id == result.Id);
    }

    private void StartRename()
    {
        if (_selectedView is null) return;
        _renameViewName = _selectedView.Name;
        _showRename = true;
    }

    private async Task ConfirmRenameAsync()
    {
        if (_selectedView is null || string.IsNullOrWhiteSpace(_renameViewName)) return;

        _savedViewError = null;
        var (result, error) = await ReportingService.RenameReportViewAsync(CompanyId, _selectedView.Id, _renameViewName.Trim());
        if (result is null)
        {
            _savedViewError = error ?? "Failed to rename the saved view.";
            return;
        }

        _showRename = false;
        await LoadSavedViewsAsync();
        _selectedView = _savedViews.FirstOrDefault(v => v.Id == result.Id);
    }

    private async Task SetDefaultAsync()
    {
        if (_selectedView is null) return;

        _savedViewError = null;
        if (!await ReportingService.SetDefaultReportViewAsync(CompanyId, _selectedView.Id))
        {
            _savedViewError = "Failed to set the saved view as default.";
            return;
        }

        await LoadSavedViewsAsync();
        _selectedView = _savedViews.FirstOrDefault(v => v.Id == _selectedViewId);
    }

    private async Task DeleteSelectedViewAsync()
    {
        if (_selectedView is null) return;

        _savedViewError = null;
        if (!await ReportingService.DeleteReportViewAsync(CompanyId, _selectedView.Id))
        {
            _savedViewError = "Failed to delete the saved view.";
            return;
        }

        _selectedViewId = null;
        _selectedView = null;
        _showRename = false;
        await LoadSavedViewsAsync();
    }
}
