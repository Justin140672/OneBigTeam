@page "/companies/{CompanyId:guid}/reporting/hr-headcount-summary"
@rendermode InteractiveServer
@using HR.Infrastructure.Abstractions
@using HR.Web.Components.Controls
@using HR.Web.Models
@using HR.Web.Services
@inject ReportingService ReportingService
@inject IJSRuntime JS

<PageTitle>HR Headcount Summary Report</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">HR Headcount Summary</h1>
    <p class="text-muted mb-3">Company-wide headcount broken down by department, location, employment type and status.</p>

    @if (_exportError is not null)
    {
        <div class="alert alert-danger alert-dismissible">
            @_exportError
            <button type="button" class="btn-close" @onclick="@(() => _exportError = null)"></button>
        </div>
    }

    <ReportFilterPanel CompanyId="CompanyId"
                        ReportId="hr-headcount-summary"
                        OnFilterChanged="OnFilterChangedAsync"
                        OnViewDeleted="LoadAsync"
                        ShowDepartmentFilter="true"
                        ShowLocationFilter="true"
                        ShowPositionProfileFilter="false"
                        ShowManagerFilter="false"
                        ShowEmploymentTypeFilter="true"
                        ShowStatusFilter="true" />

    @if (_isLoading)
    {
        <HrLoadingIndicator Label="Loading HR headcount summary…" />
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else
    {
        <div class="row g-3 mb-3">
            <div class="col-md-2">
                <div class="card"><div class="card-body"><div class="text-muted small">Total Headcount</div><div class="fs-4">@_totalHeadcount</div></div></div>
            </div>
            <div class="col-md-2">
                <div class="card"><div class="card-body"><div class="text-muted small">Active Employees</div><div class="fs-4">@_activeEmployees</div></div></div>
            </div>
            <div class="col-md-2">
                <div class="card"><div class="card-body"><div class="text-muted small">Future Starters</div><div class="fs-4">@_futureStarters</div></div></div>
            </div>
            <div class="col-md-2">
                <div class="card"><div class="card-body"><div class="text-muted small">Leavers</div><div class="fs-4">@_leavers</div></div></div>
            </div>
            <div class="col-md-2">
                <div class="card"><div class="card-body"><div class="text-muted small">Total FTE</div><div class="fs-4">@_totalFte</div></div></div>
            </div>
        </div>

        <HrGrid TValue="HrHeadcountSummaryReportItemModel"
                Toolbar="@Toolbar"
                DataSource="@_items"
                AllowPaging="true"
                AllowSorting="true"
                AllowGrouping="true">
            <GridColumns>
                <GridColumn Field="@nameof(HrHeadcountSummaryReportItemModel.EmployeeName)" HeaderText="Employee" Width="180" />
                <GridColumn Field="@nameof(HrHeadcountSummaryReportItemModel.Department)" HeaderText="Department" Width="150" />
                <GridColumn Field="@nameof(HrHeadcountSummaryReportItemModel.Location)" HeaderText="Location" Width="150" />
                <GridColumn Field="@nameof(HrHeadcountSummaryReportItemModel.Position)" HeaderText="Position" Width="150" />
                <GridColumn Field="@nameof(HrHeadcountSummaryReportItemModel.EmploymentType)" HeaderText="Employment Type" Width="150" />
                <GridColumn Field="@nameof(HrHeadcountSummaryReportItemModel.Status)" HeaderText="Status" Width="120" />
                <GridColumn Field="@nameof(HrHeadcountSummaryReportItemModel.StartDate)" HeaderText="Start Date" Width="120" Format="d" />
                <GridColumn Field="@nameof(HrHeadcountSummaryReportItemModel.LeavingDate)" HeaderText="Leaving Date" Width="120" Format="d" />
                <GridColumn Field="@nameof(HrHeadcountSummaryReportItemModel.Fte)" HeaderText="FTE" Width="100" />
            </GridColumns>
        </HrGrid>

        <div class="mt-3">@_items.Count employee(s)</div>
    }
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }

    private List<HrHeadcountSummaryReportItemModel> _items = [];
    private int _totalHeadcount;
    private int _activeEmployees;
    private int _futureStarters;
    private int _leavers;
    private decimal _totalFte;

    private bool _isLoading = true;
    private string? _error;

    private EmployeeDirectoryReportFilter _currentFilter = new();

    private bool _exporting;
    private string? _exportError;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task OnFilterChangedAsync(EmployeeDirectoryReportFilter filter)
    {
        _currentFilter = filter;
        await LoadAsync();
    }

    private HrHeadcountSummaryReportFilter BuildServiceFilter() => new(
        DepartmentId: _currentFilter.DepartmentId,
        LocationId: _currentFilter.LocationId,
        EmploymentTypeId: _currentFilter.EmploymentTypeId,
        EmployeeStatus: _currentFilter.EmployeeStatus);

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        StateHasChanged();

        var (response, error) = await ReportingService.GetHrHeadcountSummaryReportAsync(CompanyId, BuildServiceFilter());
        if (response is null)
        {
            _error = error ?? "Failed to load the HR headcount summary report.";
        }
        else
        {
            _items = response.Items;
            _totalHeadcount = response.TotalHeadcount;
            _activeEmployees = response.ActiveEmployees;
            _futureStarters = response.FutureStarters;
            _leavers = response.Leavers;
            _totalFte = response.TotalFte;
        }

        _isLoading = false;
    }

    private RenderFragment ExportMenuTemplate => @<ExportMenu OnItemSelected="HandleExportItemSelected" />;

    private IEnumerable<object> Toolbar => new List<object>
    {
        "Print",
        new Syncfusion.Blazor.Navigations.ItemModel { Id = "export", Type = Syncfusion.Blazor.Navigations.ItemType.Input, Template = ExportMenuTemplate, TooltipText = "Export" },
    };

    private async Task HandleExportItemSelected(string id)
    {
        var format = id switch
        {
            "hr-csv" => ReportExportFormat.Csv,
            "hr-excel" => ReportExportFormat.Excel,
            "hr-pdf" => ReportExportFormat.Pdf,
            _ => ReportExportFormat.Csv,
        };

        _exporting = true;
        _exportError = null;
        StateHasChanged();

        var (bytes, contentType, fileName, error) =
            await ReportingService.ExportHrHeadcountSummaryReportAsync(CompanyId, BuildServiceFilter(), format);

        if (bytes is null)
        {
            _exportError = error ?? "Failed to export the HR headcount summary report.";
        }
        else
        {
            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                fileName ?? $"hr-headcount-summary.{format.ToString().ToLowerInvariant()}",
                contentType ?? "application/octet-stream",
                Convert.ToBase64String(bytes));
        }

        _exporting = false;
        StateHasChanged();
    }
}
