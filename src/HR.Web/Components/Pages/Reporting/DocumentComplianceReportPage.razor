@page "/companies/{CompanyId:guid}/reporting/document-compliance"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject AppSession Session
@using HR.Infrastructure.Abstractions
@using HR.Web.Models
@using HR.Web.Services
@inject ReportingService ReportingService
@inject PositionProfileService PositionProfileService
@inject IJSRuntime JS

<PageTitle>Document Compliance Report</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Document Compliance</h1>
    <p class="text-muted mb-3">Required, uploaded, missing, expiring and expired documents per employee.</p>

    @if (_exportError is not null)
    {
        <div class="alert alert-danger alert-dismissible">
            @_exportError
            <button type="button" class="btn-close" @onclick="@(() => _exportError = null)"></button>
        </div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Position Profile</label>
                    <SfDropDownList TValue="Guid?"
                                    TItem="PositionProfileListItemModel"
                                    DataSource="@_positionProfiles"
                                    @bind-Value="_positionProfileId"
                                    Placeholder="All Positions"
                                    AllowFiltering="true">
                        <DropDownListFieldSettings Value="Id" Text="Title" />
                    </SfDropDownList>
                </div>
            </div>
            <div class="mt-3">
                <SfButton IsPrimary="true" OnClick="ApplyAsync">Apply Filters</SfButton>
            </div>
        </div>
    </div>

    @if (_isLoading)
    {
        <HrLoadingIndicator Label="Loading document compliance report…" />
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else
    {
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <div class="card"><div class="card-body"><div class="text-muted small">Total Employees</div><div class="fs-4">@_totalEmployees</div></div></div>
            </div>
            <div class="col-md-4">
                <div class="card"><div class="card-body"><div class="text-muted small">Total Missing</div><div class="fs-4">@_totalMissing</div></div></div>
            </div>
            <div class="col-md-2">
                <div class="card"><div class="card-body"><div class="text-muted small">Expiring Soon</div><div class="fs-4">@_totalExpiringSoon</div></div></div>
            </div>
            <div class="col-md-2">
                <div class="card"><div class="card-body"><div class="text-muted small">Expired</div><div class="fs-4">@_totalExpired</div></div></div>
            </div>
        </div>

        <HrGrid TValue="DocumentComplianceReportRowModel"
                Toolbar="@Toolbar"
                DataSource="@_items"
                AllowPaging="true"
                AllowSorting="true">
            <GridColumns>
                <GridColumn Field="@nameof(DocumentComplianceReportRowModel.EmployeeName)" HeaderText="Employee" Width="180" />
                <GridColumn Field="@nameof(DocumentComplianceReportRowModel.RequiredCount)" HeaderText="Required" Width="100" />
                <GridColumn Field="@nameof(DocumentComplianceReportRowModel.UploadedCount)" HeaderText="Uploaded" Width="100" />
                <GridColumn Field="@nameof(DocumentComplianceReportRowModel.MissingCount)" HeaderText="Missing" Width="100" />
                <GridColumn Field="@nameof(DocumentComplianceReportRowModel.ExpiringSoonCount)" HeaderText="Expiring Soon" Width="130" />
                <GridColumn Field="@nameof(DocumentComplianceReportRowModel.ExpiredCount)" HeaderText="Expired" Width="100" />
                <GridColumn HeaderText="Missing Documents" Width="220">
                    <Template>
                        @{
                            var item = (DocumentComplianceReportRowModel)context;
                        }
                        @if (item.MissingDocumentTypeNames.Count == 0)
                        {
                            <span class="text-muted">None</span>
                        }
                        else
                        {
                            <span class="badge bg-danger" title="@string.Join("; ", item.MissingDocumentTypeNames)">@item.MissingDocumentTypeNames.Count missing</span>
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </HrGrid>

        <div class="mt-3">@_items.Count employee(s)</div>
    }
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }

    private List<DocumentComplianceReportRowModel> _items = [];
    private int _totalEmployees;
    private int _totalMissing;
    private int _totalExpiringSoon;
    private int _totalExpired;

    private List<PositionProfileListItemModel> _positionProfiles = [];
    private Guid? _positionProfileId;

    private bool _isLoading = true;
    private string? _error;

    private bool _exporting;
    private string? _exportError;

    protected override async Task OnParametersSetAsync()
    {
        if (!AppSession.GuardAccess(Navigation, Session.CanViewHrReports))
            return;
        var positionProfilesResponse = await PositionProfileService.ListPositionProfilesAsync(CompanyId);
        _positionProfiles = positionProfilesResponse?.Items.ToList() ?? [];

        await LoadAsync();
    }

    private DocumentComplianceReportFilter BuildFilter() => new(PositionProfileId: _positionProfileId);

    private async Task ApplyAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        StateHasChanged();

        var response = await ReportingService.GetDocumentComplianceReportAsync(CompanyId, BuildFilter());
        if (response is null)
        {
            _error = "Failed to load the document compliance report.";
        }
        else
        {
            _items = response.Items;
            _totalEmployees = response.TotalEmployees;
            _totalMissing = response.TotalMissing;
            _totalExpiringSoon = response.TotalExpiringSoon;
            _totalExpired = response.TotalExpired;
        }

        _isLoading = false;
    }

    private RenderFragment ExportMenuTemplate => @<ExportMenu OnItemSelected="HandleExportItemSelected" />;

    private IEnumerable<object> Toolbar => new List<object>
    {
        "Print",
        new Syncfusion.Blazor.Navigations.ItemModel { Id = "export", Type = Syncfusion.Blazor.Navigations.ItemType.Input, Template = ExportMenuTemplate, TooltipText = "Export" },
    };

    private async Task HandleExportItemSelected(string id)
    {
        var format = id switch
        {
            "hr-csv" => ReportExportFormat.Csv,
            "hr-excel" => ReportExportFormat.Excel,
            "hr-pdf" => ReportExportFormat.Pdf,
            _ => ReportExportFormat.Csv,
        };

        _exporting = true;
        _exportError = null;
        StateHasChanged();

        var (bytes, contentType, fileName, error) =
            await ReportingService.ExportDocumentComplianceReportAsync(CompanyId, BuildFilter(), format);

        if (bytes is null)
        {
            _exportError = error ?? "Failed to export the document compliance report.";
        }
        else
        {
            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                fileName ?? $"document-compliance-report.{format.ToString().ToLowerInvariant()}",
                contentType ?? "application/octet-stream",
                Convert.ToBase64String(bytes));
        }

        _exporting = false;
        StateHasChanged();
    }
}
