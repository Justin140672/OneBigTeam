@page "/companies/{CompanyId:guid}/reporting/employee-starters"
@rendermode InteractiveServer
@using HR.Infrastructure.Abstractions
@using HR.Web.Components.Controls
@using HR.Web.Models
@using HR.Web.Services
@inject ReportingService ReportingService
@inject IJSRuntime JS

<PageTitle>Employee Starter Report</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Employee Starters</h1>
    <p class="text-muted mb-3">Employees who started within the selected date range, including onboarding and probation status.</p>

    @if (_exportError is not null)
    {
        <div class="alert alert-danger alert-dismissible">
            @_exportError
            <button type="button" class="btn-close" @onclick="@(() => _exportError = null)"></button>
        </div>
    }

    <ReportFilterPanel CompanyId="CompanyId"
                        ReportId="employee-starters"
                        OnCriteriaChanged="OnFilterChangedAsync"
                        OnViewDeleted="LoadAsync"
                        ShowManagerFilter="false"
                        ShowStatusFilter="false"
                        DateRangeStartLabel="Start Date From"
                        DateRangeEndLabel="Start Date To"
                        DefaultDateRangeStart="@_defaultStartDate" />

    @if (_isLoading)
    {
        <HrLoadingIndicator Label="Loading employee starters…" />
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else
    {
        <HrGrid TValue="EmployeeStarterReportItemModel"
                Toolbar="@Toolbar"
                DataSource="@_items"
                TotalItemCount="@_totalCount"
                AllowPaging="true"
                AllowSorting="true">
            <GridEvents TValue="EmployeeStarterReportItemModel" OnActionBegin="OnGridActionBeginAsync" />
            <GridPageSettings PageSize="@PageSize" />
            <GridColumns>
                <GridColumn Field="@nameof(EmployeeStarterReportItemModel.Name)" HeaderText="Name" Width="180" />
                <GridColumn Field="@nameof(EmployeeStarterReportItemModel.StartDate)" HeaderText="Start Date" Width="120" Format="d" />
                <GridColumn Field="@nameof(EmployeeStarterReportItemModel.Recruiter)" HeaderText="Recruiter" Width="150" />
                <GridColumn Field="@nameof(EmployeeStarterReportItemModel.Department)" HeaderText="Department" Width="160" />
                <GridColumn Field="@nameof(EmployeeStarterReportItemModel.Position)" HeaderText="Position" Width="160" />
                <GridColumn Field="@nameof(EmployeeStarterReportItemModel.OnboardingStatus)" HeaderText="Onboarding Status" Width="150" />
                <GridColumn Field="@nameof(EmployeeStarterReportItemModel.ProbationStatus)" HeaderText="Probation Status" Width="150" />
            </GridColumns>
        </HrGrid>

        <div class="mt-3">@_totalCount employee(s)</div>
    }
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }

    private List<EmployeeStarterReportItemModel> _items = [];
    private int _totalCount;
    private int _page = 1;
    private const int PageSize = 20;
    private string? _sortBy;
    private bool _sortDescending;

    private bool _isLoading = true;
    private string? _error;

    // Defaults the Start Date filter to the 1st of the current month so the report opens already
    // scoped to "this month's starters" rather than every starter ever recorded.
    private readonly DateOnly _defaultStartDate = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private ReportFilterCriteriaModel _currentFilter = null!;

    private bool _exporting;
    private string? _exportError;

    protected override async Task OnParametersSetAsync()
    {
        _currentFilter ??= new ReportFilterCriteriaModel(DateRangeStart: _defaultStartDate);
        await LoadAsync();
    }

    private async Task OnFilterChangedAsync(ReportFilterCriteriaModel filter)
    {
        _currentFilter = filter;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnGridActionBeginAsync(Syncfusion.Blazor.Grids.ActionEventArgs<EmployeeStarterReportItemModel> args)
    {
        if (args.RequestType == Syncfusion.Blazor.Grids.Action.Paging)
        {
            _page = args.CurrentPage;
        }
        else if (args.RequestType == Syncfusion.Blazor.Grids.Action.Sorting)
        {
            _sortBy = args.ColumnName;
            _sortDescending = args.ColumnName is not null && args.Direction == Syncfusion.Blazor.Grids.SortDirection.Descending;
            _page = 1;
        }
        else
        {
            return;
        }

        // See EmployeeDirectoryReportPage's OnGridActionBeginAsync — externally/server-paged grid,
        // must cancel the grid's own built-in paging/sorting so it doesn't also process the small
        // returned page locally and clobber header/pager UI state after the reload.
        args.Cancel = true;

        await LoadAsync();
    }

    private EmployeeStarterReportFilter BuildServiceFilter() => new(
        DepartmentId: _currentFilter.DepartmentId,
        LocationId: _currentFilter.LocationId,
        PositionProfileId: _currentFilter.PositionProfileId,
        EmploymentTypeId: _currentFilter.EmploymentTypeId,
        DateRangeStart: _currentFilter.DateRangeStart,
        DateRangeEnd: _currentFilter.DateRangeEnd,
        Page: _page,
        PageSize: PageSize,
        SortBy: _sortBy,
        SortDescending: _sortDescending);

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        StateHasChanged();

        var response = await ReportingService.GetEmployeeStarterReportAsync(CompanyId, BuildServiceFilter());
        if (response is null)
        {
            _error = "Failed to load the employee starter report.";
        }
        else
        {
            _items = response.Items;
            _totalCount = response.TotalCount;
        }

        _isLoading = false;
    }

    private RenderFragment ExportMenuTemplate => @<ExportMenu OnItemSelected="HandleExportItemSelected" />;

    private IEnumerable<object> Toolbar => new List<object>
    {
        "Print",
        new Syncfusion.Blazor.Navigations.ItemModel { Id = "export", Type = Syncfusion.Blazor.Navigations.ItemType.Input, Template = ExportMenuTemplate, TooltipText = "Export" },
    };

    private async Task HandleExportItemSelected(string id)
    {
        var format = id switch
        {
            "hr-csv" => ReportExportFormat.Csv,
            "hr-excel" => ReportExportFormat.Excel,
            "hr-pdf" => ReportExportFormat.Pdf,
            _ => ReportExportFormat.Csv,
        };

        _exporting = true;
        _exportError = null;
        StateHasChanged();

        var (bytes, contentType, fileName, error) =
            await ReportingService.ExportEmployeeStarterReportAsync(CompanyId, BuildServiceFilter(), format);

        if (bytes is null)
        {
            _exportError = error ?? "Failed to export the employee starter report.";
        }
        else
        {
            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                fileName ?? $"employee-starters.{format.ToString().ToLowerInvariant()}",
                contentType ?? "application/octet-stream",
                Convert.ToBase64String(bytes));
        }

        _exporting = false;
        StateHasChanged();
    }
}
