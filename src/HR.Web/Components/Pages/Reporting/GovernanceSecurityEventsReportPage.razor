@page "/companies/{CompanyId:guid}/reporting/governance/security-events"
@rendermode InteractiveServer
@using HR.Web.Models
@using HR.Web.Services
@inject ReportingService ReportingService
@inject NavigationManager Navigation
@inject AppSession Session

<PageTitle>Security Events Report</PageTitle>

@if (_allowed)
{
    <GovernanceAuditReport CompanyId="CompanyId"
                           Title="Security Events"
                           Description="Security-relevant events across the company — sign-in attempts, permission changes and access failures — with the acting user, outcome and a summary."
                           CatalogId="governance-security-events"
                           Load="(id, f) => ReportingService.GetGovernanceSecurityEventsReportAsync(id, f)"
                           Export="(id, f, fmt) => ReportingService.ExportGovernanceSecurityEventsReportAsync(id, f, fmt)" />
}

@code {
    [Parameter] public Guid CompanyId { get; set; }

    private bool _allowed;

    protected override void OnParametersSet()
        => _allowed = AppSession.GuardAccess(Navigation, Session.CanViewGovernanceReporting);
}
