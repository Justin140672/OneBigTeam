@page "/companies/{CompanyId:guid}/reporting/asset-assignment"
@rendermode InteractiveServer
@using HR.Infrastructure.Abstractions
@using HR.Web.Models
@using HR.Web.Services
@inject ReportingService ReportingService
@inject IJSRuntime JS

<PageTitle>Asset Assignment Report</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-start mb-1">
        <h1 class="mb-1">Asset Assignment Report</h1>
        <SfDropDownButton Content="Export" IconCss="fa-solid fa-download" CssClass="e-flat" Items="_exportItems" Disabled="_exporting">
            <DropDownButtonEvents ItemSelected="HandleExportSelected" />
        </SfDropDownButton>
    </div>
    <p class="text-muted mb-3">Assets assigned to employees including serial number, assigned date and return status.</p>

    @if (_exportError is not null)
    {
        <div class="alert alert-danger alert-dismissible">
            @_exportError
            <button type="button" class="btn-close" @onclick="@(() => _exportError = null)"></button>
        </div>
    }

    @if (_isLoading)
    {
        <HrLoadingIndicator Label="Loading asset assignment report…" />
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else
    {
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <div class="card"><div class="card-body"><div class="text-muted small">Total Assignments</div><div class="fs-4">@_totalAssignments</div></div></div>
            </div>
        </div>

        <HrGrid TValue="AssetAssignmentReportRowModel"
                DataSource="@_items"
                AllowPaging="true"
                AllowSorting="true">
            <GridColumns>
                <GridColumn Field="@nameof(AssetAssignmentReportRowModel.EmployeeName)" HeaderText="Employee" Width="180" />
                <GridColumn Field="@nameof(AssetAssignmentReportRowModel.AssetName)" HeaderText="Asset" Width="200" />
                <GridColumn Field="@nameof(AssetAssignmentReportRowModel.SerialNumber)" HeaderText="Serial Number" Width="160" />
                <GridColumn Field="@nameof(AssetAssignmentReportRowModel.AssignedDate)" HeaderText="Assigned Date" Width="150" Format="d" />
                <GridColumn HeaderText="Return Status" Width="130">
                    <Template>
                        @{
                            var item = (AssetAssignmentReportRowModel)context;
                        }
                        <span class="badge @(item.ReturnStatus == "Returned" ? "bg-secondary" : "bg-success")">@item.ReturnStatus</span>
                    </Template>
                </GridColumn>
            </GridColumns>
        </HrGrid>

        <div class="mt-3">@_items.Count assignment(s)</div>
    }
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }

    private List<AssetAssignmentReportRowModel> _items = [];
    private int _totalAssignments;

    private bool _isLoading = true;
    private string? _error;

    private bool _exporting;
    private string? _exportError;

    private static readonly List<Syncfusion.Blazor.SplitButtons.DropDownMenuItem> _exportItems =
    [
        new() { Id = "csv", Text = "CSV", IconCss = "fa-solid fa-file-csv" },
        new() { Id = "excel", Text = "Excel", IconCss = "fa-solid fa-file-excel" },
        new() { Id = "pdf", Text = "PDF", IconCss = "fa-solid fa-file-pdf" },
    ];

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        StateHasChanged();

        var response = await ReportingService.GetAssetAssignmentReportAsync(CompanyId);
        if (response is null)
        {
            _error = "Failed to load the asset assignment report.";
        }
        else
        {
            _items = response.Items;
            _totalAssignments = response.TotalAssignments;
        }

        _isLoading = false;
    }

    private async Task HandleExportSelected(Syncfusion.Blazor.SplitButtons.MenuEventArgs args)
    {
        if (args.Item?.Id is not { } id) return;

        var format = id switch
        {
            "csv" => ReportExportFormat.Csv,
            "excel" => ReportExportFormat.Excel,
            "pdf" => ReportExportFormat.Pdf,
            _ => ReportExportFormat.Csv,
        };

        _exporting = true;
        _exportError = null;
        StateHasChanged();

        var (bytes, contentType, fileName, error) =
            await ReportingService.ExportAssetAssignmentReportAsync(CompanyId, format);

        if (bytes is null)
        {
            _exportError = error ?? "Failed to export the asset assignment report.";
        }
        else
        {
            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                fileName ?? $"asset-assignment-report.{format.ToString().ToLowerInvariant()}",
                contentType ?? "application/octet-stream",
                Convert.ToBase64String(bytes));
        }

        _exporting = false;
        StateHasChanged();
    }
}
