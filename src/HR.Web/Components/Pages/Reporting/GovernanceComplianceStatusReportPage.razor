@page "/companies/{CompanyId:guid}/reporting/governance/compliance-status"
@rendermode InteractiveServer
@using System.Text.Json
@using HR.Infrastructure.Abstractions
@using HR.Web.Components.Controls
@using HR.Web.Models
@using HR.Web.Services
@inject ReportingService ReportingService
@inject EmployeeService EmployeeService
@inject NavigationManager Navigation
@inject AppSession Session
@inject IJSRuntime JS

<PageTitle>Compliance Status Report</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-start mb-1">
        <h1 class="mb-0">Compliance Status</h1>
        <button type="button"
                class="btn btn-link p-0 fs-4 governance-favourite @(_isFavourite ? "governance-favourite--active" : "")"
                title="@(_isFavourite ? "Remove from favourites" : "Add to favourites")"
                @onclick="ToggleFavouriteAsync">
            <i class="@(_isFavourite ? "fa-solid" : "fa-regular") fa-star"></i>
        </button>
    </div>
    <p class="text-muted mb-3">Company-wide compliance obligations and their current status — outstanding, due soon or informational — by employee, category and due date.</p>

    @if (_exportError is not null)
    {
        <div class="alert alert-danger alert-dismissible">
            @_exportError
            <button type="button" class="btn-close" @onclick="@(() => _exportError = null)"></button>
        </div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3 align-items-end mb-2">
                <div class="col-md-4">
                    <label class="form-label">Saved views</label>
                    <SfDropDownList TValue="Guid?"
                                    TItem="SavedViewOption"
                                    DataSource="@_savedViewOptions"
                                    Value="@_selectedViewId"
                                    ValueChanged="OnSavedViewSelectedAsync"
                                    Placeholder="Select a saved view"
                                    AllowFiltering="true"
                                    ShowClearButton="true">
                        <DropDownListFieldSettings Value="Id" Text="DisplayText" />
                    </SfDropDownList>
                </div>
                @if (_selectedView is not null)
                {
                    <div class="col-md-auto d-flex gap-2 pb-1">
                        <SfButton OnClick="StartRename">Rename</SfButton>
                        <SfButton Disabled="_selectedView.IsDefault" OnClick="SetDefaultAsync">Set default</SfButton>
                        <SfButton CssClass="e-outline e-small e-danger" OnClick="DeleteSelectedViewAsync">Delete</SfButton>
                    </div>
                }
                <div class="col-md-auto pb-1">
                    <SfButton OnClick="@(() => _showSaveAs = !_showSaveAs)">Save current filters as view</SfButton>
                </div>
            </div>
            @if (_showSaveAs)
            {
                <div class="row g-3 align-items-end mb-2">
                    <div class="col-md-4"><HrTextBox @bind-Value="_newViewName" Placeholder="View name" /></div>
                    <div class="col-md-auto pb-1 d-flex gap-2">
                        <SfButton IsPrimary="true" Disabled="@(string.IsNullOrWhiteSpace(_newViewName))" OnClick="SaveCurrentAsViewAsync">Save</SfButton>
                        <SfButton OnClick="@(() => _showSaveAs = false)">Cancel</SfButton>
                    </div>
                </div>
            }
            @if (_showRename)
            {
                <div class="row g-3 align-items-end mb-2">
                    <div class="col-md-4"><HrTextBox @bind-Value="_renameViewName" Placeholder="View name" /></div>
                    <div class="col-md-auto pb-1 d-flex gap-2">
                        <SfButton IsPrimary="true" Disabled="@(string.IsNullOrWhiteSpace(_renameViewName))" OnClick="ConfirmRenameAsync">Save name</SfButton>
                        <SfButton OnClick="@(() => _showRename = false)">Cancel</SfButton>
                    </div>
                </div>
            }
            @if (_savedViewError is not null)
            {
                <div class="alert alert-danger alert-dismissible py-2">
                    @_savedViewError
                    <button type="button" class="btn-close" @onclick="@(() => _savedViewError = null)"></button>
                </div>
            }

            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Category</label>
                    <SfDropDownList TValue="string?"
                                    TItem="CategoryOption"
                                    DataSource="@_categoryOptions"
                                    Value="@_category"
                                    ValueChanged="OnCategoryChanged">
                        <DropDownListFieldSettings Value="Value" Text="Label" />
                    </SfDropDownList>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Severity</label>
                    <SfDropDownList TValue="string?"
                                    TItem="CategoryOption"
                                    DataSource="@_severityOptions"
                                    @bind-Value="_severity">
                        <DropDownListFieldSettings Value="Value" Text="Label" />
                    </SfDropDownList>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Department</label>
                    <SfDropDownList TValue="string?"
                                    TItem="CategoryOption"
                                    DataSource="@_departmentOptions"
                                    @bind-Value="_department"
                                    AllowFiltering="true">
                        <DropDownListFieldSettings Value="Value" Text="Label" />
                    </SfDropDownList>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Manager</label>
                    <SfDropDownList @ref="_managerDropdown"
                                    TValue="Guid?"
                                    TItem="EmployeeOption"
                                    DataSource="@_managerOptions"
                                    @bind-Value="_managerId"
                                    Placeholder="All managers"
                                    AllowFiltering="true">
                        <DropDownListFieldSettings Value="Id" Text="Name" />
                        <DropDownListEvents TValue="Guid?" TItem="EmployeeOption" Filtering="OnManagerFilteringAsync" />
                    </SfDropDownList>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Due date from</label>
                    <SfDatePicker TValue="DateOnly?" @bind-Value="_dueDateStart" Format="dd/MM/yyyy" Placeholder="dd/mm/yyyy" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Due date to</label>
                    <SfDatePicker TValue="DateOnly?" @bind-Value="_dueDateEnd" Format="dd/MM/yyyy" Placeholder="dd/mm/yyyy" />
                </div>
            </div>

            <div class="mt-3 d-flex gap-2">
                <SfButton IsPrimary="true" OnClick="ApplyFiltersAsync">Apply filters</SfButton>
                <SfButton OnClick="ClearFiltersAsync">Clear</SfButton>
            </div>
        </div>
    </div>

    @if (_isLoading)
    {
        <HrLoadingIndicator Label="Loading compliance status…" />
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else
    {
        @if (_isTruncated)
        {
            <div class="alert alert-warning">
                Showing the first @_items.Count of @_totalCount items. Narrow the filters to see the rest.
            </div>
        }

        <HrGrid TValue="GovernanceComplianceStatusRowModel"
                Toolbar="@Toolbar"
                DataSource="@_items"
                TotalItemCount="@_totalCount"
                AllowPaging="true"
                AllowSorting="true">
            <GridEvents TValue="GovernanceComplianceStatusRowModel" OnActionBegin="OnGridActionBeginAsync" />
            <GridPageSettings PageSize="@PageSize" />
            <GridColumns>
                <GridColumn Field="@nameof(GovernanceComplianceStatusRowModel.EmployeeName)" HeaderText="Employee" Width="180" />
                <GridColumn Field="@nameof(GovernanceComplianceStatusRowModel.Department)" HeaderText="Department" Width="150" />
                <GridColumn Field="@nameof(GovernanceComplianceStatusRowModel.CategoryLabel)" HeaderText="Category" Width="170" />
                <GridColumn Field="@nameof(GovernanceComplianceStatusRowModel.Detail)" HeaderText="Detail" Width="260" />
                <GridColumn Field="@nameof(GovernanceComplianceStatusRowModel.DueDate)" HeaderText="Due date" Width="120" Format="d" />
                <GridColumn HeaderText="Severity" Width="120">
                    <Template>
                        @{ var item = (GovernanceComplianceStatusRowModel)context; }
                        <span class="@SeverityBadgeClass(item.Severity)">@SeverityLabel(item.Severity)</span>
                    </Template>
                </GridColumn>
            </GridColumns>
        </HrGrid>

        <div class="mt-3">@_totalCount item(s)</div>
    }
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }

    private List<GovernanceComplianceStatusRowModel> _items = [];
    private int _totalCount;
    private bool _isTruncated;
    private int _page = 1;
    private const int PageSize = 20;

    private bool _isLoading = true;
    private string? _error;
    private string? _exportError;

    private string? _category;
    private string? _severity;
    private string? _department;
    private Guid? _managerId;
    private DateOnly? _dueDateStart;
    private DateOnly? _dueDateEnd;

    private List<CategoryOption> _categoryOptions = [new(null, "All categories")];
    private List<CategoryOption> _departmentOptions = [new(null, "All departments")];
    private List<EmployeeOption> _managerOptions = [];
    private Syncfusion.Blazor.DropDowns.SfDropDownList<Guid?, EmployeeOption> _managerDropdown = default!;

    private sealed record CategoryOption(string? Value, string Label);
    private sealed record EmployeeOption(Guid Id, string Name);

    private static readonly CategoryOption[] _severityOptions =
    [
        new(null, "All severities"),
        new("Overdue", "Overdue"),
        new("DueSoon", "Due soon"),
        new("Informational", "Informational"),
    ];

    private sealed record SavedViewOption(Guid Id, string DisplayText, SavedReportViewModel View);
    private sealed record SavedFilterState(
        string? Category, string? Severity, string? Department, Guid? ManagerId,
        DateOnly? DueDateStart, DateOnly? DueDateEnd);

    private const string CatalogId = "governance-compliance-status";

    private List<SavedReportViewModel> _savedViews = [];
    private List<SavedViewOption> _savedViewOptions = [];
    private Guid? _selectedViewId;
    private SavedReportViewModel? _selectedView;
    private string? _savedViewError;
    private bool _showSaveAs;
    private string _newViewName = string.Empty;
    private bool _showRename;
    private string _renameViewName = string.Empty;

    private bool _isFavourite;

    protected override async Task OnParametersSetAsync()
    {
        if (!AppSession.GuardAccess(Navigation, Session.CanViewGovernanceReporting))
            return;

        var employees = (await EmployeeService.ListEmployeesAsync(CompanyId, pageSize: 50))?.Items ?? [];
        _managerOptions = employees
            .Select(e => new EmployeeOption(e.Id, $"{e.FirstName} {e.LastName}"))
            .OrderBy(e => e.Name)
            .ToList();

        await LoadAsync();
        await LoadSavedViewsAsync();
        await LoadFavouriteAsync();
    }

    private GovernanceComplianceStatusReportFilter BuildFilter() => new(
        Category: _category,
        Severity: _severity,
        Department: _department,
        ManagerId: _managerId,
        DueDateStart: _dueDateStart,
        DueDateEnd: _dueDateEnd,
        Page: _page,
        PageSize: PageSize);

    private async Task ApplyFiltersAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _category = null;
        _severity = null;
        _department = null;
        _managerId = null;
        _dueDateStart = null;
        _dueDateEnd = null;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnCategoryChanged(string? value)
    {
        _category = value;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnGridActionBeginAsync(Syncfusion.Blazor.Grids.ActionEventArgs<GovernanceComplianceStatusRowModel> args)
    {
        if (args.RequestType != Syncfusion.Blazor.Grids.Action.Paging) return;
        args.Cancel = true;
        _page = args.CurrentPage;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        StateHasChanged();

        var (response, error) = await ReportingService.GetGovernanceComplianceStatusReportAsync(CompanyId, BuildFilter());
        if (response is null)
        {
            _error = error ?? "Failed to load the compliance status report.";
        }
        else
        {
            _items = response.Items;
            _totalCount = response.TotalCount;
            _isTruncated = response.IsTruncated;

            // No dedicated lookup endpoints for category/department in this contract — offer the
            // real values seen in the currently-loaded rows, same convention as the Compliance Centre.
            if (_category is null)
            {
                _categoryOptions = _items
                    .GroupBy(r => r.Category)
                    .Select(g => new CategoryOption(g.Key, g.First().CategoryLabel))
                    .OrderBy(o => o.Label)
                    .Prepend(new CategoryOption(null, "All categories"))
                    .ToList();
            }
            if (_department is null)
            {
                _departmentOptions = _items
                    .Select(r => r.Department)
                    .Where(d => !string.IsNullOrWhiteSpace(d))
                    .Distinct()
                    .OrderBy(d => d)
                    .Select(d => new CategoryOption(d, d!))
                    .Prepend(new CategoryOption(null, "All departments"))
                    .ToList();
            }
        }

        _isLoading = false;
        StateHasChanged();
    }

    private int _managerFilterRequestId;

    private async Task OnManagerFilteringAsync(Syncfusion.Blazor.DropDowns.FilteringEventArgs args)
    {
        args.PreventDefaultAction = true;
        var requestId = ++_managerFilterRequestId;
        var result = await EmployeeService.ListEmployeesAsync(CompanyId, search: args.Text, pageSize: 50);
        if (requestId != _managerFilterRequestId) return;
        _managerOptions = (result?.Items ?? [])
            .Select(e => new EmployeeOption(e.Id, $"{e.FirstName} {e.LastName}"))
            .OrderBy(e => e.Name)
            .ToList();
        await _managerDropdown.FilterAsync(_managerOptions, new Syncfusion.Blazor.Data.Query());
    }

    private static string SeverityBadgeClass(string severity) => severity switch
    {
        "Overdue" => "badge bg-danger",
        "DueSoon" => "badge bg-warning text-dark",
        _ => "badge bg-secondary",
    };

    private static string SeverityLabel(string severity) => severity switch
    {
        "DueSoon" => "Due soon",
        _ => severity,
    };

    // ── Export ───────────────────────────────────────────────────────────────

    private RenderFragment ExportMenuTemplate => @<ExportMenu OnItemSelected="HandleExportItemSelected" />;

    private IEnumerable<object> Toolbar => new List<object>
    {
        "Print",
        new Syncfusion.Blazor.Navigations.ItemModel { Id = "export", Type = Syncfusion.Blazor.Navigations.ItemType.Input, Template = ExportMenuTemplate, TooltipText = "Export" },
    };

    private async Task HandleExportItemSelected(string id)
    {
        var format = id switch
        {
            "hr-csv" => ReportExportFormat.Csv,
            "hr-excel" => ReportExportFormat.Excel,
            "hr-pdf" => ReportExportFormat.Pdf,
            _ => ReportExportFormat.Csv,
        };

        _exportError = null;
        StateHasChanged();

        var (bytes, contentType, fileName, error) =
            await ReportingService.ExportGovernanceComplianceStatusReportAsync(CompanyId, BuildFilter(), format);

        if (bytes is null)
        {
            _exportError = error ?? "Failed to export the compliance status report.";
        }
        else
        {
            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                fileName ?? $"governance-compliance-status.{format.ToString().ToLowerInvariant()}",
                contentType ?? "application/octet-stream",
                Convert.ToBase64String(bytes));
        }

        StateHasChanged();
    }

    // ── Favourites ───────────────────────────────────────────────────────────

    private async Task LoadFavouriteAsync()
    {
        var response = await ReportingService.GetReportFavouritesAsync(CompanyId);
        _isFavourite = response?.ReportIds.Contains(CatalogId) ?? false;
    }

    private async Task ToggleFavouriteAsync()
    {
        var success = _isFavourite
            ? await ReportingService.RemoveReportFavouriteAsync(CompanyId, CatalogId)
            : await ReportingService.AddReportFavouriteAsync(CompanyId, CatalogId);
        if (success) _isFavourite = !_isFavourite;
    }

    // ── Saved views ──────────────────────────────────────────────────────────

    private async Task LoadSavedViewsAsync()
    {
        var response = await ReportingService.GetReportViewsAsync(CompanyId, CatalogId);
        _savedViews = response?.Views ?? [];
        _savedViewOptions = _savedViews
            .Select(v => new SavedViewOption(v.Id, v.IsDefault ? $"{v.Name} (Default)" : v.Name, v))
            .OrderBy(o => o.View.Name)
            .ToList();
    }

    private async Task OnSavedViewSelectedAsync(Guid? viewId)
    {
        _selectedViewId = viewId;
        _showRename = false;
        _selectedView = _savedViews.FirstOrDefault(v => v.Id == viewId);
        if (_selectedView is null) return;

        try
        {
            var state = JsonSerializer.Deserialize<SavedFilterState>(_selectedView.FilterCriteriaJson);
            if (state is not null)
            {
                _category = state.Category;
                _severity = state.Severity;
                _department = state.Department;
                _managerId = state.ManagerId;
                _dueDateStart = state.DueDateStart;
                _dueDateEnd = state.DueDateEnd;
            }
        }
        catch (JsonException)
        {
            _savedViewError = "Failed to apply the saved view's filters.";
            return;
        }

        _page = 1;
        await LoadAsync();
    }

    private SavedFilterState BuildSavedFilterState() => new(
        _category, _severity, _department, _managerId, _dueDateStart, _dueDateEnd);

    private async Task SaveCurrentAsViewAsync()
    {
        if (string.IsNullOrWhiteSpace(_newViewName)) return;

        _savedViewError = null;
        var json = JsonSerializer.Serialize(BuildSavedFilterState());
        var request = new SaveReportViewRequest(CatalogId, _newViewName.Trim(), json, null);
        var (result, error) = await ReportingService.SaveReportViewAsync(CompanyId, request);
        if (result is null)
        {
            _savedViewError = error ?? "Failed to save the current filters as a view.";
            return;
        }

        _newViewName = string.Empty;
        _showSaveAs = false;
        await LoadSavedViewsAsync();
        _selectedViewId = result.Id;
        _selectedView = _savedViews.FirstOrDefault(v => v.Id == result.Id);
    }

    private void StartRename()
    {
        if (_selectedView is null) return;
        _renameViewName = _selectedView.Name;
        _showRename = true;
    }

    private async Task ConfirmRenameAsync()
    {
        if (_selectedView is null || string.IsNullOrWhiteSpace(_renameViewName)) return;

        _savedViewError = null;
        var (result, error) = await ReportingService.RenameReportViewAsync(CompanyId, _selectedView.Id, _renameViewName.Trim());
        if (result is null)
        {
            _savedViewError = error ?? "Failed to rename the saved view.";
            return;
        }

        _showRename = false;
        await LoadSavedViewsAsync();
        _selectedView = _savedViews.FirstOrDefault(v => v.Id == result.Id);
    }

    private async Task SetDefaultAsync()
    {
        if (_selectedView is null) return;

        _savedViewError = null;
        if (!await ReportingService.SetDefaultReportViewAsync(CompanyId, _selectedView.Id))
        {
            _savedViewError = "Failed to set the saved view as default.";
            return;
        }

        await LoadSavedViewsAsync();
        _selectedView = _savedViews.FirstOrDefault(v => v.Id == _selectedViewId);
    }

    private async Task DeleteSelectedViewAsync()
    {
        if (_selectedView is null) return;

        _savedViewError = null;
        if (!await ReportingService.DeleteReportViewAsync(CompanyId, _selectedView.Id))
        {
            _savedViewError = "Failed to delete the saved view.";
            return;
        }

        _selectedViewId = null;
        _selectedView = null;
        _showRename = false;
        await LoadSavedViewsAsync();
    }
}
