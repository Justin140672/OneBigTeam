@page "/companies/{CompanyId:guid}/reporting/leave-calendar"
@rendermode InteractiveServer
@using HR.Infrastructure.Abstractions
@using HR.Web.Models
@using HR.Web.Services
@inject ReportingService ReportingService
@inject DepartmentService DepartmentService
@inject IJSRuntime JS

<PageTitle>Leave Calendar Report</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Leave Calendar Export</h1>
    <p class="text-muted mb-3">All approved and pending leave for the selected month, intended primarily for export.</p>

    @if (_exportError is not null)
    {
        <div class="alert alert-danger alert-dismissible">
            @_exportError
            <button type="button" class="btn-close" @onclick="@(() => _exportError = null)"></button>
        </div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Year</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_year" Format="####" Min="2000" Max="2100" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Month</label>
                    <SfDropDownList TValue="int"
                                    TItem="MonthOption"
                                    DataSource="@_monthOptions"
                                    @bind-Value="_month">
                        <DropDownListFieldSettings Value="Value" Text="Label" />
                    </SfDropDownList>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Department</label>
                    <SfDropDownList TValue="Guid?"
                                    TItem="DepartmentListItemModel"
                                    DataSource="@_departments"
                                    @bind-Value="_departmentId"
                                    Placeholder="All Departments"
                                    AllowFiltering="true">
                        <DropDownListFieldSettings Value="Id" Text="Name" />
                    </SfDropDownList>
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <SfButton CssClass="e-primary e-small" OnClick="LoadAsync">Apply Filters</SfButton>
            </div>
        </div>
    </div>

    @if (_isLoading)
    {
        <HrLoadingIndicator Label="Loading leave calendar…" />
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else
    {
        <HrGrid TValue="LeaveCalendarReportRowModel"
                Toolbar="@Toolbar"
                DataSource="@_items"
                AllowPaging="false"
                AllowSorting="false">
            <GridColumns>
                <GridColumn Field="@nameof(LeaveCalendarReportRowModel.EmployeeName)" HeaderText="Employee" Width="180" />
                <GridColumn Field="@nameof(LeaveCalendarReportRowModel.Department)" HeaderText="Department" Width="160" />
                <GridColumn Field="@nameof(LeaveCalendarReportRowModel.LeaveStart)" HeaderText="Leave Start" Width="130" Format="d" />
                <GridColumn Field="@nameof(LeaveCalendarReportRowModel.LeaveEnd)" HeaderText="Leave End" Width="130" Format="d" />
                <GridColumn Field="@nameof(LeaveCalendarReportRowModel.LeaveTypeName)" HeaderText="Leave Type" Width="150" />
                <GridColumn Field="@nameof(LeaveCalendarReportRowModel.DurationDays)" HeaderText="Duration (Days)" Width="140" />
                <GridColumn Field="@nameof(LeaveCalendarReportRowModel.ApprovalStatus)" HeaderText="Approval Status" Width="140" />
            </GridColumns>
        </HrGrid>

        <div class="mt-3">@_items.Count leave record(s)</div>
    }
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }

    private List<LeaveCalendarReportRowModel> _items = [];
    private List<DepartmentListItemModel> _departments = [];

    private bool _isLoading = true;
    private string? _error;

    private int _year = DateTime.UtcNow.Year;
    private int _month = DateTime.UtcNow.Month;
    private Guid? _departmentId;

    private bool _exporting;
    private string? _exportError;

    private sealed record MonthOption(int Value, string Label);

    private static readonly MonthOption[] _monthOptions =
    [
        new(1, "January"), new(2, "February"), new(3, "March"), new(4, "April"),
        new(5, "May"), new(6, "June"), new(7, "July"), new(8, "August"),
        new(9, "September"), new(10, "October"), new(11, "November"), new(12, "December"),
    ];

    protected override async Task OnParametersSetAsync()
    {
        _departments = (await DepartmentService.ListDepartmentsAsync(CompanyId))?.Items ?? [];
        await LoadAsync();
    }

    private LeaveCalendarReportFilter BuildFilter() => new(
        Year: _year,
        Month: _month,
        DepartmentId: _departmentId);

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        StateHasChanged();

        var response = await ReportingService.GetLeaveCalendarReportAsync(CompanyId, BuildFilter());
        if (response is null)
        {
            _error = "Failed to load the leave calendar report.";
        }
        else
        {
            _items = response.Items;
        }

        _isLoading = false;
    }

    private RenderFragment ExportMenuTemplate => @<ExportMenu OnItemSelected="HandleExportItemSelected" />;

    private IEnumerable<object> Toolbar => new List<object>
    {
        "Print",
        new Syncfusion.Blazor.Navigations.ItemModel { Id = "export", Type = Syncfusion.Blazor.Navigations.ItemType.Input, Template = ExportMenuTemplate, TooltipText = "Export" },
    };

    private async Task HandleExportItemSelected(string id)
    {
        var format = id switch
        {
            "hr-csv" => ReportExportFormat.Csv,
            "hr-excel" => ReportExportFormat.Excel,
            "hr-pdf" => ReportExportFormat.Pdf,
            _ => ReportExportFormat.Csv,
        };

        _exporting = true;
        _exportError = null;
        StateHasChanged();

        var (bytes, contentType, fileName, error) =
            await ReportingService.ExportLeaveCalendarReportAsync(CompanyId, BuildFilter(), format);

        if (bytes is null)
        {
            _exportError = error ?? "Failed to export the leave calendar report.";
        }
        else
        {
            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                fileName ?? $"leave-calendar.{format.ToString().ToLowerInvariant()}",
                contentType ?? "application/octet-stream",
                Convert.ToBase64String(bytes));
        }

        _exporting = false;
        StateHasChanged();
    }
}
