@page "/companies/{CompanyId:guid}/reporting/onboarding-progress"
@rendermode InteractiveServer
@using HR.Infrastructure.Abstractions
@using HR.Web.Models
@using HR.Web.Services
@inject ReportingService ReportingService
@inject IJSRuntime JS

<PageTitle>Onboarding Progress Report</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Onboarding Progress</h1>
    <p class="text-muted mb-3">Onboarding plan status and outstanding tasks for each employee.</p>

    @if (_exportError is not null)
    {
        <div class="alert alert-danger alert-dismissible">
            @_exportError
            <button type="button" class="btn-close" @onclick="@(() => _exportError = null)"></button>
        </div>
    }

    <div class="card mb-3">
        <div class="card-body d-flex align-items-center gap-3">
            <SfCheckBox TChecked="bool" Label="Overdue only" @bind-Checked="_overdueOnly" />
            <SfButton IsPrimary="true" OnClick="LoadAsync">Apply</SfButton>
        </div>
    </div>

    @if (_isLoading)
    {
        <HrLoadingIndicator Label="Loading onboarding progress report…" />
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else
    {
        <div class="row g-3 mb-3">
            <div class="col-md-3">
                <div class="card"><div class="card-body"><div class="text-muted small">Total Employees</div><div class="fs-4">@_totalEmployees</div></div></div>
            </div>
            <div class="col-md-3">
                <div class="card"><div class="card-body"><div class="text-muted small">Total Outstanding Tasks</div><div class="fs-4">@_totalOutstandingTasks</div></div></div>
            </div>
            <div class="col-md-3">
                <div class="card"><div class="card-body"><div class="text-muted small">Overdue Employees</div><div class="fs-4">@_overdueEmployeeCount</div></div></div>
            </div>
        </div>

        <HrGrid TValue="OnboardingProgressReportRowModel"
                Toolbar="@Toolbar"
                DataSource="@_items"
                AllowPaging="true"
                AllowSorting="true">
            <GridColumns>
                <GridColumn Field="@nameof(OnboardingProgressReportRowModel.EmployeeName)" HeaderText="Employee" Width="180" />
                <GridColumn Field="@nameof(OnboardingProgressReportRowModel.PlanStatus)" HeaderText="Plan Status" Width="140" />
                <GridColumn Field="@nameof(OnboardingProgressReportRowModel.ProgressPercent)" HeaderText="Progress %" Width="120" />
                <GridColumn HeaderText="Outstanding Tasks" Width="220">
                    <Template>
                        @{
                            var item = (OnboardingProgressReportRowModel)context;
                        }
                        @if (item.OutstandingTasks.Count == 0)
                        {
                            <span class="text-muted">None</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary" title="@BuildTaskTooltip(item)">@item.OutstandingTasks.Count outstanding</span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Has Overdue" Width="120">
                    <Template>
                        @{
                            var item = (OnboardingProgressReportRowModel)context;
                        }
                        @if (item.HasOverdueTasks)
                        {
                            <span class="badge bg-danger">Overdue</span>
                        }
                        else
                        {
                            <span class="badge bg-success">On track</span>
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </HrGrid>

        <div class="mt-3">@_items.Count employee(s)</div>
    }
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }

    private List<OnboardingProgressReportRowModel> _items = [];
    private int _totalEmployees;
    private int _totalOutstandingTasks;
    private int _overdueEmployeeCount;

    private bool _overdueOnly;

    private bool _isLoading = true;
    private string? _error;

    private bool _exporting;
    private string? _exportError;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private OnboardingProgressReportFilter BuildFilter() => new(OverdueOnly: _overdueOnly);

    private static string BuildTaskTooltip(OnboardingProgressReportRowModel item) =>
        string.Join("; ", item.OutstandingTasks.Select(t =>
            $"{t.Title}{(t.DueDate is not null ? $" (due {t.DueDate:d})" : "")}{(t.Owner is not null ? $" - {t.Owner}" : "")}{(t.IsOverdue ? " [overdue]" : "")}"));

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        StateHasChanged();

        var response = await ReportingService.GetOnboardingProgressReportAsync(CompanyId, BuildFilter());
        if (response is null)
        {
            _error = "Failed to load the onboarding progress report.";
        }
        else
        {
            _items = response.Items;
            _totalEmployees = response.TotalEmployees;
            _totalOutstandingTasks = response.TotalOutstandingTasks;
            _overdueEmployeeCount = response.OverdueEmployeeCount;
        }

        _isLoading = false;
    }

    private RenderFragment ExportMenuTemplate => @<ExportMenu OnItemSelected="HandleExportItemSelected" />;

    private IEnumerable<object> Toolbar => new List<object>
    {
        "Print",
        new Syncfusion.Blazor.Navigations.ItemModel { Id = "export", Type = Syncfusion.Blazor.Navigations.ItemType.Input, Template = ExportMenuTemplate, TooltipText = "Export" },
    };

    private async Task HandleExportItemSelected(string id)
    {
        var format = id switch
        {
            "hr-csv" => ReportExportFormat.Csv,
            "hr-excel" => ReportExportFormat.Excel,
            "hr-pdf" => ReportExportFormat.Pdf,
            _ => ReportExportFormat.Csv,
        };

        _exporting = true;
        _exportError = null;
        StateHasChanged();

        var (bytes, contentType, fileName, error) =
            await ReportingService.ExportOnboardingProgressReportAsync(CompanyId, BuildFilter(), format);

        if (bytes is null)
        {
            _exportError = error ?? "Failed to export the onboarding progress report.";
        }
        else
        {
            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                fileName ?? $"onboarding-progress-report.{format.ToString().ToLowerInvariant()}",
                contentType ?? "application/octet-stream",
                Convert.ToBase64String(bytes));
        }

        _exporting = false;
        StateHasChanged();
    }
}
