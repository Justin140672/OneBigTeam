@page "/companies/{CompanyId:guid}/reporting/governance/administrative-changes"
@rendermode InteractiveServer
@using HR.Web.Models
@using HR.Web.Services
@inject ReportingService ReportingService
@inject NavigationManager Navigation
@inject AppSession Session

<PageTitle>Administrative Changes Report</PageTitle>

@if (_allowed)
{
    <GovernanceAuditReport CompanyId="CompanyId"
                           Title="Administrative Changes"
                           Description="Configuration and administrative changes across the company — company settings, HR configuration, roles and permissions — with the acting user, outcome and a summary."
                           CatalogId="governance-administrative-changes"
                           Load="(id, f) => ReportingService.GetGovernanceAdministrativeChangesReportAsync(id, f)"
                           Export="(id, f, fmt) => ReportingService.ExportGovernanceAdministrativeChangesReportAsync(id, f, fmt)" />
}

@code {
    [Parameter] public Guid CompanyId { get; set; }

    private bool _allowed;

    protected override async Task OnParametersSetAsync()
    {
        // Capabilities are only meaningful once the session has loaded — never evaluate the guard
        // (and never bounce to /access-denied) against a half-initialised session.
        await Session.InitialiseAsync();
        if (!Session.IsLoaded)
            return;

        _allowed = AppSession.GuardAccess(Navigation, Session.CanViewGovernanceReporting);
    }
}
