@page "/companies/{CompanyId:guid}/reporting/governance/user-activity"
@rendermode InteractiveServer
@using HR.Web.Models
@using HR.Web.Services
@inject ReportingService ReportingService
@inject NavigationManager Navigation
@inject AppSession Session

<PageTitle>User Activity Report</PageTitle>

@if (_allowed)
{
    <GovernanceAuditReport CompanyId="CompanyId"
                           Title="User Activity"
                           Description="Every user-initiated action across the company — sign-ins, record views and changes — with the acting user, affected employee, outcome and a summary."
                           CatalogId="governance-user-activity"
                           Load="(id, f) => ReportingService.GetGovernanceUserActivityReportAsync(id, f)"
                           Export="(id, f, fmt) => ReportingService.ExportGovernanceUserActivityReportAsync(id, f, fmt)" />
}

@code {
    [Parameter] public Guid CompanyId { get; set; }

    private bool _allowed;

    protected override void OnParametersSet()
        => _allowed = AppSession.GuardAccess(Navigation, Session.CanViewGovernanceReporting);
}
