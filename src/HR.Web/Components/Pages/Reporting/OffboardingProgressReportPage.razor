@page "/companies/{CompanyId:guid}/reporting/offboarding-progress"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject AppSession Session
@using HR.Infrastructure.Abstractions
@using HR.Web.Models
@using HR.Web.Services
@inject ReportingService ReportingService
@inject IJSRuntime JS

<PageTitle>Offboarding Progress Report</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Offboarding Progress</h1>
    <p class="text-muted mb-3">Offboarding status, outstanding tasks and return of access/assets for leaving employees.</p>

    @if (_exportError is not null)
    {
        <div class="alert alert-danger alert-dismissible">
            @_exportError
            <button type="button" class="btn-close" @onclick="@(() => _exportError = null)"></button>
        </div>
    }

    @if (_isLoading)
    {
        <HrLoadingIndicator Label="Loading offboarding progress report…" />
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else
    {
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <div class="card"><div class="card-body"><div class="text-muted small">Total Employees</div><div class="fs-4">@_totalEmployees</div></div></div>
            </div>
            <div class="col-md-4">
                <div class="card"><div class="card-body"><div class="text-muted small">Outstanding Access</div><div class="fs-4">@_outstandingAccessCount</div></div></div>
            </div>
            <div class="col-md-4">
                <div class="card"><div class="card-body"><div class="text-muted small">Outstanding Assets</div><div class="fs-4">@_outstandingAssetsCount</div></div></div>
            </div>
        </div>

        <HrGrid TValue="OffboardingProgressReportRowModel"
                Toolbar="@Toolbar"
                DataSource="@_items"
                AllowPaging="true"
                AllowSorting="true">
            <GridColumns>
                <GridColumn Field="@nameof(OffboardingProgressReportRowModel.EmployeeName)" HeaderText="Employee" Width="180" />
                <GridColumn Field="@nameof(OffboardingProgressReportRowModel.LastWorkingDay)" HeaderText="Last Working Day" Width="150" Format="d" />
                <GridColumn Field="@nameof(OffboardingProgressReportRowModel.Status)" HeaderText="Status" Width="130" />
                <GridColumn HeaderText="Outstanding Tasks" Width="180">
                    <Template>
                        @{
                            var item = (OffboardingProgressReportRowModel)context;
                        }
                        @if (item.OutstandingTasks.Count == 0)
                        {
                            <span class="text-muted">None</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary" title="@string.Join("; ", item.OutstandingTasks)">@item.OutstandingTasks.Count outstanding</span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Completed Tasks" Width="180">
                    <Template>
                        @{
                            var item = (OffboardingProgressReportRowModel)context;
                        }
                        <span class="badge bg-light text-dark border" title="@string.Join("; ", item.CompletedTasks)">@item.CompletedTasks.Count completed</span>
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Access Disabled" Width="130">
                    <Template>
                        @{
                            var item = (OffboardingProgressReportRowModel)context;
                        }
                        <span class="badge @(item.AccessDisabled ? "bg-success" : "bg-warning text-dark")">@(item.AccessDisabled ? "Yes" : "No")</span>
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Documents Returned" Width="150">
                    <Template>
                        @{
                            var item = (OffboardingProgressReportRowModel)context;
                        }
                        <span class="badge @(item.DocumentsReturned ? "bg-success" : "bg-warning text-dark")">@(item.DocumentsReturned ? "Yes" : "No")</span>
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Assets Returned" Width="140">
                    <Template>
                        @{
                            var item = (OffboardingProgressReportRowModel)context;
                        }
                        <span class="badge @(item.AssetsReturned ? "bg-success" : "bg-warning text-dark")">@(item.AssetsReturned ? "Yes" : "No")</span>
                    </Template>
                </GridColumn>
            </GridColumns>
        </HrGrid>

        <div class="mt-3">@_items.Count employee(s)</div>
    }
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }

    private List<OffboardingProgressReportRowModel> _items = [];
    private int _totalEmployees;
    private int _outstandingAccessCount;
    private int _outstandingAssetsCount;

    private bool _isLoading = true;
    private string? _error;

    private bool _exporting;
    private string? _exportError;

    protected override async Task OnParametersSetAsync()
    {
        if (!AppSession.GuardAccess(Navigation, Session.CanViewReporting))
            return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        StateHasChanged();

        var response = await ReportingService.GetOffboardingProgressReportAsync(CompanyId);
        if (response is null)
        {
            _error = "Failed to load the offboarding progress report.";
        }
        else
        {
            _items = response.Items;
            _totalEmployees = response.TotalEmployees;
            _outstandingAccessCount = response.OutstandingAccessCount;
            _outstandingAssetsCount = response.OutstandingAssetsCount;
        }

        _isLoading = false;
    }

    private RenderFragment ExportMenuTemplate => @<ExportMenu OnItemSelected="HandleExportItemSelected" />;

    private IEnumerable<object> Toolbar => new List<object>
    {
        "Print",
        new Syncfusion.Blazor.Navigations.ItemModel { Id = "export", Type = Syncfusion.Blazor.Navigations.ItemType.Input, Template = ExportMenuTemplate, TooltipText = "Export" },
    };

    private async Task HandleExportItemSelected(string id)
    {
        var format = id switch
        {
            "hr-csv" => ReportExportFormat.Csv,
            "hr-excel" => ReportExportFormat.Excel,
            "hr-pdf" => ReportExportFormat.Pdf,
            _ => ReportExportFormat.Csv,
        };

        _exporting = true;
        _exportError = null;
        StateHasChanged();

        var (bytes, contentType, fileName, error) =
            await ReportingService.ExportOffboardingProgressReportAsync(CompanyId, format);

        if (bytes is null)
        {
            _exportError = error ?? "Failed to export the offboarding progress report.";
        }
        else
        {
            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                fileName ?? $"offboarding-progress-report.{format.ToString().ToLowerInvariant()}",
                contentType ?? "application/octet-stream",
                Convert.ToBase64String(bytes));
        }

        _exporting = false;
        StateHasChanged();
    }
}
