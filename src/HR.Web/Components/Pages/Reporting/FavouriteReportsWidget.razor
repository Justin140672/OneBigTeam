@using HR.Web.Models
@inject ReportingService ReportingService
@inject NavigationManager Navigation
@inject AppSession Session

@if (_loading)
{
    <div class="widget-card">
        <div class="widget-header">
            <i class="fa-solid fa-star widget-icon"></i>
            <span class="widget-title">Favourite Reports</span>
        </div>
        <div class="widget-body d-flex align-items-center gap-2 py-3 px-3">
            <HrLoadingIndicator Label="Loading favourite reports…" />
        </div>
    </div>
}
else
{
    <div class="widget-card">
        <div class="widget-header">
            <i class="fa-solid fa-star widget-icon"></i>
            <span class="widget-title">Favourite Reports</span>
            @if (_favourites.Count > 0)
            {
                <span class="widget-count-badge">@_favourites.Count</span>
            }
        </div>

        <div class="widget-body">
            @if (_favourites.Count == 0)
            {
                <div class="widget-empty">
                    <i class="fa-solid fa-star fa-lg mb-2"></i>
                    <p class="mb-0">No favourite reports yet</p>
                    <p class="text-muted small mb-0">Star a report from the Reports page to pin it here.</p>
                </div>
            }
            else
            {
                @foreach (var report in _favourites)
                {
                    var r = report;
                    <div @key="r.Id" class="task-widget-item" @onclick="() => OpenReport(r)">
                        <span class="priority-pip priority-pip--low"></span>
                        <div class="task-widget-content">
                            <span class="task-widget-title">@r.DisplayName</span>
                            <span class="task-widget-meta">@r.Category</span>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="widget-footer">
            <a href="/companies/@Session.CompanyId/reporting" class="widget-view-all">
                Browse all<i class="fa-solid fa-arrow-right fa-xs" aria-hidden="true"></i>
            </a>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private List<ReportCatalogItemModel> _favourites = [];

    protected override async Task OnInitializedAsync()
    {
        var catalogTask = ReportingService.GetReportCatalogAsync(Session.CompanyId);
        var favouritesTask = ReportingService.GetReportFavouritesAsync(Session.CompanyId);
        await Task.WhenAll(catalogTask, favouritesTask);

        var catalog = (await catalogTask)?.Items ?? [];
        var favouriteIds = (await favouritesTask)?.ReportIds.ToHashSet() ?? [];

        _favourites = catalog
            .Where(c => favouriteIds.Contains(c.Id))
            .OrderBy(c => c.DisplayName)
            .ToList();

        _loading = false;
    }

    private void OpenReport(ReportCatalogItemModel report)
    {
        var route = ReportRoutes.RouteFor(report.Id);
        if (route is not null)
            Navigation.NavigateTo($"/companies/{Session.CompanyId}/reporting/{route}");
    }
}
