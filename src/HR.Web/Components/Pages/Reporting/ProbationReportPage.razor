@page "/companies/{CompanyId:guid}/reporting/probation"
@rendermode InteractiveServer
@using HR.Infrastructure.Abstractions
@using HR.Web.Models
@using HR.Web.Services
@inject ReportingService ReportingService
@inject IJSRuntime JS

<PageTitle>Probation Report</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-start mb-1">
        <h1 class="mb-1">Probation Report</h1>
        <SfDropDownButton Content="Export" IconCss="fa-solid fa-download" CssClass="e-flat" Items="_exportItems" Disabled="_exporting">
            <DropDownButtonEvents ItemSelected="HandleExportSelected" />
        </SfDropDownButton>
    </div>
    <p class="text-muted mb-3">Current probation, due and overdue reviews, passed and extended.</p>

    @if (_exportError is not null)
    {
        <div class="alert alert-danger alert-dismissible">
            @_exportError
            <button type="button" class="btn-close" @onclick="@(() => _exportError = null)"></button>
        </div>
    }

    @if (_isLoading)
    {
        <HrLoadingIndicator Label="Loading probation report…" />
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else
    {
        <div class="row g-3 mb-3">
            <div class="col-md-2">
                <div class="card"><div class="card-body"><div class="text-muted small">Current Probation</div><div class="fs-4">@_currentProbationCount</div></div></div>
            </div>
            <div class="col-md-2">
                <div class="card"><div class="card-body"><div class="text-muted small">Due Reviews</div><div class="fs-4">@_dueReviewCount</div></div></div>
            </div>
            <div class="col-md-2">
                <div class="card"><div class="card-body"><div class="text-muted small">Overdue Reviews</div><div class="fs-4">@_overdueReviewCount</div></div></div>
            </div>
            <div class="col-md-2">
                <div class="card"><div class="card-body"><div class="text-muted small">Passed</div><div class="fs-4">@_passedCount</div></div></div>
            </div>
            <div class="col-md-2">
                <div class="card"><div class="card-body"><div class="text-muted small">Extended</div><div class="fs-4">@_extendedCount</div></div></div>
            </div>
        </div>

        <HrGrid TValue="ProbationReportRowModel"
                DataSource="@_items"
                AllowPaging="true"
                AllowSorting="true">
            <GridColumns>
                <GridColumn Field="@nameof(ProbationReportRowModel.EmployeeName)" HeaderText="Employee" Width="180" />
                <GridColumn Field="@nameof(ProbationReportRowModel.Status)" HeaderText="Status" Width="130" />
                <GridColumn Field="@nameof(ProbationReportRowModel.StartDate)" HeaderText="Start Date" Width="120" Format="d" />
                <GridColumn Field="@nameof(ProbationReportRowModel.ExpectedEndDate)" HeaderText="Expected End Date" Width="150" Format="d" />
                <GridColumn Field="@nameof(ProbationReportRowModel.DueReviews)" HeaderText="Due Reviews" Width="120" />
                <GridColumn Field="@nameof(ProbationReportRowModel.OverdueReviews)" HeaderText="Overdue Reviews" Width="140" />
            </GridColumns>
        </HrGrid>

        <div class="mt-3">@_items.Count employee(s)</div>
    }
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }

    private List<ProbationReportRowModel> _items = [];
    private int _currentProbationCount;
    private int _dueReviewCount;
    private int _overdueReviewCount;
    private int _passedCount;
    private int _extendedCount;

    private bool _isLoading = true;
    private string? _error;

    private bool _exporting;
    private string? _exportError;

    private static readonly List<Syncfusion.Blazor.SplitButtons.DropDownMenuItem> _exportItems =
    [
        new() { Id = "csv", Text = "CSV", IconCss = "fa-solid fa-file-csv" },
        new() { Id = "excel", Text = "Excel", IconCss = "fa-solid fa-file-excel" },
        new() { Id = "pdf", Text = "PDF", IconCss = "fa-solid fa-file-pdf" },
    ];

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        StateHasChanged();

        var response = await ReportingService.GetProbationReportAsync(CompanyId);
        if (response is null)
        {
            _error = "Failed to load the probation report.";
        }
        else
        {
            _items = response.Items;
            _currentProbationCount = response.CurrentProbationCount;
            _dueReviewCount = response.DueReviewCount;
            _overdueReviewCount = response.OverdueReviewCount;
            _passedCount = response.PassedCount;
            _extendedCount = response.ExtendedCount;
        }

        _isLoading = false;
    }

    private async Task HandleExportSelected(Syncfusion.Blazor.SplitButtons.MenuEventArgs args)
    {
        if (args.Item?.Id is not { } id) return;

        var format = id switch
        {
            "csv" => ReportExportFormat.Csv,
            "excel" => ReportExportFormat.Excel,
            "pdf" => ReportExportFormat.Pdf,
            _ => ReportExportFormat.Csv,
        };

        _exporting = true;
        _exportError = null;
        StateHasChanged();

        var (bytes, contentType, fileName, error) =
            await ReportingService.ExportProbationReportAsync(CompanyId, format);

        if (bytes is null)
        {
            _exportError = error ?? "Failed to export the probation report.";
        }
        else
        {
            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                fileName ?? $"probation-report.{format.ToString().ToLowerInvariant()}",
                contentType ?? "application/octet-stream",
                Convert.ToBase64String(bytes));
        }

        _exporting = false;
        StateHasChanged();
    }
}
