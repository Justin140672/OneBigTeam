@page "/companies/{CompanyId:guid}/reporting/employee-leavers"
@rendermode InteractiveServer
@using HR.Infrastructure.Abstractions
@using HR.Web.Components.Controls
@using HR.Web.Models
@using HR.Web.Services
@inject ReportingService ReportingService
@inject IJSRuntime JS

<PageTitle>Employee Leaver Report</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Employee Leavers</h1>
    <p class="text-muted mb-3">Employees who left within the selected date range, including offboarding and account status.</p>

    @if (_exportError is not null)
    {
        <div class="alert alert-danger alert-dismissible">
            @_exportError
            <button type="button" class="btn-close" @onclick="@(() => _exportError = null)"></button>
        </div>
    }

    <ReportFilterPanel CompanyId="CompanyId"
                        ReportId="employee-leavers"
                        OnCriteriaChanged="OnFilterChangedAsync"
                        ShowLocationFilter="false"
                        ShowManagerFilter="false"
                        ShowEmploymentTypeFilter="false"
                        ShowStatusFilter="false"
                        DateRangeStartLabel="Leaving Date From"
                        DateRangeEndLabel="Leaving Date To" />

    @if (_isLoading)
    {
        <HrLoadingIndicator Label="Loading employee leavers…" />
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else
    {
        <HrGrid TValue="EmployeeLeaverReportItemModel"
                Toolbar="@Toolbar"
                DataSource="@_items"
                TotalItemCount="@_totalCount"
                AllowPaging="true"
                AllowSorting="true">
            <GridEvents TValue="EmployeeLeaverReportItemModel" OnActionBegin="OnGridActionBeginAsync" />
            <GridPageSettings PageSize="@PageSize" />
            <GridColumns>
                <GridColumn Field="@nameof(EmployeeLeaverReportItemModel.Name)" HeaderText="Name" Width="180" />
                <GridColumn Field="@nameof(EmployeeLeaverReportItemModel.LeavingDate)" HeaderText="Leaving Date" Width="130" Format="d" />
                <GridColumn Field="@nameof(EmployeeLeaverReportItemModel.LastWorkingDay)" HeaderText="Last Working Day" Width="150" Format="d" />
                <GridColumn Field="@nameof(EmployeeLeaverReportItemModel.Department)" HeaderText="Department" Width="160" />
                <GridColumn Field="@nameof(EmployeeLeaverReportItemModel.Position)" HeaderText="Position" Width="160" />
                <GridColumn Field="@nameof(EmployeeLeaverReportItemModel.Reason)" HeaderText="Reason" Width="160" />
                <GridColumn Field="@nameof(EmployeeLeaverReportItemModel.OffboardingStatus)" HeaderText="Offboarding Status" Width="150" />
                <GridColumn Field="@nameof(EmployeeLeaverReportItemModel.AccountStatus)" HeaderText="Account Status" Width="140" />
            </GridColumns>
        </HrGrid>

        <div class="mt-3">@_totalCount employee(s)</div>
    }
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }

    private List<EmployeeLeaverReportItemModel> _items = [];
    private int _totalCount;
    private int _page = 1;
    private const int PageSize = 20;
    private string? _sortBy;
    private bool _sortDescending;

    private bool _isLoading = true;
    private string? _error;

    private ReportFilterCriteriaModel _currentFilter = new();

    private bool _exporting;
    private string? _exportError;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task OnFilterChangedAsync(ReportFilterCriteriaModel filter)
    {
        _currentFilter = filter;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnGridActionBeginAsync(Syncfusion.Blazor.Grids.ActionEventArgs<EmployeeLeaverReportItemModel> args)
    {
        if (args.RequestType == Syncfusion.Blazor.Grids.Action.Paging)
        {
            _page = args.CurrentPage;
        }
        else if (args.RequestType == Syncfusion.Blazor.Grids.Action.Sorting)
        {
            _sortBy = args.ColumnName;
            _sortDescending = args.ColumnName is not null && args.Direction == Syncfusion.Blazor.Grids.SortDirection.Descending;
            _page = 1;
        }
        else
        {
            return;
        }

        // See EmployeeDirectoryReportPage's OnGridActionBeginAsync — externally/server-paged grid,
        // must cancel the grid's own built-in paging/sorting so it doesn't also process the small
        // returned page locally and clobber header/pager UI state after the reload.
        args.Cancel = true;

        await LoadAsync();
    }

    private EmployeeLeaverReportFilter BuildServiceFilter() => new(
        DepartmentId: _currentFilter.DepartmentId,
        PositionProfileId: _currentFilter.PositionProfileId,
        DateRangeStart: _currentFilter.DateRangeStart,
        DateRangeEnd: _currentFilter.DateRangeEnd,
        Page: _page,
        PageSize: PageSize,
        SortBy: _sortBy,
        SortDescending: _sortDescending);

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        StateHasChanged();

        var response = await ReportingService.GetEmployeeLeaverReportAsync(CompanyId, BuildServiceFilter());
        if (response is null)
        {
            _error = "Failed to load the employee leaver report.";
        }
        else
        {
            _items = response.Items;
            _totalCount = response.TotalCount;
        }

        _isLoading = false;
    }

    private RenderFragment ExportMenuTemplate => @<ExportMenu OnItemSelected="HandleExportItemSelected" />;

    private IEnumerable<object> Toolbar => new List<object>
    {
        "Print",
        new Syncfusion.Blazor.Navigations.ItemModel { Id = "export", Type = Syncfusion.Blazor.Navigations.ItemType.Input, Template = ExportMenuTemplate, TooltipText = "Export" },
    };

    private async Task HandleExportItemSelected(string id)
    {
        var format = id switch
        {
            "hr-csv" => ReportExportFormat.Csv,
            "hr-excel" => ReportExportFormat.Excel,
            "hr-pdf" => ReportExportFormat.Pdf,
            _ => ReportExportFormat.Csv,
        };

        _exporting = true;
        _exportError = null;
        StateHasChanged();

        var (bytes, contentType, fileName, error) =
            await ReportingService.ExportEmployeeLeaverReportAsync(CompanyId, BuildServiceFilter(), format);

        if (bytes is null)
        {
            _exportError = error ?? "Failed to export the employee leaver report.";
        }
        else
        {
            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                fileName ?? $"employee-leavers.{format.ToString().ToLowerInvariant()}",
                contentType ?? "application/octet-stream",
                Convert.ToBase64String(bytes));
        }

        _exporting = false;
        StateHasChanged();
    }
}
