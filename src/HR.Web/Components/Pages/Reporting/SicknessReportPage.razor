@page "/companies/{CompanyId:guid}/reporting/sickness"
@rendermode InteractiveServer
@using HR.Infrastructure.Abstractions
@using HR.Web.Components.Controls
@using HR.Web.Models
@using HR.Web.Services
@inject ReportingService ReportingService
@inject IJSRuntime JS

<PageTitle>Sickness Report</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Sickness Report</h1>
    <p class="text-muted mb-3">Absence count, days absent and Bradford score, grouped by department or employee.</p>

    @if (_exportError is not null)
    {
        <div class="alert alert-danger alert-dismissible">
            @_exportError
            <button type="button" class="btn-close" @onclick="@(() => _exportError = null)"></button>
        </div>
    }

    <ReportFilterPanel CompanyId="CompanyId"
                        ReportId="sickness-report"
                        OnCriteriaChanged="OnFilterChangedAsync"
                        OnViewDeleted="LoadAsync"
                        ShowDepartmentFilter="false"
                        ShowLocationFilter="false"
                        ShowPositionProfileFilter="false"
                        ShowManagerFilter="false"
                        ShowEmploymentTypeFilter="false"
                        ShowStatusFilter="false"
                        DateRangeStartLabel="Start Date From"
                        DateRangeEndLabel="Start Date To" />

    <div class="d-flex align-items-center gap-2 mb-3">
        <label class="form-label mb-0">Group by</label>
        <SfDropDownList TValue="SicknessReportGroupBy" TItem="GroupByOption" DataSource="@_groupByOptions"
                        Width="180px"
                        Value="@_groupBy" ValueChanged="OnGroupByChangedAsync">
            <DropDownListFieldSettings Value="Value" Text="Label" />
        </SfDropDownList>
    </div>

    @if (_isLoading)
    {
        <HrLoadingIndicator Label="Loading sickness report…" />
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else
    {
        <HrGrid TValue="SicknessReportGroupRowModel"
                Toolbar="@Toolbar"
                DataSource="@_items"
                AllowPaging="true"
                AllowSorting="true">
            <GridColumns>
                <GridColumn Field="@nameof(SicknessReportGroupRowModel.GroupLabel)" HeaderText="@GroupLabelHeader" Width="180" />
                <GridColumn Field="@nameof(SicknessReportGroupRowModel.AbsenceCount)" HeaderText="Absence Count" Width="140" />
                <GridColumn Field="@nameof(SicknessReportGroupRowModel.DaysAbsent)" HeaderText="Days Absent" Width="140" />
                <GridColumn Field="@nameof(SicknessReportGroupRowModel.BradfordScore)" HeaderText="Bradford Score" Width="140" />
            </GridColumns>
        </HrGrid>

        <div class="mt-3">@_items.Count row(s)</div>
    }
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }

    private List<SicknessReportGroupRowModel> _items = [];

    private bool _isLoading = true;
    private string? _error;

    private ReportFilterCriteriaModel _currentFilter = new();
    private SicknessReportGroupBy _groupBy = SicknessReportGroupBy.Employee;

    private bool _exporting;
    private string? _exportError;

    private string GroupLabelHeader => _groupBy == SicknessReportGroupBy.Department ? "Department" : "Employee";

    private sealed record GroupByOption(SicknessReportGroupBy Value, string Label);

    private static readonly GroupByOption[] _groupByOptions =
    [
        new(SicknessReportGroupBy.Employee, "Employee"),
        new(SicknessReportGroupBy.Department, "Department"),
    ];

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task OnFilterChangedAsync(ReportFilterCriteriaModel filter)
    {
        _currentFilter = filter;
        await LoadAsync();
    }

    private async Task OnGroupByChangedAsync(SicknessReportGroupBy value)
    {
        _groupBy = value;
        await LoadAsync();
    }

    private SicknessReportFilter BuildServiceFilter() => new(
        StartDate: _currentFilter.DateRangeStart,
        EndDate: _currentFilter.DateRangeEnd,
        GroupBy: _groupBy);

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        StateHasChanged();

        var response = await ReportingService.GetSicknessReportAsync(CompanyId, BuildServiceFilter());
        if (response is null)
        {
            _error = "Failed to load the sickness report.";
        }
        else
        {
            _items = response.Items;
        }

        _isLoading = false;
    }

    private RenderFragment ExportMenuTemplate => @<ExportMenu OnItemSelected="HandleExportItemSelected" />;

    private IEnumerable<object> Toolbar => new List<object>
    {
        "Print",
        new Syncfusion.Blazor.Navigations.ItemModel { Id = "export", Type = Syncfusion.Blazor.Navigations.ItemType.Input, Template = ExportMenuTemplate, TooltipText = "Export" },
    };

    private async Task HandleExportItemSelected(string id)
    {
        var format = id switch
        {
            "hr-csv" => ReportExportFormat.Csv,
            "hr-excel" => ReportExportFormat.Excel,
            "hr-pdf" => ReportExportFormat.Pdf,
            _ => ReportExportFormat.Csv,
        };

        _exporting = true;
        _exportError = null;
        StateHasChanged();

        var (bytes, contentType, fileName, error) =
            await ReportingService.ExportSicknessReportAsync(CompanyId, BuildServiceFilter(), format);

        if (bytes is null)
        {
            _exportError = error ?? "Failed to export the sickness report.";
        }
        else
        {
            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                fileName ?? $"sickness-report.{format.ToString().ToLowerInvariant()}",
                contentType ?? "application/octet-stream",
                Convert.ToBase64String(bytes));
        }

        _exporting = false;
        StateHasChanged();
    }
}
