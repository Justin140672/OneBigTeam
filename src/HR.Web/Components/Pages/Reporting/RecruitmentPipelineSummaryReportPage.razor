@page "/companies/{CompanyId:guid}/reporting/recruitment-pipeline-summary"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject AppSession Session
@using HR.Infrastructure.Abstractions
@using HR.Web.Components.Controls
@using HR.Web.Models
@using HR.Web.Services
@inject ReportingService ReportingService
@inject IJSRuntime JS

<PageTitle>Recruitment Pipeline Summary Report</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Recruitment Pipeline Summary</h1>
    <p class="text-muted mb-3">Open vacancies and candidates by pipeline stage.</p>

    @if (_exportError is not null)
    {
        <div class="alert alert-danger alert-dismissible">
            @_exportError
            <button type="button" class="btn-close" @onclick="@(() => _exportError = null)"></button>
        </div>
    }

    <div class="d-flex align-items-center gap-2 mb-3">
        <SfCheckBox TChecked="bool" Label="Include closed vacancies" Checked="@_includeClosed" CheckedChanged="OnIncludeClosedChangedAsync" />
    </div>

    @if (_isLoading)
    {
        <HrLoadingIndicator Label="Loading recruitment pipeline summary…" />
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else
    {
        <HrGrid TValue="RecruitmentPipelineSummaryRowModel"
                Toolbar="@Toolbar"
                DataSource="@_items"
                AllowPaging="true"
                AllowSorting="true">
            <GridColumns>
                <GridColumn Field="@nameof(RecruitmentPipelineSummaryRowModel.VacancyTitle)" HeaderText="Vacancy" Width="180" />
                <GridColumn Field="@nameof(RecruitmentPipelineSummaryRowModel.PositionProfileTitle)" HeaderText="Position Profile" Width="160" />
                <GridColumn Field="@nameof(RecruitmentPipelineSummaryRowModel.DepartmentName)" HeaderText="Department" Width="150" />
                <GridColumn Field="@nameof(RecruitmentPipelineSummaryRowModel.Status)" HeaderText="Status" Width="110" />
                <GridColumn Field="@nameof(RecruitmentPipelineSummaryRowModel.OpenedAt)" HeaderText="Opened" Width="120" Format="d" />
                <GridColumn Field="@nameof(RecruitmentPipelineSummaryRowModel.CandidateCount)" HeaderText="Candidates" Width="110" />
                <GridColumn HeaderText="Pipeline Stages" Width="260">
                    <Template>
                        @{
                            var item = (RecruitmentPipelineSummaryRowModel)context;
                        }
                        @if (_stages.Count == 0)
                        {
                            <span class="text-muted">No stages configured</span>
                        }
                        else
                        {
                            @foreach (var stage in _stages)
                            {
                                var count = item.CandidatesByStage.GetValueOrDefault(stage.StageId);
                                <span class="badge bg-secondary me-1" title="@stage.StageName">@stage.StageName: @count</span>
                            }
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </HrGrid>

        <div class="mt-3">@_items.Count vacancy(vacancies)</div>
    }
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }

    private List<RecruitmentPipelineSummaryRowModel> _items = [];
    private List<RecruitmentStageColumnModel> _stages = [];

    private bool _isLoading = true;
    private string? _error;

    private bool _includeClosed;

    private bool _exporting;
    private string? _exportError;

    protected override async Task OnParametersSetAsync()
    {
        if (!AppSession.GuardAccess(Navigation, Session.CanViewRecruitmentReports))
            return;
        await LoadAsync();
    }

    private async Task OnIncludeClosedChangedAsync(bool value)
    {
        _includeClosed = value;
        await LoadAsync();
    }

    private RecruitmentPipelineSummaryReportFilter BuildServiceFilter() => new(IncludeClosed: _includeClosed);

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        StateHasChanged();

        var (response, error) = await ReportingService.GetRecruitmentPipelineSummaryReportAsync(CompanyId, BuildServiceFilter());
        if (response is null)
        {
            _error = error ?? "Failed to load the recruitment pipeline summary report.";
        }
        else
        {
            _items = response.Vacancies;
            _stages = response.Stages;
        }

        _isLoading = false;
    }

    private RenderFragment ExportMenuTemplate => @<ExportMenu OnItemSelected="HandleExportItemSelected" />;

    private IEnumerable<object> Toolbar => new List<object>
    {
        "Print",
        new Syncfusion.Blazor.Navigations.ItemModel { Id = "export", Type = Syncfusion.Blazor.Navigations.ItemType.Input, Template = ExportMenuTemplate, TooltipText = "Export" },
    };

    private async Task HandleExportItemSelected(string id)
    {
        var format = id switch
        {
            "hr-csv" => ReportExportFormat.Csv,
            "hr-excel" => ReportExportFormat.Excel,
            "hr-pdf" => ReportExportFormat.Pdf,
            _ => ReportExportFormat.Csv,
        };

        _exporting = true;
        _exportError = null;
        StateHasChanged();

        var (bytes, contentType, fileName, error) =
            await ReportingService.ExportRecruitmentPipelineSummaryReportAsync(CompanyId, BuildServiceFilter(), format);

        if (bytes is null)
        {
            _exportError = error ?? "Failed to export the recruitment pipeline summary report.";
        }
        else
        {
            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                fileName ?? $"recruitment-pipeline-summary.{format.ToString().ToLowerInvariant()}",
                contentType ?? "application/octet-stream",
                Convert.ToBase64String(bytes));
        }

        _exporting = false;
        StateHasChanged();
    }
}
