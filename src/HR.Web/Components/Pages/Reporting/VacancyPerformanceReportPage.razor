@page "/companies/{CompanyId:guid}/reporting/vacancy-performance"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject AppSession Session
@using HR.Infrastructure.Abstractions
@using HR.Web.Components.Controls
@using HR.Web.Models
@using HR.Web.Services
@inject ReportingService ReportingService
@inject IJSRuntime JS

<PageTitle>Vacancy Performance Report</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Vacancy Performance Report</h1>
    <p class="text-muted mb-3">Per-vacancy days open, applicant count, interview count, offer count and hire date.</p>

    @if (_exportError is not null)
    {
        <div class="alert alert-danger alert-dismissible">
            @_exportError
            <button type="button" class="btn-close" @onclick="@(() => _exportError = null)"></button>
        </div>
    }

    <ReportFilterPanel CompanyId="CompanyId"
                        ReportId="vacancy-performance-report"
                        OnCriteriaChanged="OnFilterChangedAsync"
                        OnViewDeleted="LoadAsync"
                        ShowDepartmentFilter="false"
                        ShowLocationFilter="false"
                        ShowPositionProfileFilter="false"
                        ShowManagerFilter="false"
                        ShowEmploymentTypeFilter="false"
                        ShowStatusFilter="false"
                        DateRangeStartLabel="Start Date From"
                        DateRangeEndLabel="Start Date To" />

    @if (_isLoading)
    {
        <HrLoadingIndicator Label="Loading vacancy performance report…" />
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else
    {
        <HrGrid TValue="VacancyPerformanceReportRowModel"
                Toolbar="@Toolbar"
                DataSource="@_items"
                AllowPaging="true"
                AllowSorting="true">
            <GridColumns>
                <GridColumn Field="@nameof(VacancyPerformanceReportRowModel.VacancyTitle)" HeaderText="Vacancy" Width="200" />
                <GridColumn Field="@nameof(VacancyPerformanceReportRowModel.DaysOpen)" HeaderText="Days Open" Width="120" />
                <GridColumn Field="@nameof(VacancyPerformanceReportRowModel.ApplicantCount)" HeaderText="Applicants" Width="120" />
                <GridColumn Field="@nameof(VacancyPerformanceReportRowModel.InterviewCount)" HeaderText="Interviews" Width="120" />
                <GridColumn Field="@nameof(VacancyPerformanceReportRowModel.OfferCount)" HeaderText="Offers" Width="120" />
                <GridColumn Field="@nameof(VacancyPerformanceReportRowModel.HireDate)" HeaderText="Hire Date" Width="140" Format="d" />
            </GridColumns>
        </HrGrid>

        <div class="mt-3">@_items.Count vacancy(s)</div>
    }
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }

    private List<VacancyPerformanceReportRowModel> _items = [];

    private bool _isLoading = true;
    private string? _error;

    private ReportFilterCriteriaModel _currentFilter = new();

    private bool _exporting;
    private string? _exportError;

    protected override async Task OnParametersSetAsync()
    {
        if (!AppSession.GuardAccess(Navigation, Session.CanViewRecruitmentReports))
            return;
        await LoadAsync();
    }

    private async Task OnFilterChangedAsync(ReportFilterCriteriaModel filter)
    {
        _currentFilter = filter;
        await LoadAsync();
    }

    private VacancyPerformanceReportFilter BuildServiceFilter() => new(
        StartDate: _currentFilter.DateRangeStart,
        EndDate: _currentFilter.DateRangeEnd);

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        StateHasChanged();

        var response = await ReportingService.GetVacancyPerformanceReportAsync(CompanyId, BuildServiceFilter());
        if (response is null)
        {
            _error = "Failed to load the vacancy performance report.";
        }
        else
        {
            _items = response.Items;
        }

        _isLoading = false;
    }

    private RenderFragment ExportMenuTemplate => @<ExportMenu OnItemSelected="HandleExportItemSelected" />;

    private IEnumerable<object> Toolbar => new List<object>
    {
        "Print",
        new Syncfusion.Blazor.Navigations.ItemModel { Id = "export", Type = Syncfusion.Blazor.Navigations.ItemType.Input, Template = ExportMenuTemplate, TooltipText = "Export" },
    };

    private async Task HandleExportItemSelected(string id)
    {
        var format = id switch
        {
            "hr-csv" => ReportExportFormat.Csv,
            "hr-excel" => ReportExportFormat.Excel,
            "hr-pdf" => ReportExportFormat.Pdf,
            _ => ReportExportFormat.Csv,
        };

        _exporting = true;
        _exportError = null;
        StateHasChanged();

        var (bytes, contentType, fileName, error) =
            await ReportingService.ExportVacancyPerformanceReportAsync(CompanyId, BuildServiceFilter(), format);

        if (bytes is null)
        {
            _exportError = error ?? "Failed to export the vacancy performance report.";
        }
        else
        {
            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                fileName ?? $"vacancy-performance-report.{format.ToString().ToLowerInvariant()}",
                contentType ?? "application/octet-stream",
                Convert.ToBase64String(bytes));
        }

        _exporting = false;
        StateHasChanged();
    }
}
