@page "/companies/{CompanyId:guid}/reporting/document-acknowledgement"
@rendermode InteractiveServer
@using HR.Infrastructure.Abstractions
@using HR.Web.Models
@using HR.Web.Services
@inject ReportingService ReportingService
@inject IJSRuntime JS

<PageTitle>Document Acknowledgement Report</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Document Acknowledgement</h1>
    <p class="text-muted mb-3">Company document acknowledgement status by employee.</p>

    @if (_exportError is not null)
    {
        <div class="alert alert-danger alert-dismissible">
            @_exportError
            <button type="button" class="btn-close" @onclick="@(() => _exportError = null)"></button>
        </div>
    }

    @if (_isLoading)
    {
        <HrLoadingIndicator Label="Loading document acknowledgement report…" />
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else
    {
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <div class="card"><div class="card-body"><div class="text-muted small">Total Required</div><div class="fs-4">@_totalRequired</div></div></div>
            </div>
            <div class="col-md-4">
                <div class="card"><div class="card-body"><div class="text-muted small">Total Acknowledged</div><div class="fs-4">@_totalAcknowledged</div></div></div>
            </div>
            <div class="col-md-4">
                <div class="card"><div class="card-body"><div class="text-muted small">Total Outstanding</div><div class="fs-4">@_totalOutstanding</div></div></div>
            </div>
        </div>

        <HrGrid TValue="CompanyDocumentAcknowledgementReportRowModel"
                Toolbar="@Toolbar"
                DataSource="@_items"
                AllowPaging="true"
                AllowSorting="true">
            <GridColumns>
                <GridColumn Field="@nameof(CompanyDocumentAcknowledgementReportRowModel.DocumentTitle)" HeaderText="Document" Width="200" />
                <GridColumn Field="@nameof(CompanyDocumentAcknowledgementReportRowModel.EmployeeName)" HeaderText="Employee" Width="180" />
                <GridColumn HeaderText="Acknowledged" Width="130">
                    <Template>
                        @{
                            var item = (CompanyDocumentAcknowledgementReportRowModel)context;
                        }
                        <span class="badge @(item.Acknowledged ? "bg-success" : "bg-warning text-dark")">@(item.Acknowledged ? "Yes" : "No")</span>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(CompanyDocumentAcknowledgementReportRowModel.AcknowledgedAt)" HeaderText="Acknowledged At" Width="170" Format="g" />
            </GridColumns>
        </HrGrid>

        <div class="mt-3">@_items.Count row(s)</div>
    }
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }

    private List<CompanyDocumentAcknowledgementReportRowModel> _items = [];
    private int _totalRequired;
    private int _totalAcknowledged;
    private int _totalOutstanding;

    private bool _isLoading = true;
    private string? _error;

    private bool _exporting;
    private string? _exportError;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        StateHasChanged();

        var response = await ReportingService.GetCompanyDocumentAcknowledgementReportAsync(CompanyId);
        if (response is null)
        {
            _error = "Failed to load the document acknowledgement report.";
        }
        else
        {
            _items = response.Items;
            _totalRequired = response.TotalRequired;
            _totalAcknowledged = response.TotalAcknowledged;
            _totalOutstanding = response.TotalOutstanding;
        }

        _isLoading = false;
    }

    private RenderFragment ExportMenuTemplate => @<ExportMenu OnItemSelected="HandleExportItemSelected" />;

    private IEnumerable<object> Toolbar => new List<object>
    {
        "Print",
        new Syncfusion.Blazor.Navigations.ItemModel { Id = "export", Type = Syncfusion.Blazor.Navigations.ItemType.Input, Template = ExportMenuTemplate, TooltipText = "Export" },
    };

    private async Task HandleExportItemSelected(string id)
    {
        var format = id switch
        {
            "hr-csv" => ReportExportFormat.Csv,
            "hr-excel" => ReportExportFormat.Excel,
            "hr-pdf" => ReportExportFormat.Pdf,
            _ => ReportExportFormat.Csv,
        };

        _exporting = true;
        _exportError = null;
        StateHasChanged();

        var (bytes, contentType, fileName, error) =
            await ReportingService.ExportCompanyDocumentAcknowledgementReportAsync(CompanyId, format);

        if (bytes is null)
        {
            _exportError = error ?? "Failed to export the document acknowledgement report.";
        }
        else
        {
            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                fileName ?? $"document-acknowledgement-report.{format.ToString().ToLowerInvariant()}",
                contentType ?? "application/octet-stream",
                Convert.ToBase64String(bytes));
        }

        _exporting = false;
        StateHasChanged();
    }
}
