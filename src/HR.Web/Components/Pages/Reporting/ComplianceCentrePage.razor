@page "/companies/{CompanyId:guid}/reporting/compliance-centre"
@rendermode InteractiveServer
@using HR.Infrastructure.Abstractions
@using HR.Web.Models
@using HR.Web.Services
@inject ReportingService ReportingService
@inject EmployeeService EmployeeService
@inject NavigationManager Navigation
@inject AppSession Session

<PageTitle>Compliance Centre</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Compliance Centre</h1>
    <p class="text-muted mb-3">A consolidated, prioritised view of every outstanding compliance action across the company — expiring visas, certifications and other documents, missing required documents, outstanding document requests and probation reviews.</p>

    @if (_isLoading)
    {
        <HrLoadingIndicator Label="Loading compliance centre…" />
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else
    {
        <div class="row g-3 mb-3">
            <div class="col-md-3">
                <div class="card"><div class="card-body"><div class="text-muted small">Total</div><div class="fs-4">@_summary.Total</div></div></div>
            </div>
            <div class="col-md-3">
                <div class="card"><div class="card-body"><div class="text-muted small">Overdue</div><div class="fs-4 text-danger">@_summary.Overdue</div></div></div>
            </div>
            <div class="col-md-3">
                <div class="card"><div class="card-body"><div class="text-muted small">Due soon</div><div class="fs-4 text-warning">@_summary.DueSoon</div></div></div>
            </div>
            <div class="col-md-3">
                <div class="card"><div class="card-body"><div class="text-muted small">Informational</div><div class="fs-4 text-secondary">@_summary.Informational</div></div></div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h6 mb-3">Consolidated sections</h2>
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th class="text-end">Total</th>
                            <th class="text-end">Overdue</th>
                            <th class="text-end">Due soon</th>
                            <th class="text-end">Informational</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in _categorySummaries)
                        {
                            <tr>
                                <td>@c.CategoryLabel</td>
                                <td class="text-end">@c.Total</td>
                                <td class="text-end">@c.Overdue</td>
                                <td class="text-end">@c.DueSoon</td>
                                <td class="text-end">@c.Informational</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Category</label>
                        <SfDropDownList TValue="string?"
                                        TItem="CategoryOption"
                                        DataSource="@_categoryOptions"
                                        Value="@_category"
                                        ValueChanged="OnCategoryChangedAsync"
                                        Placeholder="All categories">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Severity</label>
                        <SfDropDownList TValue="string?"
                                        TItem="CategoryOption"
                                        DataSource="@_severityOptions"
                                        Value="@_severity"
                                        ValueChanged="OnSeverityChangedAsync"
                                        Placeholder="All severities">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Department</label>
                        <SfDropDownList TValue="string?"
                                        TItem="string"
                                        DataSource="@_departmentOptions"
                                        Value="@_department"
                                        ValueChanged="OnDepartmentChangedAsync"
                                        Placeholder="All departments"
                                        AllowFiltering="true" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Manager</label>
                        <SfDropDownList @ref="_managerDropdown"
                                        TValue="Guid?"
                                        TItem="EmployeeOption"
                                        DataSource="@_managerOptions"
                                        Value="@_managerId"
                                        ValueChanged="OnManagerChangedAsync"
                                        Placeholder="All managers"
                                        AllowFiltering="true">
                            <DropDownListFieldSettings Value="Id" Text="Name" />
                            <DropDownListEvents TValue="Guid?" TItem="EmployeeOption" Filtering="OnManagerFilteringAsync" />
                        </SfDropDownList>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Due date from</label>
                        <SfDatePicker TValue="DateOnly?" Value="@_dueDateStart" ValueChanged="OnDueDateStartChangedAsync" Format="dd/MM/yyyy" Placeholder="dd/mm/yyyy" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Due date to</label>
                        <SfDatePicker TValue="DateOnly?" Value="@_dueDateEnd" ValueChanged="OnDueDateEndChangedAsync" Format="dd/MM/yyyy" Placeholder="dd/mm/yyyy" />
                    </div>
                    <div class="col-md-auto d-flex align-items-end">
                        <SfButton OnClick="ClearFiltersAsync">Clear</SfButton>
                    </div>
                </div>
            </div>
        </div>

        @if (_noActionRequired)
        {
            <div class="alert alert-success">
                <strong>No compliance action required.</strong> Everything is up to date for the current filters.
            </div>
        }
        else
        {
            @if (_isTruncated)
            {
                <div class="alert alert-warning">
                    Showing the first @_items.Count of @_totalCount items. Narrow the filters to see the rest.
                </div>
            }

            <HrGrid TValue="ComplianceItemRowModel"
                    DataSource="@_items"
                    AllowPaging="true"
                    AllowSorting="true">
                <GridColumns>
                    <GridColumn HeaderText="Employee" Width="180">
                        <Template>
                            @{
                                var item = (ComplianceItemRowModel)context;
                            }
                            <a href="javascript:void(0)" @onclick="@(() => GoTo(item))">@item.EmployeeName</a>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(ComplianceItemRowModel.Department)" HeaderText="Department" Width="140" />
                    <GridColumn Field="@nameof(ComplianceItemRowModel.CategoryLabel)" HeaderText="Category" Width="170" />
                    <GridColumn Field="@nameof(ComplianceItemRowModel.Detail)" HeaderText="Detail" Width="240" />
                    <GridColumn Field="@nameof(ComplianceItemRowModel.DueDate)" HeaderText="Due date" Width="110" Format="d" />
                    <GridColumn HeaderText="Severity" Width="120">
                        <Template>
                            @{
                                var item = (ComplianceItemRowModel)context;
                            }
                            <span class="@SeverityBadgeClass(item.Severity)">@SeverityLabel(item.Severity)</span>
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="Action" Width="90">
                        <Template>
                            @{
                                var item = (ComplianceItemRowModel)context;
                            }
                            <SfButton OnClick="@(() => GoTo(item))">Open</SfButton>
                        </Template>
                    </GridColumn>
                </GridColumns>
            </HrGrid>

            <div class="mt-3">@_items.Count item(s)</div>
        }
    }
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }

    private List<ComplianceItemRowModel> _items = [];
    private List<ComplianceCategorySummaryModel> _categorySummaries = [];
    private ComplianceCentreSummaryModel _summary = new(0, 0, 0, 0);
    private int _totalCount;
    private bool _isTruncated;
    private bool _noActionRequired;

    private bool _isLoading = true;
    private string? _error;

    private string? _category;
    private string? _severity;
    private string? _department;
    private Guid? _managerId;
    private DateOnly? _dueDateStart;
    private DateOnly? _dueDateEnd;

    private List<string> _departmentOptions = [];
    private List<EmployeeOption> _managerOptions = [];
    private Syncfusion.Blazor.DropDowns.SfDropDownList<Guid?, EmployeeOption> _managerDropdown = default!;

    private sealed record EmployeeOption(Guid Id, string Name);
    private sealed record CategoryOption(string Value, string Label);

    private static readonly CategoryOption[] _categoryOptions =
    [
        new("ExpiringVisa", "Expiring visa"),
        new("ExpiringCertification", "Expiring certification"),
        new("ExpiringOtherDocument", "Expiring other document"),
        new("MissingRequiredDocument", "Missing required document"),
        new("OutstandingDocumentRequest", "Outstanding document request"),
        new("ProbationReview", "Probation review"),
    ];

    private static readonly CategoryOption[] _severityOptions =
    [
        new("Overdue", "Overdue"),
        new("DueSoon", "Due soon"),
        new("Informational", "Informational"),
    ];

    protected override async Task OnParametersSetAsync()
    {
        if (!AppSession.GuardAccess(Navigation, Session.CanViewComplianceCentre))
            return;

        var employees = (await EmployeeService.ListEmployeesAsync(CompanyId, pageSize: 50))?.Items ?? [];
        _managerOptions = employees
            .Select(e => new EmployeeOption(e.Id, $"{e.FirstName} {e.LastName}"))
            .OrderBy(e => e.Name)
            .ToList();

        await LoadAsync();
    }

    private ComplianceCentreFilter BuildFilter() => new(
        Category: _category,
        Department: _department,
        ManagerId: _managerId,
        DueDateStart: _dueDateStart,
        DueDateEnd: _dueDateEnd,
        Severity: _severity);

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        StateHasChanged();

        var response = await ReportingService.GetComplianceCentreAsync(CompanyId, BuildFilter());
        if (response is null)
        {
            _error = "Failed to load the compliance centre.";
        }
        else
        {
            _items = response.Items;
            _categorySummaries = response.CategorySummaries;
            _summary = response.Summary;
            _totalCount = response.TotalCount;
            _isTruncated = response.IsTruncated;
            _noActionRequired = response.NoActionRequired;

            // Department filter offers real values from the loaded rows — the compliance-centre
            // backend contract has no dedicated department lookup endpoint.
            if (_department is null)
            {
                _departmentOptions = _items
                    .Select(r => r.Department)
                    .Where(d => !string.IsNullOrWhiteSpace(d))
                    .Distinct()
                    .OrderBy(x => x)
                    .ToList()!;
            }
        }

        _isLoading = false;
        StateHasChanged();
    }

    private async Task OnCategoryChangedAsync(string? value) { _category = value; await LoadAsync(); }
    private async Task OnSeverityChangedAsync(string? value) { _severity = value; await LoadAsync(); }
    private async Task OnDepartmentChangedAsync(string? value) { _department = value; await LoadAsync(); }
    private async Task OnManagerChangedAsync(Guid? value) { _managerId = value; await LoadAsync(); }
    private async Task OnDueDateStartChangedAsync(DateOnly? value) { _dueDateStart = value; await LoadAsync(); }
    private async Task OnDueDateEndChangedAsync(DateOnly? value) { _dueDateEnd = value; await LoadAsync(); }

    private async Task ClearFiltersAsync()
    {
        _category = null;
        _severity = null;
        _department = null;
        _managerId = null;
        _dueDateStart = null;
        _dueDateEnd = null;
        await LoadAsync();
    }

    private int _managerFilterRequestId;

    private async Task OnManagerFilteringAsync(Syncfusion.Blazor.DropDowns.FilteringEventArgs args)
    {
        args.PreventDefaultAction = true;
        var requestId = ++_managerFilterRequestId;
        var result = await EmployeeService.ListEmployeesAsync(CompanyId, search: args.Text, pageSize: 50);
        if (requestId != _managerFilterRequestId) return;
        _managerOptions = (result?.Items ?? [])
            .Select(e => new EmployeeOption(e.Id, $"{e.FirstName} {e.LastName}"))
            .OrderBy(e => e.Name)
            .ToList();
        await _managerDropdown.FilterAsync(_managerOptions, new Syncfusion.Blazor.Data.Query());
    }

    private void GoTo(ComplianceItemRowModel row)
    {
        if (!string.IsNullOrWhiteSpace(row.DeepLinkUrl))
            Navigation.NavigateTo(row.DeepLinkUrl);
    }

    private static string SeverityBadgeClass(string severity) => severity switch
    {
        "Overdue" => "badge bg-danger",
        "DueSoon" => "badge bg-warning text-dark",
        _ => "badge bg-secondary",
    };

    private static string SeverityLabel(string severity) => severity switch
    {
        "DueSoon" => "Due soon",
        _ => severity,
    };
}
