@page "/companies/{CompanyId:guid}/sickness-categories/new"
@page "/companies/{CompanyId:guid}/sickness-categories/{Id:guid}"
@page "/companies/{CompanyId:guid}/sickness-categories/{Id:guid}/view"
@rendermode InteractiveServer
@inject SicknessCategoryService SicknessCategoryService
@inject NavigationManager Navigation

<PageTitle>@PageTitle</PageTitle>

<div class="container py-4">
    <SfBreadcrumb Class="mb-3">
        <BreadcrumbItems>
            <BreadcrumbItem Text="Sickness Categories" Url="@($"/companies/{CompanyId}/sickness-categories")" />
            <BreadcrumbItem Text="@PageTitle" />
        </BreadcrumbItems>
    </SfBreadcrumb>

    @if (_loading)
    {
        <div class="d-flex align-items-center gap-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Loading…</span>
        </div>
    }
    else
    {
        <h1 class="mb-1">@PageTitle</h1>
        <p class="text-muted mb-4">Set the name and display order for this sickness category.</p>

        @if (!string.IsNullOrEmpty(_globalError))
        {
            <div class="alert alert-danger">@_globalError</div>
        }

        <div class="row">
            <div class="col-lg-7">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Sickness Category Details</h5>
                    </div>
                    <div class="card-body @(_isViewMode ? "view-mode" : "")">
                        <div class="mb-3">
                            <label class="form-label">Name <span class="text-danger">*</span></label>
                            <HrTextBox @bind-Value="_model.Name" Placeholder="e.g. Cold, Stress, Back Pain" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Display Order</label>
                            <SfNumericTextBox TValue="int" @bind-Value="_model.DisplayOrder" Min="0" />
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    @if (!_isViewMode)
                    {
                        @if (!string.IsNullOrEmpty(_successMsg))
                        {
                            <div class="alert alert-success py-2 mb-0 d-flex align-items-center">@_successMsg</div>
                        }
                        <SfButton IsPrimary="true" Disabled="@_saving" OnClick="Save">
                            @if (_saving)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            Save
                        </SfButton>
                    }
                    <SfButton OnClick="Cancel" Disabled="@_saving">@(_isViewMode ? "Close" : "Cancel")</SfButton>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid? Id { get; set; }

    private bool _isViewMode;
    private bool IsNew => Id is null || Id == Guid.Empty;
    private string PageTitle => IsNew ? "Add Sickness Category"
        : _model.Name.Trim().Length > 0 ? _model.Name
        : _isViewMode ? "View Sickness Category" : "Edit Sickness Category";

    private bool _loading = true;
    private bool _saving;
    private string? _globalError;
    private string? _successMsg;

    private readonly SicknessCategoryEditModel _model = new();

    protected override async Task OnParametersSetAsync()
    {
        _isViewMode = Navigation.Uri.Contains("/view", StringComparison.OrdinalIgnoreCase);
        _loading = true;
        _globalError = null;
        _successMsg = null;

        if (!IsNew)
        {
            var list = await SicknessCategoryService.ListSicknessCategoriesAsync(CompanyId);
            var existing = list?.Items.FirstOrDefault(e => e.Id == Id);
            if (existing is not null)
            {
                _model.Name = existing.Name;
                _model.DisplayOrder = existing.DisplayOrder;
            }
        }

        _loading = false;
    }

    private async Task Save()
    {
        _saving = true;
        _globalError = null;
        _successMsg = null;

        if (IsNew)
        {
            var request = new CreateSicknessCategoryRequest(
                CompanyId,
                _model.Name.Trim(),
                _model.DisplayOrder);

            var (created, error) = await SicknessCategoryService.CreateAsync(CompanyId, request);
            _saving = false;

            if (created is not null)
                Navigation.NavigateTo($"/companies/{CompanyId}/sickness-categories", forceLoad: true);
            else
                _globalError = error ?? "Failed to create sickness category.";
        }
        else
        {
            var request = new UpdateSicknessCategoryRequest(
                CompanyId,
                Id!.Value,
                _model.Name.Trim(),
                _model.DisplayOrder);

            var (updated, error) = await SicknessCategoryService.UpdateAsync(CompanyId, Id!.Value, request);
            _saving = false;

            if (updated is not null)
                Navigation.NavigateTo($"/companies/{CompanyId}/sickness-categories", forceLoad: true);
            else
                _globalError = error ?? "Failed to save sickness category.";
        }
    }

    private void Cancel() => Navigation.NavigateTo($"/companies/{CompanyId}/sickness-categories");
}
