@page "/companies/{CompanyId:guid}/position-profiles/new"
@page "/companies/{CompanyId:guid}/position-profiles/{Id:guid}"
@page "/companies/{CompanyId:guid}/position-profiles/{Id:guid}/view"
@rendermode InteractiveServer
@inject PositionProfileService PositionProfileService
@inject DepartmentService DepartmentService
@inject LocationService LocationService
@inject LeavePolicyService LeavePolicyService
@inject OnboardingTemplateService OnboardingTemplateService
@inherits EditPageBase<PositionProfileEditModel>
@using HR.Infrastructure.Abstractions
@using HR.Web.Components.Pages.Employees

<PageTitle>@PageTitle</PageTitle>

<div class="container py-4">
    <SfBreadcrumb Class="mb-3">
        <BreadcrumbItems>
            <BreadcrumbItem Text="Position Profiles" Url="@($"/companies/{CompanyId}/position-profiles")" />
            <BreadcrumbItem Text="@PageTitle" />
        </BreadcrumbItems>
    </SfBreadcrumb>

    @if (IsLoading)
    {
        <HrLoadingIndicator />
    }
    else
    {
        <h1 class="mb-1">@PageTitle</h1>
        <p class="text-muted mb-4">Set the job title, department, and required documents for this position.</p>

        @if (!string.IsNullOrEmpty(GlobalError))
        {
            <div class="alert alert-danger">@GlobalError</div>
        }

        @if (IsNew)
        {
            <div class="row">
                <div class="col-lg-7">
                    <EditForm EditContext="EditContext">
                        <DataAnnotationsValidator />
                        <div class="card mb-4">
                            <div class="card-header"><h5 class="mb-0">Position Profile Details</h5></div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label class="form-label">Title <span class="text-danger">*</span></label>
                                    <HrTextBox @bind-Value="Model.Title" Placeholder="e.g. Senior Software Engineer" />
                                    <ValidationMessage For="@(() => Model.Title)" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Description</label>
                                    <HrTextBox @bind-Value="Model.Description" Placeholder="Optional description" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Department <span class="text-danger">*</span></label>
                                    <SfDropDownList TValue="Guid?"
                                                    TItem="DepartmentListItemModel"
                                                    DataSource="@_departments"
                                                    @bind-Value="Model.DepartmentId"
                                                    Placeholder="Select department"
                                                    AllowFiltering="true">
                                        <DropDownListFieldSettings Value="Id" Text="Name" />
                                    </SfDropDownList>
                                    <ValidationMessage For="@(() => Model.DepartmentId)" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Location <span class="text-danger">*</span></label>
                                    <SfDropDownList TValue="Guid?"
                                                    TItem="LocationListItemModel"
                                                    DataSource="@_locations"
                                                    @bind-Value="Model.LocationId"
                                                    Placeholder="Select location"
                                                    AllowFiltering="true">
                                        <DropDownListFieldSettings Value="Id" Text="Name" />
                                    </SfDropDownList>
                                    <ValidationMessage For="@(() => Model.LocationId)" />
                                </div>
                            </div>
                        </div>

                        @DefaultsCard()

                        <div class="d-flex gap-2 align-items-center mt-3 justify-content-end">
                            <SfButton IsPrimary="true" Disabled="@Saving" OnClick="SaveAsync">
                                @if (Saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                Save
                            </SfButton>
                            <SfButton OnClick="RequestClose" Disabled="@Saving">Close</SfButton>
                        </div>
                    </EditForm>
                </div>
            </div>
        }
        else
        {
            <SfTab>
                <TabItems>
                    <TabItem>
                        <ChildContent><TabHeader Text="Details" /></ChildContent>
                        <ContentTemplate>
                            <div class="mt-4">
                                <div class="row">
                                    <div class="col-lg-7">
                                        <EditForm EditContext="EditContext">
                                            <DataAnnotationsValidator />
                                            <div class="card mb-4">
                                                <div class="card-header"><h5 class="mb-0">Position Profile Details</h5></div>
                                                <div class="card-body @(IsViewMode ? "view-mode" : "")">
                                                    <div class="mb-3">
                                                        <label class="form-label">Title <span class="text-danger">*</span></label>
                                                        <HrTextBox @bind-Value="Model.Title" Placeholder="e.g. Senior Software Engineer" />
                                                        <ValidationMessage For="@(() => Model.Title)" />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label">Description</label>
                                                        <HrTextBox @bind-Value="Model.Description" Placeholder="Optional description" />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label">Department <span class="text-danger">*</span></label>
                                                        <SfDropDownList TValue="Guid?"
                                                                        TItem="DepartmentListItemModel"
                                                                        DataSource="@_departments"
                                                                        @bind-Value="Model.DepartmentId"
                                                                        Placeholder="Select department"
                                                                        AllowFiltering="true">
                                                            <DropDownListFieldSettings Value="Id" Text="Name" />
                                                        </SfDropDownList>
                                                        <ValidationMessage For="@(() => Model.DepartmentId)" />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label">Location <span class="text-danger">*</span></label>
                                                        <SfDropDownList TValue="Guid?"
                                                                        TItem="LocationListItemModel"
                                                                        DataSource="@_locations"
                                                                        @bind-Value="Model.LocationId"
                                                                        Placeholder="Select location"
                                                                        AllowFiltering="true">
                                                            <DropDownListFieldSettings Value="Id" Text="Name" />
                                                        </SfDropDownList>
                                                        <ValidationMessage For="@(() => Model.LocationId)" />
                                                    </div>
                                                </div>
                                            </div>

                                            @DefaultsCard()

                                            <div class="d-flex gap-2 align-items-center mt-3 justify-content-end">
                                                @if (!IsViewMode)
                                                {
                                                    <SfButton IsPrimary="true" Disabled="@Saving" OnClick="SaveAsync">
                                                        @if (Saving)
                                                        {
                                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                                        }
                                                        Save
                                                    </SfButton>
                                                }
                                                <SfButton OnClick="RequestClose" Disabled="@Saving">Close</SfButton>
                                            </div>
                                        </EditForm>
                                    </div>
                                </div>
                            </div>
                        </ContentTemplate>
                    </TabItem>
                    <TabItem>
                        <ChildContent><TabHeader Text="Required Documents" /></ChildContent>
                        <ContentTemplate>
                            <div class="mt-4">
                                <PositionProfileRequiredDocumentsTab
                                    CompanyId="CompanyId"
                                    PositionProfileId="Id!.Value"
                                    CanEdit="!IsViewMode" />
                            </div>
                        </ContentTemplate>
                    </TabItem>
                    <TabItem>
                        <ChildContent><TabHeader Text="Required Assets" /></ChildContent>
                        <ContentTemplate>
                            <div class="mt-4">
                                <PositionProfileRequiredAssetsTab
                                    CompanyId="CompanyId"
                                    PositionProfileId="Id!.Value"
                                    CanEdit="!IsViewMode" />
                            </div>
                        </ContentTemplate>
                    </TabItem>
                    <TabItem>
                        <ChildContent><TabHeader Text="Onboarding Templates" /></ChildContent>
                        <ContentTemplate>
                            <div class="mt-4">
                                <PositionProfileOnboardingTab
                                    CompanyId="CompanyId"
                                    PositionProfileId="Id!.Value"
                                    CanEdit="!IsViewMode" />
                            </div>
                        </ContentTemplate>
                    </TabItem>
                </TabItems>
            </SfTab>
        }
    }

    <NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges" />

    <UnsavedChangesDialog Visible="ShowUnsavedChangesDialog"
                          OnSaveAndClose="ConfirmSaveAndCloseAsync"
                          OnDiscard="DiscardChangesAndClose"
                          OnCancel="CancelCloseDialog" />
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid? Id { get; set; }

    private bool IsNew => Id is null || Id == Guid.Empty;
    private string PageTitle => IsNew ? "Add Position Profile"
        : Model.Title.Trim().Length > 0 ? Model.Title.Trim()
        : IsViewMode ? "View Position Profile" : "Edit Position Profile";

    private List<DepartmentListItemModel> _departments = [];
    private List<LocationListItemModel> _locations = [];
    private List<LeavePolicyListItemModel> _leavePolicies = [];
    private List<OnboardingTemplateListItemModel> _onboardingTemplates = [];

    private static readonly string[] _allDays =
        ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];

    private static readonly NoticePeriodUnitChoice[] NoticePeriodUnitOptions =
    [
        new(NoticePeriodUnit.Weeks, "Weeks"),
        new(NoticePeriodUnit.Months, "Months")
    ];

    private sealed record NoticePeriodUnitChoice(NoticePeriodUnit Value, string Label);

    protected override async Task LoadAsync()
    {
        var deptTask = DepartmentService.ListDepartmentsAsync(CompanyId);
        var locationTask = LocationService.ListLocationsAsync(CompanyId);
        var leavePolicyTask = LeavePolicyService.ListLeavePoliciesAsync(CompanyId, activeOnly: true);
        var onboardingTemplateTask = OnboardingTemplateService.ListOnboardingTemplatesAsync(CompanyId);

        await Task.WhenAll(deptTask, locationTask, leavePolicyTask, onboardingTemplateTask);

        _departments = (await deptTask)?.Items ?? [];
        _locations = (await locationTask)?.Items ?? [];
        _leavePolicies = (await leavePolicyTask)?.Items ?? [];
        _onboardingTemplates = ((await onboardingTemplateTask)?.Items ?? [])
            .Prepend(new OnboardingTemplateListItemModel(Guid.Empty, "None", null, true, 0))
            .ToList();

        Model.OnboardingTemplateId ??= Guid.Empty;

        if (!IsNew)
        {
            var profile = await PositionProfileService.GetPositionProfileAsync(CompanyId, Id!.Value);
            if (profile is not null)
            {
                Model.Title = profile.Title;
                Model.Description = profile.Description;
                Model.DepartmentId = profile.DepartmentId;
                Model.LocationId = profile.LocationId;
                Model.ProbationMonthsOverride = profile.ProbationMonthsOverride;
                Model.SalaryMin = profile.SalaryMin;
                Model.SalaryMax = profile.SalaryMax;
                Model.SalaryType = profile.SalaryType ?? "Annual";
                Model.DefaultLeavePolicyId = profile.DefaultLeavePolicyId;
                Model.OnboardingTemplateId = profile.OnboardingTemplateId ?? Guid.Empty;

                if (profile.WorkingDaysOverride.HasValue && profile.HoursPerDayOverride.HasValue)
                {
                    Model.UseCompanyWorkingPattern = false;
                    Model.WorkingWeek = _allDays
                        .Where(d => Enum.TryParse<WorkingDays>(d, out var wd) && profile.WorkingDaysOverride.Value.HasFlag(wd))
                        .ToHashSet();
                    Model.HoursPerDay = profile.HoursPerDayOverride.Value;
                }
                else
                {
                    Model.UseCompanyWorkingPattern = true;
                }

                if (profile.NoticePeriodUnitOverride.HasValue && profile.NoticePeriodLengthOverride.HasValue)
                {
                    Model.OverrideNoticePeriod = true;
                    Model.NoticePeriodUnit = profile.NoticePeriodUnitOverride.Value;
                    Model.NoticePeriodLength = profile.NoticePeriodLengthOverride.Value;
                }
                else
                {
                    Model.OverrideNoticePeriod = false;
                }
            }
        }
    }

    protected override async Task<string?> SaveCoreAsync()
    {
        WorkingDays? workingDaysOverride = null;
        decimal? hoursPerDayOverride = null;

        if (!Model.UseCompanyWorkingPattern)
        {
            workingDaysOverride = Model.WorkingWeek
                .Aggregate(WorkingDays.None, (acc, day) => Enum.TryParse<WorkingDays>(day, out var wd) ? acc | wd : acc);
            hoursPerDayOverride = Model.HoursPerDay;
        }

        NoticePeriodUnit? noticePeriodUnitOverride = Model.OverrideNoticePeriod ? Model.NoticePeriodUnit : null;
        int? noticePeriodLengthOverride = Model.OverrideNoticePeriod ? Model.NoticePeriodLength : null;

        if (IsNew)
        {
            var request = new CreatePositionProfileRequest(
                CompanyId,
                Model.DepartmentId!.Value,
                Model.LocationId!.Value,
                Model.Title.Trim(),
                string.IsNullOrWhiteSpace(Model.Description) ? null : Model.Description.Trim(),
                Model.ProbationMonthsOverride,
                workingDaysOverride,
                hoursPerDayOverride,
                Model.SalaryMin,
                Model.SalaryMax,
                Model.SalaryType,
                Model.DefaultLeavePolicyId!.Value,
                Model.OnboardingTemplateId == Guid.Empty ? null : Model.OnboardingTemplateId,
                NoticePeriodUnitOverride: noticePeriodUnitOverride,
                NoticePeriodLengthOverride: noticePeriodLengthOverride);

            var (created, error) = await PositionProfileService.CreatePositionProfileAsync(CompanyId, request);
            return created is not null ? null : error ?? "Failed to create position profile.";
        }
        else
        {
            var request = new UpdatePositionProfileRequest(
                CompanyId,
                Id!.Value,
                Model.DepartmentId!.Value,
                Model.LocationId!.Value,
                Model.Title.Trim(),
                string.IsNullOrWhiteSpace(Model.Description) ? null : Model.Description.Trim(),
                Model.ProbationMonthsOverride,
                workingDaysOverride,
                hoursPerDayOverride,
                Model.SalaryMin,
                Model.SalaryMax,
                Model.SalaryType,
                Model.DefaultLeavePolicyId!.Value,
                Model.OnboardingTemplateId == Guid.Empty ? null : Model.OnboardingTemplateId,
                NoticePeriodUnitOverride: noticePeriodUnitOverride,
                NoticePeriodLengthOverride: noticePeriodLengthOverride);

            var (success, error) = await PositionProfileService.UpdatePositionProfileAsync(CompanyId, Id!.Value, request);
            return success ? null : error;
        }
    }

    private void ToggleWorkingDay(string day, bool isChecked)
    {
        if (isChecked) Model.WorkingWeek.Add(day);
        else Model.WorkingWeek.Remove(day);
    }

    private RenderFragment DefaultsCard() => @<div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Defaults</h5>
        </div>
        <div class="card-body @(IsViewMode ? "view-mode" : "")">
            <div class="mb-3">
                <label class="form-label">Probation Months Override</label>
                <SfNumericTextBox TValue="int?" @bind-Value="Model.ProbationMonthsOverride" Min="1" Max="24" ShowSpinButton="false" Placeholder="Use company default" />
                <ValidationMessage For="@(() => Model.ProbationMonthsOverride)" />
            </div>
            <div class="mb-3">
                <label class="form-label">Salary Range <span class="text-muted small">(guidance only)</span></label>
                <div class="row g-2">
                    <div class="col-4">
                        <SfNumericTextBox TValue="decimal?" @bind-Value="Model.SalaryMin" Placeholder="Min" ShowSpinButton="false" Format="0" />
                    </div>
                    <div class="col-4">
                        <SfNumericTextBox TValue="decimal?" @bind-Value="Model.SalaryMax" Placeholder="Max" ShowSpinButton="false" Format="0" />
                    </div>
                    <div class="col-4">
                        <SfDropDownList TValue="string" TItem="AddCompensationDialog.SalaryTypeChoice"
                                        DataSource="@AddCompensationDialog.SalaryTypeOptions"
                                        @bind-Value="Model.SalaryType"
                                        Placeholder="Type">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                </div>
                <ValidationMessage For="@(() => Model.SalaryMax)" />
            </div>
            <div class="mb-3">
                <label class="form-label">Default Leave Policy <span class="text-danger">*</span></label>
                <SfDropDownList TValue="Guid?"
                                TItem="LeavePolicyListItemModel"
                                DataSource="@_leavePolicies"
                                @bind-Value="Model.DefaultLeavePolicyId"
                                Placeholder="Select leave policy"
                                AllowFiltering="true">
                    <DropDownListFieldSettings Value="Id" Text="Name" />
                </SfDropDownList>
                <ValidationMessage For="@(() => Model.DefaultLeavePolicyId)" />
            </div>
            <div class="mb-3">
                <label class="form-label">Onboarding Template</label>
                <SfDropDownList TValue="Guid?"
                                TItem="OnboardingTemplateListItemModel"
                                DataSource="@_onboardingTemplates"
                                @bind-Value="Model.OnboardingTemplateId"
                                Placeholder="None"
                                AllowFiltering="true">
                    <DropDownListFieldSettings Value="Id" Text="Name" />
                </SfDropDownList>
            </div>
            <div class="mb-3">
                <SfCheckBox TChecked="bool"
                            Label="Use company working pattern"
                            Checked="@Model.UseCompanyWorkingPattern"
                            CheckedChanged="@((bool v) => Model.UseCompanyWorkingPattern = v)" />
                @if (!Model.UseCompanyWorkingPattern)
                {
                    <div class="row g-3 mt-2">
                        <div class="col-12">
                            <label class="form-label fw-semibold">Working Days</label>
                            <div class="d-flex flex-wrap gap-3 mt-1">
                                @foreach (var day in _allDays)
                                {
                                    <SfCheckBox TChecked="bool" Label="@day"
                                                Checked="@Model.WorkingWeek.Contains(day)"
                                                CheckedChanged="@(e => ToggleWorkingDay(day, e))" />
                                }
                            </div>
                        </div>
                        <div class="col-md-4">
                            <SfNumericTextBox TValue="decimal" @bind-Value="Model.HoursPerDay"
                                              Placeholder="Hours Per Day"
                                              FloatLabelType="FloatLabelType.Auto"
                                              ShowSpinButton="false"
                                              Min="0.5m" Max="24m" Step="0.5m" />
                            <ValidationMessage For="@(() => Model.HoursPerDay)" />
                        </div>
                    </div>
                }
            </div>
            <div>
                <SfCheckBox TChecked="bool"
                            Label="Override company default notice period"
                            Checked="@Model.OverrideNoticePeriod"
                            CheckedChanged="@((bool v) => Model.OverrideNoticePeriod = v)" />
                @if (Model.OverrideNoticePeriod)
                {
                    <div class="row g-3 mt-2">
                        <div class="col-md-4">
                            <label class="form-label">Length</label>
                            <SfNumericTextBox TValue="int" @bind-Value="Model.NoticePeriodLength"
                                              ShowSpinButton="false"
                                              Min="1" />
                            <ValidationMessage For="@(() => Model.NoticePeriodLength)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Unit</label>
                            <SfDropDownList TValue="NoticePeriodUnit" TItem="NoticePeriodUnitChoice"
                                            DataSource="@NoticePeriodUnitOptions"
                                            @bind-Value="Model.NoticePeriodUnit"
                                            Placeholder="Unit">
                                <DropDownListFieldSettings Value="Value" Text="Label" />
                            </SfDropDownList>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>;

    protected override string? ListUrl => $"/companies/{CompanyId}/position-profiles";
}
