@page "/companies/{CompanyId:guid}/position-profiles/new"
@page "/companies/{CompanyId:guid}/position-profiles/{Id:guid}"
@page "/companies/{CompanyId:guid}/position-profiles/{Id:guid}/view"
@rendermode InteractiveServer
@inject PositionProfileService PositionProfileService
@inject DepartmentService DepartmentService
@inject NavigationManager Navigation

<PageTitle>@PageTitle</PageTitle>

<div class="container py-4">
    <SfBreadcrumb Class="mb-3">
        <BreadcrumbItems>
            <BreadcrumbItem Text="Position Profiles" Url="@($"/companies/{CompanyId}/position-profiles")" />
            <BreadcrumbItem Text="@PageTitle" />
        </BreadcrumbItems>
    </SfBreadcrumb>

    @if (_loading)
    {
        <div class="d-flex align-items-center gap-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Loading…</span>
        </div>
    }
    else
    {
        <h1 class="mb-4">@PageTitle</h1>

        @if (!string.IsNullOrEmpty(_globalError))
        {
            <div class="alert alert-danger">@_globalError</div>
        }

        @if (IsNew)
        {
            <div class="row">
                <div class="col-lg-7">
                    <div class="card mb-4">
                        <div class="card-header"><h5 class="mb-0">Position Profile Details</h5></div>
                        <div class="card-body">
                            @DetailsFormFields
                        </div>
                    </div>
                    @FormButtons
                </div>
            </div>
        }
        else
        {
            <SfTab>
                <TabItems>
                    <TabItem>
                        <ChildContent><TabHeader Text="Details" /></ChildContent>
                        <ContentTemplate>
                            <div class="mt-4">
                                <div class="row">
                                    <div class="col-lg-7">
                                        <div class="card mb-4">
                                            <div class="card-header"><h5 class="mb-0">Position Profile Details</h5></div>
                                            <div class="card-body @(_isViewMode ? "view-mode" : "")">
                                                @DetailsFormFields
                                            </div>
                                        </div>
                                        @FormButtons
                                    </div>
                                </div>
                            </div>
                        </ContentTemplate>
                    </TabItem>
                    <TabItem>
                        <ChildContent><TabHeader Text="Required Documents" /></ChildContent>
                        <ContentTemplate>
                            <div class="mt-4">
                                <PositionProfileRequiredDocumentsTab
                                    CompanyId="CompanyId"
                                    PositionProfileId="Id!.Value"
                                    CanEdit="!_isViewMode" />
                            </div>
                        </ContentTemplate>
                    </TabItem>
                </TabItems>
            </SfTab>
        }
    }
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid? Id { get; set; }

    private bool _isViewMode;
    private bool IsNew => Id is null || Id == Guid.Empty;
    private string PageTitle => IsNew ? "Add Position Profile"
        : _model.Title.Trim().Length > 0 ? _model.Title.Trim()
        : _isViewMode ? "View Position Profile" : "Edit Position Profile";

    private bool _loading = true;
    private string? _globalError;
    private bool _saving;

    private readonly PositionProfileEditModel _model = new();
    private List<DepartmentListItemModel> _departments = [];

    protected override async Task OnParametersSetAsync()
    {
        _isViewMode = Navigation.Uri.Contains("/view", StringComparison.OrdinalIgnoreCase);
        _loading = true;
        _globalError = null;

        var deptResult = await DepartmentService.ListDepartmentsAsync(CompanyId);
        _departments = deptResult?.Items ?? [];

        if (!IsNew)
        {
            var profile = await PositionProfileService.GetPositionProfileAsync(CompanyId, Id!.Value);
            if (profile is not null)
            {
                _model.Title = profile.Title;
                _model.Description = profile.Description;
                _model.DepartmentId = profile.DepartmentId;
                _model.IsManagerial = profile.IsManagerial;
            }
        }

        _loading = false;
    }

    private async Task Save()
    {
        _saving = true;
        _globalError = null;

        if (IsNew)
        {
            var request = new CreatePositionProfileRequest(
                CompanyId,
                _model.DepartmentId,
                _model.Title.Trim(),
                string.IsNullOrWhiteSpace(_model.Description) ? null : _model.Description.Trim(),
                _model.IsManagerial);

            var (created, error) = await PositionProfileService.CreatePositionProfileAsync(CompanyId, request);
            _saving = false;

            if (created is not null)
            {
                Navigation.NavigateTo($"/companies/{CompanyId}/position-profiles", forceLoad: true);
                return;
            }

            _globalError = error ?? "Failed to create position profile.";
        }
        else
        {
            var request = new UpdatePositionProfileRequest(
                CompanyId,
                Id!.Value,
                _model.DepartmentId,
                _model.Title.Trim(),
                string.IsNullOrWhiteSpace(_model.Description) ? null : _model.Description.Trim(),
                _model.IsManagerial);

            var (success, error) = await PositionProfileService.UpdatePositionProfileAsync(CompanyId, Id!.Value, request);
            _saving = false;

            if (success)
            {
                Navigation.NavigateTo($"/companies/{CompanyId}/position-profiles", forceLoad: true);
                return;
            }

            _globalError = error;
        }
    }

    private void Cancel() =>
        Navigation.NavigateTo($"/companies/{CompanyId}/position-profiles");

    private RenderFragment DetailsFormFields => __builder =>
    {
        <div class="mb-3">
            <label class="form-label">Title <span class="text-danger">*</span></label>
            <HrTextBox @bind-Value="_model.Title" Placeholder="e.g. Senior Software Engineer" />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <HrTextBox @bind-Value="_model.Description" Placeholder="Optional description" />
        </div>
        <div class="mb-3">
            <label class="form-label">Department</label>
            <SfDropDownList TValue="Guid?"
                            TItem="DepartmentListItemModel"
                            DataSource="@_departments"
                            @bind-Value="_model.DepartmentId"
                            Placeholder="None"
                            AllowFiltering="true">
                <DropDownListFieldSettings Value="Id" Text="Name" />
            </SfDropDownList>
        </div>
        <div class="mb-3">
            <SfCheckBox TChecked="bool"
                        Label="Managerial role"
                        @bind-Checked="_model.IsManagerial" />
        </div>
    };

    private RenderFragment FormButtons => __builder =>
    {
        <div class="d-flex gap-2 align-items-center mt-3">
            @if (!_isViewMode)
            {
                <SfButton IsPrimary="true" Disabled="@_saving" OnClick="Save">
                    @if (_saving)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    Save
                </SfButton>
            }
            <SfButton OnClick="Cancel" Disabled="@_saving">@(_isViewMode ? "Close" : "Cancel")</SfButton>
        </div>
    };
}
