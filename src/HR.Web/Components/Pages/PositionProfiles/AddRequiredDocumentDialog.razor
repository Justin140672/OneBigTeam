@using System.ComponentModel.DataAnnotations
@inject DocumentService DocumentService
@inject PositionProfileService PositionProfileService
@inherits EditDialogBase<AddRequiredDocumentDialog.AddRequiredDocumentFormModel>

<SfDialog @bind-Visible="Visible" IsModal="true" Width="520px" ShowCloseIcon="true">
    <DialogEvents Closed="HandleDialogClosed" />
    <DialogTemplates>
        <Header>Add Required Document</Header>
        <Content>
            @if (!string.IsNullOrEmpty(GlobalError))
            {
                <div class="alert alert-danger alert-dismissible mb-3">
                    @GlobalError
                    <button type="button" class="btn-close" @onclick="@(() => GlobalError = null)"></button>
                </div>
            }
            <EditForm EditContext="EditContext">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Document Type <span class="text-danger">*</span></label>
                        <SfDropDownList TValue="Guid?"
                                        TItem="DocumentTypeItem"
                                        DataSource="@_documentTypes"
                                        @bind-Value="Model.DocumentTypeId"
                                        Placeholder="Select document type…"
                                        AllowFiltering="true">
                            <DropDownListFieldSettings Value="Id" Text="Name" />
                        </SfDropDownList>
                        <ValidationMessage For="@(() => Model.DocumentTypeId)" />
                    </div>
                    <div class="col-12">
                        <SfCheckBox TChecked="bool" Label="Mandatory" @bind-Checked="Model.IsMandatory" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Due Days After Start</label>
                        <SfNumericTextBox TValue="int?" @bind-Value="Model.DueDaysAfterStart" Min="0" Placeholder="e.g. 30"
                                          FloatLabelType="FloatLabelType.Auto" ShowSpinButton="false" />
                    </div>
                    <div class="col-12">
                        <SfCheckBox TChecked="bool" Label="Requires Expiry Date" @bind-Checked="Model.RequiresExpiryDate" />
                    </div>
                </div>
            </EditForm>
        </Content>
        <FooterTemplate>
            <HrDialogButtonBar SaveLabel="Add" Saving="Saving" OnSave="SubmitAsync" OnCancel="CancelAsync" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<UnsavedChangesDialog Visible="ShowUnsavedChangesDialog"
                      OnSaveAndClose="ConfirmSaveInsteadOfCancelAsync"
                      OnDiscard="ConfirmDiscardAsync"
                      OnCancel="CancelUnsavedChangesDialog" />

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public Guid PositionProfileId { get; set; }

    private List<DocumentTypeItem> _documentTypes = [];

    protected override async Task OnOpenedAsync()
    {
        GlobalError = null;
        _documentTypes = (await DocumentService.ListDocumentTypesAsync(CompanyId))?.Items.ToList() ?? [];
    }

    protected override async Task<string?> SaveCoreAsync()
    {
        var request = new AddRequiredDocumentToProfileRequest(
            CompanyId, PositionProfileId, Model.DocumentTypeId!.Value,
            Model.IsMandatory, Model.DueDaysAfterStart, Model.RequiresExpiryDate);
        var (success, error) = await PositionProfileService.AddRequiredDocumentAsync(
            CompanyId, PositionProfileId, request);

        return success ? null : error ?? "Failed to add required document.";
    }

    protected override void ResetForm()
    {
        Model.DocumentTypeId = null;
        Model.IsMandatory = true;
        Model.DueDaysAfterStart = null;
        Model.RequiresExpiryDate = false;
    }

    public sealed class AddRequiredDocumentFormModel
    {
        [Required(ErrorMessage = "Please select a document type.")]
        public Guid? DocumentTypeId { get; set; }
        public bool IsMandatory { get; set; } = true;
        public int? DueDaysAfterStart { get; set; }
        public bool RequiresExpiryDate { get; set; }
    }
}
