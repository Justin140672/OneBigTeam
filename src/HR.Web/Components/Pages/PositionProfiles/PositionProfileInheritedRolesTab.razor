@inject PositionProfileService PositionProfileService

@if (_loading)
{
    <HrLoadingIndicator />
}
else
{
    <div class="card">
        <div class="card-header d-flex align-items-center">
            <i class="fa-solid fa-user-shield text-muted me-2"></i>
            <h5 class="mb-0">Inherited Roles</h5>
        </div>
        <div class="card-body">
            <p class="text-muted small">Every employee holding this position automatically receives the roles selected below.</p>
            <table class="table table-sm table-borderless mb-1">
                <tbody>
                    @foreach (var role in _roleOptions)
                    {
                        <tr>
                            <td class="ps-0" style="width: 2.5rem;">
                                <input type="checkbox"
                                       class="form-check-input"
                                       id="@($"inherited-role-{role.Id}")"
                                       checked="@_selectedRoleIds.Contains(role.Id)"
                                       disabled="@(!CanEdit)"
                                       @onchange="@(e => OnRoleCheckedChanged(role.Id, e.Value is bool b && b))" />
                            </td>
                            <td class="align-middle">
                                <label class="form-check-label mb-0" for="@($"inherited-role-{role.Id}")">
                                    @role.Name
                                </label>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger py-2">@_error</div>
            }
            @if (!string.IsNullOrEmpty(_success))
            {
                <div class="alert alert-success py-2">@_success</div>
            }

            @if (CanEdit)
            {
                <div class="d-flex justify-content-end mt-3">
                    <SfButton IsPrimary="true" Disabled="@_saving" OnClick="SaveAsync">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Save
                    </SfButton>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public Guid PositionProfileId { get; set; }
    [Parameter] public bool CanEdit { get; set; }

    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private string? _success;
    private List<Guid> _selectedRoleIds = [];

    private readonly List<RoleOption> _roleOptions = SystemRoleOptions.All.ToList();

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _success = null;
        StateHasChanged();

        var response = await PositionProfileService.ListPositionRoleDefaultsAsync(CompanyId);
        var current = response?.Positions.FirstOrDefault(p => p.PositionProfileId == PositionProfileId);
        _selectedRoleIds = current?.RoleIds.ToList() ?? [];

        _loading = false;
    }

    private void OnRoleCheckedChanged(Guid roleId, bool isChecked)
    {
        if (isChecked)
        {
            if (!_selectedRoleIds.Contains(roleId))
                _selectedRoleIds.Add(roleId);
        }
        else
        {
            _selectedRoleIds.Remove(roleId);
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;
        _success = null;

        var request = new SetPositionRoleDefaultsRequest(CompanyId, PositionProfileId, _selectedRoleIds);
        var (success, error) = await PositionProfileService.SetPositionRoleDefaultsAsync(CompanyId, PositionProfileId, request);

        _saving = false;

        if (!success)
        {
            _error = error ?? "Failed to save inherited roles.";
            return;
        }

        _success = "Inherited roles saved.";
        await LoadAsync();
    }
}
