@page "/companies/{CompanyId:guid}/position-profiles"
@rendermode InteractiveServer
@inherits SearchPageBase<PositionProfileListItemModel>
@inject PositionProfileService PositionProfileService
@inject AppSession Session

<PageTitle>Position Profiles</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Position Profiles</h1>
    <p class="text-muted mb-3">Define job roles and the documents required for employees who hold them.</p>

    @if (IsLoading)
    {
        <HrLoadingIndicator Label="Loading position profiles…" />
    }
    else if (Error is not null)
    {
        <div class="alert alert-danger">@Error</div>
    }
    else
    {
        @if (ActionError is not null)
        {
            <div class="alert alert-danger alert-dismissible">
                @ActionError
                <button type="button" class="btn-close" @onclick="ClearActionError"></button>
            </div>
        }

        <HrGrid @ref="Grid"
                TValue="PositionProfileListItemModel"
                DataSource="@Items"
                Toolbar="@GridToolbar"
                AllowFiltering="true">
            <GridEvents TValue="PositionProfileListItemModel" OnToolbarClick="OnToolbarClick"
                        RowSelected="OnRowSelected" RowDeselected="OnRowDeselected" />
            <GridPageSettings PageSize="20" />
            <GridColumns>
                <GridColumn Field="@nameof(PositionProfileListItemModel.Title)" HeaderText="Title" Width="220">
                    <Template>
                        @{
                            var row = (context as PositionProfileListItemModel)!;
                            <a href="/companies/@CompanyId/position-profiles/@row.Id">@row.Title</a>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(PositionProfileListItemModel.DepartmentName)" HeaderText="Department" Width="180" />
                <GridColumn HeaderText="Salary Range" Width="200">
                    <Template>
                        @{
                            var row = (context as PositionProfileListItemModel)!;
                            <span>@FormatSalaryRange(row)</span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(PositionProfileListItemModel.IsActive)" HeaderText="Status" Width="110">
                    <Template>
                        @{
                            var row = (context as PositionProfileListItemModel)!;
                            <ActiveStatusBadge IsActive="row.IsActive" />
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </HrGrid>
    }
</div>

@code {
    protected override bool SupportsActiveFilter => true;

    protected override Task OnBeforeLoadAsync()
    {
        if (!Session.CanManageEmployees)
            Navigation.NavigateTo(Session.MyProfileUrl, replace: true);
        return Task.CompletedTask;
    }

    protected override void ConfigureToolbar()
    {
        AddToolbarAction(
            id:      "hr-deactivate",
            text:    "Deactivate",
            icon:    "fa-solid fa-circle-xmark",
            onClick: async item =>
            {
                if (!item.IsActive) return;
                await Deactivate(item);
            },
            tooltip: "Deactivate selected position profile");
    }

    protected override async Task<IReadOnlyList<PositionProfileListItemModel>?> FetchItemsAsync(string? search)
    {
        var result = await PositionProfileService.ListPositionProfilesAsync(CompanyId, ShowInactive);
        return result?.Items.ToList();
    }

    protected override string LoadErrorMessage => "Failed to load position profiles.";

    protected override string? GetAddUrl() => $"/companies/{CompanyId}/position-profiles/new";

    protected override string? GetEditUrl(PositionProfileListItemModel item) =>
        $"/companies/{CompanyId}/position-profiles/{item.Id}";

    protected override string? GetViewUrl(PositionProfileListItemModel item) =>
        $"/companies/{CompanyId}/position-profiles/{item.Id}/view";

    private static string FormatSalaryRange(PositionProfileListItemModel item)
    {
        if (item.SalaryMin is null && item.SalaryMax is null)
            return "—";

        var suffix = string.IsNullOrEmpty(item.SalaryType) ? string.Empty : $" ({item.SalaryType})";

        if (item.SalaryMin is not null && item.SalaryMax is not null)
            return $"£{item.SalaryMin.Value:N0} - £{item.SalaryMax.Value:N0}{suffix}";

        if (item.SalaryMin is not null)
            return $"£{item.SalaryMin.Value:N0}+{suffix}";

        return $"Up to £{item.SalaryMax!.Value:N0}{suffix}";
    }

    private async Task Deactivate(PositionProfileListItemModel profile)
    {
        ClearActionError();
        var error = await PositionProfileService.DeactivatePositionProfileAsync(CompanyId, profile.Id);
        if (error is not null)
            SetActionError(error);
        else
            await LoadAsync();
    }
}
