@using System.ComponentModel.DataAnnotations
@inject OnboardingTemplateService OnboardingTemplateService
@inject PositionProfileService PositionProfileService
@inherits EditDialogBase<AddOnboardingTemplateDialog.AddOnboardingTemplateFormModel>

<SfDialog @bind-Visible="Visible" IsModal="true" Width="520px" ShowCloseIcon="true">
    <DialogEvents Closed="HandleDialogClosed" />
    <DialogTemplates>
        <Header>Add Onboarding Template</Header>
        <Content>
            @if (!string.IsNullOrEmpty(GlobalError))
            {
                <div class="alert alert-danger alert-dismissible mb-3">
                    @GlobalError
                    <button type="button" class="btn-close" @onclick="@(() => GlobalError = null)"></button>
                </div>
            }
            <EditForm EditContext="EditContext">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Onboarding Template <span class="text-danger">*</span></label>
                        <SfDropDownList TValue="Guid?"
                                        TItem="OnboardingTemplateListItemModel"
                                        DataSource="@_availableTemplates"
                                        @bind-Value="Model.OnboardingTemplateId"
                                        Placeholder="Select onboarding template…"
                                        AllowFiltering="true">
                            <DropDownListFieldSettings Value="Id" Text="Name" />
                        </SfDropDownList>
                        <ValidationMessage For="@(() => Model.OnboardingTemplateId)" />
                    </div>
                    @if (_selectedTemplate is not null)
                    {
                        <div class="col-12">
                            <p class="text-muted small mb-0">
                                @(_selectedTemplate.Description ?? "No description.")
                                — @_selectedTemplate.TaskCount task(s)
                            </p>
                        </div>
                    }
                </div>
            </EditForm>
        </Content>
        <FooterTemplate>
            <HrDialogButtonBar SaveLabel="Add" Saving="Saving" OnSave="SubmitAsync" OnCancel="CancelAsync" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<UnsavedChangesDialog Visible="ShowUnsavedChangesDialog"
                      OnSaveAndClose="ConfirmSaveInsteadOfCancelAsync"
                      OnDiscard="ConfirmDiscardAsync"
                      OnCancel="CancelUnsavedChangesDialog" />

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public Guid PositionProfileId { get; set; }
    [Parameter] public IReadOnlySet<Guid>? ExistingTemplateIds { get; set; }

    private List<OnboardingTemplateListItemModel> _allTemplates = [];
    private List<OnboardingTemplateListItemModel> _availableTemplates = [];

    private OnboardingTemplateListItemModel? _selectedTemplate =>
        _allTemplates.FirstOrDefault(t => t.Id == Model.OnboardingTemplateId);

    protected override async Task OnOpenedAsync()
    {
        GlobalError = null;
        _allTemplates = (await OnboardingTemplateService.ListOnboardingTemplatesAsync(CompanyId))?.Items.ToList() ?? [];
        _availableTemplates = ExistingTemplateIds is null
            ? _allTemplates
            : _allTemplates.Where(t => !ExistingTemplateIds.Contains(t.Id)).ToList();
    }

    protected override async Task<string?> SaveCoreAsync()
    {
        var request = new AddOnboardingTemplateToProfileRequest(
            CompanyId, PositionProfileId, Model.OnboardingTemplateId!.Value);
        var (success, error) = await PositionProfileService.AddOnboardingTemplateAsync(
            CompanyId, PositionProfileId, request);

        return success ? null : error ?? "Failed to add onboarding template.";
    }

    protected override void ResetForm()
    {
        Model.OnboardingTemplateId = null;
    }

    public sealed class AddOnboardingTemplateFormModel
    {
        [Required(ErrorMessage = "Please select an onboarding template.")]
        public Guid? OnboardingTemplateId { get; set; }
    }
}
