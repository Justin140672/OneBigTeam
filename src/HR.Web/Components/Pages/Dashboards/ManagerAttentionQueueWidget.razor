@* Manager-scoped "Requires attention" queue for the Manager Dashboard.

   DSH-06: the widget issues ONE server-side bounded summary fetch
   (DashboardService.GetManagerSummaryOrThrowAsync), always scoped to the calling manager's own
   reporting sub-tree, instead of fanning out to 5 category endpoints plus a client-side
   employee-name lookup. Each returned category maps to one WidgetSourceOutcome so the existing
   WidgetPanelState.Summarise / ShowAllClear / per-failed-source warning / count-badge behaviour
   (DSH-03) is preserved, and the pure ManagerAttentionQueueOrdering.Order sort shape is retained.

   This widget is a thin, manager-audience container: it owns authorization, data source
   selection, manager ordering, alert-count callbacks, and wording. Presentation
   (loading/failure/all-clear/item rendering/task dialog) is shared with the HR dashboard via
   AttentionQueuePanel. *@
@inject DashboardService DashboardService
@inject WidgetSourceLoader SourceLoader
@inject AppSession Session

@if (Session.IsManager)
{
    <AttentionQueuePanel Title="Needs your action"
                          AllClearMessage="Nothing needs your action right now."
                          CompanyId="Session.CompanyId"
                          Loading="_loading"
                          RetryingAll="_retryingAll"
                          Summary="_summary"
                          Items="_items"
                          OnReload="ReloadAllAsync" />

    <WaitingOnOthersPanel Loading="_loading"
                          WaitingCount="_waitingCount"
                          Items="_waiting"
                          Exceptions="_exceptions" />
}

@code {
    [Parameter] public EventCallback<IReadOnlyDictionary<Guid, int>> OnAlertCountsChanged { get; set; }

    [Parameter] public EventCallback<int> OnItemCountChanged { get; set; }

    private const string WidgetName = "Needs your action";

    private bool _loading = true;
    private bool _retryingAll;
    private DateOnly _today;

    private WidgetResult<DashboardSummaryModel> _res = WidgetResult<DashboardSummaryModel>.Loading(WidgetName);
    private WidgetPanelSummary _summary = WidgetPanelState.Summarise([]);
    private IReadOnlyList<AttentionQueueItem> _items = [];
    private IReadOnlyList<AttentionQueueItem> _waiting = [];
    private IReadOnlyList<DashboardExceptionModel> _exceptions = [];
    private int _waitingCount;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsManager || !Session.EmployeeId.HasValue)
        {
            _loading = false;
            return;
        }

        _today = DateOnly.FromDateTime(DateTime.UtcNow);
        await ReloadAllAsync();
        _loading = false;
    }

    private async Task ReloadAllAsync()
    {
        _retryingAll = true;

        _res = await SourceLoader.LoadAsync(WidgetName, "Dashboard summary",
            () => DashboardService.GetManagerSummaryOrThrowAsync(Session.CompanyId));

        _retryingAll = false;
        await RecomputeAsync();
    }

    private async Task RecomputeAsync()
    {
        if (_res.IsFailed)
        {
            _summary = WidgetPanelState.Summarise([new WidgetSourceOutcome("Dashboard summary", true, true, 0)]);
            _items = [];
            _waiting = [];
            _exceptions = [];
            _waitingCount = 0;

            if (OnAlertCountsChanged.HasDelegate)
                await OnAlertCountsChanged.InvokeAsync(new Dictionary<Guid, int>());
            if (OnItemCountChanged.HasDelegate)
                await OnItemCountChanged.InvokeAsync(0);
            return;
        }

        var (outcomes, rawItems) = AttentionQueueSupport.Convert(_res.Value!, _today);

        var alertCounts = new Dictionary<Guid, int>();
        foreach (var it in rawItems)
        {
            if (it.EmployeeId is null) continue;
            alertCounts[it.EmployeeId.Value] = alertCounts.GetValueOrDefault(it.EmployeeId.Value) + 1;
        }

        _summary = WidgetPanelState.Summarise(outcomes);
        _items = ManagerAttentionQueueOrdering.Order(rawItems, i => i.IsOverdue, i => i.UrgencyRank, i => i.DueDate);
        _waiting = ManagerAttentionQueueOrdering.Order(
            AttentionQueueSupport.ConvertWaiting(_res.Value!, _today), i => i.IsOverdue, i => i.UrgencyRank, i => i.DueDate);
        _waitingCount = _res.Value!.TotalWaitingOnOthersCount;
        _exceptions = _res.Value!.Exceptions;

        if (OnAlertCountsChanged.HasDelegate)
            await OnAlertCountsChanged.InvokeAsync(alertCounts);

        if (OnItemCountChanged.HasDelegate)
            await OnItemCountChanged.InvokeAsync(_summary.TotalActionableCount);
    }
}
