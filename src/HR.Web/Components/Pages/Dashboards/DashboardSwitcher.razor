@inject AppSession Session
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (_options.Count > 1)
{
    <div class="dashboard-switcher mb-3" role="group" aria-label="Switch dashboard">
        @foreach (var option in _options)
        {
            var opt = option;
            <SfButton CssClass="@("dashboard-switcher-item " + (IsCurrent(opt.Key) ? "dashboard-switcher-item--active" : ""))"
                      HtmlAttributes="@(IsCurrent(opt.Key) ? CurrentAttributes : null)"
                      OnClick="() => SwitchToAsync(opt.Key, opt.Url)">
                @opt.Label
            </SfButton>
        }
    </div>
}

@code {
    private sealed record DashboardOption(string Key, string Label, string Url);

    private static readonly Dictionary<string, object> CurrentAttributes = new() { ["aria-current"] = "page" };

    private List<DashboardOption> _options = [];

    protected override void OnInitialized()
    {
        var options = new List<DashboardOption>();
        if (Session.IsHrAdministrator) options.Add(new DashboardOption("hr", "HR Dashboard", "/dashboard/hr"));
        if (Session.IsRecruiter) options.Add(new DashboardOption("recruitment", "Recruitment", "/dashboard/recruitment"));
        if (Session.IsManager) options.Add(new DashboardOption("manager", "My Team", "/dashboard/manager"));
        _options = options;
    }

    private bool IsCurrent(string key) =>
        Navigation.Uri.TrimEnd('/').EndsWith(AppSession.DashboardUrl(key) ?? string.Empty, StringComparison.OrdinalIgnoreCase);

    private async Task SwitchToAsync(string key, string url)
    {
        try
        {
            await JS.InvokeVoidAsync("setLastDashboard", key);
        }
        catch
        {
        }

        Navigation.NavigateTo(url);
    }
}
