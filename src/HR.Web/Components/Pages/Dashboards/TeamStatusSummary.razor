@* Compact team-status metric strip for the redesigned Manager Dashboard. Reuses data already
   fetched by sibling widgets rather than adding new endpoints. See PRODUCT ticket "Reorganise the
   Team Manager Dashboard around priority actions" for full context on the proxy measures used.

   DSH-03: each source is loaded independently. A failed "In probation" / "Missing fit notes"
   source renders a compact inline warning + retry and a "—" tile rather than a misleading 0. If
   the team roster itself fails to load, the whole strip is replaced with a warning + retry (there
   is nothing meaningful to show without it). *@
@using HR.Web.Components.Pages.Dashboards
@inject EmployeeService EmployeeService
@inject ProbationService ProbationService
@inject SicknessService SicknessService
@inject WidgetSourceLoader SourceLoader
@inject AppSession Session

@if (Session.IsManager)
{
    <div class="widget-card team-status-summary">
        <div class="widget-header">
            <i class="fa-solid fa-chart-simple widget-icon"></i>
            <span class="widget-title">Team Status</span>
        </div>

        @if (_loading)
        {
            <div class="widget-body d-flex align-items-center gap-2 py-3 px-3">
                <HrLoadingIndicator Label="Loading team status…" />
            </div>
        }
        else if (_teamRes.IsFailed)
        {
            <WidgetSourceWarning SourceName="Team status" Retrying="_retrying.Contains(SrcTeam)" OnRetry="() => RetryAsync(SrcTeam)" />
        }
        else if (_teamSize == 0)
        {
            <div class="widget-empty">
                <i class="fa-solid fa-people-group fa-lg mb-2"></i>
                <p class="mb-0">No one reports up to you yet.</p>
            </div>
        }
        else
        {
            @if (_probationRes.IsFailed)
            {
                <WidgetSourceWarning SourceName="In probation" Retrying="_retrying.Contains(SrcProbation)" OnRetry="() => RetryAsync(SrcProbation)" />
            }
            @if (_fitNotesRes.IsFailed)
            {
                <WidgetSourceWarning SourceName="Missing fit notes" Retrying="_retrying.Contains(SrcFitNotes)" OnRetry="() => RetryAsync(SrcFitNotes)" />
            }

            <div class="team-status-strip" role="list" aria-label="Team status summary">
                <div class="team-status-tile" role="listitem">
                    <span class="team-status-value">@_atWork</span>
                    <span class="team-status-label">At work</span>
                </div>
                <div class="team-status-tile" role="listitem">
                    <span class="team-status-value">@_awayToday</span>
                    <span class="team-status-label">Away today</span>
                </div>
                <div class="team-status-tile" role="listitem">
                    <span class="team-status-value">@_onLeave</span>
                    <span class="team-status-label">On leave</span>
                </div>
                <div class="team-status-tile" role="listitem">
                    <span class="team-status-value">@_sick</span>
                    <span class="team-status-label">Sick</span>
                </div>
                <div class="team-status-tile @(_probationRes.IsLoaded && _inProbation > 0 ? "team-status-tile--warning" : "")" role="listitem">
                    <span class="team-status-value">@(_probationRes.IsFailed ? "—" : _inProbation.ToString())</span>
                    <span class="team-status-label">In probation</span>
                </div>
                <div class="team-status-tile @(_fitNotesRes.IsLoaded && _missingFitNotes > 0 ? "team-status-tile--warning" : "")" role="listitem">
                    <span class="team-status-value">@(_fitNotesRes.IsFailed ? "—" : _missingFitNotes.ToString())</span>
                    <span class="team-status-label">Missing fit notes</span>
                </div>
            </div>
        }
    </div>
}

@code {
    // Reports the "away today" count up to ManagerDashboard for its one-line activity summary.
    [Parameter] public EventCallback<int> OnAwayTodayChanged { get; set; }

    private const string SrcTeam = "Team status";
    private const string SrcProbation = "In probation";
    private const string SrcFitNotes = "Missing fit notes";
    private const string WidgetName = "Team Status";

    private readonly string[] _sourceNames = [SrcTeam, SrcProbation, SrcFitNotes];
    private readonly HashSet<string> _retrying = [];

    private bool _loading = true;

    private WidgetResult<GetMyTeamResponse?> _teamRes = WidgetResult<GetMyTeamResponse?>.Loading(SrcTeam);
    private WidgetResult<IReadOnlyList<UpcomingProbationReviewItem>> _probationRes = WidgetResult<IReadOnlyList<UpcomingProbationReviewItem>>.Loading(SrcProbation);
    private WidgetResult<GetMissingFitNotesResponseModel?> _fitNotesRes = WidgetResult<GetMissingFitNotesResponseModel?>.Loading(SrcFitNotes);

    private int _teamSize;
    private int _atWork;
    private int _onLeave;
    private int _sick;
    private int _awayToday;
    private int _inProbation;
    private int _missingFitNotes;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsManager)
        {
            _loading = false;
            return;
        }

        await Task.WhenAll(_sourceNames.Select(LoadSourceAsync));
        Recompute();
        _loading = false;
        await NotifyAsync();
    }

    private async Task LoadSourceAsync(string name)
    {
        switch (name)
        {
            case SrcTeam:
                _teamRes = await SourceLoader.LoadAsync(WidgetName, name,
                    () => EmployeeService.GetMyTeamOrThrowAsync(Session.CompanyId, includeIndirect: true));
                break;
            case SrcProbation:
                _probationRes = await SourceLoader.LoadAsync(WidgetName, name,
                    () => ProbationService.GetUpcomingReviewsOrThrowAsync(Session.CompanyId));
                break;
            case SrcFitNotes:
                _fitNotesRes = await SourceLoader.LoadAsync(WidgetName, name,
                    () => SicknessService.GetMissingFitNotesOrThrowAsync(Session.CompanyId));
                break;
        }
    }

    private async Task RetryAsync(string name)
    {
        _retrying.Add(name);
        StateHasChanged();
        await LoadSourceAsync(name);
        _retrying.Remove(name);
        Recompute();
        await NotifyAsync();
    }

    private void Recompute()
    {
        var team = _teamRes.IsLoaded ? _teamRes.Value?.Items ?? [] : [];
        _teamSize = team.Count;
        _sick = team.Count(m => m.Status == "Sick");
        _onLeave = team.Count(m => m.Status == "OnLeave");
        _atWork = _teamSize - _sick - _onLeave;
        _awayToday = _sick + _onLeave;
        _inProbation = _probationRes.IsLoaded ? (_probationRes.Value ?? []).Select(p => p.EmployeeId).Distinct().Count() : 0;
        _missingFitNotes = _fitNotesRes.IsLoaded ? _fitNotesRes.Value?.Items.Count ?? 0 : 0;
    }

    private async Task NotifyAsync()
    {
        if (OnAwayTodayChanged.HasDelegate && _teamRes.IsLoaded)
            await OnAwayTodayChanged.InvokeAsync(_awayToday);
    }
}
