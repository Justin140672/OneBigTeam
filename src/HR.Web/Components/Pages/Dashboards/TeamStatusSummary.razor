@* Compact team-status metric strip for the redesigned Manager Dashboard.

   DSH-05: backed by a single authoritative server endpoint
   (GET api/companies/{companyId}/employees/{managerId}/team-status-summary) which computes every
   headline count and the per-member drill-down flags from one payload — so the summary tiles and
   the drill-down list can never disagree. Previously this widget composed three sibling services
   and computed counts client-side, including two known-wrong measures.

   DSH-03: the single source is loaded through WidgetSourceLoader as a WidgetResult<T>. On failure
   the whole strip is replaced with a warning + retry (there is nothing meaningful to show). *@
@using HR.Web.Components.Pages.Dashboards
@inject EmployeeService EmployeeService
@inject WidgetSourceLoader SourceLoader
@inject AppSession Session

@if (Session.IsManager && Session.EmployeeId is Guid managerId)
{
    <div class="widget-card team-status-summary">
        <div class="widget-header">
            <i class="fa-solid fa-chart-simple widget-icon"></i>
            <span class="widget-title">Team Status</span>
            @if (!_loading && _res.IsLoaded && _res.Value is { } h)
            {
                <span class="widget-count-badge">@h.TeamSize</span>
            }
        </div>

        @if (_loading)
        {
            <div class="widget-body d-flex align-items-center gap-2 py-3 px-3">
                <HrLoadingIndicator Label="Loading team status…" />
            </div>
        }
        else if (_res.IsFailed)
        {
            <WidgetSourceWarning SourceName="Team status" Retrying="_retrying" OnRetry="RetryAsync" />
        }
        else if (_res.Value is not { } payload)
        {
            <WidgetSourceWarning SourceName="Team status" Retrying="_retrying" OnRetry="RetryAsync" />
        }
        else if (payload.TeamSize == 0)
        {
            <div class="widget-empty">
                <i class="fa-solid fa-people-group fa-lg mb-2"></i>
                <p class="mb-0">No one reports up to you yet.</p>
            </div>
        }
        else
        {
            <div class="team-status-strip" role="list" aria-label="Team status summary">
                @foreach (var tile in Tiles(payload))
                {
                    var t = tile;
                    <button type="button"
                            class="team-status-tile @(t.Warning ? "team-status-tile--warning" : "") @(_openTile == t.Key ? "team-status-tile--active" : "")"
                            role="listitem"
                            aria-expanded="@(_openTile == t.Key ? "true" : "false")"
                            aria-label="@($"{t.Count} {t.Label}{(t.Warning ? " (needs attention)" : "")}. Show matching team members.")"
                            @onclick="() => ToggleTile(t.Key)">
                        <span class="team-status-value">
                            @if (t.Warning)
                            {
                                <i class="fa-solid fa-triangle-exclamation team-status-warning-icon" aria-hidden="true"></i>
                            }
                            @t.Count
                        </span>
                        <span class="team-status-label">@t.Label</span>
                    </button>
                }
            </div>

            @if (_openTile is { } openKey)
            {
                var open = Tiles(payload).First(x => x.Key == openKey);
                var members = open.Filter(payload.Members).ToList();
                <div class="team-status-drilldown" aria-label="@($"{open.Label} — matching team members")">
                    <div class="team-status-drilldown-head">
                        <span class="fw-semibold">@open.Label</span>
                        <span class="text-muted">@members.Count</span>
                    </div>
                    @if (members.Count == 0)
                    {
                        <p class="team-status-drilldown-empty mb-0 text-muted">No team members match.</p>
                    }
                    else
                    {
                        <ul class="team-status-drilldown-list">
                            @foreach (var m in members)
                            {
                                <li class="team-status-drilldown-item">
                                    <span class="team-status-drilldown-name">@m.FullName</span>
                                    <span class="team-status-drilldown-role text-muted">@(string.IsNullOrWhiteSpace(m.JobTitle) ? "—" : m.JobTitle)</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
        }
    </div>
}

@code {
    // Reports the "away today" count up to ManagerDashboard for its one-line activity summary.
    [Parameter] public EventCallback<int> OnAwayTodayChanged { get; set; }

    private const string Src = "Team status";
    private const string WidgetName = "Team Status";

    private bool _loading = true;
    private bool _retrying;
    private string? _openTile;

    private WidgetResult<TeamStatusSummaryResponse?> _res = WidgetResult<TeamStatusSummaryResponse?>.Loading(Src);

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsManager || Session.EmployeeId is not Guid)
        {
            _loading = false;
            return;
        }

        await LoadAsync();
        _loading = false;
        await NotifyAsync();
    }

    private async Task LoadAsync()
    {
        var managerId = Session.EmployeeId!.Value;
        _res = await SourceLoader.LoadAsync(WidgetName, Src,
            () => EmployeeService.GetTeamStatusSummaryOrThrowAsync(Session.CompanyId, managerId));
    }

    private async Task RetryAsync()
    {
        _retrying = true;
        StateHasChanged();
        await LoadAsync();
        _retrying = false;
        await NotifyAsync();
    }

    private void ToggleTile(string key) => _openTile = _openTile == key ? null : key;

    private async Task NotifyAsync()
    {
        if (OnAwayTodayChanged.HasDelegate && _res.IsLoaded && _res.Value is { } h)
            await OnAwayTodayChanged.InvokeAsync(h.AwayToday);
    }

    private static IEnumerable<TileDef> Tiles(TeamStatusSummaryResponse p) =>
    [
        new("atwork", "At work", p.AtWork, false, m => m.Where(x => x.PrimaryStatus == "AtWork")),
        new("away", "Away today", p.AwayToday, false, m => m.Where(x => x.OnLeaveToday || x.OffSickToday)),
        new("onleave", "On leave", p.OnLeave, false, m => m.Where(x => x.OnLeaveToday)),
        new("sick", "Sick", p.Sick, false, m => m.Where(x => x.OffSickToday)),
        new("probation", "In probation", p.InProbation, p.InProbation > 0, m => m.Where(x => x.InProbation)),
        new("fitnotes", "Missing fit notes", p.MissingFitNotes, p.MissingFitNotes > 0, m => m.Where(x => x.MissingFitNote)),
    ];

    private sealed record TileDef(
        string Key,
        string Label,
        int Count,
        bool Warning,
        Func<IEnumerable<TeamStatusMemberItem>, IEnumerable<TeamStatusMemberItem>> Filter);
}
