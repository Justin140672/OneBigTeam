@page "/dashboard/hr"
@rendermode InteractiveServer
@using HR.Web.Components.Pages.Sickness
@using HR.Web.Components.Pages.Employees
@using HR.Web.Components.Pages.Reporting
@inject AppSession Session
@inject NavigationManager Navigation

<PageTitle>HR Dashboard</PageTitle>

@if (_ready)
{
    <div class="container-fluid py-4">
        <DashboardAnnouncer Message="@_announcement" />
        <div class="dashboard-greeting mb-4">
            <h1 class="dashboard-heading">@Greeting(), @Session.FirstName</h1>
            <p class="text-muted mb-0">@DateTime.Now.ToString("dddd, d MMMM yyyy")</p>
        </div>

        <DashboardSwitcher />

        <section class="dashboard-section" aria-label="Needs your attention">
            <div class="row g-3">
                <div class="col-lg-8">
                    <AttentionQueueWidget />
                </div>
                <div class="col-lg-4">
                    <FavouriteReportsWidget />
                </div>
            </div>
        </section>

        <section class="dashboard-section">
            <h2 class="dashboard-section-title">Analytics</h2>
            <div class="dashboard-analytics-grid">
                <HeadcountByDepartmentChart />
                <GenderSplitChart />
                <EmploymentTypeSplitChart />
            </div>
        </section>

        <section class="dashboard-section">
            <h2 class="dashboard-section-title">More</h2>
            <div class="dashboard-grid-3col">
                <CurrentSicknessAbsenceWidget />
                <MissingFitNotesWidget />
                <RecentEmployeeChangesWidget />
            </div>
        </section>
    </div>
}

@code {
    // Guarded like CompanyEdit.razor: URL-typing into this dashboard without the
    // HR Administrator role bounces to MyProfileUrl. The switcher/redirect only pick a default.
    private bool _ready;

    // DSH-07: child widgets self-contain their own failure/retry messaging, so a simple
    // load-complete announcement is enough here.
    private string? _announcement;

    protected override async Task OnInitializedAsync()
    {
        await Session.InitialiseAsync();

        if (!Session.IsHrAdministrator)
        {
            Navigation.NavigateTo(Session.MyProfileUrl, replace: true);
            return;
        }

        _ready = true;
        _announcement = DashboardAnnouncements.LoadComplete("HR dashboard");
    }

    private static string Greeting()
    {
        var hour = DateTime.Now.Hour;
        return hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    }
}
