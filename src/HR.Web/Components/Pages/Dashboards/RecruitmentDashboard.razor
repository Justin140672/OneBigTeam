@page "/dashboard/recruitment"
@rendermode InteractiveServer
@using HR.Web.Components.Pages.Recruitment
@using HR.Web.Components.Pages.Employees
@inject AppSession Session
@inject NavigationManager Navigation

<PageTitle>Recruitment Dashboard</PageTitle>

@if (_ready)
{
    <div class="container-fluid py-4">
        <div class="dashboard-greeting mb-4">
            <h1 class="dashboard-heading">@Greeting(), @Session.FirstName</h1>
            <p class="text-muted mb-0">@DateTime.Now.ToString("dddd, d MMMM yyyy")</p>
        </div>

        <DashboardSwitcher />

        <div class="recruitment-dashboard-actions mb-4">
            <SfButton IsPrimary="true" CssClass="recruitment-dashboard-action-btn" OnClick="NavigateToVacancies" data-testid="recruitment-dashboard-vacancies-btn">
                <i class="fa-solid fa-briefcase me-2"></i>Vacancies
            </SfButton>
            <SfButton CssClass="recruitment-dashboard-action-btn" OnClick="NavigateToCandidates" data-testid="recruitment-dashboard-candidates-btn">
                <i class="fa-solid fa-user-tie me-2"></i>Candidates
            </SfButton>
        </div>

        <div class="dashboard-overview-row">
            <HiringPipelineChart />
            <NewHiresTrendChart />
        </div>

        <section class="dashboard-section">
            <h2 class="dashboard-section-title">Recruitment</h2>
            <div class="dashboard-detail-grid">
                <RecruitmentSummaryWidget />
                <UpcomingInterviewsWidget />
                <OffersAwaitingResponseWidget />
                <OpenVacanciesNoActivityWidget />
            </div>
        </section>
    </div>
}

@code {
    // Guarded like CompanyEdit.razor: URL-typing into this dashboard without the
    // Recruiter role bounces to MyProfileUrl. The switcher/redirect only pick a default.
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        await Session.InitialiseAsync();

        if (!Session.IsRecruiter)
        {
            Navigation.NavigateTo(Session.MyProfileUrl, replace: true);
            return;
        }

        _ready = true;
    }

    private void NavigateToVacancies() =>
        Navigation.NavigateTo($"/companies/{Session.CompanyId}/vacancies");

    private void NavigateToCandidates() =>
        Navigation.NavigateTo($"/companies/{Session.CompanyId}/candidates");

    private static string Greeting()
    {
        var hour = DateTime.Now.Hour;
        return hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    }
}
