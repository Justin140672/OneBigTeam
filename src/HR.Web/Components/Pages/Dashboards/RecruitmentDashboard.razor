@page "/dashboard/recruitment"
@rendermode InteractiveServer
@using HR.Web.Components.Pages.Recruitment
@using HR.Web.Components.Pages.Employees
@using Syncfusion.Blazor.Inputs
@inject AppSession Session
@inject NavigationManager Navigation
@inject VacancyService VacancyService
@inject InterviewService InterviewService
@inject ApplicationService ApplicationService
@inject RecruitmentStageService RecruitmentStageService
@inject WidgetSourceLoader SourceLoader

<PageTitle>Recruitment Dashboard</PageTitle>

@if (_ready)
{
    <div class="container-fluid py-4 recruitment-dashboard">
        <DashboardAnnouncer Message="@_announcement" />
        <div class="recruitment-dashboard-header mb-3">
            <div>
                <h1 class="dashboard-heading mb-1">Recruitment</h1>
                <p class="text-muted mb-0">@HeaderSummary()</p>
            </div>
            <div class="recruitment-dashboard-actions">
                <SfButton IsPrimary="true" CssClass="recruitment-dashboard-action-btn"
                          OnClick="NavigateToNewVacancy" data-testid="recruitment-dashboard-create-vacancy-btn">
                    <i class="fa-solid fa-plus me-1"></i>Create vacancy
                </SfButton>
                <SfButton CssClass="recruitment-dashboard-action-btn"
                          OnClick="NavigateToNewCandidate" data-testid="recruitment-dashboard-add-candidate-btn">
                    <i class="fa-solid fa-user-plus me-1"></i>Add candidate
                </SfButton>
            </div>
        </div>

        <DashboardSwitcher />

        <!-- Compact, actionable metric row (redesign brief §2). Kept separate from the more
             detailed RecruitmentSummaryWidget (reused below, in the Activity tab) rather than
             replacing it — this row is about "where should I click next", the widget below is
             about the same few numbers presented as a normal dashboard KPI card. -->
        <section class="dashboard-section recruitment-dashboard-summary" aria-label="Recruitment summary">
            <h2 class="recruitment-dashboard-summary-title">Recruitment summary <span class="text-muted fw-normal">— company-wide</span></h2>
            @if (_summaryLoading)
            {
                <HrLoadingIndicator Label="Loading recruitment summary…" />
            }
            else
            {
                <div class="widget-card">
                    @foreach (var source in _summary.FailedSources)
                    {
                        var s = source;
                        <WidgetSourceWarning SourceName="@s" Retrying="_retrying.Contains(s)" OnRetry="() => RetrySummarySourceAsync(s)" />
                    }
                    <div class="widget-kpi-row recruitment-dashboard-summary-row" role="list">
                        <RecruitmentSummaryTile Label="Open vacancies" Value="_openVacancies" Failed="_vacanciesRes.IsFailed"
                                                 Href="@($"/companies/{Session.CompanyId}/vacancies")" />
                        <RecruitmentSummaryTile Label="New applications" Value="_newApplications" Failed="_newApplicationsRes.IsFailed"
                                                 Href="#" OnClick="@(() => OpenDrillDown(SrcPipeline))" />
                        <RecruitmentSummaryTile Label="Candidates in progress" Value="_candidatesInProgress" Failed="_candidatesRes.IsFailed"
                                                 Href="#" OnClick="@(() => OpenDrillDown(SrcCandidates))" />
                        <RecruitmentSummaryTile Label="Interviews requiring action" Value="_interviewsRequiringAction" Failed="_interviewsRes.IsFailed"
                                                 Href="#" OnClick="@(() => OpenDrillDown(SrcInterviews))" />
                        <RecruitmentSummaryTile Label="Offers awaiting response" Value="_offersAwaitingResponse" Failed="_offersRes.IsFailed"
                                                 Href="#" OnClick="@(() => OpenDrillDown(SrcOffers))"
                                                 Muted="@(_offersRes.IsLoaded && !_offerStageConfigured)"
                                                 Title="@(_offersRes.IsLoaded && !_offerStageConfigured ? "No offer stage configured" : null)" />
                        <RecruitmentSummaryTile Label="Stale vacancies" Value="_staleVacancies" Failed="_staleRes.IsFailed"
                                                 Href="@($"/companies/{Session.CompanyId}/vacancies")" Muted="@(_staleRes.IsLoaded && _staleVacancies == 0)" />
                    </div>
                </div>
            }
        </section>

        @* DSH-07: "full keyboard tab behaviour" per the ticket applies to these three dashboard
           tabs (WAI-ARIA tabs pattern: roving tabindex, Arrow/Home/End, DOM focus follows
           selection). The Kanban board inside the Pipeline panel is explicitly out of scope. *@
        <ul class="nav nav-tabs recruitment-dashboard-tabs mb-3" role="tablist"
            aria-label="Recruitment dashboard sections" @onkeydown="OnTabsKeyDown">
            @foreach (var (tab, index) in _tabs.Select((t, i) => (t, i)))
            {
                var t = tab;
                var i = index;
                var name = t.ToString().ToLowerInvariant();
                var selected = _tab == t;
                <li class="nav-item" role="presentation">
                    <button type="button" class="nav-link @(selected ? "active" : "")"
                            @ref="_tabRefs[i]"
                            id="@($"recruitment-tab-{name}")"
                            role="tab"
                            aria-selected="@(selected ? "true" : "false")"
                            aria-controls="@($"recruitment-tabpanel-{name}")"
                            tabindex="@(selected ? "0" : "-1")"
                            data-testid="@($"recruitment-tab-{name}")"
                            @onclick="() => SetTab(t)">
                        <i class="fa-solid @TabIcon(t) me-1"></i>@t.ToString()
                    </button>
                </li>
            }
        </ul>

        @if (_tab == DashboardTab.Pipeline)
        {
            <section class="dashboard-section" role="tabpanel" tabindex="0"
                     id="recruitment-tabpanel-pipeline" aria-labelledby="recruitment-tab-pipeline"
                     aria-label="Recruitment pipeline">
                <h2 class="dashboard-section-title">Selected vacancy pipeline</h2>

                <div class="recruitment-dashboard-toolbar mb-3">
                    @if (_view == PipelineView.Board)
                    {
                        <div class="recruitment-dashboard-toolbar-group">
                            <div class="recruitment-dashboard-vacancy-picker">
                                <SfDropDownList TValue="Guid?" TItem="VacancyListItemModel"
                                                DataSource="@_vacancies" @bind-Value="_selectedVacancyId"
                                                Placeholder="Select a vacancy" AllowFiltering="true"
                                                data-testid="recruitment-board-vacancy-picker">
                                    <DropDownListFieldSettings Value="Id" Text="EffectiveTitle" />
                                </SfDropDownList>
                            </div>
                            <HrTextBox Placeholder="Search by name or email…"
                                       Value="@_boardSearchText"
                                       ValueChange="OnBoardSearchChanged"
                                       CssClass="recruitment-dashboard-search"
                                       data-testid="kanban-search-box" />
                            <div class="form-check recruitment-dashboard-terminal-toggle">
                                <input class="form-check-input" type="checkbox" id="show-terminal-stages"
                                       checked="@_showTerminalStages" @onchange="OnShowTerminalStagesChanged" />
                                <label class="form-check-label" for="show-terminal-stages">
                                    Show closed candidates
                                </label>
                            </div>
                        </div>
                    }
                    <div class="recruitment-dashboard-view-toggle ms-auto" role="group"
                         aria-label="Pipeline view" data-testid="recruitment-view-toggle">
                        <SfButton CssClass="@("recruitment-dashboard-view-toggle-btn" + (_view == PipelineView.Board ? " e-active" : ""))"
                                  OnClick="() => SetView(PipelineView.Board)"
                                  aria-pressed="@(_view == PipelineView.Board ? "true" : "false")"
                                  data-testid="recruitment-view-board-btn">
                            <i class="fa-solid fa-table-columns me-1"></i>Board
                        </SfButton>
                        <SfButton CssClass="@("recruitment-dashboard-view-toggle-btn" + (_view == PipelineView.List ? " e-active" : ""))"
                                  OnClick="() => SetView(PipelineView.List)"
                                  aria-pressed="@(_view == PipelineView.List ? "true" : "false")"
                                  data-testid="recruitment-view-list-btn">
                            <i class="fa-solid fa-list me-1"></i>List
                        </SfButton>
                    </div>
                </div>

                @if (_view == PipelineView.Board)
                {
                    @if (_vacanciesLoading)
                    {
                        <HrLoadingIndicator Label="Loading vacancies…" />
                    }
                    else if (_vacancies.Count == 0)
                    {
                        <div class="widget-empty">
                            <i class="fa-solid fa-user-tie fa-lg mb-2"></i>
                            <p class="mb-0">No open vacancies to show on the board yet.</p>
                        </div>
                    }
                    else if (_selectedVacancyId is Guid vacancyId && vacancyId != Guid.Empty)
                    {
                        <VacancyKanbanBoard CompanyId="Session.CompanyId" VacancyId="vacancyId"
                                             @bind-SearchText="_boardSearchText"
                                             ShowTerminalStages="_showTerminalStages"
                                             ShowToolbar="false" />
                    }
                }
                else
                {
                    <div class="dashboard-scroll-x">
                        <VacancyList CompanyId="Session.CompanyId" />
                    </div>
                }
            </section>
        }
        else if (_tab == DashboardTab.Activity)
        {
            <section class="dashboard-section" role="tabpanel" tabindex="0"
                     id="recruitment-tabpanel-activity" aria-labelledby="recruitment-tab-activity"
                     aria-label="Recruitment activity">
                <h2 class="dashboard-section-title">Activity</h2>
                <div class="dashboard-detail-grid">
                    <RecruitmentSummaryWidget />
                    <UpcomingInterviewsWidget />
                    <OffersAwaitingResponseWidget />
                    <OpenVacanciesNoActivityWidget />
                </div>
            </section>
        }
        else
        {
            <section class="dashboard-section" role="tabpanel" tabindex="0"
                     id="recruitment-tabpanel-insights" aria-labelledby="recruitment-tab-insights"
                     aria-label="Recruitment insights">
                <h2 class="dashboard-section-title">Insights</h2>
                <div class="dashboard-overview-row">
                    <HiringPipelineChart />
                    <NewHiresTrendChart />
                </div>
            </section>
        }

        <RecruitmentMetricDrillDownDialog Visible="_drillDownVisible"
                                          Title="@_drillDownTitle"
                                          DateHeader="@_drillDownDateHeader"
                                          Rows="_drillDownRows"
                                          OnClosed="CloseDrillDown" />
    </div>
}

@code {
    // Guarded like CompanyEdit.razor: URL-typing into this dashboard without the
    // Recruiter role bounces to MyProfileUrl. The switcher/redirect only pick a default.
    private bool _ready;

    private enum DashboardTab { Pipeline, Activity, Insights }
    private DashboardTab _tab = DashboardTab.Pipeline;

    // DSH-07: WAI-ARIA tabs keyboard support. Roving tabindex + Arrow/Home/End move selection
    // and DOM focus together; the pure next-index maths lives in DashboardTabKeyboard.
    private static readonly DashboardTab[] _tabs = [DashboardTab.Pipeline, DashboardTab.Activity, DashboardTab.Insights];
    private readonly ElementReference[] _tabRefs = new ElementReference[3];
    private int? _pendingFocusIndex;

    // DSH-07: single polite live-region message, announced when the summary finishes loading
    // or is retried.
    private string? _announcement;

    private static string TabIcon(DashboardTab tab) => tab switch
    {
        DashboardTab.Pipeline => "fa-diagram-project",
        DashboardTab.Activity => "fa-bell",
        _ => "fa-chart-simple",
    };

    private void OnTabsKeyDown(KeyboardEventArgs e)
    {
        var current = Array.IndexOf(_tabs, _tab);
        var next = DashboardTabKeyboard.NextIndex(e.Key, current, _tabs.Length);
        if (next is not { } n || n == current) return;

        _tab = _tabs[n];
        _pendingFocusIndex = n;
    }

    // Judgement call ("remembers filters"): the Kanban board is per-vacancy (see
    // GetRecruitmentKanban's contract), so the dashboard needs a vacancy picker above it. Tab
    // selection, Board/List toggle state, the selected vacancy, the board's search text, and the
    // terminal-stage toggle are all held here as plain in-memory fields — scoped to this component
    // instance's circuit lifetime, same as any other Blazor Server page state. No new persistence
    // mechanism (session storage, cookies, etc.) exists elsewhere in this codebase for "remember
    // during session" UI state, so none was introduced here; navigating away and back within the
    // same circuit keeps the selection (including which tab was active), a full reload resets it.
    private enum PipelineView { Board, List }
    private PipelineView _view = PipelineView.Board;
    private List<VacancyListItemModel> _vacancies = [];
    private bool _vacanciesLoading = true;
    private Guid? _selectedVacancyId;
    private string _boardSearchText = string.Empty;
    private bool _showTerminalStages;

    // ── Summary row state ───────────────────────────────────────────────────
    // DSH-03: each tile's underlying source is tracked as a WidgetResult so a failed source shows
    // "—" + an inline retry rather than a misleading 0.
    private const string SrcVacancies = "Open vacancies";
    private const string SrcPipeline = "New applications";
    private const string SrcCandidates = "Candidates in progress";
    private const string SrcInterviews = "Interviews requiring action";
    private const string SrcOffers = "Offers awaiting response";
    private const string SrcStale = "Stale vacancies";
    private const string SummaryWidgetName = "Recruitment summary";

    private readonly string[] _summarySources = [SrcVacancies, SrcPipeline, SrcCandidates, SrcInterviews, SrcOffers, SrcStale];
    private readonly HashSet<string> _retrying = [];

    private bool _summaryLoading = true;

    // DSH-04: every recruitment-summary tile now maps to an authoritative server metric endpoint
    // ({ count, items[] }, count == items.Count) rather than inferring meaning from stage ordering.
    // Each endpoint is its own tracked source so one failure can't blank the whole row or the header.
    private WidgetResult<ListVacanciesResponse?> _vacanciesRes = WidgetResult<ListVacanciesResponse?>.Loading(SrcVacancies);
    private WidgetResult<NewApplicationsMetricResponse?> _newApplicationsRes = WidgetResult<NewApplicationsMetricResponse?>.Loading(SrcPipeline);
    private WidgetResult<CandidatesInProgressMetricResponse?> _candidatesRes = WidgetResult<CandidatesInProgressMetricResponse?>.Loading(SrcCandidates);
    private WidgetResult<InterviewsRequiringActionMetricResponse?> _interviewsRes = WidgetResult<InterviewsRequiringActionMetricResponse?>.Loading(SrcInterviews);
    private WidgetResult<OffersAwaitingResponseMetricResponse?> _offersRes = WidgetResult<OffersAwaitingResponseMetricResponse?>.Loading(SrcOffers);
    private WidgetResult<GetStaleVacanciesResponse?> _staleRes = WidgetResult<GetStaleVacanciesResponse?>.Loading(SrcStale);
    private bool _offerStageConfigured = true;

    // Drill-down dialog state — always shows exactly the items the metric endpoint returned.
    private bool _drillDownVisible;
    private string _drillDownTitle = string.Empty;
    private string _drillDownDateHeader = "Applied";
    private IReadOnlyList<RecruitmentMetricDrillDownRow> _drillDownRows = [];

    private WidgetPanelSummary _summary = WidgetPanelState.Summarise([]);

    private int _openVacancies;
    private int _newApplications;
    private int _interviewsRequiringAction;
    private int _offersAwaitingResponse;
    private int _staleVacancies;
    private int _candidatesInProgress;

    protected override async Task OnInitializedAsync()
    {
        await Session.InitialiseAsync();

        if (!Session.IsRecruiter)
        {
            Navigation.NavigateTo(Session.MyProfileUrl, replace: true);
            return;
        }

        _ready = true;

        await Task.WhenAll(_summarySources.Select(LoadSummarySourceAsync));
        RecomputeSummary();
        _summaryLoading = false;
        AnnounceSummary();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingFocusIndex is { } idx)
        {
            _pendingFocusIndex = null;
            try { await _tabRefs[idx].FocusAsync(); } catch { }
        }
    }

    private void AnnounceSummary()
    {
        var counts = new (string Label, int Count)[]
        {
            ("open vacancies", _openVacancies),
            ("candidates in progress", _candidatesInProgress),
            ("interviews requiring action", _interviewsRequiringAction),
            ("offers awaiting response", _offersAwaitingResponse),
        };

        _announcement = DashboardAnnouncements.Compose(
            DashboardAnnouncements.LoadComplete("Recruitment dashboard"),
            DashboardAnnouncements.Counts(counts),
            DashboardAnnouncements.PartialFailure(_summary.FailedSources));
    }

    private void RecomputeSummary() => _summary = WidgetPanelState.Summarise(
    [
        new WidgetSourceOutcome(SrcVacancies, true, _vacanciesRes.IsFailed, _openVacancies),
        new WidgetSourceOutcome(SrcPipeline, true, _newApplicationsRes.IsFailed, _newApplications),
        new WidgetSourceOutcome(SrcCandidates, true, _candidatesRes.IsFailed, _candidatesInProgress),
        new WidgetSourceOutcome(SrcInterviews, true, _interviewsRes.IsFailed, _interviewsRequiringAction),
        new WidgetSourceOutcome(SrcOffers, true, _offersRes.IsFailed, _offersAwaitingResponse),
        new WidgetSourceOutcome(SrcStale, true, _staleRes.IsFailed, _staleVacancies),
    ]);

    private async Task LoadSummarySourceAsync(string name)
    {
        switch (name)
        {
            case SrcVacancies:
                _vacanciesRes = await SourceLoader.LoadAsync(SummaryWidgetName, name,
                    () => VacancyService.ListVacanciesOrThrowAsync(Session.CompanyId, status: "Open"));
                _vacancies = _vacanciesRes.IsLoaded ? _vacanciesRes.Value?.Items.ToList() ?? [] : [];
                _selectedVacancyId ??= _vacancies.FirstOrDefault()?.Id;
                _vacanciesLoading = false;
                _openVacancies = _vacancies.Count;
                break;

            case SrcPipeline:
                // DSH-04: authoritative "new applications" — live applications whose current stage
                // carries purpose = NewApplication (time-based fallback server-side when none does).
                _newApplicationsRes = await SourceLoader.LoadAsync(SummaryWidgetName, name,
                    () => VacancyService.GetNewApplicationsMetricOrThrowAsync(Session.CompanyId));
                _newApplications = _newApplicationsRes.IsLoaded ? _newApplicationsRes.Value?.Count ?? 0 : 0;
                break;

            case SrcCandidates:
                // DSH-04: authoritative "candidates in progress" — live applications in any
                // non-terminal stage. Own tracked source so a failure doesn't break the header line.
                _candidatesRes = await SourceLoader.LoadAsync(SummaryWidgetName, name,
                    () => VacancyService.GetCandidatesInProgressMetricOrThrowAsync(Session.CompanyId));
                _candidatesInProgress = _candidatesRes.IsLoaded ? _candidatesRes.Value?.Count ?? 0 : 0;
                break;

            case SrcInterviews:
                // DSH-04: authoritative "interviews requiring action" — interviews with a Pending
                // outcome scheduled at or before end of today (overdue + today's already-happened).
                _interviewsRes = await SourceLoader.LoadAsync(SummaryWidgetName, name,
                    () => InterviewService.GetInterviewsRequiringActionMetricOrThrowAsync(Session.CompanyId));
                _interviewsRequiringAction = _interviewsRes.IsLoaded ? _interviewsRes.Value?.Count ?? 0 : 0;
                break;

            case SrcStale:
                _staleRes = await SourceLoader.LoadAsync(SummaryWidgetName, name,
                    () => VacancyService.GetStaleVacanciesOrThrowAsync(Session.CompanyId));
                _staleVacancies = _staleRes.IsLoaded ? _staleRes.Value?.Items.Count ?? 0 : 0;
                break;

            case SrcOffers:
                // DSH-04: authoritative "offers awaiting response" — live applications whose current
                // stage carries purpose = Offer (summed across every Offer-purpose stage). No
                // order-based fallback: if no stage has that purpose the count is 0 and the tile is
                // rendered muted with a "No offer stage configured" hint.
                _offersRes = await SourceLoader.LoadAsync(SummaryWidgetName, name,
                    () => VacancyService.GetOffersAwaitingResponseMetricOrThrowAsync(Session.CompanyId));
                _offersAwaitingResponse = _offersRes.IsLoaded ? _offersRes.Value?.Count ?? 0 : 0;
                _offerStageConfigured = !_offersRes.IsLoaded || (_offersRes.Value?.OfferStageConfigured ?? true);
                break;
        }

    }

    private async Task RetrySummarySourceAsync(string name)
    {
        _retrying.Add(name);
        StateHasChanged();
        await LoadSummarySourceAsync(name);
        RecomputeSummary();
        _retrying.Remove(name);
        AnnounceSummary();
    }

    private static RecruitmentMetricDrillDownRow Row(RecruitmentMetricApplicationItem i) =>
        new(i.CandidateName, i.VacancyTitle, i.AppliedAt.LocalDateTime);

    private void OpenDrillDown(string source)
    {
        switch (source)
        {
            case SrcPipeline:
                _drillDownTitle = SrcPipeline;
                _drillDownDateHeader = "Applied";
                _drillDownRows = (_newApplicationsRes.Value?.Items ?? []).Select(Row).ToList();
                break;
            case SrcCandidates:
                _drillDownTitle = SrcCandidates;
                _drillDownDateHeader = "Applied";
                _drillDownRows = (_candidatesRes.Value?.Items ?? []).Select(Row).ToList();
                break;
            case SrcInterviews:
                _drillDownTitle = SrcInterviews;
                _drillDownDateHeader = "Scheduled";
                _drillDownRows = (_interviewsRes.Value?.Items ?? [])
                    .Select(i => new RecruitmentMetricDrillDownRow(i.CandidateName, i.VacancyTitle, i.ScheduledAt.LocalDateTime))
                    .ToList();
                break;
            case SrcOffers:
                _drillDownTitle = SrcOffers;
                _drillDownDateHeader = "Applied";
                _drillDownRows = (_offersRes.Value?.Items ?? []).Select(Row).ToList();
                break;
            default:
                return;
        }

        _drillDownVisible = true;
    }

    private void CloseDrillDown() => _drillDownVisible = false;

    private string HeaderSummary() =>
        $"{Pluralize(_openVacancies, "open vacancy", "open vacancies")} · " +
        $"{Pluralize(_candidatesInProgress, "candidate", "candidates")} in progress";

    // Small pluralization helper (matches ManagerDashboard.razor's ActivitySummary pattern) — avoids
    // grammatically wrong copy like "1 open vacancies" on the header summary line.
    private static string Pluralize(int count, string singular, string plural) =>
        count == 1 ? $"1 {singular}" : $"{count} {plural}";

    private void SetTab(DashboardTab tab) => _tab = tab;

    private void SetView(PipelineView view) => _view = view;

    private void OnShowTerminalStagesChanged(Microsoft.AspNetCore.Components.ChangeEventArgs args) =>
        _showTerminalStages = args.Value is bool b && b;

    private void OnBoardSearchChanged(Syncfusion.Blazor.Inputs.ChangedEventArgs args) =>
        _boardSearchText = args.Value ?? string.Empty;

    private void NavigateToNewVacancy() =>
        Navigation.NavigateTo($"/companies/{Session.CompanyId}/vacancies/new");

    private void NavigateToNewCandidate() =>
        Navigation.NavigateTo($"/companies/{Session.CompanyId}/candidates/new?origin=dashboard");
}
