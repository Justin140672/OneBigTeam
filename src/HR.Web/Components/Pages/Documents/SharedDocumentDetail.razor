@page "/companies/{CompanyId:guid}/shared-documents/{DocumentId:guid}"
@rendermode InteractiveServer
@inject DocumentService DocumentService
@inject AppSession Session
@inject NavigationManager Navigation

<PageTitle>@(_detail?.Title ?? "Shared Document")</PageTitle>

<div class="container py-4 doc-detail-page">
    @if (_loading)
    {
        <HrLoadingIndicator Label="Loading document…" />
    }
    else if (_detail is null)
    {
        <div class="alert alert-danger">Document was not found.</div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_publishError))
        {
            <div class="alert alert-danger alert-dismissible mb-3">
                @_publishError
                <button type="button" class="btn-close" @onclick="@(() => _publishError = null)"></button>
            </div>
        }
        <div class="doc-detail-header mb-3">
            <div class="doc-detail-heading">
                <a href="/companies/@CompanyId/shared-documents" class="text-decoration-none text-muted small">← Shared Documents</a>
                <div class="d-flex align-items-center flex-wrap gap-2 mt-1">
                    <h1 class="mb-0 doc-detail-title">@_detail.Title</h1>
                    <span class="badge @StatusBadgeClass(_detail.Status) doc-detail-status-badge">@_detail.Status</span>
                </div>
            </div>

            <div class="doc-detail-actions">
                <div class="doc-detail-actions-group">
                    @if (_detail.Status == "Draft")
                    {
                        <SfButton CssClass="e-primary" OnClick="@(() => _publishConfirmOpen = true)">
                            <i class="fa-solid fa-paper-plane me-1"></i> Publish
                        </SfButton>
                        <SfButton CssClass="e-outline" OnClick="@(() => _editOpen = true)">
                            <i class="fa-solid fa-pen me-1"></i> Edit
                        </SfButton>
                    }
                    else
                    {
                        <SfButton CssClass="e-primary" OnClick="@(() => _editOpen = true)">
                            <i class="fa-solid fa-pen me-1"></i> Edit
                        </SfButton>
                    }
                    <a class="e-btn e-outline" href="@DocumentService.GetSharedCompanyDocumentDownloadUrl(CompanyId, DocumentId)" target="_blank">
                        <i class="fa-solid fa-download me-1"></i> Download
                    </a>
                    <SfButton CssClass="e-outline" OnClick="@(() => _reviewOpen = true)">
                        <i class="fa-solid fa-clipboard-check me-1"></i> Review Document
                    </SfButton>
                    <SfButton CssClass="e-outline" OnClick="@(() => _auditHistoryOpen = true)">
                        <i class="fa-solid fa-clock-rotate-left me-1"></i> Audit History
                    </SfButton>
                </div>
                @if (_detail.Status is "Draft" or "Published")
                {
                    <div class="doc-detail-actions-group doc-detail-actions-danger">
                        <SfButton CssClass="e-outline e-danger" OnClick="@(() => _archiveConfirmOpen = true)">
                            <i class="fa-solid fa-box-archive me-1"></i> Archive
                        </SfButton>
                        <SfButton CssClass="e-outline e-danger" OnClick="@(() => _expireConfirmOpen = true)">
                            <i class="fa-solid fa-calendar-xmark me-1"></i> Mark Expired
                        </SfButton>
                    </div>
                }
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-xl-4 col-md-6">
                <div class="overview-card doc-detail-card">
                    <div class="overview-card-header d-flex justify-content-between align-items-center">
                        <span>
                            <i class="fa-solid fa-file-lines overview-card-icon"></i>
                            <span class="overview-card-title">Document Metadata</span>
                        </span>
                        @if (_detail.Status != "Archived")
                        {
                            <SfButton CssClass="e-small e-outline" OnClick="@(() => _uploadVersionOpen = true)">
                                <i class="fa-solid fa-upload me-1"></i> Upload New Version
                            </SfButton>
                        }
                    </div>
                    <dl class="overview-dl">
                        <dt>Category</dt>
                        <dd>@_detail.CategoryName</dd>
                        <dt>Status</dt>
                        <dd><span class="badge @StatusBadgeClass(_detail.Status)">@_detail.Status</span></dd>
                        <dt>Current Version</dt>
                        <dd>v@(_detail.VersionNumber)</dd>
                        <dt>File</dt>
                        <dd>@_detail.FileName (@FormatBytes(_detail.FileSize))</dd>
                        @if (_detail.EffectiveDate.HasValue)
                        {
                            <dt>Effective Date</dt>
                            <dd>@_detail.EffectiveDate.Value.ToString("d MMMM yyyy")</dd>
                        }
                        @if (_detail.ReviewDate.HasValue)
                        {
                            <dt>Next Review Date</dt>
                            <dd>@_detail.ReviewDate.Value.ToString("d MMMM yyyy")</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(_detail.ReviewFrequency) && _detail.ReviewFrequency != "None")
                        {
                            <dt>Review Frequency</dt>
                            <dd>
                                @ReviewFrequencyDisplay.Label(_detail.ReviewFrequency)
                                @if (_detail.ReviewFrequency == "Custom" && _detail.CustomReviewFrequencyMonths.HasValue)
                                {
                                    <text> (every @(_detail.CustomReviewFrequencyMonths.Value) month@(_detail.CustomReviewFrequencyMonths.Value == 1 ? "" : "s"))</text>
                                }
                            </dd>
                        }
                        @if (_detail.ReviewOwnerEmployeeId.HasValue)
                        {
                            <dt>Review Owner</dt>
                            <dd>@_detail.ReviewOwnerName</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(_detail.Description))
                        {
                            <dt>Description</dt>
                            <dd>@_detail.Description</dd>
                        }
                    </dl>
                </div>
            </div>

            <div class="col-xl-4 col-md-6">
                <div class="overview-card doc-detail-card">
                    <div class="overview-card-header d-flex justify-content-between align-items-center">
                        <span>
                            <i class="fa-solid fa-users overview-card-icon"></i>
                            <span class="overview-card-title">Audience</span>
                        </span>
                        <SfButton CssClass="e-small e-outline" OnClick="@(() => _editAudienceOpen = true)">
                            <i class="fa-solid fa-pen me-1"></i> Edit
                        </SfButton>
                    </div>
                    <dl class="overview-dl">
                        <dt>Audience</dt>
                        <dd>@_detail.AudienceDescription</dd>
                    </dl>
                </div>
            </div>

            <div class="col-xl-4 col-md-6">
                <div class="overview-card doc-detail-card">
                    <div class="overview-card-header d-flex justify-content-between align-items-center">
                        <span>
                            <i class="fa-solid fa-clipboard-check overview-card-icon"></i>
                            <span class="overview-card-title">Acknowledgement</span>
                        </span>
                        <div>
                            @if (_detail.RequiresAcknowledgement)
                            {
                                <a class="e-btn e-small e-outline me-1" href="/companies/@CompanyId/shared-documents/@DocumentId/acknowledgement-progress">
                                    <i class="fa-solid fa-chart-simple me-1"></i> View Progress
                                </a>
                                @if (_detail.Status == "Published")
                                {
                                    <SfButton CssClass="e-small e-outline me-1" OnClick="@(() => _reissueConfirmOpen = true)">
                                        <i class="fa-solid fa-paper-plane me-1"></i> Reissue
                                    </SfButton>
                                }
                            }
                            <SfButton CssClass="e-small e-outline" OnClick="@(() => _editAcknowledgementOpen = true)">
                                <i class="fa-solid fa-pen me-1"></i> Edit
                            </SfButton>
                        </div>
                    </div>
                    <dl class="overview-dl">
                        <dt>Requires Acknowledgement</dt>
                        <dd>@(_detail.RequiresAcknowledgement ? "Yes" : "No")</dd>
                        @if (_detail.RequiresAcknowledgement)
                        {
                            <dt>Due Date</dt>
                            <dd>@(_detail.AcknowledgementDueDate?.ToString("d MMMM yyyy") ?? "Not set")</dd>
                            <dt>Statement</dt>
                            <dd>@(_detail.AcknowledgementStatement ?? "I confirm that I have read and understood this document.")</dd>
                        }
                    </dl>
                    @if (_detail.RequiresAcknowledgement && _detail.AcknowledgementProgress is not null)
                    {
                        var progress = _detail.AcknowledgementProgress;
                        var percent = progress.EligibleCount == 0 ? 0 : (int)Math.Round(progress.AcknowledgedCount * 100m / progress.EligibleCount);
                        <div class="px-1 py-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="text-muted small">@progress.AcknowledgedCount of @progress.EligibleCount acknowledged</span>
                                <span class="fw-semibold">@(percent)%</span>
                            </div>
                            <div class="progress">
                                <div class="progress-bar" role="progressbar" style="width: @(percent)%"></div>
                            </div>
                        </div>
                        @if (progress.AcknowledgedEmployeeNames.Count > 0)
                        {
                            <ul class="upcoming-leave-list">
                                @foreach (var name in progress.AcknowledgedEmployeeNames)
                                {
                                    <li class="upcoming-leave-item"><span class="upcoming-leave-type">@name</span></li>
                                }
                            </ul>
                        }
                    }
                </div>
            </div>

            <div class="col-12">
                <div class="overview-card doc-detail-card">
                    <div class="overview-card-header">
                        <i class="fa-solid fa-clock-rotate-left overview-card-icon"></i>
                        <span class="overview-card-title">Version History</span>
                    </div>
                    @if (_detail.VersionHistory.Count == 0)
                    {
                        <div class="doc-detail-empty-state">No versions yet.</div>
                    }
                    else
                    {
                        <HrGrid TValue="SharedCompanyDocumentVersionModel" DataSource="@_detail.VersionHistory" AllowPaging="false" AllowTextWrap="true">
                            <GridColumns>
                                <GridColumn Field="@nameof(SharedCompanyDocumentVersionModel.VersionNumber)" HeaderText="Version" Width="90" />
                                <GridColumn Field="@nameof(SharedCompanyDocumentVersionModel.PublicationStatus)" HeaderText="Publication Status" Width="140">
                                    <Template>
                                        @{
                                            var row = (context as SharedCompanyDocumentVersionModel)!;
                                        }
                                        <span class="badge @StatusBadgeClass(row.PublicationStatus)">@row.PublicationStatus</span>
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(SharedCompanyDocumentVersionModel.FileName)" HeaderText="File Name" Width="240" />
                                <GridColumn Field="@nameof(SharedCompanyDocumentVersionModel.VersionNote)" HeaderText="Note" Width="260" />
                                <GridColumn Field="@nameof(SharedCompanyDocumentVersionModel.RequiresAcknowledgement)" HeaderText="Required Ack" Width="120">
                                    <Template>
                                        @{
                                            var row = (context as SharedCompanyDocumentVersionModel)!;
                                        }
                                        @(row.RequiresAcknowledgement ? "Yes" : "No")
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(SharedCompanyDocumentVersionModel.EffectiveDate)" HeaderText="Effective Date" Width="130" Format="d" />
                                <GridColumn Field="@nameof(SharedCompanyDocumentVersionModel.UploadedByName)" HeaderText="Uploaded By" Width="160" />
                                <GridColumn Field="@nameof(SharedCompanyDocumentVersionModel.UploadedAt)" HeaderText="Uploaded At" Width="170" Format="g" />
                                <GridColumn HeaderText="Download" Width="100">
                                    <Template>
                                        @{
                                            var row = (context as SharedCompanyDocumentVersionModel)!;
                                        }
                                        <a href="@DocumentService.GetSharedCompanyDocumentVersionDownloadUrl(CompanyId, DocumentId, row.VersionNumber)" target="_blank" title="Download this version">
                                            <i class="fa-solid fa-download"></i>
                                        </a>
                                    </Template>
                                </GridColumn>
                            </GridColumns>
                        </HrGrid>
                    }
                </div>
            </div>

            <div class="col-12">
                <div class="overview-card doc-detail-card">
                    <div class="overview-card-header">
                        <i class="fa-solid fa-magnifying-glass-chart overview-card-icon"></i>
                        <span class="overview-card-title">Review History</span>
                    </div>
                    @if (_detail.ReviewHistory.Count == 0)
                    {
                        <div class="doc-detail-empty-state">No reviews yet.</div>
                    }
                    else
                    {
                        <HrGrid TValue="SharedCompanyDocumentReviewHistoryModel" DataSource="@_detail.ReviewHistory" AllowPaging="false" AllowTextWrap="true">
                            <GridColumns>
                                <GridColumn Field="@nameof(SharedCompanyDocumentReviewHistoryModel.ReviewDate)" HeaderText="Review Date" Width="130" Format="d" />
                                <GridColumn Field="@nameof(SharedCompanyDocumentReviewHistoryModel.ReviewedByName)" HeaderText="Reviewer" Width="180" />
                                <GridColumn Field="@nameof(SharedCompanyDocumentReviewHistoryModel.ReviewNotes)" HeaderText="Notes" Width="280" />
                                <GridColumn Field="@nameof(SharedCompanyDocumentReviewHistoryModel.PreviousReviewDate)" HeaderText="Previous Review Date" Width="170" Format="d" />
                            </GridColumns>
                        </HrGrid>
                    }
                </div>
            </div>

            <div class="col-12">
                <p class="text-muted small mb-0">
                    Created by @_detail.CreatedByName on @_detail.CreatedAt.ToString("d MMM yyyy, HH:mm")
                    · Last updated by @_detail.UpdatedByName on @_detail.UpdatedAt.ToString("d MMM yyyy, HH:mm")
                    @if (_detail.PublishedAt.HasValue)
                    {
                        <text> · Published by @_detail.PublishedByName on @_detail.PublishedAt.Value.ToString("d MMM yyyy, HH:mm")</text>
                    }
                    @if (_detail.ArchivedAt.HasValue)
                    {
                        <text> · Archived by @_detail.ArchivedByName on @_detail.ArchivedAt.Value.ToString("d MMM yyyy, HH:mm") — reason: @_detail.ArchiveReason</text>
                    }
                    @if (_detail.LastReviewedAt.HasValue)
                    {
                        <text> · Last reviewed by @_detail.LastReviewedByName on @_detail.LastReviewedAt.Value.ToString("d MMM yyyy")</text>
                    }
                </p>
            </div>
        </div>
    }
</div>

<EditSharedCompanyDocumentMetadataDialog CompanyId="CompanyId"
                                          Document="_detail"
                                          IsOpen="_editOpen"
                                          OnSaved="OnMetadataSavedAsync"
                                          OnCancelled="@(() => _editOpen = false)" />

<EditSharedCompanyDocumentAudienceDialog CompanyId="CompanyId"
                                          Document="_detail"
                                          IsOpen="_editAudienceOpen"
                                          OnSaved="OnAudienceSavedAsync"
                                          OnCancelled="@(() => _editAudienceOpen = false)" />

<EditSharedCompanyDocumentAcknowledgementDialog CompanyId="CompanyId"
                                                 Document="_detail"
                                                 IsOpen="_editAcknowledgementOpen"
                                                 OnSaved="OnAcknowledgementSavedAsync"
                                                 OnCancelled="@(() => _editAcknowledgementOpen = false)" />

<UploadSharedCompanyDocumentVersionDialog CompanyId="CompanyId"
                                           DocumentId="DocumentId"
                                           Document="_detail"
                                           IsOpen="_uploadVersionOpen"
                                           OnSaved="OnVersionUploadedAsync"
                                           OnCancelled="@(() => _uploadVersionOpen = false)" />

<CompleteSharedCompanyDocumentReviewDialog CompanyId="CompanyId"
                                           Document="_detail"
                                           IsOpen="_reviewOpen"
                                           OnSaved="OnReviewCompletedAsync"
                                           OnCancelled="@(() => _reviewOpen = false)" />

<SharedCompanyDocumentAuditHistoryDialog CompanyId="CompanyId"
                                          DocumentId="DocumentId"
                                          IsOpen="_auditHistoryOpen"
                                          OnClosed="@(() => _auditHistoryOpen = false)" />

<SfDialog Visible="_publishConfirmOpen" IsModal="true" Width="420px" ShowCloseIcon="false">
    <DialogTemplates>
        <Header>Publish Document</Header>
        <Content>
            Publishing "@_detail?.Title" will make it visible to its intended audience@(_detail?.RequiresAcknowledgement == true ? " and create acknowledgement tasks for eligible employees" : "").
            This cannot be undone from here. Continue?
        </Content>
        <FooterTemplate>
            <SfButton CssClass="e-primary" Disabled="_publishing" OnClick="ConfirmPublishAsync">
                @(_publishing ? "Publishing…" : "Publish")
            </SfButton>
            <SfButton Disabled="_publishing" OnClick="@(() => _publishConfirmOpen = false)">Cancel</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<SfDialog Visible="_archiveConfirmOpen" IsModal="true" Width="420px" ShowCloseIcon="false">
    <DialogTemplates>
        <Header>Archive Document</Header>
        <Content>
            <p>
                Archiving "@_detail?.Title" will remove it from the employee document list, prevent new
                acknowledgement tasks, and cancel any outstanding acknowledgement tasks. The document, its
                versions, and completed acknowledgements are retained. This cannot be undone from here.
            </p>
            <div class="mb-2">
                <label class="form-label">Reason <span class="text-danger">*</span></label>
                <HrTextBox @bind-Value="_archiveReason" Multiline="true" Rows="3" Maxlength="500"
                           HtmlAttributes="@(new Dictionary<string, object> { ["id"] = "archive-reason" })" />
            </div>
            @if (!string.IsNullOrEmpty(_archiveError))
            {
                <div class="alert alert-danger py-2 mb-0">@_archiveError</div>
            }
        </Content>
        <FooterTemplate>
            <SfButton CssClass="e-danger" Disabled="_archiving" OnClick="ConfirmArchiveAsync">
                @(_archiving ? "Archiving…" : "Archive")
            </SfButton>
            <SfButton Disabled="_archiving" OnClick="CancelArchive">Cancel</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<SfDialog Visible="_reissueConfirmOpen" IsModal="true" Width="420px" ShowCloseIcon="false">
    <DialogTemplates>
        <Header>Reissue Acknowledgement Request</Header>
        <Content>
            <p>
                This sends a fresh reminder notification to every employee who hasn't yet acknowledged
                "@_detail?.Title", and creates an acknowledgement task for anyone who doesn't already have
                one. Employees who have already acknowledged are not affected.
            </p>
            @if (!string.IsNullOrEmpty(_reissueError))
            {
                <div class="alert alert-danger py-2 mb-0">@_reissueError</div>
            }
        </Content>
        <FooterTemplate>
            <SfButton CssClass="e-primary" Disabled="_reissuing" OnClick="ConfirmReissueAsync">
                @(_reissuing ? "Sending…" : "Reissue")
            </SfButton>
            <SfButton Disabled="_reissuing" OnClick="@(() => _reissueConfirmOpen = false)">Cancel</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<SfDialog Visible="_expireConfirmOpen" IsModal="true" Width="420px" ShowCloseIcon="false">
    <DialogTemplates>
        <Header>Mark Document as Expired</Header>
        <Content>
            <p>
                Marking "@_detail?.Title" as expired will remove it from the employee document list and
                cancel any outstanding review tasks. This cannot be undone.
            </p>
            @if (!string.IsNullOrEmpty(_expireError))
            {
                <div class="alert alert-danger py-2 mb-0">@_expireError</div>
            }
        </Content>
        <FooterTemplate>
            <SfButton CssClass="e-danger" Disabled="_expiring" OnClick="ConfirmExpireAsync">
                @(_expiring ? "Marking Expired…" : "Mark Expired")
            </SfButton>
            <SfButton Disabled="_expiring" OnClick="CancelExpire">Cancel</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid DocumentId { get; set; }

    private SharedCompanyDocumentDetailResponse? _detail;
    private bool _loading = true;
    private bool _editOpen;
    private bool _editAudienceOpen;
    private bool _editAcknowledgementOpen;
    private bool _uploadVersionOpen;
    private bool _reviewOpen;
    private bool _auditHistoryOpen;
    private bool _reissueConfirmOpen;
    private bool _reissuing;
    private string? _reissueError;
    private bool _publishConfirmOpen;
    private bool _publishing;
    private string? _publishError;
    private bool _archiveConfirmOpen;
    private bool _archiving;
    private string _archiveReason = string.Empty;
    private string? _archiveError;
    private bool _expireConfirmOpen;
    private bool _expiring;
    private string? _expireError;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsHrAdministrator)
        {
            Navigation.NavigateTo(Session.MyProfileUrl, replace: true);
            return;
        }

        _detail = await DocumentService.GetSharedCompanyDocumentAsync(CompanyId, DocumentId);
        _loading = false;
    }

    private async Task OnMetadataSavedAsync()
    {
        _editOpen = false;
        _detail = await DocumentService.GetSharedCompanyDocumentAsync(CompanyId, DocumentId);
    }

    private async Task OnAudienceSavedAsync()
    {
        _editAudienceOpen = false;
        _detail = await DocumentService.GetSharedCompanyDocumentAsync(CompanyId, DocumentId);
    }

    private async Task OnAcknowledgementSavedAsync()
    {
        _editAcknowledgementOpen = false;
        _detail = await DocumentService.GetSharedCompanyDocumentAsync(CompanyId, DocumentId);
    }

    private async Task OnVersionUploadedAsync()
    {
        _uploadVersionOpen = false;
        _detail = await DocumentService.GetSharedCompanyDocumentAsync(CompanyId, DocumentId);
    }

    private async Task OnReviewCompletedAsync()
    {
        _reviewOpen = false;
        _detail = await DocumentService.GetSharedCompanyDocumentAsync(CompanyId, DocumentId);
    }

    private async Task ConfirmPublishAsync()
    {
        _publishing = true;
        StateHasChanged();

        var error = await DocumentService.PublishSharedCompanyDocumentAsync(CompanyId, DocumentId);

        _publishing = false;
        _publishConfirmOpen = false;

        if (error is not null)
        {
            _publishError = error;
            return;
        }

        _publishError = null;
        _detail = await DocumentService.GetSharedCompanyDocumentAsync(CompanyId, DocumentId);
    }

    private void CancelArchive()
    {
        _archiveConfirmOpen = false;
        _archiveReason = string.Empty;
        _archiveError = null;
    }

    private async Task ConfirmArchiveAsync()
    {
        if (string.IsNullOrWhiteSpace(_archiveReason))
        {
            _archiveError = "A reason is required.";
            return;
        }

        _archiving = true;
        _archiveError = null;
        StateHasChanged();

        var error = await DocumentService.ArchiveSharedCompanyDocumentAsync(CompanyId, DocumentId, _archiveReason);

        _archiving = false;

        if (error is not null)
        {
            _archiveError = error;
            return;
        }

        _archiveConfirmOpen = false;
        _archiveReason = string.Empty;
        _archiveError = null;
        _detail = await DocumentService.GetSharedCompanyDocumentAsync(CompanyId, DocumentId);
    }

    private async Task ConfirmReissueAsync()
    {
        _reissuing = true;
        _reissueError = null;
        StateHasChanged();

        var error = await DocumentService.ReissueSharedCompanyDocumentAcknowledgementAsync(CompanyId, DocumentId);

        _reissuing = false;

        if (error is not null)
        {
            _reissueError = error;
            return;
        }

        _reissueConfirmOpen = false;
        _detail = await DocumentService.GetSharedCompanyDocumentAsync(CompanyId, DocumentId);
    }

    private void CancelExpire()
    {
        _expireConfirmOpen = false;
        _expireError = null;
    }

    private async Task ConfirmExpireAsync()
    {
        _expiring = true;
        _expireError = null;
        StateHasChanged();

        var error = await DocumentService.ExpireSharedCompanyDocumentAsync(CompanyId, DocumentId);

        _expiring = false;

        if (error is not null)
        {
            _expireError = error;
            return;
        }

        _expireConfirmOpen = false;
        _expireError = null;
        _detail = await DocumentService.GetSharedCompanyDocumentAsync(CompanyId, DocumentId);
    }

    private static string StatusBadgeClass(string status) => status switch
    {
        "Published"  => "bg-success",
        "Archived"   => "bg-secondary",
        "Superseded" => "bg-secondary",
        "Expired"    => "bg-secondary",
        _            => "bg-warning text-dark",
    };

    private static string FormatBytes(long bytes) =>
        bytes < 1024 * 1024
            ? $"{bytes / 1024.0:0.#} KB"
            : $"{bytes / (1024.0 * 1024.0):0.#} MB";
}
