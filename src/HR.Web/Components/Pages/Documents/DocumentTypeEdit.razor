@page "/companies/{CompanyId:guid}/document-types/new"
@page "/companies/{CompanyId:guid}/document-types/{Id:guid}"
@page "/companies/{CompanyId:guid}/document-types/{Id:guid}/view"
@rendermode InteractiveServer
@inject DocumentTypeService DocumentTypeService
@inherits EditPageBase<DocumentTypeEditModel>

<PageTitle>@PageTitle</PageTitle>

<div class="container py-4">
    <SfBreadcrumb Class="mb-3">
        <BreadcrumbItems>
            <BreadcrumbItem Text="Document Types" Url="@($"/companies/{CompanyId}/document-types")" />
            <BreadcrumbItem Text="@PageTitle" />
        </BreadcrumbItems>
    </SfBreadcrumb>

    @if (IsLoading)
    {
        <div class="d-flex align-items-center gap-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Loading…</span>
        </div>
    }
    else
    {
        <h1 class="mb-1">@PageTitle</h1>
        <p class="text-muted mb-4">Set the name and whether employees can upload this document type themselves.</p>

        @if (!string.IsNullOrEmpty(GlobalError))
        {
            <div class="alert alert-danger">@GlobalError</div>
        }

        <EditForm EditContext="EditContext">
            <DataAnnotationsValidator />
            <div class="row">
                <div class="col-lg-7">
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Document Type Details</h5>
                        </div>
                        <div class="card-body @(IsViewMode ? "view-mode" : "")">
                            <div class="mb-3">
                                <label class="form-label">Name <span class="text-danger">*</span></label>
                                <HrTextBox @bind-Value="Model.Name" Placeholder="e.g. Passport, Contract" />
                                <ValidationMessage For="@(() => Model.Name)" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Description</label>
                                <HrTextBox @bind-Value="Model.Description" Placeholder="Optional description" />
                            </div>
                            <div class="mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="allowEmployeeUpload"
                                           @bind="Model.AllowEmployeeUpload" />
                                    <label class="form-check-label" for="allowEmployeeUpload">Allow employee upload</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        @if (!IsViewMode)
                        {
                            <SfButton IsPrimary="true" Disabled="@Saving" OnClick="SaveAsync">
                                @if (Saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                Save
                            </SfButton>
                        }
                        <SfButton OnClick="RequestClose" Disabled="@Saving">Close</SfButton>
                    </div>
                </div>
            </div>
        </EditForm>
    }

    <UnsavedChangesDialog Visible="ShowUnsavedChangesDialog"
                          OnSaveAndClose="ConfirmSaveAndCloseAsync"
                          OnDiscard="DiscardChangesAndClose"
                          OnCancel="CancelCloseDialog" />
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid? Id { get; set; }

    private bool IsNew => Id is null || Id == Guid.Empty;
    private string PageTitle => IsNew ? "Add Document Type"
        : Model.Name.Trim().Length > 0 ? Model.Name
        : IsViewMode ? "View Document Type" : "Edit Document Type";

    protected override async Task LoadAsync()
    {
        if (!IsNew)
        {
            var list = await DocumentTypeService.ListDocumentTypesAsync(CompanyId, includeInactive: true);
            var existing = list?.Items.FirstOrDefault(e => e.Id == Id);
            if (existing is not null)
            {
                Model.Name = existing.Name;
                Model.Description = existing.Description;
                Model.AllowEmployeeUpload = existing.AllowEmployeeUpload;
            }
        }
    }

    protected override async Task<string?> SaveCoreAsync()
    {
        if (IsNew)
        {
            var request = new CreateDocumentTypeRequest(
                CompanyId,
                Model.Name.Trim(),
                string.IsNullOrWhiteSpace(Model.Description) ? null : Model.Description.Trim(),
                Model.AllowEmployeeUpload);

            var (created, error) = await DocumentTypeService.CreateAsync(CompanyId, request);
            return created is not null ? null : error ?? "Failed to create document type.";
        }
        else
        {
            var request = new UpdateDocumentTypeRequest(
                CompanyId,
                Id!.Value,
                Model.Name.Trim(),
                string.IsNullOrWhiteSpace(Model.Description) ? null : Model.Description.Trim(),
                Model.AllowEmployeeUpload);

            var (updated, error) = await DocumentTypeService.UpdateAsync(CompanyId, Id!.Value, request);
            return updated is not null ? null : error ?? "Failed to save document type.";
        }
    }

    protected override string? ListUrl => $"/companies/{CompanyId}/document-types";
}
