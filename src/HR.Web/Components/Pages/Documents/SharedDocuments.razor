@page "/companies/{CompanyId:guid}/shared-documents"
@rendermode InteractiveServer
@inject DocumentService DocumentService
@inject AppSession Session
@inject NavigationManager Navigation

<PageTitle>Shared Documents</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-start mb-1">
        <h1 class="mb-1">Shared Documents</h1>
        <SfButton CssClass="e-primary" OnClick="@(() => _uploadOpen = true)">Upload Document</SfButton>
    </div>
    <p class="text-muted mb-4">Company-wide documents such as policies and handbooks.</p>

    @if (_loading)
    {
        <HrLoadingIndicator Label="Loading documents…" />
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else if (_documents.Count == 0)
    {
        <p class="text-muted">No shared documents yet.</p>
    }
    else
    {
        <HrGrid TValue="SharedCompanyDocumentListItem" DataSource="@_documents" AllowPaging="true" AllowSorting="true">
            <GridPageSettings PageSize="20" />
            <GridColumns>
                <GridColumn Field="@nameof(SharedCompanyDocumentListItem.Title)" HeaderText="Title" Width="200">
                    <Template>
                        @{
                            var row = (context as SharedCompanyDocumentListItem)!;
                            <a href="/companies/@CompanyId/shared-documents/@row.Id">@row.Title</a>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(SharedCompanyDocumentListItem.CategoryName)" HeaderText="Category" Width="130" />
                <GridColumn Field="@nameof(SharedCompanyDocumentListItem.VersionNumber)" HeaderText="Version" Width="90" />
                <GridColumn Field="@nameof(SharedCompanyDocumentListItem.Status)" HeaderText="Status" Width="100" />
                <GridColumn Field="@nameof(SharedCompanyDocumentListItem.EffectiveDate)" HeaderText="Effective Date" Width="130" Format="d" />
                <GridColumn Field="@nameof(SharedCompanyDocumentListItem.ReviewDate)" HeaderText="Next Review Date" Width="150" Format="d" />
                <GridColumn Field="@nameof(SharedCompanyDocumentListItem.ReviewFrequency)" HeaderText="Review Frequency" Width="140">
                    <Template>
                        @{
                            var row = (context as SharedCompanyDocumentListItem)!;
                            @(row.ReviewFrequency != "None" ? ReviewFrequencyDisplay.Label(row.ReviewFrequency) : "")
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(SharedCompanyDocumentListItem.ReviewOwnerName)" HeaderText="Review Owner" Width="150" />
                <GridColumn Field="@nameof(SharedCompanyDocumentListItem.UpdatedAt)" HeaderText="Last Updated" Width="150" Format="g" />
                <GridColumn Field="@nameof(SharedCompanyDocumentListItem.UpdatedByName)" HeaderText="Updated By" Width="150" />
            </GridColumns>
        </HrGrid>
    }
</div>

<UploadSharedCompanyDocumentDialog CompanyId="CompanyId"
                                    IsOpen="_uploadOpen"
                                    OnSaved="OnDocumentUploadedAsync"
                                    OnCancelled="@(() => _uploadOpen = false)" />

@code {
    [Parameter] public Guid CompanyId { get; set; }

    private List<SharedCompanyDocumentListItem> _documents = [];
    private bool _loading = true;
    private string? _error;
    private bool _uploadOpen;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.CanManageSharedDocuments)
        {
            Navigation.NavigateTo("/access-denied", replace: true);
            return;
        }

        await LoadDocumentsAsync();
    }

    private async Task LoadDocumentsAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var result = await DocumentService.ListSharedCompanyDocumentsAsync(CompanyId);

            if (result is null)
            {
                _error = "Failed to load shared documents.";
                return;
            }

            _error = null;
            _documents = result.Items.ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnDocumentUploadedAsync()
    {
        _uploadOpen = false;
        await LoadDocumentsAsync();
    }
}
