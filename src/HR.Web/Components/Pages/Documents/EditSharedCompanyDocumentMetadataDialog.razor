@using System.ComponentModel.DataAnnotations
@using Syncfusion.Blazor.Data
@inject DocumentService DocumentService
@inject EmployeeService EmployeeService
@inherits EditDialogBase<EditSharedCompanyDocumentMetadataDialog.EditSharedCompanyDocumentMetadataFormModel>

<SfDialog @bind-Visible="Visible" IsModal="true" Width="640px" ShowCloseIcon="true">
    <DialogEvents Closed="HandleDialogClosed" />
    <DialogTemplates>
        <Header>Edit Document Metadata</Header>
        <Content>
            @if (!string.IsNullOrEmpty(GlobalError))
            {
                <div class="alert alert-danger alert-dismissible mb-3">
                    @GlobalError
                    <button type="button" class="btn-close" @onclick="@(() => GlobalError = null)"></button>
                </div>
            }
            <EditForm EditContext="EditContext">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Title <span class="text-danger">*</span></label>
                        <HrTextBox @bind-Value="Model.Title" Placeholder="Document title" />
                        <ValidationMessage For="@(() => Model.Title)" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Category <span class="text-danger">*</span></label>
                        @if (_dataLoaded)
                        {
                            <SfDropDownList TValue="Guid?"
                                            TItem="CompanyDocumentCategoryItem"
                                            DataSource="@_categories"
                                            @bind-Value="Model.CategoryId"
                                            Placeholder="Select category…"
                                            AllowFiltering="true">
                                <DropDownListFieldSettings Value="Id" Text="Name" />
                            </SfDropDownList>
                        }
                        else
                        {
                            <HrLoadingIndicator Label="Loading categories…" />
                        }
                        <ValidationMessage For="@(() => Model.CategoryId)" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <HrTextBox @bind-Value="Model.Description"
                                   Placeholder="Optional description"
                                   Multiline="true" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Effective Date</label>
                        <SfDatePicker TValue="DateOnly?"
                                      @bind-Value="Model.EffectiveDate"
                                      Format="dd/MM/yyyy"
                                      Placeholder="dd/mm/yyyy"
                                      ShowClearButton="true" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">
                            Next Review Date
                            @if (Model.ReviewFrequency != "None")
                            {
                                <span class="text-danger">*</span>
                            }
                        </label>
                        <SfDatePicker TValue="DateOnly?"
                                      @bind-Value="Model.ReviewDate"
                                      Format="dd/MM/yyyy"
                                      Placeholder="dd/mm/yyyy"
                                      ShowClearButton="true" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Review Frequency</label>
                        <SfDropDownList TValue="string"
                                        TItem="ReviewFrequencyOption"
                                        DataSource="@_reviewFrequencyOptions"
                                        @bind-Value="Model.ReviewFrequency">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                    @if (Model.ReviewFrequency == "Custom")
                    {
                        <div class="col-md-6">
                            <label class="form-label">Custom Frequency (months)</label>
                            <SfNumericTextBox TValue="int?" @bind-Value="Model.CustomReviewFrequencyMonths"
                                              Min="1" Placeholder="e.g. 6" ShowSpinButton="false" />
                        </div>
                    }
                    <div class="col-md-6">
                        <label class="form-label">Review Owner</label>
                        @if (_dataLoaded)
                        {
                            <SfDropDownList @ref="_reviewOwnerDropdown"
                                            TValue="Guid?"
                                            TItem="ReviewOwnerOption"
                                            DataSource="@_reviewOwnerOptions"
                                            @bind-Value="Model.ReviewOwnerEmployeeId"
                                            Placeholder="None"
                                            AllowFiltering="true">
                                <DropDownListFieldSettings Value="Id" Text="Name" />
                                <DropDownListEvents TValue="Guid?" TItem="ReviewOwnerOption" Filtering="OnReviewOwnerFilteringAsync" />
                            </SfDropDownList>
                        }
                        else
                        {
                            <HrLoadingIndicator Label="Loading employees…" />
                        }
                    </div>
                </div>
            </EditForm>
        </Content>
        <FooterTemplate>
            <HrDialogButtonBar SaveLabel="Save" Saving="Saving" OnSave="SubmitAsync" OnCancel="CancelAsync" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<UnsavedChangesDialog Visible="ShowUnsavedChangesDialog"
                      OnSaveAndClose="ConfirmSaveInsteadOfCancelAsync"
                      OnDiscard="ConfirmDiscardAsync"
                      OnCancel="CancelUnsavedChangesDialog" />

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter] public SharedCompanyDocumentDetailResponse? Document { get; set; }

    private List<CompanyDocumentCategoryItem> _categories = [];
    private SfDropDownList<Guid?, ReviewOwnerOption> _reviewOwnerDropdown = default!;
    private List<ReviewOwnerOption> _reviewOwnerOptions = [];

    // Category is rendered once _categories has actually loaded rather than immediately with an
    // empty DataSource — Blazor renders this dialog as soon as it becomes visible, before the
    // await below completes, so an ungated dropdown would briefly look interactive but have
    // nothing to show in its popup.
    private bool _dataLoaded;

    private static readonly List<ReviewFrequencyOption> _reviewFrequencyOptions =
    [
        new("None", "None"),
        new("Monthly", "Monthly"),
        new("Quarterly", "Quarterly"),
        new("SixMonthly", "Six Monthly"),
        new("Yearly", "Yearly"),
        new("Custom", "Custom"),
    ];

    protected override async Task OnOpenedAsync()
    {
        GlobalError = null;
        _dataLoaded = false;
        _categories = (await DocumentService.ListCompanyDocumentCategoriesAsync(CompanyId))?.Items.ToList() ?? [];

        // A first page (browsable without typing anything) — same pattern as
        // EmployeeEmploymentTab's manager picker. The rest of the company is reached by typing,
        // see OnReviewOwnerFilteringAsync, so this page doesn't need to be exhaustive.
        _reviewOwnerOptions = ((await EmployeeService.ListSelectableEmployeesAsync(CompanyId, pageSize: 50))?.Items ?? [])
            .Select(e => new ReviewOwnerOption(e.Id, $"{e.FirstName} {e.LastName}"))
            .ToList();

        Model.ReviewOwnerEmployeeId = Guid.Empty;

        if (Document is not null)
        {
            Model.Title = Document.Title;
            Model.Description = Document.Description;
            Model.CategoryId = Document.CategoryId;
            Model.EffectiveDate = Document.EffectiveDate;
            Model.ReviewDate = Document.ReviewDate;
            Model.ReviewFrequency = Document.ReviewFrequency;
            Model.CustomReviewFrequencyMonths = Document.CustomReviewFrequencyMonths;
            Model.ReviewOwnerEmployeeId = Document.ReviewOwnerEmployeeId ?? Guid.Empty;

            // The current review owner might not fall within the first page above — merge them in
            // explicitly so their name always renders rather than blank, same as the manager
            // picker's handling of employee.ManagerFullName.
            if (Document.ReviewOwnerEmployeeId is { } reviewOwnerId && _reviewOwnerOptions.All(o => o.Id != reviewOwnerId))
                _reviewOwnerOptions.Add(new ReviewOwnerOption(reviewOwnerId, Document.ReviewOwnerName ?? ""));
        }

        _reviewOwnerOptions = _reviewOwnerOptions.OrderBy(o => o.Name)
            .Prepend(new ReviewOwnerOption(Guid.Empty, "Not assigned"))
            .ToList();

        _dataLoaded = true;
    }

    // The review owner list can't be preloaded in one bounded page the way _categories is — a
    // company can have far more employees than any reasonable page size. Search server-side as
    // the user types instead, same pattern as EmployeeEmploymentTab's manager picker.
    private int _reviewOwnerFilterRequestId;

    // Requests aren't guaranteed to resolve in the order they were fired — applying every response
    // unconditionally means a late-arriving response for an earlier keystroke can land after the
    // user already picked a review owner from a later, faster response, visibly clearing their
    // selection. Only the most recently issued request's response is applied.
    private async Task OnReviewOwnerFilteringAsync(Syncfusion.Blazor.DropDowns.FilteringEventArgs args)
    {
        args.PreventDefaultAction = true;
        var requestId = ++_reviewOwnerFilterRequestId;
        var result = await EmployeeService.ListSelectableEmployeesAsync(CompanyId, search: args.Text, pageSize: 50);
        if (requestId != _reviewOwnerFilterRequestId) return;
        _reviewOwnerOptions = (result?.Items ?? [])
            .Select(e => new ReviewOwnerOption(e.Id, $"{e.FirstName} {e.LastName}"))
            .OrderBy(e => e.Name)
            .Prepend(new ReviewOwnerOption(Guid.Empty, "Not assigned"))
            .ToList();
        await _reviewOwnerDropdown.FilterAsync(_reviewOwnerOptions, new Query());
    }

    // Mirrors UploadSharedCompanyDocumentDialog's ValidateExtra hook — DataAnnotations can't
    // express "required only when another field has a certain value", so this cross-field check
    // lives here instead, giving immediate client-side feedback ahead of the matching
    // server-side rule in UpdateSharedCompanyDocumentMetadataValidator.
    protected override string? ValidateExtra() =>
        Model.ReviewFrequency != "None" && Model.ReviewDate is null
            ? "A next review date is required when a review frequency is set."
            : null;

    protected override async Task<string?> SaveCoreAsync()
    {
        if (Document is null)
            return "No document selected.";

        return await DocumentService.UpdateSharedCompanyDocumentMetadataAsync(
            CompanyId, Document.Id,
            Model.Title, Model.Description, Model.CategoryId!.Value,
            Model.EffectiveDate, Model.ReviewDate,
            Model.ReviewFrequency, Model.CustomReviewFrequencyMonths,
            Model.ReviewOwnerEmployeeId == Guid.Empty ? null : Model.ReviewOwnerEmployeeId);
    }

    protected override void ResetForm()
    {
        Model.Title = string.Empty;
        Model.Description = null;
        Model.CategoryId = null;
        Model.EffectiveDate = null;
        Model.ReviewDate = null;
        Model.ReviewFrequency = "None";
        Model.CustomReviewFrequencyMonths = null;
        Model.ReviewOwnerEmployeeId = null;
    }

    public sealed record ReviewFrequencyOption(string Value, string Label);
    private sealed record ReviewOwnerOption(Guid Id, string Name);

    public sealed class EditSharedCompanyDocumentMetadataFormModel
    {
        [Required(ErrorMessage = "Title is required.")]
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        [Required(ErrorMessage = "Category is required.")]
        public Guid? CategoryId { get; set; }
        public DateOnly? EffectiveDate { get; set; }
        public DateOnly? ReviewDate { get; set; }
        public string ReviewFrequency { get; set; } = "None";
        public int? CustomReviewFrequencyMonths { get; set; }
        public Guid? ReviewOwnerEmployeeId { get; set; }
    }
}
