@page "/companies/{CompanyId:guid}/document-types"
@rendermode InteractiveServer
@inherits SearchPageBase<DocumentTypeListItemModel>
@inject DocumentTypeService DocumentTypeService
@inject AppSession Session

<PageTitle>Document Types</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Document Types</h1>
    <p class="text-muted mb-3">Define the categories of documents employees can be required to provide.</p>

    @if (IsLoading)
    {
        <HrLoadingIndicator Label="Loading document types…" />
    }
    else if (Error is not null)
    {
        <div class="alert alert-danger">@Error</div>
    }
    else
    {
        @if (ActionError is not null)
        {
            <div class="alert alert-danger alert-dismissible">
                @ActionError
                <button type="button" class="btn-close" @onclick="ClearActionError"></button>
            </div>
        }

        <HrGrid @ref="Grid"
                TValue="DocumentTypeListItemModel"
                DataSource="@Items"
                Toolbar="@GridToolbar"
                AllowFiltering="true">
            <GridEvents TValue="DocumentTypeListItemModel" OnToolbarClick="OnToolbarClick"
                        RowSelected="OnRowSelected" RowDeselected="OnRowDeselected" />
            <GridPageSettings PageSize="20" />
            <GridColumns>
                <GridColumn Field="@nameof(DocumentTypeListItemModel.Name)" HeaderText="Name" Width="220">
                    <Template>
                        @{
                            var row = (context as DocumentTypeListItemModel)!;
                            <a href="/companies/@CompanyId/document-types/@row.Id">@row.Name</a>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(DocumentTypeListItemModel.Description)" HeaderText="Description" Width="300" />
                <GridColumn Field="@nameof(DocumentTypeListItemModel.AllowEmployeeUpload)" HeaderText="Employee Upload" Width="160">
                    <Template>
                        @{
                            var row = (context as DocumentTypeListItemModel)!;
                            <span class="badge @(row.AllowEmployeeUpload ? "bg-success" : "bg-secondary")">
                                @(row.AllowEmployeeUpload ? "Yes" : "No")
                            </span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(DocumentTypeListItemModel.IsActive)" HeaderText="Status" Width="110">
                    <Template>
                        @{
                            var row = (context as DocumentTypeListItemModel)!;
                            <ActiveStatusBadge IsActive="row.IsActive" />
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </HrGrid>
    }
</div>

<HrConfirmDialog Visible="@(_deactivateTarget is not null)"
                 Title="Deactivate Document Type"
                 Message="@($"Are you sure you want to deactivate '{_deactivateTarget?.Name}'?")"
                 ConfirmText="Deactivate"
                 CancelText="Cancel"
                 Busy="_deactivating"
                 OnConfirmed="ConfirmDeactivateAsync"
                 OnCancelled="@(() => _deactivateTarget = null)" />

@code {
    private DocumentTypeListItemModel? _deactivateTarget;
    private bool _deactivating;

    protected override bool SupportsActiveFilter => true;

    protected override Task OnBeforeLoadAsync()
    {
        if (!Session.CanManageEmployees)
            Navigation.NavigateTo("/access-denied", replace: true);
        return Task.CompletedTask;
    }

    protected override void ConfigureToolbar()
    {
        AddToolbarAction(
            id:      "hr-deactivate",
            text:    "Deactivate",
            icon:    "fa-solid fa-circle-xmark",
            onClick: item =>
            {
                if (!item.IsActive) return Task.CompletedTask;
                _deactivateTarget = item;
                return Task.CompletedTask;
            },
            tooltip: "Deactivate selected document type");
    }

    protected override async Task<IReadOnlyList<DocumentTypeListItemModel>?> FetchItemsAsync(string? search)
    {
        var result = await DocumentTypeService.ListDocumentTypesAsync(CompanyId, ShowInactive);
        return result?.Items;
    }

    protected override string LoadErrorMessage => "Failed to load document types.";

    protected override string? GetAddUrl()  => $"/companies/{CompanyId}/document-types/new";
    protected override string? GetEditUrl(DocumentTypeListItemModel item) => $"/companies/{CompanyId}/document-types/{item.Id}";
    protected override string? GetViewUrl(DocumentTypeListItemModel item) => $"/companies/{CompanyId}/document-types/{item.Id}/view";

    private async Task ConfirmDeactivateAsync()
    {
        if (_deactivateTarget is null) return;
        _deactivating = true;
        await Deactivate(_deactivateTarget);
        _deactivating = false;
        _deactivateTarget = null;
    }

    private async Task Deactivate(DocumentTypeListItemModel item)
    {
        ClearActionError();
        var error = await DocumentTypeService.DeactivateAsync(CompanyId, item.Id);
        if (error is not null)
            SetActionError(error);
        else
            await LoadAsync();
    }
}
