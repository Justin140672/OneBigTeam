@using System.ComponentModel.DataAnnotations
@inject DocumentService DocumentService
@inherits EditDialogBase<UploadSharedCompanyDocumentDialog.UploadSharedCompanyDocumentFormModel>

<SfDialog @bind-Visible="Visible" IsModal="true" Width="640px" ShowCloseIcon="true">
    <DialogEvents Closed="HandleDialogClosed" />
    <DialogTemplates>
        <Header>Upload Document</Header>
        <Content>
            @if (!string.IsNullOrEmpty(GlobalError))
            {
                <div class="alert alert-danger alert-dismissible mb-3">
                    @GlobalError
                    <button type="button" class="btn-close" @onclick="@(() => GlobalError = null)"></button>
                </div>
            }
            <EditForm EditContext="EditContext">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Title <span class="text-danger">*</span></label>
                        <HrTextBox @bind-Value="Model.Title" Placeholder="Document title" />
                        <ValidationMessage For="@(() => Model.Title)" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Category <span class="text-danger">*</span></label>
                        @if (_dataLoaded)
                        {
                            <SfDropDownList TValue="Guid?"
                                            TItem="CompanyDocumentCategoryItem"
                                            DataSource="@_categories"
                                            @bind-Value="Model.CategoryId"
                                            Placeholder="Select category…"
                                            AllowFiltering="true">
                                <DropDownListFieldSettings Value="Id" Text="Name" />
                            </SfDropDownList>
                        }
                        else
                        {
                            <HrLoadingIndicator Label="Loading categories…" />
                        }
                        <ValidationMessage For="@(() => Model.CategoryId)" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <HrTextBox @bind-Value="Model.Description"
                                   Placeholder="Optional description"
                                   Multiline="true" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Effective Date</label>
                        <SfDatePicker TValue="DateOnly?"
                                      @bind-Value="Model.EffectiveDate"
                                      Format="dd/MM/yyyy"
                                      Placeholder="dd/mm/yyyy"
                                      ShowClearButton="true" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">
                            Next Review Date
                            @if (Model.ReviewFrequency != "None")
                            {
                                <span class="text-danger">*</span>
                            }
                        </label>
                        <SfDatePicker TValue="DateOnly?"
                                      @bind-Value="Model.ReviewDate"
                                      Format="dd/MM/yyyy"
                                      Placeholder="dd/mm/yyyy"
                                      ShowClearButton="true" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Review Frequency</label>
                        <SfDropDownList TValue="string"
                                        TItem="ReviewFrequencyOption"
                                        DataSource="@_reviewFrequencyOptions"
                                        @bind-Value="Model.ReviewFrequency">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                    @if (Model.ReviewFrequency == "Custom")
                    {
                        <div class="col-md-6">
                            <label class="form-label">Custom Frequency (months)</label>
                            <SfNumericTextBox TValue="int?" @bind-Value="Model.CustomReviewFrequencyMonths"
                                              Min="1" Placeholder="e.g. 6" ShowSpinButton="false" />
                        </div>
                    }
                    <div class="col-12">
                        <label class="form-label">File <span class="text-danger">*</span></label>
                        <InputFile class="form-control" OnChange="OnFileSelected"
                                   accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
                        <div class="form-text">PDF, Word, or image files up to 20 MB.</div>
                    </div>
                    <div class="col-12">
                        <hr class="my-1" />
                        <label class="form-label mb-1">Audience</label>
                        <div class="form-text mt-0 mb-2">
                            Leave everything below empty for "All Employees". Otherwise, an employee can see
                            this document if they match at least one department, location, position, or are
                            individually selected.
                        </div>
                    </div>
                    @if (_dataLoaded)
                    {
                        <div class="col-md-6">
                            <label class="form-label">Departments</label>
                            <SfMultiSelect TValue="List<Guid>"
                                           TItem="DepartmentListItemModel"
                                           DataSource="@_departments"
                                           @bind-Value="Model.AudienceDepartmentIds"
                                           Placeholder="Any department"
                                           Mode="VisualMode.CheckBox"
                                           AllowFiltering="true">
                                <MultiSelectFieldSettings Value="Id" Text="Name" />
                            </SfMultiSelect>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Locations</label>
                            <SfMultiSelect TValue="List<Guid>"
                                           TItem="LocationListItemModel"
                                           DataSource="@_locations"
                                           @bind-Value="Model.AudienceLocationIds"
                                           Placeholder="Any location"
                                           Mode="VisualMode.CheckBox"
                                           AllowFiltering="true">
                                <MultiSelectFieldSettings Value="Id" Text="Name" />
                            </SfMultiSelect>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Positions</label>
                            <SfMultiSelect TValue="List<Guid>"
                                           TItem="PositionProfileListItemModel"
                                           DataSource="@_positionProfiles"
                                           @bind-Value="Model.AudiencePositionProfileIds"
                                           Placeholder="Any position"
                                           Mode="VisualMode.CheckBox"
                                           AllowFiltering="true">
                                <MultiSelectFieldSettings Value="Id" Text="Title" />
                            </SfMultiSelect>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Selected Employees</label>
                            <SfMultiSelect TValue="List<Guid>"
                                           TItem="EmployeeOption"
                                           DataSource="@_employees"
                                           @bind-Value="Model.AudienceEmployeeIds"
                                           Placeholder="No individually selected employees"
                                           Mode="VisualMode.CheckBox"
                                           AllowFiltering="true">
                                <MultiSelectFieldSettings Value="Id" Text="Name" />
                            </SfMultiSelect>
                        </div>
                    }
                    else
                    {
                        <div class="col-12">
                            <HrLoadingIndicator Label="Loading audience options…" />
                        </div>
                    }
                    <div class="col-12">
                        <hr class="my-1" />
                        <SfCheckBox TChecked="bool"
                                    Label="Requires employee acknowledgement"
                                    Checked="@Model.RequiresAcknowledgement"
                                    CheckedChanged="@((bool v) => Model.RequiresAcknowledgement = v)" />
                    </div>
                    @if (Model.RequiresAcknowledgement)
                    {
                        <div class="col-md-6">
                            <label class="form-label">Acknowledgement Due Date</label>
                            <SfDatePicker TValue="DateOnly?"
                                          @bind-Value="Model.AcknowledgementDueDate"
                                          Format="dd/MM/yyyy"
                                          Placeholder="dd/mm/yyyy"
                                          ShowClearButton="true" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Acknowledgement Statement</label>
                            <HrTextBox @bind-Value="Model.AcknowledgementStatement"
                                       Placeholder="@AcknowledgementStatementPlaceholder"
                                       Multiline="true" />
                            <div class="form-text">
                                Optional — shown to employees before they acknowledge. If left blank, they'll see:
                                "@AcknowledgementStatementPlaceholder"
                            </div>
                        </div>
                    }
                </div>
            </EditForm>
        </Content>
        <FooterTemplate>
            <HrDialogButtonBar SaveLabel="Upload" Saving="Saving" OnSave="SubmitAsync" OnCancel="CancelAsync" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Inject] public DepartmentService DepartmentService { get; set; } = null!;
    [Inject] public LocationService LocationService { get; set; } = null!;
    [Inject] public PositionProfileService PositionProfileService { get; set; } = null!;
    [Inject] public EmployeeService EmployeeService { get; set; } = null!;

    [Parameter, EditorRequired] public Guid CompanyId { get; set; }

    private List<CompanyDocumentCategoryItem> _categories = [];
    private List<DepartmentListItemModel> _departments = [];
    private List<LocationListItemModel> _locations = [];
    private List<PositionProfileListItemModel> _positionProfiles = [];
    private List<EmployeeOption> _employees = [];
    private IBrowserFile? _selectedFile;

    // OnOpenedAsync below awaits five HTTP calls sequentially with no intermediate
    // StateHasChanged, so Blazor renders this dialog once as soon as it becomes visible, while
    // every one of these lists is still its empty default, and only re-renders with real data
    // once the whole method finishes. Gating Category and the SfMultiSelect audience fields
    // behind this flag avoids two problems from that empty first render: Category would look
    // interactive but have nothing to show in its popup, and SfMultiSelect (unlike
    // SfDropDownList) can hit a JS interop "tracked object disposed" error if its DataSource is
    // reassigned from an empty list to a populated one shortly after its first render.
    private bool _dataLoaded;

    private static readonly List<ReviewFrequencyOption> _reviewFrequencyOptions =
    [
        new("None", "None"),
        new("Monthly", "Monthly"),
        new("Quarterly", "Quarterly"),
        new("SixMonthly", "Six Monthly"),
        new("Yearly", "Yearly"),
        new("Custom", "Custom"),
    ];

    protected override async Task OnOpenedAsync()
    {
        GlobalError = null;
        _selectedFile = null;
        _dataLoaded = false;

        // These five calls are independent of each other, so they're fired concurrently rather
        // than awaited one at a time — halves the time _dataLoaded stays false versus the
        // previous sequential-await version, shrinking the window where Category and the
        // audience SfMultiSelect fields are stuck showing their loading placeholder.
        var categoriesTask       = DocumentService.ListCompanyDocumentCategoriesAsync(CompanyId);
        var departmentsTask      = DepartmentService.ListDepartmentsAsync(CompanyId);
        var locationsTask        = LocationService.ListLocationsAsync(CompanyId);
        var positionProfilesTask = PositionProfileService.ListPositionProfilesAsync(CompanyId);
        var employeesTask        = EmployeeService.ListEmployeesAsync(CompanyId, pageSize: 500);

        await Task.WhenAll(categoriesTask, departmentsTask, locationsTask, positionProfilesTask, employeesTask);

        _categories       = categoriesTask.Result?.Items.ToList() ?? [];
        _departments       = departmentsTask.Result?.Items ?? [];
        _locations         = locationsTask.Result?.Items ?? [];
        _positionProfiles  = positionProfilesTask.Result?.Items.ToList() ?? [];
        _employees          = employeesTask.Result?.Items.Select(e => new EmployeeOption(e.Id, $"{e.FirstName} {e.LastName}")).ToList() ?? [];

        _dataLoaded = true;
    }

    private const string AcknowledgementStatementPlaceholder = "I confirm that I have read and understood this document.";

    private void OnFileSelected(InputFileChangeEventArgs e) => _selectedFile = e.File;

    // A due date isn't required here — acknowledgement settings only need to be complete by the
    // time the document is published (enforced server-side by PublishSharedCompanyDocument), so
    // HR can upload first and fill in the due date later via the Acknowledgement edit dialog.
    protected override string? ValidateExtra()
    {
        if (_selectedFile is null) return "Please select a file.";
        if (Model.ReviewFrequency != "None" && Model.ReviewDate is null)
            return "A next review date is required when a review frequency is set.";
        return null;
    }

    protected override async Task<string?> SaveCoreAsync() =>
        await DocumentService.UploadSharedCompanyDocumentAsync(
            CompanyId,
            Model.Title, Model.Description, Model.CategoryId!.Value,
            Model.EffectiveDate, Model.ReviewDate,
            Model.AudienceDepartmentIds, Model.AudienceLocationIds,
            Model.AudiencePositionProfileIds, Model.AudienceEmployeeIds,
            Model.RequiresAcknowledgement,
            Model.AcknowledgementDueDate, Model.AcknowledgementStatement,
            _selectedFile!,
            Model.ReviewFrequency, Model.CustomReviewFrequencyMonths);

    protected override void ResetForm()
    {
        Model.Title = string.Empty;
        Model.Description = null;
        Model.CategoryId = null;
        Model.EffectiveDate = null;
        Model.ReviewDate = null;
        Model.AudienceDepartmentIds = [];
        Model.AudienceLocationIds = [];
        Model.AudiencePositionProfileIds = [];
        Model.AudienceEmployeeIds = [];
        Model.RequiresAcknowledgement = false;
        Model.AcknowledgementDueDate = null;
        Model.AcknowledgementStatement = null;
        Model.ReviewFrequency = "None";
        Model.CustomReviewFrequencyMonths = null;
        _selectedFile = null;
    }

    public sealed record EmployeeOption(Guid Id, string Name);

    public sealed record ReviewFrequencyOption(string Value, string Label);

    public sealed class UploadSharedCompanyDocumentFormModel
    {
        [Required(ErrorMessage = "Title is required.")]
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        [Required(ErrorMessage = "Category is required.")]
        public Guid? CategoryId { get; set; }
        public DateOnly? EffectiveDate { get; set; }
        public DateOnly? ReviewDate { get; set; }
        public string ReviewFrequency { get; set; } = "None";
        public int? CustomReviewFrequencyMonths { get; set; }
        public List<Guid> AudienceDepartmentIds { get; set; } = [];
        public List<Guid> AudienceLocationIds { get; set; } = [];
        public List<Guid> AudiencePositionProfileIds { get; set; } = [];
        public List<Guid> AudienceEmployeeIds { get; set; } = [];
        public bool RequiresAcknowledgement { get; set; }
        public DateOnly? AcknowledgementDueDate { get; set; }
        public string? AcknowledgementStatement { get; set; }
    }
}
