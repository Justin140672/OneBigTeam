@inject DocumentService DocumentService
@inject NavigationManager Navigation
@inject AppSession Session

@if (Session.CanManageEmployees)
{
    @if (_loading)
    {
        <div class="widget-card">
            <div class="widget-header">
                <i class="fa-solid fa-file-shield widget-icon"></i>
                <span class="widget-title">Document Compliance</span>
            </div>
            <div class="widget-body d-flex align-items-center gap-2 py-3 px-3">
                <HrLoadingIndicator />
            </div>
        </div>
    }
    else
    {
        <div class="widget-card">
            <div class="widget-header">
                <i class="fa-solid fa-file-shield widget-icon"></i>
                <span class="widget-title">Document Compliance</span>
                @if (_items.Count > 0)
                {
                    <span class="widget-count-badge">@_items.Count</span>
                }
            </div>

            @if (_expired > 0 || _expiringSoon > 0)
            {
                <div class="widget-stats">
                    @if (_expired > 0)
                    {
                        <div class="widget-stat widget-stat--danger">
                            <i class="fa-solid fa-triangle-exclamation fa-xs"></i>
                            <span class="widget-stat-value">@_expired</span>
                            <span class="widget-stat-label">expired</span>
                        </div>
                    }
                    @if (_expiringSoon > 0)
                    {
                        <div class="widget-stat">
                            <span class="widget-stat-value">@_expiringSoon</span>
                            <span class="widget-stat-label">expiring soon</span>
                        </div>
                    }
                </div>
            }

            <div class="widget-body">
                @if (_items.Count == 0)
                {
                    <div class="widget-empty">
                        <i class="fa-solid fa-circle-check fa-lg mb-2"></i>
                        <p class="mb-0">No expiring documents</p>
                    </div>
                }
                else
                {
                    @foreach (var item in _items.Take(5))
                    {
                        var doc = item;
                        var (dueLabel, dueCss) = StatusBadge(doc.ExpiryStatus, doc.ExpiryDate);
                        var name = EmployeeName(doc.EmployeeId);
                        var url  = $"/companies/{Session.CompanyId}/employees/{doc.EmployeeId}?tab=documents";
                        <div @key="doc.EmployeeDocumentId" class="task-widget-item"
                             @onclick="() => Navigation.NavigateTo(url)">
                            <span class="priority-pip priority-pip--@(doc.ExpiryStatus == DocumentExpiryStatus.Expired ? "critical" : "medium")"></span>
                            <div class="task-widget-content">
                                <span class="task-widget-title">@name</span>
                                <span class="task-widget-meta">@doc.DocumentTypeName — @doc.Title</span>
                            </div>
                            <span class="due-badge due-badge--@dueCss">@dueLabel</span>
                        </div>
                    }
                }
            </div>
        </div>
    }
}

@code {
    private bool _loading = true;
    private IReadOnlyList<ExpiringDocumentItem> _items = [];
    private IReadOnlyDictionary<Guid, string> _employeeNames = new Dictionary<Guid, string>();
    private int _expired;
    private int _expiringSoon;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.CanManageEmployees)
        {
            _loading = false;
            return;
        }

        var docsTask = DocumentService.GetExpiringDocumentsAsync(Session.CompanyId);
        var employeesTask = Session.GetEmployeeNamesAsync();

        await Task.WhenAll(docsTask, employeesTask);

        _items = (await docsTask)?.Items ?? [];
        _employeeNames = await employeesTask;

        _expired = _items.Count(d => d.ExpiryStatus == DocumentExpiryStatus.Expired);
        _expiringSoon = _items.Count(d => d.ExpiryStatus == DocumentExpiryStatus.ExpiringSoon);
        _loading = false;
    }

    private string EmployeeName(Guid employeeId) =>
        _employeeNames.TryGetValue(employeeId, out var name) ? name : "Employee";

    private static (string Label, string Css) StatusBadge(DocumentExpiryStatus status, DateOnly expiryDate) => status switch
    {
        DocumentExpiryStatus.Expired => ("Expired", "overdue"),
        DocumentExpiryStatus.ExpiringSoon => (expiryDate.ToString("d MMM"), "soon"),
        _ => (expiryDate.ToString("d MMM"), "normal"),
    };
}
