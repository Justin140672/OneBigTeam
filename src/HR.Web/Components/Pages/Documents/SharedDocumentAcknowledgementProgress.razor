@page "/companies/{CompanyId:guid}/shared-documents/{DocumentId:guid}/acknowledgement-progress"
@rendermode InteractiveServer
@inject DocumentService DocumentService
@inject AppSession Session
@inject NavigationManager Navigation

<PageTitle>@(_progress?.DocumentTitle ?? "Acknowledgement Progress")</PageTitle>

<div class="container-fluid py-4">
    <a href="/companies/@CompanyId/shared-documents/@DocumentId" class="text-decoration-none text-muted small">← @(_progress?.DocumentTitle ?? "Document")</a>
    <h1 class="mb-1">Acknowledgement Progress</h1>
    <p class="text-muted mb-4">@_progress?.DocumentTitle</p>

    @if (_loading)
    {
        <HrLoadingIndicator Label="Loading acknowledgement progress…" />
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else if (_progress is not null)
    {
        <div class="row g-3 mb-4">
            <div class="col-md-2 col-sm-4 col-6">
                <div class="overview-card text-center py-3">
                    <div class="fs-4 fw-semibold">@_progress.TotalAssigned</div>
                    <div class="text-muted small">Total Assigned</div>
                </div>
            </div>
            <div class="col-md-2 col-sm-4 col-6">
                <div class="overview-card text-center py-3">
                    <div class="fs-4 fw-semibold text-success">@_progress.AcknowledgedCount</div>
                    <div class="text-muted small">Acknowledged</div>
                </div>
            </div>
            <div class="col-md-2 col-sm-4 col-6">
                <div class="overview-card text-center py-3">
                    <div class="fs-4 fw-semibold text-warning">@_progress.OutstandingCount</div>
                    <div class="text-muted small">Outstanding</div>
                </div>
            </div>
            <div class="col-md-2 col-sm-4 col-6">
                <div class="overview-card text-center py-3">
                    <div class="fs-4 fw-semibold text-danger">@_progress.OverdueCount</div>
                    <div class="text-muted small">Overdue</div>
                </div>
            </div>
            <div class="col-md-4 col-sm-8 col-12">
                <div class="overview-card py-3 px-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small">Acknowledgement Rate</span>
                        <span class="fw-semibold">@(_progress.AcknowledgementPercentage)%</span>
                    </div>
                    <div class="progress">
                        <div class="progress-bar" role="progressbar" style="width: @(_progress.AcknowledgementPercentage)%"></div>
                    </div>
                </div>
            </div>
        </div>

        @if (_progress.Items.Count == 0)
        {
            <p class="text-muted">No employees to show.</p>
        }
        else
        {
            <div class="d-flex justify-content-end gap-2 mb-2">
                <SfButton CssClass="e-small e-outline" OnClick="@(() => _grid!.ExportToExcelAsync())">
                    <i class="fa-solid fa-file-excel me-1"></i> Export to Excel
                </SfButton>
                <SfButton CssClass="e-small e-outline" OnClick="@(() => _grid!.ExportToCsvAsync())">
                    <i class="fa-solid fa-file-csv me-1"></i> Export to CSV
                </SfButton>
                <SfButton CssClass="e-small e-outline" OnClick="@(() => _grid!.ExportToPdfAsync())">
                    <i class="fa-solid fa-file-pdf me-1"></i> Export to PDF
                </SfButton>
            </div>

            <HrGrid @ref="_grid" TValue="SharedCompanyDocumentAcknowledgementProgressItem" DataSource="@_progress.Items" AllowPaging="true" AllowSorting="true">
                <GridPageSettings PageSize="20" />
                <GridColumns>
                    <GridColumn Field="@nameof(SharedCompanyDocumentAcknowledgementProgressItem.EmployeeName)" HeaderText="Employee" Width="180" />
                    <GridColumn Field="@nameof(SharedCompanyDocumentAcknowledgementProgressItem.DepartmentName)" HeaderText="Department" Width="150" />
                    <GridColumn Field="@nameof(SharedCompanyDocumentAcknowledgementProgressItem.ManagerName)" HeaderText="Manager" Width="150" />
                    <GridColumn Field="@nameof(SharedCompanyDocumentAcknowledgementProgressItem.LocationName)" HeaderText="Location" Width="150" />
                    <GridColumn Field="@nameof(SharedCompanyDocumentAcknowledgementProgressItem.Status)" HeaderText="Status" Width="120">
                        <Template>
                            @{
                                var row = (context as SharedCompanyDocumentAcknowledgementProgressItem)!;
                                <span class="badge @StatusBadgeClass(row.Status)">@row.Status</span>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(SharedCompanyDocumentAcknowledgementProgressItem.VersionNumber)" HeaderText="Version" Width="90">
                        <Template>
                            @{
                                var row = (context as SharedCompanyDocumentAcknowledgementProgressItem)!;
                                @(row.VersionNumber is { } v ? $"v{v}" : "—")
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(SharedCompanyDocumentAcknowledgementProgressItem.DueDate)" HeaderText="Due Date" Width="120" Format="d" />
                    <GridColumn Field="@nameof(SharedCompanyDocumentAcknowledgementProgressItem.AcknowledgedAt)" HeaderText="Acknowledged Date" Width="160" Format="g" />
                    <GridColumn HeaderText="" Width="90" AllowSorting="false" AllowFiltering="false" TextAlign="TextAlign.Right">
                        <Template>
                            @{
                                var row = (context as SharedCompanyDocumentAcknowledgementProgressItem)!;
                            }
                            @if (row.AcknowledgedAt is not null)
                            {
                                <SfButton CssClass="e-outline e-small" title="View statement" OnClick="() => HandleViewStatement(row)">
                                    <i class="fa-solid fa-eye"></i>
                                </SfButton>
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
            </HrGrid>
        }
    }
</div>

<SfDialog Visible="_statementDialogOpen" IsModal="true" Width="600px" ShowCloseIcon="true">
    <DialogEvents Closed="@(() => _statementDialogOpen = false)" />
    <DialogTemplates>
        <Header>Acknowledgement Statement</Header>
        <Content>
            @if (_selectedItem is not null)
            {
                <dl class="row mb-3">
                    <dt class="col-sm-3 text-muted fw-normal">Employee</dt>
                    <dd class="col-sm-9">@_selectedItem.EmployeeName</dd>

                    <dt class="col-sm-3 text-muted fw-normal">Document Version</dt>
                    <dd class="col-sm-9">@(_selectedItem.VersionNumber is { } v ? $"v{v}" : "—")</dd>

                    <dt class="col-sm-3 text-muted fw-normal">Acknowledged Date</dt>
                    <dd class="col-sm-9">@(_selectedItem.AcknowledgedAt?.ToString("d MMM yyyy HH:mm") ?? "—")</dd>
                </dl>

                <label class="form-label text-muted small">Statement (read-only)</label>
                <div class="border rounded p-2 bg-light" style="white-space: pre-wrap;" data-testid="acknowledgement-statement-text">
                    @(string.IsNullOrWhiteSpace(_selectedItem.AcknowledgementStatement) ? "No statement was recorded." : _selectedItem.AcknowledgementStatement)
                </div>
            }
        </Content>
        <FooterTemplate>
            <SfButton OnClick="@(() => _statementDialogOpen = false)">Close</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid DocumentId { get; set; }

    private SharedCompanyDocumentAcknowledgementProgressResponse? _progress;
    private bool _loading = true;
    private string? _error;
    private HrGrid<SharedCompanyDocumentAcknowledgementProgressItem>? _grid;

    private bool _statementDialogOpen;
    private SharedCompanyDocumentAcknowledgementProgressItem? _selectedItem;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.CanManageSharedDocuments)
        {
            Navigation.NavigateTo("/access-denied", replace: true);
            return;
        }

        await LoadProgressAsync();
    }

    private async Task LoadProgressAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var result = await DocumentService.GetSharedCompanyDocumentAcknowledgementProgressAsync(CompanyId, DocumentId);

            if (result is null)
            {
                _error = "Failed to load acknowledgement progress.";
                return;
            }

            _error = null;
            _progress = result;
        }
        finally
        {
            _loading = false;
        }
    }

    private void HandleViewStatement(SharedCompanyDocumentAcknowledgementProgressItem item)
    {
        _selectedItem = item;
        _statementDialogOpen = true;
    }

    private static string StatusBadgeClass(string status) => status switch
    {
        "Acknowledged" => "bg-success",
        "Overdue"      => "bg-danger",
        _              => "bg-warning text-dark",
    };
}
