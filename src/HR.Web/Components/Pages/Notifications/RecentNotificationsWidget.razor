@inject NotificationService NotificationService
@inject AppSession Session

@if (_loading)
{
    <div class="widget-card">
        <div class="widget-header">
            <i class="fa-solid fa-bell widget-icon"></i>
            <span class="widget-title">Recent Notifications</span>
        </div>
        <div class="widget-body d-flex align-items-center gap-2 py-3 px-3">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span class="text-muted">Loading notifications…</span>
        </div>
    </div>
}
else
{
    <div class="widget-card">
        <div class="widget-header">
            <i class="fa-solid fa-bell widget-icon"></i>
            <span class="widget-title">Recent Notifications</span>
            @if (_unreadCount > 0)
            {
                <span class="widget-count-badge">@_unreadCount</span>
            }
        </div>

        <div class="widget-body">
            @if (_items.Count == 0)
            {
                <div class="widget-empty">
                    <i class="fa-solid fa-bell-slash fa-lg mb-2"></i>
                    <p class="mb-0">No notifications</p>
                </div>
            }
            else
            {
                @foreach (var n in _items)
                {
                    var notif = n;
                    var (icon, label) = TypeInfo(notif.Type);
                    <div class="notif-widget-item @(notif.IsRead ? "" : "notif-widget-item--unread")">
                        <div class="notif-widget-icon-wrap notif-type--@notif.Type.ToLowerInvariant()">
                            <i class="@icon"></i>
                        </div>
                        <div class="notif-widget-content">
                            <span class="notif-widget-title">@notif.Title</span>
                            <span class="notif-widget-meta">@label · @FormatTime(notif.CreatedAt)</span>
                        </div>
                        @if (!notif.IsRead)
                        {
                            <span class="notif-widget-dot"></span>
                        }
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private List<NotificationDto> _items = [];
    private int _unreadCount;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.EmployeeId.HasValue) return;

        var result = await NotificationService.GetAsync(Session.CompanyId);
        if (result is not null)
        {
            _items       = result.Items.Take(5).ToList();
            _unreadCount = result.UnreadCount;
        }

        _loading = false;
    }

    private static (string Icon, string Label) TypeInfo(string type) => type switch
    {
        "TaskDueSoon"  => ("fa-solid fa-clock",               "Due soon"),
        "TaskOverdue"  => ("fa-solid fa-triangle-exclamation", "Overdue"),
        "TaskCompleted"=> ("fa-solid fa-circle-check",         "Completed"),
        "LeaveApproved"=> ("fa-solid fa-circle-check",         "Leave approved"),
        "LeaveRejected"=> ("fa-solid fa-circle-xmark",         "Leave rejected"),
        _              => ("fa-solid fa-bell",                  "Notification"),
    };

    private static string FormatTime(DateTimeOffset dt)
    {
        var diff = DateTimeOffset.UtcNow - dt;
        if (diff.TotalMinutes < 1)  return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours   < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays    < 7)  return $"{(int)diff.TotalDays}d ago";
        return dt.ToString("d MMM");
    }
}
