@page "/companies/{CompanyId:guid}/leave-types"
@rendermode InteractiveServer
@inherits SearchPageBase<LeaveTypeListItemModel>
@inject LeaveTypeService LeaveTypeService
@inject AppSession Session

<PageTitle>Leave Types</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Leave Types</h1>
    <p class="text-muted mb-3">Define the types of leave employees can request, such as annual leave or sick leave.</p>

    @if (IsLoading)
    {
        <HrLoadingIndicator Label="Loading leave types…" />
    }
    else if (Error is not null)
    {
        <div class="alert alert-danger">@Error</div>
    }
    else
    {
        @if (ActionError is not null)
        {
            <div class="alert alert-danger alert-dismissible">
                @ActionError
                <button type="button" class="btn-close" @onclick="ClearActionError"></button>
            </div>
        }

        <HrGrid @ref="Grid"
                TValue="LeaveTypeListItemModel"
                DataSource="@Items"
                Toolbar="@GridToolbar"
                AllowFiltering="true">
            <GridEvents TValue="LeaveTypeListItemModel" OnToolbarClick="OnToolbarClick"
                        RowSelected="OnRowSelected" RowDeselected="OnRowDeselected" />
            <GridPageSettings PageSize="20" />
            <GridColumns>
                <GridColumn Field="@nameof(LeaveTypeListItemModel.Name)" HeaderText="Name" Width="200">
                    <Template>
                        @{
                            var row = (context as LeaveTypeListItemModel)!;
                            <a href="/companies/@CompanyId/leave-types/@row.Id">@row.Name</a>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(LeaveTypeListItemModel.Code)" HeaderText="Code" Width="100" />
                <GridColumn Field="@nameof(LeaveTypeListItemModel.DefaultEntitlementDays)" HeaderText="Days" Width="80" />
                <GridColumn Field="@nameof(LeaveTypeListItemModel.AccrualMethod)" HeaderText="Accrual" Width="120" />
                <GridColumn Field="@nameof(LeaveTypeListItemModel.Behaviour)" HeaderText="Behaviour" Width="130" />
                <GridColumn Field="@nameof(LeaveTypeListItemModel.HasBalance)" HeaderText="Tracks Balance" Width="130">
                    <Template>
                        @{
                            var row = (context as LeaveTypeListItemModel)!;
                        }
                        <span class="badge @(row.HasBalance ? "bg-success" : "bg-secondary")">
                            @(row.HasBalance ? "Yes" : "No")
                        </span>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(LeaveTypeListItemModel.IsActive)" HeaderText="Status" Width="100">
                    <Template>
                        @{
                            var row = (context as LeaveTypeListItemModel)!;
                            <ActiveStatusBadge IsActive="row.IsActive" />
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </HrGrid>
    }
</div>

<HrConfirmDialog Visible="@(_deactivateTarget is not null)"
                 Title="Deactivate Leave Type"
                 Message="@($"Are you sure you want to deactivate '{_deactivateTarget?.Name}'?")"
                 ConfirmText="Deactivate"
                 CancelText="Cancel"
                 Busy="_deactivating"
                 OnConfirmed="ConfirmDeactivateAsync"
                 OnCancelled="@(() => _deactivateTarget = null)" />

@code {
    private LeaveTypeListItemModel? _deactivateTarget;
    private bool _deactivating;

    protected override bool SupportsActiveFilter => true;

    protected override Task OnBeforeLoadAsync()
    {
        if (!Session.CanManageEmployees)
            Navigation.NavigateTo(Session.MyProfileUrl, replace: true);
        return Task.CompletedTask;
    }

    protected override void ConfigureToolbar()
    {
        AddToolbarAction(
            id:      "hr-deactivate",
            text:    "Deactivate",
            icon:    "fa-solid fa-circle-xmark",
            onClick: item =>
            {
                if (!item.IsActive) return Task.CompletedTask;
                // System leave types (e.g. Annual Leave — see LeaveType.IsSystem) can never be
                // deactivated; the backend rejects this too (DeactivateLeaveTypeHandler), but
                // short-circuit here so the confirm dialog never even opens for one (item 50).
                if (item.IsSystem)
                {
                    SetActionError($"'{item.Name}' is a system leave type and cannot be deactivated.");
                    return Task.CompletedTask;
                }
                _deactivateTarget = item;
                return Task.CompletedTask;
            },
            tooltip: "Deactivate selected leave type");
    }

    protected override async Task<IReadOnlyList<LeaveTypeListItemModel>?> FetchItemsAsync(string? search)
    {
        var result = await LeaveTypeService.ListLeaveTypesAsync(CompanyId, ShowInactive);
        return result?.Items;
    }

    protected override string LoadErrorMessage => "Failed to load leave types.";

    protected override string? GetAddUrl()  => $"/companies/{CompanyId}/leave-types/new";
    protected override string? GetEditUrl(LeaveTypeListItemModel item) => $"/companies/{CompanyId}/leave-types/{item.Id}";
    protected override string? GetViewUrl(LeaveTypeListItemModel item) => $"/companies/{CompanyId}/leave-types/{item.Id}/view";

    private async Task ConfirmDeactivateAsync()
    {
        if (_deactivateTarget is null) return;
        _deactivating = true;
        await Deactivate(_deactivateTarget);
        _deactivating = false;
        _deactivateTarget = null;
    }

    private async Task Deactivate(LeaveTypeListItemModel item)
    {
        ClearActionError();
        var error = await LeaveTypeService.DeactivateAsync(CompanyId, item.Id);
        if (error is not null)
            SetActionError(error);
        else
            await LoadAsync();
    }
}
