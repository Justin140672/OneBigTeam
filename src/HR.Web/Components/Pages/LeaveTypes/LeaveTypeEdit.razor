@page "/companies/{CompanyId:guid}/leave-types/new"
@page "/companies/{CompanyId:guid}/leave-types/{Id:guid}"
@page "/companies/{CompanyId:guid}/leave-types/{Id:guid}/view"
@rendermode InteractiveServer
@inject LeaveTypeService LeaveTypeService
@inherits EditPageBase<LeaveTypeEditModel, Guid>

<PageTitle>@PageTitle</PageTitle>

<div class="container py-4">
    <SfBreadcrumb Class="mb-3">
        <BreadcrumbItems>
            <BreadcrumbItem Text="Administration" Url="@($"/companies/{CompanyId}/administration")" />
            <BreadcrumbItem Text="Leave Types" Url="@($"/companies/{CompanyId}/leave-types")" />
            <BreadcrumbItem Text="@PageTitle" />
        </BreadcrumbItems>
    </SfBreadcrumb>

    @if (IsLoading)
    {
        <HrLoadingIndicator />
    }
    else
    {
        <h1 class="mb-1">@PageTitle</h1>
        <p class="text-muted mb-4">Set the code, default entitlement, and behaviour for this leave type.</p>

        @if (!string.IsNullOrEmpty(GlobalError))
        {
            <div class="alert alert-danger">@GlobalError</div>
        }

        <EditForm EditContext="EditContext">
            <DataAnnotationsValidator />
            <HrValidationSummary />
            <div class="row">
                <div class="col-lg-7">
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Leave Type Details</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="form-label">Name <span class="text-danger">*</span></label>
                                    <HrTextBox @bind-Value="Model.Name" Placeholder="e.g. Annual Leave" Enabled="@(!Model.IsSystem && !IsViewMode)"
                                               aria-invalid="@(HasFieldError(() => Model.Name) ? "true" : null)" />
                                    @if (Model.IsSystem)
                                    {
                                        <p class="text-muted small mb-0">This is a system leave type and cannot be renamed.</p>
                                    }
                                    <ValidationMessage For="@(() => Model.Name)" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Code <span class="text-danger">*</span></label>
                                    <HrTextBox @bind-Value="Model.Code" Placeholder="e.g. ANNUAL"
                                               aria-invalid="@(HasFieldError(() => Model.Code) ? "true" : null)" />
                                    <ValidationMessage For="@(() => Model.Code)" />
                                </div>
                                @if (IsAnnualLeave)
                                {
                                    <div class="col-md-4">
                                        <label class="form-label">Default Days <span class="text-danger">*</span></label>
                                        <SfNumericTextBox TValue="int" @bind-Value="Model.DefaultEntitlementDays"
                                                          Min="0" Step="1" ShowSpinButton="false" />
                                        <ValidationMessage For="@(() => Model.DefaultEntitlementDays)" />
                                    </div>
                                }
                                else
                                {
                                    <div class="col-md-4">
                                        <label class="form-label">Default Days</label>
                                        <p class="text-muted small mb-0">
                                            Only the Annual Leave type has a default entitlement — other leave types
                                            don't set one here.
                                        </p>
                                    </div>
                                }
                                <div class="col-md-4">
                                    <label class="form-label">Accrual Method <span class="text-danger">*</span></label>
                                    <SfDropDownList TValue="string" TItem="Option"
                                                   DataSource="@_accrualOptions"
                                                   @bind-Value="Model.AccrualMethod"
                                                   Placeholder="Select method">
                                        <DropDownListFieldSettings Value="Value" Text="Label" />
                                    </SfDropDownList>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Behaviour <span class="text-danger">*</span></label>
                                    <SfDropDownList TValue="string" TItem="Option"
                                                   DataSource="@_behaviourOptions"
                                                   @bind-Value="Model.Behaviour"
                                                   Placeholder="Select behaviour">
                                        <DropDownListFieldSettings Value="Value" Text="Label" />
                                    </SfDropDownList>
                                </div>
                                <div class="col-12">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="hasBalance"
                                               @bind="Model.HasBalance" disabled="@IsViewMode" />
                                        <label class="form-check-label" for="hasBalance">
                                            Tracks a balance (uncheck for leave types like Unpaid Leave that don't have an entitlement)
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-3 justify-content-end">
                        @if (!IsViewMode)
                        {
                            <SfButton IsPrimary="true" Disabled="@Saving" OnClick="SaveAsync">
                                @if (Saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                Save
                            </SfButton>
                        }
                        <SfButton OnClick="RequestClose" Disabled="@Saving">Close</SfButton>
                    </div>
                </div>
            </div>
        </EditForm>
    }

    <NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges" />

    <UnsavedChangesDialog Visible="ShowUnsavedChangesDialog"
                          OnSaveAndClose="ConfirmSaveAndCloseAsync"
                          OnDiscard="DiscardChangesAndClose"
                          OnCancel="CancelCloseDialog" />
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid? Id { get; set; }

    private string PageTitle => IsNew ? "Add Leave Type"
        : Model.Name.Trim().Length > 0 ? Model.Name
        : IsViewMode ? "View Leave Type" : "Edit Leave Type";

    private static readonly Option[] _accrualOptions =
    [
        new("None",        "None"),
        new("Monthly",     "Monthly"),
        new("Fortnightly", "Fortnightly"),
        new("Annual",      "Annual"),
    ];

    private static readonly Option[] _behaviourOptions =
    [
        new("Standard",  "Standard"),
        new("Sickness",  "Sickness"),
        new("Maternity", "Maternity"),
        new("Paternity", "Paternity"),
        new("Parental",  "Parental"),
        new("Unpaid",    "Unpaid"),
        new("Toil",      "Time Off in Lieu"),
    ];

    protected override IEditService<LeaveTypeEditModel, Guid> Service => LeaveTypeService;
    protected override Guid GetCompanyId() => CompanyId;
    protected override Guid? GetId() => Id;

    protected override string? ListUrl => $"/companies/{CompanyId}/leave-types";

    // Only the Annual Leave type record is allowed a default entitlement — keyed off the
    // IsSystem flag (see LeaveType.IsSystem / item 50) rather than matching Name, since Annual
    // Leave can no longer be renamed anyway and this is more robust than a name comparison. Any
    // other leave type's Default Days field is hidden in the form above and forced to 0 here
    // before saving, so a stale value can never be silently persisted for a non-system type. For
    // a brand-new (not-yet-saved) leave type, Model.IsSystem is always false — there is no way to
    // create a system leave type via this form.
    private bool IsAnnualLeave => Model.IsSystem;

    protected override async Task<string?> SaveCoreAsync()
    {
        if (!IsAnnualLeave)
            Model.DefaultEntitlementDays = 0;

        return await base.SaveCoreAsync();
    }

    private sealed record Option(string Value, string Label);

    private bool HasFieldError<T>(System.Linq.Expressions.Expression<Func<T>> accessor)
        => EditContext.GetValidationMessages(FieldIdentifier.Create(accessor)).Any();
}
