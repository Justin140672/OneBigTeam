@inject AssetService AssetService
@inject NavigationManager Navigation

@if (_loading)
{
    <div class="d-flex align-items-center gap-2">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span>Loading assets…</span>
    </div>
}
else
{
    <HrGrid TValue="EmployeeAssetItem"
            DataSource="@_assets"
            AllowFiltering="false"
            AllowPaging="false"
            AllowSorting="false"
            Toolbar="@_toolbar"
            data-testid="my-assets-grid">
        <GridEvents TValue="EmployeeAssetItem"
                    OnToolbarClick="OnToolbarClickAsync"
                    RowSelected="OnRowSelected"
                    RowDeselected="OnRowDeselected" />
        <GridColumns>
            <GridColumn HeaderText="Asset">
                <Template>
                    @{
                        var item = (EmployeeAssetItem)context;
                    }
                    <div>
                        <span class="fw-medium">@item.AssetNumber</span>
                        <span class="text-muted ms-2">@item.Name</span>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(EmployeeAssetItem.CategoryName)" HeaderText="Category" Width="180" />
            <GridColumn Field="@nameof(EmployeeAssetItem.AssignedAt)" HeaderText="Assigned" Width="140" Format="d" />
            <GridColumn HeaderText="Status" Width="160">
                <Template>
                    @{
                        var item = (EmployeeAssetItem)context;
                    }
                    @if (item.IsAcknowledged)
                    {
                        <span class="badge text-bg-success">Acknowledged</span>
                    }
                    else
                    {
                        <span class="badge text-bg-warning">Pending</span>
                    }
                </Template>
            </GridColumn>
        </GridColumns>
    </HrGrid>
}

@code {
    [Parameter, EditorRequired] public Guid CompanyId  { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId { get; set; }

    private List<EmployeeAssetItem> _assets = [];
    private bool _loading = true;
    private EmployeeAssetItem? _selected;

    private IEnumerable<object> _toolbar => new List<object>
    {
        new ItemModel { Id = "hr-view", Text = "View", PrefixIcon = "fa-solid fa-eye", TooltipText = "View asset details", Disabled = _selected is null }
    };

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = _assets.Count == 0;
        _assets = await AssetService.GetEmployeeAssignmentsAsync(CompanyId, EmployeeId) ?? [];
        _loading = false;
    }

    private void OnRowSelected(RowSelectEventArgs<EmployeeAssetItem> args)
    {
        _selected = args.Data;
        StateHasChanged();
    }

    private void OnRowDeselected(RowDeselectEventArgs<EmployeeAssetItem> args)
    {
        _selected = null;
        StateHasChanged();
    }

    private Task OnToolbarClickAsync(ClickEventArgs args)
    {
        if (args.Item.Id == "hr-view" && _selected is not null)
            Navigation.NavigateTo($"/companies/{CompanyId}/assets/{_selected.AssetId}/view");
        return Task.CompletedTask;
    }
}
