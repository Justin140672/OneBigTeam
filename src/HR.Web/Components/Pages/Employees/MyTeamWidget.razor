@inject EmployeeService EmployeeService
@inject AppSession Session
@inject NavigationManager Navigation

<RecordSicknessDialog CompanyId="Session.CompanyId"
                      EmployeeId="@(_sicknessTargetEmployeeId ?? Guid.Empty)"
                      IsOpen="_recordSicknessOpen"
                      OnSaved="OnSicknessRecordedAsync"
                      OnCancelled="@(() => _recordSicknessOpen = false)" />

@if (Session.IsManager)
{
    @if (_loading)
    {
        <div class="widget-card">
            <div class="widget-header">
                <i class="fa-solid fa-people-group widget-icon"></i>
                <span class="widget-title">My Team</span>
            </div>
            <div class="widget-body d-flex align-items-center gap-2 py-3 px-3">
                <HrLoadingIndicator Label="Loading team…" />
            </div>
        </div>
    }
    else
    {
        <div class="widget-card">
            <div class="widget-header">
                <i class="fa-solid fa-people-group widget-icon"></i>
                <span class="widget-title">My Team</span>
                @if (_items.Count > 0)
                {
                    <span class="widget-count-badge">@_items.Count</span>
                }
                <a href="@($"/companies/{Session.CompanyId}/my-team")" class="ms-auto small" data-testid="view-all-team-link">
                    View all team@(_items.Count > 8 ? $" ({_items.Count})" : "")
                </a>
            </div>

            <div class="team-widget-scope" role="group" aria-label="Team scope">
                <button type="button" class="e-btn e-small team-scope-btn @(!_includeIndirect ? "e-primary" : "")" aria-pressed="@(!_includeIndirect ? "true" : "false")" disabled="@_scopeSwitching" @onclick="@(() => SetScopeAsync(false))">Direct Reports</button>
                <button type="button" class="e-btn e-small team-scope-btn @(_includeIndirect ? "e-primary" : "")" aria-pressed="@(_includeIndirect ? "true" : "false")" disabled="@_scopeSwitching" @onclick="@(() => SetScopeAsync(true))">All Reports</button>
            </div>

            <div class="widget-body @(_scopeSwitching ? "team-widget-body--switching" : "")">
                @if (_items.Count == 0)
                {
                    <div class="widget-empty">
                        <i class="fa-solid fa-people-group fa-lg mb-2"></i>
                        <p class="mb-0">@(_includeIndirect ? "No one reports up to you." : "You have no direct reports.")</p>
                    </div>
                }
                else
                {
                    <div class="team-card-grid">
                        @foreach (var member in _items.Take(8))
                        {
                            var m = member;
                            <div @key="m.EmployeeId" class="team-card">
                                <div class="team-card-top-row">
                                    @if (AlertCounts is not null && AlertCounts.TryGetValue(m.EmployeeId, out var alertCount) && alertCount > 0)
                                    {
                                        <span class="team-card-alert-badge" title="@($"{alertCount} item(s) need attention")" aria-label="@($"{alertCount} item(s) need attention")">
                                            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> @alertCount
                                        </span>
                                    }
                                    else
                                    {
                                        <span></span>
                                    }
                                    <span class="team-card-status-group">
                                        @if (m.IsLeaving)
                                        {
                                            <span class="team-card-leaving-badge" data-testid="@($"team-card-leaving-badge-{m.EmployeeId}")">Leaving</span>
                                        }
                                        <span class="team-card-status team-card-status--@StatusCss(m.Status)">@StatusLabel(m.Status)</span>
                                    </span>
                                </div>
                                <a href="@($"/companies/{Session.CompanyId}/employees/{m.EmployeeId}/team-view")" class="team-card-profile-link">
                                    <ProfilePhotoAvatar PhotoUrl="@m.ProfilePhotoUrl" Initials="@Initials(m.FullName)" SizePx="48" />
                                    <span class="team-card-name" title="@m.FullName">@m.FullName</span>
                                </a>
                                <span class="team-card-title" title="@(m.JobTitle ?? "—")">@(m.JobTitle ?? "—")</span>
                                <div class="team-card-contact">
                                    @if (!string.IsNullOrEmpty(m.PhoneNumber))
                                    {
                                        <a href="tel:@m.PhoneNumber" title="@m.PhoneNumber" class="team-card-contact-link">
                                            <i class="fa-solid fa-phone"></i>
                                            <span class="team-card-contact-text">@m.PhoneNumber</span>
                                        </a>
                                    }
                                    <a href="mailto:@m.WorkEmail" title="@m.WorkEmail" class="team-card-contact-link">
                                        <i class="fa-solid fa-envelope"></i>
                                        <span class="team-card-contact-text">@m.WorkEmail</span>
                                    </a>
                                </div>
                                <div class="team-card-actions">
                                    <SfButton CssClass="e-small e-outline team-card-notify-btn" OnClick="@(() => OpenNotifySickness(m.EmployeeId))">Notify Sickness</SfButton>
                                    <SfButton CssClass="e-small e-outline"
                                              data-testid="@($"team-card-view-profile-{m.EmployeeId}")"
                                              OnClick="@(() => Navigation.NavigateTo($"/companies/{Session.CompanyId}/employees/{m.EmployeeId}/team-view"))">
                                        View profile
                                    </SfButton>
                                </div>
                            </div>
                        }
                    </div>
                    @if (_items.Count > 8)
                    {
                        <p class="text-muted small mt-2 mb-0">
                            Showing 8 of @_items.Count —
                            <a href="@($"/companies/{Session.CompanyId}/my-team")" data-testid="view-all-team-inline-link">view all team</a>
                        </p>
                    }
                }
            </div>
        </div>
    }
}

@code {
    [Parameter] public IReadOnlyDictionary<Guid, int>? AlertCounts { get; set; }

    private bool _loading = true;
    private bool _scopeSwitching;
    private bool _includeIndirect;
    private List<TeamMemberItem> _items = [];
    private bool _recordSicknessOpen;
    private Guid? _sicknessTargetEmployeeId;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsManager)
        {
            _loading = false;
            return;
        }

        await LoadTeamAsync();
        _loading = false;
    }

    private async Task LoadTeamAsync()
    {
        var result = await EmployeeService.GetMyTeamAsync(Session.CompanyId, _includeIndirect);
        _items = result?.Items.ToList() ?? [];
    }

    private async Task SetScopeAsync(bool includeIndirect)
    {
        if (_includeIndirect == includeIndirect) return;

        _includeIndirect = includeIndirect;

        _scopeSwitching = true;
        StateHasChanged();

        await LoadTeamAsync();
        _scopeSwitching = false;
    }

    private void OpenNotifySickness(Guid employeeId)
    {
        _sicknessTargetEmployeeId = employeeId;
        _recordSicknessOpen = true;
    }

    private async Task OnSicknessRecordedAsync()
    {
        _recordSicknessOpen = false;
        _sicknessTargetEmployeeId = null;
        await LoadTeamAsync();
    }

    private static string StatusCss(string status) => status switch
    {
        "Sick"    => "sick",
        "OnLeave" => "on-leave",
        _         => "at-work",
    };

    private static string StatusLabel(string status) => status switch
    {
        "Sick"    => "Sick",
        "OnLeave" => "On Leave",
        _         => "At Work",
    };

    private static string Initials(string fullName)
    {
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => (parts[0][..1] + parts[^1][..1]).ToUpperInvariant(),
        };
    }
}
