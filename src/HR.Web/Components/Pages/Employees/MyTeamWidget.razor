@inject EmployeeService EmployeeService
@inject AppSession Session

<RecordSicknessDialog CompanyId="Session.CompanyId"
                      EmployeeId="@(_sicknessTargetEmployeeId ?? Guid.Empty)"
                      IsOpen="_recordSicknessOpen"
                      OnSaved="OnSicknessRecordedAsync"
                      OnCancelled="@(() => _recordSicknessOpen = false)" />

@if (Session.IsManager)
{
    @if (_loading)
    {
        <div class="widget-card">
            <div class="widget-header">
                <i class="fa-solid fa-people-group widget-icon"></i>
                <span class="widget-title">My Team</span>
            </div>
            <div class="widget-body d-flex align-items-center gap-2 py-3 px-3">
                <HrLoadingIndicator Label="Loading team…" />
            </div>
        </div>
    }
    else
    {
        <div class="widget-card">
            <div class="widget-header">
                <i class="fa-solid fa-people-group widget-icon"></i>
                <span class="widget-title">My Team</span>
                @if (_items.Count > 0)
                {
                    <span class="widget-count-badge">@_items.Count</span>
                }
            </div>

            <div class="team-widget-scope" role="group" aria-label="Team scope">
                <SfButton CssClass="e-small" IsPrimary="@(!_includeIndirect)" Disabled="_scopeSwitching" OnClick="@(() => SetScopeAsync(false))">Direct Reports</SfButton>
                <SfButton CssClass="e-small" IsPrimary="@_includeIndirect" Disabled="_scopeSwitching" OnClick="@(() => SetScopeAsync(true))">All Reports</SfButton>
            </div>

            <div class="widget-body @(_scopeSwitching ? "team-widget-body--switching" : "")">
                @if (_items.Count == 0)
                {
                    <div class="widget-empty">
                        <i class="fa-solid fa-people-group fa-lg mb-2"></i>
                        <p class="mb-0">@(_includeIndirect ? "No one reports up to you." : "You have no direct reports.")</p>
                    </div>
                }
                else
                {
                    <div class="team-card-grid">
                        @foreach (var member in _items.Take(8))
                        {
                            var m = member;
                            <div @key="m.EmployeeId" class="team-card">
                                <span class="team-card-status team-card-status--@StatusCss(m.Status)">@StatusLabel(m.Status)</span>
                                <ProfilePhotoAvatar PhotoUrl="@m.ProfilePhotoUrl" Initials="@Initials(m.FullName)" SizePx="48" />
                                <span class="team-card-name" title="@m.FullName">@m.FullName</span>
                                <span class="team-card-title" title="@(m.JobTitle ?? "—")">@(m.JobTitle ?? "—")</span>
                                <div class="team-card-contact">
                                    @if (!string.IsNullOrEmpty(m.PhoneNumber))
                                    {
                                        <a href="tel:@m.PhoneNumber" title="@m.PhoneNumber" class="team-card-contact-link">
                                            <i class="fa-solid fa-phone"></i>
                                            <span class="team-card-contact-text">@m.PhoneNumber</span>
                                        </a>
                                    }
                                    <a href="mailto:@m.WorkEmail" title="@m.WorkEmail" class="team-card-contact-link">
                                        <i class="fa-solid fa-envelope"></i>
                                        <span class="team-card-contact-text">@m.WorkEmail</span>
                                    </a>
                                </div>
                                <SfButton CssClass="e-small e-outline team-card-notify-btn" OnClick="@(() => OpenNotifySickness(m.EmployeeId))">Notify Sickness</SfButton>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private bool _loading = true;
    private bool _scopeSwitching;
    private bool _includeIndirect;
    private List<TeamMemberItem> _items = [];
    private bool _recordSicknessOpen;
    private Guid? _sicknessTargetEmployeeId;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsManager)
        {
            _loading = false;
            return;
        }

        await LoadTeamAsync();
        _loading = false;
    }

    private async Task LoadTeamAsync()
    {
        var result = await EmployeeService.GetMyTeamAsync(Session.CompanyId, _includeIndirect);
        _items = result?.Items.ToList() ?? [];
    }

    private async Task SetScopeAsync(bool includeIndirect)
    {
        if (_includeIndirect == includeIndirect) return;

        _includeIndirect = includeIndirect;

        // Unlike the initial load, switching scope keeps the existing card grid visible (dimmed via
        // team-widget-body--switching) rather than swapping the whole widget out for a loading
        // spinner — that full remount/collapse was the source of the reported jumpy re-render.
        _scopeSwitching = true;
        StateHasChanged();

        await LoadTeamAsync();
        _scopeSwitching = false;
    }

    private void OpenNotifySickness(Guid employeeId)
    {
        _sicknessTargetEmployeeId = employeeId;
        _recordSicknessOpen = true;
    }

    private async Task OnSicknessRecordedAsync()
    {
        _recordSicknessOpen = false;
        _sicknessTargetEmployeeId = null;
        await LoadTeamAsync();
    }

    private static string StatusCss(string status) => status switch
    {
        "Sick"    => "sick",
        "OnLeave" => "on-leave",
        _         => "at-work",
    };

    private static string StatusLabel(string status) => status switch
    {
        "Sick"    => "Sick",
        "OnLeave" => "On Leave",
        _         => "At Work",
    };

    private static string Initials(string fullName)
    {
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => (parts[0][..1] + parts[^1][..1]).ToUpperInvariant(),
        };
    }
}
