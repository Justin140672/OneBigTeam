@inject EmployeeService EmployeeService
@inject AppSession Session

@if (Session.IsManager)
{
    @if (_loading)
    {
        <div class="widget-card">
            <div class="widget-header">
                <i class="fa-solid fa-people-group widget-icon"></i>
                <span class="widget-title">My Team</span>
            </div>
            <div class="widget-body d-flex align-items-center gap-2 py-3 px-3">
                <HrLoadingIndicator Label="Loading team…" />
            </div>
        </div>
    }
    else
    {
        <div class="widget-card">
            <div class="widget-header">
                <i class="fa-solid fa-people-group widget-icon"></i>
                <span class="widget-title">My Team</span>
                @if (_items.Count > 0)
                {
                    <span class="widget-count-badge">@_items.Count</span>
                }
            </div>

            <div class="team-widget-scope" role="group" aria-label="Team scope">
                <SfButton CssClass="e-small" IsPrimary="@(!_includeIndirect)" OnClick="@(() => SetScopeAsync(false))">Direct Reports</SfButton>
                <SfButton CssClass="e-small" IsPrimary="@_includeIndirect" OnClick="@(() => SetScopeAsync(true))">All Reports</SfButton>
            </div>

            <div class="widget-body">
                @if (_items.Count == 0)
                {
                    <div class="widget-empty">
                        <i class="fa-solid fa-people-group fa-lg mb-2"></i>
                        <p class="mb-0">@(_includeIndirect ? "No one reports up to you." : "You have no direct reports.")</p>
                    </div>
                }
                else
                {
                    <div class="team-card-grid">
                        @foreach (var member in _items.Take(8))
                        {
                            var m = member;
                            <div @key="m.EmployeeId" class="team-card">
                                <ProfilePhotoAvatar PhotoUrl="@m.ProfilePhotoUrl" Initials="@Initials(m.FullName)" SizePx="48" />
                                <span class="team-card-name" title="@m.FullName">@m.FullName</span>
                                <span class="team-card-title" title="@(m.JobTitle ?? "—")">@(m.JobTitle ?? "—")</span>
                                <div class="team-card-contact">
                                    @if (!string.IsNullOrEmpty(m.PhoneNumber))
                                    {
                                        <a href="tel:@m.PhoneNumber" title="@m.PhoneNumber" class="team-card-contact-link">
                                            <i class="fa-solid fa-phone"></i>
                                            <span class="team-card-contact-text">@m.PhoneNumber</span>
                                        </a>
                                    }
                                    <a href="mailto:@m.WorkEmail" title="@m.WorkEmail" class="team-card-contact-link">
                                        <i class="fa-solid fa-envelope"></i>
                                        <span class="team-card-contact-text">@m.WorkEmail</span>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private bool _loading = true;
    private bool _includeIndirect;
    private List<TeamMemberItem> _items = [];

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsManager)
        {
            _loading = false;
            return;
        }

        await LoadTeamAsync();
        _loading = false;
    }

    private async Task LoadTeamAsync()
    {
        var result = await EmployeeService.GetMyTeamAsync(Session.CompanyId, _includeIndirect);
        _items = result?.Items.ToList() ?? [];
    }

    private async Task SetScopeAsync(bool includeIndirect)
    {
        if (_includeIndirect == includeIndirect) return;

        _includeIndirect = includeIndirect;
        _loading = true;
        StateHasChanged();

        await LoadTeamAsync();
        _loading = false;
    }

    private static string Initials(string fullName)
    {
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => (parts[0][..1] + parts[^1][..1]).ToUpperInvariant(),
        };
    }
}
