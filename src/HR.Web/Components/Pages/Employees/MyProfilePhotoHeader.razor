@inject ProfilePhotoService ProfilePhotoService

<div class="photo-header-row">
    <ProfilePhotoAvatar PhotoUrl="@_photo?.CurrentPhoto?.DownloadUrl" Initials="@Initials" SizePx="72" />
    <div>
        <SfButton CssClass="e-small" OnClick="OpenUploadDialog" Disabled="@_loading">Change Photo</SfButton>

        @if (_photo?.PendingPhoto is not null)
        {
            <div class="alert alert-warning py-2 px-3 mt-2 mb-0 d-flex align-items-center gap-2 photo-alert">
                <img src="@_photo.PendingPhoto.DownloadUrl" alt="Pending photo" class="pending-photo-thumb" />
                <div class="flex-grow-1">
                    <div class="fw-semibold small">Pending approval</div>
                    <div class="small text-muted">Awaiting HR review</div>
                </div>
                <SfButton CssClass="e-small e-flat" Disabled="@_cancelling" OnClick="CancelPendingAsync">
                    @if (_cancelling)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    Cancel
                </SfButton>
            </div>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger py-1 px-2 mt-2 mb-0 small photo-alert">@_error</div>
        }
    </div>
</div>

<UploadProfilePhotoDialog IsOpen="_dialogOpen"
                           Title="Change Profile Photo"
                           UploadFunc="@((file, ct) => ProfilePhotoService.UploadMyProfilePhotoAsync(CompanyId, file, ct))"
                           OnSaved="HandleUploaded"
                           OnCancelled="CloseDialog" />

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId { get; set; }
    [Parameter, EditorRequired] public string Initials { get; set; } = "?";

    private GetMyProfilePhotoResponse? _photo;
    private bool _loading;
    private bool _cancelling;
    private bool _dialogOpen;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _photo = await ProfilePhotoService.GetMyProfilePhotoAsync(CompanyId);
        _loading = false;
    }

    private void OpenUploadDialog()
    {
        _error = null;
        _dialogOpen = true;
    }

    private void CloseDialog() => _dialogOpen = false;

    private async Task HandleUploaded()
    {
        _dialogOpen = false;
        await PollForPendingPhotoAsync();
    }

    // Same race as EmployeeProfilePhotoHeader.PollForCurrentPhotoAsync — the virus scan
    // (ScanUploadedFileJob) runs asynchronously via a background job queued during upload, and
    // GetMyProfilePhotoAsync only reports a pending photo once that scan comes back Clean (see
    // GetMyProfilePhotoHandler / ScanStatusAccessGuard.CheckDownloadable). A single fetch right
    // after upload can race it and see nothing, leaving this header showing no "Pending
    // approval" banner at all with nothing left to trigger a re-render once scanning finishes.
    // 20 attempts / 10s total (raised from 10/5s) — under a full E2E suite run, Hangfire's queue
    // can be busy enough with other tests' background jobs that the scan doesn't come back within
    // 5s, which surfaced as this banner silently never appearing.
    private async Task PollForPendingPhotoAsync()
    {
        for (var attempt = 0; attempt < 20; attempt++)
        {
            await LoadAsync();
            if (_photo?.PendingPhoto is not null)
                return;

            await Task.Delay(500);
        }
    }

    private async Task CancelPendingAsync()
    {
        _cancelling = true;
        _error = null;
        StateHasChanged();

        var success = await ProfilePhotoService.CancelPendingProfilePhotoAsync(CompanyId);
        if (!success)
            _error = "Failed to cancel the pending photo.";

        _cancelling = false;
        await LoadAsync();
    }
}
