@inject AppSession Session
@using HR.SharedKernel.Http
@inject ProfilePhotoService ProfilePhotoService
@implements IDisposable

<div class="d-flex align-items-start gap-3 mb-3">
    <ProfilePhotoAvatar PhotoUrl="@_currentPhotoUrl" Initials="@Initials" SizePx="72" />
    <div>
        <SfButton CssClass="e-small" OnClick="OpenUploadDialog" Disabled="@(_loading || Session.IsReadOnly)">Upload / Replace Photo</SfButton>

        @if (!string.IsNullOrEmpty(_uploadSuccessMsg))
        {
            <div class="alert alert-success py-1 px-2 mt-2 mb-0 small photo-header-alert">@_uploadSuccessMsg</div>
        }

        @if (_pending is not null)
        {
            <div class="alert alert-info py-2 px-3 mt-2 mb-0 photo-header-alert">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <img src="@_pending.DownloadUrl" alt="Pending photo" class="pending-photo-thumb" />
                    <div class="flex-grow-1">
                        <div class="fw-semibold small">Pending Review</div>
                        <div class="small text-muted">Submitted @_pending.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
                    </div>
                </div>

                @if (_showRejectReason)
                {
                    <HrTextBox @bind-Value="_rejectReason" Placeholder="Reason for rejection (optional)" CssClass="mb-2 w-100" />
                    <div class="d-flex gap-2">
                        <SfButton CssClass="e-small" IsPrimary="true" Disabled="@(_reviewing || Session.IsReadOnly)" OnClick="ConfirmRejectAsync">Confirm Reject</SfButton>
                        <SfButton CssClass="e-small e-flat" Disabled="@_reviewing" OnClick="@(() => _showRejectReason = false)">Back</SfButton>
                    </div>
                }
                else
                {
                    <div class="d-flex gap-2">
                        <SfButton CssClass="e-small" IsPrimary="true" Disabled="@(_reviewing || Session.IsReadOnly)" OnClick="ApproveAsync">
                            @if (_reviewing)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            Approve
                        </SfButton>
                        <SfButton CssClass="e-small" Disabled="@(_reviewing || Session.IsReadOnly)" OnClick="@(() => _showRejectReason = true)">Reject</SfButton>
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger py-1 px-2 mt-2 mb-0 small photo-header-alert">@_error</div>
        }
    </div>
</div>

<UploadProfilePhotoDialog IsOpen="_dialogOpen"
                           Title="Upload / Replace Profile Photo"
                           UploadFunc="@(async (file, ct) => ApiFailurePresenter.ErrorOrNull(
                               await ProfilePhotoService.UploadEmployeeProfilePhotoAsync(CompanyId, EmployeeId, file, ct),
                               "upload this photo"))"
                           OnSaved="HandleUploaded"
                           OnCancelled="CloseDialog" />

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId { get; set; }
    [Parameter, EditorRequired] public string Initials { get; set; } = "?";

    private GetPendingProfilePhotoResponse? _pending;

    private string? _currentPhotoUrl;

    private bool _loading;
    private bool _reviewing;
    private bool _dialogOpen;
    private bool _showRejectReason;
    private string? _rejectReason;
    private string? _error;
    private string? _uploadSuccessMsg;

    protected override async Task OnInitializedAsync()
    {
        await LoadPendingAsync();
        await LoadCurrentPhotoAsync();
    }

    private async Task LoadPendingAsync()
    {
        _loading = true;
        var result = await ProfilePhotoService.GetPendingProfilePhotoAsync(CompanyId, EmployeeId);
        if (result.Success)
            _pending = result.Value;
        else if (result.FailureKind == ApiFailureKind.NotFound)
            _pending = null; // no pending submission
        else
            _error = ApiFailurePresenter.Message(result, "load the pending photo");
        _loading = false;
    }

    // Returns false when the lookup itself failed (as opposed to "there is no photo yet").
    private async Task<bool> LoadCurrentPhotoAsync()
    {
        var current = await ProfilePhotoService.GetEmployeeProfilePhotoAsync(CompanyId, EmployeeId);
        if (current.Success)
        {
            _currentPhotoUrl = current.Value?.DownloadUrl;
            return true;
        }

        if (current.FailureKind == ApiFailureKind.NotFound)
        {
            _currentPhotoUrl = null;
            return true;
        }

        _error = ApiFailurePresenter.Message(current, "load the current photo");
        return false;
    }

    private void OpenUploadDialog()
    {
        _error = null;
        _uploadSuccessMsg = null;
        _dialogOpen = true;
    }

    private void CloseDialog() => _dialogOpen = false;

    private async Task HandleUploaded()
    {
        _dialogOpen = false;
        _uploadSuccessMsg = "Photo uploaded successfully.";
        await LoadPendingAsync();
        await PollForCurrentPhotoAsync();
    }

    private readonly CancellationTokenSource _disposeCts = new();

    private async Task PollForCurrentPhotoAsync()
    {
        var started = DateTime.UtcNow;
        try
        {
            while (!_disposeCts.IsCancellationRequested && DateTime.UtcNow - started < TimeSpan.FromMinutes(2))
            {
                if (!await LoadCurrentPhotoAsync() || _currentPhotoUrl is not null)
                    return;

                var delay = DateTime.UtcNow - started < TimeSpan.FromSeconds(20)
                    ? TimeSpan.FromMilliseconds(500)
                    : TimeSpan.FromSeconds(2);
                await Task.Delay(delay, _disposeCts.Token);
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
        }
    }

    public void Dispose()
    {
        _disposeCts.Cancel();
        _disposeCts.Dispose();
    }

    private async Task ApproveAsync()
    {
        _reviewing = true;
        _error = null;
        StateHasChanged();

        var error = ApiFailurePresenter.ErrorOrNull(
            await ProfilePhotoService.ApproveProfilePhotoAsync(CompanyId, EmployeeId), "approve this photo");
        if (error is not null)
            _error = error;

        _reviewing = false;
        await LoadPendingAsync();
        StateHasChanged();

        if (error is null)
            await PollForCurrentPhotoAsync();
    }

    private async Task ConfirmRejectAsync()
    {
        _reviewing = true;
        _error = null;
        StateHasChanged();

        var error = ApiFailurePresenter.ErrorOrNull(
            await ProfilePhotoService.RejectProfilePhotoAsync(CompanyId, EmployeeId, _rejectReason), "reject this photo");
        if (error is not null)
            _error = error;

        _reviewing = false;
        _showRejectReason = false;
        _rejectReason = null;
        await LoadPendingAsync();
    }
}
