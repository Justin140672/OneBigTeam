@inject DocumentService DocumentService

@if (!_requestsLoading && _requests.Count > 0)
{
    <div class="card mb-4" data-testid="admin-document-requests-section">
        <div class="card-header d-flex align-items-center">
            <h5 class="mb-0">Document Requests</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Document Type</th>
                        <th width="130">Due Date</th>
                        <th width="130">Status</th>
                        <th width="160">Requested By</th>
                        <th width="130">Requested Date</th>
                        <th width="100"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _requests)
                    {
                        var (css, label) = GetRequestBadge(r);
                        <tr>
                            <td class="align-middle">@r.DocumentTypeName</td>
                            <td class="align-middle text-muted small">
                                @(r.DueDate?.ToString("d MMM yyyy") ?? "—")
                            </td>
                            <td class="align-middle">
                                <span class="badge @css">@label</span>
                            </td>
                            <td class="align-middle text-muted small">
                                @(r.RequestedByName ?? "—")
                            </td>
                            <td class="align-middle text-muted small">
                                @r.CreatedAt.LocalDateTime.ToString("d MMM yyyy")
                            </td>
                            <td class="align-middle text-end">
                                @if (r.Status == "Requested" && EmployeeSelfUpload)
                                {
                                    <SfButton CssClass="e-primary e-small"
                                              OnClick="() => OpenUploadRequested(r)">
                                        <i class="fa-solid fa-upload me-1"></i> Upload
                                    </SfButton>
                                }
                                else if (r.Status == "Requested" && !EmployeeSelfUpload)
                                {
                                    @if (_cancelTargetId == r.Id)
                                    {
                                        <span class="me-2 text-muted small">Cancel?</span>
                                        <SfButton CssClass="e-danger e-small me-1"
                                                  OnClick="() => ConfirmCancelRequestAsync(r.Id)">
                                            Yes
                                        </SfButton>
                                        <SfButton CssClass="e-small" OnClick="ClearCancelTarget">No</SfButton>
                                    }
                                    else
                                    {
                                        <SfButton CssClass="e-outline e-small"
                                                  OnClick="() => _cancelTargetId = r.Id"
                                                  title="Cancel request">
                                            Cancel
                                        </SfButton>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (!EmployeeSelfUpload)
{
    <UploadDocumentDialog CompanyId="CompanyId"
                          EmployeeId="EmployeeId"
                          IsOpen="_uploadOpen"
                          EmployeeSelfUpload="false"
                          OnSaved="OnDocumentUploaded"
                          OnCancelled="@(() => _uploadOpen = false)" />

    <RequestDocumentDialog CompanyId="CompanyId"
                           EmployeeId="EmployeeId"
                           IsOpen="_requestOpen"
                           OnSaved="OnDocumentRequested"
                           OnCancelled="@(() => _requestOpen = false)" />
}
else
{
    <UploadRequestedDocumentDialog @ref="_uploadRequestedDialog"
                                   CompanyId="CompanyId"
                                   EmployeeId="EmployeeId"
                                   IsOpen="_uploadRequestedOpen"
                                   OnUploaded="OnRequestedDocumentUploaded"
                                   OnCancelled="@(() => _uploadRequestedOpen = false)" />
}

@if (_loading)
{
    <HrLoadingIndicator />
}
else
{
    <div class="card" data-testid="employee-documents-grid-section">
        <div class="card-header d-flex align-items-center">
            <h5 class="mb-0">Documents</h5>
            @if (!EmployeeSelfUpload)
            {
                <div class="ms-auto d-flex gap-2">
                    <SfButton CssClass="e-outline e-small" OnClick="@(() => _requestOpen = true)">
                        <i class="fa-solid fa-file-circle-plus me-1"></i> Request Document
                    </SfButton>
                    <SfButton CssClass="e-primary e-small" OnClick="@(() => _uploadOpen = true)">
                        <i class="fa-solid fa-upload me-1"></i> Upload
                    </SfButton>
                </div>
            }
        </div>
        <div class="card-body p-0">
            <HrGrid TValue="EmployeeDocumentListItem"
                    DataSource="@_documents"
                    AllowFiltering="false"
                    AllowPaging="false">
                <GridColumns>
                    <GridColumn Field="@nameof(EmployeeDocumentListItem.Title)"
                                HeaderText="Title" />
                    <GridColumn Field="@nameof(EmployeeDocumentListItem.DocumentTypeName)"
                                HeaderText="Type" Width="160" />
                    <GridColumn Field="@nameof(EmployeeDocumentListItem.IssueDate)"
                                HeaderText="Issue Date" Width="130">
                        <Template>
                            @{ var r = (context as EmployeeDocumentListItem)!; }
                            <span class="text-muted small">
                                @(r.IssueDate?.ToString("dd MMM yyyy") ?? "—")
                            </span>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(EmployeeDocumentListItem.ExpiryDate)"
                                HeaderText="Expiry Date" Width="130">
                        <Template>
                            @{ var r = (context as EmployeeDocumentListItem)!; }
                            <span class="text-muted small">
                                @(r.ExpiryDate?.ToString("dd MMM yyyy") ?? "—")
                            </span>
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="Status" Width="140" AllowSorting="false" AllowFiltering="false">
                        <Template>
                            @{ var r = (context as EmployeeDocumentListItem)!;
                               var (css, label) = GetStatusBadge(r); }
                            <span class="badge @css">@label</span>
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="" Width="220" AllowSorting="false" AllowFiltering="false"
                                TextAlign="TextAlign.Right">
                        <Template>
                            @{ var r = (context as EmployeeDocumentListItem)!; }
                            @if (!EmployeeSelfUpload && _deleteTargetId == r.EmployeeDocumentId)
                            {
                                <span class="me-2 text-muted small">Delete?</span>
                                <SfButton CssClass="e-danger e-small me-1"
                                          OnClick="() => ConfirmDeleteAsync(r.EmployeeDocumentId)">
                                    Yes
                                </SfButton>
                                <SfButton CssClass="e-small" OnClick="CancelDelete">No</SfButton>
                            }
                            else
                            {
                                <a class="e-btn e-outline e-small me-1"
                                   href="@DocumentService.GetEmployeeDocumentDownloadUrl(CompanyId, EmployeeId, r.EmployeeDocumentId)"
                                   target="_blank">
                                    Download
                                </a>
                                @if (!EmployeeSelfUpload)
                                {
                                    <SfButton CssClass="e-danger e-outline e-small"
                                              OnClick="() => StartDelete(r.EmployeeDocumentId)">
                                        Delete
                                    </SfButton>
                                }
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
            </HrGrid>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid CompanyId        { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId       { get; set; }
    [Parameter]                 public bool EmployeeSelfUpload { get; set; }

    private bool _loading = true;
    private bool _requestsLoading = true;
    private bool _uploadOpen;
    private bool _requestOpen;
    private List<EmployeeDocumentListItem>  _documents = [];
    private List<DocumentRequestListItem>   _requests  = [];

    private Guid? _deleteTargetId;
    private Guid? _cancelTargetId;

    private UploadRequestedDocumentDialog? _uploadRequestedDialog;
    private bool _uploadRequestedOpen;

    private void OpenUploadRequested(DocumentRequestListItem request)
    {
        // _uploadRequestedOpen also has to flip true here (not just the dialog's own
        // internal Open()) — the dialog's OnParametersSet force-closes itself whenever this
        // parent re-renders with IsOpen still false, which would otherwise immediately
        // undo the Open() call on the very next unrelated render.
        _uploadRequestedOpen = true;
        _uploadRequestedDialog?.Open(request);
    }

    private async Task OnRequestedDocumentUploaded()
    {
        _uploadRequestedOpen = false;
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading         = _documents.Count == 0;
        _requestsLoading = true;

        var docTask     = DocumentService.ListEmployeeDocumentsAsync(CompanyId, EmployeeId);
        var requestTask = DocumentService.ListDocumentRequestsAsync(CompanyId, EmployeeId);

        _documents       = (await docTask)?.Items.ToList()     ?? [];
        _requests        = (await requestTask)?.Items.ToList() ?? [];
        _loading         = false;
        _requestsLoading = false;
        StateHasChanged();
    }

    private async Task OnDocumentUploaded()
    {
        _uploadOpen = false;
        await LoadAsync();
    }

    private async Task OnDocumentRequested()
    {
        _requestOpen = false;
        await LoadAsync();
    }

    private void StartDelete(Guid id)   => _deleteTargetId = id;
    private void CancelDelete()         => _deleteTargetId = null;

    private void ClearCancelTarget()    => _cancelTargetId = null;

    private async Task ConfirmCancelRequestAsync(Guid id)
    {
        _cancelTargetId = null;
        await DocumentService.CancelDocumentRequestAsync(CompanyId, EmployeeId, id);
        await LoadAsync();
    }

    private async Task ConfirmDeleteAsync(Guid id)
    {
        _deleteTargetId = null;
        await DocumentService.DeleteEmployeeDocumentAsync(CompanyId, EmployeeId, id);
        await LoadAsync();
    }

    private static (string Css, string Label) GetRequestBadge(DocumentRequestListItem r)
    {
        if (r.Status == "Requested" && r.DueDate.HasValue && r.DueDate.Value < DateOnly.FromDateTime(DateTime.UtcNow))
            return ("text-bg-danger",    "Overdue");

        return r.Status switch
        {
            "Requested" => ("text-bg-warning",   "Requested"),
            "Uploaded"  => ("text-bg-success",   "Uploaded"),
            "Cancelled" => ("text-bg-secondary", "Cancelled"),
            "Expired"   => ("text-bg-danger",    "Expired"),
            _           => ("text-bg-secondary", r.Status),
        };
    }

    private static (string Css, string Label) GetStatusBadge(EmployeeDocumentListItem doc)
    {
        if (doc.ExpiryDate.HasValue)
        {
            var today = DateOnly.FromDateTime(DateTime.UtcNow);
            if (doc.ExpiryDate < today)
                return ("text-bg-danger",  "Expired");
            if (doc.ExpiryDate <= today.AddDays(30))
                return ("text-bg-warning", "Expiring Soon");
        }
        return doc.Status switch
        {
            "Archived" => ("text-bg-secondary", "Archived"),
            "Expired"  => ("text-bg-danger",    "Expired"),
            _          => ("text-bg-success",    "Active"),
        };
    }
}
