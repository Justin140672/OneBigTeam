@using System.ComponentModel.DataAnnotations
@inject DocumentService DocumentService
@inherits EditDialogBase<UploadDocumentDialog.UploadDocumentFormModel>

<SfDialog @bind-Visible="Visible" IsModal="true" Width="640px" ShowCloseIcon="true">
    <DialogEvents Closed="HandleDialogClosed" />
    <DialogTemplates>
        <Header>Upload Document</Header>
        <Content>
            @if (!string.IsNullOrEmpty(GlobalError))
            {
                <div class="alert alert-danger alert-dismissible mb-3">
                    @GlobalError
                    <button type="button" class="btn-close" @onclick="@(() => GlobalError = null)"></button>
                </div>
            }
            <EditForm EditContext="EditContext">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Title <span class="text-danger">*</span></label>
                        <HrTextBox @bind-Value="Model.Title" Placeholder="Document title" />
                        <ValidationMessage For="@(() => Model.Title)" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Document Type <span class="text-danger">*</span></label>
                        <SfDropDownList TValue="Guid?"
                                        TItem="DocumentTypeItem"
                                        DataSource="@_documentTypes"
                                        @bind-Value="Model.DocumentTypeId"
                                        Placeholder="Select type…"
                                        AllowFiltering="true">
                            <DropDownListFieldSettings Value="Id" Text="Name" />
                        </SfDropDownList>
                        <ValidationMessage For="@(() => Model.DocumentTypeId)" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <HrTextBox @bind-Value="Model.Description"
                                   Placeholder="Optional description"
                                   Multiline="true" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Issue Date</label>
                        <SfDatePicker TValue="DateOnly?"
                                      @bind-Value="Model.IssueDate"
                                      Format="dd/MM/yyyy"
                                      Placeholder="dd/mm/yyyy"
                                      ShowClearButton="true" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Expiry Date</label>
                        <SfDatePicker TValue="DateOnly?"
                                      @bind-Value="Model.ExpiryDate"
                                      Format="dd/MM/yyyy"
                                      Placeholder="dd/mm/yyyy"
                                      ShowClearButton="true" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">File <span class="text-danger">*</span></label>
                        <InputFile class="form-control" OnChange="OnFileSelected"
                                   accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
                    </div>
                </div>
            </EditForm>
        </Content>
        <FooterTemplate>
            <HrDialogButtonBar SaveLabel="Upload" Saving="Saving" OnSave="SubmitAsync" OnCancel="CancelAsync" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter, EditorRequired] public Guid CompanyId        { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId       { get; set; }
    [Parameter]                 public bool EmployeeSelfUpload { get; set; }

    private List<DocumentTypeItem> _documentTypes = [];
    private IBrowserFile? _selectedFile;

    protected override async Task OnOpenedAsync()
    {
        _selectedFile = null;
        _documentTypes = (await DocumentService.ListDocumentTypesAsync(CompanyId, employeeUploadOnly: EmployeeSelfUpload))?.Items.ToList() ?? [];
    }

    private void OnFileSelected(InputFileChangeEventArgs e) => _selectedFile = e.File;

    protected override string? ValidateExtra() =>
        _selectedFile is null ? "Please select a file." : null;

    protected override async Task<string?> SaveCoreAsync() =>
        await DocumentService.UploadEmployeeDocumentAsync(
            CompanyId, EmployeeId,
            Model.Title, Model.Description, Model.DocumentTypeId!.Value,
            Model.IssueDate, Model.ExpiryDate,
            _selectedFile!);

    protected override void ResetForm()
    {
        Model.Title = string.Empty;
        Model.Description = null;
        Model.DocumentTypeId = null;
        Model.IssueDate = null;
        Model.ExpiryDate = null;
        _selectedFile = null;
    }

    public sealed class UploadDocumentFormModel
    {
        [Required(ErrorMessage = "Title is required.")]
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        [Required(ErrorMessage = "Document type is required.")]
        public Guid? DocumentTypeId { get; set; }
        public DateOnly? IssueDate { get; set; }
        public DateOnly? ExpiryDate { get; set; }
    }
}
