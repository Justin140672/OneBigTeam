@using System.ComponentModel.DataAnnotations
@inject EmployeeService EmployeeService
@inject AppSession Session

@if (!Session.EmployeeId.HasValue || Session.EmployeeId.Value != EmployeeId)
{
    <div class="alert alert-danger">
        <i class="fa-solid fa-lock me-2"></i>You can only view your own emergency contacts.
    </div>
}
else if (_loading)
{
    <HrLoadingIndicator />
}
else
{
    @if (_saved)
    {
        <div class="ec-success-banner mb-3">
            <i class="fa-solid fa-circle-check ec-success-icon"></i>
            <div>
                <div class="ec-success-title">Emergency contacts saved</div>
                <div class="ec-success-body">Your emergency contacts have been updated.</div>
            </div>
            <button class="ec-success-dismiss" @onclick="@(() => _saved = false)">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    @if (_error is not null)
    {
        <div class="alert alert-danger alert-dismissible mb-3">
            @_error
            <button type="button" class="btn-close" @onclick="@(() => _error = null)"></button>
        </div>
    }

    <div class="ec-card">
        <div class="ec-card-header">
            <i class="fa-solid fa-person-circle-exclamation ec-card-icon"></i>
            <span class="ec-card-title">Emergency Contacts</span>
            @if (!_showAddForm && _editingId is null)
            {
                <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="StartAdd">
                    <i class="fa-solid fa-plus me-1"></i>Add Contact
                </button>
            }
        </div>

        <div class="ec-form-body">
            @if (_contacts.Count == 0 && !_showAddForm)
            {
                <div class="ec-empty">
                    <i class="fa-solid fa-address-book ec-empty-icon"></i>
                    <p class="ec-empty-text">No emergency contacts added yet.</p>
                    <button class="btn btn-outline-primary btn-sm" @onclick="StartAdd">Add your first contact</button>
                </div>
            }

            @foreach (var contact in _contacts)
            {
                var c = contact;
                @if (_editingId == c.Id)
                {
                    <EditForm EditContext="_editContext">
                        <DataAnnotationsValidator />
                        <div class="ec-contact-form">
                            <div class="ec-section-label">Edit Contact</div>
                            <div class="ec-field-row">
                                <div class="ec-field-group">
                                    <label class="ec-label">Name <span class="ec-required">*</span></label>
                                    <input class="form-control" @bind="_form.Name" placeholder="Full name" maxlength="200" />
                                    <ValidationMessage For="@(() => _form.Name)" />
                                </div>
                                <div class="ec-field-group">
                                    <label class="ec-label">Relationship <span class="ec-required">*</span></label>
                                    <input class="form-control" @bind="_form.Relationship" placeholder="e.g. Spouse, Parent, Sibling" maxlength="100" />
                                    <ValidationMessage For="@(() => _form.Relationship)" />
                                </div>
                            </div>
                            <div class="ec-field-row">
                                <div class="ec-field-group">
                                    <label class="ec-label">Phone Number <span class="ec-required">*</span></label>
                                    <input class="form-control" type="tel" @bind="_form.PhoneNumber" placeholder="e.g. 07700 900000" maxlength="30" />
                                    <ValidationMessage For="@(() => _form.PhoneNumber)" />
                                </div>
                                <div class="ec-field-group">
                                    <label class="ec-label">Email</label>
                                    <input class="form-control" type="email" @bind="_form.Email" placeholder="e.g. name@example.com" maxlength="320" />
                                    <ValidationMessage For="@(() => _form.Email)" />
                                </div>
                            </div>
                            <div class="ec-form-actions">
                                <SfButton IsPrimary="true" Disabled="@_saving" OnClick="@(() => SaveEditAsync(c.Id))">
                                    @if (_saving) { <span class="spinner-border spinner-border-sm me-1" role="status"></span> }
                                    Save
                                </SfButton>
                                <SfButton OnClick="CancelEdit" Disabled="@_saving">Cancel</SfButton>
                            </div>
                        </div>
                    </EditForm>
                }
                else
                {
                    <div class="ec-contact-card">
                        <div class="ec-contact-info">
                            <div class="ec-contact-name">@c.Name</div>
                            <div class="ec-contact-meta">
                                <span class="ec-contact-relationship">@c.Relationship</span>
                                <span class="ec-contact-phone"><i class="fa-solid fa-phone me-1"></i>@c.PhoneNumber</span>
                                @if (c.Email is not null)
                                {
                                    <span class="ec-contact-email"><i class="fa-solid fa-envelope me-1"></i>@c.Email</span>
                                }
                            </div>
                        </div>
                        <div class="ec-contact-actions">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => StartEdit(c))" title="Edit">
                                <i class="fa-solid fa-pen"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="@(() => RemoveAsync(c.Id))" title="Remove">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </div>
                }
            }

        </div>
    </div>

    <SfDialog @bind-Visible="_showAddForm" IsModal="true" Width="480px" ShowCloseIcon="true">
        <DialogEvents Closed="CancelAdd" />
        <DialogTemplates>
            <Header>New Contact</Header>
            <Content>
                <EditForm EditContext="_editContext">
                    <DataAnnotationsValidator />
                    <div class="ec-field-row">
                        <div class="ec-field-group">
                            <label class="ec-label">Name <span class="ec-required">*</span></label>
                            <input class="form-control" @bind="_form.Name" placeholder="Full name" maxlength="200" />
                            <ValidationMessage For="@(() => _form.Name)" />
                        </div>
                        <div class="ec-field-group">
                            <label class="ec-label">Relationship <span class="ec-required">*</span></label>
                            <input class="form-control" @bind="_form.Relationship" placeholder="e.g. Spouse, Parent, Sibling" maxlength="100" />
                            <ValidationMessage For="@(() => _form.Relationship)" />
                        </div>
                    </div>
                    <div class="ec-field-row">
                        <div class="ec-field-group">
                            <label class="ec-label">Phone Number <span class="ec-required">*</span></label>
                            <input class="form-control" type="tel" @bind="_form.PhoneNumber" placeholder="e.g. 07700 900000" maxlength="30" />
                            <ValidationMessage For="@(() => _form.PhoneNumber)" />
                        </div>
                        <div class="ec-field-group">
                            <label class="ec-label">Email</label>
                            <input class="form-control" type="email" @bind="_form.Email" placeholder="e.g. name@example.com" maxlength="320" />
                            <ValidationMessage For="@(() => _form.Email)" />
                        </div>
                    </div>
                </EditForm>
            </Content>
            <FooterTemplate>
                <SfButton IsPrimary="true" Disabled="@_saving" OnClick="SaveAddAsync">
                    @if (_saving) { <span class="spinner-border spinner-border-sm me-1" role="status"></span> }
                    Add Contact
                </SfButton>
                <SfButton OnClick="CancelAdd" Disabled="@_saving">Cancel</SfButton>
            </FooterTemplate>
        </DialogTemplates>
    </SfDialog>
}

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId { get; set; }

    private bool _loading = true;
    private bool _saving;
    private bool _saved;
    private string? _error;

    private List<EmergencyContactItem> _contacts = [];

    private bool _showAddForm;
    private Guid? _editingId;

    // Shared by both the inline "add" and "edit" forms — only one is ever visible at a time.
    private readonly EmergencyContactFormModel _form = new();
    private EditContext _editContext = default!;

    protected override async Task OnParametersSetAsync()
    {
        if (!Session.EmployeeId.HasValue || Session.EmployeeId.Value != EmployeeId)
        {
            _loading = false;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await EmployeeService.GetMyEmergencyContactsAsync(CompanyId);
        _contacts = result?.Contacts ?? [];
        _loading = false;
    }

    private void ResetForm()
    {
        _form.Name = string.Empty;
        _form.Relationship = string.Empty;
        _form.PhoneNumber = string.Empty;
        _form.Email = null;
        _form.TelephoneRegexPattern = Session.TelephoneRegex;
        _form.MobileRegexPattern = Session.MobileRegex;
        _editContext = new EditContext(_form);
    }

    private void StartAdd()
    {
        _showAddForm = true;
        _editingId = null;
        ResetForm();
        _error = null;
    }

    private void CancelAdd()
    {
        _showAddForm = false;
    }

    private void StartEdit(EmergencyContactItem c)
    {
        _editingId = c.Id;
        _showAddForm = false;
        _form.Name = c.Name;
        _form.Relationship = c.Relationship;
        _form.PhoneNumber = c.PhoneNumber;
        _form.Email = c.Email;
        _form.TelephoneRegexPattern = Session.TelephoneRegex;
        _form.MobileRegexPattern = Session.MobileRegex;
        _editContext = new EditContext(_form);
        _error = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
    }

    private async Task SaveAddAsync()
    {
        if (!_editContext.Validate()) return;

        _saving = true;
        _error  = null;

        var request = new AddEmergencyContactRequest(
            CompanyId,
            _form.Name.Trim(),
            _form.Relationship.Trim(),
            _form.PhoneNumber.Trim(),
            string.IsNullOrWhiteSpace(_form.Email) ? null : _form.Email.Trim());

        var (contact, error) = await EmployeeService.AddMyEmergencyContactAsync(CompanyId, request);
        _saving = false;

        if (contact is null)
        {
            _error = error ?? "Failed to add emergency contact.";
            return;
        }

        _showAddForm = false;
        _saved       = true;
        await LoadAsync();
    }

    private async Task SaveEditAsync(Guid contactId)
    {
        if (!_editContext.Validate()) return;

        _saving = true;
        _error  = null;

        var request = new UpdateEmergencyContactRequest(
            CompanyId,
            contactId,
            _form.Name.Trim(),
            _form.Relationship.Trim(),
            _form.PhoneNumber.Trim(),
            string.IsNullOrWhiteSpace(_form.Email) ? null : _form.Email.Trim());

        var (success, error) = await EmployeeService.UpdateMyEmergencyContactAsync(CompanyId, request);
        _saving = false;

        if (!success)
        {
            _error = error ?? "Failed to update emergency contact.";
            return;
        }

        _editingId = null;
        _saved     = true;
        await LoadAsync();
    }

    private async Task RemoveAsync(Guid contactId)
    {
        _saving = true;
        _error  = null;

        var (success, error) = await EmployeeService.RemoveMyEmergencyContactAsync(CompanyId, contactId);
        _saving = false;

        if (!success)
        {
            _error = error ?? "Failed to remove emergency contact.";
            return;
        }

        _contacts.RemoveAll(c => c.Id == contactId);
    }

    public sealed class EmergencyContactFormModel
    {
        [Required(ErrorMessage = "Name is required.")]
        public string Name { get; set; } = string.Empty;
        [Required(ErrorMessage = "Relationship is required.")]
        public string Relationship { get; set; } = string.Empty;
        [Required(ErrorMessage = "Phone number is required.")]
        [DynamicRegex(nameof(MobileRegexPattern), nameof(TelephoneRegexPattern), ErrorMessage = "Enter a valid phone number.")]
        public string PhoneNumber { get; set; } = string.Empty;
        [EmailAddress(ErrorMessage = "Email must be a valid email address.")]
        public string? Email { get; set; }

        public string? TelephoneRegexPattern { get; set; }
        public string? MobileRegexPattern { get; set; }
    }
}
