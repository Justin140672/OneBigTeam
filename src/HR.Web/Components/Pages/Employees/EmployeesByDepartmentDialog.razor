@inject EmployeeService EmployeeService

<SfDialog Visible="Visible" IsModal="true" Width="720px" ShowCloseIcon="true" CssClass="employees-by-department-dialog">
    <DialogEvents Closed="HandleDialogClosed" />
    <DialogTemplates>
        <Header>@(string.IsNullOrEmpty(DepartmentName) ? "Employees" : DepartmentName)</Header>
        <Content>
            @if (_loading)
            {
                <HrLoadingIndicator Label="Loading employees…" />
            }
            else if (_employees.Count == 0)
            {
                <p class="text-muted mb-0">No employees found in this department.</p>
            }
            else
            {
                <HrGrid TValue="EmployeeListItemModel"
                        DataSource="@_employees"
                        AllowPaging="false"
                        AllowFiltering="false">
                    <GridColumns>
                        <GridColumn HeaderText="Name" Width="200">
                            <Template>
                                @{
                                    var row = (EmployeeListItemModel)context;
                                }
                                <a href="/companies/@CompanyId/employees/@row.Id">@row.FirstName @row.LastName</a>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(EmployeeListItemModel.WorkEmail)" HeaderText="Work Email" Width="220" />
                        <GridColumn Field="@nameof(EmployeeListItemModel.PositionProfileTitle)" HeaderText="Position" Width="180" />
                        <GridColumn Field="@nameof(EmployeeListItemModel.Status)" HeaderText="Status" Width="120" />
                    </GridColumns>
                </HrGrid>
            }
            <div class="mt-3">
                <a href="/companies/@CompanyId/employees">View all employees</a>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Close" OnClick="HandleDialogClosed" />
    </DialogButtons>
</SfDialog>

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter] public Guid? DepartmentId { get; set; }
    [Parameter] public string DepartmentName { get; set; } = "";
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private bool Visible;
    private bool _loading;
    private List<EmployeeListItemModel> _employees = [];
    private Guid? _loadedDepartmentId;
    private bool _loadedForUnassigned;

    protected override async Task OnParametersSetAsync()
    {
        Visible = IsOpen;

        var isUnassigned = DepartmentId is null;
        if (IsOpen && (DepartmentId != _loadedDepartmentId || isUnassigned != _loadedForUnassigned))
        {
            _loadedDepartmentId = DepartmentId;
            _loadedForUnassigned = isUnassigned;
            _loading = true;
            var result = await EmployeeService.ListEmployeesAsync(CompanyId, departmentId: DepartmentId, pageSize: 100);
            _employees = result?.Items ?? [];
            _loading = false;
        }
    }

    private async Task HandleDialogClosed()
    {
        Visible = false;
        await OnClosed.InvokeAsync();
    }
}
