@inject EmployeeService EmployeeService
@inject AppSession Session

@if (Session.CanReadEmployees)
{
    <div class="widget-card chart-tile">
        <div class="widget-header">
            <i class="fa-solid fa-arrow-trend-up widget-icon"></i>
            <span class="widget-title">New Hires (Last 6 Months)</span>
        </div>

        <div class="widget-body">
            @if (_loading)
            {
                <HrLoadingIndicator Label="Loading trend…" />
            }
            else if (_data.Count == 0)
            {
                <div class="widget-empty">
                    <i class="fa-solid fa-chart-line fa-lg mb-2"></i>
                    <p class="mb-0">No hires in the last 6 months</p>
                </div>
            }
            else
            {
                <SfChart Title="" Height="280px" Background="transparent">
                    <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category">
                        <ChartAxisLabelStyle FontFamily="Inter, Helvetica Neue, Helvetica, Arial, sans-serif"></ChartAxisLabelStyle>
                    </ChartPrimaryXAxis>
                    <ChartPrimaryYAxis Minimum="0">
                        <ChartAxisLabelStyle FontFamily="Inter, Helvetica Neue, Helvetica, Arial, sans-serif"></ChartAxisLabelStyle>
                    </ChartPrimaryYAxis>
                    <ChartTooltipSettings Enable="true"></ChartTooltipSettings>
                    <ChartSeriesCollection>
                        <ChartSeries DataSource="@_data"
                                     XName="@nameof(TrendPoint.MonthLabel)"
                                     YName="@nameof(TrendPoint.NewHireCount)"
                                     Type="ChartSeriesType.Column"
                                     Fill="#0f766e">
                        </ChartSeries>
                    </ChartSeriesCollection>
                </SfChart>

                @* DSH-07: text alternative for the Syncfusion column chart (SVG has no accessible data). *@
                <details class="chart-data-table">
                    <summary>View new-hire trend as a table</summary>
                    <div class="dashboard-scroll-x">
                        <table>
                            <caption>New hires by month (last 6 months)</caption>
                            <thead>
                                <tr><th scope="col">Month</th><th scope="col">New hires</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var point in _data)
                                {
                                    <tr><td>@point.MonthLabel</td><td>@point.NewHireCount</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private List<TrendPoint> _data = [];

    protected override async Task OnInitializedAsync()
    {
        if (!Session.CanReadEmployees)
        {
            _loading = false;
            return;
        }

        var result = await EmployeeService.GetNewHiresTrendAsync(Session.CompanyId);
        _data = (result?.Items ?? [])
            .Select(i => new TrendPoint(i.MonthLabel, i.NewHireCount))
            .ToList();

        _loading = false;
    }

    private sealed record TrendPoint(string MonthLabel, int NewHireCount);
}
