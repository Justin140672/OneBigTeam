@inject EmployeeService EmployeeService
@inject AppSession Session

@if (Session.CanReadEmployees)
{
    <div class="widget-card chart-tile">
        <div class="widget-header">
            <i class="fa-solid fa-arrow-trend-up widget-icon"></i>
            <span class="widget-title">New Hires (Last 6 Months)</span>
        </div>

        <div class="widget-body">
            @if (_loading)
            {
                <HrLoadingIndicator Label="Loading trend…" />
            }
            else if (_data.Count == 0)
            {
                <div class="widget-empty">
                    <i class="fa-solid fa-chart-line fa-lg mb-2"></i>
                    <p class="mb-0">No hires in the last 6 months</p>
                </div>
            }
            else
            {
                <div role="img" aria-label="New hires per month, last six months"
                     aria-describedby="@_summaryId" data-testid="new-hires-chart">
                    <SfChart Title="" Height="280px" Background="transparent">
                        <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category">
                            <ChartAxisLabelStyle FontFamily="Inter, Helvetica Neue, Helvetica, Arial, sans-serif"></ChartAxisLabelStyle>
                        </ChartPrimaryXAxis>
                        <ChartPrimaryYAxis Minimum="0">
                            <ChartAxisLabelStyle FontFamily="Inter, Helvetica Neue, Helvetica, Arial, sans-serif"></ChartAxisLabelStyle>
                        </ChartPrimaryYAxis>
                        <ChartTooltipSettings Enable="true"></ChartTooltipSettings>
                        <ChartSeriesCollection>
                            <ChartSeries DataSource="@_data"
                                         XName="@nameof(TrendPoint.MonthLabel)"
                                         YName="@nameof(TrendPoint.NewHireCount)"
                                         Type="ChartSeriesType.Column"
                                         Fill="#0f766e">
                                <ChartMarker>
                                    <ChartDataLabel Visible="true" Position="Syncfusion.Blazor.Charts.LabelPosition.Outer">
                                        <ChartDataLabelFont FontFamily="Inter, Helvetica Neue, Helvetica, Arial, sans-serif" />
                                    </ChartDataLabel>
                                </ChartMarker>
                            </ChartSeries>
                        </ChartSeriesCollection>
                    </SfChart>
                </div>

                <p id="@_summaryId" class="visually-hidden">@Summary</p>

                <ChartDataTableToggle TestIdPrefix="new-hires"
                                      ShowText="View new-hire trend as a table"
                                      HideText="Hide new-hire trend table"
                                      Caption="New hires by month (last 6 months)"
                                      CategoryHeader="Month"
                                      ValueHeader="New hires"
                                      Rows="@_data.Select(p => new ChartDataTableToggle.ChartDataRow(p.MonthLabel, p.NewHireCount))" />
            }
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private List<TrendPoint> _data = [];

    protected override async Task OnInitializedAsync()
    {
        if (!Session.CanReadEmployees)
        {
            _loading = false;
            return;
        }

        var result = await EmployeeService.GetNewHiresTrendAsync(Session.CompanyId);
        _data = (result?.Items ?? [])
            .Select(i => new TrendPoint(i.MonthLabel, i.NewHireCount))
            .ToList();

        _loading = false;
    }

    private readonly string _summaryId = $"new-hires-summary-{Guid.NewGuid():N}";

    private string Summary =>
        "New hires per month, last six months: " +
        string.Join(", ", _data.Select(p => $"{p.MonthLabel} {p.NewHireCount}")) +
        $". Total {_data.Sum(p => p.NewHireCount)} new hires.";

    private sealed record TrendPoint(string MonthLabel, int NewHireCount);
}
