@inject NavigationManager Navigation
@inject DocumentService DocumentService

@if (_loading)
{
    <HrLoadingIndicator Label="Loading documents…" />
}
else if (_documents.Count == 0)
{
    <p class="text-muted">No published company documents yet.</p>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-2 col-sm-4 col-6">
            <div class="overview-card text-center py-3">
                <div class="fs-4 fw-semibold">@_documents.Count</div>
                <div class="text-muted small">Total Available</div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-6">
            <div class="overview-card text-center py-3">
                <div class="fs-4 fw-semibold">@_requiresAcknowledgementCount</div>
                <div class="text-muted small">Requires Acknowledgement</div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-6">
            <div class="overview-card text-center py-3">
                <div class="fs-4 fw-semibold text-warning">@_outstandingCount</div>
                <div class="text-muted small">Outstanding</div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-6">
            <div class="overview-card text-center py-3">
                <div class="fs-4 fw-semibold text-success">@_completedCount</div>
                <div class="text-muted small">Completed</div>
            </div>
        </div>
    </div>

    <HrGrid TValue="PublishedSharedCompanyDocumentItem"
            DataSource="@_documents"
            AllowPaging="true"
            AllowSorting="true"
            AllowFiltering="true">
        <GridColumns>
            <GridColumn HeaderText="Title" Width="220">
                <Template>
                    @{ var d = (context as PublishedSharedCompanyDocumentItem)!; }
                    <a href="javascript:void(0)" @onclick="@(() => OpenDocument(d.Id))">@d.Title</a>
                    @if (IsNew(d))
                    {
                        <span class="badge bg-info ms-2">New</span>
                    }
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(PublishedSharedCompanyDocumentItem.CategoryName)" HeaderText="Category" Width="160" />
            <GridColumn Field="@nameof(PublishedSharedCompanyDocumentItem.EffectiveDate)" HeaderText="Effective Date" Width="140" Format="d" />
            <GridColumn Field="@nameof(PublishedSharedCompanyDocumentItem.Description)" HeaderText="Description" Width="220" />
            <GridColumn HeaderText="Acknowledgement" Width="220" AllowSorting="false" AllowFiltering="false">
                <Template>
                    @{ var d = (context as PublishedSharedCompanyDocumentItem)!; }
                    @if (d.RequiresAcknowledgement)
                    {
                        <span class="badge @AcknowledgementBadgeClass(d)">@AcknowledgementBadgeText(d)</span>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </Template>
            </GridColumn>
        </GridColumns>
    </HrGrid>
}

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }

    private List<PublishedSharedCompanyDocumentItem> _documents = [];
    private bool _loading = true;

    private int _requiresAcknowledgementCount;
    private int _outstandingCount;
    private int _completedCount;

    protected override async Task OnInitializedAsync()
    {
        _documents = (await DocumentService.ListPublishedSharedCompanyDocumentsAsync(CompanyId))?.Items.ToList() ?? [];

        _requiresAcknowledgementCount = _documents.Count(d => d.RequiresAcknowledgement);
        _outstandingCount = _documents.Count(IsOutstanding);
        _completedCount = _documents.Count(IsCompleted);

        _loading = false;
    }

    // Backed by SharedCompanyDocumentAcknowledgementStatusCalculator's canonical status, computed
    // server-side and carried on d.AcknowledgementStatus — "Outstanding" here covers both of the
    // calculator's two not-yet-done states (Pending and Overdue).
    private static bool IsOutstanding(PublishedSharedCompanyDocumentItem d) =>
        d.AcknowledgementStatus is "Pending" or "Overdue";

    private static bool IsCompleted(PublishedSharedCompanyDocumentItem d) =>
        d.AcknowledgementStatus == "Completed";

    private static bool IsNew(PublishedSharedCompanyDocumentItem d) =>
        d.PublishedAt.HasValue && DateTimeOffset.UtcNow - d.PublishedAt.Value <= TimeSpan.FromDays(14);

    private static string AcknowledgementBadgeClass(PublishedSharedCompanyDocumentItem d) => d.AcknowledgementStatus switch
    {
        "Completed" => "bg-success",
        "Overdue" => "bg-danger",
        _ => "bg-warning text-dark",
    };

    private static string AcknowledgementBadgeText(PublishedSharedCompanyDocumentItem d)
    {
        if (IsOutstanding(d))
        {
            var due = d.AcknowledgementDueDate.HasValue
                ? $" · Due {d.AcknowledgementDueDate.Value.ToString("d MMMM yyyy")}"
                : string.Empty;
            return $"Acknowledgement Required{due}";
        }

        return $"Acknowledged {d.MyAcknowledgedAt!.Value.ToString("d MMM yyyy")}";
    }

    private void OpenDocument(Guid documentId) =>
        Navigation.NavigateTo($"/companies/{CompanyId}/shared-documents/published/{documentId}");
}
