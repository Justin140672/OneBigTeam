@inject EmployeeService EmployeeService
@inject AppSession Session

@if (Session.CanManageEmployees)
{
    <div class="widget-card chart-tile">
        <div class="widget-header">
            <i class="fa-solid fa-id-badge widget-icon"></i>
            <span class="widget-title">Employment Type</span>
        </div>

        <div class="widget-body">
            @if (_loading)
            {
                <HrLoadingIndicator Label="Loading employment type split…" />
            }
            else if (_data.Count == 0)
            {
                <div class="widget-empty">
                    <i class="fa-solid fa-users-slash fa-lg mb-2"></i>
                    <p class="mb-0">No employee data available.</p>
                </div>
            }
            else
            {
                <SfAccumulationChart Title="" Height="280px" Background="transparent">
                    <AccumulationChartLegendSettings Visible="true" Position="LegendPosition.Right" />
                    <AccumulationChartSeriesCollection>
                        <AccumulationChartSeries DataSource="@_data"
                                                  XName="@nameof(ChartSlice.Label)"
                                                  YName="@nameof(ChartSlice.Value)"
                                                  PointColorMapping="@nameof(ChartSlice.Fill)"
                                                  Type="AccumulationType.Pie"
                                                  InnerRadius="55%">
                            <AccumulationDataLabelSettings Visible="true" Name="@nameof(ChartSlice.LabelText)" />
                        </AccumulationChartSeries>
                    </AccumulationChartSeriesCollection>
                </SfAccumulationChart>
            }
        </div>
    </div>
}

@code {
    private static readonly string[] Palette =
    [
        "#0f766e", "#f97316", "#eab308", "#16a34a", "#6b7280", "#0d9488", "#dc2626", "#9333ea"
    ];

    private bool _loading = true;
    private List<ChartSlice> _data = [];

    protected override async Task OnInitializedAsync()
    {
        if (!Session.CanManageEmployees)
        {
            _loading = false;
            return;
        }

        var result = await EmployeeService.GetEmploymentTypeSplitAsync(Session.CompanyId);
        var items = result?.Items ?? [];

        _data = items
            .Select((item, index) => new ChartSlice(
                item.EmploymentTypeName,
                item.EmployeeCount,
                $"{item.EmployeeCount}",
                Palette[index % Palette.Length]))
            .ToList();

        _loading = false;
    }

    private sealed record ChartSlice(string Label, int Value, string LabelText, string Fill);
}
