@using HR.Web.Models
@using System.Globalization
@inject CompensationService CompensationService
@inject AppSession Session

<AddCompensationDialog CompanyId="CompanyId"
                       EmployeeId="EmployeeId"
                       IsOpen="_addOpen"
                       OnSaved="OnCompensationAdded"
                       OnCancelled="@(() => _addOpen = false)" />

<EditFutureCompensationDialog CompanyId="CompanyId"
                              EmployeeId="EmployeeId"
                              Record="_editTarget"
                              IsOpen="_editOpen"
                              OnSaved="OnCompensationEdited"
                              OnCancelled="@(() => _editOpen = false)" />

@if (_loading)
{
    <HrLoadingIndicator />
}
else
{
    <div class="d-flex justify-content-end mb-3">
        <SfButton CssClass="e-primary e-small" OnClick="@(() => _addOpen = true)" data-testid="add-compensation-btn">
            <i class="fa-solid fa-plus me-1"></i> Add Compensation
        </SfButton>
    </div>

    @if (_current is null && _history.Count == 0)
    {
        <p class="text-muted small mb-0" data-testid="no-compensation-message">No compensation records for this employee.</p>
    }
    else
    {
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Compensation History</h5>
            </div>
            <div class="card-body p-0">
                @if (_history.Count == 0)
                {
                    <p class="text-muted small p-3 mb-0">No compensation history recorded.</p>
                }
                else
                {
                    <CompensationHistoryGrid CompanyId="CompanyId"
                                              EmployeeId="EmployeeId"
                                              Items="_history"
                                              OnEdit="StartEdit"
                                              OnDeleted="ReloadAsync" />
                }
            </div>
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId { get; set; }

    private bool _loading = true;
    private bool _addOpen;
    private bool _editOpen;
    private CompensationHistoryItemModel? _editTarget;
    private CurrentCompensationModel? _current;
    private IReadOnlyList<CompensationHistoryItemModel> _history = [];

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = _current is null && _history.Count == 0;

        var currentTask = CompensationService.GetCurrentCompensationAsync(CompanyId, EmployeeId);
        var historyTask = CompensationService.GetCompensationHistoryAsync(CompanyId, EmployeeId);
        await Task.WhenAll(currentTask, historyTask);

        _current = await currentTask;
        _history = await historyTask;
        _loading = false;
        StateHasChanged();
    }

    private async Task OnCompensationAdded()
    {
        _addOpen = false;
        await ReloadAsync();
    }

    private void StartEdit(CompensationHistoryItemModel item)
    {
        _editTarget = item;
        _editOpen = true;
    }

    private async Task OnCompensationEdited()
    {
        _editOpen = false;
        await ReloadAsync();
    }

}
