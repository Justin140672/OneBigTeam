@using HR.Web.Models
@inject CompensationService CompensationService

<AddCompensationDialog CompanyId="CompanyId"
                       EmployeeId="EmployeeId"
                       IsOpen="_addOpen"
                       OnSaved="OnCompensationAdded"
                       OnCancelled="@(() => _addOpen = false)" />

<EditFutureCompensationDialog CompanyId="CompanyId"
                              EmployeeId="EmployeeId"
                              Record="_editTarget"
                              IsOpen="_editOpen"
                              OnSaved="OnCompensationEdited"
                              OnCancelled="@(() => _editOpen = false)" />

@if (_loading)
{
    <div class="d-flex align-items-center gap-2 py-3">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span class="text-muted">Loading…</span>
    </div>
}
else
{
    <div class="d-flex justify-content-end mb-3">
        <SfButton CssClass="e-primary e-small" OnClick="@(() => _addOpen = true)" data-testid="add-compensation-btn">
            <i class="fa-solid fa-plus me-1"></i> Add Compensation
        </SfButton>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            @if (_current is null)
            {
                <div class="alert alert-secondary">No current compensation record found for this employee.</div>
            }
            else
            {
                <div class="card" data-testid="current-compensation-panel">
                    <div class="card-header">
                        <h5 class="mb-0">Current Compensation</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0 small">
                            <dt class="col-sm-5 text-muted fw-normal">Salary</dt>
                            <dd class="col-sm-7" data-testid="compensation-salary">@SalarySummary(_current)</dd>

                            <dt class="col-sm-5 text-muted fw-normal">Annual Salary</dt>
                            <dd class="col-sm-7" data-testid="compensation-annualised-salary">@AnnualisedSalarySummary(_current)</dd>

                            <dt class="col-sm-5 text-muted fw-normal">Hours</dt>
                            <dd class="col-sm-7" data-testid="compensation-hours">@(_current.HoursPerWeek.HasValue ? $"{_current.HoursPerWeek.Value:0.##} hrs/week" : "—")</dd>

                            <dt class="col-sm-5 text-muted fw-normal">FTE</dt>
                            <dd class="col-sm-7" data-testid="compensation-fte">@(_current.FTE.HasValue ? $"{_current.FTE.Value:P0}" : "—")</dd>

                            <dt class="col-sm-5 text-muted fw-normal">Effective From</dt>
                            <dd class="col-sm-7" data-testid="compensation-effective-from">@_current.EffectiveFrom.ToString("d MMM yyyy")</dd>
                        </dl>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-7">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Compensation History</h5>
                </div>
                <div class="card-body p-0">
                    @if (_history.Count == 0)
                    {
                        <p class="text-muted small p-3 mb-0">No compensation history recorded.</p>
                    }
                    else
                    {
                        <CompensationHistoryGrid CompanyId="CompanyId"
                                                  EmployeeId="EmployeeId"
                                                  Items="_history"
                                                  OnEdit="StartEdit"
                                                  OnDeleted="ReloadAsync" />
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId { get; set; }

    private bool _loading = true;
    private bool _addOpen;
    private bool _editOpen;
    private CompensationHistoryItemModel? _editTarget;
    private CurrentCompensationModel? _current;
    private IReadOnlyList<CompensationHistoryItemModel> _history = [];

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = _current is null && _history.Count == 0;

        var currentTask = CompensationService.GetCurrentCompensationAsync(CompanyId, EmployeeId);
        var historyTask = CompensationService.GetCompensationHistoryAsync(CompanyId, EmployeeId);
        await Task.WhenAll(currentTask, historyTask);

        _current = await currentTask;
        _history = await historyTask;
        _loading = false;
        StateHasChanged();
    }

    private async Task OnCompensationAdded()
    {
        _addOpen = false;
        await ReloadAsync();
    }

    private void StartEdit(CompensationHistoryItemModel item)
    {
        _editTarget = item;
        _editOpen = true;
    }

    private async Task OnCompensationEdited()
    {
        _editOpen = false;
        await ReloadAsync();
    }

    private static string SalarySummary(CurrentCompensationModel c) =>
        $"{c.Currency} {c.Salary:N2} per {PeriodLabel(c.SalaryType)}";

    private static string AnnualisedSalarySummary(CurrentCompensationModel c) =>
        c.AnnualisedSalary.HasValue ? $"{c.Currency} {c.AnnualisedSalary.Value:N2}" : "—";

    private static string PeriodLabel(string salaryType) => salaryType switch
    {
        "Hourly" => "hour",
        "Daily"  => "day",
        _        => "year"
    };
}
