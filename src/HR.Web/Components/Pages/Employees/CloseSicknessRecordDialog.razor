@using System.ComponentModel.DataAnnotations
@inject SicknessService SicknessService
@inherits EditDialogBase<CloseSicknessRecordDialog.CloseSicknessRecordFormModel>

<SfDialog @bind-Visible="Visible" IsModal="true" Width="480px" ShowCloseIcon="true" CssClass="close-sickness-record-dialog">
    <DialogEvents Closed="HandleDialogClosed" />
    <DialogTemplates>
        <Header>Close Sickness Record</Header>
        <Content>
            @if (GlobalError is not null)
            {
                <div class="alert alert-danger alert-dismissible mb-3">
                    @GlobalError
                    <button type="button" class="btn-close" @onclick="@(() => GlobalError = null)"></button>
                </div>
            }
            <EditForm EditContext="EditContext">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label">End Date <span class="text-danger">*</span></label>
                        <SfDatePicker TValue="DateOnly?"
                                      @bind-Value="Model.EndDate"
                                      Format="dd/MM/yyyy"
                                      Placeholder="dd/mm/yyyy" />
                        <ValidationMessage For="@(() => Model.EndDate)" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">End Day Part <span class="text-danger">*</span></label>
                        <SfDropDownList TValue="string" TItem="RecordSicknessDialog.DayPartChoice"
                                        DataSource="@RecordSicknessDialog.DayPartOptions"
                                        @bind-Value="Model.EndDayPart">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Return to Work Date</label>
                        <SfDatePicker TValue="DateOnly?"
                                      @bind-Value="Model.ReturnToWorkDate"
                                      Format="dd/MM/yyyy"
                                      Placeholder="dd/mm/yyyy"
                                      ShowClearButton="true" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Notes</label>
                        <HrTextBox @bind-Value="Model.Notes" Multiline="true" Rows="3" Maxlength="1000" Placeholder="Optional notes…" />
                    </div>
                </div>
            </EditForm>
        </Content>
        <FooterTemplate>
            <HrDialogButtonBar SaveLabel="Close Record" Saving="Saving" OnSave="SubmitAsync" OnCancel="CancelAsync" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<UnsavedChangesDialog Visible="ShowUnsavedChangesDialog"
                      OnSaveAndClose="ConfirmSaveInsteadOfCancelAsync"
                      OnDiscard="ConfirmDiscardAsync"
                      OnCancel="CancelUnsavedChangesDialog" />

@code {
    [Parameter, EditorRequired] public Guid CompanyId  { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId { get; set; }
    [Parameter]                 public Guid RecordId   { get; set; }

    protected override async Task<string?> SaveCoreAsync()
    {
        var (success, error) = await SicknessService.CloseSicknessRecordAsync(
            CompanyId,
            EmployeeId,
            RecordId,
            new CloseSicknessRecordRequest(Model.EndDate!.Value, Model.EndDayPart, Model.ReturnToWorkDate, Model.Notes));

        return success ? null : error;
    }

    protected override Task OnOpenedAsync()
    {
        GlobalError = null;
        return Task.CompletedTask;
    }

    protected override void ResetForm()
    {
        Model.EndDate = null;
        Model.EndDayPart = "FullDay";
        Model.ReturnToWorkDate = null;
        Model.Notes = null;
    }

    public sealed class CloseSicknessRecordFormModel
    {
        [Required(ErrorMessage = "Please enter an end date.")]
        public DateOnly? EndDate { get; set; }
        public string EndDayPart { get; set; } = "FullDay";
        public DateOnly? ReturnToWorkDate { get; set; }
        public string? Notes { get; set; }
    }
}
