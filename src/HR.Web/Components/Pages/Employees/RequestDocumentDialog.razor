@inject DocumentService DocumentService

<SfDialog @bind-Visible="_visible" IsModal="true" Width="480px" ShowCloseIcon="true">
    <DialogEvents Closed="OnDialogClosed" />
    <DialogTemplates>
        <Header>Request Document</Header>
        <Content>
            @if (_error is not null)
            {
                <div class="alert alert-danger alert-dismissible mb-3">
                    @_error
                    <button type="button" class="btn-close" @onclick="@(() => _error = null)"></button>
                </div>
            }
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label">Document Type <span class="text-danger">*</span></label>
                    <SfDropDownList TValue="Guid?" TItem="DocumentTypeItem"
                                    DataSource="_documentTypes"
                                    @bind-Value="_documentTypeId"
                                    Placeholder="Select a document type"
                                    PopupHeight="200px">
                        <DropDownListFieldSettings Value="Id" Text="Name" />
                    </SfDropDownList>
                </div>
                <div class="col-12">
                    <label class="form-label">Due Date</label>
                    <SfDatePicker TValue="DateOnly?"
                                  @bind-Value="_dueDate"
                                  Format="dd/MM/yyyy"
                                  Placeholder="dd/mm/yyyy"
                                  ShowClearButton="true" />
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="isMandatory"
                               @bind="_isMandatory" />
                        <label class="form-check-label" for="isMandatory">Mandatory</label>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label">Notes</label>
                    <textarea class="form-control" rows="3" maxlength="1000"
                              @bind="_notes" placeholder="Optional notes for the employee…"></textarea>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <SfButton IsPrimary="true" OnClick="SubmitAsync" Disabled="_submitting">
                @if (_submitting)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                Request
            </SfButton>
            <SfButton OnClick="Cancel">Cancel</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter, EditorRequired] public Guid CompanyId  { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId { get; set; }
    [Parameter]                 public bool IsOpen     { get; set; }
    [Parameter]                 public EventCallback   OnRequested  { get; set; }
    [Parameter]                 public EventCallback   OnCancelled  { get; set; }

    private bool    _visible;
    private bool    _submitting;
    private string? _error;

    private Guid?     _documentTypeId;
    private DateOnly? _dueDate;
    private bool      _isMandatory;
    private string?   _notes;

    private List<DocumentTypeItem> _documentTypes = [];

    protected override async Task OnParametersSetAsync()
    {
        _visible = IsOpen;
        if (IsOpen && _documentTypes.Count == 0)
            await LoadTypesAsync();
    }

    private async Task LoadTypesAsync()
    {
        var result = await DocumentService.ListDocumentTypesAsync(CompanyId);
        _documentTypes = result?.Items.Where(t => t.IsActive).ToList() ?? [];
    }

    private async Task SubmitAsync()
    {
        _error = null;

        if (_documentTypeId is null)
        {
            _error = "Please select a document type.";
            return;
        }

        _submitting = true;
        var error = await DocumentService.RequestDocumentAsync(
            CompanyId, EmployeeId, _documentTypeId.Value, _dueDate, _isMandatory, _notes);
        _submitting = false;

        if (error is not null)
        {
            _error = error;
            return;
        }

        ResetForm();
        await OnRequested.InvokeAsync();
    }

    private async Task Cancel()
    {
        ResetForm();
        await OnCancelled.InvokeAsync();
    }

    private void OnDialogClosed() => OnCancelled.InvokeAsync();

    private void ResetForm()
    {
        _documentTypeId = null;
        _dueDate        = null;
        _isMandatory    = false;
        _notes          = null;
        _error          = null;
        _visible        = false;
    }
}
