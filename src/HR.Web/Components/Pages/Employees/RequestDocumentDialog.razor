@using System.ComponentModel.DataAnnotations
@inject DocumentService DocumentService
@inherits EditDialogBase<RequestDocumentDialog.RequestDocumentFormModel>

<SfDialog @bind-Visible="Visible" IsModal="true" Width="480px" ShowCloseIcon="true" CssClass="request-document-dialog">
    <DialogEvents Closed="HandleDialogClosed" />
    <DialogTemplates>
        <Header>Request Document</Header>
        <Content>
            @if (GlobalError is not null)
            {
                <div class="alert alert-danger alert-dismissible mb-3">
                    @GlobalError
                    <button type="button" class="btn-close" @onclick="@(() => GlobalError = null)"></button>
                </div>
            }
            <EditForm EditContext="EditContext">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Document Type <span class="text-danger">*</span></label>
                        <SfDropDownList TValue="Guid?" TItem="DocumentTypeItem"
                                        DataSource="_documentTypes"
                                        @bind-Value="Model.DocumentTypeId"
                                        Placeholder="Select a document type"
                                        PopupHeight="200px">
                            <DropDownListFieldSettings Value="Id" Text="Name" />
                        </SfDropDownList>
                        <ValidationMessage For="@(() => Model.DocumentTypeId)" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Due Date</label>
                        <SfDatePicker TValue="DateOnly?"
                                      @bind-Value="Model.DueDate"
                                      Format="dd/MM/yyyy"
                                      Placeholder="dd/mm/yyyy"
                                      ShowClearButton="true" />
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="isMandatory"
                                   @bind="Model.IsMandatory" />
                            <label class="form-check-label" for="isMandatory">Mandatory</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Notes</label>
                        <textarea class="form-control" rows="3" maxlength="1000"
                                  @bind="Model.Notes" placeholder="Optional notes for the employee…"></textarea>
                    </div>
                </div>
            </EditForm>
        </Content>
        <FooterTemplate>
            <SfButton IsPrimary="true" OnClick="SubmitAsync" Disabled="Saving">
                @if (Saving)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                Request
            </SfButton>
            <SfButton OnClick="CancelAsync">Cancel</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter, EditorRequired] public Guid CompanyId  { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId { get; set; }

    private List<DocumentTypeItem> _documentTypes = [];

    protected override async Task OnOpenedAsync()
    {
        var result = await DocumentService.ListDocumentTypesAsync(CompanyId);
        _documentTypes = result?.Items.Where(t => t.IsActive).ToList() ?? [];
    }

    protected override async Task<string?> SaveCoreAsync() =>
        await DocumentService.RequestDocumentAsync(
            CompanyId, EmployeeId, Model.DocumentTypeId!.Value, Model.DueDate, Model.IsMandatory, Model.Notes);

    protected override void ResetForm()
    {
        Model.DocumentTypeId = null;
        Model.DueDate = null;
        Model.IsMandatory = false;
        Model.Notes = null;
    }

    public sealed class RequestDocumentFormModel
    {
        [Required(ErrorMessage = "Please select a document type.")]
        public Guid? DocumentTypeId { get; set; }
        public DateOnly? DueDate { get; set; }
        public bool IsMandatory { get; set; }
        public string? Notes { get; set; }
    }
}
