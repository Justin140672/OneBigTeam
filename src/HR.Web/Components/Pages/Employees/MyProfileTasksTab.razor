@inject TaskService TaskService
@using HR.Web.Components.Pages.Tasks

@if (_loading)
{
    <HrLoadingIndicator Label="Loading tasks…" />
}
else
{
    <TaskList Tasks="@_tasks" ShowAssignedTo="false" OnViewTask="OpenTaskDialog" />
}

<TaskViewDialog CompanyId="CompanyId"
                TaskId="_selectedTaskId"
                IsOpen="_dialogOpen"
                OnClosed="CloseTaskDialogAsync" />

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }

    private IReadOnlyList<TaskListItem> _tasks = [];
    private bool _loading = true;

    private Guid? _selectedTaskId;
    private bool _dialogOpen;

    protected override async Task OnParametersSetAsync() => await LoadTasksAsync();

    private async Task LoadTasksAsync()
    {
        _loading = _tasks.Count == 0;
        // See EmployeeTasksTab's identical comment: TaskList/HrGrid has AllowPaging="false" with
        // no "next page" control, so the default pageSize=20 would silently drop tasks past the
        // first page (soonest-due first) with no indication anything is missing.
        var result = await TaskService.GetMyTasksAsync(CompanyId, pageSize: 200);
        _tasks = result?.Items ?? [];
        _loading = false;
        StateHasChanged();
    }

    private void OpenTaskDialog(Guid taskId)
    {
        _selectedTaskId = taskId;
        _dialogOpen = true;
    }

    private async Task CloseTaskDialogAsync()
    {
        _dialogOpen = false;
        // Refresh in case the task was actioned (completed/approved/etc.) while the dialog was open.
        await LoadTasksAsync();
    }
}
