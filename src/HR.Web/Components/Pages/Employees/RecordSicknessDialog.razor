@inject SicknessCategoryService SicknessCategoryService
@inject SicknessService SicknessService

<SfDialog @bind-Visible="_visible" IsModal="true" Width="480px" ShowCloseIcon="true" CssClass="record-sickness-dialog">
    <DialogEvents Closed="OnDialogClosed" />
    <DialogTemplates>
        <Header>Record Sickness</Header>
        <Content>
            @if (_error is not null)
            {
                <div class="alert alert-danger alert-dismissible mb-3">
                    @_error
                    <button type="button" class="btn-close" @onclick="@(() => _error = null)"></button>
                </div>
            }
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label">Category <span class="text-danger">*</span></label>
                    <SfDropDownList TValue="Guid?" TItem="SicknessCategoryListItemModel"
                                    DataSource="_categories"
                                    @bind-Value="_categoryId"
                                    Placeholder="Select a sickness category"
                                    PopupHeight="200px">
                        <DropDownListFieldSettings Value="Id" Text="Name" />
                    </SfDropDownList>
                </div>
                <div class="col-6">
                    <label class="form-label">Start Date <span class="text-danger">*</span></label>
                    <SfDatePicker TValue="DateOnly?"
                                  @bind-Value="_startDate"
                                  Format="dd/MM/yyyy"
                                  Placeholder="dd/mm/yyyy" />
                </div>
                <div class="col-6">
                    <label class="form-label">Start Day Part <span class="text-danger">*</span></label>
                    <SfDropDownList TValue="string" TItem="DayPartChoice"
                                    DataSource="@DayPartOptions"
                                    @bind-Value="_startDayPart">
                        <DropDownListFieldSettings Value="Value" Text="Label" />
                    </SfDropDownList>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="alreadyEnded"
                               @bind="_alreadyEnded" />
                        <label class="form-check-label" for="alreadyEnded">This absence has already ended</label>
                    </div>
                </div>
                @if (_alreadyEnded)
                {
                    <div class="col-6">
                        <label class="form-label">End Date</label>
                        <SfDatePicker TValue="DateOnly?"
                                      @bind-Value="_endDate"
                                      Format="dd/MM/yyyy"
                                      Placeholder="dd/mm/yyyy" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">End Day Part</label>
                        <SfDropDownList TValue="string" TItem="DayPartChoice"
                                        DataSource="@DayPartOptions"
                                        @bind-Value="_endDayPart">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                }
                <div class="col-12">
                    <label class="form-label">Notes</label>
                    <textarea class="form-control" rows="3" maxlength="1000"
                              @bind="_notes" placeholder="Optional notes…"></textarea>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <SfButton IsPrimary="true" OnClick="SubmitAsync" Disabled="_submitting">
                @if (_submitting)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                Record
            </SfButton>
            <SfButton OnClick="Cancel">Cancel</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter, EditorRequired] public Guid CompanyId  { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId { get; set; }
    [Parameter]                 public bool IsOpen     { get; set; }
    [Parameter]                 public EventCallback   OnRecorded   { get; set; }
    [Parameter]                 public EventCallback   OnCancelled  { get; set; }

    private record DayPartChoice(string Value, string Label);

    private static readonly DayPartChoice[] DayPartOptions =
    [
        new("FullDay", "Full Day"),
        new("HalfDayAM", "Half Day (AM)"),
        new("HalfDayPM", "Half Day (PM)"),
    ];

    private bool    _visible;
    private bool    _submitting;
    private string? _error;

    private Guid?     _categoryId;
    private DateOnly? _startDate;
    private string     _startDayPart = "FullDay";
    private bool       _alreadyEnded;
    private DateOnly? _endDate;
    private string     _endDayPart = "FullDay";
    private string?   _notes;

    private List<SicknessCategoryListItemModel> _categories = [];

    protected override async Task OnParametersSetAsync()
    {
        _visible = IsOpen;
        if (IsOpen && _categories.Count == 0)
            await LoadCategoriesAsync();
    }

    private async Task LoadCategoriesAsync()
    {
        var result = await SicknessCategoryService.ListSicknessCategoriesAsync(CompanyId);
        _categories = result?.Items.Where(c => c.IsActive).ToList() ?? [];
    }

    private async Task SubmitAsync()
    {
        _error = null;

        if (_categoryId is null)
        {
            _error = "Please select a sickness category.";
            return;
        }

        if (_startDate is null)
        {
            _error = "Please enter a start date.";
            return;
        }

        _submitting = true;
        var (success, error) = await SicknessService.RecordSicknessAsync(
            CompanyId,
            EmployeeId,
            new RecordSicknessRequest(
                _categoryId.Value,
                _startDate.Value,
                _startDayPart,
                _alreadyEnded ? _endDate : null,
                _alreadyEnded ? _endDayPart : null,
                _notes));
        _submitting = false;

        if (!success)
        {
            _error = error;
            return;
        }

        ResetForm();
        await OnRecorded.InvokeAsync();
    }

    private async Task Cancel()
    {
        ResetForm();
        await OnCancelled.InvokeAsync();
    }

    private void OnDialogClosed() => OnCancelled.InvokeAsync();

    private void ResetForm()
    {
        _categoryId    = null;
        _startDate     = null;
        _startDayPart  = "FullDay";
        _alreadyEnded  = false;
        _endDate       = null;
        _endDayPart    = "FullDay";
        _notes         = null;
        _error         = null;
        _visible       = false;
    }
}
