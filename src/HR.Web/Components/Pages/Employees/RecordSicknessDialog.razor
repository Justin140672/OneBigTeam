@using System.ComponentModel.DataAnnotations
@inject SicknessCategoryService SicknessCategoryService
@inject SicknessService SicknessService
@inherits EditDialogBase<RecordSicknessDialog.RecordSicknessFormModel>

<SfDialog @bind-Visible="Visible" IsModal="true" Width="480px" ShowCloseIcon="true" CssClass="record-sickness-dialog">
    <DialogEvents Closed="HandleDialogClosed" />
    <DialogTemplates>
        <Header>@(SelfService ? "Notify Sickness" : "Record Sickness")</Header>
        <Content>
            @if (GlobalError is not null)
            {
                <div class="alert alert-danger alert-dismissible mb-3">
                    @GlobalError
                    <button type="button" class="btn-close" @onclick="@(() => GlobalError = null)"></button>
                </div>
            }
            <EditForm EditContext="EditContext">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Category <span class="text-danger">*</span></label>
                        <SfDropDownList TValue="Guid?" TItem="SicknessCategoryListItemModel"
                                        DataSource="_categories"
                                        @bind-Value="Model.CategoryId"
                                        Placeholder="Select a sickness category"
                                        PopupHeight="200px">
                            <DropDownListFieldSettings Value="Id" Text="Name" />
                        </SfDropDownList>
                        <ValidationMessage For="@(() => Model.CategoryId)" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Start Date <span class="text-danger">*</span></label>
                        <SfDatePicker TValue="DateOnly?"
                                      @bind-Value="Model.StartDate"
                                      Format="dd/MM/yyyy"
                                      Placeholder="dd/mm/yyyy" />
                        <ValidationMessage For="@(() => Model.StartDate)" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Start Day Part <span class="text-danger">*</span></label>
                        <SfDropDownList TValue="string" TItem="DayPartChoice"
                                        DataSource="@DayPartOptions"
                                        @bind-Value="Model.StartDayPart">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="alreadyEnded"
                                   @bind="Model.AlreadyEnded" />
                            <label class="form-check-label" for="alreadyEnded">This absence has already ended</label>
                        </div>
                    </div>
                    @if (Model.AlreadyEnded)
                    {
                        <div class="col-6">
                            <label class="form-label">End Date</label>
                            <SfDatePicker TValue="DateOnly?"
                                          @bind-Value="Model.EndDate"
                                          Format="dd/MM/yyyy"
                                          Placeholder="dd/mm/yyyy" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">End Day Part</label>
                            <SfDropDownList TValue="string" TItem="DayPartChoice"
                                            DataSource="@DayPartOptions"
                                            @bind-Value="Model.EndDayPart">
                                <DropDownListFieldSettings Value="Value" Text="Label" />
                            </SfDropDownList>
                        </div>
                    }
                    <div class="col-12">
                        <label class="form-label">Notes</label>
                        <HrTextBox @bind-Value="Model.Notes" Multiline="true" Rows="3" Maxlength="1000" Placeholder="Optional notes…" />
                    </div>
                </div>
            </EditForm>
        </Content>
        <FooterTemplate>
            <HrDialogButtonBar SaveLabel="@(SelfService ? "Notify" : "Record")" Saving="Saving" OnSave="SubmitAsync" OnCancel="CancelAsync" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<UnsavedChangesDialog Visible="ShowUnsavedChangesDialog"
                      OnSaveAndClose="ConfirmSaveInsteadOfCancelAsync"
                      OnDiscard="ConfirmDiscardAsync"
                      OnCancel="CancelUnsavedChangesDialog" />

@code {
    [Parameter, EditorRequired] public Guid CompanyId  { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId { get; set; }
    // When true, this is the employee reporting their own sickness (calls RecordMySicknessAsync)
    // rather than an HR/manager recording it on someone's behalf (RecordSicknessAsync).
    [Parameter] public bool SelfService { get; set; }

    public sealed record DayPartChoice(string Value, string Label);

    public static readonly DayPartChoice[] DayPartOptions =
    [
        new("FullDay", "Full Day"),
        new("HalfDayAM", "Half Day (AM)"),
        new("HalfDayPM", "Half Day (PM)"),
    ];

    private List<SicknessCategoryListItemModel> _categories = [];

    protected override async Task OnOpenedAsync()
    {
        GlobalError = null;

        if (_categories.Count == 0)
        {
            var result = await SicknessCategoryService.ListSicknessCategoriesAsync(CompanyId);
            _categories = result?.Items.Where(c => c.IsActive).ToList() ?? [];
        }
    }

    protected override async Task<string?> SaveCoreAsync()
    {
        var request = new RecordSicknessRequest(
            Model.CategoryId!.Value,
            Model.StartDate!.Value,
            Model.StartDayPart,
            Model.AlreadyEnded ? Model.EndDate : null,
            Model.AlreadyEnded ? Model.EndDayPart : null,
            Model.Notes);

        var (success, error) = SelfService
            ? await SicknessService.RecordMySicknessAsync(CompanyId, EmployeeId, request)
            : await SicknessService.RecordSicknessAsync(CompanyId, EmployeeId, request);

        return success ? null : error;
    }

    protected override void ResetForm()
    {
        Model.CategoryId = null;
        Model.StartDate = null;
        Model.StartDayPart = "FullDay";
        Model.AlreadyEnded = false;
        Model.EndDate = null;
        Model.EndDayPart = "FullDay";
        Model.Notes = null;
    }

    public sealed class RecordSicknessFormModel
    {
        [Required(ErrorMessage = "Please select a sickness category.")]
        public Guid? CategoryId { get; set; }
        [Required(ErrorMessage = "Please enter a start date.")]
        public DateOnly? StartDate { get; set; }
        public string StartDayPart { get; set; } = "FullDay";
        public bool AlreadyEnded { get; set; }
        public DateOnly? EndDate { get; set; }
        public string EndDayPart { get; set; } = "FullDay";
        public string? Notes { get; set; }
    }
}
