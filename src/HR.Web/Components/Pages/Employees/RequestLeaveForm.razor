@using System.ComponentModel.DataAnnotations
@using HR.Modules.Employees.Contracts
@inject LeaveService LeaveService

<SfDialog @bind-Visible="_visible" IsModal="true" Width="640px" ShowCloseIcon="true">
    <DialogEvents Closed="OnDialogClosed" />
    <DialogTemplates>
        <Header>Request Leave</Header>
        <Content>
            @if (_submitError is not null)
            {
                <div class="alert alert-danger alert-dismissible mb-3">
                    @_submitError
                    <button type="button" class="btn-close" @onclick="@(() => _submitError = null)"></button>
                </div>
            }

            @if (Balances.Count == 0)
            {
                <p class="text-muted mb-0">No leave types are available.</p>
            }
            else
            {
            <EditForm EditContext="_editContext">
                <DataAnnotationsValidator />
                <HrValidationSummary />
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Leave Type <span class="text-danger">*</span></label>
                        <SfDropDownList TValue="Guid?" TItem="LeaveBalanceItemModel"
                                        DataSource="@Balances"
                                        Value="_model.LeaveTypeId"
                                        ValueChanged="OnLeaveTypeChanged"
                                        Placeholder="Select leave type"
                                        HtmlAttributes="@LeaveTypeHtmlAttributes">
                            <DropDownListFieldSettings Value="LeaveTypeId" Text="LeaveTypeName" />
                        </SfDropDownList>
                        <ValidationMessage For="@(() => _model.LeaveTypeId)" class="invalid-feedback d-block" />
                    </div>
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-6">
                        <label class="form-label">Start Date <span class="text-danger">*</span></label>
                        <SfDatePicker TValue="DateTime?"
                                      Value="_model.StartDate"
                                      ValueChanged="OnStartDateChanged"
                                      Format="dd/MM/yyyy" />
                        <ValidationMessage For="@(() => _model.StartDate)" class="invalid-feedback d-block" />
                        <div class="mt-2">
                            <label class="form-label small text-muted">Start</label>
                            <SfDropDownList TValue="LeaveDayPart" TItem="DayPartChoice"
                                            DataSource="@DayPartOptions"
                                            Value="_startPart"
                                            ValueChanged="OnStartPartChanged">
                                <DropDownListFieldSettings Value="Part" Text="Label" />
                            </SfDropDownList>
                        </div>
                    </div>
                    <div class="col-6">
                        <label class="form-label">End Date <span class="text-danger">*</span></label>
                        <SfDatePicker TValue="DateTime?"
                                      Value="_model.EndDate"
                                      ValueChanged="OnEndDateChanged"
                                      Format="dd/MM/yyyy" />
                        <ValidationMessage For="@(() => _model.EndDate)" class="invalid-feedback d-block" />
                        <div class="mt-2">
                            <label class="form-label small text-muted">End</label>
                            <SfDropDownList TValue="LeaveDayPart" TItem="DayPartChoice"
                                            DataSource="@DayPartOptions"
                                            Value="_endPart"
                                            ValueChanged="OnEndPartChanged">
                                <DropDownListFieldSettings Value="Part" Text="Label" />
                            </SfDropDownList>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-12">
                        <label class="form-label">Reason <span class="text-muted small">(optional)</span></label>
                        <HrTextBox @bind-Value="_model.Reason" Placeholder="Reason for leave request" />
                    </div>
                </div>

                @if (_model.LeaveTypeId is { } leaveTypeId && leaveTypeId != Guid.Empty)
                {
                    var dateInvalid = EndDate < StartDate;
                    var totalDays = dateInvalid ? 0m : CalculateDays();
                    var selectedBalance = Balances.FirstOrDefault(b => b.LeaveTypeId == leaveTypeId);
                    var remainingAfter = !dateInvalid && selectedBalance?.RemainingDays is not null
                        ? selectedBalance.RemainingDays - totalDays
                        : (decimal?)null;
                    var wouldExceed = remainingAfter.HasValue && remainingAfter.Value < 0;
                    var excludedHolidays = !dateInvalid && ExcludePublicHolidays
                        ? GetExcludedHolidays()
                        : (IReadOnlyList<DateOnly>)[];

                    <div class="mt-3 p-3 rounded border bg-light">
                        @if (dateInvalid)
                        {
                            <span class="text-danger small">End date must be on or after start date.</span>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-1">
                                <span class="fw-semibold">@FormatDays(totalDays) requested</span>

                                @if (excludedHolidays.Count > 0)
                                {
                                    <small class="text-muted">
                                        @excludedHolidays.Count public holiday(s) excluded
                                    </small>
                                }

                                @if (remainingAfter.HasValue)
                                {
                                    <small class="@(wouldExceed ? "text-danger fw-semibold" : "text-muted")">
                                        Balance after: @FormatDays(remainingAfter.Value)
                                        @if (wouldExceed)
                                        {
                                            <span> &mdash; would exceed your allowance</span>
                                        }
                                    </small>
                                }
                            </div>
                        }
                    </div>
                }
            </EditForm>
            }
        </Content>
        <FooterTemplate>
            <SfButton IsPrimary="true" Disabled="@(!CanSubmit)" OnClick="Submit">
                @if (_submitting)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                Submit Request
            </SfButton>
            <SfButton OnClick="Cancel">Cancel</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<LeaveBalanceItemModel> Balances { get; set; } = [];
    [Parameter] public WorkingDays EffectiveWorkingDays { get; set; } =
        WorkingDays.Monday | WorkingDays.Tuesday | WorkingDays.Wednesday |
        WorkingDays.Thursday | WorkingDays.Friday;
    [Parameter] public decimal EffectiveHoursPerDay { get; set; } = 7.5m;
    [Parameter] public bool ExcludePublicHolidays { get; set; } = true;
    [Parameter] public IReadOnlyList<DateOnly> PublicHolidays { get; set; } = [];
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnSubmitted { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    private record DayPartChoice(LeaveDayPart Part, string Label);

    private static readonly DayPartChoice[] DayPartOptions =
    [
        new(LeaveDayPart.FullDay, "Full day"),
        new(LeaveDayPart.Morning, "Morning"),
        new(LeaveDayPart.Afternoon, "Afternoon"),
    ];

    private bool _visible;

    private readonly RequestLeaveFormModel _model = new();
    private EditContext _editContext = default!;
    private LeaveDayPart _startPart = LeaveDayPart.FullDay;
    private LeaveDayPart _endPart = LeaveDayPart.FullDay;

    private bool _submitting;
    private string? _submitError;

    private DateOnly StartDate => DateOnly.FromDateTime(_model.StartDate ?? DateTime.Today);
    private DateOnly EndDate => DateOnly.FromDateTime(_model.EndDate ?? DateTime.Today);

    private bool CanSubmit => !_submitting;

    // Syncfusion's SfDropDownList doesn't get Blazor's automatic aria-invalid/is-invalid wiring
    // (that only applies to InputBase-derived components), so this is set manually from the
    // EditContext's current validation state for the Leave Type field.
    private Dictionary<string, object> LeaveTypeHtmlAttributes =>
        new()
        {
            ["aria-invalid"] = _editContext.GetValidationMessages(_editContext.Field(nameof(RequestLeaveFormModel.LeaveTypeId))).Any()
                ? "true"
                : "false"
        };

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);
    }

    protected override void OnParametersSet()
    {
        if (IsOpen && !_visible)
        {
            Reset();
            _visible = true;
        }
        else if (!IsOpen && _visible)
        {
            _visible = false;
        }
    }

    private void Reset()
    {
        _model.LeaveTypeId = null;
        _model.StartDate = null;
        _model.EndDate = null;
        _model.Reason = null;
        _startPart = LeaveDayPart.FullDay;
        _endPart = LeaveDayPart.FullDay;
        _submitError = null;
        _editContext = new EditContext(_model);
    }

    private async Task OnDialogClosed() => await OnCancelled.InvokeAsync();

    private async Task Cancel()
    {
        _visible = false;
        await OnCancelled.InvokeAsync();
    }

    private void OnLeaveTypeChanged(Guid? v)
    {
        _model.LeaveTypeId = v;
        _editContext.NotifyFieldChanged(_editContext.Field(nameof(RequestLeaveFormModel.LeaveTypeId)));
    }

    private void OnStartDateChanged(DateTime? v)
    {
        _model.StartDate = v;
        if (v is not null && _model.EndDate < v)
            _model.EndDate = v;
        _editContext.NotifyFieldChanged(_editContext.Field(nameof(RequestLeaveFormModel.StartDate)));
    }

    private void OnEndDateChanged(DateTime? v)
    {
        _model.EndDate = v;
        _editContext.NotifyFieldChanged(_editContext.Field(nameof(RequestLeaveFormModel.EndDate)));
    }
    private void OnStartPartChanged(LeaveDayPart v) => _startPart = v;
    private void OnEndPartChanged(LeaveDayPart v) => _endPart = v;

    private decimal CalculateDays()
    {
        var start = StartDate;
        var end = EndDate;
        if (end < start || EffectiveHoursPerDay <= 0) return 0;

        decimal totalHours = 0;
        var current = start;

        while (current <= end)
        {
            if (IsWorkingDay(current.DayOfWeek) &&
                (!ExcludePublicHolidays || !PublicHolidays.Contains(current)))
            {
                totalHours += current == start && current == end
                    ? PartToHours(_startPart)
                    : current == start
                        ? PartToHours(_startPart)
                        : current == end
                            ? PartToHours(_endPart)
                            : EffectiveHoursPerDay;
            }

            current = current.AddDays(1);
        }

        return totalHours / EffectiveHoursPerDay;
    }

    private IReadOnlyList<DateOnly> GetExcludedHolidays()
    {
        var start = StartDate;
        var end = EndDate;
        return PublicHolidays
            .Where(h => h >= start && h <= end && IsWorkingDay(h.DayOfWeek))
            .ToList();
    }

    private bool IsWorkingDay(DayOfWeek day) => day switch
    {
        DayOfWeek.Monday    => EffectiveWorkingDays.HasFlag(WorkingDays.Monday),
        DayOfWeek.Tuesday   => EffectiveWorkingDays.HasFlag(WorkingDays.Tuesday),
        DayOfWeek.Wednesday => EffectiveWorkingDays.HasFlag(WorkingDays.Wednesday),
        DayOfWeek.Thursday  => EffectiveWorkingDays.HasFlag(WorkingDays.Thursday),
        DayOfWeek.Friday    => EffectiveWorkingDays.HasFlag(WorkingDays.Friday),
        DayOfWeek.Saturday  => EffectiveWorkingDays.HasFlag(WorkingDays.Saturday),
        DayOfWeek.Sunday    => EffectiveWorkingDays.HasFlag(WorkingDays.Sunday),
        _                   => false
    };

    private decimal PartToHours(LeaveDayPart part) =>
        part == LeaveDayPart.FullDay ? EffectiveHoursPerDay : EffectiveHoursPerDay / 2;

    private async Task Submit()
    {
        if (_submitting) return;

        if (!_editContext.Validate())
            return;

        _submitting = true;
        _submitError = null;

        var (response, error) = await LeaveService.SubmitLeaveRequestAsync(
            CompanyId, EmployeeId,
            new SubmitLeaveRequestModel(
                _model.LeaveTypeId!.Value,
                StartDate, _startPart,
                EndDate, _endPart,
                string.IsNullOrWhiteSpace(_model.Reason) ? null : _model.Reason));

        _submitting = false;

        if (response is not null)
        {
            _visible = false;
            await OnSubmitted.InvokeAsync();
        }
        else
        {
            _submitError = error ?? "Failed to submit leave request.";
        }
    }

    private static string FormatDays(decimal days) =>
        $"{days:0.##} {(days == 1m ? "day" : "days")}";

    private sealed class RequestLeaveFormModel : IValidatableObject
    {
        [Required(ErrorMessage = "Please select a leave type.")]
        public Guid? LeaveTypeId { get; set; }

        [Required(ErrorMessage = "Please select a start date.")]
        public DateTime? StartDate { get; set; }

        [Required(ErrorMessage = "Please select an end date.")]
        public DateTime? EndDate { get; set; }

        public string? Reason { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (StartDate is not null && EndDate is not null && EndDate < StartDate)
                yield return new ValidationResult(
                    "End date must be on or after start date.",
                    [nameof(EndDate)]);
        }
    }
}
