@page "/companies/{CompanyId:guid}/employees"
@rendermode InteractiveServer
@inherits SearchPageBase<EmployeeListItemModel>
@using HR.SharedKernel
@inject EmployeeService EmployeeService
@inject UserService UserService
@inject AppSession Session

<PageTitle>Employees</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Employees</h1>
    <p class="text-muted mb-3">View and manage everyone employed at your company.</p>

    <div class="mb-3 col-md-4 px-0">
        <HrTextBox Value="@SearchTerm"
                   ValueChanged="@OnSearchChanged"
                   Placeholder="Search by name or email" />
    </div>

    @if (IsLoading)
    {
        <div class="d-flex align-items-center gap-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Loading employees…</span>
        </div>
    }
    else if (Error is not null)
    {
        <div class="alert alert-danger">@Error</div>
    }
    else
    {
        <HrGrid @ref="Grid"
                TValue="EmployeeListItemModel"
                DataSource="@Items"
                Toolbar="@GridToolbar"
                AllowFiltering="true">
            <GridEvents TValue="EmployeeListItemModel" OnToolbarClick="OnToolbarClick"
                        RowSelected="OnRowSelected" RowDeselected="OnRowDeselected" />
            <GridPageSettings PageSize="20" />
            <GridColumns>
                <GridColumn Field="@nameof(EmployeeListItemModel.LastName)" HeaderText="Last Name" Width="140">
                    <Template>
                        @{
                            var row = (context as EmployeeListItemModel)!;
                            <a href="/companies/@CompanyId/employees/@row.Id">@row.LastName</a>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(EmployeeListItemModel.FirstName)" HeaderText="First Name" Width="130" />
                <GridColumn Field="@nameof(EmployeeListItemModel.WorkEmail)" HeaderText="Work Email" Width="220" />
                <GridColumn Field="@nameof(EmployeeListItemModel.DepartmentName)" HeaderText="Department" Width="160" />
                <GridColumn Field="@nameof(EmployeeListItemModel.PositionProfileTitle)" HeaderText="Position" Width="180" />
                <GridColumn Field="@nameof(EmployeeListItemModel.ManagerFullName)" HeaderText="Manager" Width="150" />
                <GridColumn Field="@nameof(EmployeeListItemModel.StartDate)" HeaderText="Start Date" Width="120" Format="d" />
                <GridColumn Field="@nameof(EmployeeListItemModel.Status)" HeaderText="Status" Width="120">
                    <Template>
                        @{
                            var row = (context as EmployeeListItemModel)!;
                            <span class="badge @StatusBadgeClass(row.Status)">@row.Status</span>
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </HrGrid>
    }
</div>

@code {
    private bool _canCreateEmployee;

    protected override async Task OnBeforeLoadAsync()
    {
        if (!Session.CanManageEmployees)
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }
        _canCreateEmployee = await UserService.HasPermissionAsync(SystemPermissions.EmployeeCreate);
    }

    protected override async Task<IReadOnlyList<EmployeeListItemModel>?> FetchItemsAsync(string? search)
    {
        var result = await EmployeeService.ListEmployeesAsync(CompanyId, search: search, pageSize: 100);
        return result?.Items;
    }

    protected override string LoadErrorMessage => "Failed to load employees.";

    protected override string? GetAddUrl() =>
        _canCreateEmployee ? $"/companies/{CompanyId}/employees/new" : null;

    protected override string? GetEditUrl(EmployeeListItemModel item) =>
        $"/companies/{CompanyId}/employees/{item.Id}";

    protected override string? GetViewUrl(EmployeeListItemModel item) =>
        $"/companies/{CompanyId}/employees/{item.Id}/view";

    private static string StatusBadgeClass(string status) => status switch
    {
        "Active"     => "bg-success",
        "OnLeave"    => "bg-warning text-dark",
        "Suspended"  => "bg-danger",
        "Terminated" => "bg-secondary",
        _            => "bg-light text-dark"
    };
}
