@page "/companies/{CompanyId:guid}/employees"
@rendermode InteractiveServer
@inherits SearchPageBase<EmployeeListItemModel>
@using HR.SharedKernel
@using HR.Web.Services
@inject EmployeeService EmployeeService
@inject UserService UserService
@inject AppSession Session
@inject CompensationService CompensationService
@inject IJSRuntime JS

<PageTitle>Employees</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Employees</h1>
    <p class="text-muted mb-3">View and manage everyone employed at your company.</p>

    <div class="mb-3 col-md-4 px-0">
        <HrTextBox Value="@SearchTerm"
                   ValueChanged="@OnSearchChanged"
                   Placeholder="Search by name, email or employee number" />
    </div>

    @if (IsLoading)
    {
        <HrLoadingIndicator Label="Loading employees…" />
    }
    else if (Error is not null)
    {
        <div class="alert alert-danger">@Error</div>
    }
    else
    {
        @if (_actionError is not null)
        {
            <div class="alert alert-danger alert-dismissible">
                @_actionError
                <button type="button" class="btn-close" @onclick="@(() => _actionError = null)"></button>
            </div>
        }

        @if (_actionSuccess is not null)
        {
            <div class="alert alert-success alert-dismissible">
                @_actionSuccess
                <button type="button" class="btn-close" @onclick="@(() => _actionSuccess = null)"></button>
            </div>
        }

        <HrGrid @ref="Grid"
                TValue="EmployeeListItemModel"
                DataSource="@Items"
                Toolbar="@EmployeeToolbar"
                AllowFiltering="true">
            <GridEvents TValue="EmployeeListItemModel" OnToolbarClick="OnToolbarClick"
                        RowSelected="OnRowSelected" RowDeselected="OnRowDeselected" />
            <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple" Mode="Syncfusion.Blazor.Grids.SelectionMode.Row"></GridSelectionSettings>
            <GridPageSettings PageSize="20" />
            <GridColumns>
                <GridColumn Type="Syncfusion.Blazor.Grids.ColumnType.CheckBox" Width="50"></GridColumn>
                <GridColumn HeaderText="" Width="50" AllowSorting="false" AllowFiltering="false">
                    <Template>
                        @{
                            var row = (context as EmployeeListItemModel)!;
                            <ProfilePhotoAvatar PhotoUrl="@row.ProfilePhotoUrl" Initials="@GetInitials(row)" SizePx="32" />
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(EmployeeListItemModel.LastName)" HeaderText="Last Name" Width="140">
                    <Template>
                        @{
                            var row = (context as EmployeeListItemModel)!;
                            <a href="/companies/@CompanyId/employees/@row.Id">@row.LastName</a>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(EmployeeListItemModel.FirstName)" HeaderText="First Name" Width="130" />
                <GridColumn Field="@nameof(EmployeeListItemModel.WorkEmail)" HeaderText="Work Email" Width="220" />
                <GridColumn Field="@nameof(EmployeeListItemModel.DepartmentName)" HeaderText="Department" Width="160" />
                <GridColumn Field="@nameof(EmployeeListItemModel.PositionProfileTitle)" HeaderText="Position" Width="180" />
                <GridColumn Field="@nameof(EmployeeListItemModel.ManagerFullName)" HeaderText="Manager" Width="150" />
                <GridColumn Field="@nameof(EmployeeListItemModel.StartDate)" HeaderText="Start Date" Width="120" Format="d" />
                <GridColumn Field="@nameof(EmployeeListItemModel.Status)" HeaderText="Status" Width="120">
                    <Template>
                        @{
                            var row = (context as EmployeeListItemModel)!;
                            <span class="badge @StatusBadgeClass(row.Status)">@row.Status</span>
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </HrGrid>

        <BulkCompensationUpdateDialog CompanyId="CompanyId"
                                       Employees="@_bulkUpdateEmployees"
                                       IsOpen="_showBulkUpdateDialog"
                                       OnClosed="HandleBulkUpdateDialogClosed"
                                       OnApplied="HandleBulkUpdateApplied" />

        <BulkCompensationImportDialog CompanyId="CompanyId"
                                      IsOpen="_showImportDialog"
                                      OnClosed="HandleImportDialogClosed"
                                      OnImported="HandleImportDialogImported" />
    }
</div>

@code {
    private bool _canCreateEmployee;
    private bool _showBulkUpdateDialog;
    private bool _showImportDialog;
    private List<EmployeeListItemModel> _bulkUpdateEmployees = [];
    private string? _actionError;
    private string? _actionSuccess;

    protected override async Task OnBeforeLoadAsync()
    {
        if (!Session.CanManageEmployees)
        {
            Navigation.NavigateTo(Session.MyProfileUrl, replace: true);
            return;
        }
        _canCreateEmployee = await UserService.HasPermissionAsync(SystemPermissions.EmployeeCreate);
    }

    protected override void ConfigureToolbar()
    {
        AddToolbarAction(
            id:      "hr-bulk-update",
            text:    "Bulk Update",
            icon:    "fa-solid fa-money-bill-wave",
            onClick: OnBulkUpdateClicked,
            tooltip: "Bulk update compensation for selected employees");
    }

    private async Task OnBulkUpdateClicked(EmployeeListItemModel _)
    {
        if (Grid is null) return;

        var selected = await Grid.GetSelectedRecordsAsync();
        if (selected.Count == 0) return;

        _actionError = null;
        _actionSuccess = null;
        _bulkUpdateEmployees = selected.ToList();
        _showBulkUpdateDialog = true;
    }

    // Swaps the plain "hr-bulk-update" toolbar button (registered via ConfigureToolbar/
    // AddToolbarAction, so its Disabled state still tracks selection via
    // SearchPageBase.SelectionDependentToolbarIds) for a Template-based dropdown mounting
    // BulkUpdateMenu, mirroring how GridToolbar itself mounts ExportMenu for "hr-export".
    private IEnumerable<object> EmployeeToolbar =>
        GridToolbar.Select(item => item is Syncfusion.Blazor.Navigations.ItemModel im && im.Id == "hr-bulk-update"
            ? new Syncfusion.Blazor.Navigations.ItemModel
            {
                Id          = "hr-bulk-update",
                Type        = Syncfusion.Blazor.Navigations.ItemType.Input,
                Template    = BulkUpdateMenuTemplate,
                TooltipText = "Bulk update compensation for selected employees",
            }
            : item);

    private RenderFragment BulkUpdateMenuTemplate => builder =>
    {
        builder.OpenComponent<HR.Web.Components.Controls.BulkUpdateMenu>(0);
        builder.AddAttribute(1, nameof(HR.Web.Components.Controls.BulkUpdateMenu.OnItemSelected),
            EventCallback.Factory.Create<string>(this, HandleBulkUpdateMenuItemSelected));
        builder.CloseComponent();
    };

    private async Task HandleBulkUpdateMenuItemSelected(string id)
    {
        switch (id)
        {
            case "hr-bulk-selected":
                await OnBulkUpdateClicked(null!);
                break;
            case "hr-bulk-import":
                _actionError = null;
                _actionSuccess = null;
                _showImportDialog = true;
                break;
            case "hr-bulk-download-template":
                await DownloadImportTemplateAsync();
                break;
        }
    }

    private async Task DownloadImportTemplateAsync()
    {
        _actionError = null;
        var (bytes, error) = await CompensationService.DownloadImportTemplateAsync(CompanyId);
        if (bytes is null)
        {
            _actionError = error ?? "Failed to download the compensation import template.";
            return;
        }

        await JS.InvokeVoidAsync(
            "downloadFileFromBase64",
            "compensation-import-template.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            Convert.ToBase64String(bytes));
    }

    private async Task HandleBulkUpdateDialogClosed()
    {
        _showBulkUpdateDialog = false;
        if (Grid is not null)
            await Grid.ClearSelectionAsync();
    }

    private async Task HandleBulkUpdateApplied()
    {
        _actionSuccess = $"Updated compensation for {_bulkUpdateEmployees.Count} employee(s).";
        _showBulkUpdateDialog = false;
        if (Grid is not null)
            await Grid.ClearSelectionAsync();
    }

    private void HandleImportDialogClosed()
    {
        _showImportDialog = false;
    }

    private void HandleImportDialogImported(ImportCompensationChangesResponse result)
    {
        _actionSuccess = $"Imported compensation changes for {result.Items.Count} employee(s).";
        _showImportDialog = false;
    }

    protected override async Task<IReadOnlyList<EmployeeListItemModel>?> FetchItemsAsync(string? search)
    {
        var result = await EmployeeService.ListEmployeesAsync(CompanyId, search: search, pageSize: 100);
        return result?.Items;
    }

    protected override string LoadErrorMessage => "Failed to load employees.";

    protected override string? GetAddUrl() =>
        _canCreateEmployee ? $"/companies/{CompanyId}/employees/new" : null;

    protected override string? GetEditUrl(EmployeeListItemModel item) =>
        $"/companies/{CompanyId}/employees/{item.Id}";

    protected override string? GetViewUrl(EmployeeListItemModel item) =>
        $"/companies/{CompanyId}/employees/{item.Id}/view";

    private static string GetInitials(EmployeeListItemModel row)
    {
        var first = row.FirstName.Length > 0 ? row.FirstName[..1] : string.Empty;
        var last = row.LastName.Length > 0 ? row.LastName[..1] : string.Empty;
        var initials = $"{first}{last}".ToUpperInvariant();
        return string.IsNullOrEmpty(initials) ? "?" : initials;
    }

    private static string StatusBadgeClass(string status) => status switch
    {
        "Active"         => "bg-success",
        "OnLeave"        => "bg-warning text-dark",
        "Suspended"      => "bg-danger",
        "Leaving"        => "bg-warning text-dark",
        "FormerEmployee" => "bg-secondary",
        _                => "bg-light text-dark"
    };
}
