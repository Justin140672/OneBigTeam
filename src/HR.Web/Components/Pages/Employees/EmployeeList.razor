@page "/companies/{CompanyId:guid}/employees"
@rendermode InteractiveServer
@inherits SearchPageBase<EmployeeListItemModel>
@using HR.SharedKernel
@using HR.SharedKernel.Http
@using HR.Web.Services
@using HR.Web.Components.Pages.Users
@using Syncfusion.Blazor.SplitButtons
@inject EmployeeService EmployeeService
@inject DepartmentService DepartmentService
@inject UserService UserService
@inject AppSession Session
@inject CompensationService CompensationService
@inject InvitationBatchService InvitationBatchService
@inject UserAdministrationService UserAdministrationService
@inject IJSRuntime JS

<PageTitle>Employees</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Employees</h1>
    <p class="text-muted mb-3">View and manage everyone employed at your company.</p>

    @if (_isInviteMode)
    {
        <div class="alert alert-info d-flex justify-content-between align-items-center invite-mode-banner">
            <span>Invitation mode — reviewing who to invite.</span>
            <a href="@BackToListUrl">Back to employee list</a>
        </div>
    }

    <InvitationBatchProgressPanel @ref="_progressPanel" CompanyId="CompanyId" OnRecipientsUpdated="HandleInvitationRecipientsUpdatedAsync" />

    @if (_inviteBatchExcluded.Count > 0)
    {
        <div class="alert alert-warning alert-dismissible" data-testid="invite-batch-excluded">
            <p class="fw-medium mb-1">@_inviteBatchExcluded.Count employee(s) were not invited:</p>
            <ul class="mb-0">
                @foreach (var excluded in _inviteBatchExcluded)
                {
                    <li data-testid="invite-batch-excluded-row">
                        <strong>@excluded.Name</strong>@(excluded.Email is not null && excluded.Email != excluded.Name ? $" ({excluded.Email})" : string.Empty)
                        — @InvitationReasonDisplay.Explanation(excluded.Reason)
                    </li>
                }
            </ul>
            <button type="button" class="btn-close" aria-label="Dismiss" @onclick="@(() => _inviteBatchExcluded = [])"></button>
        </div>
    }

    @if (_isInviteMode)
    {
        <InviteModeCandidateGrid @ref="_inviteModeGrid"
                                  CompanyId="CompanyId"
                                  CanManageUsers="_canManageUserAccounts"
                                  OnInviteSelectedRequested="HandleInviteSelectedRequestedAsync" />
    }
    else
    {
        <div class="employee-list-controls mb-2">
        <div class="employee-search-wrap">
            <label for="employee-list-search" class="visually-hidden">Search employees</label>
            <HrTextBox Value="@SearchTerm"
                       ValueChanged="@OnSearchChanged"
                       CssClass="employee-search-input"
                       Placeholder="Search by name, email or employee number"
                       HtmlAttributes="@(new Dictionary<string, object> { ["id"] = "employee-list-search", ["aria-label"] = "Search employees" })" />
            @if (!string.IsNullOrEmpty(SearchTerm))
            {
                <button type="button"
                        class="btn btn-link employee-search-clear"
                        aria-label="Clear search"
                        title="Clear search"
                        @onclick="@(() => OnSearchChanged(string.Empty))">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            }
        </div>

        <button type="button"
                class="btn btn-outline-secondary employee-filters-toggle"
                aria-expanded="@_showFilters"
                aria-label="@($"Filters{(ActiveFilterCount > 0 ? $", {ActiveFilterCount} active" : string.Empty)}")"
                @onclick="@(() => _showFilters = !_showFilters)">
            <i class="fa-solid fa-filter" aria-hidden="true"></i>
            Filters
            @if (ActiveFilterCount > 0)
            {
                <span class="badge rounded-pill text-bg-primary employee-filters-count">@ActiveFilterCount</span>
            }
        </button>
    </div>

    @if (_showFilters)
    {
        <div class="employee-filters-panel mb-2" role="region" aria-label="Filter employees">
            <div class="employee-filter-field">
                <label for="employee-filter-department" class="form-label small mb-1">Department</label>
                <select id="employee-filter-department"
                        class="form-select form-select-sm"
                        @bind="_filterDepartmentIdText"
                        @bind:after="OnFilterChangedAsync">
                    <option value="">All departments</option>
                    @foreach (var department in _departments)
                    {
                        <option value="@department.Id">@department.Name</option>
                    }
                </select>
            </div>
            <div class="employee-filter-field">
                <label for="employee-filter-status" class="form-label small mb-1">Status</label>
                <select id="employee-filter-status"
                        class="form-select form-select-sm"
                        @bind="_filterStatus"
                        @bind:after="OnFilterChangedAsync">
                    <option value="">All statuses</option>
                    @foreach (var status in StatusOptions)
                    {
                        <option value="@status">@EnumDisplay.Humanize(status)</option>
                    }
                </select>
            </div>
        </div>
    }

    @if (ActiveFilterCount > 0)
    {
        <div class="employee-filter-chips mb-2" aria-label="Active filters">
            @if (_selectedDepartmentName is not null)
            {
                <span class="employee-filter-chip">
                    Department: @_selectedDepartmentName
                    <button type="button" class="employee-filter-chip-remove" aria-label="@($"Remove department filter: {_selectedDepartmentName}")" @onclick="RemoveDepartmentFilterAsync">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                </span>
            }
            @if (!string.IsNullOrEmpty(_filterStatus))
            {
                <span class="employee-filter-chip">
                    Status: @EnumDisplay.Humanize(_filterStatus)
                    <button type="button" class="employee-filter-chip-remove" aria-label="@($"Remove status filter: {EnumDisplay.Humanize(_filterStatus)}")" @onclick="RemoveStatusFilterAsync">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                </span>
            }
        </div>
    }

    @if (IsLoading)
    {
        <HrLoadingIndicator Label="Loading employees…" />
    }
    else if (Error is not null)
    {
        <div class="alert alert-danger">@Error</div>
    }
    else
    {
        @if (_actionError is not null)
        {
            <div class="alert alert-danger alert-dismissible">
                @_actionError
                <button type="button" class="btn-close" @onclick="@(() => _actionError = null)"></button>
            </div>
        }

        @if (_actionSuccess is not null)
        {
            <div class="alert alert-success alert-dismissible">
                @_actionSuccess
                <button type="button" class="btn-close" @onclick="@(() => _actionSuccess = null)"></button>
            </div>
        }

        <div class="employee-list-summary mb-2">
            @ResultSummaryText
        </div>

        <HrGrid @ref="Grid"
                TValue="EmployeeListItemModel"
                DataSource="@Items"
                Toolbar="@EmployeeToolbar"
                class="employee-grid"
                AllowFiltering="true">
            <GridEvents TValue="EmployeeListItemModel" OnToolbarClick="OnToolbarClick"
                        RowSelected="OnRowSelected" RowDeselected="OnRowDeselected"
                        OnRecordClick="OnRecordClick" OnActionComplete="OnGridActionComplete" />
            <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple" Mode="Syncfusion.Blazor.Grids.SelectionMode.Row"></GridSelectionSettings>
            <GridPageSettings PageSize="20" />
            <GridColumns>
                <GridColumn Type="Syncfusion.Blazor.Grids.ColumnType.CheckBox" Width="50"></GridColumn>
                <GridColumn Field="@nameof(EmployeeListItemModel.LastName)" HeaderText="Employee" Width="260" AllowFiltering="false">
                    <Template>
                        @{
                            var row = (context as EmployeeListItemModel)!;
                            <a class="employee-cell" href="/companies/@CompanyId/employees/@row.Id" aria-label="@($"Open profile for {row.FullName}")">
                                <ProfilePhotoAvatar PhotoUrl="@row.ProfilePhotoUrl" Initials="@GetInitials(row)" SizePx="32" />
                                <span class="employee-cell-text">
                                    <span class="employee-cell-name">@row.FullName</span>
                                    @if (!string.IsNullOrEmpty(row.EmployeeNumber))
                                    {
                                        <span class="employee-cell-number">@row.EmployeeNumber</span>
                                    }
                                </span>
                            </a>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(EmployeeListItemModel.WorkEmail)" HeaderText="Work Email" Width="220" />
                <GridColumn Field="@nameof(EmployeeListItemModel.DepartmentName)" HeaderText="Department" Width="160" />
                <GridColumn Field="@nameof(EmployeeListItemModel.LocationName)" HeaderText="Location" Width="150" />
                <GridColumn Field="@nameof(EmployeeListItemModel.PositionProfileTitle)" HeaderText="Position" Width="180" />
                <GridColumn Field="@nameof(EmployeeListItemModel.ManagerFullName)" HeaderText="Manager" Width="150" />
                <GridColumn Field="@nameof(EmployeeListItemModel.Status)" HeaderText="Status" Width="120">
                    <Template>
                        @{
                            var row = (context as EmployeeListItemModel)!;
                            <span class="badge @StatusBadgeClass(row.Status)">@EnumDisplay.Humanize(row.Status)</span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(EmployeeListItemModel.UserAccountStatus)" HeaderText="User Account" Width="200" AllowFiltering="false">
                    <Template>
                        @{
                            var row = (context as EmployeeListItemModel)!;
                            var (icon, cssClass, label) = AccountStateDisplay(row.UserAccountStatus);
                        }
                        <div class="user-account-cell" @onclick:stopPropagation="true">
                            <span class="user-account-status-label @cssClass">
                                <i class="@icon me-1" aria-hidden="true"></i>@label
                            </span>
                            @if (_canManageUserAccounts && AccountMenuItems(row).Count > 0)
                            {
                                <SfDropDownButton Items="@AccountMenuItems(row)"
                                                  IconCss="fa-solid fa-ellipsis-vertical"
                                                  CssClass="e-flat e-caret-hide user-account-actions-btn"
                                                  aria-label="@($"Account actions for {row.FullName}")">
                                    <DropDownButtonEvents ItemSelected="@(args => HandleAccountMenuAsync(row, args))" />
                                </SfDropDownButton>
                            }
                        </div>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(EmployeeListItemModel.StartDate)" HeaderText="Start Date" Width="120" Format="d" Visible="false" />
            </GridColumns>
        </HrGrid>

        <BulkCompensationUpdateDialog CompanyId="CompanyId"
                                       Employees="@_bulkUpdateEmployees"
                                       IsOpen="_showBulkUpdateDialog"
                                       OnClosed="HandleBulkUpdateDialogClosed"
                                       OnApplied="HandleBulkUpdateApplied" />

        <BulkCompensationImportDialog CompanyId="CompanyId"
                                      IsOpen="_showImportDialog"
                                      OnClosed="HandleImportDialogClosed"
                                      OnImported="HandleImportDialogImported" />

        @if (_inviteEmployeeId is not null)
        {
            <InviteUserDialog CompanyId="CompanyId"
                              IsOpen="_showInviteUserDialog"
                              PreselectedEmployeeId="_inviteEmployeeId.Value"
                              PreselectedEmployeeName="@(_inviteEmployeeName ?? string.Empty)"
                              PreselectedEmployeeEmail="@_inviteEmployeeEmail"
                              OnCancelled="HandleInviteUserDialogCancelled"
                              OnCompleted="HandleInviteUserDialogCompleted" />
        }

        <HrConfirmDialog Visible="_showDisableConfirm"
                         Title="Disable access"
                         Message="@($"Disable sign-in access for {_disableRow?.FullName}? You'll be taken to their account page to confirm and complete this.")"
                         ConfirmText="Continue"
                         CancelText="Cancel"
                         DangerConfirm="true"
                         OnConfirmed="ConfirmDisableAsync"
                         OnCancelled="@(() => { _showDisableConfirm = false; _disableRow = null; })" />
    }
    }

    <BulkInviteConfirmDialog CompanyId="CompanyId"
                             IsOpen="_showInviteConfirmDialog"
                             Recipients="_inviteConfirmRecipients"
                             Excluded="_inviteConfirmExcluded"
                             OnClosed="HandleInviteConfirmDialogClosed"
                             OnQueued="HandleInviteBatchQueuedAsync" />
</div>

@code {
    private static readonly string[] StatusOptions = ["Active", "Suspended", "Leaving", "FormerEmployee"];

    private bool _canCreateEmployee;
    private bool _showBulkUpdateDialog;
    private bool _showImportDialog;
    private List<EmployeeListItemModel> _bulkUpdateEmployees = [];
    private string? _actionError;
    private string? _actionSuccess;

    private bool _canManageUserAccounts;
    private bool _showDisableConfirm;
    private EmployeeListItemModel? _disableRow;

    private bool _showInviteUserDialog;
    private Guid? _inviteEmployeeId;
    private string? _inviteEmployeeName;
    private string? _inviteEmployeeEmail;

    private bool _showFilters;
    private List<DepartmentListItemModel> _departments = [];
    private string _filterDepartmentIdText = string.Empty;
    private string _filterStatus = string.Empty;
    private int _totalCount;
    private int _currentPage = 1;

    [SupplyParameterFromQuery(Name = "mode")]
    public string? Mode { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private bool _isInviteMode => string.Equals(Mode, "invite", StringComparison.OrdinalIgnoreCase);

    private string BackToListUrl =>
        ReturnUrlValidator.ValidateInternalPathAllowingBaseRelative(ReturnUrl) ?? $"/companies/{CompanyId}/employees";

    private InvitationBatchProgressPanel? _progressPanel;
    private InviteModeCandidateGrid? _inviteModeGrid;

    private bool _showInviteConfirmDialog;
    private List<InvitationRecipientCandidate> _inviteConfirmRecipients = [];
    private List<InvitationExclusionCandidate> _inviteBatchExcluded = [];
    private List<InvitationExclusionCandidate> _inviteConfirmExcluded = [];

    private Guid? FilterDepartmentId =>
        Guid.TryParse(_filterDepartmentIdText, out var id) ? id : null;

    private string? _selectedDepartmentName =>
        FilterDepartmentId is { } id ? _departments.FirstOrDefault(d => d.Id == id)?.Name : null;

    private int ActiveFilterCount =>
        (FilterDepartmentId is not null ? 1 : 0) + (!string.IsNullOrEmpty(_filterStatus) ? 1 : 0);

    private string ResultSummaryText
    {
        get
        {
            if (_totalCount == 0)
                return "0 employees";

            if (Items.Count >= _totalCount)
                return $"{_totalCount} employee{(_totalCount == 1 ? "" : "s")}";

            var start = ((_currentPage - 1) * 20) + 1;
            var end = Math.Min(_currentPage * 20, Items.Count);
            return $"{start}–{end} of {_totalCount} employees";
        }
    }

    protected override async Task OnBeforeLoadAsync()
    {
        if (!Session.CanManageEmployees)
        {
            Navigation.NavigateTo("/access-denied", replace: true);
            return;
        }
        _canCreateEmployee = await UserService.HasPermissionAsync(SystemPermissions.EmployeeCreate);
        _canManageUserAccounts = Session.CanManageUsers;

        if (_departments.Count == 0)
        {
            var departments = await DepartmentService.ListDepartmentsAsync(CompanyId);
            _departments = departments?.Items ?? [];
        }
    }

    protected override string AddButtonText => "Add employee";

    protected override void ConfigureToolbar()
    {
        AddToolbarAction(
            id:      "hr-bulk-update",
            text:    "Update selected",
            icon:    "fa-solid fa-money-bill-wave",
            onClick: OnBulkUpdateClicked,
            tooltip: "Update compensation for selected employees",
            selectionDependent: false);

        if (Session.CanManageUsers)
        {
            AddToolbarAction(
                id:      "hr-invite-selected",
                text:    "Invite selected",
                icon:    "fa-solid fa-paper-plane",
                onClick: OnInviteSelectedClicked,
                tooltip: "Send account invitations to selected employees",
                textWithSelectionCount: n => n > 0 ? $"Invite selected ({n})" : "Invite selected");
        }
    }

    private async Task OnInviteSelectedClicked(EmployeeListItemModel _)
    {
        if (Grid is null) return;

        var selected = await Grid.GetSelectedRecordsAsync();
        if (selected.Count == 0)
        {
            _actionError = "Select at least one employee to invite.";
            return;
        }

        var recipients = new List<InvitationRecipientCandidate>();
        var excluded = new List<InvitationExclusionCandidate>();
        var seenEmails = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (var row in selected)
        {
            if (string.IsNullOrWhiteSpace(row.WorkEmail))
            {
                excluded.Add(new(row.FullName, null, "MissingEmail"));
                continue;
            }

            var category = AccountStateCategory(row.UserAccountStatus);
            if (category is "invited" or "expired")
            {
                excluded.Add(new(row.FullName, row.WorkEmail, "AlreadyInvited"));
                continue;
            }
            if (category is "active" or "disabled")
            {
                excluded.Add(new(row.FullName, row.WorkEmail, "AlreadyHasAccount"));
                continue;
            }
            if (!seenEmails.Add(row.WorkEmail))
            {
                excluded.Add(new(row.FullName, row.WorkEmail, "DuplicateEmail"));
                continue;
            }

            recipients.Add(new(row.Id, row.FullName, row.WorkEmail));
        }

        _actionError = null;
        _actionSuccess = null;
        _inviteConfirmRecipients = recipients;
        _inviteConfirmExcluded = excluded;
        _inviteBatchExcluded = [];
        _showInviteConfirmDialog = true;
    }

    private async Task HandleInviteSelectedRequestedAsync((List<InvitationRecipientCandidate> Recipients, List<InvitationExclusionCandidate> Excluded) selection)
    {
        _actionError = null;
        _actionSuccess = null;
        _inviteConfirmRecipients = selection.Recipients;
        _inviteConfirmExcluded = selection.Excluded;
        _inviteBatchExcluded = [];
        _showInviteConfirmDialog = true;
        await Task.CompletedTask;
    }

    private void HandleInviteConfirmDialogClosed()
    {
        _showInviteConfirmDialog = false;
    }

    private async Task HandleInviteBatchQueuedAsync(QueueInvitationBatchResponse result)
    {
        _showInviteConfirmDialog = false;
        _actionSuccess = "Invitations queued — you can navigate away, processing will continue.";

        var namesById = _inviteConfirmRecipients
            .GroupBy(r => r.EmployeeId)
            .ToDictionary(g => g.Key, g => g.First().Name);
        _inviteBatchExcluded = (result.Excluded ?? [])
            .Select(e => new InvitationExclusionCandidate(
                namesById.TryGetValue(e.EmployeeId, out var name) ? name : (e.Email ?? "Unknown employee"),
                e.Email,
                e.Reason))
            .ToList();

        if (Grid is not null)
            await Grid.ClearSelectionAsync();
        if (_inviteModeGrid is not null)
            await _inviteModeGrid.ClearSelectionAsync();

        if (_recipientRefreshPending)
        {
            _recipientRefreshPending = false;
            await LoadAsync();
        }

        if (_progressPanel is not null)
            await _progressPanel.ShowBatchAsync(result.BatchId);
    }

    private bool _recipientRefreshPending;

    private async Task HandleInvitationRecipientsUpdatedAsync()
    {
        if (_inviteModeGrid is not null)
            await _inviteModeGrid.ReloadAsync();

        if (_hasSelection)
        {
            _recipientRefreshPending = true;
            return;
        }

        _recipientRefreshPending = false;
        await LoadAsync();
    }

    private async Task OnBulkUpdateClicked(EmployeeListItemModel _)
    {
        if (Grid is null) return;

        var selected = await Grid.GetSelectedRecordsAsync();
        if (selected.Count == 0)
        {
            _actionError = "Select at least one employee to update.";
            return;
        }

        _actionError = null;
        _actionSuccess = null;
        _bulkUpdateEmployees = selected.ToList();
        _showBulkUpdateDialog = true;
    }

    private IEnumerable<object> EmployeeToolbar =>
        GridToolbar
            .Where(item => item is not Syncfusion.Blazor.Navigations.ItemModel im
                || (im.Id != "hr-print" && im.Id != "hr-export" && im.Id != "hr-columns"))
            .Select(item => item is Syncfusion.Blazor.Navigations.ItemModel im && im.Id == "hr-bulk-update"
                ? new Syncfusion.Blazor.Navigations.ItemModel
                {
                    Id          = "hr-bulk-update",
                    Type        = Syncfusion.Blazor.Navigations.ItemType.Input,
                    Template    = BulkUpdateMenuTemplate,
                    TooltipText = "Update compensation for selected employees",
                }
                : item)
            .Append(new Syncfusion.Blazor.Navigations.ItemModel
            {
                Id          = "hr-more",
                Type        = Syncfusion.Blazor.Navigations.ItemType.Input,
                Template    = OverflowMenuTemplate,
                TooltipText = "More actions",
            });

    private RenderFragment BulkUpdateMenuTemplate => builder =>
    {
        builder.OpenComponent<HR.Web.Components.Controls.BulkUpdateMenu>(0);
        builder.AddAttribute(1, nameof(HR.Web.Components.Controls.BulkUpdateMenu.OnItemSelected),
            EventCallback.Factory.Create<string>(this, HandleBulkUpdateMenuItemSelected));
        builder.AddAttribute(2, nameof(HR.Web.Components.Controls.BulkUpdateMenu.HasSelection), _hasSelection);
        builder.AddAttribute(3, nameof(HR.Web.Components.Controls.BulkUpdateMenu.SelectedCount), SelectedCount);
        builder.AddAttribute(4, nameof(HR.Web.Components.Controls.BulkUpdateMenu.Disabled), Session.IsReadOnly);
        builder.CloseComponent();
    };

    private RenderFragment OverflowMenuTemplate => builder =>
    {
        builder.OpenComponent<HR.Web.Components.Controls.OverflowActionsMenu>(0);
        builder.AddAttribute(1, nameof(HR.Web.Components.Controls.OverflowActionsMenu.OnItemSelected),
            EventCallback.Factory.Create<string>(this, HandleOverflowMenuItemSelected));
        builder.CloseComponent();
    };

    private async Task HandleOverflowMenuItemSelected(string id)
    {
        if (Grid is null) return;

        switch (id)
        {
            case "hr-print":
                await Grid.PrintAsync();
                break;
            case "hr-excel":
                await Grid.ExportToExcelAsync(new Syncfusion.Blazor.Grids.ExcelExportProperties());
                break;
            case "hr-csv":
                await Grid.ExportToCsvAsync(new Syncfusion.Blazor.Grids.ExcelExportProperties());
                break;
            case "hr-pdf":
                await Grid.ExportToPdfAsync(new Syncfusion.Blazor.Grids.PdfExportProperties());
                break;
            case "hr-columns":
                await Grid.OpenColumnChooserAsync(0, 0);
                break;
        }
    }

    private async Task HandleBulkUpdateMenuItemSelected(string id)
    {
        switch (id)
        {
            case "hr-bulk-selected":
                await OnBulkUpdateClicked(null!);
                break;
            case "hr-bulk-import":
                _actionError = null;
                _actionSuccess = null;
                _showImportDialog = true;
                break;
            case "hr-bulk-download-template":
                await DownloadImportTemplateAsync();
                break;
        }
    }

    private async Task DownloadImportTemplateAsync()
    {
        _actionError = null;
        var (bytes, error) = await CompensationService.DownloadImportTemplateAsync(CompanyId);
        if (bytes is null)
        {
            _actionError = error ?? "Failed to download the compensation import template.";
            return;
        }

        await JS.InvokeVoidAsync(
            "downloadFileFromBase64",
            "compensation-import-template.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            Convert.ToBase64String(bytes));
    }

    private async Task HandleBulkUpdateDialogClosed()
    {
        _showBulkUpdateDialog = false;
        if (Grid is not null)
            await Grid.ClearSelectionAsync();
    }

    private async Task HandleBulkUpdateApplied()
    {
        _actionSuccess = $"Updated compensation for {_bulkUpdateEmployees.Count} employee(s).";
        _showBulkUpdateDialog = false;
        if (Grid is not null)
            await Grid.ClearSelectionAsync();
    }

    private void HandleImportDialogClosed()
    {
        _showImportDialog = false;
    }

    private void HandleImportDialogImported(ImportCompensationChangesResponse result)
    {
        _actionSuccess = $"Imported compensation changes for {result.Items.Count} employee(s).";
        _showImportDialog = false;
    }

    private async Task OnFilterChangedAsync()
    {
        _currentPage = 1;
        await LoadAsync();
    }

    private void OnGridActionComplete(Syncfusion.Blazor.Grids.ActionEventArgs<EmployeeListItemModel> args)
    {
        if (args.RequestType == Syncfusion.Blazor.Grids.Action.Paging)
        {
            _currentPage = args.CurrentPage;
            StateHasChanged();
        }
    }

    private async Task RemoveDepartmentFilterAsync()
    {
        _filterDepartmentIdText = string.Empty;
        await OnFilterChangedAsync();
    }

    private async Task RemoveStatusFilterAsync()
    {
        _filterStatus = string.Empty;
        await OnFilterChangedAsync();
    }

    protected override async Task<IReadOnlyList<EmployeeListItemModel>?> FetchItemsAsync(string? search)
    {
        var result = await EmployeeService.ListEmployeesAsync(
            CompanyId,
            search: search,
            pageSize: 100,
            departmentId: FilterDepartmentId,
            status: string.IsNullOrEmpty(_filterStatus) ? null : _filterStatus);

        _totalCount = result?.TotalCount ?? 0;
        return result?.Items;
    }

    protected override string LoadErrorMessage => "Failed to load employees.";

    protected override bool IsAddDisabled => Session.IsReadOnly;

    protected override string? GetAddUrl() =>
        _canCreateEmployee ? $"/companies/{CompanyId}/employees/new" : null;

    protected override string? GetEditUrl(EmployeeListItemModel item) =>
        $"/companies/{CompanyId}/employees/{item.Id}";

    protected override string? GetViewUrl(EmployeeListItemModel item) =>
        $"/companies/{CompanyId}/employees/{item.Id}/view";

    private void OnRecordClick(Syncfusion.Blazor.Grids.RecordClickEventArgs<EmployeeListItemModel> args)
    {
        if (args.Column?.Type == Syncfusion.Blazor.Grids.ColumnType.CheckBox) return;
        if (args.RowData is null) return;
        Navigation.NavigateTo($"/companies/{CompanyId}/employees/{args.RowData.Id}");
    }

    private static string GetInitials(EmployeeListItemModel row)
    {
        var first = row.FirstName.Length > 0 ? row.FirstName[..1] : string.Empty;
        var last = row.LastName.Length > 0 ? row.LastName[..1] : string.Empty;
        var initials = $"{first}{last}".ToUpperInvariant();
        return string.IsNullOrEmpty(initials) ? "?" : initials;
    }

    private static string StatusBadgeClass(string status) => status switch
    {
        "Active"         => "bg-success",
        "Suspended"      => "bg-danger",
        "Leaving"        => "bg-warning text-dark",
        "FormerEmployee" => "bg-secondary",
        _                => "bg-light text-dark"
    };

    private static (string Icon, string CssClass, string Label) AccountStateDisplay(string status) => status switch
    {
        "Active"              => ("fa-solid fa-circle-check", "text-success", "Active"),
        "Disabled"            => ("fa-solid fa-ban", "text-danger", "Disabled"),
        "Pending Invitation"  => ("fa-solid fa-clock", "text-warning", "Invited"),
        "Invitation Expired"  => ("fa-solid fa-triangle-exclamation", "text-warning", "Invite expired"),
        "No User"             => ("fa-solid fa-circle-minus", "text-secondary", "No account"),
        _                     => ("fa-solid fa-circle-minus", "text-secondary", "No account")
    };

    private static string AccountStateCategory(string status) => status switch
    {
        "Active"             => "active",
        "Disabled"           => "disabled",
        "Pending Invitation" => "invited",
        "Invitation Expired" => "expired",
        _                    => "none"
    };

    private List<DropDownMenuItem> AccountMenuItems(EmployeeListItemModel row)
    {
        var items = new List<DropDownMenuItem>();
        switch (AccountStateCategory(row.UserAccountStatus))
        {
            case "none":
                items.Add(new() { Id = "invite", Text = "Invite", Disabled = Session.IsReadOnly, IconCss = "fa-solid fa-paper-plane" });
                break;
            case "invited":
            case "expired":
                items.Add(new() { Id = "resend", Text = "Resend invite", Disabled = Session.IsReadOnly, IconCss = "fa-solid fa-paper-plane" });
                items.Add(new() { Id = "view", Text = "View account", IconCss = "fa-solid fa-up-right-from-square" });
                break;
            case "active":
                items.Add(new() { Id = "view", Text = "View account", IconCss = "fa-solid fa-up-right-from-square" });
                items.Add(new() { Id = "disable", Text = "Disable access", Disabled = Session.IsReadOnly, IconCss = "fa-solid fa-ban" });
                break;
            case "disabled":
                items.Add(new() { Id = "view", Text = "View account", IconCss = "fa-solid fa-up-right-from-square" });
                break;
        }
        return items;
    }

    private string UserDetailUrl(EmployeeListItemModel row) =>
        $"/companies/{CompanyId}/user-administration/{row.Id}";

    private Task HandleAccountMenuAsync(EmployeeListItemModel row, MenuEventArgs args)
    {
        switch (args.Item?.Id)
        {
            case "invite":
                OnInviteUserClicked(row);
                break;
            case "resend":
            case "view":
                Navigation.NavigateTo(UserDetailUrl(row));
                break;
            case "disable":
                _actionError = null;
                _actionSuccess = null;
                _disableRow = row;
                _showDisableConfirm = true;
                break;
        }
        return Task.CompletedTask;
    }

    private Task ConfirmDisableAsync()
    {
        _showDisableConfirm = false;
        var row = _disableRow;
        _disableRow = null;
        if (row is not null)
            Navigation.NavigateTo(UserDetailUrl(row));
        return Task.CompletedTask;
    }

    private void OnInviteUserClicked(EmployeeListItemModel row)
    {
        _actionError = null;
        _actionSuccess = null;
        _inviteEmployeeId = row.Id;
        _inviteEmployeeName = row.FullName;
        _inviteEmployeeEmail = row.WorkEmail;
        _showInviteUserDialog = true;
    }

    private void HandleInviteUserDialogCancelled()
    {
        _showInviteUserDialog = false;
        _inviteEmployeeId = null;
        _inviteEmployeeName = null;
        _inviteEmployeeEmail = null;
    }

    private async Task HandleInviteUserDialogCompleted(InviteEmployeeUserResponse result)
    {
        _showInviteUserDialog = false;
        _inviteEmployeeId = null;
        _inviteEmployeeName = null;
        _inviteEmployeeEmail = null;
        _actionSuccess = "Invitation sent.";
        await LoadAsync();
    }
}
