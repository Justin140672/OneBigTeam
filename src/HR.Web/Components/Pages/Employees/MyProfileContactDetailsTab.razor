@using System.ComponentModel.DataAnnotations
@inject EmployeeService EmployeeService
@inject AppSession Session
@inherits EditSectionBase<MyProfileContactDetailsTab.ContactDetailsFormModel>

@if (!Session.EmployeeId.HasValue || Session.EmployeeId.Value != EmployeeId)
{
    <div class="alert alert-danger">
        <i class="fa-solid fa-lock me-2"></i>You can only view your own contact details.
    </div>
}
else if (IsLoading)
{
    <div class="d-flex align-items-center gap-2 py-3">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span class="text-muted">Loading…</span>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(SuccessMsg))
    {
        <div class="cd-success-banner mb-3">
            <i class="fa-solid fa-circle-check cd-success-icon"></i>
            <div>
                <div class="cd-success-title">Contact details saved</div>
                <div class="cd-success-body">Your contact details have been updated.</div>
            </div>
            <button class="cd-success-dismiss" @onclick="@(() => SuccessMsg = null)">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    @if (GlobalError is not null)
    {
        <div class="alert alert-danger alert-dismissible mb-3">
            @GlobalError
            <button type="button" class="btn-close" @onclick="@(() => GlobalError = null)"></button>
        </div>
    }

    <EditForm EditContext="EditContext">
        <DataAnnotationsValidator />
        <div class="cd-card">
            <div class="cd-card-header">
                <i class="fa-solid fa-address-book cd-card-icon"></i>
                <span class="cd-card-title">Contact Details</span>
            </div>

            <div class="cd-form-body">
                <!-- Email -->
                <div class="cd-section-label">Email</div>

                <div class="cd-field-group">
                    <label class="cd-label">Work Email</label>
                    <input class="form-control cd-readonly" type="email" value="@_workEmail" readonly />
                    <div class="cd-hint">Your work email is managed by HR and cannot be changed here.</div>
                </div>

                <div class="cd-field-group">
                    <label class="cd-label">Personal Email</label>
                    <input class="form-control" type="email" @bind="Model.PersonalEmail" placeholder="e.g. name@personal.com" maxlength="320" />
                    <ValidationMessage For="@(() => Model.PersonalEmail)" />
                </div>

                <!-- Phone -->
                <div class="cd-section-label mt-3">Phone Numbers</div>

                <div class="cd-field-row">
                    <div class="cd-field-group">
                        <label class="cd-label">Mobile / Work Phone</label>
                        <input class="form-control" type="tel" @bind="Model.PhoneNumber" placeholder="e.g. 07700 900000" maxlength="30" />
                    </div>
                    <div class="cd-field-group">
                        <label class="cd-label">Home Phone</label>
                        <input class="form-control" type="tel" @bind="Model.HomePhone" placeholder="e.g. 01234 567890" maxlength="30" />
                    </div>
                </div>

                <!-- Address -->
                <div class="cd-section-label mt-3">Home Address</div>

                <div class="cd-field-group">
                    <label class="cd-label">Address Line 1 <span class="cd-required">*</span></label>
                    <input class="form-control" @bind="Model.AddressLine1" placeholder="Street address" maxlength="200" />
                    <ValidationMessage For="@(() => Model.AddressLine1)" />
                </div>

                <div class="cd-field-group">
                    <label class="cd-label">Address Line 2</label>
                    <input class="form-control" @bind="Model.AddressLine2" placeholder="Apartment, suite, etc." maxlength="200" />
                </div>

                <div class="cd-field-row">
                    <div class="cd-field-group">
                        <label class="cd-label">City <span class="cd-required">*</span></label>
                        <input class="form-control" @bind="Model.City" placeholder="e.g. London" maxlength="100" />
                        <ValidationMessage For="@(() => Model.City)" />
                    </div>
                    <div class="cd-field-group">
                        <label class="cd-label">County / State</label>
                        <input class="form-control" @bind="Model.County" placeholder="e.g. Greater London" maxlength="100" />
                    </div>
                </div>

                <div class="cd-field-row">
                    <div class="cd-field-group">
                        <label class="cd-label">Post Code <span class="cd-required">*</span></label>
                        <input class="form-control" @bind="Model.PostCode" placeholder="e.g. SW1A 1AA" maxlength="20" />
                        <ValidationMessage For="@(() => Model.PostCode)" />
                    </div>
                    <div class="cd-field-group">
                        <label class="cd-label">Country <span class="cd-required">*</span></label>
                        <input class="form-control" @bind="Model.Country" placeholder="e.g. United Kingdom" maxlength="100" />
                        <ValidationMessage For="@(() => Model.Country)" />
                    </div>
                </div>

                <div class="cd-form-footer">
                    <SfButton IsPrimary="true" Disabled="@_saving" OnClick="SaveClickedAsync">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Save Changes
                    </SfButton>
                </div>
            </div>
        </div>
    </EditForm>
}

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId { get; set; }

    private bool _saving;
    private string _workEmail = string.Empty;

    protected override async Task LoadAsync()
    {
        if (!Session.EmployeeId.HasValue || Session.EmployeeId.Value != EmployeeId)
            return;

        var details = await EmployeeService.GetMyContactDetailsAsync(CompanyId);
        if (details is not null)
        {
            _workEmail = details.WorkEmail;
            Model.PersonalEmail = details.PersonalEmail;
            Model.PhoneNumber = details.PhoneNumber;
            Model.HomePhone = details.HomePhone;
            Model.AddressLine1 = details.AddressLine1 ?? string.Empty;
            Model.AddressLine2 = details.AddressLine2;
            Model.City = details.City ?? string.Empty;
            Model.County = details.County;
            Model.PostCode = details.PostCode ?? string.Empty;
            Model.Country = details.Country ?? string.Empty;
        }
    }

    // The base SaveAsync() is normally called by a parent page's own Save button; here the
    // component drives its own button, so wrap it to manage this component's spinner state.
    private async Task SaveClickedAsync()
    {
        _saving = true;
        await SaveAsync();
        _saving = false;
    }

    protected override async Task<string?> SaveCoreAsync()
    {
        var request = new UpdateMyContactDetailsRequest(
            CompanyId,
            string.IsNullOrWhiteSpace(Model.PersonalEmail) ? null : Model.PersonalEmail.Trim(),
            string.IsNullOrWhiteSpace(Model.PhoneNumber)   ? null : Model.PhoneNumber.Trim(),
            string.IsNullOrWhiteSpace(Model.HomePhone)     ? null : Model.HomePhone.Trim(),
            Model.AddressLine1.Trim(),
            string.IsNullOrWhiteSpace(Model.AddressLine2)  ? null : Model.AddressLine2.Trim(),
            Model.City.Trim(),
            string.IsNullOrWhiteSpace(Model.County)        ? null : Model.County.Trim(),
            Model.PostCode.Trim(),
            Model.Country.Trim());

        var (success, errorMsg) = await EmployeeService.UpdateMyContactDetailsAsync(CompanyId, request);

        return success ? null : errorMsg ?? "Failed to save contact details.";
    }

    public sealed class ContactDetailsFormModel
    {
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string? PersonalEmail { get; set; }
        public string? PhoneNumber { get; set; }
        public string? HomePhone { get; set; }
        [Required(ErrorMessage = "Address line 1 is required.")]
        public string AddressLine1 { get; set; } = string.Empty;
        public string? AddressLine2 { get; set; }
        [Required(ErrorMessage = "City is required.")]
        public string City { get; set; } = string.Empty;
        public string? County { get; set; }
        [Required(ErrorMessage = "Post code is required.")]
        public string PostCode { get; set; } = string.Empty;
        [Required(ErrorMessage = "Country is required.")]
        public string Country { get; set; } = string.Empty;
    }
}
