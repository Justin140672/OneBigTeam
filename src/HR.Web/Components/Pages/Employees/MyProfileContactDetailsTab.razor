@using System.ComponentModel.DataAnnotations
@inject EmployeeService EmployeeService
@inject AppSession Session
@inject IJSRuntime JS
@inherits EditSectionBase<MyProfileContactDetailsTab.ContactDetailsFormModel>

@if (!Session.EmployeeId.HasValue || Session.EmployeeId.Value != EmployeeId)
{
    <div class="alert alert-danger" role="alert">
        <i class="fa-solid fa-lock me-2" aria-hidden="true"></i>You can only view your own contact details.
    </div>
}
else if (IsLoading)
{
    <HrLoadingIndicator />
}
else
{
    @if (!string.IsNullOrEmpty(SuccessMsg))
    {
        <div class="cd-success-banner mb-3" role="status" aria-live="polite">
            <i class="fa-solid fa-circle-check cd-success-icon" aria-hidden="true"></i>
            <div>
                <div class="cd-success-title">Contact details saved</div>
                <div class="cd-success-body">Your contact details have been updated.</div>
            </div>
            <button type="button" class="cd-success-dismiss" aria-label="Dismiss confirmation" @onclick="DismissSuccessAsync">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </div>
    }

    <SaveConflictBanner Visible="SaveConflict"
                        Disabled="@_saving"
                        OnReload="ReloadLatestClickedAsync"
                        Message="Someone else changed your details while you were editing. Your changes have not been saved." />

    @if (!SaveConflict && GlobalError is not null)
    {
        <div class="alert alert-danger alert-dismissible mb-3" role="alert">
            @GlobalError
            <button type="button" class="btn-close" aria-label="Dismiss error" @onclick="DismissGlobalErrorAsync"></button>
        </div>
    }

    <EditForm EditContext="EditContext">
        <DataAnnotationsValidator />
        <div id="cd-form" class="cd-card">
            <div class="cd-card-header">
                <i class="fa-solid fa-address-book cd-card-icon" aria-hidden="true"></i>
                <span class="cd-card-title">Contact Details</span>
            </div>

            <div class="cd-form-body">
                <!-- Email -->
                <div class="cd-section-label">Email</div>

                <div class="cd-field-group">
                    <label class="cd-label" for="cd-work-email">Work Email</label>
                    <input id="cd-work-email" class="form-control cd-readonly" type="email" value="@_workEmail" readonly
                           aria-label="Work Email" aria-describedby="cd-work-email-hint" />
                    <div id="cd-work-email-hint" class="cd-hint">Your work email is managed by HR and cannot be changed here.</div>
                </div>

                <div class="cd-field-group">
                    <label class="cd-label" for="cd-personal-email">Personal Email</label>
                    <HrTextBox @bind-Value="Model.PersonalEmail" Type="InputType.Email" Placeholder="e.g. name@personal.com" Maxlength="320"
                               HtmlAttributes="@Attrs("cd-personal-email", "Personal Email")" />
                    <div id="cd-personal-email-hint" class="cd-hint visually-hidden">Optional. Used for personal correspondence only.</div>
                    <div id="cd-personal-email-error" class="cd-error"><ValidationMessage For="@(() => Model.PersonalEmail)" /></div>
                </div>

                <!-- Address -->
                <div class="cd-section-label mt-3">Home Address</div>

                <div class="cd-field-group">
                    <label class="cd-label" for="cd-address-line-1">Address Line 1 <span class="cd-required" aria-hidden="true">*</span></label>
                    <HrTextBox @bind-Value="Model.AddressLine1" Placeholder="Street address" Maxlength="200"
                               HtmlAttributes="@Attrs("cd-address-line-1", "Address Line 1", required: true)" />
                    <div id="cd-address-line-1-hint" class="cd-hint visually-hidden">Required.</div>
                    <div id="cd-address-line-1-error" class="cd-error"><ValidationMessage For="@(() => Model.AddressLine1)" /></div>
                </div>

                <div class="cd-field-group">
                    <label class="cd-label" for="cd-address-line-2">Address Line 2</label>
                    <HrTextBox @bind-Value="Model.AddressLine2" Placeholder="Apartment, suite, etc." Maxlength="200"
                               HtmlAttributes="@Attrs("cd-address-line-2", "Address Line 2")" />
                    <div id="cd-address-line-2-hint" class="cd-hint visually-hidden">Optional.</div>
                    <div id="cd-address-line-2-error" class="cd-error"></div>
                </div>

                <div class="cd-field-row">
                    <div class="cd-field-group">
                        <label class="cd-label" for="cd-city">City <span class="cd-required" aria-hidden="true">*</span></label>
                        <HrTextBox @bind-Value="Model.City" Placeholder="e.g. London" Maxlength="100"
                                   HtmlAttributes="@Attrs("cd-city", "City", required: true)" />
                        <div id="cd-city-hint" class="cd-hint visually-hidden">Required.</div>
                        <div id="cd-city-error" class="cd-error"><ValidationMessage For="@(() => Model.City)" /></div>
                    </div>
                    <div class="cd-field-group">
                        <label class="cd-label" for="cd-county">County / State</label>
                        <HrTextBox @bind-Value="Model.County" Placeholder="e.g. Greater London" Maxlength="100"
                                   HtmlAttributes="@Attrs("cd-county", "County / State")" />
                        <div id="cd-county-hint" class="cd-hint visually-hidden">Optional.</div>
                        <div id="cd-county-error" class="cd-error"></div>
                    </div>
                </div>

                <div class="cd-field-row">
                    <div class="cd-field-group">
                        <label class="cd-label" for="cd-post-code">Post Code <span class="cd-required" aria-hidden="true">*</span></label>
                        <HrTextBox @bind-Value="Model.PostCode" Placeholder="e.g. SW1A 1AA" Maxlength="20"
                                   HtmlAttributes="@Attrs("cd-post-code", "Post Code", required: true)" />
                        <div id="cd-post-code-hint" class="cd-hint visually-hidden">Required.</div>
                        <div id="cd-post-code-error" class="cd-error"><ValidationMessage For="@(() => Model.PostCode)" /></div>
                    </div>
                    @* Country is not shown — UK-only for now. Model.Country defaults to "United
                       Kingdom" and is preserved from the loaded value if one is already set. *@
                </div>

                <!-- Phone -->
                <div class="cd-section-label mt-3">Phone Numbers</div>

                <div class="cd-field-row">
                    <div class="cd-field-group">
                        <label class="cd-label" for="cd-phone-number">Mobile / Work Phone</label>
                        <HrTextBox @bind-Value="Model.PhoneNumber" Type="InputType.Tel" Placeholder="e.g. 07700 900000" Maxlength="30"
                                   HtmlAttributes="@Attrs("cd-phone-number", "Mobile / Work Phone")" />
                        <div id="cd-phone-number-hint" class="cd-hint visually-hidden">Optional.</div>
                        <div id="cd-phone-number-error" class="cd-error"><ValidationMessage For="@(() => Model.PhoneNumber)" /></div>
                    </div>
                    <div class="cd-field-group">
                        <label class="cd-label" for="cd-home-phone">Home Phone</label>
                        <HrTextBox @bind-Value="Model.HomePhone" Type="InputType.Tel" Placeholder="e.g. 01234 567890" Maxlength="30"
                                   HtmlAttributes="@Attrs("cd-home-phone", "Home Phone")" />
                        <div id="cd-home-phone-hint" class="cd-hint visually-hidden">Optional.</div>
                        <div id="cd-home-phone-error" class="cd-error"><ValidationMessage For="@(() => Model.HomePhone)" /></div>
                    </div>
                </div>

                <div class="cd-form-footer">
                    <SfButton IsPrimary="true" Disabled="@_saving" OnClick="SaveClickedAsync"
                              HtmlAttributes="@(new Dictionary<string, object> { ["id"] = "cd-save-button" })">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        }
                        Save Changes
                    </SfButton>
                </div>
            </div>
        </div>
    </EditForm>
}

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId { get; set; }

    private bool _saving;
    private string _workEmail = string.Empty;

    // Builds the HtmlAttributes bag for an HrTextBox: a stable id (for label `for=`), a mirrored
    // aria-label (Syncfusion wraps the input so for/id can be flaky — same belt-and-braces approach
    // as EmployeeEdit), aria-describedby wiring the field to its hint + error containers, and
    // aria-required for the mandatory fields. `required` is deliberately expressed via aria only —
    // a native `required` attribute on the Syncfusion-wrapped input changes its :invalid styling
    // and pseudo-class behaviour, which the existing visual design and E2E selectors don't expect.
    private static Dictionary<string, object> Attrs(string id, string ariaLabel, bool required = false)
    {
        var attrs = new Dictionary<string, object>
        {
            ["id"] = id,
            ["aria-label"] = ariaLabel,
            ["aria-describedby"] = $"{id}-hint {id}-error",
        };
        if (required)
            attrs["aria-required"] = "true";
        return attrs;
    }

    private async Task DismissSuccessAsync()
    {
        SuccessMsg = null;
        await JS.InvokeVoidAsync("hrFocusById", "cd-save-button");
    }

    private async Task DismissGlobalErrorAsync()
    {
        GlobalError = null;
        await JS.InvokeVoidAsync("hrFocusById", "cd-save-button");
    }

    protected override async Task LoadAsync()
    {
        if (!Session.EmployeeId.HasValue || Session.EmployeeId.Value != EmployeeId)
            return;

        Model.PostcodeRegexPattern = Session.PostcodeRegex;
        Model.TelephoneRegexPattern = Session.TelephoneRegex;
        Model.MobileRegexPattern = Session.MobileRegex;

        var details = await EmployeeService.GetMyContactDetailsAsync(CompanyId);
        if (details is not null)
        {
            _workEmail = details.WorkEmail;
            LoadedVersion = details.Version;
            Model.PersonalEmail = details.PersonalEmail;
            Model.PhoneNumber = details.PhoneNumber;
            Model.HomePhone = details.HomePhone;
            Model.AddressLine1 = details.AddressLine1 ?? string.Empty;
            Model.AddressLine2 = details.AddressLine2;
            Model.City = details.City ?? string.Empty;
            Model.County = details.County;
            Model.PostCode = details.PostCode ?? string.Empty;
            Model.Country = string.IsNullOrWhiteSpace(details.Country) ? "United Kingdom" : details.Country;
        }
    }

    // The base SaveAsync() is normally called by a parent page's own Save button; here the
    // component drives its own button, so wrap it to manage this component's spinner state.
    private async Task SaveClickedAsync()
    {
        _saving = true;
        var error = await SaveAsync();
        _saving = false;

        // Accessibility: on a client-side validation failure move focus to the first invalid field
        // so a screen-reader / keyboard user is taken straight to the problem. Server errors and
        // concurrency conflicts are announced via their live-region banners without stealing focus.
        if (error is not null && !SaveConflict && EditContext.GetValidationMessages().Any())
        {
            await JS.InvokeVoidAsync("hrFocusFirstInvalid", "#cd-form");
        }
    }

    // Concurrency-conflict recovery: explicit user reload — adopt the latest server values and
    // re-baseline unsaved-changes tracking (rebaseline: true). The base handles the re-fetch,
    // version refresh and clearing the banner.
    private async Task ReloadLatestClickedAsync()
    {
        _saving = true;
        await ReloadLatestValuesAsync(rebaseline: true);
        _saving = false;

        // Orient the user on the refreshed values by moving focus to the first form field.
        await JS.InvokeVoidAsync("hrFocusById", "cd-personal-email");
    }

    protected override async Task<string?> SaveCoreAsync()
    {
        var request = new UpdateMyContactDetailsRequest(
            CompanyId,
            string.IsNullOrWhiteSpace(Model.PersonalEmail) ? null : Model.PersonalEmail.Trim(),
            string.IsNullOrWhiteSpace(Model.PhoneNumber)   ? null : Model.PhoneNumber.Trim(),
            string.IsNullOrWhiteSpace(Model.HomePhone)     ? null : Model.HomePhone.Trim(),
            Model.AddressLine1.Trim(),
            string.IsNullOrWhiteSpace(Model.AddressLine2)  ? null : Model.AddressLine2.Trim(),
            Model.City.Trim(),
            string.IsNullOrWhiteSpace(Model.County)        ? null : Model.County.Trim(),
            Model.PostCode.Trim(),
            Model.Country.Trim(),
            ExpectedVersion: ExpectedVersionForSave);

        var result = await EmployeeService.UpdateMyContactDetailsAsync(CompanyId, request);
        return ApplySaveResult(result, "Failed to save contact details.");
    }

    public sealed class ContactDetailsFormModel
    {
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string? PersonalEmail { get; set; }
        [DynamicRegex(nameof(MobileRegexPattern), ErrorMessage = "Enter a valid mobile number.")]
        public string? PhoneNumber { get; set; }
        [DynamicRegex(nameof(TelephoneRegexPattern), ErrorMessage = "Enter a valid phone number.")]
        public string? HomePhone { get; set; }
        [Required(ErrorMessage = "Address line 1 is required.")]
        public string AddressLine1 { get; set; } = string.Empty;
        public string? AddressLine2 { get; set; }
        [Required(ErrorMessage = "City is required.")]
        public string City { get; set; } = string.Empty;
        public string? County { get; set; }
        private string _postCode = string.Empty;
        [Required(ErrorMessage = "Post code is required.")]
        [DynamicRegex(nameof(PostcodeRegexPattern), ErrorMessage = "Enter a valid postcode.")]
        public string PostCode
        {
            get => _postCode;
            set => _postCode = value.ToUpperInvariant();
        }
        // Not user-editable (UK-only for now) — no input is rendered. Defaults here and is
        // preserved from the loaded value on OnLoadedAsync if the record already has one.
        [Required(ErrorMessage = "Country is required.")]
        public string Country { get; set; } = "United Kingdom";

        public string? PostcodeRegexPattern { get; set; }
        public string? TelephoneRegexPattern { get; set; }
        public string? MobileRegexPattern { get; set; }
    }
}
