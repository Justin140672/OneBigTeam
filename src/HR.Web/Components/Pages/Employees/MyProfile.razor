@page "/companies/{CompanyId:guid}/employees/{EmployeeId:guid}/profile"
@rendermode InteractiveServer
@inject AppSession Session

<PageTitle>My Profile</PageTitle>

<div class="container py-4">
    <h1 class="mb-4">@Session.DisplayName</h1>

    <SfTab>
        <TabItems>
            <TabItem>
                <ChildContent><TabHeader Text="Overview" /></ChildContent>
                <ContentTemplate>
                    <div class="mt-4"><MyProfileOverviewTab CompanyId="CompanyId" EmployeeId="EmployeeId" /></div>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent><TabHeader Text="Leave" /></ChildContent>
                <ContentTemplate>
                    <div class="mt-4"><MyProfileLeaveTab CompanyId="CompanyId" EmployeeId="EmployeeId" /></div>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent><TabHeader Text="Documents" /></ChildContent>
                <ContentTemplate>
                    <div class="mt-4"><MyProfileDocumentsTab CompanyId="CompanyId" EmployeeId="EmployeeId" /></div>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent><TabHeader Text="Tasks" /></ChildContent>
                <ContentTemplate>
                    <div class="mt-4"><MyProfileTasksTab CompanyId="CompanyId" /></div>
                </ContentTemplate>
            </TabItem>
        </TabItems>
    </SfTab>
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid EmployeeId { get; set; }
}
