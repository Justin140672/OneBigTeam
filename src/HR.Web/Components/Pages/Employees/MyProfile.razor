@page "/companies/{CompanyId:guid}/employees/{EmployeeId:guid}/profile"
@rendermode InteractiveServer
@inject AppSession Session
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.WebUtilities

<PageTitle>My Profile</PageTitle>

<div class="container py-4">
    <h1 class="mb-1">@Session.DisplayName</h1>
    <p class="text-muted mb-4">View and manage your personal details, leave, documents, and tasks.</p>

    <SfTab @bind-SelectedItem="_activeTabIndex">
        <TabItems>
            <TabItem>
                <ChildContent><TabHeader Text="Overview" /></ChildContent>
                <ContentTemplate>
                    <div class="mt-4">
                        <MyProfileOverviewTab CompanyId="CompanyId"
                                             EmployeeId="EmployeeId"
                                             OnNavigateToLeave="NavigateToLeaveAndOpen"
                                             OnNavigateToSickness="NavigateToSicknessAndOpen"
                                             OnNavigateToDocuments="() => _activeTabIndex = 6"
                                             OnNavigateToTasks="() => _activeTabIndex = 7" />
                    </div>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent><TabHeader Text="Personal Details" /></ChildContent>
                <ContentTemplate>
                    <div class="mt-4"><MyProfilePersonalDetailsTab CompanyId="CompanyId" EmployeeId="EmployeeId" /></div>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent><TabHeader Text="Contact Details" /></ChildContent>
                <ContentTemplate>
                    <div class="mt-4"><MyProfileContactDetailsTab CompanyId="CompanyId" EmployeeId="EmployeeId" /></div>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent><TabHeader Text="Emergency Contacts" /></ChildContent>
                <ContentTemplate>
                    <div class="mt-4"><MyProfileEmergencyContactsTab CompanyId="CompanyId" EmployeeId="EmployeeId" /></div>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent><TabHeader Text="Leave" /></ChildContent>
                <ContentTemplate>
                    <div class="mt-4"><MyProfileLeaveTab CompanyId="CompanyId" EmployeeId="EmployeeId"
                                                         AutoOpenToken="_leaveAutoOpenToken" /></div>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent><TabHeader Text="Sickness" /></ChildContent>
                <ContentTemplate>
                    <div class="mt-4"><MyProfileSicknessTab CompanyId="CompanyId" EmployeeId="EmployeeId"
                                                            AutoOpenToken="_sicknessAutoOpenToken" /></div>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent><TabHeader Text="Documents" /></ChildContent>
                <ContentTemplate>
                    <div class="mt-4"><MyProfileDocumentsTab CompanyId="CompanyId" EmployeeId="EmployeeId" /></div>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent><TabHeader Text="Tasks" /></ChildContent>
                <ContentTemplate>
                    <div class="mt-4"><MyProfileTasksTab CompanyId="CompanyId" /></div>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent><TabHeader Text="Assets" /></ChildContent>
                <ContentTemplate>
                    <div class="mt-4"><MyProfileAssetsTab CompanyId="CompanyId" EmployeeId="EmployeeId" /></div>
                </ContentTemplate>
            </TabItem>
        </TabItems>
    </SfTab>
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid EmployeeId { get; set; }

    private int _activeTabIndex;
    private int _leaveAutoOpenToken;
    private int _sicknessAutoOpenToken;

    protected override async Task OnParametersSetAsync()
    {
        await Session.InitialiseAsync();

        // Redirect if the URL's company or employee doesn't match the signed-in user.
        // This prevents cross-tenant profile URL access.
        if (Session.CompanyId != CompanyId || Session.EmployeeId != (Guid?)EmployeeId)
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (query.TryGetValue("tab", out var tab))
        {
            _activeTabIndex = tab.ToString() switch
            {
                "tasks"  => 7,
                "assets" => 8,
                _        => 0
            };
        }
    }

    private void NavigateToLeaveAndOpen()
    {
        _activeTabIndex = 4;
        _leaveAutoOpenToken++;
    }

    private void NavigateToSicknessAndOpen()
    {
        _activeTabIndex = 5;
        _sicknessAutoOpenToken++;
    }
}
