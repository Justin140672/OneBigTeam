@using HR.Web.Models
@inject ProfilePhotoService ProfilePhotoService

<div class="card" data-testid="profile-photo-review-panel">
    <div class="card-header fw-medium">Review Profile Photo</div>
    <div class="card-body">
        @if (_justCompleted)
        {
            <div class="d-flex align-items-center gap-2 mb-3">
                <i class="fa-solid fa-circle-check text-success fs-5"></i>
                <span class="fw-medium">Review completed.</span>
                @if (_successOutcome is not null)
                {
                    <span>Outcome: <strong data-testid="review-outcome">@_successOutcome</strong></span>
                }
            </div>
            <SfButton CssClass="e-outline e-small" OnClick="DismissAsync">Done</SfButton>
        }
        else
        {
            @if (_pending is not null)
            {
                <div class="d-flex align-items-center gap-2 mb-3">
                    <img src="@_pending.DownloadUrl" alt="Pending photo" class="pending-photo-thumb" />
                    <div>
                        <div class="fw-semibold small">Pending Review</div>
                        <div class="small text-muted">Submitted @_pending.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
                    </div>
                </div>
                <hr class="my-3" />

                @if (_showRejectReason)
                {
                    <HrTextBox @bind-Value="_rejectReason" Placeholder="Reason for rejection (optional)" CssClass="mb-2 w-100" />
                    <div class="d-flex gap-2">
                        <SfButton CssClass="e-small" IsPrimary="true" Disabled="@_reviewing" OnClick="ConfirmRejectAsync">Confirm Reject</SfButton>
                        <SfButton CssClass="e-small e-flat" Disabled="@_reviewing" OnClick="@(() => _showRejectReason = false)">Back</SfButton>
                    </div>
                }
                else
                {
                    <div class="d-flex gap-2">
                        <SfButton CssClass="e-small" IsPrimary="true" Disabled="@_reviewing" OnClick="ApproveAsync">
                            @if (_reviewing)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            Approve
                        </SfButton>
                        <SfButton CssClass="e-small" Disabled="@_reviewing" OnClick="@(() => _showRejectReason = true)">Reject</SfButton>
                    </div>
                }
            }
            else if (_loading)
            {
                <HrLoadingIndicator Label="Loading photo…" />
            }
            else
            {
                <div class="alert alert-warning mb-0">This pending photo could not be found. It may have already been reviewed.</div>
            }

            @if (_error is not null)
            {
                <div class="alert alert-danger mt-3 mb-0">@_error</div>
            }
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public TaskDetailModel Task { get; set; } = null!;
    [Parameter] public EventCallback OnCompleted { get; set; }

    private GetPendingProfilePhotoByIdResponse? _pending;
    private bool _loading;
    private bool _reviewing;
    private bool _showRejectReason;
    private string? _rejectReason;
    private string? _error;
    private bool _justCompleted;
    private string? _successOutcome;

    protected override async Task OnParametersSetAsync()
    {
        if (_justCompleted) return;

        if (Task.SourceEntityId.HasValue)
        {
            _loading = true;
            _pending = await ProfilePhotoService.GetPendingProfilePhotoByIdAsync(CompanyId, Task.SourceEntityId.Value);
            _loading = false;
        }
    }

    private async Task ApproveAsync()
    {
        if (_pending is null) return;

        _reviewing = true;
        _error = null;
        StateHasChanged();

        var error = await ProfilePhotoService.ApproveProfilePhotoAsync(CompanyId, _pending.EmployeeId);

        _reviewing = false;

        if (error is not null)
        {
            _error = error;
        }
        else
        {
            _justCompleted = true;
            _successOutcome = "Approved";
        }
    }

    private async Task ConfirmRejectAsync()
    {
        if (_pending is null) return;

        _reviewing = true;
        _error = null;
        StateHasChanged();

        var error = await ProfilePhotoService.RejectProfilePhotoAsync(CompanyId, _pending.EmployeeId, _rejectReason);

        _reviewing = false;

        if (error is not null)
        {
            _error = error;
        }
        else
        {
            _showRejectReason = false;
            _rejectReason = null;
            _justCompleted = true;
            _successOutcome = "Rejected";
        }
    }

    private async Task DismissAsync() => await OnCompleted.InvokeAsync();
}
