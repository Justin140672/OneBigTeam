@page "/companies/{CompanyId:guid}/employees/new"
@page "/companies/{CompanyId:guid}/employees/{Id:guid}"
@rendermode InteractiveServer
@inject EmployeeService EmployeeService
@inject DepartmentService DepartmentService
@inject PositionProfileService PositionProfileService
@inject InviteService InviteService
@inject NavigationManager Navigation
@using HR.SharedKernel

<PageTitle>@PageTitle</PageTitle>

<div class="container py-4">
    <SfBreadcrumb Class="mb-3">
        <BreadcrumbItems>
            <BreadcrumbItem Text="Employees" Url="@($"/companies/{CompanyId}/employees")" />
            <BreadcrumbItem Text="@PageTitle" />
        </BreadcrumbItems>
    </SfBreadcrumb>

    @if (_loading)
    {
        <div class="d-flex align-items-center gap-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Loading…</span>
        </div>
    }
    else if (IsNew)
    {
        <h1 class="mb-4">Add Employee</h1>

        @if (!string.IsNullOrEmpty(_globalError))
        {
            <div class="alert alert-danger">@_globalError</div>
        }

        <div class="row">
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Personal Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">First Name <span class="text-danger">*</span></label>
                                <HrTextBox @bind-Value="_model.FirstName" Placeholder="First name" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Last Name <span class="text-danger">*</span></label>
                                <HrTextBox @bind-Value="_model.LastName" Placeholder="Last name" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Work Email <span class="text-danger">*</span></label>
                                <HrTextBox @bind-Value="_model.WorkEmail" Placeholder="work@company.com" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Personal Email</label>
                                <HrTextBox @bind-Value="_model.PersonalEmail" Placeholder="personal@example.com" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Start Date <span class="text-danger">*</span></label>
                                <SfDatePicker TValue="DateOnly" @bind-Value="_model.StartDate" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Department</label>
                                <SfDropDownList TValue="Guid?"
                                                TItem="DepartmentListItemModel"
                                                DataSource="@_departments"
                                                @bind-Value="_model.DepartmentId"
                                                Placeholder="None"
                                                AllowFiltering="true">
                                    <DropDownListFieldSettings Value="Id" Text="Name" />
                                </SfDropDownList>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Position Profile</label>
                                <SfDropDownList TValue="Guid?"
                                                TItem="PositionProfileListItemModel"
                                                DataSource="@_positionProfiles"
                                                @bind-Value="_model.PositionProfileId"
                                                Placeholder="None"
                                                AllowFiltering="true">
                                    <DropDownListFieldSettings Value="Id" Text="Title" />
                                </SfDropDownList>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">System Access</h5>
                    </div>
                    <div class="card-body">
                        <SfCheckBox TChecked="bool"
                                    Label="Employee needs system access (can log in)"
                                    @bind-Checked="_model.HasSystemAccess" />
                        @if (_model.HasSystemAccess)
                        {
                            <hr class="my-3" />
                            <SfCheckBox TChecked="bool"
                                        Label="Send invite link after creating employee"
                                        @bind-Checked="_sendInviteOnCreate" />
                        }
                    </div>
                </div>

                <div class="d-flex gap-2 align-items-center mt-3">
                    @if (!string.IsNullOrEmpty(_successMsg))
                    {
                        <div class="alert alert-success py-2 mb-0 d-flex align-items-center">@_successMsg</div>
                    }
                    <SfButton IsPrimary="true" Disabled="@_saving" OnClick="Save">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Save
                    </SfButton>
                    <SfButton OnClick="Cancel" Disabled="@_saving">Cancel</SfButton>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex align-items-center gap-3 mb-3">
            <h1 class="mb-0">@(_employee?.FirstName) @(_employee?.LastName)</h1>
            @if (_employee is not null)
            {
                <span class="badge rounded-pill px-3 py-2 fs-6 fw-normal @StatusBadgeClass(_employee.Status)">@_employee.Status</span>
            }
        </div>

        @if (!string.IsNullOrEmpty(_globalError))
        {
            <div class="alert alert-danger mb-3">@_globalError</div>
        }

        <SfTab>
            <TabItems>

                <TabItem>
                    <ChildContent><TabHeader Text="Details" /></ChildContent>
                    <ContentTemplate>
                        <div class="mt-4 row">
                            <div class="col-lg-8">
                                <div class="card mb-4">
                                    <div class="card-header">
                                        <h5 class="mb-0">Personal Information</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label">First Name <span class="text-danger">*</span></label>
                                                <HrTextBox @bind-Value="_model.FirstName" Placeholder="First name" />
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">Last Name <span class="text-danger">*</span></label>
                                                <HrTextBox @bind-Value="_model.LastName" Placeholder="Last name" />
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">Work Email <span class="text-danger">*</span></label>
                                                <HrTextBox @bind-Value="_model.WorkEmail" Placeholder="work@company.com" />
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">Personal Email</label>
                                                <HrTextBox @bind-Value="_model.PersonalEmail" Placeholder="personal@example.com" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Start Date <span class="text-danger">*</span></label>
                                                <SfDatePicker TValue="DateOnly" @bind-Value="_model.StartDate" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Department</label>
                                                <SfDropDownList TValue="Guid?"
                                                                TItem="DepartmentListItemModel"
                                                                DataSource="@_departments"
                                                                @bind-Value="_model.DepartmentId"
                                                                Placeholder="None"
                                                                AllowFiltering="true">
                                                    <DropDownListFieldSettings Value="Id" Text="Name" />
                                                </SfDropDownList>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Position Profile</label>
                                                <SfDropDownList TValue="Guid?"
                                                                TItem="PositionProfileListItemModel"
                                                                DataSource="@_positionProfiles"
                                                                @bind-Value="_model.PositionProfileId"
                                                                Placeholder="None"
                                                                AllowFiltering="true">
                                                    <DropDownListFieldSettings Value="Id" Text="Title" />
                                                </SfDropDownList>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card mb-4">
                                    <div class="card-header">
                                        <h5 class="mb-0">System Access</h5>
                                    </div>
                                    <div class="card-body">
                                        <SfCheckBox TChecked="bool"
                                                    Label="Employee needs system access (can log in)"
                                                    @bind-Checked="_model.HasSystemAccess" />
                                        @if (_model.HasSystemAccess)
                                        {
                                            <hr class="my-3" />
                                            @if (!string.IsNullOrEmpty(_inviteError))
                                            {
                                                <div class="alert alert-danger py-2">@_inviteError</div>
                                            }
                                            @if (_inviteLink is not null)
                                            {
                                                <div class="alert alert-success py-2">
                                                    <div class="mb-1"><strong>Invite link generated</strong> — expires @_inviteExpiresAt.ToString("MMM d, yyyy")</div>
                                                    <div class="input-group">
                                                        <input class="form-control form-control-sm font-monospace" readonly value="@_inviteLink" />
                                                        <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="CopyLink">Copy</button>
                                                    </div>
                                                    <small class="text-muted">Share this link with the employee to let them set their password.</small>
                                                </div>
                                            }
                                            else
                                            {
                                                <p class="text-muted small mb-2">Generate an invite link to send to the employee so they can set their password and access the system.</p>
                                                <SfButton OnClick="SendInvite" Disabled="@_sendingInvite">
                                                    @if (_sendingInvite)
                                                    {
                                                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                                    }
                                                    Generate Invite Link
                                                </SfButton>
                                            }
                                        }
                                    </div>
                                </div>

                                <div class="card mb-4">
                                    <div class="card-header">
                                        <h5 class="mb-0">Working Pattern</h5>
                                    </div>
                                    <div class="card-body">
                                        <SfCheckBox TChecked="bool"
                                                    Label="Override company defaults"
                                                    Checked="@_model.OverrideWorkingPattern"
                                                    CheckedChanged="@((bool v) => _model.OverrideWorkingPattern = v)" />
                                        @if (_model.OverrideWorkingPattern)
                                        {
                                            <div class="row g-3 mt-2">
                                                <div class="col-12">
                                                    <label class="form-label fw-semibold">Working Days</label>
                                                    <div class="d-flex flex-wrap gap-3 mt-1">
                                                        @foreach (var day in _allDays)
                                                        {
                                                            <SfCheckBox TChecked="bool" Label="@day"
                                                                        Checked="@_model.WorkingWeek.Contains(day)"
                                                                        CheckedChanged="@(e => ToggleWorkingDay(day, e))" />
                                                        }
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <SfNumericTextBox TValue="decimal" @bind-Value="_model.HoursPerDay"
                                                                      Placeholder="Hours Per Day"
                                                                      FloatLabelType="FloatLabelType.Auto"
                                                                      Min="0.5m" Max="24m" Step="0.5m" />
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="d-flex gap-2 align-items-center mt-3">
                                    @if (!string.IsNullOrEmpty(_successMsg))
                                    {
                                        <div class="alert alert-success py-2 mb-0 d-flex align-items-center">@_successMsg</div>
                                    }
                                    <SfButton IsPrimary="true" Disabled="@_saving" OnClick="Save">
                                        @if (_saving)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                        }
                                        Save
                                    </SfButton>
                                    <SfButton OnClick="Cancel" Disabled="@_saving">Cancel</SfButton>
                                </div>
                            </div>
                        </div>
                    </ContentTemplate>
                </TabItem>

                <TabItem>
                    <ChildContent><TabHeader Text="Employment" /></ChildContent>
                    <ContentTemplate>
                        <div class="mt-4">
                            <p class="text-muted">Employment details coming soon.</p>
                        </div>
                    </ContentTemplate>
                </TabItem>

                <TabItem>
                    <ChildContent><TabHeader Text="Leave" /></ChildContent>
                    <ContentTemplate>
                        <div class="mt-4">
                            <EmployeeLeaveTab CompanyId="CompanyId"
                                              EmployeeId="Id!.Value"
                                              HoursPerDay="@(_model.OverrideWorkingPattern ? _model.HoursPerDay : 7.5m)" />
                        </div>
                    </ContentTemplate>
                </TabItem>

                <TabItem>
                    <ChildContent><TabHeader Text="Documents" /></ChildContent>
                    <ContentTemplate>
                        <div class="mt-4">
                            <p class="text-muted">Documents coming soon.</p>
                        </div>
                    </ContentTemplate>
                </TabItem>

                <TabItem>
                    <ChildContent><TabHeader Text="Compensation" /></ChildContent>
                    <ContentTemplate>
                        <div class="mt-4">
                            <p class="text-muted">Compensation coming soon.</p>
                        </div>
                    </ContentTemplate>
                </TabItem>

                <TabItem>
                    <ChildContent><TabHeader Text="Audit" /></ChildContent>
                    <ContentTemplate>
                        <div class="mt-4">
                            <p class="text-muted">Audit history coming soon.</p>
                        </div>
                    </ContentTemplate>
                </TabItem>

            </TabItems>
        </SfTab>
    }
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid? Id { get; set; }

    private bool IsNew => Id is null || Id == Guid.Empty;
    private string PageTitle => IsNew ? "Add Employee" : $"{_model.FirstName} {_model.LastName}".Trim();

    private GetEmployeeResponse? _employee;
    private bool _loading = true;
    private string? _globalError;
    private string? _successMsg;
    private bool _saving;

    private bool _sendInviteOnCreate;
    private bool _sendingInvite;
    private string? _inviteLink;
    private DateOnly _inviteExpiresAt;
    private string? _inviteError;

    private readonly EmployeeProfileEditModel _model = new();
    private static readonly string[] _allDays = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];

    private List<DepartmentListItemModel> _departments = [];
    private List<PositionProfileListItemModel> _positionProfiles = [];

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _globalError = null;
        _successMsg = null;

        var deptResult = await DepartmentService.ListDepartmentsAsync(CompanyId);
        _departments = deptResult?.Items ?? [];

        var profileResult = await PositionProfileService.ListPositionProfilesAsync(CompanyId);
        _positionProfiles = profileResult?.Items.ToList() ?? [];

        if (!IsNew)
        {
            _employee = await EmployeeService.GetEmployeeAsync(CompanyId, Id!.Value);
            if (_employee is not null)
            {
                _model.FirstName = _employee.FirstName;
                _model.LastName = _employee.LastName;
                _model.WorkEmail = _employee.WorkEmail;
                _model.PersonalEmail = _employee.PersonalEmail;
                _model.StartDate = _employee.StartDate;
                _model.DepartmentId = _employee.DepartmentId;
                _model.PositionProfileId = _employee.PositionProfileId;
                _model.HasSystemAccess = _employee.HasSystemAccess;

                if (_employee.WorkingDaysOverride.HasValue || _employee.HoursPerDayOverride.HasValue)
                {
                    _model.OverrideWorkingPattern = true;
                    if (_employee.WorkingDaysOverride.HasValue)
                    {
                        _model.WorkingWeek = _allDays
                            .Where(d => Enum.TryParse<WorkingDays>(d, out var wd) &&
                                        _employee.WorkingDaysOverride.Value.HasFlag(wd))
                            .ToHashSet();
                    }
                    if (_employee.HoursPerDayOverride.HasValue)
                        _model.HoursPerDay = _employee.HoursPerDayOverride.Value;
                }
            }

            var uri = new Uri(Navigation.Uri);
            if (uri.Query.Contains("invited=true") && _employee is not null)
                await SendInvite();
        }
        else
        {
            _model.StartDate = DateOnly.FromDateTime(DateTime.Today);
        }

        _loading = false;
    }

    private async Task Save()
    {
        _saving = true;
        _globalError = null;
        _successMsg = null;

        if (IsNew)
        {
            var request = new CreateEmployeeRequest(
                CompanyId,
                _model.DepartmentId,
                _model.PositionProfileId,
                _model.FirstName.Trim(),
                _model.LastName.Trim(),
                _model.WorkEmail.Trim(),
                string.IsNullOrWhiteSpace(_model.PersonalEmail) ? null : _model.PersonalEmail.Trim(),
                _model.StartDate,
                _model.HasSystemAccess);

            var (created, error) = await EmployeeService.CreateEmployeeAsync(CompanyId, request);
            _saving = false;

            if (created is not null)
            {
                if (_sendInviteOnCreate)
                {
                    var email = _model.WorkEmail.Trim();
                    var (token, expiresAt, _) = await InviteService.SendInviteAsync(CompanyId, created.Id, email);
                    if (token is not null)
                    {
                        Navigation.NavigateTo($"/companies/{CompanyId}/employees/{created.Id}?invited=true");
                        return;
                    }
                }
                Navigation.NavigateTo($"/companies/{CompanyId}/employees");
                return;
            }

            _globalError = error ?? "Failed to create employee.";
        }
        else
        {
            var workingDaysOverride = _model.OverrideWorkingPattern
                ? _model.WorkingWeek.Aggregate(WorkingDays.None, (acc, day) =>
                    Enum.TryParse<WorkingDays>(day, out var wd) ? acc | wd : acc)
                : (WorkingDays?)null;
            var hoursPerDayOverride = _model.OverrideWorkingPattern
                ? _model.HoursPerDay
                : (decimal?)null;

            var request = new UpdateEmployeeProfileRequest(
                CompanyId,
                Id!.Value,
                _model.DepartmentId,
                _model.PositionProfileId,
                _model.FirstName,
                _model.LastName,
                _model.WorkEmail,
                _model.PersonalEmail,
                _model.StartDate,
                _model.HasSystemAccess,
                workingDaysOverride,
                hoursPerDayOverride);

            var (success, conflictMessage) = await EmployeeService.UpdateEmployeeProfileAsync(CompanyId, Id!.Value, request);
            _saving = false;

            if (success)
                Navigation.NavigateTo($"/companies/{CompanyId}/employees");
            else
                _globalError = conflictMessage;
        }
    }

    private void Cancel() =>
        Navigation.NavigateTo($"/companies/{CompanyId}/employees");

    private async Task SendInvite()
    {
        if (_employee is null) return;

        _sendingInvite = true;
        _inviteError = null;

        var email = _employee.WorkEmail;
        var (token, expiresAt, error) = await InviteService.SendInviteAsync(CompanyId, Id!.Value, email);

        _sendingInvite = false;

        if (token is not null)
        {
            var baseUrl = Navigation.BaseUri.TrimEnd('/');
            _inviteLink = $"{baseUrl}/invite/{token}";
            _inviteExpiresAt = DateOnly.FromDateTime(expiresAt.LocalDateTime);
        }
        else
        {
            _inviteError = error;
        }
    }

    private async Task CopyLink()
    {
        await Task.CompletedTask;
    }

    private void ToggleWorkingDay(string day, bool isChecked)
    {
        if (isChecked) _model.WorkingWeek.Add(day);
        else _model.WorkingWeek.Remove(day);
    }

    private static string StatusBadgeClass(string status) => status switch
    {
        "Active"     => "bg-success",
        "OnLeave"    => "bg-warning text-dark",
        "Suspended"  => "bg-danger",
        "Terminated" => "bg-secondary",
        _            => "bg-light text-dark"
    };
}
