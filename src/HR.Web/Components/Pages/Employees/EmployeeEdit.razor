@page "/companies/{CompanyId:guid}/employees/new"
@page "/companies/{CompanyId:guid}/employees/{Id:guid}"
@page "/companies/{CompanyId:guid}/employees/{Id:guid}/view"
@rendermode InteractiveServer
@inject EmployeeService EmployeeService
@inject DepartmentService DepartmentService
@inject LocationService LocationService
@inject PositionProfileService PositionProfileService
@inject EmploymentTypeService EmploymentTypeService
@inject LeavePolicyService LeavePolicyService
@inject CompanyService CompanyService
@inject AppSession Session
@inject IJSRuntime JS
@inherits EditPageBase<EmployeeProfileEditModel>
@using HR.Infrastructure.Abstractions
@using HR.SharedKernel
@using Microsoft.AspNetCore.WebUtilities
@using Syncfusion.Blazor.Data
@using Syncfusion.Blazor.SplitButtons
@using Syncfusion.Blazor.Navigations

<PageTitle>@PageTitle</PageTitle>

<div class="container py-4">
    <SfBreadcrumb Class="mb-3">
        <BreadcrumbItems>
            <BreadcrumbItem Text="Employees" Url="@($"/companies/{CompanyId}/employees")" />
            <BreadcrumbItem Text="@PageTitle" />
        </BreadcrumbItems>
    </SfBreadcrumb>

    @if (IsLoading || _accessDenied)
    {
        <HrLoadingIndicator />
    }
    else if (IsNew)
    {
        <h1 class="mb-1">Add Employee</h1>
        <p class="text-muted mb-4">Add a new employee and set up their employment and contact details.</p>

        @if (!string.IsNullOrEmpty(GlobalError))
        {
            <div class="alert alert-danger">@GlobalError</div>
        }

        <EditForm EditContext="EditContext">
            <DataAnnotationsValidator />
            <div class="row">
                <div class="col-lg-8">
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Personal Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="emp-first-name">First Name <span class="text-danger" aria-hidden="true">*</span></label>
                                    <HrTextBox @bind-Value="Model.FirstName" Placeholder="First name" HtmlAttributes="@Aria("emp-first-name", "FirstName", true, label: "First Name")" />
                                    <ValidationMessage For="@(() => Model.FirstName)" id="emp-first-name-error" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="emp-last-name">Last Name <span class="text-danger" aria-hidden="true">*</span></label>
                                    <HrTextBox @bind-Value="Model.LastName" Placeholder="Last name" HtmlAttributes="@Aria("emp-last-name", "LastName", true, label: "Last Name")" />
                                    <ValidationMessage For="@(() => Model.LastName)" id="emp-last-name-error" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="emp-preferred-name">Preferred Name</label>
                                    <HrTextBox @bind-Value="Model.PreferredName" Placeholder="Defaults to first name" HtmlAttributes="@Aria("emp-preferred-name", "PreferredName", label: "Preferred Name")" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="emp-date-of-birth">Date of Birth <span class="text-danger" aria-hidden="true">*</span></label>
                                    <SfDatePicker TValue="DateOnly?" @bind-Value="Model.DateOfBirth" Placeholder="dd/mm/yyyy" Format="dd/MM/yyyy" HtmlAttributes="@Aria("emp-date-of-birth", "DateOfBirth", true, label: "Date of Birth")" />
                                    <ValidationMessage For="@(() => Model.DateOfBirth)" id="emp-date-of-birth-error" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="emp-nationality">Nationality <span class="text-danger" aria-hidden="true">*</span></label>
                                    <SfDropDownList TValue="string"
                                                    TItem="NationalityListItem"
                                                    DataSource="@_nationalities"
                                                    @bind-Value="Model.Nationality"
                                                    Placeholder="Select nationality"
                                                    AllowFiltering="true" HtmlAttributes="@Aria("emp-nationality", "Nationality", true, label: "Nationality")">
                                        <DropDownListFieldSettings Value="Name" Text="Name" />
                                    </SfDropDownList>
                                    <ValidationMessage For="@(() => Model.Nationality)" id="emp-nationality-error" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="emp-gender">Gender <span class="text-danger" aria-hidden="true">*</span></label>
                                    <SfDropDownList TValue="string"
                                                    TItem="string"
                                                    DataSource="@_genderOptions"
                                                    @bind-Value="Model.Gender"
                                                    Placeholder="Select gender" HtmlAttributes="@Aria("emp-gender", "Gender", true, label: "Gender")">
                                    </SfDropDownList>
                                    <ValidationMessage For="@(() => Model.Gender)" id="emp-gender-error" />
                                    @if (Model.Gender == "Other")
                                    {
                                        <div class="mt-2">
                                            <label class="visually-hidden" for="emp-gender-other">Gender (please specify)</label>
                                            <HrTextBox @bind-Value="Model.GenderOther" Placeholder="Please specify" HtmlAttributes="@Aria("emp-gender-other", "GenderOther", label: "Gender (please specify)")" />
                                        </div>
                                    }
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="emp-work-email">Work Email <span class="text-danger" aria-hidden="true">*</span></label>
                                    <HrTextBox @bind-Value="Model.WorkEmail" Placeholder="work@company.com" HtmlAttributes="@Aria("emp-work-email", "WorkEmail", true, label: "Work Email")" />
                                    <ValidationMessage For="@(() => Model.WorkEmail)" id="emp-work-email-error" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="emp-personal-email">Personal Email</label>
                                    <HrTextBox @bind-Value="Model.PersonalEmail" Placeholder="personal@example.com" HtmlAttributes="@Aria("emp-personal-email", "PersonalEmail", label: "Personal Email")" />
                                    <ValidationMessage For="@(() => Model.PersonalEmail)" id="emp-personal-email-error" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="emp-start-date">Start Date <span class="text-danger" aria-hidden="true">*</span></label>
                                    <SfDatePicker TValue="DateOnly" @bind-Value="Model.StartDate" HtmlAttributes="@Aria("emp-start-date", "StartDate", true, label: "Start Date")" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="emp-employee-number">
                                        Employee Number
                                        @if (_companyEmployeeNumberMode != EmployeeNumberMode.Automatic)
                                        {
                                            <span class="text-danger" aria-hidden="true">*</span>
                                        }
                                    </label>
                                    @if (_companyEmployeeNumberMode == EmployeeNumberMode.Automatic)
                                    {
                                        <p class="text-muted small mb-0">An employee number will be assigned automatically when this employee is created.</p>
                                    }
                                    else
                                    {
                                        <HrTextBox @bind-Value="Model.EmployeeNumber" Placeholder="e.g. EMP-001" HtmlAttributes="@Aria("emp-employee-number", "EmployeeNumber", true, label: "Employee Number")" />
                                        <ValidationMessage For="@(() => Model.EmployeeNumber)" id="emp-employee-number-error" />
                                    }
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="emp-employment-type">Employment Type <span class="text-danger" aria-hidden="true">*</span></label>
                                    <SfDropDownList TValue="Guid?"
                                                    TItem="EmploymentTypeListItemModel"
                                                    DataSource="@_employmentTypes"
                                                    @bind-Value="Model.EmploymentTypeId"
                                                    Placeholder="Select type" HtmlAttributes="@Aria("emp-employment-type", "EmploymentTypeId", true, label: "Employment Type")">
                                        <DropDownListFieldSettings Value="Id" Text="Name" />
                                    </SfDropDownList>
                                    <ValidationMessage For="@(() => Model.EmploymentTypeId)" id="emp-employment-type-error" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="emp-department">Department <span class="text-danger" aria-hidden="true">*</span></label>
                                    <SfDropDownList TValue="Guid?"
                                                    TItem="DepartmentListItemModel"
                                                    DataSource="@_departments"
                                                    @bind-Value="Model.DepartmentId"
                                                    Placeholder="None"
                                                    AllowFiltering="true" HtmlAttributes="@Aria("emp-department", "DepartmentId", true, label: "Department")">
                                        <DropDownListFieldSettings Value="Id" Text="Name" />
                                    </SfDropDownList>
                                    <ValidationMessage For="@(() => Model.DepartmentId)" id="emp-department-error" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="emp-position-profile">Position Profile <span class="text-danger" aria-hidden="true">*</span></label>
                                    <SfDropDownList @ref="_positionProfileDropdown"
                                                    TValue="Guid?"
                                                    TItem="PositionProfileListItemModel"
                                                    DataSource="@_positionProfiles"
                                                    @bind-Value="Model.PositionProfileId"
                                                    Placeholder="None"
                                                    AllowFiltering="true" HtmlAttributes="@Aria("emp-position-profile", "PositionProfileId", true, label: "Position Profile")">
                                        <DropDownListFieldSettings Value="Id" Text="DisplayLabel" />
                                        <DropDownListEvents TItem="PositionProfileListItemModel" TValue="Guid?"
                                                            ValueChange="OnPositionProfileChanged"
                                                            Filtering="OnPositionProfileFilteringAsync" />
                                    </SfDropDownList>
                                    <ValidationMessage For="@(() => Model.PositionProfileId)" id="emp-position-profile-error" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="emp-location">Location <span class="text-danger" aria-hidden="true">*</span></label>
                                    <SfDropDownList TValue="Guid?"
                                                    TItem="LocationListItemModel"
                                                    DataSource="@_locations"
                                                    @bind-Value="Model.LocationId"
                                                    Placeholder="None"
                                                    AllowFiltering="true" HtmlAttributes="@Aria("emp-location", "LocationId", true, label: "Location")">
                                        <DropDownListFieldSettings Value="Id" Text="Name" />
                                    </SfDropDownList>
                                    <ValidationMessage For="@(() => Model.LocationId)" id="emp-location-error" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="emp-manager">Manager</label>
                                    <SfDropDownList @ref="_managerDropdown"
                                                    TValue="Guid?"
                                                    TItem="ManagerOption"
                                                    DataSource="@_managerOptions"
                                                    @bind-Value="Model.ManagerId"
                                                    Placeholder="None"
                                                    AllowFiltering="true" HtmlAttributes="@Aria("emp-manager", "ManagerId", label: "Manager")">
                                        <DropDownListFieldSettings Value="Id" Text="Name" />
                                        <DropDownListEvents TValue="Guid?" TItem="ManagerOption" Filtering="OnManagerFilteringAsync" />
                                    </SfDropDownList>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (_selectedProfileDefaults is not null)
                    {
                        <div class="card mb-4" data-testid="position-profile-defaults-summary">
                            <div class="card-header">
                                <h5 class="mb-0">From Position Profile</h5>
                            </div>
                            <div class="card-body">
                                <dl class="row mb-0 small">
                                    <dt class="col-5 text-muted fw-normal">Working Pattern</dt>
                                    <dd class="col-7">@ProfileWorkingPatternSummary(_selectedProfileDefaults)</dd>
                                    @if (_selectedProfileDefaults.SalaryMin is not null || _selectedProfileDefaults.SalaryMax is not null)
                                    {
                                        <dt class="col-5 text-muted fw-normal">Salary Range</dt>
                                        <dd class="col-7">@ProfileSalaryRangeSummary(_selectedProfileDefaults)</dd>
                                    }
                                    @if (_selectedProfileLeavePolicyName is not null)
                                    {
                                        <dt class="col-5 text-muted fw-normal">Default Leave Policy</dt>
                                        <dd class="col-7">@_selectedProfileLeavePolicyName</dd>
                                    }
                                    <dt class="col-5 text-muted fw-normal">Required Documents</dt>
                                    <dd class="col-7">@_selectedProfileDefaults.RequiredDocuments.Count</dd>
                                </dl>
                            </div>
                        </div>
                    }

                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Contact Details</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label" for="emp-address-line-1">Address Line 1</label>
                                    <HrTextBox @bind-Value="Model.AddressLine1" Placeholder="Street address" HtmlAttributes="@Aria("emp-address-line-1", "AddressLine1", label: "Address Line 1")" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="emp-address-line-2">Address Line 2</label>
                                    <HrTextBox @bind-Value="Model.AddressLine2" Placeholder="Apartment, suite, etc." HtmlAttributes="@Aria("emp-address-line-2", "AddressLine2", label: "Address Line 2")" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="emp-city">City</label>
                                    <HrTextBox @bind-Value="Model.City" Placeholder="e.g. London" HtmlAttributes="@Aria("emp-city", "City", label: "City")" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="emp-county-state">County / State</label>
                                    <HrTextBox @bind-Value="Model.County" Placeholder="e.g. Greater London" HtmlAttributes="@Aria("emp-county-state", "County", label: "County / State")" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="emp-post-code">Post Code</label>
                                    <HrTextBox @bind-Value="Model.PostCode" Placeholder="e.g. SW1A 1AA" HtmlAttributes="@Aria("emp-post-code", "PostCode", label: "Post Code")" />
                                    <ValidationMessage For="@(() => Model.PostCode)" id="emp-post-code-error" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="emp-mobile-work-phone">Mobile / Work Phone</label>
                                    <HrTextBox @bind-Value="Model.PhoneNumber" Placeholder="e.g. 07700 900000" HtmlAttributes="@Aria("emp-mobile-work-phone", "PhoneNumber", label: "Mobile / Work Phone")" />
                                    <ValidationMessage For="@(() => Model.PhoneNumber)" id="emp-mobile-work-phone-error" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="emp-home-phone">Home Phone</label>
                                    <HrTextBox @bind-Value="Model.HomePhone" Placeholder="e.g. 01234 567890" HtmlAttributes="@Aria("emp-home-phone", "HomePhone", label: "Home Phone")" />
                                    <ValidationMessage For="@(() => Model.HomePhone)" id="emp-home-phone-error" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 align-items-center mt-3 justify-content-end">
                        <SfButton IsPrimary="true" Disabled="@(Saving || IsSubscriptionReadOnly)" OnClick="SaveAsync">
                            @if (Saving)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            Save
                        </SfButton>
                        <SfButton OnClick="RequestClose" Disabled="@Saving">Cancel</SfButton>
                    </div>
                </div>
            </div>
        </EditForm>
    }
    else
    {
        <div class="employee-profile-header mb-1">
            <h1 class="mb-0">@(_employee is null ? string.Empty : PersonName.Display(_employee.FirstName, _employee.LastName, _employee.PreferredName))</h1>
            @if (_employee is not null)
            {
                <span class="badge rounded-pill px-3 py-2 fs-6 fw-normal @StatusBadgeClass(_employee.Status)">@StatusDisplayName(_employee.Status)</span>
                @if (!string.IsNullOrEmpty(_employee.EmployeeNumber))
                {
                    <span class="text-muted employee-profile-number">#@_employee.EmployeeNumber</span>
                }
            }
            <div class="employee-profile-actions">
                @if (IsViewMode && Session.CanManageEmployees)
                {
                    <SfButton CssClass="e-small e-primary" data-testid="edit-details-button" Disabled="@Session.IsReadOnly" OnClick="EnterEditMode">
                        <i class="fa-solid fa-pen me-1"></i>Edit details
                    </SfButton>
                }
                @if (Session.CanManageEmployees)
                {
                    <SfDropDownButton Content="More actions" IconCss="fa-solid fa-ellipsis-vertical" CssClass="e-small e-flat"
                                       Items="_moreActionsItems">
                        <DropDownButtonEvents ItemSelected="HandleMoreActionSelected" />
                    </SfDropDownButton>
                }
            </div>
        </div>

        @if (Session.CanManageEmployees && _employee is not null)
        {
            <EmployeeProfilePhotoHeader CompanyId="CompanyId" EmployeeId="Id!.Value" Initials="@EmployeeInitials" />
        }

        @if (_employee is not null && PersonName.IsPreferredDistinct(_employee.FirstName, _employee.PreferredName))
        {
            <p class="text-muted small mb-1" data-testid="legal-name">Legal name: @PersonName.Legal(_employee.FirstName, _employee.LastName)</p>
        }

        @if (_employee?.ManagerId is not null)
        {
            <p class="text-muted small mb-1">
                Reports To:
                <a href="/companies/@CompanyId/employees/@_employee.ManagerId">@_employee.ManagerFullName</a>
            </p>
        }
        @if (_employee?.DirectReportsCount > 0)
        {
            <p class="text-muted small mb-1">
                Direct Reports:
                <a href="/companies/@CompanyId/organisation-chart?employeeId=@Id">@_employee.DirectReportsCount Employee@(_employee.DirectReportsCount == 1 ? "" : "s")</a>
            </p>
        }
        <p class="text-muted mb-3">View and manage this employee's profile, employment, leave, and documents.</p>

        @if (_employee?.ReportingChain is { Count: > 0 })
        {
            <div class="card mb-3">
                <div class="card-body py-2 px-3">
                    <h6 class="text-muted small text-uppercase mb-2">Reporting Chain</h6>
                    <div class="d-flex flex-column align-items-start">
                        @foreach (var link in _employee.ReportingChain)
                        {
                            <div class="mb-1">
                                <a href="/companies/@CompanyId/employees/@link.EmployeeId" class="fw-semibold text-decoration-none">@link.Name</a>
                                @if (!string.IsNullOrEmpty(link.JobTitle))
                                {
                                    <span class="text-muted small"> — @link.JobTitle</span>
                                }
                            </div>
                            <div class="text-muted mb-1">↓</div>
                        }
                        <div>
                            <span class="fw-semibold">@PersonName.Display(_employee.FirstName, _employee.LastName, _employee.PreferredName)</span>
                            <span class="badge bg-secondary-subtle text-secondary-emphasis ms-1">Current Employee</span>
                        </div>
                    </div>
                </div>
            </div>
        }

        <SaveConflictBanner Visible="SaveConflict"
                            Disabled="@Saving"
                            OnReload="ReloadLatestValuesAsync"
                            Message="Someone else changed this employee's details while you were editing. Your changes have not been saved." />

        @if (!SaveConflict && !string.IsNullOrEmpty(GlobalError))
        {
            <div class="alert alert-danger mb-3">@GlobalError</div>
        }

        <div class="employee-profile-tabs">
        <SfTab OverflowMode="OverflowMode.Scrollable" @bind-SelectedItem="GroupTab" CssClass="employee-profile-groups">
            <TabItems>

                <TabItem>
                    <ChildContent><TabHeader Text="Overview" /></ChildContent>
                    <ContentTemplate>
                        <div class="employee-profile-section-wrap" role="region" aria-label="Overview sub-sections">
                        @* LoadOn=Init: render Details, Employment and the other Overview sub-panels
                           up front and keep them mounted. The default (Dynamic) destroys the
                           inactive panel's content on every sub-tab switch, which silently discards
                           unsaved edits in the section you just left — and breaks the atomic
                           profile+employment save (Ticket 2 item 5), whose whole point is editing
                           both halves before one combined Save. *@
                        <SfTab OverflowMode="OverflowMode.Scrollable" @bind-SelectedItem="OverviewTab" LoadOn="ContentLoad.Init" CssClass="employee-profile-sections mt-2">
                            <TabItems>

                <TabItem>
                    <ChildContent><TabHeader Text="Details" /></ChildContent>
                    <ContentTemplate>
                        <EditForm EditContext="EditContext">
                            <DataAnnotationsValidator />
                            <div class="mt-4 row">
                                <div class="col-lg-10 col-xl-9">
                                    <p class="text-muted small mb-3">Fields marked <span class="text-danger">*</span> are required.</p>
                                    <div class="card mb-4">
                                        <div class="card-header">
                                            <h5 class="mb-0">Personal Information</h5>
                                        </div>
                                        <div class="card-body @(IsViewMode ? "view-mode" : "")">
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label class="form-label" for="emp-first-name">First Name <span class="text-danger" aria-hidden="true">*</span></label>
                                                    <HrTextBox @bind-Value="Model.FirstName" Placeholder="First name" ReadOnly="@IsViewMode" HtmlAttributes="@Aria("emp-first-name", "FirstName", true, label: "First Name")" />
                                                    <ValidationMessage For="@(() => Model.FirstName)" id="emp-first-name-error" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label" for="emp-last-name">Last Name <span class="text-danger" aria-hidden="true">*</span></label>
                                                    <HrTextBox @bind-Value="Model.LastName" Placeholder="Last name" ReadOnly="@IsViewMode" HtmlAttributes="@Aria("emp-last-name", "LastName", true, label: "Last Name")" />
                                                    <ValidationMessage For="@(() => Model.LastName)" id="emp-last-name-error" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label" for="emp-preferred-name">Preferred Name</label>
                                                    <HrTextBox @bind-Value="Model.PreferredName" Placeholder="Defaults to first name" ReadOnly="@IsViewMode" HtmlAttributes="@Aria("emp-preferred-name", "PreferredName", label: "Preferred Name")" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label" for="employee-dob">Date of Birth <span class="text-danger" aria-hidden="true">*</span></label>
                                                    <SfDatePicker ID="employee-dob" TValue="DateOnly?" @bind-Value="Model.DateOfBirth" Placeholder="dd/mm/yyyy" Format="dd/MM/yyyy" Enabled="@(!IsViewMode)" HtmlAttributes="@Aria("employee-dob", "DateOfBirth", true, false, label: "Date of Birth")" />
                                                    <ValidationMessage For="@(() => Model.DateOfBirth)" id="employee-dob-error" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label" for="employee-nationality">Nationality <span class="text-danger" aria-hidden="true">*</span></label>
                                                    <SfDropDownList ID="employee-nationality"
                                                                    TValue="string"
                                                                    TItem="NationalityListItem"
                                                                    DataSource="@_nationalities"
                                                                    @bind-Value="Model.Nationality"
                                                                    Placeholder="Select nationality"
                                                                    AllowFiltering="true"
                                                                    Enabled="@(!IsViewMode)" HtmlAttributes="@Aria("employee-nationality", "Nationality", true, false, label: "Nationality")">
                                                        <DropDownListFieldSettings Value="Name" Text="Name" />
                                                    </SfDropDownList>
                                                    <ValidationMessage For="@(() => Model.Nationality)" id="employee-nationality-error" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label" for="employee-gender">Gender <span class="text-danger" aria-hidden="true">*</span></label>
                                                    <SfDropDownList ID="employee-gender"
                                                                    TValue="string"
                                                                    TItem="string"
                                                                    DataSource="@_genderOptions"
                                                                    @bind-Value="Model.Gender"
                                                                    Placeholder="Select gender"
                                                                    Enabled="@(!IsViewMode)" HtmlAttributes="@Aria("employee-gender", "Gender", true, false, label: "Gender")">
                                                    </SfDropDownList>
                                                    <ValidationMessage For="@(() => Model.Gender)" id="employee-gender-error" />
                                                    @if (Model.Gender == "Other")
                                                    {
                                                        <div class="mt-2">
                                                            <label class="visually-hidden" for="emp-gender-other">Gender (please specify)</label>
                                                            <HrTextBox @bind-Value="Model.GenderOther" Placeholder="Please specify" ReadOnly="@IsViewMode" HtmlAttributes="@Aria("emp-gender-other", "GenderOther", label: "Gender (please specify)")" />
                                                        </div>
                                                    }
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label" for="emp-work-email">Work Email <span class="text-danger" aria-hidden="true">*</span></label>
                                                    <HrTextBox @bind-Value="Model.WorkEmail" Placeholder="work@company.com" ReadOnly="@IsViewMode" HtmlAttributes="@Aria("emp-work-email", "WorkEmail", true, label: "Work Email")" />
                                                    <ValidationMessage For="@(() => Model.WorkEmail)" id="emp-work-email-error" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label" for="emp-personal-email">Personal Email</label>
                                                    <HrTextBox @bind-Value="Model.PersonalEmail" Placeholder="personal@example.com" ReadOnly="@IsViewMode" HtmlAttributes="@Aria("emp-personal-email", "PersonalEmail", label: "Personal Email")" />
                                                    <ValidationMessage For="@(() => Model.PersonalEmail)" id="emp-personal-email-error" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card mb-4">
                                        <div class="card-header">
                                            <h5 class="mb-0">Contact Details</h5>
                                        </div>
                                        <div class="card-body @(IsViewMode ? "view-mode" : "")">
                                            <div class="row g-3">
                                                <div class="col-12">
                                                    <label class="form-label" for="emp-address-line-1">Address Line 1</label>
                                                    <HrTextBox @bind-Value="Model.AddressLine1" Placeholder="Street address" ReadOnly="@IsViewMode" HtmlAttributes="@Aria("emp-address-line-1", "AddressLine1", label: "Address Line 1")" />
