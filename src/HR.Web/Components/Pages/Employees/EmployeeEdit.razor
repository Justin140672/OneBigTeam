                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label" for="emp-city">City</label>
                                                    <HrTextBox @bind-Value="Model.City" Placeholder="e.g. London" ReadOnly="@IsViewMode" HtmlAttributes="@Aria("emp-city", "City", label: "City")" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label" for="emp-county-state">County / State</label>
                                                    <HrTextBox @bind-Value="Model.County" Placeholder="e.g. Greater London" ReadOnly="@IsViewMode" HtmlAttributes="@Aria("emp-county-state", "County", label: "County / State")" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label" for="emp-post-code">Post Code</label>
                                                    <HrTextBox @bind-Value="Model.PostCode" Placeholder="e.g. SW1A 1AA" ReadOnly="@IsViewMode" HtmlAttributes="@Aria("emp-post-code", "PostCode", label: "Post Code")" />
                                                    <ValidationMessage For="@(() => Model.PostCode)" id="emp-post-code-error" />
                                                </div>
                                                <div class="col-12">
                                                    <label class="form-label" for="emp-mobile-work-phone">Mobile / Work Phone</label>
                                                    <HrTextBox @bind-Value="Model.PhoneNumber" Placeholder="e.g. 07700 900000" ReadOnly="@IsViewMode" HtmlAttributes="@Aria("emp-mobile-work-phone", "PhoneNumber", label: "Mobile / Work Phone")" />
                                                    <ValidationMessage For="@(() => Model.PhoneNumber)" id="emp-mobile-work-phone-error" />
                                                </div>
                                                <div class="col-12">
                                                    <label class="form-label" for="emp-home-phone">Home Phone</label>
                                                    <HrTextBox @bind-Value="Model.HomePhone" Placeholder="e.g. 01234 567890" ReadOnly="@IsViewMode" HtmlAttributes="@Aria("emp-home-phone", "HomePhone", label: "Home Phone")" />
                                                    <ValidationMessage For="@(() => Model.HomePhone)" id="emp-home-phone-error" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </EditForm>
                    </ContentTemplate>
                </TabItem>

                <TabItem>
                    <ChildContent><TabHeader Text="Employment" /></ChildContent>
                    <ContentTemplate>
