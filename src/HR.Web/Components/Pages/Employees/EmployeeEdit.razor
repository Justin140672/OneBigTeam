    {
        _showAmendLeavingProcessDialog = false;
        var suffix = offboardingAlreadyStarted ? "&offboardingAlreadyStarted=true" : string.Empty;
        Navigation.NavigateTo($"/companies/{CompanyId}/employees/{Id}?tab=leaving{suffix}", forceLoad: true);
    }

    private bool _showCancelLeavingProcessDialog;

    private void OpenCancelLeavingProcessDialog() => _showCancelLeavingProcessDialog = true;

    private void CloseCancelLeavingProcessDialog() => _showCancelLeavingProcessDialog = false;

    private void OnLeavingProcessCancelled()
    {
        _showCancelLeavingProcessDialog = false;
        Navigation.NavigateTo($"/companies/{CompanyId}/employees/{Id}", forceLoad: true);
    }

    private int _managerFilterRequestId;

    private async Task OnManagerFilteringAsync(Syncfusion.Blazor.DropDowns.FilteringEventArgs args)
    {
        args.PreventDefaultAction = true;
        var requestId = ++_managerFilterRequestId;
        var result = await EmployeeService.ListSelectableEmployeesAsync(CompanyId, search: args.Text, pageSize: 50);
        if (requestId != _managerFilterRequestId) return;
        _managerOptions = (result?.Items ?? [])
            .Where(e => e.Status != "Draft" && e.Status != "FormerEmployee")
            .Select(e => new ManagerOption(e.Id, e.FullName))
            .OrderBy(e => e.Name)
            .Prepend(new ManagerOption(Guid.Empty, "No Manager"))
            .ToList();
        await _managerDropdown.FilterAsync(_managerOptions, new Query());
    }

    private sealed record ManagerOption(Guid Id, string Name);

    private int _profileFilterRequestId;

    private async Task OnPositionProfileFilteringAsync(Syncfusion.Blazor.DropDowns.FilteringEventArgs args)
    {
        args.PreventDefaultAction = true;
        var requestId = ++_profileFilterRequestId;
        var result = await PositionProfileService.ListPositionProfilesAsync(CompanyId, search: args.Text, pageSize: 100);
        if (requestId != _profileFilterRequestId) return;
        var options = (result?.Items ?? []).ToList();
        await _positionProfileDropdown.FilterAsync(options, new Query());
    }

    private async Task OnPositionProfileChanged(ChangeEventArgs<Guid?, PositionProfileListItemModel> args)
    {
        Model.PositionProfileId = args.Value;
        _selectedProfileDefaults = null;
        _selectedProfileLeavePolicyName = null;

        if (args.Value is Guid profileId)
        {
            _selectedProfileDefaults = await PositionProfileService.GetPositionProfileAsync(CompanyId, profileId);

            if (_selectedProfileDefaults is not null)
            {
                Model.DepartmentId = _selectedProfileDefaults.DepartmentId;
                Model.LocationId = _selectedProfileDefaults.LocationId;

                if (_selectedProfileDefaults.DefaultLeavePolicyId is Guid leavePolicyId)
                {
                    var policies = await LeavePolicyService.ListLeavePoliciesAsync(CompanyId, activeOnly: true);
                    _selectedProfileLeavePolicyName = policies?.Items.FirstOrDefault(p => p.Id == leavePolicyId)?.Name;
                }
            }
        }
    }

    private static string ProfileWorkingPatternSummary(GetPositionProfileResponse profile)
    {
        if (profile.WorkingDaysOverride is null || profile.HoursPerDayOverride is null)
            return "Company default";

        return WorkingPatternFormatter.Summarize(profile.WorkingDaysOverride.Value, profile.HoursPerDayOverride.Value);
    }

    private static string ProfileSalaryRangeSummary(GetPositionProfileResponse profile) => (profile.SalaryMin, profile.SalaryMax) switch
    {
        (not null, not null) => $"{profile.SalaryMin:N0} - {profile.SalaryMax:N0}",
        (not null, null) => $"From {profile.SalaryMin:N0}",
        (null, not null) => $"Up to {profile.SalaryMax:N0}",
        _ => string.Empty
    };

    protected override async Task<string?> SaveCoreAsync()
    {
        if (IsNew)
        {
            var request = new CreateEmployeeRequest(
                CompanyId,
                Model.DepartmentId!.Value,
                Model.LocationId!.Value,
                Model.PositionProfileId!.Value,
                FormText.Required(Model.FirstName),
                FormText.Required(Model.LastName),
                FormText.Optional(Model.PreferredName),
                FormText.Required(Model.WorkEmail),
                FormText.Optional(Model.PersonalEmail),
                Model.StartDate,
                Model.DateOfBirth ?? default,
                FormText.Required(Model.Nationality),
                FormText.Required(Model.Gender),
                FormText.Optional(Model.GenderOther),
                FormText.Required(Model.EmployeeNumber),
                Model.EmploymentTypeId!.Value,
                FormText.Optional(Model.PhoneNumber),
                FormText.Optional(Model.HomePhone),
                FormText.Optional(Model.AddressLine1),
                FormText.Optional(Model.AddressLine2),
                FormText.Optional(Model.City),
                FormText.Optional(Model.County),
                FormText.Optional(Model.PostCode),
                FormText.Optional(Model.Country),
                Model.HasSystemAccess,
                Model.ManagerId == Guid.Empty ? null : Model.ManagerId);

            var (created, error) = await EmployeeService.CreateEmployeeAsync(CompanyId, request);

            if (created is null)
                return error ?? "Failed to create employee.";

            _redirectUrl = $"/companies/{CompanyId}/employees";
            return null;
        }
        else
        {
            if (_employmentTab is not null && !_employmentTab.ValidateSection())
                return "Please fix the highlighted errors on the Employment tab.";

            var correlationId = Guid.NewGuid();
            var employment = _employmentTab?.GetEmploymentPortion();

            var request = new UpdateEmployeeProfileAndEmploymentRequest(
                CompanyId,
                Id!.Value,
                Model.FirstName,
                Model.LastName,
                FormText.Optional(Model.PreferredName),
                Model.WorkEmail,
                Model.PersonalEmail,
                Model.DateOfBirth,
                FormText.Optional(Model.Nationality),
                FormText.Optional(Model.Gender),
                FormText.Optional(Model.GenderOther),
                FormText.Optional(Model.PhoneNumber),
                FormText.Optional(Model.HomePhone),
                FormText.Optional(Model.AddressLine1),
                FormText.Optional(Model.AddressLine2),
                FormText.Optional(Model.City),
                FormText.Optional(Model.County),
                FormText.Optional(Model.PostCode),
                FormText.Optional(Model.Country),
                Model.HasSystemAccess,
                // Ticket 2 follow-up: when the Employment tab has been loaded this session
                // (employment is not null) its values are authoritative, INCLUDING deliberate
                // nulls (manager removed, dates/notes cleared, overrides unchecked). Only fall
                // back to the loaded _employee/Model snapshot when the tab was never opened, so
                // the employment half is submitted unchanged. Note: NOT '??' — that would
                // silently resurrect stale values for every intentional clear.
                employment is not null ? employment.EmployeeNumber : _employee?.EmployeeNumber,
                employment is not null ? employment.EmploymentTypeId : _employee?.EmploymentTypeId,
                employment?.Status ?? _employee?.Status ?? "Active",
                employment is not null ? employment.DepartmentId : Model.DepartmentId,
                employment is not null ? employment.LocationId : Model.LocationId,
                employment is not null ? employment.PositionProfileId : Model.PositionProfileId,
                employment is not null ? employment.ManagerId : _employee?.ManagerId,
                employment?.StartDate ?? Model.StartDate,
                employment is not null ? employment.ContinuousServiceDate : _employee?.ContinuousServiceDate,
                employment is not null ? employment.ProbationEndDate : _employee?.ProbationEndDate,
                employment is not null ? employment.LeavingDate : _employee?.LeavingDate,
                employment is not null ? employment.NoticePeriodUnitOverride : _employee?.NoticePeriodUnitOverride,
                employment is not null ? employment.NoticePeriodLengthOverride : _employee?.NoticePeriodLengthOverride,
                employment is not null ? employment.WorkingDaysOverride : _employee?.WorkingDaysOverride,
                employment is not null ? employment.HoursPerDayOverride : _employee?.HoursPerDayOverride,
                employment is not null ? employment.Notes : _employee?.Notes,
                CorrelationId: correlationId,
                // Ticket 2: optimistic concurrency — reject the save if this employee changed
                // (via any screen) since it was loaded into this editor.
                ExpectedVersion: _employee?.Version);

            var result = await EmployeeService.UpdateEmployeeProfileAndEmploymentAsync(CompanyId, Id!.Value, request);

            if (!result.Success)
            {
                SaveConflict = result.IsConcurrencyConflict;
                return result.ErrorMessage;
            }

            SaveConflict = false;
            if (result.NewVersion is { } v && _employee is not null)
                _employee = _employee with { Version = v };
            _employmentTab?.AdoptSavedVersion(result.NewVersion);

            _redirectUrl = $"/companies/{CompanyId}/employees/{Id}/view";
            return null;
        }
    }

    private bool _closing;

    private async Task ConfirmSaveAndCloseFromDialogAsync()
    {
        _closing = true;
        try
        {
            await ConfirmSaveAndCloseAsync();
        }
        finally
        {
            _closing = false;
        }
    }

    protected override async Task OnSavedAsync()
    {
        _saveSuccessMessage = IsNew ? "Employee created successfully." : "Employee details saved successfully.";
        StateHasChanged();
        await Task.Delay(700);

        if (_closing)
            NavigateToList();
        else
            Navigation.NavigateTo(_redirectUrl ?? ListUrl!, forceLoad: true);
    }

    protected override string? ListUrl => $"/companies/{CompanyId}/employees";

    protected override bool HasUnsavedChanges =>
        base.HasUnsavedChanges || (_employmentTab?.HasUnsavedChanges ?? false);

    protected override void ResetChildSectionsUnsavedState() =>
        _employmentTab?.ResetBaseline();

    private static string StatusBadgeClass(string status) => status switch
    {
        "Active"         => "bg-success",
        "Suspended"      => "bg-danger",
        "Leaving"        => "bg-warning text-dark",
        "FormerEmployee" => "bg-secondary",
        _                => "bg-light text-dark"
    };

    private static string StatusDisplayName(string status) => EnumDisplay.Humanize(status);
