@page "/companies/{CompanyId:guid}/employees/new"
@page "/companies/{CompanyId:guid}/employees/{Id:guid}"
@page "/companies/{CompanyId:guid}/employees/{Id:guid}/view"
@rendermode InteractiveServer
@inject EmployeeService EmployeeService
@inject DepartmentService DepartmentService
@inject LocationService LocationService
@inject PositionProfileService PositionProfileService
@inject EmploymentTypeService EmploymentTypeService
@inject LeavePolicyService LeavePolicyService
@inject InviteService InviteService
@inject CompanyService CompanyService
@inject AppSession Session
@inherits EditPageBase<EmployeeProfileEditModel>
@using HR.Infrastructure.Abstractions
@using HR.SharedKernel
@using Microsoft.AspNetCore.WebUtilities
@using Syncfusion.Blazor.Data
@using Syncfusion.Blazor.SplitButtons
@using Syncfusion.Blazor.Navigations

<PageTitle>@PageTitle</PageTitle>

<div class="container py-4">
    <SfBreadcrumb Class="mb-3">
        <BreadcrumbItems>
            <BreadcrumbItem Text="Employees" Url="@($"/companies/{CompanyId}/employees")" />
            <BreadcrumbItem Text="@PageTitle" />
        </BreadcrumbItems>
    </SfBreadcrumb>

    @if (IsLoading)
    {
        <HrLoadingIndicator />
    }
    else if (IsNew)
    {
        <h1 class="mb-1">Add Employee</h1>
        <p class="text-muted mb-4">Add a new employee and set up their employment, contact, and system access details.</p>

        @if (!string.IsNullOrEmpty(GlobalError))
        {
            <div class="alert alert-danger">@GlobalError</div>
        }

        <EditForm EditContext="EditContext">
            <DataAnnotationsValidator />
            <div class="row">
                <div class="col-lg-8">
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Personal Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">First Name <span class="text-danger">*</span></label>
                                    <HrTextBox @bind-Value="Model.FirstName" Placeholder="First name" />
                                    <ValidationMessage For="@(() => Model.FirstName)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Last Name <span class="text-danger">*</span></label>
                                    <HrTextBox @bind-Value="Model.LastName" Placeholder="Last name" />
                                    <ValidationMessage For="@(() => Model.LastName)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Preferred Name</label>
                                    <HrTextBox @bind-Value="Model.PreferredName" Placeholder="Defaults to first name" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Date of Birth <span class="text-danger">*</span></label>
                                    <SfDatePicker TValue="DateOnly?" @bind-Value="Model.DateOfBirth" Placeholder="dd/mm/yyyy" Format="dd/MM/yyyy" />
                                    <ValidationMessage For="@(() => Model.DateOfBirth)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Nationality <span class="text-danger">*</span></label>
                                    <SfDropDownList TValue="string"
                                                    TItem="NationalityListItem"
                                                    DataSource="@_nationalities"
                                                    @bind-Value="Model.Nationality"
                                                    Placeholder="Select nationality"
                                                    AllowFiltering="true">
                                        <DropDownListFieldSettings Value="Name" Text="Name" />
                                    </SfDropDownList>
                                    <ValidationMessage For="@(() => Model.Nationality)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Gender <span class="text-danger">*</span></label>
                                    <SfDropDownList TValue="string"
                                                    TItem="string"
                                                    DataSource="@_genderOptions"
                                                    @bind-Value="Model.Gender"
                                                    Placeholder="Select gender">
                                    </SfDropDownList>
                                    <ValidationMessage For="@(() => Model.Gender)" />
                                    @if (Model.Gender == "Other")
                                    {
                                        <div class="mt-2">
                                            <HrTextBox @bind-Value="Model.GenderOther" Placeholder="Please specify" />
                                        </div>
                                    }
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Work Email <span class="text-danger">*</span></label>
                                    <HrTextBox @bind-Value="Model.WorkEmail" Placeholder="work@company.com" />
                                    <ValidationMessage For="@(() => Model.WorkEmail)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Personal Email</label>
                                    <HrTextBox @bind-Value="Model.PersonalEmail" Placeholder="personal@example.com" />
                                    <ValidationMessage For="@(() => Model.PersonalEmail)" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Start Date <span class="text-danger">*</span></label>
                                    <SfDatePicker TValue="DateOnly" @bind-Value="Model.StartDate" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">
                                        Employee Number
                                        @if (_companyEmployeeNumberMode != EmployeeNumberMode.Automatic)
                                        {
                                            <span class="text-danger">*</span>
                                        }
                                    </label>
                                    @if (_companyEmployeeNumberMode == EmployeeNumberMode.Automatic)
                                    {
                                        <p class="text-muted small mb-0">An employee number will be assigned automatically when this employee is created.</p>
                                    }
                                    else
                                    {
                                        <HrTextBox @bind-Value="Model.EmployeeNumber" Placeholder="e.g. EMP-001" />
                                        <ValidationMessage For="@(() => Model.EmployeeNumber)" />
                                    }
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Employment Type <span class="text-danger">*</span></label>
                                    <SfDropDownList TValue="Guid?"
                                                    TItem="EmploymentTypeListItemModel"
                                                    DataSource="@_employmentTypes"
                                                    @bind-Value="Model.EmploymentTypeId"
                                                    Placeholder="Select type">
                                        <DropDownListFieldSettings Value="Id" Text="Name" />
                                    </SfDropDownList>
                                    <ValidationMessage For="@(() => Model.EmploymentTypeId)" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Department <span class="text-danger">*</span></label>
                                    <SfDropDownList TValue="Guid?"
                                                    TItem="DepartmentListItemModel"
                                                    DataSource="@_departments"
                                                    @bind-Value="Model.DepartmentId"
                                                    Placeholder="None"
                                                    AllowFiltering="true">
                                        <DropDownListFieldSettings Value="Id" Text="Name" />
                                    </SfDropDownList>
                                    <ValidationMessage For="@(() => Model.DepartmentId)" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Position Profile <span class="text-danger">*</span></label>
                                    <SfDropDownList TValue="Guid?"
                                                    TItem="PositionProfileListItemModel"
                                                    DataSource="@_positionProfiles"
                                                    @bind-Value="Model.PositionProfileId"
                                                    Placeholder="None"
                                                    AllowFiltering="true">
                                        <DropDownListFieldSettings Value="Id" Text="Title" />
                                        <DropDownListEvents TItem="PositionProfileListItemModel" TValue="Guid?" ValueChange="OnPositionProfileChanged" />
                                    </SfDropDownList>
                                    <ValidationMessage For="@(() => Model.PositionProfileId)" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Location <span class="text-danger">*</span></label>
                                    <SfDropDownList TValue="Guid?"
                                                    TItem="LocationListItemModel"
                                                    DataSource="@_locations"
                                                    @bind-Value="Model.LocationId"
                                                    Placeholder="None"
                                                    AllowFiltering="true">
                                        <DropDownListFieldSettings Value="Id" Text="Name" />
                                    </SfDropDownList>
                                    <ValidationMessage For="@(() => Model.LocationId)" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Manager</label>
                                    <SfDropDownList @ref="_managerDropdown"
                                                    TValue="Guid?"
                                                    TItem="ManagerOption"
                                                    DataSource="@_managerOptions"
                                                    @bind-Value="Model.ManagerId"
                                                    Placeholder="None"
                                                    AllowFiltering="true">
                                        <DropDownListFieldSettings Value="Id" Text="Name" />
                                        <DropDownListEvents TValue="Guid?" TItem="ManagerOption" Filtering="OnManagerFilteringAsync" />
                                    </SfDropDownList>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (_selectedProfileDefaults is not null)
                    {
                        <div class="card mb-4" data-testid="position-profile-defaults-summary">
                            <div class="card-header">
                                <h5 class="mb-0">From Position Profile</h5>
                            </div>
                            <div class="card-body">
                                <dl class="row mb-0 small">
                                    <dt class="col-5 text-muted fw-normal">Working Pattern</dt>
                                    <dd class="col-7">@ProfileWorkingPatternSummary(_selectedProfileDefaults)</dd>
                                    @if (_selectedProfileDefaults.SalaryMin is not null || _selectedProfileDefaults.SalaryMax is not null)
                                    {
                                        <dt class="col-5 text-muted fw-normal">Salary Range</dt>
                                        <dd class="col-7">@ProfileSalaryRangeSummary(_selectedProfileDefaults)</dd>
                                    }
                                    @if (_selectedProfileLeavePolicyName is not null)
                                    {
                                        <dt class="col-5 text-muted fw-normal">Default Leave Policy</dt>
                                        <dd class="col-7">@_selectedProfileLeavePolicyName</dd>
                                    }
                                    <dt class="col-5 text-muted fw-normal">Required Documents</dt>
                                    <dd class="col-7">@_selectedProfileDefaults.RequiredDocuments.Count</dd>
                                </dl>
                            </div>
                        </div>
                    }

                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Contact Details</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Mobile / Work Phone</label>
                                    <HrTextBox @bind-Value="Model.PhoneNumber" Placeholder="e.g. 07700 900000" />
                                    <ValidationMessage For="@(() => Model.PhoneNumber)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Home Phone</label>
                                    <HrTextBox @bind-Value="Model.HomePhone" Placeholder="e.g. 01234 567890" />
                                    <ValidationMessage For="@(() => Model.HomePhone)" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Address Line 1</label>
                                    <HrTextBox @bind-Value="Model.AddressLine1" Placeholder="Street address" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Address Line 2</label>
                                    <HrTextBox @bind-Value="Model.AddressLine2" Placeholder="Apartment, suite, etc." />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">City</label>
                                    <HrTextBox @bind-Value="Model.City" Placeholder="e.g. London" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">County / State</label>
                                    <HrTextBox @bind-Value="Model.County" Placeholder="e.g. Greater London" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Post Code</label>
                                    <HrTextBox @bind-Value="Model.PostCode" Placeholder="e.g. SW1A 1AA" />
                                    <ValidationMessage For="@(() => Model.PostCode)" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Country</label>
                                    <HrTextBox @bind-Value="Model.Country" Placeholder="e.g. United Kingdom" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Users &amp; Access</h5>
                        </div>
                        <div class="card-body">
                            <SfCheckBox TChecked="bool"
                                        Label="Allow this employee to sign in."
                                        @bind-Checked="Model.HasSystemAccess" />
                            @if (Model.HasSystemAccess)
                            {
                                <hr class="my-3" />
                                <p class="text-muted small mb-2">
                                    Invite links expire after 7 days. Generating a new invite link invalidates any previous unused link.
                                </p>
                                <SfCheckBox TChecked="bool"
                                            Label="Send invite link after creating employee"
                                            @bind-Checked="_sendInviteOnCreate" />
                            }
                        </div>
                    </div>

                    <div class="d-flex gap-2 align-items-center mt-3 justify-content-end">
                        <SfButton IsPrimary="true" Disabled="@Saving" OnClick="SaveAsync">
                            @if (Saving)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            Save
                        </SfButton>
                        <SfButton OnClick="RequestClose" Disabled="@Saving">Cancel</SfButton>
                    </div>
                </div>
            </div>
        </EditForm>
    }
    else
    {
        <div class="d-flex align-items-center gap-3 mb-1">
            <h1 class="mb-0">@(_employee?.FirstName) @(_employee?.LastName)</h1>
            @if (_employee is not null)
            {
                <span class="badge rounded-pill px-3 py-2 fs-6 fw-normal @StatusBadgeClass(_employee.Status)">@StatusDisplayName(_employee.Status)</span>
                @if (!string.IsNullOrEmpty(_employee.EmployeeNumber))
                {
                    <span class="text-muted">#@_employee.EmployeeNumber</span>
                }
            }
            <div class="ms-auto d-flex align-items-center gap-2">
                @if (IsViewMode && Session.CanManageEmployees)
                {
                    <SfButton CssClass="e-small e-primary" data-testid="edit-details-button" OnClick="EnterEditMode">
                        <i class="fa-solid fa-pen me-1"></i>Edit details
                    </SfButton>
                }
                @if (Session.CanManageEmployees)
                {
                    <SfDropDownButton Content="More actions" IconCss="fa-solid fa-ellipsis-vertical" CssClass="e-small e-flat"
                                       Items="_moreActionsItems">
                        <DropDownButtonEvents ItemSelected="HandleMoreActionSelected" />
                    </SfDropDownButton>
                }
            </div>
        </div>

        @if (Session.CanManageEmployees && _employee is not null)
        {
            <EmployeeProfilePhotoHeader CompanyId="CompanyId" EmployeeId="Id!.Value" Initials="@EmployeeInitials" />
        }

        @if (_employee?.ManagerId is not null)
        {
            <p class="text-muted small mb-1">
                Reports To:
                <a href="/companies/@CompanyId/employees/@_employee.ManagerId">@_employee.ManagerFullName</a>
            </p>
        }
        @if (_employee?.DirectReportsCount > 0)
        {
            <p class="text-muted small mb-1">
                Direct Reports:
                <a href="/companies/@CompanyId/organisation-chart?employeeId=@Id">@_employee.DirectReportsCount Employee@(_employee.DirectReportsCount == 1 ? "" : "s")</a>
            </p>
        }
        <p class="text-muted mb-3">View and manage this employee's profile, employment, leave, and documents.</p>

        @if (_employee?.ReportingChain is { Count: > 0 })
        {
            <div class="card mb-3">
                <div class="card-body py-2 px-3">
                    <h6 class="text-muted small text-uppercase mb-2">Reporting Chain</h6>
                    <div class="d-flex flex-column align-items-start">
                        @foreach (var link in _employee.ReportingChain)
                        {
                            <div class="mb-1">
                                <a href="/companies/@CompanyId/employees/@link.EmployeeId" class="fw-semibold text-decoration-none">@link.Name</a>
                                @if (!string.IsNullOrEmpty(link.JobTitle))
                                {
                                    <span class="text-muted small"> — @link.JobTitle</span>
                                }
                            </div>
                            <div class="text-muted mb-1">↓</div>
                        }
                        <div>
                            <span class="fw-semibold">@_employee.FirstName @_employee.LastName</span>
                            <span class="badge bg-secondary-subtle text-secondary-emphasis ms-1">Current Employee</span>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(GlobalError))
        {
            <div class="alert alert-danger mb-3">@GlobalError</div>
        }

        <SfTab @bind-SelectedItem="_activeTabIndex">
            <TabItems>

                <TabItem>
                    <ChildContent><TabHeader Text="Details" /></ChildContent>
                    <ContentTemplate>
                        <EditForm EditContext="EditContext">
                            <DataAnnotationsValidator />
                            <div class="mt-4 row">
                                <div class="col-lg-10 col-xl-9">
                                    <p class="text-muted small mb-3">Fields marked <span class="text-danger">*</span> are required.</p>
                                    <div class="card mb-4">
                                        <div class="card-header">
                                            <h5 class="mb-0">Personal Information</h5>
                                        </div>
                                        <div class="card-body @(IsViewMode ? "view-mode" : "")">
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label class="form-label" for="employee-first-name">First Name <span class="text-danger">*</span></label>
                                                    <HrTextBox ID="employee-first-name" @bind-Value="Model.FirstName" Placeholder="First name" ReadOnly="@IsViewMode" />
                                                    <ValidationMessage For="@(() => Model.FirstName)" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label" for="employee-last-name">Last Name <span class="text-danger">*</span></label>
                                                    <HrTextBox ID="employee-last-name" @bind-Value="Model.LastName" Placeholder="Last name" ReadOnly="@IsViewMode" />
                                                    <ValidationMessage For="@(() => Model.LastName)" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label" for="employee-preferred-name">Preferred Name</label>
                                                    <HrTextBox ID="employee-preferred-name" @bind-Value="Model.PreferredName" Placeholder="Defaults to first name" ReadOnly="@IsViewMode" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label" for="employee-dob">Date of Birth <span class="text-danger">*</span></label>
                                                    <SfDatePicker ID="employee-dob" TValue="DateOnly?" @bind-Value="Model.DateOfBirth" Placeholder="dd/mm/yyyy" Format="dd/MM/yyyy" Enabled="@(!IsViewMode)" />
                                                    <ValidationMessage For="@(() => Model.DateOfBirth)" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label" for="employee-nationality">Nationality <span class="text-danger">*</span></label>
                                                    <SfDropDownList ID="employee-nationality"
                                                                    TValue="string"
                                                                    TItem="NationalityListItem"
                                                                    DataSource="@_nationalities"
                                                                    @bind-Value="Model.Nationality"
                                                                    Placeholder="Select nationality"
                                                                    AllowFiltering="true"
                                                                    Enabled="@(!IsViewMode)">
                                                        <DropDownListFieldSettings Value="Name" Text="Name" />
                                                    </SfDropDownList>
                                                    <ValidationMessage For="@(() => Model.Nationality)" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label" for="employee-gender">Gender <span class="text-danger">*</span></label>
                                                    <SfDropDownList ID="employee-gender"
                                                                    TValue="string"
                                                                    TItem="string"
                                                                    DataSource="@_genderOptions"
                                                                    @bind-Value="Model.Gender"
                                                                    Placeholder="Select gender"
                                                                    Enabled="@(!IsViewMode)">
                                                    </SfDropDownList>
                                                    <ValidationMessage For="@(() => Model.Gender)" />
                                                    @if (Model.Gender == "Other")
                                                    {
                                                        <div class="mt-2">
                                                            <HrTextBox @bind-Value="Model.GenderOther" Placeholder="Please specify" ReadOnly="@IsViewMode" />
                                                        </div>
                                                    }
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label" for="employee-work-email">Work Email <span class="text-danger">*</span></label>
                                                    <HrTextBox ID="employee-work-email" @bind-Value="Model.WorkEmail" Placeholder="work@company.com" ReadOnly="@IsViewMode" />
                                                    <ValidationMessage For="@(() => Model.WorkEmail)" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label" for="employee-personal-email">Personal Email</label>
                                                    <HrTextBox ID="employee-personal-email" @bind-Value="Model.PersonalEmail" Placeholder="personal@example.com" ReadOnly="@IsViewMode" />
                                                    <ValidationMessage For="@(() => Model.PersonalEmail)" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label" for="employee-start-date">Start Date <span class="text-danger">*</span></label>
                                                    <SfDatePicker ID="employee-start-date" TValue="DateOnly" @bind-Value="Model.StartDate" Enabled="@(!IsViewMode)" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card mb-4">
                                        <div class="card-header">
                                            <h5 class="mb-0">Contact Details</h5>
                                        </div>
                                        <div class="card-body @(IsViewMode ? "view-mode" : "")">
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label class="form-label" for="employee-phone">Mobile / Work Phone</label>
                                                    <HrTextBox ID="employee-phone" @bind-Value="Model.PhoneNumber" Placeholder="e.g. 07700 900000" ReadOnly="@IsViewMode" />
                                                    <ValidationMessage For="@(() => Model.PhoneNumber)" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label" for="employee-home-phone">Home Phone</label>
                                                    <HrTextBox ID="employee-home-phone" @bind-Value="Model.HomePhone" Placeholder="e.g. 01234 567890" ReadOnly="@IsViewMode" />
                                                    <ValidationMessage For="@(() => Model.HomePhone)" />
                                                </div>
                                                <div class="col-12">
                                                    <label class="form-label" for="employee-address-1">Address Line 1</label>
                                                    <HrTextBox ID="employee-address-1" @bind-Value="Model.AddressLine1" Placeholder="Street address" ReadOnly="@IsViewMode" />
                                                </div>
                                                <div class="col-12">
                                                    <label class="form-label" for="employee-address-2">Address Line 2</label>
                                                    <HrTextBox ID="employee-address-2" @bind-Value="Model.AddressLine2" Placeholder="Apartment, suite, etc." ReadOnly="@IsViewMode" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label" for="employee-city">City</label>
                                                    <HrTextBox ID="employee-city" @bind-Value="Model.City" Placeholder="e.g. London" ReadOnly="@IsViewMode" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label" for="employee-county">County / State</label>
                                                    <HrTextBox ID="employee-county" @bind-Value="Model.County" Placeholder="e.g. Greater London" ReadOnly="@IsViewMode" />
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label" for="employee-postcode">Post Code</label>
                                                    <HrTextBox ID="employee-postcode" @bind-Value="Model.PostCode" Placeholder="e.g. SW1A 1AA" ReadOnly="@IsViewMode" />
                                                    <ValidationMessage For="@(() => Model.PostCode)" />
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label" for="employee-country">Country</label>
                                                    <HrTextBox ID="employee-country" @bind-Value="Model.Country" Placeholder="e.g. United Kingdom" ReadOnly="@IsViewMode" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <hr class="my-4 employee-section-divider" />

                                    <!-- Users & Access: structurally separated from personal-information cards above
                                         (own heading + divider) rather than a new top-level tab, since this page's
                                         SfTab indices are computed by hand from a fixed tab count elsewhere in this
                                         file (see the index-math comments near _activeTabIndex below) and adding a
                                         tab here would require re-deriving every one of those constants. -->
                                    <h6 class="text-muted text-uppercase small mb-2">Users &amp; Access</h6>
                                    <div class="card mb-4">
                                        <div class="card-header">
                                            <h5 class="mb-0">Users &amp; Access</h5>
                                        </div>
                                        <div class="card-body @(IsViewMode ? "view-mode" : "")">
                                            <SfCheckBox TChecked="bool"
                                                        Label="Allow this employee to sign in."
                                                        @bind-Checked="Model.HasSystemAccess"
                                                        Enabled="@(!IsViewMode)" />
                                            @if (Model.HasSystemAccess)
                                            {
                                                <hr class="my-3" />
                                                <p class="text-muted small mb-2">
                                                    Invite links expire after 7 days. Generating a new invite link invalidates any previous unused link.
                                                </p>
                                                @if (!string.IsNullOrEmpty(_inviteError))
                                                {
                                                    <div class="alert alert-danger py-2">@_inviteError</div>
                                                }
                                                @if (_inviteLink is not null)
                                                {
                                                    <div class="alert alert-success py-2">
                                                        <div class="mb-1"><strong>Invite link generated</strong> — expires @_inviteExpiresAt.ToString("MMM d, yyyy")</div>
                                                        <div class="input-group">
                                                            <input class="form-control form-control-sm font-monospace" readonly value="@_inviteLink" />
                                                            <SfButton CssClass="e-small" OnClick="CopyLink">Copy</SfButton>
                                                        </div>
                                                        <small class="text-muted">Share this link with the employee to let them set their password.</small>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <SfButton OnClick="SendInvite" Disabled="@(_sendingInvite || IsViewMode)">
                                                        @if (_sendingInvite)
                                                        {
                                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                                        }
                                                        Generate Invite Link
                                                    </SfButton>
                                                }
                                            }
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </EditForm>
                    </ContentTemplate>
                </TabItem>

                <TabItem>
                    <ChildContent><TabHeader Text="Employment" /></ChildContent>
                    <ContentTemplate>
                        <div class="mt-4">
                            <EmployeeEmploymentTab @ref="_employmentTab" CompanyId="CompanyId" EmployeeId="Id!.Value" IsViewMode="IsViewMode" />
                        </div>
                    </ContentTemplate>
                </TabItem>

                <TabItem>
                    <ChildContent><TabHeader Text="Compensation History" /></ChildContent>
                    <ContentTemplate>
                        <div class="mt-4">
                            <EmployeeCompensationTab CompanyId="CompanyId" EmployeeId="Id!.Value" />
                        </div>
                    </ContentTemplate>
                </TabItem>

                <TabItem>
                    <ChildContent><TabHeader Text="Promotion History" /></ChildContent>
                    <ContentTemplate>
                        <div class="mt-4">
                            <EmployeePromotionHistoryTab CompanyId="CompanyId" EmployeeId="Id!.Value"
                                                          CurrentPositionProfileTitle="@CurrentPositionProfileTitle" />
                        </div>
                    </ContentTemplate>
                </TabItem>

                @if (_showProbationTab)
                {
                    <TabItem>
                        <ChildContent><TabHeader Text="Probation" /></ChildContent>
                        <ContentTemplate>
                            <div class="mt-4">
                                <EmployeeProbationTab CompanyId="CompanyId" EmployeeId="Id!.Value" />
                            </div>
                        </ContentTemplate>
                    </TabItem>
                }

                <TabItem>
                    <ChildContent><TabHeader Text="Emergency Contacts" /></ChildContent>
                    <ContentTemplate>
                        <div class="mt-4">
                            <EmployeeEmergencyContactsTab CompanyId="CompanyId" EmployeeId="Id!.Value" />
                        </div>
                    </ContentTemplate>
                </TabItem>

                <TabItem>
                    <ChildContent><TabHeader Text="Leave" /></ChildContent>
                    <ContentTemplate>
                        <div class="mt-4">
                            <EmployeeLeaveTab CompanyId="CompanyId"
                                              EmployeeId="Id!.Value" />
                        </div>
                    </ContentTemplate>
                </TabItem>

                <TabItem>
                    <ChildContent><TabHeader Text="Sickness" /></ChildContent>
                    <ContentTemplate>
                        <div class="mt-4">
                            <EmployeeSicknessTab CompanyId="CompanyId" EmployeeId="Id!.Value" />
                        </div>
                    </ContentTemplate>
                </TabItem>

                <TabItem>
                    <ChildContent><TabHeader Text="Tasks" /></ChildContent>
                    <ContentTemplate>
                        <div class="mt-4">
                            <EmployeeTasksTab CompanyId="CompanyId" EmployeeId="Id!.Value" />
                        </div>
                    </ContentTemplate>
                </TabItem>

                <TabItem>
                    <ChildContent><TabHeader Text="Documents" /></ChildContent>
                    <ContentTemplate>
                        <div class="mt-4">
                            <EmployeeDocumentsTab CompanyId="CompanyId" EmployeeId="Id!.Value" />
                        </div>
                    </ContentTemplate>
                </TabItem>

                <TabItem>
                    <ChildContent><TabHeader Text="Assets" /></ChildContent>
                    <ContentTemplate>
                        <div class="mt-4">
                            <EmployeeAssetsTab CompanyId="CompanyId" EmployeeId="Id!.Value" />
                        </div>
                    </ContentTemplate>
                </TabItem>

                <TabItem>
                    <ChildContent><TabHeader Text="Acknowledgement History" /></ChildContent>
                    <ContentTemplate>
                        <div class="mt-4">
                            <EmployeeAcknowledgementHistoryTab CompanyId="CompanyId" EmployeeId="Id!.Value" />
                        </div>
                    </ContentTemplate>
                </TabItem>

                <TabItem>
                    <ChildContent><TabHeader Text="Audit" /></ChildContent>
                    <ContentTemplate>
                        <div class="mt-4">
                            <EmployeeAuditHistoryTab CompanyId="CompanyId" EmployeeId="Id!.Value" />
                        </div>
                    </ContentTemplate>
                </TabItem>

                <TabItem>
                    <ChildContent><TabHeader Text="Timeline" /></ChildContent>
                    <ContentTemplate>
                        <div class="mt-4">
                            <EmployeeTimelineTab CompanyId="CompanyId" EmployeeId="Id!.Value"
                                                  OnNavigateToPromotions="@(() => _activeTabIndex = 3)"
                                                  OnNavigateToCompensation="@(() => _activeTabIndex = 2)"
                                                  OnNavigateToProbation="@(() => { if (_showProbationTab) _activeTabIndex = 4; })"
                                                  OnNavigateToOnboarding="@(() => { if (_showOnboardingTab) _activeTabIndex = OnboardingTabIndex; })"
                                                  OnNavigateToDocuments="@(() => _activeTabIndex = 9 + ProbationOffset)"
                                                  OnNavigateToAcknowledgements="@(() => _activeTabIndex = 11 + ProbationOffset)"
                                                  OnNavigateToOffboarding="@(() => { if (_showOffboardingTab) _activeTabIndex = OffboardingTabIndex; })"
                                                  OnNavigateToNotes="@(() => { if (Session.IsHrAdministrator) _activeTabIndex = NotesTabIndex; })" />
                        </div>
                    </ContentTemplate>
                </TabItem>

                @if (_showOnboardingTab)
                {
                    <TabItem>
                        <ChildContent><TabHeader Text="Onboarding" /></ChildContent>
                        <ContentTemplate>
                            <div class="mt-4">
                                <EmployeeOnboardingTab CompanyId="CompanyId" EmployeeId="Id!.Value" />
                            </div>
                        </ContentTemplate>
                    </TabItem>
                }

                @if (_showOffboardingTab)
                {
                    <TabItem>
                        <ChildContent><TabHeader Text="Offboarding" /></ChildContent>
                        <ContentTemplate>
                            <div class="mt-4">
                                <EmployeeOffboardingTab CompanyId="CompanyId" EmployeeId="Id!.Value" />
                            </div>
                        </ContentTemplate>
                    </TabItem>
                }

                @if (_showLeavingTab)
                {
                    <TabItem>
                        <ChildContent><TabHeader Text="Leaving" /></ChildContent>
                        <ContentTemplate>
                            <div class="mt-4">
                                <EmployeeLeavingTab CompanyId="CompanyId" EmployeeId="Id!.Value"
                                                     OnAmendRequested="OpenAmendLeavingProcessDialog"
                                                     OnCancelRequested="OpenCancelLeavingProcessDialog" />
                            </div>
                        </ContentTemplate>
                    </TabItem>
                }

                @if (Session.IsHrAdministrator)
                {
                    <TabItem>
                        <ChildContent><TabHeader Text="Notes" /></ChildContent>
                        <ContentTemplate>
                            <div class="mt-4">
                                <EmployeeNotesTab CompanyId="CompanyId" EmployeeId="Id!.Value" />
                            </div>
                        </ContentTemplate>
                    </TabItem>
                }

            </TabItems>
        </SfTab>

        @if (!string.IsNullOrEmpty(_saveSuccessMessage))
        {
            <div class="alert alert-success mt-4" role="status" aria-live="polite">@_saveSuccessMessage</div>
        }

        @if (IsViewMode)
        {
            <div class="d-flex gap-2 align-items-center mt-4 justify-content-end">
                <SfButton OnClick="@(() => Navigation.NavigateTo(ListUrl!))">Back to employees</SfButton>
            </div>
        }
        else
        {
            <!-- Sticky so Save/Cancel stay reachable while scrolling through the long form/tabs
                 below; only rendered in edit mode, per AC3. -->
            <div class="employee-edit-sticky-bar">
                <div class="d-flex gap-2 align-items-center justify-content-end">
                    <SfButton IsPrimary="true" Disabled="@Saving" OnClick="SaveAsync">
                        @if (Saving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Save
                    </SfButton>
                    <SfButton OnClick="CancelEdit" Disabled="@Saving">Cancel</SfButton>
                </div>
            </div>
        }

        @if (_employee is not null)
        {
            <StartLeavingProcessDialog IsOpen="_showStartLeavingProcessDialog"
                                        CompanyId="CompanyId"
                                        EmployeeId="Id!.Value"
                                        EffectiveNoticePeriodUnit="_employee.EffectiveNoticePeriodUnit"
                                        EffectiveNoticePeriodLength="_employee.EffectiveNoticePeriodLength"
                                        OnCancelled="CloseStartLeavingProcessDialog"
                                        OnCompleted="OnLeavingProcessStarted" />

            <AmendLeavingProcessDialog IsOpen="_showAmendLeavingProcessDialog"
                                        CompanyId="CompanyId"
                                        EmployeeId="Id!.Value"
                                        OnCancelled="CloseAmendLeavingProcessDialog"
                                        OnCompleted="OnLeavingProcessAmended" />

            <CancelLeavingProcessDialog IsOpen="_showCancelLeavingProcessDialog"
                                         CompanyId="CompanyId"
                                         EmployeeId="Id!.Value"
                                         ShowOffboardingTab="_showOffboardingTab"
                                         OnCancelled="CloseCancelLeavingProcessDialog"
                                         OnCompleted="OnLeavingProcessCancelled" />
        }
    }

    <NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges" />

    <UnsavedChangesDialog Visible="ShowUnsavedChangesDialog"
                          OnSaveAndClose="ConfirmSaveAndCloseAsync"
                          OnDiscard="DiscardChangesAndClose"
                          OnCancel="CancelCloseDialog" />
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid? Id { get; set; }

    private bool IsNew => Id is null || Id == Guid.Empty;
    private string PageTitle => IsNew ? "Add Employee" : $"{Model.FirstName} {Model.LastName}".Trim();

    private GetEmployeeResponse? _employee;

    private string CurrentPositionProfileTitle =>
        _positionProfiles.FirstOrDefault(p => p.Id == _employee?.PositionProfileId)?.Title ?? "—";

    private string EmployeeInitials => string.Concat(
        (_employee?.FirstName?.Length > 0 ? _employee.FirstName[0].ToString() : ""),
        (_employee?.LastName?.Length  > 0 ? _employee.LastName[0].ToString()  : "")).ToUpperInvariant()
        is { Length: > 0 } i ? i : "?";

    private bool _sendInviteOnCreate;
    private bool _sendingInvite;
    private string? _inviteLink;
    private DateOnly _inviteExpiresAt;
    private string? _inviteError;
    private string? _redirectUrl;
    private string? _saveSuccessMessage;

    // "More actions" overflow (AC12): groups the less-frequent "Start offboarding" action so it's
    // no longer a prominent primary page action. Only Organisation Chart is always shown here;
    // Start offboarding is added conditionally below once _showLeavingTab is known.
    private List<DropDownMenuItem> _moreActionsItems = [];

    private void BuildMoreActionsItems()
    {
        _moreActionsItems =
        [
            new DropDownMenuItem { Id = "org-chart", Text = "View Organisation Chart", IconCss = "fa-solid fa-sitemap" },
        ];

        if (!_showLeavingTab)
        {
            _moreActionsItems.Add(new DropDownMenuItem
            {
                Id = "start-offboarding",
                Text = "Start offboarding",
                IconCss = "fa-solid fa-right-from-bracket"
            });
        }
    }

    private void HandleMoreActionSelected(Syncfusion.Blazor.SplitButtons.MenuEventArgs args)
    {
        switch (args.Item?.Id)
        {
            case "org-chart":
                Navigation.NavigateTo($"/companies/{CompanyId}/organisation-chart?employeeId={Id}");
                break;
            case "start-offboarding":
                OpenStartLeavingProcessDialog();
                break;
        }
    }

    // "Edit details" (AC2) — drops the "/view" suffix and does a full reload so the edit form
    // starts from freshly-fetched data rather than whatever was last rendered in view mode.
    private void EnterEditMode() =>
        Navigation.NavigateTo($"/companies/{CompanyId}/employees/{Id}", forceLoad: true);

    // Cancel (AC5) — discards any in-progress edits (both this page's Model and the Employment
    // tab's own independent model) by doing a full reload back into view mode, rather than
    // attempting to hand-revert every bound field.
    private void CancelEdit() =>
        Navigation.NavigateTo($"/companies/{CompanyId}/employees/{Id}/view", forceLoad: true);

    private static readonly string[] _genderOptions = ["Male", "Female", "Non-binary", "Prefer not to say", "Other"];

    private List<DepartmentListItemModel> _departments = [];
    private List<LocationListItemModel> _locations = [];
    private List<PositionProfileListItemModel> _positionProfiles = [];
    private List<EmploymentTypeListItemModel> _employmentTypes = [];
    private List<NationalityListItem> _nationalities = [];
    private SfDropDownList<Guid?, ManagerOption> _managerDropdown = default!;
    private List<ManagerOption> _managerOptions = [];

    private GetPositionProfileResponse? _selectedProfileDefaults;
    private string? _selectedProfileLeavePolicyName;

    private EmployeeEmploymentTab? _employmentTab;
    private int _activeTabIndex;

    // Probation only gets a tab while an active record exists (Active/ReviewDue/Extended) —
    // hidden once Passed/Failed, or when the employee never had a record at all. Since Probation
    // sits above every other conditional/fixed tab in this markup, hiding it shifts every
    // subsequent tab's index down by one.
    private bool _showProbationTab;
    private int ProbationOffset => _showProbationTab ? 0 : -1;

    // Leave is always rendered (not conditional like Probation/Onboarding/Offboarding), but its
    // own index still shifts by ProbationOffset since it sits after Probation in this markup.
    private int LeaveTabIndex => 6 + ProbationOffset;

    // Onboarding only gets a tab once a plan exists, and loses it again once that plan is
    // Completed — completed history remains visible via the Audit tab instead (see
    // OnboardingPlanCompletedAuditEvent). Offboarding's tab index shifts whenever Onboarding's (or
    // Probation's) tab isn't rendered, since Syncfusion's SfTab indexes by however many <TabItem>
    // elements actually render, not by their position in this markup.
    //
    // Counted directly from the markup above (Details, Employment, Compensation, Promotion
    // History, [Probation], Emergency Contacts, Leave, Sickness, Tasks, Documents, Assets,
    // Acknowledgement History, Audit, Timeline = 13 always-rendered tabs before Onboarding, plus 1
    // more when Probation renders), not trusted from any older constant — this file has picked up
    // tabs (e.g. Promotion History, Timeline) since these indices were last set, so re-derive them
    // from the actual <TabItem> count rather than assuming the previous numbers still held.
    private bool _showOnboardingTab;
    private int OnboardingTabIndex => 14 + ProbationOffset;
    private int OffboardingTabIndex => (_showOnboardingTab ? 15 : 14) + ProbationOffset;

    // Offboarding only gets a tab once a plan has been started, and loses it again once that
    // plan is Completed/Cancelled — completed history remains visible via the Audit tab instead
    // (see OffboardingPlanCompletedAuditEvent). It sits directly before Leaving in this markup, so
    // its own visibility still needs to be accounted for by LeavingTabIndex below, but nothing
    // after Leaving depends on it.
    private bool _showOffboardingTab;

    // Leaving only gets a tab once a leaving process has been started for this employee (i.e.
    // Employee.Status has moved to "Leaving" — see GetEmployeeHandler.ShowLeavingTab). It's the
    // last tab in this markup, immediately after Offboarding, so its index is simply
    // OffboardingTabIndex plus one more slot if Offboarding itself is currently rendered.
    private bool _showLeavingTab;
    private int LeavingTabIndex => OffboardingTabIndex + (_showOffboardingTab ? 1 : 0);

    // Notes (HR-only) is the very last tab, rendered after Leaving when Leaving itself is shown.
    private int NotesTabIndex => LeavingTabIndex + (_showLeavingTab ? 1 : 0);

    private EmployeeNumberMode _companyEmployeeNumberMode = EmployeeNumberMode.Manual;

    protected override async Task LoadAsync()
    {
        await Session.InitialiseAsync();
        if (!Session.CanManageEmployees)
        {
            Navigation.NavigateTo(Session.MyProfileUrl, replace: true);
            return;
        }

        var deptResult = await DepartmentService.ListDepartmentsAsync(CompanyId);
        _departments = deptResult?.Items ?? [];

        var locationResult = await LocationService.ListLocationsAsync(CompanyId);
        _locations = locationResult?.Items ?? [];

        var profileResult = await PositionProfileService.ListPositionProfilesAsync(CompanyId);
        _positionProfiles = profileResult?.Items.ToList() ?? [];

        var employmentTypeResult = await EmploymentTypeService.ListEmploymentTypesAsync(CompanyId);
        _employmentTypes = employmentTypeResult?.Items ?? [];

        var natResult = await EmployeeService.ListNationalitiesAsync();
        _nationalities = natResult?.Items.ToList() ?? [];

        Model.PostcodeRegexPattern = Session.PostcodeRegex;
        Model.TelephoneRegexPattern = Session.TelephoneRegex;
        Model.MobileRegexPattern = Session.MobileRegex;

        if (!IsNew)
        {
            _employee = await EmployeeService.GetEmployeeAsync(CompanyId, Id!.Value);
            if (_employee is not null)
            {
                Model.FirstName = _employee.FirstName;
                Model.LastName = _employee.LastName;
                Model.PreferredName = _employee.PreferredName ?? string.Empty;
                Model.WorkEmail = _employee.WorkEmail;
                Model.PersonalEmail = _employee.PersonalEmail;
                Model.StartDate = _employee.StartDate;
                Model.DateOfBirth = _employee.DateOfBirth;
                Model.Nationality = _employee.Nationality ?? string.Empty;
                Model.Gender = _employee.Gender ?? string.Empty;
                Model.GenderOther    = _employee.GenderOther    ?? string.Empty;
                Model.PhoneNumber    = _employee.PhoneNumber    ?? string.Empty;
                Model.HomePhone      = _employee.HomePhone      ?? string.Empty;
                Model.AddressLine1   = _employee.AddressLine1   ?? string.Empty;
                Model.AddressLine2   = _employee.AddressLine2   ?? string.Empty;
                Model.City           = _employee.City           ?? string.Empty;
                Model.County         = _employee.County         ?? string.Empty;
                Model.PostCode       = _employee.PostCode       ?? string.Empty;
                Model.Country        = _employee.Country        ?? string.Empty;
                Model.HasSystemAccess = _employee.HasSystemAccess;
                // Not shown on this tab (owned by the Employment tab's own model/form), but
                // EmployeeProfileEditModel is validated as a whole via the shared EditContext, so
                // these must still be populated here or Save on the Details tab would fail
                // DataAnnotations validation for an existing employee.
                Model.EmployeeNumber = _employee.EmployeeNumber ?? string.Empty;
                Model.EmploymentTypeId = _employee.EmploymentTypeId;
                Model.DepartmentId = _employee.DepartmentId;
                Model.LocationId = _employee.LocationId;
                Model.PositionProfileId = _employee.PositionProfileId;

                // The employee profile response is the single source of truth for lifecycle tab
                // visibility — these rules live server-side (GetEmployeeHandler) precisely so
                // this page doesn't have to re-derive them from separately-fetched plan/record
                // statuses.
                _showProbationTab = _employee.ShowProbationTab;
                _showOnboardingTab = _employee.ShowOnboardingTab;
                _showOffboardingTab = _employee.ShowOffboardingTab;
                _showLeavingTab = _employee.ShowLeavingTab;
            }

            var uri = new Uri(Navigation.Uri);
            if (uri.Query.Contains("invited=true") && _employee is not null)
                await SendInvite();
        }
        else
        {
            Model.StartDate = DateOnly.FromDateTime(DateTime.Today);

            var hrSettings = await CompanyService.GetHrSettingsAsync(CompanyId);
            _companyEmployeeNumberMode = hrSettings?.EmployeeNumberMode ?? EmployeeNumberMode.Manual;
            Model.EmployeeNumberAutoAssigned = _companyEmployeeNumberMode == EmployeeNumberMode.Automatic;

            var managerResult = await EmployeeService.ListEmployeesAsync(CompanyId, pageSize: 50);
            _managerOptions = (managerResult?.Items ?? [])
                .Where(e => e.Status != "Draft" && e.Status != "FormerEmployee")
                .Select(e => new ManagerOption(e.Id, $"{e.FirstName} {e.LastName}"))
                .OrderBy(e => e.Name)
                .Prepend(new ManagerOption(Guid.Empty, "No Manager"))
                .ToList();

            Model.ManagerId = Guid.Empty;
        }

        // Parsed after _showProbationTab/_showOnboardingTab/_showOffboardingTab are known, since
        // every later tab's index depends on whether those actually rendered above it.
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (query.TryGetValue("tab", out var tab))
        {
            var tabValue = tab.ToString();

            _activeTabIndex = tabValue switch
            {
                "probation" => _showProbationTab ? 4 : 0,
                "leave" => LeaveTabIndex,
                "onboarding" => _showOnboardingTab ? OnboardingTabIndex : 0,
                "offboarding" => OffboardingTabIndex,
                "leaving" => _showLeavingTab ? LeavingTabIndex : 0,
                "timeline" => 13 + ProbationOffset,
                _ => 0
            };
        }

        BuildMoreActionsItems();
    }

    private bool _showStartLeavingProcessDialog;

    private void OpenStartLeavingProcessDialog() => _showStartLeavingProcessDialog = true;

    private void CloseStartLeavingProcessDialog() => _showStartLeavingProcessDialog = false;

    // This doesn't deep-link into a tab first — the whole flow is
    // captured by the wizard dialog itself. Once it succeeds, a forceLoad navigate to
    // ?tab=leaving is the simplest way to re-trigger LoadAsync and re-derive every tab
    // flag/index (including the now-true _showLeavingTab) from a freshly-fetched employee.
    private void OnLeavingProcessStarted()
    {
        _showStartLeavingProcessDialog = false;
        Navigation.NavigateTo($"/companies/{CompanyId}/employees/{Id}?tab=leaving", forceLoad: true);
    }

    private bool _showAmendLeavingProcessDialog;

    private void OpenAmendLeavingProcessDialog() => _showAmendLeavingProcessDialog = true;

    private void CloseAmendLeavingProcessDialog() => _showAmendLeavingProcessDialog = false;

    // Same forceLoad-to-?tab=leaving pattern as OnLeavingProcessStarted, but also carries the
    // OffboardingAlreadyStarted flag through as its own query-string flag — that's the simplest way
    // for EmployeeLeavingTab to still know about it after this full-page reload, since the value only
    // exists on the AmendLeavingProcessResponse from this one request and wouldn't otherwise survive.
    private void OnLeavingProcessAmended(bool offboardingAlreadyStarted)
    {
        _showAmendLeavingProcessDialog = false;
        var suffix = offboardingAlreadyStarted ? "&offboardingAlreadyStarted=true" : string.Empty;
        Navigation.NavigateTo($"/companies/{CompanyId}/employees/{Id}?tab=leaving{suffix}", forceLoad: true);
    }

    private bool _showCancelLeavingProcessDialog;

    private void OpenCancelLeavingProcessDialog() => _showCancelLeavingProcessDialog = true;

    private void CloseCancelLeavingProcessDialog() => _showCancelLeavingProcessDialog = false;

    // Unlike Start/Amend, no ?tab= is needed here — cancelling flips the employee's status back to
    // Active, so GetEmployeeHandler will derive ShowLeavingTab as false on the next fetch and the tab
    // itself disappears; a plain forceLoad reload lands back on the default (Details) tab.
    private void OnLeavingProcessCancelled()
    {
        _showCancelLeavingProcessDialog = false;
        Navigation.NavigateTo($"/companies/{CompanyId}/employees/{Id}", forceLoad: true);
    }

    // Same pattern as EmployeeEmploymentTab.OnManagerFilteringAsync — the manager list can't be
    // preloaded in one bounded page, so search server-side as the user types.
    private int _managerFilterRequestId;

    // Requests aren't guaranteed to resolve in the order they were fired — applying every response
    // unconditionally means a late-arriving response for an earlier keystroke can land after the
    // user already picked a manager from a later, faster response, visibly clearing their
    // selection. Only the most recently issued request's response is applied.
    private async Task OnManagerFilteringAsync(Syncfusion.Blazor.DropDowns.FilteringEventArgs args)
    {
        args.PreventDefaultAction = true;
        var requestId = ++_managerFilterRequestId;
        var result = await EmployeeService.ListEmployeesAsync(CompanyId, search: args.Text, pageSize: 50);
        if (requestId != _managerFilterRequestId) return;
        _managerOptions = (result?.Items ?? [])
            .Where(e => e.Status != "Draft" && e.Status != "FormerEmployee")
            .Select(e => new ManagerOption(e.Id, $"{e.FirstName} {e.LastName}"))
            .OrderBy(e => e.Name)
            .Prepend(new ManagerOption(Guid.Empty, "No Manager"))
            .ToList();
        await _managerDropdown.FilterAsync(_managerOptions, new Query());
    }

    private sealed record ManagerOption(Guid Id, string Name);

    private async Task OnPositionProfileChanged(ChangeEventArgs<Guid?, PositionProfileListItemModel> args)
    {
        Model.PositionProfileId = args.Value;
        _selectedProfileDefaults = null;
        _selectedProfileLeavePolicyName = null;

        if (args.Value is Guid profileId)
        {
            _selectedProfileDefaults = await PositionProfileService.GetPositionProfileAsync(CompanyId, profileId);

            if (_selectedProfileDefaults is not null)
            {
                Model.DepartmentId = _selectedProfileDefaults.DepartmentId;
                Model.LocationId = _selectedProfileDefaults.LocationId;

                if (_selectedProfileDefaults.DefaultLeavePolicyId is Guid leavePolicyId)
                {
                    var policies = await LeavePolicyService.ListLeavePoliciesAsync(CompanyId, activeOnly: true);
                    _selectedProfileLeavePolicyName = policies?.Items.FirstOrDefault(p => p.Id == leavePolicyId)?.Name;
                }
            }
        }
    }

    private static string ProfileWorkingPatternSummary(GetPositionProfileResponse profile)
    {
        if (profile.WorkingDaysOverride is null || profile.HoursPerDayOverride is null)
            return "Company default";

        return WorkingPatternFormatter.Summarize(profile.WorkingDaysOverride.Value, profile.HoursPerDayOverride.Value);
    }

    private static string ProfileSalaryRangeSummary(GetPositionProfileResponse profile) => (profile.SalaryMin, profile.SalaryMax) switch
    {
        (not null, not null) => $"{profile.SalaryMin:N0} - {profile.SalaryMax:N0}",
        (not null, null) => $"From {profile.SalaryMin:N0}",
        (null, not null) => $"Up to {profile.SalaryMax:N0}",
        _ => string.Empty
    };

    protected override async Task<string?> SaveCoreAsync()
    {
        if (IsNew)
        {
            var request = new CreateEmployeeRequest(
                CompanyId,
                Model.DepartmentId!.Value,
                Model.LocationId!.Value,
                Model.PositionProfileId!.Value,
                Model.FirstName.Trim(),
                Model.LastName.Trim(),
                string.IsNullOrWhiteSpace(Model.PreferredName)  ? null : Model.PreferredName.Trim(),
                Model.WorkEmail.Trim(),
                string.IsNullOrWhiteSpace(Model.PersonalEmail)  ? null : Model.PersonalEmail.Trim(),
                Model.StartDate,
                Model.DateOfBirth ?? default,
                Model.Nationality.Trim(),
                Model.Gender.Trim(),
                string.IsNullOrWhiteSpace(Model.GenderOther)    ? null : Model.GenderOther.Trim(),
                Model.EmployeeNumber.Trim(),
                Model.EmploymentTypeId!.Value,
                string.IsNullOrWhiteSpace(Model.PhoneNumber)    ? null : Model.PhoneNumber.Trim(),
                string.IsNullOrWhiteSpace(Model.HomePhone)      ? null : Model.HomePhone.Trim(),
                string.IsNullOrWhiteSpace(Model.AddressLine1)   ? null : Model.AddressLine1.Trim(),
                string.IsNullOrWhiteSpace(Model.AddressLine2)   ? null : Model.AddressLine2.Trim(),
                string.IsNullOrWhiteSpace(Model.City)           ? null : Model.City.Trim(),
                string.IsNullOrWhiteSpace(Model.County)         ? null : Model.County.Trim(),
                string.IsNullOrWhiteSpace(Model.PostCode)       ? null : Model.PostCode.Trim(),
                string.IsNullOrWhiteSpace(Model.Country)        ? null : Model.Country.Trim(),
                Model.HasSystemAccess,
                Model.ManagerId == Guid.Empty ? null : Model.ManagerId);

            var (created, error) = await EmployeeService.CreateEmployeeAsync(CompanyId, request);

            if (created is null)
                return error ?? "Failed to create employee.";

            if (_sendInviteOnCreate)
            {
                var email = Model.WorkEmail.Trim();
                var (token, expiresAt, _) = await InviteService.SendInviteAsync(CompanyId, created.Id, email);
                if (token is not null)
                {
                    _redirectUrl = $"/companies/{CompanyId}/employees/{created.Id}?invited=true";
                    return null;
                }
            }

            _redirectUrl = $"/companies/{CompanyId}/employees";
            return null;
        }
        else
        {
            // Working pattern override is owned by the Employment tab's own save (below);
            // pass through the value already on the employee so this call doesn't touch it.
            var workingDaysOverride = _employee?.WorkingDaysOverride;
            var hoursPerDayOverride = _employee?.HoursPerDayOverride;

            // Ticket: "merge Employee + Employment tab audit entries when saved together". This
            // page's single Save button calls both UpdateEmployeeProfileAsync and (below)
            // _employmentTab.SaveAsync() as one user action, so both requests share the same
            // freshly generated CorrelationId — letting GetEmployeeAuditHistoryHandler combine
            // the two resulting audit rows into a single history entry.
            var correlationId = Guid.NewGuid();

            var request = new UpdateEmployeeProfileRequest(
                CompanyId,
                Id!.Value,
                Model.DepartmentId,
                Model.LocationId,
                Model.PositionProfileId,
                Model.FirstName,
                Model.LastName,
                string.IsNullOrWhiteSpace(Model.PreferredName)  ? null : Model.PreferredName.Trim(),
                Model.WorkEmail,
                Model.PersonalEmail,
                Model.StartDate,
                Model.DateOfBirth,
                string.IsNullOrWhiteSpace(Model.Nationality)    ? null : Model.Nationality.Trim(),
                string.IsNullOrWhiteSpace(Model.Gender)         ? null : Model.Gender.Trim(),
                string.IsNullOrWhiteSpace(Model.GenderOther)    ? null : Model.GenderOther.Trim(),
                string.IsNullOrWhiteSpace(Model.PhoneNumber)    ? null : Model.PhoneNumber.Trim(),
                string.IsNullOrWhiteSpace(Model.HomePhone)      ? null : Model.HomePhone.Trim(),
                string.IsNullOrWhiteSpace(Model.AddressLine1)   ? null : Model.AddressLine1.Trim(),
                string.IsNullOrWhiteSpace(Model.AddressLine2)   ? null : Model.AddressLine2.Trim(),
                string.IsNullOrWhiteSpace(Model.City)           ? null : Model.City.Trim(),
                string.IsNullOrWhiteSpace(Model.County)         ? null : Model.County.Trim(),
                string.IsNullOrWhiteSpace(Model.PostCode)       ? null : Model.PostCode.Trim(),
                string.IsNullOrWhiteSpace(Model.Country)        ? null : Model.Country.Trim(),
                Model.HasSystemAccess,
                workingDaysOverride,
                hoursPerDayOverride,
                CorrelationId: correlationId);

            var (success, conflictMessage) = await EmployeeService.UpdateEmployeeProfileAsync(CompanyId, Id!.Value, request);

            if (!success)
                return conflictMessage;

            // Save Employment tab's data (including any working pattern override change) second,
            // so it has the final say over the shared working-pattern fields. Pass the same
            // correlationId through so its audit event merges with the profile update above.
            //
            // Department/Location are NOT edited on this (Employee/Profile) tab for an existing
            // employee — that section of the form only renders in the IsNew (create) branch above
            // (see the "else if (IsNew)" block). This tab's Model.DepartmentId/LocationId are only
            // ever populated once at load time (from _employee.DepartmentId/LocationId, purely so
            // EmployeeProfileEditModel's shared EditContext still validates), and never change from
            // user interaction here.
            //
            // Previously this called _employmentTab.SyncSharedAssignmentFields(Model.DepartmentId,
            // Model.LocationId) unconditionally, on the theory that Department/Location were edited
            // on this tab and the Employment tab's own independent copy of those fields (set from
            // its Position Profile picker — see EmployeeEmploymentTab.OnPositionProfileChanged) was
            // the stale one. That's backwards for the current UI: this tab's copy is the one that's
            // always stale, so the unconditional sync was clobbering whatever Department/Location
            // change the user had just made on the Employment tab with the original pre-edit
            // values, silently reverting it on every save (and since EmploymentDetailsSnapshot
            // doesn't track Department/Location, the revert never showed up in the audit trail
            // either). The Employment tab already owns and saves its own Department/Location, so no
            // sync is needed here.
            if (_employmentTab is not null)
            {
                _employmentTab.CorrelationId = correlationId;
                var employmentError = await _employmentTab.SaveAsync();
                if (employmentError is not null)
                    return employmentError;
            }

            _redirectUrl = $"/companies/{CompanyId}/employees";
            return null;
        }
    }

    // Accessible success confirmation (AC6): a role="status" live region so screen readers
    // announce the save, shown briefly before the existing forceLoad navigation takes over.
    protected override async Task OnSavedAsync()
    {
        _saveSuccessMessage = IsNew ? "Employee created successfully." : "Employee details saved successfully.";
        StateHasChanged();
        await Task.Delay(700);
        Navigation.NavigateTo(_redirectUrl ?? ListUrl!, forceLoad: true);
    }

    protected override string? ListUrl => $"/companies/{CompanyId}/employees";

    protected override bool HasUnsavedChanges =>
        base.HasUnsavedChanges || (_employmentTab?.HasUnsavedChanges ?? false);

    private async Task SendInvite()
    {
        if (_employee is null) return;

        _sendingInvite = true;
        _inviteError = null;

        var email = _employee.WorkEmail;
        var (token, expiresAt, error) = await InviteService.SendInviteAsync(CompanyId, Id!.Value, email);

        _sendingInvite = false;

        if (token is not null)
        {
            var baseUrl = Navigation.BaseUri.TrimEnd('/');
            _inviteLink = $"{baseUrl}/invite/{token}";
            _inviteExpiresAt = DateOnly.FromDateTime(expiresAt.LocalDateTime);
        }
        else
        {
            _inviteError = error;
        }
    }

    private async Task CopyLink()
    {
        await Task.CompletedTask;
    }

    private static string StatusBadgeClass(string status) => status switch
    {
        "Active"         => "bg-success",
        "Suspended"      => "bg-danger",
        "Leaving"        => "bg-warning text-dark",
        "FormerEmployee" => "bg-secondary",
        _                => "bg-light text-dark"
    };

    private static string StatusDisplayName(string status) => status switch
    {
        "Active"         => "Active",
        "Suspended"      => "Suspended",
        "Leaving"        => "Leaving",
        "FormerEmployee" => "Former Employee",
        _                => status
    };
}
