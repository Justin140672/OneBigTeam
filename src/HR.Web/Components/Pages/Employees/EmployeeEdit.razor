                    </ContentTemplate>
                </TabItem>

                @if (_showProbationTab)
                {
                    <TabItem>
                        <ChildContent><TabHeader Text="Probation" /></ChildContent>
                        <ContentTemplate>
                            <div class="mt-4">
                                <EmployeeProbationTab CompanyId="CompanyId" EmployeeId="Id!.Value" />
                            </div>
                        </ContentTemplate>
                    </TabItem>
                }

                <TabItem>
                    <ChildContent><TabHeader Text="Emergency Contacts" /></ChildContent>
                    <ContentTemplate>
                        <div class="mt-4">
                            <EmployeeEmergencyContactsTab CompanyId="CompanyId" EmployeeId="Id!.Value" />
                        </div>
                    </ContentTemplate>
                </TabItem>

                            </TabItems>
                        </SfTab>
                        </div>
                    </ContentTemplate>
                </TabItem>

                <TabItem>
                    <ChildContent><TabHeader Text="Career &amp; Pay" /></ChildContent>
                    <ContentTemplate>
                        <div class="employee-profile-section-wrap" role="region" aria-label="Career and Pay sub-sections">
                        <SfTab OverflowMode="OverflowMode.Scrollable" @bind-SelectedItem="CareerPayTab" CssClass="employee-profile-sections mt-2">
                            <TabItems>
                                <TabItem>
                                    <ChildContent><TabHeader Text="Compensation History" /></ChildContent>
                                    <ContentTemplate>
                                        <div class="mt-4">
                                            <EmployeeCompensationTab CompanyId="CompanyId" EmployeeId="Id!.Value" />
                                        </div>
                                    </ContentTemplate>
                                </TabItem>
                                <TabItem>
                                    <ChildContent><TabHeader Text="Promotion History" /></ChildContent>
                                    <ContentTemplate>
                                        <div class="mt-4">
                                            <EmployeePromotionHistoryTab CompanyId="CompanyId" EmployeeId="Id!.Value"
                                                                          CurrentPositionProfileTitle="@CurrentPositionProfileTitle" />
                                        </div>
                                    </ContentTemplate>
                                </TabItem>
                            </TabItems>
                        </SfTab>
                        </div>
                    </ContentTemplate>
                </TabItem>

                <TabItem>
                    <ChildContent><TabHeader Text="Time Off" /></ChildContent>
                    <ContentTemplate>
                        <div class="employee-profile-section-wrap" role="region" aria-label="Time Off sub-sections">
                        <SfTab OverflowMode="OverflowMode.Scrollable" @bind-SelectedItem="TimeOffTab" CssClass="employee-profile-sections mt-2">
                            <TabItems>
                                <TabItem>
                                    <ChildContent><TabHeader Text="Leave" /></ChildContent>
                                    <ContentTemplate>
                                        <div class="mt-4">
                                            <EmployeeLeaveTab CompanyId="CompanyId"
                                                              EmployeeId="Id!.Value" />
                                        </div>
                                    </ContentTemplate>
                                </TabItem>
                                <TabItem>
                                    <ChildContent><TabHeader Text="Sickness" /></ChildContent>
