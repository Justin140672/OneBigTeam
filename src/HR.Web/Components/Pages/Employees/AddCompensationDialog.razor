@using System.ComponentModel.DataAnnotations
@inject CompensationService CompensationService
@inherits EditDialogBase<AddCompensationDialog.AddCompensationFormModel>

<SfDialog @bind-Visible="Visible" IsModal="true" Width="520px" ShowCloseIcon="true" CssClass="add-compensation-dialog">
    <DialogEvents Closed="HandleDialogClosed" />
    <DialogTemplates>
        <Header>Add Compensation</Header>
        <Content>
            @if (!string.IsNullOrEmpty(GlobalError))
            {
                <div class="alert alert-danger alert-dismissible mb-3">
                    @GlobalError
                    <button type="button" class="btn-close" @onclick="@(() => GlobalError = null)"></button>
                </div>
            }
            <EditForm EditContext="EditContext">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label">Effective From <span class="text-danger">*</span></label>
                        <SfDatePicker TValue="DateOnly?"
                                      @bind-Value="Model.EffectiveFrom"
                                      Format="dd/MM/yyyy"
                                      Placeholder="dd/mm/yyyy" />
                        <ValidationMessage For="@(() => Model.EffectiveFrom)" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Salary Type <span class="text-danger">*</span></label>
                        <SfDropDownList TValue="string" TItem="SalaryTypeChoice"
                                        DataSource="@SalaryTypeOptions"
                                        @bind-Value="Model.SalaryType">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Salary <span class="text-danger">*</span></label>
                        <SfNumericTextBox TValue="decimal?" @bind-Value="Model.Salary" Min="0" ShowSpinButton="false"
                                          Placeholder="e.g. 45000" />
                        <ValidationMessage For="@(() => Model.Salary)" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Currency <span class="text-danger">*</span></label>
                        <HrTextBox @bind-Value="Model.Currency" Placeholder="e.g. GBP" />
                        <ValidationMessage For="@(() => Model.Currency)" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Reason <span class="text-danger">*</span></label>
                        <SfDropDownList TValue="string" TItem="CompensationChangeReasonChoice"
                                        DataSource="@ReasonOptions"
                                        @bind-Value="Model.Reason">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                        <ValidationMessage For="@(() => Model.Reason)" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Hours Per Week</label>
                        <SfNumericTextBox TValue="decimal?" @bind-Value="Model.HoursPerWeek" Min="0" Max="168" ShowSpinButton="false"
                                          Placeholder="e.g. 37.5" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">FTE</label>
                        <SfNumericTextBox TValue="decimal?" @bind-Value="Model.FTE" Min="0" Max="1" Step="0.05m" ShowSpinButton="false"
                                          Placeholder="e.g. 1.0" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Notes</label>
                        <HrTextBox @bind-Value="Model.Notes" Multiline="true" Rows="3" Maxlength="4000" Placeholder="Optional notes…" />
                    </div>
                </div>
            </EditForm>
        </Content>
        <FooterTemplate>
            <HrDialogButtonBar SaveLabel="Add" Saving="Saving" OnSave="SubmitAsync" OnCancel="CancelAsync" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId { get; set; }

    public static readonly SalaryTypeChoice[] SalaryTypeOptions =
    [
        new("Annual", "Annual"),
        new("Hourly", "Hourly"),
        new("Daily", "Daily")
    ];

    public static readonly CompensationChangeReasonChoice[] ReasonOptions =
    [
        new("NewHire", "New Hire"),
        new("AnnualReview", "Annual Review"),
        new("Promotion", "Promotion"),
        new("MarketAdjustment", "Market Adjustment"),
        new("RoleChange", "Role Change"),
        new("Correction", "Correction"),
        new("Other", "Other")
    ];

    protected override async Task<string?> SaveCoreAsync()
    {
        var request = new CreateCompensationRecordRequest(
            CompanyId,
            EmployeeId,
            Model.EffectiveFrom!.Value,
            Model.SalaryType,
            Model.Salary!.Value,
            Model.Currency.Trim().ToUpperInvariant(),
            Model.HoursPerWeek,
            Model.FTE,
            string.IsNullOrWhiteSpace(Model.Notes) ? null : Model.Notes.Trim(),
            Model.Reason);

        var (created, error) = await CompensationService.CreateCompensationRecordAsync(CompanyId, EmployeeId, request);

        return created is not null ? null : error ?? "Failed to create compensation record.";
    }

    protected override Task OnOpenedAsync()
    {
        GlobalError = null;
        return Task.CompletedTask;
    }

    protected override void ResetForm()
    {
        Model.EffectiveFrom = null;
        Model.SalaryType = "Annual";
        Model.Salary = null;
        Model.Currency = "GBP";
        Model.HoursPerWeek = null;
        Model.FTE = null;
        Model.Notes = null;
        Model.Reason = "NewHire";
    }

    public sealed record SalaryTypeChoice(string Value, string Label);
    public sealed record CompensationChangeReasonChoice(string Value, string Label);

    public sealed class AddCompensationFormModel
    {
        [Required(ErrorMessage = "Please enter an effective date.")]
        public DateOnly? EffectiveFrom { get; set; }
        public string SalaryType { get; set; } = "Annual";
        [Required(ErrorMessage = "Please enter a salary.")]
        [Range(0.01, double.MaxValue, ErrorMessage = "Salary must be greater than 0.")]
        public decimal? Salary { get; set; }
        [Required(ErrorMessage = "Please enter a currency code.")]
        [StringLength(3, MinimumLength = 3, ErrorMessage = "Currency must be a 3-letter code (e.g. GBP).")]
        public string Currency { get; set; } = "GBP";
        public decimal? HoursPerWeek { get; set; }
        public decimal? FTE { get; set; }
        public string? Notes { get; set; }
        [Required(ErrorMessage = "Please select a reason.")]
        public string Reason { get; set; } = "NewHire";
    }
}
