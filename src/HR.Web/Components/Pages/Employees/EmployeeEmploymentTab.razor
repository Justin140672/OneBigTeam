@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Syncfusion.Blazor.Data
@inject EmployeeService EmployeeService
@inject DepartmentService DepartmentService
@inject LocationService LocationService
@inject PositionProfileService PositionProfileService
@inject ProbationService ProbationService
@inject EmploymentTypeService EmploymentTypeService
@inject CompensationService CompensationService
@inject AppSession Session
@inherits EditSectionBase<EmployeeEmploymentTab.EmploymentEditModel>
@using HR.Infrastructure.Abstractions
@using HR.SharedKernel

@if (IsLoading)
{
    <HrLoadingIndicator />
}
else
{
    @if (!string.IsNullOrEmpty(GlobalError))
    {
        <div class="alert alert-danger mb-3">@GlobalError</div>
    }
    @if (!string.IsNullOrEmpty(SuccessMsg))
    {
        <div class="alert alert-success mb-3">@SuccessMsg</div>
    }

    <EditForm EditContext="EditContext">
        <DataAnnotationsValidator />

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Employment Details</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Employee Number <span class="text-danger">*</span></label>
                                <HrTextBox @bind-Value="Model.EmployeeNumber" Placeholder="e.g. EMP-001" ReadOnly="@IsViewMode" />
                                <ValidationMessage For="@(() => Model.EmployeeNumber)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Employment Status</label>
                                <SfDropDownList TValue="string"
                                                TItem="Option"
                                                DataSource="@_statusOptions"
                                                @bind-Value="Model.Status"
                                                Placeholder="Select status"
                                                Enabled="@(!IsViewMode)">
                                    <DropDownListFieldSettings Value="Value" Text="Label" />
                                </SfDropDownList>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Employment Type <span class="text-danger">*</span></label>
                                <SfDropDownList TValue="Guid?"
                                                TItem="EmploymentTypeListItemModel"
                                                DataSource="@_employmentTypes"
                                                @bind-Value="Model.EmploymentTypeId"
                                                Placeholder="Select type"
                                                Enabled="@(!IsViewMode)">
                                    <DropDownListFieldSettings Value="Id" Text="Name" />
                                </SfDropDownList>
                                <ValidationMessage For="@(() => Model.EmploymentTypeId)" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Current Compensation</h5>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm mb-0">
                            <tbody>
                                <tr>
                                    <th class="text-muted fw-normal" style="width: 220px">Current Salary</th>
                                    <td>@CurrentSalaryDisplay()</td>
                                </tr>
                                <tr>
                                    <th class="text-muted fw-normal">Hours</th>
                                    <td>@CurrentHoursDisplay()</td>
                                </tr>
                                <tr>
                                    <th class="text-muted fw-normal">FTE</th>
                                    <td>@CurrentFteDisplay()</td>
                                </tr>
                                <tr>
                                    <th class="text-muted fw-normal">Effective From</th>
                                    <td>@CurrentEffectiveFromDisplay()</td>
                                </tr>
                                <tr>
                                    <th class="text-muted fw-normal">Working Pattern</th>
                                    <td>@WorkingPatternSummary()</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Organisation</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Position Profile</label>
                                <SfDropDownList @ref="_positionProfileDropdown"
                                                TValue="Guid?"
                                                TItem="PositionProfileListItemModel"
                                                DataSource="@_positionProfiles"
                                                @bind-Value="Model.PositionProfileId"
                                                Placeholder="None"
                                                AllowFiltering="true"
                                                Enabled="@(!IsViewMode)">
                                    <DropDownListFieldSettings Value="Id" Text="Title" />
                                    <DropDownListEvents TItem="PositionProfileListItemModel" TValue="Guid?"
                                                         ValueChange="OnPositionProfileChanged"
                                                         Filtering="OnPositionProfileFilteringAsync" />
                                </SfDropDownList>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Department</label>
                                <SfDropDownList TValue="Guid?"
                                                TItem="DepartmentListItemModel"
                                                DataSource="@_departments"
                                                @bind-Value="Model.DepartmentId"
                                                Placeholder="None"
                                                AllowFiltering="true"
                                                Enabled="@(!IsViewMode)">
                                    <DropDownListFieldSettings Value="Id" Text="Name" />
                                </SfDropDownList>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Location</label>
                                <SfDropDownList TValue="Guid?"
                                                TItem="LocationListItemModel"
                                                DataSource="@_locations"
                                                @bind-Value="Model.LocationId"
                                                Placeholder="None"
                                                AllowFiltering="true"
                                                ShowClearButton="true"
                                                Enabled="@(!IsViewMode)">
                                    <DropDownListFieldSettings Value="Id" Text="Name" />
                                </SfDropDownList>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Manager</label>
                                <SfDropDownList @ref="_managerDropdown"
                                                TValue="Guid?"
                                                TItem="ManagerOption"
                                                DataSource="@_managerOptions"
                                                @bind-Value="Model.ManagerId"
                                                Placeholder="None"
                                                AllowFiltering="true"
                                                Enabled="@(!IsViewMode)">
                                    <DropDownListFieldSettings Value="Id" Text="Name" />
                                    <DropDownListEvents TValue="Guid?" TItem="ManagerOption" Filtering="OnManagerFilteringAsync" />
                                </SfDropDownList>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Dates</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Start Date <span class="text-danger">*</span></label>
                                <SfDatePicker TValue="DateOnly" @bind-Value="Model.StartDate" Format="dd/MM/yyyy" Enabled="@(!IsViewMode)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Continuous Service Date</label>
                                <SfDatePicker TValue="DateOnly?" @bind-Value="Model.ContinuousServiceDate" Format="dd/MM/yyyy" ShowClearButton="true" Enabled="@(!IsViewMode)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Probation End Date</label>
                                <SfDatePicker TValue="DateOnly?" @bind-Value="Model.ProbationEndDate" Format="dd/MM/yyyy" ShowClearButton="true" Enabled="@(!IsViewMode)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Leaving Date</label>
                                <SfDatePicker TValue="DateOnly?" @bind-Value="Model.LeavingDate" Format="dd/MM/yyyy" ShowClearButton="true" Enabled="false" />
                                <div class="form-text">Handled via Start Leaving Process.</div>
                            </div>
                        </div>

                        <hr class="my-3" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <SfCheckBox TChecked="bool"
                                            Label="Override notice period"
                                            Checked="@Model.OverrideNoticePeriod"
                                            CheckedChanged="@((bool v) => Model.OverrideNoticePeriod = v)"
                                            Enabled="@(!IsViewMode)" />
                                @if (Model.OverrideNoticePeriod)
                                {
                                    <div class="row g-3 mt-2">
                                        <div class="col-md-6">
                                            <label class="form-label">Length</label>
                                            <SfNumericTextBox TValue="int" @bind-Value="Model.NoticePeriodLength"
                                                              ShowSpinButton="false"
                                                              Min="1"
                                                              Enabled="@(!IsViewMode)" />
                                            <ValidationMessage For="@(() => Model.NoticePeriodLength)" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Unit</label>
                                            <SfDropDownList TValue="NoticePeriodUnit" TItem="NoticePeriodUnitChoice"
                                                            DataSource="@NoticePeriodUnitOptions"
                                                            @bind-Value="Model.NoticePeriodUnit"
                                                            Placeholder="Unit"
                                                            Enabled="@(!IsViewMode)">
                                                <DropDownListFieldSettings Value="Value" Text="Label" />
                                            </SfDropDownList>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="col-md-6">
                                <dl class="row mb-0">
                                    <dt class="col-sm-5 text-muted fw-normal">Notice source</dt>
                                    <dd class="col-sm-7">@NoticePeriodSourceLabel(_effectiveNoticePeriodSource)</dd>
                                    <dt class="col-sm-5 text-muted fw-normal">Notice Period</dt>
                                    <dd class="col-sm-7">@_effectiveNoticePeriodLength @(_effectiveNoticePeriodUnit)</dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Working Pattern</h5>
                    </div>
                    <div class="card-body">
                        <SfCheckBox TChecked="bool"
                                    Label="Use company working pattern"
                                    Checked="@Model.UseCompanyWorkingPattern"
                                    CheckedChanged="@((bool v) => Model.UseCompanyWorkingPattern = v)"
                                    Enabled="@(!IsViewMode)" />
                        @if (!Model.UseCompanyWorkingPattern)
                        {
                            <div class="row g-3 mt-2">
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Working Days</label>
                                    <div class="d-flex flex-wrap gap-3 mt-1">
                                        @foreach (var day in _allDays)
                                        {
                                            <SfCheckBox TChecked="bool" Label="@day"
                                                        Checked="@Model.WorkingWeek.Contains(day)"
                                                        CheckedChanged="@(e => ToggleWorkingDay(day, e))"
                                                        Enabled="@(!IsViewMode)" />
                                        }
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <SfNumericTextBox TValue="decimal" @bind-Value="Model.HoursPerDay"
                                                      Placeholder="Hours Per Day"
                                                      FloatLabelType="FloatLabelType.Auto"
                                                      ShowSpinButton="false"
                                                      Min="0.5m" Max="24m" Step="0.5m"
                                                      Enabled="@(!IsViewMode)" />
                                    <ValidationMessage For="@(() => Model.HoursPerDay)" />
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Notes</h5>
                    </div>
                    <div class="card-body">
                        <label class="form-label">HR Notes</label>
                        <HrTextBox @bind-Value="Model.Notes"
                                   Multiline="true"
                                   Rows="4"
                                   Placeholder="Optional internal notes visible to HR only"
                                   Maxlength="4000"
                                   ReadOnly="@IsViewMode" />
                        @if (!string.IsNullOrEmpty(Model.Notes))
                        {
                            <div class="text-muted small mt-1">@Model.Notes.Length / 4000</div>
                        }
                    </div>
                </div>

                @if (_probationRecord is not null)
                {
                    <div class="card mb-4" data-testid="probation-summary">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Probation</h5>
                            <span class="badge @ProbationStatusBadgeClass(_probationRecord.Status)">
                                @ProbationStatusLabel(_probationRecord.Status)
                            </span>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="text-muted small">Start Date</div>
                                    <div>@_probationRecord.StartDate.ToString("dd MMM yyyy")</div>
                                </div>
                                <div class="col-md-6">
                                    <div class="text-muted small">Expected End</div>
                                    <div>@_probationRecord.ExpectedEndDate.ToString("dd MMM yyyy")</div>
                                </div>
                                @if (_probationRecord.DecisionDate.HasValue)
                                {
                                    <div class="col-md-6">
                                        <div class="text-muted small">Decision Date</div>
                                        <div>@_probationRecord.DecisionDate.Value.ToString("dd MMM yyyy")</div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
    </EditForm>
}

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId { get; set; }

    // Set by EmployeeEdit.razor from its own IsViewMode (URL-derived). Genuinely disables every
    // interactive control below rather than relying on CSS alone — see the AC1 fix in
    // EmployeeEdit.razor for why: pointer-events:none only prevented mouse interaction, not
    // keyboard/programmatic edits.
    [Parameter] public bool IsViewMode { get; set; }

    protected override object? LoadKey => (CompanyId, EmployeeId);

    // Set by EmployeeEdit.razor's SaveCoreAsync (via its @ref to this component) immediately
    // before calling SaveAsync(), so this tab's UpdateEmploymentDetailsRequest carries the same
    // CorrelationId as the Employee Profile tab's own save — letting
    // GetEmployeeAuditHistoryHandler merge the two resulting audit rows into one entry. Left null
    // (the default) whenever this tab is saved on its own, so its audit entry stays separate.
    public Guid? CorrelationId { get; set; }

    // Called by EmployeeEdit.razor's SaveCoreAsync (via its @ref to this component) immediately
    // before calling SaveAsync(), whenever the user also changed Department/Location on the
    // Employee/Profile tab. Model.DepartmentId/LocationId here are loaded once when this tab
    // mounts and never refreshed from the sibling tab, so without this sync SaveAsync() would
    // resubmit these stale values via UpdateEmploymentDetailsRequest and silently revert the
    // change the Profile tab just saved (bug fix — Department/Location edits were being reverted,
    // and since EmploymentDetailsSnapshot doesn't audit these fields, the revert never showed up
    // in Employee Audit History either).
    public void SyncSharedAssignmentFields(Guid? departmentId, Guid? locationId)
    {
        Model.DepartmentId = departmentId;
        Model.LocationId = locationId;
    }

    private List<DepartmentListItemModel> _departments = [];
    private List<LocationListItemModel> _locations = [];
    private List<PositionProfileListItemModel> _positionProfiles = [];
    private SfDropDownList<Guid?, PositionProfileListItemModel> _positionProfileDropdown = default!;
    private SfDropDownList<Guid?, ManagerOption> _managerDropdown = default!;
    private List<ManagerOption> _managerOptions = [];
    private List<EmploymentTypeListItemModel> _employmentTypes = [];

    private ProbationRecordModel? _probationRecord;
    private CurrentCompensationModel? _currentCompensation;
    private GetEmployeeResponse? _employee;

    private NoticePeriodUnit _effectiveNoticePeriodUnit;
    private int _effectiveNoticePeriodLength;
    private string _effectiveNoticePeriodSource = "CompanyDefault";

    private static readonly string[] _allDays =
        ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];

    private static readonly NoticePeriodUnitChoice[] NoticePeriodUnitOptions =
    [
        new(NoticePeriodUnit.Weeks, "Weeks"),
        new(NoticePeriodUnit.Months, "Months")
    ];

    // Same convention as EmployeeLeavingTab.NoticePeriodSourceLabel.
    private static string NoticePeriodSourceLabel(string source) => source switch
    {
        "Employee"        => "Employee",
        "PositionProfile" => "Position Profile",
        "CompanyDefault"  => "Company Default",
        _                 => source
    };

    private sealed record NoticePeriodUnitChoice(NoticePeriodUnit Value, string Label);

    // Read-only — compensation changes go through Add/Adjust Compensation, not this form.
    private string CurrentSalaryDisplay() =>
        _currentCompensation is not null
            ? $"{_currentCompensation.Salary.ToString("C2", CultureInfo.GetCultureInfo(Session.Locale))} per {SalaryPeriodLabel(_currentCompensation.SalaryType)}"
            : "—";

    private static string SalaryPeriodLabel(string salaryType) => salaryType switch
    {
        "Hourly" => "hour",
        "Daily"  => "day",
        _        => "year"
    };

    // Read-only — same source as CurrentSalaryDisplay, sourced from the current compensation record.
    private string CurrentHoursDisplay() =>
        _currentCompensation?.HoursPerWeek is { } hours ? $"{hours:0.##} hrs/week" : "—";

    private string CurrentFteDisplay() =>
        _currentCompensation?.FTE is { } fte ? fte.ToString("P0") : "—";

    private string CurrentEffectiveFromDisplay() =>
        _currentCompensation is not null ? _currentCompensation.EffectiveFrom.ToString("d MMM yyyy") : "—";

    // Reuses the same company-default-fallback pattern as MyProfileOverviewTab.WorkingPatternSummary.
    private string WorkingPatternSummary()
    {
        if (_employee is null)
            return "—";

        var workingDays = _employee.WorkingDaysOverride ?? (WorkingDays)Session.WorkingDays;
        var hoursPerDay = _employee.HoursPerDayOverride ?? Session.HoursPerDay;

        return WorkingPatternFormatter.Summarize(workingDays, hoursPerDay);
    }

    // Draft, Leaving, and FormerEmployee must be real options here even though nobody should ever
    // *pick* them (a brand-new employee's Employment tab loads with Model.Status == "Draft" — see
    // PopulateModel below — an employee mid-way through the leaving process loads with
    // Model.Status == "Leaving", and a former employee's tab loads with Model.Status ==
    // "FormerEmployee"). If any of those values has no matching item in the dropdown's own
    // DataSource, the widget clears its selection and, via @bind-Value, silently overwrites
    // Model.Status back to the client with an empty string. That corrupts the field on first
    // render, before the user has touched anything, and the empty value then fails server-side
    // deserialization on save regardless of which field they actually meant to edit.
    // UpdateEmploymentDetailsHandler still rejects any attempt to actively transition into Draft,
    // Leaving, or FormerEmployee via this form, so including them here only fixes the
    // display/round-trip of an already-Draft, already-Leaving, or already-FormerEmployee
    // employee — it doesn't relax those rules. Leaving is only ever actively entered via the
    // dedicated Start Leaving Process action, not this generic edit form.
    // "Leaving" is only offered as a selectable option once the employee already has a
    // LeavingDate set — UpdateEmploymentDetailsHandler rejects an attempt to actively transition
    // into "Leaving" via this generic form otherwise (that transition only happens via the
    // dedicated Start Leaving Process action). Draft/FormerEmployee are still included whenever
    // that's the employee's current status, purely so the dropdown round-trips that value without
    // corrupting it (see remarks above) — never as something a user is meant to actively pick.
    private List<Option> _statusOptions =
    [
        new("Draft",          "Draft"),
        new("Active",         "Active"),
        new("Suspended",      "Suspended"),
        new("FormerEmployee", "Former Employee"),
    ];

    private void RebuildStatusOptions()
    {
        var hasLeavingDate = _employee?.LeavingDate is not null;
        var options = new List<Option>
        {
            new("Draft",          "Draft"),
            new("Active",         "Active"),
            new("Suspended",      "Suspended"),
        };
        if (hasLeavingDate || Model.Status == "Leaving")
            options.Add(new("Leaving", "Leaving"));
        options.Add(new("FormerEmployee", "Former Employee"));
        _statusOptions = options;
    }

    protected override async Task LoadAsync()
    {
        var deptTask       = DepartmentService.ListDepartmentsAsync(CompanyId);
        var locationTask   = LocationService.ListLocationsAsync(CompanyId);
        // Bounded — a long-lived shared company can accumulate far more Position Profiles over
        // time than any dropdown needs to browse without typing (e.g. this suite's own E2E runs
        // create a uniquely-named one per test, unbounded, across hundreds of runs). An unbounded
        // fetch here was a real, user-observed multi-second delay before this field became
        // interactable at all — see OnPositionProfileFilteringAsync for how the rest of the
        // company is reached by typing (same pattern as OnManagerFilteringAsync below), and the
        // explicit merge-in after `employee` loads for why the currently-assigned profile is
        // never silently missing just because it falls outside this first page.
        var profileTask    = PositionProfileService.ListPositionProfilesAsync(CompanyId, pageSize: 100);
        var empListTask    = EmployeeService.ListSelectableEmployeesAsync(CompanyId, pageSize: 50);
        var probationTask  = ProbationService.GetProbationRecordByEmployeeAsync(CompanyId, EmployeeId);
        var empTypesTask   = EmploymentTypeService.ListEmploymentTypesAsync(CompanyId);
        var compensationTask = CompensationService.GetCurrentCompensationAsync(CompanyId, EmployeeId);

        await Task.WhenAll(deptTask, locationTask, profileTask, empListTask, probationTask, empTypesTask, compensationTask);

        _departments      = (await deptTask)?.Items ?? [];
        _locations        = (await locationTask)?.Items ?? [];
        _positionProfiles = (await profileTask)?.Items.ToList() ?? [];
        _employmentTypes  = (await empTypesTask)?.Items ?? [];

        _probationRecord = await probationTask;
        _currentCompensation = await compensationTask;

        var employee = await EmployeeService.GetEmployeeAsync(CompanyId, EmployeeId);
        _employee = employee;
        if (employee is not null)
            PopulateModel(employee);
        RebuildStatusOptions();

        // Same "merge in the currently-assigned option even if it fell outside the bounded first
        // page" pattern as _managerOptions below — otherwise an employee whose Position Profile
        // happens to sort past the first 100 (alphabetically by Title) would render with a blank
        // Position Profile field until the user typed something to search for it.
        if (employee?.PositionProfileId is { } currentProfileId &&
            _positionProfiles.All(p => p.Id != currentProfileId))
        {
            var currentProfile = await PositionProfileService.GetPositionProfileAsync(CompanyId, currentProfileId);
            if (currentProfile is not null)
            {
                _positionProfiles.Add(new PositionProfileListItemModel(
                    currentProfile.Id, DepartmentName: null, currentProfile.Title, currentProfile.Description,
                    currentProfile.IsActive, currentProfile.SalaryMin, currentProfile.SalaryMax,
                    currentProfile.SalaryType, currentProfile.NoticePeriodUnitOverride,
                    currentProfile.NoticePeriodLengthOverride));
            }
        }

        // A first page (browsable without typing anything) — same purpose as the initial
        // pageSize:200 fetch in VacancyApplicationsTab.OpenAddDialog. The rest of the company
        // is reached by typing, see OnManagerFilteringAsync, so this page doesn't need to be
        // exhaustive. The currently-assigned manager is merged in explicitly in case they don't
        // happen to fall within this first page, so their name always renders rather than blank.
        _managerOptions = ((await empListTask)?.Items ?? [])
            .Where(e => e.Id != EmployeeId && e.Status != "Draft" && e.Status != "FormerEmployee")
            .Select(e => new ManagerOption(e.Id, $"{e.FirstName} {e.LastName}"))
            .ToList();

        if (employee?.ManagerId is { } managerId && _managerOptions.All(m => m.Id != managerId))
            _managerOptions.Add(new ManagerOption(managerId, employee.ManagerFullName ?? ""));

        _managerOptions = _managerOptions.OrderBy(m => m.Name)
            .Prepend(new ManagerOption(Guid.Empty, "No Manager"))
            .ToList();
    }

    // The manager list can't be preloaded in one bounded page the way _departments/_locations/etc.
    // are — a company can have far more employees than any reasonable page size, and whoever the
    // target manager is might sort outside that page (alphabetically, by whatever order), making
    // them impossible to find no matter what's typed into the filter box. Search server-side as
    // the user types instead, same pattern as VacancyApplicationsTab's candidate picker.
    private int _managerFilterRequestId;

    // Requests aren't guaranteed to resolve in the order they were fired — applying every response
    // unconditionally means a late-arriving response for an earlier keystroke can land after the
    // user already picked a manager from a later, faster response, visibly clearing their
    // selection. Only the most recently issued request's response is applied.
    private async Task OnManagerFilteringAsync(Syncfusion.Blazor.DropDowns.FilteringEventArgs args)
    {
        args.PreventDefaultAction = true;
        var requestId = ++_managerFilterRequestId;
        var result = await EmployeeService.ListSelectableEmployeesAsync(CompanyId, search: args.Text, pageSize: 50);
        if (requestId != _managerFilterRequestId) return;
        _managerOptions = (result?.Items ?? [])
            .Where(e => e.Id != EmployeeId && e.Status != "Draft" && e.Status != "FormerEmployee")
            .Select(e => new ManagerOption(e.Id, $"{e.FirstName} {e.LastName}"))
            .OrderBy(e => e.Name)
            .Prepend(new ManagerOption(Guid.Empty, "No Manager"))
            .ToList();
        await _managerDropdown.FilterAsync(_managerOptions, new Query());
    }

    private void PopulateModel(GetEmployeeResponse e)
    {
        Model.EmployeeNumber        = e.EmployeeNumber ?? string.Empty;
        Model.EmploymentTypeId      = e.EmploymentTypeId;
        Model.Status                = e.Status is "Draft" or "Active" or "Suspended" or "Leaving" or "FormerEmployee"
                                           ? e.Status
                                           : "Active";
        Model.DepartmentId          = e.DepartmentId;
        Model.LocationId            = e.LocationId;
        Model.PositionProfileId     = e.PositionProfileId;
        Model.ManagerId             = e.ManagerId ?? Guid.Empty;
        Model.StartDate             = e.StartDate;
        Model.ContinuousServiceDate = e.ContinuousServiceDate;
        Model.ProbationEndDate      = e.ProbationEndDate;
        Model.LeavingDate           = e.LeavingDate;
        Model.Notes                 = e.Notes ?? string.Empty;

        _effectiveNoticePeriodUnit   = e.EffectiveNoticePeriodUnit;
        _effectiveNoticePeriodLength = e.EffectiveNoticePeriodLength;
        _effectiveNoticePeriodSource = e.EffectiveNoticePeriodSource;

        if (e.NoticePeriodUnitOverride.HasValue && e.NoticePeriodLengthOverride.HasValue)
        {
            Model.OverrideNoticePeriod = true;
            Model.NoticePeriodUnit = e.NoticePeriodUnitOverride.Value;
            Model.NoticePeriodLength = e.NoticePeriodLengthOverride.Value;
        }
        else
        {
            Model.OverrideNoticePeriod = false;
        }

        if (e.WorkingDaysOverride.HasValue || e.HoursPerDayOverride.HasValue)
        {
            Model.UseCompanyWorkingPattern = false;
            if (e.WorkingDaysOverride.HasValue)
            {
                Model.WorkingWeek = _allDays
                    .Where(d => Enum.TryParse<WorkingDays>(d, out var wd) &&
                                e.WorkingDaysOverride.Value.HasFlag(wd))
                    .ToHashSet();
            }
            if (e.HoursPerDayOverride.HasValue)
                Model.HoursPerDay = e.HoursPerDayOverride.Value;
        }
        else
        {
            Model.UseCompanyWorkingPattern = true;
        }
    }

    protected override async Task<string?> SaveCoreAsync()
    {
        WorkingDays? workingDaysOverride = null;
        decimal? hoursPerDayOverride = null;

        if (!Model.UseCompanyWorkingPattern)
        {
            workingDaysOverride = Model.WorkingWeek
                .Aggregate(WorkingDays.None, (acc, day) =>
                    Enum.TryParse<WorkingDays>(day, out var wd) ? acc | wd : acc);
            hoursPerDayOverride = Model.HoursPerDay;
        }

        NoticePeriodUnit? noticePeriodUnitOverride = Model.OverrideNoticePeriod ? Model.NoticePeriodUnit : null;
        int? noticePeriodLengthOverride = Model.OverrideNoticePeriod ? Model.NoticePeriodLength : null;

        var request = new UpdateEmploymentDetailsRequest(
            CompanyId,
            EmployeeId,
            string.IsNullOrWhiteSpace(Model.EmployeeNumber) ? null : Model.EmployeeNumber.Trim(),
            Model.EmploymentTypeId,
            Model.Status,
            Model.DepartmentId,
            Model.LocationId,
            Model.PositionProfileId,
            Model.ManagerId == Guid.Empty ? null : Model.ManagerId,
            Model.StartDate,
            Model.ContinuousServiceDate,
            Model.ProbationEndDate,
            Model.LeavingDate,
            workingDaysOverride,
            hoursPerDayOverride,
            string.IsNullOrWhiteSpace(Model.Notes) ? null : Model.Notes.Trim(),
            NoticePeriodUnitOverride: noticePeriodUnitOverride,
            NoticePeriodLengthOverride: noticePeriodLengthOverride,
            CorrelationId: CorrelationId);

        var (success, error) = await EmployeeService.UpdateEmploymentDetailsAsync(CompanyId, EmployeeId, request);

        return success ? null : error ?? "Failed to save employment details.";
    }

    private async Task OnPositionProfileChanged(ChangeEventArgs<Guid?, PositionProfileListItemModel> args)
    {
        Model.PositionProfileId = args.Value;

        if (args.Value is Guid profileId)
        {
            var profile = await PositionProfileService.GetPositionProfileAsync(CompanyId, profileId);
            if (profile is not null)
            {
                Model.DepartmentId = profile.DepartmentId;
                Model.LocationId = profile.LocationId;
            }
        }
    }

    // Same "search server-side as the user types instead of requiring the whole company be
    // preloaded" pattern as OnManagerFilteringAsync above, and for the same reason: the bounded
    // first page loaded in LoadAsync (see profileTask's remarks) only covers the first 100
    // Position Profiles by Title, so anything past that is only reachable by typing.
    private int _profileFilterRequestId;

    private async Task OnPositionProfileFilteringAsync(Syncfusion.Blazor.DropDowns.FilteringEventArgs args)
    {
        args.PreventDefaultAction = true;
        var requestId = ++_profileFilterRequestId;
        var result = await PositionProfileService.ListPositionProfilesAsync(CompanyId, search: args.Text, pageSize: 100);
        if (requestId != _profileFilterRequestId) return;
        var options = (result?.Items ?? []).ToList();
        await _positionProfileDropdown.FilterAsync(options, new Query());
    }

    private void ToggleWorkingDay(string day, bool isChecked)
    {
        if (isChecked) Model.WorkingWeek.Add(day);
        else Model.WorkingWeek.Remove(day);
    }

    private static string ProbationStatusBadgeClass(string status) => status switch
    {
        "Active"    => "bg-primary",
        "ReviewDue" => "bg-warning text-dark",
        "Extended"  => "bg-info text-dark",
        "Passed"    => "bg-success",
        "Failed"    => "bg-danger",
        _           => "bg-secondary"
    };

    private static string ProbationStatusLabel(string status) => status switch
    {
        "ReviewDue" => "Review Due",
        _           => status
    };

    public sealed class EmploymentEditModel
    {
        [Required(ErrorMessage = "Employee number is required.")]
        public string EmployeeNumber { get; set; } = string.Empty;
        [Required(ErrorMessage = "Employment type is required.")]
        public Guid? EmploymentTypeId { get; set; }
        public string Status { get; set; } = "Active";
        public Guid? DepartmentId { get; set; }
        public Guid? LocationId { get; set; }
        public Guid? PositionProfileId { get; set; }
        public Guid? ManagerId { get; set; }
        public DateOnly StartDate { get; set; }
        public DateOnly? ContinuousServiceDate { get; set; }
        public DateOnly? ProbationEndDate { get; set; }
        public DateOnly? LeavingDate { get; set; }
        public bool UseCompanyWorkingPattern { get; set; } = true;
        public HashSet<string> WorkingWeek { get; set; } = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"];
        [Range(0.5, 24, ErrorMessage = "Hours per day must be between 0.5 and 24.")]
        public decimal HoursPerDay { get; set; } = 7.5m;
        public bool OverrideNoticePeriod { get; set; }
        public NoticePeriodUnit NoticePeriodUnit { get; set; } = NoticePeriodUnit.Weeks;
        [Range(1, int.MaxValue, ErrorMessage = "Notice period length must be greater than 0.")]
        public int NoticePeriodLength { get; set; } = 1;
        public string Notes { get; set; } = string.Empty;
    }

    private sealed record Option(string Value, string Label);
    private sealed record ManagerOption(Guid Id, string Name);
}
