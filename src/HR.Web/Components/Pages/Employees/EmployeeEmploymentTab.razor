@using System.ComponentModel.DataAnnotations
@using Syncfusion.Blazor.Data
@inject EmployeeService EmployeeService
@inject DepartmentService DepartmentService
@inject LocationService LocationService
@inject PositionProfileService PositionProfileService
@inject ProbationService ProbationService
@inject EmploymentTypeService EmploymentTypeService
@inherits EditSectionBase<EmployeeEmploymentTab.EmploymentEditModel>
@using HR.Infrastructure.Abstractions
@using HR.SharedKernel

@if (IsLoading)
{
    <HrLoadingIndicator />
}
else
{
    @if (!string.IsNullOrEmpty(GlobalError))
    {
        <div class="alert alert-danger mb-3">@GlobalError</div>
    }
    @if (!string.IsNullOrEmpty(SuccessMsg))
    {
        <div class="alert alert-success mb-3">@SuccessMsg</div>
    }

    <EditForm EditContext="EditContext">
        <DataAnnotationsValidator />
        <div class="row">
            <div class="col-lg-8">

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Employment Details</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Employee Number <span class="text-danger">*</span></label>
                                <HrTextBox @bind-Value="Model.EmployeeNumber" Placeholder="e.g. EMP-001" />
                                <ValidationMessage For="@(() => Model.EmployeeNumber)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Employment Status</label>
                                <SfDropDownList TValue="string"
                                                TItem="Option"
                                                DataSource="@_statusOptions"
                                                @bind-Value="Model.Status"
                                                Placeholder="Select status">
                                    <DropDownListFieldSettings Value="Value" Text="Label" />
                                </SfDropDownList>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Employment Type <span class="text-danger">*</span></label>
                                <SfDropDownList TValue="Guid?"
                                                TItem="EmploymentTypeListItemModel"
                                                DataSource="@_employmentTypes"
                                                @bind-Value="Model.EmploymentTypeId"
                                                Placeholder="Select type">
                                    <DropDownListFieldSettings Value="Id" Text="Name" />
                                </SfDropDownList>
                                <ValidationMessage For="@(() => Model.EmploymentTypeId)" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Dates</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Start Date <span class="text-danger">*</span></label>
                                <SfDatePicker TValue="DateOnly" @bind-Value="Model.StartDate" Format="dd/MM/yyyy" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Continuous Service Date</label>
                                <SfDatePicker TValue="DateOnly?" @bind-Value="Model.ContinuousServiceDate" Format="dd/MM/yyyy" ShowClearButton="true" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Probation End Date</label>
                                <SfDatePicker TValue="DateOnly?" @bind-Value="Model.ProbationEndDate" Format="dd/MM/yyyy" ShowClearButton="true" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Leaving Date</label>
                                <SfDatePicker TValue="DateOnly?" @bind-Value="Model.LeavingDate" Format="dd/MM/yyyy" ShowClearButton="true" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Organisation</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Position Profile</label>
                                <SfDropDownList TValue="Guid?"
                                                TItem="PositionProfileListItemModel"
                                                DataSource="@_positionProfiles"
                                                @bind-Value="Model.PositionProfileId"
                                                Placeholder="None"
                                                AllowFiltering="true">
                                    <DropDownListFieldSettings Value="Id" Text="Title" />
                                    <DropDownListEvents TItem="PositionProfileListItemModel" TValue="Guid?" ValueChange="OnPositionProfileChanged" />
                                </SfDropDownList>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Department</label>
                                <SfDropDownList TValue="Guid?"
                                                TItem="DepartmentListItemModel"
                                                DataSource="@_departments"
                                                @bind-Value="Model.DepartmentId"
                                                Placeholder="None"
                                                AllowFiltering="true">
                                    <DropDownListFieldSettings Value="Id" Text="Name" />
                                </SfDropDownList>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Location</label>
                                <SfDropDownList TValue="Guid?"
                                                TItem="LocationListItemModel"
                                                DataSource="@_locations"
                                                @bind-Value="Model.LocationId"
                                                Placeholder="None"
                                                AllowFiltering="true"
                                                ShowClearButton="true">
                                    <DropDownListFieldSettings Value="Id" Text="Name" />
                                </SfDropDownList>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Manager</label>
                                <SfDropDownList @ref="_managerDropdown"
                                                TValue="Guid?"
                                                TItem="ManagerOption"
                                                DataSource="@_managerOptions"
                                                @bind-Value="Model.ManagerId"
                                                Placeholder="None"
                                                AllowFiltering="true">
                                    <DropDownListFieldSettings Value="Id" Text="Name" />
                                    <DropDownListEvents TValue="Guid?" TItem="ManagerOption" Filtering="OnManagerFilteringAsync" />
                                </SfDropDownList>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Working Pattern</h5>
                    </div>
                    <div class="card-body">
                        <SfCheckBox TChecked="bool"
                                    Label="Use company working pattern"
                                    Checked="@Model.UseCompanyWorkingPattern"
                                    CheckedChanged="@((bool v) => Model.UseCompanyWorkingPattern = v)" />
                        @if (!Model.UseCompanyWorkingPattern)
                        {
                            <div class="row g-3 mt-2">
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Working Days</label>
                                    <div class="d-flex flex-wrap gap-3 mt-1">
                                        @foreach (var day in _allDays)
                                        {
                                            <SfCheckBox TChecked="bool" Label="@day"
                                                        Checked="@Model.WorkingWeek.Contains(day)"
                                                        CheckedChanged="@(e => ToggleWorkingDay(day, e))" />
                                        }
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <SfNumericTextBox TValue="decimal" @bind-Value="Model.HoursPerDay"
                                                      Placeholder="Hours Per Day"
                                                      FloatLabelType="FloatLabelType.Auto"
                                                      ShowSpinButton="false"
                                                      Min="0.5m" Max="24m" Step="0.5m" />
                                    <ValidationMessage For="@(() => Model.HoursPerDay)" />
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Notes</h5>
                    </div>
                    <div class="card-body">
                        <label class="form-label">HR Notes</label>
                        <textarea class="form-control"
                                  rows="4"
                                  placeholder="Optional internal notes visible to HR only"
                                  @bind="Model.Notes"
                                  maxlength="4000"></textarea>
                        @if (!string.IsNullOrEmpty(Model.Notes))
                        {
                            <div class="text-muted small mt-1">@Model.Notes.Length / 4000</div>
                        }
                    </div>
                </div>

            </div>

            @if (_probationRecord is not null)
            {
                <div class="col-lg-4">
                    <div class="card mb-4" data-testid="probation-summary">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Probation</h5>
                            <span class="badge @ProbationStatusBadgeClass(_probationRecord.Status)">
                                @ProbationStatusLabel(_probationRecord.Status)
                            </span>
                        </div>
                        <div class="card-body">
                            <dl class="row mb-0 small">
                                <dt class="col-6 text-muted fw-normal">Start Date</dt>
                                <dd class="col-6">@_probationRecord.StartDate.ToString("dd MMM yyyy")</dd>
                                <dt class="col-6 text-muted fw-normal">Expected End</dt>
                                <dd class="col-6">@_probationRecord.ExpectedEndDate.ToString("dd MMM yyyy")</dd>
                                @if (_probationRecord.DecisionDate.HasValue)
                                {
                                    <dt class="col-6 text-muted fw-normal">Decision Date</dt>
                                    <dd class="col-6">@_probationRecord.DecisionDate.Value.ToString("dd MMM yyyy")</dd>
                                }
                            </dl>

                        </div>
                    </div>
                </div>
            }
        </div>
    </EditForm>
}

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId { get; set; }

    private List<DepartmentListItemModel> _departments = [];
    private List<LocationListItemModel> _locations = [];
    private List<PositionProfileListItemModel> _positionProfiles = [];
    private SfDropDownList<Guid?, ManagerOption> _managerDropdown = default!;
    private List<ManagerOption> _managerOptions = [];
    private List<EmploymentTypeListItemModel> _employmentTypes = [];

    private ProbationRecordModel? _probationRecord;

    private static readonly string[] _allDays =
        ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];

    // Draft must be a real option here even though nobody should ever *pick* it (a brand-new
    // employee's Employment tab loads with Model.Status == "Draft" — see PopulateModel below —
    // and if that value has no matching item in the dropdown's own DataSource, the widget clears
    // its selection and, via @bind-Value, silently overwrites Model.Status back to the client with
    // an empty string. That corrupts the field on first render, before the user has touched
    // anything, and the empty value then fails server-side deserialization on save regardless of
    // which field they actually meant to edit. UpdateEmploymentDetailsHandler still rejects any
    // attempt to actively transition a non-Draft employee back to Draft, so including it here only
    // fixes the display/round-trip of an already-Draft employee — it doesn't relax that rule.
    private static readonly Option[] _statusOptions =
    [
        new("Draft",      "Draft"),
        new("Active",     "Active"),
        new("OnLeave",    "On Leave"),
        new("Suspended",  "Suspended"),
        new("Terminated", "Leaver"),
    ];

    protected override async Task LoadAsync()
    {
        var deptTask       = DepartmentService.ListDepartmentsAsync(CompanyId);
        var locationTask   = LocationService.ListLocationsAsync(CompanyId);
        var profileTask    = PositionProfileService.ListPositionProfilesAsync(CompanyId);
        var empListTask    = EmployeeService.ListEmployeesAsync(CompanyId, pageSize: 50);
        var probationTask  = ProbationService.GetProbationRecordByEmployeeAsync(CompanyId, EmployeeId);
        var empTypesTask   = EmploymentTypeService.ListEmploymentTypesAsync(CompanyId);

        await Task.WhenAll(deptTask, locationTask, profileTask, empListTask, probationTask, empTypesTask);

        _departments      = (await deptTask)?.Items ?? [];
        _locations        = (await locationTask)?.Items ?? [];
        _positionProfiles = (await profileTask)?.Items.ToList() ?? [];
        _employmentTypes  = (await empTypesTask)?.Items ?? [];

        _probationRecord = await probationTask;

        var employee = await EmployeeService.GetEmployeeAsync(CompanyId, EmployeeId);
        if (employee is not null)
            PopulateModel(employee);

        // A first page (browsable without typing anything) — same purpose as the initial
        // pageSize:200 fetch in VacancyApplicationsTab.OpenAddDialog. The rest of the company
        // is reached by typing, see OnManagerFilteringAsync, so this page doesn't need to be
        // exhaustive. The currently-assigned manager is merged in explicitly in case they don't
        // happen to fall within this first page, so their name always renders rather than blank.
        _managerOptions = ((await empListTask)?.Items ?? [])
            .Where(e => e.Id != EmployeeId && e.Status != "Draft" && e.Status != "Terminated")
            .Select(e => new ManagerOption(e.Id, $"{e.FirstName} {e.LastName}"))
            .ToList();

        if (employee?.ManagerId is { } managerId && _managerOptions.All(m => m.Id != managerId))
            _managerOptions.Add(new ManagerOption(managerId, employee.ManagerFullName ?? ""));

        _managerOptions = _managerOptions.OrderBy(m => m.Name)
            .Prepend(new ManagerOption(Guid.Empty, "No Manager"))
            .ToList();
    }

    // The manager list can't be preloaded in one bounded page the way _departments/_locations/etc.
    // are — a company can have far more employees than any reasonable page size, and whoever the
    // target manager is might sort outside that page (alphabetically, by whatever order), making
    // them impossible to find no matter what's typed into the filter box. Search server-side as
    // the user types instead, same pattern as VacancyApplicationsTab's candidate picker.
    private async Task OnManagerFilteringAsync(Syncfusion.Blazor.DropDowns.FilteringEventArgs args)
    {
        args.PreventDefaultAction = true;
        var result = await EmployeeService.ListEmployeesAsync(CompanyId, search: args.Text, pageSize: 50);
        _managerOptions = (result?.Items ?? [])
            .Where(e => e.Id != EmployeeId && e.Status != "Draft" && e.Status != "Terminated")
            .Select(e => new ManagerOption(e.Id, $"{e.FirstName} {e.LastName}"))
            .OrderBy(e => e.Name)
            .Prepend(new ManagerOption(Guid.Empty, "No Manager"))
            .ToList();
        await _managerDropdown.FilterAsync(_managerOptions, new Query());
    }

    private void PopulateModel(GetEmployeeResponse e)
    {
        Model.EmployeeNumber        = e.EmployeeNumber ?? string.Empty;
        Model.EmploymentTypeId      = e.EmploymentTypeId;
        Model.Status                = e.Status is "Draft" or "Active" or "OnLeave" or "Suspended" or "Terminated"
                                           ? e.Status
                                           : "Active";
        Model.DepartmentId          = e.DepartmentId;
        Model.LocationId            = e.LocationId;
        Model.PositionProfileId     = e.PositionProfileId;
        Model.ManagerId             = e.ManagerId ?? Guid.Empty;
        Model.StartDate             = e.StartDate;
        Model.ContinuousServiceDate = e.ContinuousServiceDate;
        Model.ProbationEndDate      = e.ProbationEndDate;
        Model.LeavingDate           = e.LeavingDate;
        Model.Notes                 = e.Notes ?? string.Empty;

        if (e.WorkingDaysOverride.HasValue || e.HoursPerDayOverride.HasValue)
        {
            Model.UseCompanyWorkingPattern = false;
            if (e.WorkingDaysOverride.HasValue)
            {
                Model.WorkingWeek = _allDays
                    .Where(d => Enum.TryParse<WorkingDays>(d, out var wd) &&
                                e.WorkingDaysOverride.Value.HasFlag(wd))
                    .ToHashSet();
            }
            if (e.HoursPerDayOverride.HasValue)
                Model.HoursPerDay = e.HoursPerDayOverride.Value;
        }
        else
        {
            Model.UseCompanyWorkingPattern = true;
        }
    }

    protected override async Task<string?> SaveCoreAsync()
    {
        WorkingDays? workingDaysOverride = null;
        decimal? hoursPerDayOverride = null;

        if (!Model.UseCompanyWorkingPattern)
        {
            workingDaysOverride = Model.WorkingWeek
                .Aggregate(WorkingDays.None, (acc, day) =>
                    Enum.TryParse<WorkingDays>(day, out var wd) ? acc | wd : acc);
            hoursPerDayOverride = Model.HoursPerDay;
        }

        var request = new UpdateEmploymentDetailsRequest(
            CompanyId,
            EmployeeId,
            string.IsNullOrWhiteSpace(Model.EmployeeNumber) ? null : Model.EmployeeNumber.Trim(),
            Model.EmploymentTypeId,
            Model.Status,
            Model.DepartmentId,
            Model.LocationId,
            Model.PositionProfileId,
            Model.ManagerId == Guid.Empty ? null : Model.ManagerId,
            Model.StartDate,
            Model.ContinuousServiceDate,
            Model.ProbationEndDate,
            Model.LeavingDate,
            workingDaysOverride,
            hoursPerDayOverride,
            string.IsNullOrWhiteSpace(Model.Notes) ? null : Model.Notes.Trim());

        var (success, error) = await EmployeeService.UpdateEmploymentDetailsAsync(CompanyId, EmployeeId, request);

        return success ? null : error ?? "Failed to save employment details.";
    }

    private async Task OnPositionProfileChanged(ChangeEventArgs<Guid?, PositionProfileListItemModel> args)
    {
        Model.PositionProfileId = args.Value;

        if (args.Value is Guid profileId)
        {
            var profile = await PositionProfileService.GetPositionProfileAsync(CompanyId, profileId);
            if (profile is not null)
            {
                Model.DepartmentId = profile.DepartmentId;
                Model.LocationId = profile.LocationId;
            }
        }
    }

    private void ToggleWorkingDay(string day, bool isChecked)
    {
        if (isChecked) Model.WorkingWeek.Add(day);
        else Model.WorkingWeek.Remove(day);
    }

    private static string ProbationStatusBadgeClass(string status) => status switch
    {
        "Active"    => "bg-primary",
        "ReviewDue" => "bg-warning text-dark",
        "Extended"  => "bg-info text-dark",
        "Passed"    => "bg-success",
        "Failed"    => "bg-danger",
        _           => "bg-secondary"
    };

    private static string ProbationStatusLabel(string status) => status switch
    {
        "ReviewDue" => "Review Due",
        _           => status
    };

    public sealed class EmploymentEditModel
    {
        [Required(ErrorMessage = "Employee number is required.")]
        public string EmployeeNumber { get; set; } = string.Empty;
        [Required(ErrorMessage = "Employment type is required.")]
        public Guid? EmploymentTypeId { get; set; }
        public string Status { get; set; } = "Active";
        public Guid? DepartmentId { get; set; }
        public Guid? LocationId { get; set; }
        public Guid? PositionProfileId { get; set; }
        public Guid? ManagerId { get; set; }
        public DateOnly StartDate { get; set; }
        public DateOnly? ContinuousServiceDate { get; set; }
        public DateOnly? ProbationEndDate { get; set; }
        public DateOnly? LeavingDate { get; set; }
        public bool UseCompanyWorkingPattern { get; set; } = true;
        public HashSet<string> WorkingWeek { get; set; } = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"];
        [Range(0.5, 24, ErrorMessage = "Hours per day must be between 0.5 and 24.")]
        public decimal HoursPerDay { get; set; } = 7.5m;
        public string Notes { get; set; } = string.Empty;
    }

    private sealed record Option(string Value, string Label);
    private sealed record ManagerOption(Guid Id, string Name);
}
