@inject EmployeeService EmployeeService
@inject AppSession Session

@if (Session.CanManageEmployees)
{
    <div class="widget-card chart-tile">
        <div class="widget-header">
            <i class="fa-solid fa-venus-mars widget-icon"></i>
            <span class="widget-title">Gender Split</span>
        </div>

        <div class="widget-body">
            @if (_loading)
            {
                <HrLoadingIndicator Label="Loading gender split…" />
            }
            else
            {
                <HorizontalBarChart Bars="@_bars" EmptyText="No employee data available." AriaLabel="Gender split of active employees" />
            }
        </div>
    </div>
}

@code {
    private static readonly string[] Palette =
    [
        "#0f766e", "#f97316", "#eab308", "#16a34a", "#6b7280", "#0d9488", "#dc2626", "#9333ea"
    ];

    private bool _loading = true;
    private List<HorizontalBarChart.HorizontalBarDatum> _bars = [];

    protected override async Task OnInitializedAsync()
    {
        if (!Session.CanManageEmployees)
        {
            _loading = false;
            return;
        }

        var result = await EmployeeService.GetGenderSplitAsync(Session.CompanyId);
        var items = result?.Items ?? [];

        _bars = items
            .Select((item, index) => new HorizontalBarChart.HorizontalBarDatum(
                item.Gender,
                item.EmployeeCount,
                Palette[index % Palette.Length]))
            .ToList();

        _loading = false;
    }
}
