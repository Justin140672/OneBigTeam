<div class="card">
    <div class="card-body">
        <div class="row g-4">
            <div class="col-md-6">
                <HrTextBox @bind-Value="Model.FirstName" Placeholder="First Name" />
            </div>
            <div class="col-md-6">
                <HrTextBox @bind-Value="Model.LastName" Placeholder="Last Name" />
            </div>
            <div class="col-md-6">
                <HrTextBox @bind-Value="Model.WorkEmail" Placeholder="Work Email" Type="InputType.Email" />
            </div>
            <div class="col-md-6">
                <HrTextBox Value="@_personalEmail"
                           ValueChanged="@OnPersonalEmailChanged"
                           Placeholder="Personal Email (optional)"
                           Type="InputType.Email" />
            </div>
            <div class="col-md-6">
                <SfDatePicker TValue="DateOnly" @bind-Value="Model.StartDate" Placeholder="Start Date" FloatLabelType="FloatLabelType.Auto" />
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public EmployeeProfileEditModel Model { get; set; } = default!;

    private string _personalEmail = string.Empty;

    protected override void OnParametersSet()
    {
        _personalEmail = Model.PersonalEmail ?? string.Empty;
    }

    private void OnPersonalEmailChanged(string value)
    {
        _personalEmail = value;
        Model.PersonalEmail = string.IsNullOrWhiteSpace(value) ? null : value;
    }
}
