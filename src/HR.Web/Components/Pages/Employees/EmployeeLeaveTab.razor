@inject LeaveService LeaveService

@if (_loading)
{
    <div class="d-flex align-items-center gap-2">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span>Loading…</span>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header fw-semibold">Current Balance</div>
                <div class="card-body">
                    @if (_nonToilBalances.Count > 0)
                    {
                        <div class="row g-3">
                            @foreach (var item in _nonToilBalances)
                            {
                                <div class="col-md-4">
                                    <div class="d-flex flex-column">
                                        <span class="text-muted small">@item.LeaveTypeName</span>
                                        <span class="fs-4 fw-semibold">@FormatDays(item.RemainingDays)</span>
                                        <span class="text-muted small">of @FormatDays(item.EntitlementDays) entitlement</span>
                                        @if (item.PendingDays > 0)
                                        {
                                            <span class="text-muted small">@FormatDays(item.PendingDays) pending</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">No balance data available.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header fw-semibold">Pending Requests</div>
                <div class="card-body p-0">
                    @if (_pendingRequests.Count == 0)
                    {
                        <p class="text-muted small p-3 mb-0">No pending requests.</p>
                    }
                    else
                    {
                        <HrGrid TValue="LeaveRequestListItem"
                                DataSource="@_pendingRequests"
                                AllowFiltering="false"
                                AllowPaging="false">
                            <GridColumns>
                                <GridColumn Field="@nameof(LeaveRequestListItem.LeaveTypeName)" HeaderText="Type" />
                                <GridColumn HeaderText="Start" Width="160" AllowSorting="false" AllowFiltering="false">
                                    <Template>
                                        @{ var r = (context as LeaveRequestListItem)!; }
                                        @FormatDate(r.StartDate, r.StartPart)
                                    </Template>
                                </GridColumn>
                                <GridColumn HeaderText="End" Width="160" AllowSorting="false" AllowFiltering="false">
                                    <Template>
                                        @{ var r = (context as LeaveRequestListItem)!; }
                                        @FormatDate(r.EndDate, r.EndPart)
                                    </Template>
                                </GridColumn>
                                <GridColumn HeaderText="Days" Width="100" AllowSorting="false" AllowFiltering="false">
                                    <Template>
                                        @{ var r = (context as LeaveRequestListItem)!; }
                                        @FormatDays(r.TotalDays)
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(LeaveRequestListItem.Reason)" HeaderText="Reason">
                                    <Template>
                                        @{ var r = (context as LeaveRequestListItem)!; }
                                        <span class="text-muted">@(r.Reason ?? "—")</span>
                                    </Template>
                                </GridColumn>
                            </GridColumns>
                        </HrGrid>
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header fw-semibold">Approved Requests</div>
                <div class="card-body p-0">
                    @if (_approvedRequests.Count == 0)
                    {
                        <p class="text-muted small p-3 mb-0">No approved requests.</p>
                    }
                    else
                    {
                        <HrGrid TValue="LeaveRequestListItem"
                                DataSource="@_approvedRequests"
                                AllowFiltering="false"
                                AllowPaging="false">
                            <GridColumns>
                                <GridColumn Field="@nameof(LeaveRequestListItem.LeaveTypeName)" HeaderText="Type" />
                                <GridColumn HeaderText="Start" Width="160" AllowSorting="false" AllowFiltering="false">
                                    <Template>
                                        @{ var r = (context as LeaveRequestListItem)!; }
                                        @FormatDate(r.StartDate, r.StartPart)
                                    </Template>
                                </GridColumn>
                                <GridColumn HeaderText="End" Width="160" AllowSorting="false" AllowFiltering="false">
                                    <Template>
                                        @{ var r = (context as LeaveRequestListItem)!; }
                                        @FormatDate(r.EndDate, r.EndPart)
                                    </Template>
                                </GridColumn>
                                <GridColumn HeaderText="Days" Width="100" AllowSorting="false" AllowFiltering="false">
                                    <Template>
                                        @{ var r = (context as LeaveRequestListItem)!; }
                                        @FormatDays(r.TotalDays)
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(LeaveRequestListItem.Reason)" HeaderText="Reason">
                                    <Template>
                                        @{ var r = (context as LeaveRequestListItem)!; }
                                        <span class="text-muted">@(r.Reason ?? "—")</span>
                                    </Template>
                                </GridColumn>
                            </GridColumns>
                        </HrGrid>
                    }
                </div>
            </div>
        </div>

        @if (_toilBalance is not null)
        {
            <div class="col-12">
                <div class="card">
                    <div class="card-header fw-semibold">TOIL Balance</div>
                    <div class="card-body">
                        <span class="fs-4 fw-semibold">@FormatDays(_toilBalance.RemainingDays)</span>
                        <span class="text-muted small ms-2">available</span>
                    </div>
                </div>
            </div>
        }

        <div class="col-12">
            <SfButton>Adjust Balance</SfButton>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId { get; set; }

    private bool _loading = true;
    private List<LeaveBalanceItemModel> _nonToilBalances = [];
    private LeaveBalanceItemModel? _toilBalance;
    private List<LeaveRequestListItem> _pendingRequests = [];
    private List<LeaveRequestListItem> _approvedRequests = [];

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;

        var balanceTask = LeaveService.GetEmployeeLeaveBalanceAsync(CompanyId, EmployeeId);
        var requestsTask = LeaveService.ListLeaveRequestsAsync(CompanyId, EmployeeId);

        await Task.WhenAll(balanceTask, requestsTask);

        var balance = await balanceTask;
        if (balance is not null)
        {
            _toilBalance = balance.Balances.FirstOrDefault(b => b.LeaveTypeCode == "TOIL");
            _nonToilBalances = balance.Balances.Where(b => b.LeaveTypeCode != "TOIL").ToList();
        }

        var requests = await requestsTask;
        if (requests is not null)
        {
            _pendingRequests = requests.Items.Where(r => r.Status == "Pending").ToList();
            _approvedRequests = requests.Items.Where(r => r.Status == "Approved").ToList();
        }

        _loading = false;
    }

    private static string FormatDays(decimal days) =>
        $"{days:0.##} {(days == 1m ? "day" : "days")}";

    private static string FormatDate(DateOnly date, string part) =>
        part == "FullDay" ? date.ToString("dd MMM yyyy") : $"{date:dd MMM yyyy} ({part})";
}
