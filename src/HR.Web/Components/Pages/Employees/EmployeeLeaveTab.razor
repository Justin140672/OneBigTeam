@inject LeaveService LeaveService
@inject AppSession Session

@if (_loading)
{
    <HrLoadingIndicator />
}
else
{
    <div class="row g-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header fw-semibold">Current Balance</div>
                <div class="card-body">
                    @if (_nonToilBalances.Count > 0)
                    {
                        <div class="row g-3">
                            @foreach (var item in _nonToilBalances)
                            {
                                <div class="col-md-4">
                                    <div class="d-flex flex-column h-100">
                                        <span class="text-muted small">@item.LeaveTypeName</span>
                                        @if (item.HasBalance)
                                        {
                                            <span class="fs-4 fw-semibold">@FormatDays(item.RemainingDays ?? 0)</span>
                                            <span class="text-muted small">of @FormatDays(item.EntitlementDays ?? 0) entitlement</span>
                                            @if (item.PendingDays > 0)
                                            {
                                                <span class="text-muted small">@FormatDays(item.PendingDays) pending</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="fs-4 fw-semibold text-muted">n/a</span>
                                        }
                                        <div class="d-flex gap-1 mt-2">
                                            @if (item.HasBalance && Session.CanManageEmployees)
                                            {
                                                <SfButton CssClass="e-outline e-small"
                                                          OnClick="@(() => OpenAdjustDialog(item))">
                                                    Adjust
                                                </SfButton>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">No balance data available.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header fw-semibold">Pending Requests</div>
                <div class="card-body p-0">
                    @if (_pendingRequests.Count == 0)
                    {
                        <p class="text-muted small p-3 mb-0">No pending requests.</p>
                    }
                    else
                    {
                        <HrGrid TValue="LeaveRequestListItem"
                                DataSource="@_pendingRequests"
                                AllowFiltering="false"
                                AllowPaging="false">
                            <GridColumns>
                                <GridColumn Field="@nameof(LeaveRequestListItem.LeaveTypeName)" HeaderText="Type" />
                                <GridColumn HeaderText="Start" Width="160" AllowSorting="false" AllowFiltering="false">
                                    <Template>
                                        @{ var r = (context as LeaveRequestListItem)!; }
                                        @FormatDate(r.StartDate, r.StartPart)
                                    </Template>
                                </GridColumn>
                                <GridColumn HeaderText="End" Width="160" AllowSorting="false" AllowFiltering="false">
                                    <Template>
                                        @{ var r = (context as LeaveRequestListItem)!; }
                                        @FormatDate(r.EndDate, r.EndPart)
                                    </Template>
                                </GridColumn>
                                <GridColumn HeaderText="Days" Width="100" AllowSorting="false" AllowFiltering="false">
                                    <Template>
                                        @{ var r = (context as LeaveRequestListItem)!; }
                                        @FormatDays(r.TotalDays)
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(LeaveRequestListItem.Reason)" HeaderText="Reason">
                                    <Template>
                                        @{ var r = (context as LeaveRequestListItem)!; }
                                        <span class="text-muted">@(r.Reason ?? "—")</span>
                                    </Template>
                                </GridColumn>
                            </GridColumns>
                        </HrGrid>
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header fw-semibold">Approved Requests</div>
                <div class="card-body p-0">
                    @if (_approvedRequests.Count == 0)
                    {
                        <p class="text-muted small p-3 mb-0">No approved requests.</p>
                    }
                    else
                    {
                        <HrGrid TValue="LeaveRequestListItem"
                                DataSource="@_approvedRequests"
                                AllowFiltering="false"
                                AllowPaging="false">
                            <GridColumns>
                                <GridColumn Field="@nameof(LeaveRequestListItem.LeaveTypeName)" HeaderText="Type" />
                                <GridColumn HeaderText="Start" Width="160" AllowSorting="false" AllowFiltering="false">
                                    <Template>
                                        @{ var r = (context as LeaveRequestListItem)!; }
                                        @FormatDate(r.StartDate, r.StartPart)
                                    </Template>
                                </GridColumn>
                                <GridColumn HeaderText="End" Width="160" AllowSorting="false" AllowFiltering="false">
                                    <Template>
                                        @{ var r = (context as LeaveRequestListItem)!; }
                                        @FormatDate(r.EndDate, r.EndPart)
                                    </Template>
                                </GridColumn>
                                <GridColumn HeaderText="Days" Width="100" AllowSorting="false" AllowFiltering="false">
                                    <Template>
                                        @{ var r = (context as LeaveRequestListItem)!; }
                                        @FormatDays(r.TotalDays)
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(LeaveRequestListItem.Reason)" HeaderText="Reason">
                                    <Template>
                                        @{ var r = (context as LeaveRequestListItem)!; }
                                        <span class="text-muted">@(r.Reason ?? "—")</span>
                                    </Template>
                                </GridColumn>
                            </GridColumns>
                        </HrGrid>
                    }
                </div>
            </div>
        </div>

        @if (_toilBalance is not null)
        {
            <div class="col-12">
                <div class="card">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <span class="fw-semibold">TOIL Balance</span>
                        @if (_toilBalance.HasBalance && Session.CanManageEmployees)
                        {
                            <div class="d-flex gap-1">
                                <SfButton CssClass="e-outline e-small"
                                          OnClick="@(() => OpenAdjustDialog(_toilBalance))">
                                    Adjust
                                </SfButton>
                            </div>
                        }
                    </div>
                    <div class="card-body">
                        @if (_toilBalance.HasBalance)
                        {
                            <span class="fs-4 fw-semibold">@FormatHours(_toilBalance.RemainingHours)</span>
                            <span class="text-muted small ms-2">available</span>
                        }
                        else
                        {
                            <span class="fs-4 fw-semibold text-muted">n/a</span>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <span class="fw-semibold">Balance History</span>
                    @if (_historyOptions.Count > 0)
                    {
                        <div class="leave-type-picker">
                            <SfDropDownList TValue="Guid?" TItem="HistoryOption"
                                            DataSource="@_historyOptions"
                                            @bind-Value="_historyLeaveTypeId"
                                            AllowFiltering="true"
                                            Placeholder="Select leave type">
                                <DropDownListFieldSettings Value="Id" Text="Name" />
                                <DropDownListEvents TValue="Guid?" TItem="HistoryOption" ValueChange="OnHistoryLeaveTypeChanged" />
                            </SfDropDownList>
                        </div>
                    }
                </div>
                <div class="card-body p-0">
                    @if (_historyLoading)
                    {
                        <HrLoadingIndicator />
                    }
                    else if (_historyOptions.Count == 0)
                    {
                        <p class="text-muted small p-3 mb-0">No balance-tracked leave types available.</p>
                    }
                    else if (_historyItems.Count == 0)
                    {
                        <p class="text-muted small p-3 mb-0">No balance history for this leave type.</p>
                    }
                    else
                    {
                        <HrGrid TValue="LeaveBalanceHistoryItemModel"
                                DataSource="@_historyItems"
                                AllowFiltering="false"
                                AllowPaging="true">
                            <GridPageSettings PageSize="10" />
                            <GridColumns>
                                <GridColumn HeaderText="Date" Width="140" AllowSorting="false" AllowFiltering="false">
                                    <Template>
                                        @{ var h = (context as LeaveBalanceHistoryItemModel)!; }
                                        @h.Date.ToString("dd MMM yyyy")
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(LeaveBalanceHistoryItemModel.LeaveTypeName)" HeaderText="Leave Type" Width="160" />
                                <GridColumn HeaderText="Change" Width="110" AllowSorting="false" AllowFiltering="false">
                                    <Template>
                                        @{ var h = (context as LeaveBalanceHistoryItemModel)!; }
                                        <span class="@(h.Change >= 0 ? "text-success" : "text-danger")">@FormatSignedHours(h.Change)</span>
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(LeaveBalanceHistoryItemModel.Reason)" HeaderText="Reason" Width="160" />
                                <GridColumn HeaderText="Balance After" Width="130" AllowSorting="false" AllowFiltering="false">
                                    <Template>
                                        @{ var h = (context as LeaveBalanceHistoryItemModel)!; }
                                        @FormatHours(h.BalanceAfter)
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(LeaveBalanceHistoryItemModel.CreatedBy)" HeaderText="Created By" Width="160" />
                            </GridColumns>
                        </HrGrid>
                    }
                </div>
            </div>
        </div>
    </div>
}

<AdjustLeaveBalanceDialog @bind-Visible="_showAdjustDialog"
                           CompanyId="CompanyId"
                           EmployeeId="EmployeeId"
                           LeaveTypeId="@_adjustLeaveTypeId"
                           LeaveTypeName="@_adjustLeaveTypeName"
                           CurrentBalanceHours="@_adjustCurrentBalanceHours"
                           IsToil="@_adjustIsToil"
                           CurrentBalanceDays="@_adjustCurrentBalanceDays"
                           OnAdjusted="OnBalanceAdjusted" />

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId { get; set; }

    private bool _loading = true;
    private List<LeaveBalanceItemModel> _nonToilBalances = [];
    private LeaveBalanceItemModel? _toilBalance;
    private List<LeaveRequestListItem> _pendingRequests = [];
    private List<LeaveRequestListItem> _approvedRequests = [];

    private bool _showAdjustDialog;
    private Guid _adjustLeaveTypeId;
    private string _adjustLeaveTypeName = string.Empty;
    private decimal? _adjustCurrentBalanceHours;
    private decimal? _adjustCurrentBalanceDays;
    private bool _adjustIsToil;

    private List<HistoryOption> _historyOptions = [];
    private Guid? _historyLeaveTypeId;
    private List<LeaveBalanceHistoryItemModel> _historyItems = [];
    private bool _historyLoading;

    private sealed record HistoryOption(Guid Id, string Name);

    protected override async Task OnParametersSetAsync()
    {
        await LoadBalancesAndRequestsAsync();
    }

    private async Task LoadBalancesAndRequestsAsync()
    {
        _loading = true;

        var balanceTask = LeaveService.GetEmployeeLeaveBalanceAsync(CompanyId, EmployeeId);
        var requestsTask = LeaveService.ListLeaveRequestsAsync(CompanyId, EmployeeId);

        await Task.WhenAll(balanceTask, requestsTask);

        var balance = await balanceTask;
        if (balance is not null)
        {
            _toilBalance = balance.Balances.FirstOrDefault(b => b.LeaveTypeCode == "TOIL");
            _nonToilBalances = balance.Balances.Where(b => b.LeaveTypeCode != "TOIL").ToList();

            var trackedBalances = balance.Balances.Where(b => b.HasBalance).ToList();
            _historyOptions = trackedBalances
                .Select(b => new HistoryOption(b.LeaveTypeId, b.LeaveTypeName))
                .ToList();

            if (_historyLeaveTypeId is null || _historyOptions.All(o => o.Id != _historyLeaveTypeId))
                _historyLeaveTypeId = _historyOptions.FirstOrDefault()?.Id;
        }

        var requests = await requestsTask;
        if (requests is not null)
        {
            _pendingRequests = requests.Items.Where(r => r.Status == "Pending").ToList();
            _approvedRequests = requests.Items.Where(r => r.Status == "Approved").ToList();
        }

        _loading = false;

        await LoadHistoryAsync();
    }

    private async Task LoadHistoryAsync()
    {
        if (_historyLeaveTypeId is null)
        {
            _historyItems = [];
            return;
        }

        _historyLoading = true;
        var history = await LeaveService.GetLeaveBalanceHistoryAsync(CompanyId, EmployeeId, _historyLeaveTypeId.Value);
        _historyItems = history?.Items.ToList() ?? [];
        _historyLoading = false;
    }

    private async Task OnHistoryLeaveTypeChanged(ChangeEventArgs<Guid?, HistoryOption> args)
    {
        _historyLeaveTypeId = args.Value;
        await LoadHistoryAsync();
    }

    private void OpenAdjustDialog(LeaveBalanceItemModel item)
    {
        var isToil = item.LeaveTypeCode == "TOIL";

        _adjustLeaveTypeId = item.LeaveTypeId;
        _adjustLeaveTypeName = item.LeaveTypeName;
        _adjustCurrentBalanceHours = item.RemainingHours;
        _adjustCurrentBalanceDays = item.RemainingDays;
        _adjustIsToil = isToil;
        _showAdjustDialog = true;
    }

    private async Task OnBalanceAdjusted()
    {
        await LoadBalancesAndRequestsAsync();
    }

    private static string FormatDays(decimal days) =>
        $"{days:0.##} {(days == 1m ? "day" : "days")}";

    private static string FormatHours(decimal? hours) =>
        $"{(hours ?? 0):0.#}h";

    private static string FormatSignedHours(decimal hours) =>
        $"{(hours >= 0 ? "+" : "")}{hours:0.#}h";

    private static string FormatDate(DateOnly date, string part) =>
        part == "FullDay" ? date.ToString("dd MMM yyyy") : $"{date:dd MMM yyyy} ({part})";
}
