@using System.ComponentModel.DataAnnotations
@using HR.Web.Models
@inject EmployeeNoteService EmployeeNoteService
@inherits EditDialogBase<SupersedeEmployeeNoteDialog.SupersedeEmployeeNoteFormModel>

<SfDialog @bind-Visible="Visible" IsModal="true" Width="560px" ShowCloseIcon="true" CssClass="supersede-employee-note-dialog">
    <DialogEvents Closed="HandleDialogClosed" />
    <DialogTemplates>
        <Header>Edit Note</Header>
        <Content>
            @if (!string.IsNullOrEmpty(GlobalError))
            {
                <div class="alert alert-danger alert-dismissible mb-3">
                    @GlobalError
                    <button type="button" class="btn-close" @onclick="@(() => GlobalError = null)"></button>
                </div>
            }
            @if (Original is not null)
            {
                <div class="card mb-3" data-testid="supersede-original-note-preview">
                    <div class="card-header py-2">
                        <span class="text-muted small">Original Note (@EmployeeNoteCategories.Label(Original.Category))</span>
                    </div>
                    <div class="card-body py-2">
                        <p class="mb-0 small">@Original.NoteText</p>
                    </div>
                </div>
            }
            <EditForm EditContext="EditContext">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Category <span class="text-danger">*</span></label>
                        <SfDropDownList TValue="string" TItem="string"
                                        DataSource="@EmployeeNoteCategories.All"
                                        @bind-Value="Model.Category"
                                        AllowFiltering="true">
                        </SfDropDownList>
                        <ValidationMessage For="@(() => Model.Category)" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Note <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="4" maxlength="4000" data-testid="supersede-note-text"
                                  @bind="Model.NoteText" placeholder="Enter replacement note details…"></textarea>
                        <ValidationMessage For="@(() => Model.NoteText)" />
                    </div>
                    <div class="col-12">
                        <SfCheckBox TChecked="bool" Label="Important" @bind-Checked="Model.IsImportant" />
                    </div>
                </div>
            </EditForm>
        </Content>
        <FooterTemplate>
            <HrDialogButtonBar SaveLabel="Save" Saving="Saving" OnSave="SubmitAsync" OnCancel="CancelAsync" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId { get; set; }
    [Parameter, EditorRequired] public EmployeeNoteItemModel? Original { get; set; }

    protected override async Task<string?> SaveCoreAsync()
    {
        if (Original is null)
            return "No original note selected.";

        var request = new SupersedeEmployeeNoteRequest(
            CompanyId,
            EmployeeId,
            Model.Category,
            Model.NoteText.Trim(),
            Model.IsImportant);

        var (created, error) = await EmployeeNoteService.SupersedeEmployeeNoteAsync(
            CompanyId, EmployeeId, Original.Id, request);

        return created is not null ? null : error ?? "Failed to supersede employee note.";
    }

    protected override Task OnOpenedAsync()
    {
        GlobalError = null;

        if (Original is not null)
        {
            Model.Category = Original.Category;
            Model.NoteText = Original.NoteText;
            Model.IsImportant = Original.IsImportant;
        }

        return Task.CompletedTask;
    }

    protected override void ResetForm()
    {
        Model.Category = "General";
        Model.NoteText = string.Empty;
        Model.IsImportant = false;
    }

    public sealed class SupersedeEmployeeNoteFormModel
    {
        [Required(ErrorMessage = "Please select a category.")]
        public string Category { get; set; } = "General";

        [Required(ErrorMessage = "Please enter the note text.")]
        public string NoteText { get; set; } = string.Empty;

        public bool IsImportant { get; set; }
    }
}
