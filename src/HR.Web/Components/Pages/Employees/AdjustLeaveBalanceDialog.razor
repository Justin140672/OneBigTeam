@using System.ComponentModel.DataAnnotations
@using HR.SharedKernel.Idempotency
@using HR.Web.Models
@inject LeaveService LeaveService

<SfDialog @bind-Visible="Visible" IsModal="true" Width="480px" ShowCloseIcon="true">
    <DialogEvents Closed="Cancel" />
    <DialogTemplates>
        <Header>Adjust @LeaveTypeName Balance</Header>
        <Content>
            <EditForm EditContext="_editContext">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label fw-medium">Current Balance</label>
                    <input class="form-control" readonly value="@FormattedCurrentBalance" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-medium">Adjustment (@(IsToil ? "hours" : "days")) <span class="text-danger">*</span></label>
                    <div data-testid="adjustment-hours-input">
                        <SfNumericTextBox TValue="decimal?" @bind-Value="_model.AdjustmentValue" ShowSpinButton="false"
                                          Min="-9999.99m" Max="9999.99m"
                                          Placeholder="e.g. 7.5 or -3.5" />
                    </div>
                    <ValidationMessage For="@(() => _model.AdjustmentValue)" />
                    <div class="form-text">Use a positive value to add @(IsToil ? "hours" : "days"), negative to deduct (max 9,999.99).</div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-medium">Reason <span class="text-danger">*</span></label>
                    <SfDropDownList TValue="LeaveBalanceAdjustmentReason" TItem="ReasonChoice"
                                    DataSource="@ReasonOptions"
                                    @bind-Value="_model.Reason">
                        <DropDownListFieldSettings Value="Value" Text="Label" />
                    </SfDropDownList>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-medium">Comments</label>
                    <HrTextBox @bind-Value="_model.Comments" Multiline="true" Rows="3" Maxlength="500" Placeholder="Optional comments…" />
                    <ValidationMessage For="@(() => _model.Comments)" />
                </div>
                <div class="mb-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="allowNegativeOverride"
                               @bind="_model.AllowNegativeOverride" />
                        <label class="form-check-label" for="allowNegativeOverride">
                            Allow this adjustment to take the balance below zero
                        </label>
                    </div>
                </div>
                @if (_ambiguous)
                {
                    <div class="alert alert-warning mt-2 mb-0">
                        <p class="mb-2">@_error</p>
                        <p class="mb-2">We could not confirm whether this adjustment was applied. Click <strong>Save</strong> again to safely retry — it will not adjust the balance twice. Only choose <strong>Start Over</strong> if you're sure you want to abandon this attempt; if it actually succeeded, starting over and resubmitting may adjust the balance twice.</p>
                        <SfButton CssClass="e-small" OnClick="AbandonAndReset">Start Over</SfButton>
                    </div>
                }
                else if (_error is not null)
                {
                    <div class="alert alert-danger mt-2 mb-0">@_error</div>
                }
            </EditForm>
        </Content>
        <FooterTemplate>
            <SfButton IsPrimary="true" Disabled="@_submitting" OnClick="SubmitAsync">
                @if (_submitting)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                Save
            </SfButton>
            <SfButton Disabled="@_submitting" OnClick="Cancel">Cancel</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId { get; set; }
    [Parameter, EditorRequired] public Guid LeaveTypeId { get; set; }
    [Parameter, EditorRequired] public string LeaveTypeName { get; set; } = string.Empty;
    [Parameter] public decimal? CurrentBalanceHours { get; set; }
    [Parameter] public bool IsToil { get; set; }
    [Parameter] public decimal? CurrentBalanceDays { get; set; }
    [Parameter] public EventCallback OnAdjusted { get; set; }

    private string FormattedCurrentBalance => IsToil
        ? $"{(CurrentBalanceHours ?? 0):0.#}h"
        : FormatDays(CurrentBalanceDays ?? 0);

    private static string FormatDays(decimal days) =>
        $"{days:0.##} {(days == 1m ? "day" : "days")}";

    private sealed record ReasonChoice(LeaveBalanceAdjustmentReason Value, string Label);

    private static readonly ReasonChoice[] ReasonOptions =
    [
        new(LeaveBalanceAdjustmentReason.Correction, "Correction"),
        new(LeaveBalanceAdjustmentReason.CarryOver, "Carry Over"),
        new(LeaveBalanceAdjustmentReason.ManualAward, "Manual Award"),
        new(LeaveBalanceAdjustmentReason.ManualDeduction, "Manual Deduction"),
        new(LeaveBalanceAdjustmentReason.Other, "Other"),
    ];

    private readonly AdjustLeaveBalanceFormModel _model = new();
    private EditContext _editContext = default!;
    private string? _error;
    private bool _submitting;

    // Ticket 3 (P1) final gap: true when the last submit attempt returned an AmbiguousFailure (a
    // 5xx/408/429/transport failure/timeout/malformed response) — distinct from a definitive
    // rejection. Drives the "unconfirmed, safe to retry" banner above and gates the explicit
    // Start Over action, which is the only way to discard a key retained under this condition.
    private bool _ambiguous;

    // Ticket 3 (P1) final follow-up items 1/2: this dialog instance - not the scoped LeaveService -
    // owns the idempotency key for the ONE logical "adjust balance" submission it currently
    // represents. Reused across retries of that same unchanged submission; rotated the moment the
    // user changes a material field; discarded in Reset() on every definitive outcome.
    private readonly PendingIdempotentOperation _submitOperation = new();

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);
    }

    private sealed class AdjustLeaveBalanceFormModel : IValidatableObject
    {
        [Required(ErrorMessage = "Please enter a non-zero adjustment.")]
        public decimal? AdjustmentValue { get; set; }

        public LeaveBalanceAdjustmentReason Reason { get; set; } = LeaveBalanceAdjustmentReason.Correction;

        [MaxLength(500)]
        public string? Comments { get; set; }

        public bool AllowNegativeOverride { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (AdjustmentValue == 0)
                yield return new ValidationResult("Please enter a non-zero adjustment.", [nameof(AdjustmentValue)]);
        }
    }

    private async Task SubmitAsync()
    {
        _error = null;
        _ambiguous = false;

        if (!_editContext.Validate())
        {
            _error = _editContext.GetValidationMessages().FirstOrDefault()
                ?? "Please correct the highlighted fields below.";
            return;
        }

        // Disable-while-in-flight (below, via _submitting on the button) is this dialog's only
        // concurrent-submission guard - by design, one dialog instance represents one in-progress
        // adjustment at a time, so there's nothing else to give a separate key to here. A second,
        // independent adjustment (e.g. a second dialog instance for a different employee) gets its
        // own IdempotencyKeyScope simply by being a different component instance.
        _submitting = true;
        _error = null;

        // Bug fix (P1 follow-up to Ticket 3): _submitting was previously only cleared along the
        // normal AmbiguousFailure/Succeeded/Rejected result paths below. LeaveService now never
        // lets a body-read failure escape as an exception (it's classified as AmbiguousFailure
        // instead), but this try/finally is kept as defence in depth against any other unexpected
        // exception reaching here (e.g. a bug in a future caller, an OOM, ...) — without it, an
        // escaped exception would leave the Save button permanently disabled with no way for the
        // user to retry or abandon the pending operation.
        try
        {
            // Comments must be normalized here, before the idempotency key snapshot is taken below,
            // so the fingerprint and the HTTP body are always derived from the identical trimmed
            // value - trimming afterwards (or only at the HTTP boundary) would let whitespace-only
            // edits change one without the other.
            var request = new AdjustLeaveBalanceModel(
                LeaveTypeId,
                _model.AdjustmentValue!.Value,
                _model.Reason,
                FormText.Optional(_model.Comments),
                _model.AllowNegativeOverride);

            // Fingerprint includes which employee/leave type this dialog instance currently targets
            // - it's a reusable component, so Blazor can rebind it to a different employee between
            // opens without recreating it.
            var key = _submitOperation.PrepareKey((CompanyId, EmployeeId, request));

            var outcome = await LeaveService.AdjustLeaveBalanceAsync(CompanyId, EmployeeId, request, key);

            if (outcome.Kind == MutationOutcomeKind.AmbiguousFailure)
            {
                // Ambiguous - the mutation may already have committed server-side. Deliberately do
                // NOT complete the operation: the key and this exact request are retained so the
                // user's next click of this same "Save" button (unchanged fields) reuses them and
                // the server replays rather than repeats the adjustment. The form stays populated.
                _ambiguous = true;
                _error = outcome.Error ?? "Failed to adjust leave balance. Please try again.";
                return;
            }

            // A definitive outcome (success or a business rejection) was returned - so this
            // submission has concluded one way or another: the NEXT submit (a corrected
            // resubmission, or a fresh adjustment after this dialog is reopened) starts a new
            // logical operation.
            _submitOperation.Complete();

            if (outcome.Kind == MutationOutcomeKind.Succeeded)
            {
                await VisibleChanged.InvokeAsync(false);
                Reset();
                await OnAdjusted.InvokeAsync();
            }
            else
            {
                _error = outcome.Error ?? "Failed to adjust leave balance.";
            }
        }
        catch (Exception)
        {
            // Unexpected exception reaching the UI: the outcome is unconfirmed, not a definitive
            // failure - preserve the pending operation (do NOT call _submitOperation.Complete())
            // so an unchanged retry can still safely replay rather than repeat the adjustment.
            _ambiguous = true;
            _error = "We could not confirm whether this adjustment was applied. Please try again.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task Cancel()
    {
        await VisibleChanged.InvokeAsync(false);
        Reset();
    }

    // Ticket 3 (P1) final gap item 7: explicit user action to give up on a pending ambiguous
    // operation while staying on the dialog (as opposed to Cancel, which also abandons it but by
    // closing the dialog). Only reachable from the ambiguous-outcome banner, which already warns
    // that this may create a second record if the previous attempt actually committed.
    private void AbandonAndReset()
    {
        _ambiguous = false;
        _submitOperation.Complete();
        Reset();
    }

    private void Reset()
    {
        _model.AdjustmentValue = null;
        _model.Reason = LeaveBalanceAdjustmentReason.Correction;
        _model.Comments = null;
        _model.AllowNegativeOverride = false;
        _editContext = new EditContext(_model);
        _error = null;
        _ambiguous = false;

        // Cancelling discards whatever partial submission was pending - the next open of this
        // dialog (even for the same employee/leave type) is a new logical operation.
        _submitOperation.Complete();
    }
}
