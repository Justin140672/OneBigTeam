@using System.Globalization
@using HR.Web.Components.Pages.Reporting
@inject EmployeeService EmployeeService
@inject LeaveService LeaveService
@inject PublicHolidayService PublicHolidayService
@inject TaskService TaskService
@inject SicknessService SicknessService
@inject ProbationService ProbationService
@inject OnboardingService OnboardingService
@inject CompensationService CompensationService
@inject AppSession Session

@if (!Session.EmployeeId.HasValue || Session.EmployeeId.Value != EmployeeId)
{
    <div class="alert alert-danger">
        <i class="fa-solid fa-lock me-2"></i>You can only view your own profile.
    </div>
}
else if (_loading)
{
    <div class="overview-skeleton">
        @for (var i = 0; i < 3; i++)
        {
            <div class="skeleton-card mb-3">
                <div class="skeleton-line skeleton-title"></div>
                <div class="skeleton-line"></div>
                <div class="skeleton-line"></div>
                <div class="skeleton-line skeleton-short"></div>
            </div>
        }
    </div>
}
else if (_employee is null)
{
    <div class="alert alert-warning">Unable to load profile details.</div>
}
else
{
    <div class="overview-layout">
        <div class="overview-main">

            <div class="overview-grid">

                <!-- Employment Summary -->
                <div class="overview-card">
                    <div class="overview-card-header">
                        <i class="fa-solid fa-briefcase overview-card-icon"></i>
                        <span class="overview-card-title">Employment</span>
                    </div>
                    <dl class="overview-dl">
                        <dt>Job Title</dt>
                        <dd>@(_employee.PositionTitle ?? Session.JobTitle ?? "—")</dd>

                        <dt>Employee Number</dt>
                        <dd>@(_employee.EmployeeNumber ?? "—")</dd>

                        <dt>Department</dt>
                        <dd>@(_employee.DepartmentName ?? "—")</dd>

                        <dt>Location</dt>
                        <dd>@(_employee.LocationName ?? "—")</dd>

                        <dt>Manager</dt>
                        <dd>@(_employee.ManagerFullName ?? "—")</dd>

                        <dt>Employment Type</dt>
                        <dd>@(_employee.EmploymentTypeName ?? "—")</dd>

                        <dt>Employment Status</dt>
                        <dd>@StatusDisplayName(_employee.Status)</dd>

                        <dt>Start Date</dt>
                        <dd>@_employee.StartDate.ToString("d MMMM yyyy")</dd>

                        @if (_employee.ContinuousServiceDate.HasValue)
                        {
                            <dt>Continuous Service Date</dt>
                            <dd>@_employee.ContinuousServiceDate.Value.ToString("d MMMM yyyy")</dd>
                        }

                        <dt>Length of Service</dt>
                        <dd>@LengthOfService(_employee.StartDate)</dd>

                        <dt>Working Pattern</dt>
                        <dd>@WorkingPatternSummary()</dd>

                        @if (_probationStatus is { HasRecord: true })
                        {
                            <dt>Probation Status</dt>
                            <dd>
                                <span class="badge @ProbationStatusBadgeClass(_probationStatus.Status ?? "")">
                                    @ProbationStatusLabel(_probationStatus.Status ?? "")
                                </span>
                            </dd>

                            @if (_probationStatus.ExpectedEndDate.HasValue)
                            {
                                <dt>Probation End Date</dt>
                                <dd>@_probationStatus.ExpectedEndDate.Value.ToString("d MMMM yyyy")</dd>
                            }
                        }

                        @if (Session.DisplaySalaryOnEmployeeProfile)
                        {
                            <dt>Salary</dt>
                            <dd>@SalarySummary()</dd>
                        }
                    </dl>
                </div>

                <!-- Contact Information -->
                <div class="overview-card">
                    <div class="overview-card-header">
                        <i class="fa-solid fa-envelope overview-card-icon"></i>
                        <span class="overview-card-title">Contact Information</span>
                    </div>
                    <dl class="overview-dl">
                        <dt>Work Email</dt>
                        <dd>
                            <a href="mailto:@_employee.WorkEmail" class="overview-link">@_employee.WorkEmail</a>
                        </dd>

                        <dt>Personal Email</dt>
                        <dd>
                            @if (_employee.PersonalEmail is not null)
                            {
                                <a href="mailto:@_employee.PersonalEmail" class="overview-link">@_employee.PersonalEmail</a>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </dd>
                    </dl>
                </div>

            </div>

            <!-- Quick Statistics -->
            <div class="stats-row">
                <div class="stat-card stat-card--clickable" @onclick="@(() => OnNavigateToTasks.InvokeAsync())">
                    <div class="stat-icon stat-icon--tasks">
                        <i class="fa-solid fa-list-check"></i>
                    </div>
                    <div class="stat-body">
                        <span class="stat-value">@_openTaskCount</span>
                        <span class="stat-label">Open Tasks</span>
                    </div>
                </div>

                <div class="stat-card stat-card--clickable" @onclick="@(() => OnNavigateToLeave.InvokeAsync())">
                    <div class="stat-icon stat-icon--leave">
                        <i class="fa-solid fa-umbrella-beach"></i>
                    </div>
                    <div class="stat-body">
                        <span class="stat-value">@FormatDays(_annualLeaveRemaining)</span>
                        <span class="stat-label">Leave Remaining</span>
                    </div>
                </div>

                <div class="stat-card stat-card--clickable" @onclick="@(() => OnNavigateToLeave.InvokeAsync())">
                    <div class="stat-icon stat-icon--pending @(_pendingLeaveCount > 0 ? "stat-icon--pending-active" : "")">
                        <i class="fa-solid fa-clock"></i>
                    </div>
                    <div class="stat-body">
                        <span class="stat-value">@_pendingLeaveCount</span>
                        <span class="stat-label">Pending Requests</span>
                    </div>
                </div>

                <div class="stat-card stat-card--clickable" @onclick="@(() => OnNavigateToSickness.InvokeAsync())">
                    <div class="stat-icon stat-icon--sickness">
                        <i class="fa-solid fa-house-medical"></i>
                    </div>
                    <div class="stat-body">
                        <span class="stat-value">@FormatDays(_sicknessDays)</span>
                        <span class="stat-label">Sickness Absence</span>
                    </div>
                </div>
            </div>

            <!-- Upcoming Leave -->
            <div class="overview-card mt-3">
                <div class="overview-card-header">
                    <i class="fa-solid fa-calendar-days overview-card-icon"></i>
                    <span class="overview-card-title">Upcoming Leave</span>
                </div>
                @if (_upcomingLeave.Count == 0)
                {
                    <p class="text-muted mb-0 px-1 py-2">No upcoming leave approved.</p>
                }
                else
                {
                    <ul class="upcoming-leave-list">
                        @foreach (var req in _upcomingLeave)
                        {
                            <li class="upcoming-leave-item">
                                <span class="upcoming-leave-type">@req.LeaveTypeName</span>
                                <span class="upcoming-leave-dates">
                                    @FormatDateRange(req.StartDate, req.StartPart, req.EndDate, req.EndPart)
                                </span>
                                <span class="upcoming-leave-days">@FormatDays(req.TotalDays)</span>
                            </li>
                        }
                    </ul>
                }
            </div>

            @if (_onboardingStatus is { HasPlan: true })
            {
                <!-- Onboarding Progress -->
                <div class="overview-card mt-3">
                    <div class="overview-card-header">
                        <i class="fa-solid fa-route overview-card-icon"></i>
                        <span class="overview-card-title">Onboarding Progress</span>
                    </div>
                    <div class="px-1 py-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small">@_onboardingStatus.CompletedTasks of @_onboardingStatus.TotalTasks tasks complete</span>
                            <span class="fw-semibold">@OnboardingPercentComplete()%</span>
                        </div>
                        <div class="progress">
                            <div class="progress-bar" role="progressbar" style="width: @(OnboardingPercentComplete())%"></div>
                        </div>
                    </div>
                    @if (_onboardingStatus.Tasks.Count > 0)
                    {
                        <ul class="upcoming-leave-list">
                            @foreach (var task in _onboardingStatus.Tasks.Where(t => t.Status != "Completed" && t.Status != "Skipped").Take(5))
                            {
                                <li class="upcoming-leave-item">
                                    <span class="upcoming-leave-type">@task.Title</span>
                                    <span class="upcoming-leave-dates">@(task.DueDate.HasValue ? task.DueDate.Value.ToString("d MMM yyyy") : "No due date")</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }

        </div>

        <!-- Actions -->
        <div class="overview-sidebar">
            @if (!Session.IsManager)
            {
                <div class="mb-3">
                    <FavouriteReportsWidget />
                </div>
            }
            <div class="overview-card overview-actions-card">
                <div class="overview-card-header">
                    <i class="fa-solid fa-bolt overview-card-icon"></i>
                    <span class="overview-card-title">Quick Actions</span>
                </div>
                <div class="overview-actions">
                    <button class="action-btn action-btn--leave" @onclick="@(() => _showRequestLeaveForm = true)">
                        <span class="action-btn-icon"><i class="fa-solid fa-calendar-plus"></i></span>
                        <span class="action-btn-label">Request Leave</span>
                        <i class="fa-solid fa-chevron-right action-btn-chevron"></i>
                    </button>
                    <button class="action-btn action-btn--sickness" @onclick="@(() => _showRecordSicknessDialog = true)">
                        <span class="action-btn-icon"><i class="fa-solid fa-house-medical"></i></span>
                        <span class="action-btn-label">Notify Sickness</span>
                        <i class="fa-solid fa-chevron-right action-btn-chevron"></i>
                    </button>
                    <button class="action-btn action-btn--documents" @onclick="@(() => OnNavigateToDocuments.InvokeAsync())">
                        <span class="action-btn-icon"><i class="fa-solid fa-file-lines"></i></span>
                        <span class="action-btn-label">View Documents</span>
                        <i class="fa-solid fa-chevron-right action-btn-chevron"></i>
                    </button>
                    <button class="action-btn action-btn--tasks" @onclick="@(() => OnNavigateToTasks.InvokeAsync())">
                        <span class="action-btn-icon"><i class="fa-solid fa-list-check"></i></span>
                        <span class="action-btn-label">View Tasks</span>
                        <i class="fa-solid fa-chevron-right action-btn-chevron"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <RequestLeaveForm CompanyId="CompanyId"
                      EmployeeId="EmployeeId"
                      Balances="_allBalances"
                      EffectiveWorkingDays="_effectiveWorkingDays"
                      EffectiveHoursPerDay="_effectiveHoursPerDay"
                      ExcludePublicHolidays="_excludePublicHolidays"
                      PublicHolidays="_publicHolidays"
                      IsOpen="_showRequestLeaveForm"
                      OnSubmitted="OnLeaveSubmittedAsync"
                      OnCancelled="@(() => _showRequestLeaveForm = false)" />

    <RecordSicknessDialog CompanyId="CompanyId"
                          EmployeeId="EmployeeId"
                          SelfService="true"
                          IsOpen="_showRecordSicknessDialog"
                          OnSaved="OnSicknessRecordedAsync"
                          OnCancelled="@(() => _showRecordSicknessDialog = false)" />
}

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId { get; set; }

    [Parameter] public EventCallback OnNavigateToDocuments { get; set; }
    [Parameter] public EventCallback OnNavigateToTasks { get; set; }
    [Parameter] public EventCallback OnNavigateToLeave { get; set; }
    [Parameter] public EventCallback OnNavigateToSickness { get; set; }

    private bool _loading = true;
    private bool _showRequestLeaveForm;
    private bool _showRecordSicknessDialog;
    private GetEmployeeResponse? _employee;
    private int _openTaskCount;
    private decimal? _annualLeaveRemaining;
    private int _pendingLeaveCount;
    private decimal? _sicknessDays;
    private List<LeaveRequestListItem> _upcomingLeave = [];
    private MyProbationStatusModel? _probationStatus;
    private MyOnboardingStatusModel? _onboardingStatus;
    private CurrentCompensationModel? _currentCompensation;

    // Backing data for the "Request Leave" quick-action dialog, rendered directly on this tab
    // so it opens on top of whatever tab the user is currently viewing instead of forcing a
    // navigation to the Leave tab first.
    private IReadOnlyList<LeaveBalanceItemModel> _allBalances = [];
    private WorkingDays _effectiveWorkingDays = WorkingDays.Monday | WorkingDays.Tuesday |
        WorkingDays.Wednesday | WorkingDays.Thursday | WorkingDays.Friday;
    private decimal _effectiveHoursPerDay = 7.5m;
    private bool _excludePublicHolidays = true;
    private IReadOnlyList<DateOnly> _publicHolidays = [];

    protected override async Task OnParametersSetAsync()
    {
        if (!Session.EmployeeId.HasValue || Session.EmployeeId.Value != EmployeeId)
        {
            _loading = false;
            return;
        }

        _loading = true;

        _effectiveWorkingDays  = Session.WorkingDaysOverride ?? (WorkingDays)Session.WorkingDays;
        _effectiveHoursPerDay  = Session.HoursPerDayOverride ?? Session.HoursPerDay;
        _excludePublicHolidays = Session.ExcludePublicHolidaysFromLeave;

        var employeeTask   = EmployeeService.GetEmployeeAsync(CompanyId, EmployeeId);
        var balanceTask    = LeaveService.GetEmployeeLeaveBalanceAsync(CompanyId, EmployeeId);
        var requestsTask   = LeaveService.ListLeaveRequestsAsync(CompanyId, EmployeeId);
        var tasksTask      = TaskService.GetMyTasksAsync(CompanyId);
        var sicknessTask   = SicknessService.GetMySicknessRecordsAsync(CompanyId, EmployeeId);
        // Self-scoped endpoint (employees/me/probation-status) — the HR-only
        // GetProbationRecordByEmployee ("probation:manage") 403s for a real employee viewing
        // their own profile, which used to be silently swallowed by a blanket catch{}.
        var probationTask  = ProbationService.GetMyProbationStatusAsync(CompanyId);
        var onboardingTask = OnboardingService.GetMyOnboardingStatusAsync(CompanyId);
        var holidaysTask   = PublicHolidayService.ListAsync(CompanyId);
        var compensationTask = Session.DisplaySalaryOnEmployeeProfile
            ? CompensationService.GetCurrentCompensationAsync(CompanyId, EmployeeId)
            : Task.FromResult<CurrentCompensationModel?>(null);

        await Task.WhenAll(employeeTask, balanceTask, requestsTask, tasksTask, sicknessTask, probationTask, onboardingTask, holidaysTask, compensationTask);

        _employee = await employeeTask;
        _probationStatus = await probationTask;
        _onboardingStatus = await onboardingTask;
        _currentCompensation = await compensationTask;
        _publicHolidays = (await holidaysTask)?.Items.Select(h => h.Date).ToList() ?? [];

        ApplyLeaveData(await balanceTask, await requestsTask);

        var tasks = await tasksTask;
        if (tasks is not null)
            _openTaskCount = tasks.Items.Count(t => t.Status is "Open" or "InProgress");

        ApplySicknessData(await sicknessTask);

        _loading = false;
    }

    private void ApplyLeaveData(LeaveBalanceResponse? balance, LeaveRequestListResponse? requests)
    {
        if (balance is not null)
        {
            _allBalances = balance.Balances;
            var annual = balance.Balances.FirstOrDefault(b => b.LeaveTypeCode == "ANNUAL");
            _annualLeaveRemaining = annual?.RemainingDays;
        }

        if (requests is not null)
        {
            var today = DateOnly.FromDateTime(DateTime.UtcNow);
            _pendingLeaveCount = requests.Items.Count(r => r.Status == "Pending");
            _upcomingLeave = requests.Items
                .Where(r => r.Status == "Approved" && r.StartDate >= today)
                .OrderBy(r => r.StartDate)
                .ToList();
        }
    }

    private void ApplySicknessData(ListEmployeeSicknessRecordsResponseModel? sickness)
    {
        if (sickness is null) return;

        // Open/ongoing records have no TotalDays yet, so only completed records are summed.
        var completedDays = sickness.Records
            .Where(r => r.TotalDays.HasValue)
            .Sum(r => r.TotalDays!.Value);
        _sicknessDays = sickness.Records.Count == 0 ? null : completedDays;
    }

    private async Task OnLeaveSubmittedAsync()
    {
        _showRequestLeaveForm = false;

        var balanceTask  = LeaveService.GetEmployeeLeaveBalanceAsync(CompanyId, EmployeeId);
        var requestsTask = LeaveService.ListLeaveRequestsAsync(CompanyId, EmployeeId);
        await Task.WhenAll(balanceTask, requestsTask);
        ApplyLeaveData(await balanceTask, await requestsTask);
    }

    private async Task OnSicknessRecordedAsync()
    {
        _showRecordSicknessDialog = false;
        ApplySicknessData(await SicknessService.GetMySicknessRecordsAsync(CompanyId, EmployeeId));
    }

    private static string LengthOfService(DateOnly startDate)
    {
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        var years = today.Year - startDate.Year;
        var months = today.Month - startDate.Month;
        if (months < 0) { years--; months += 12; }
        if (today.Day < startDate.Day && months > 0) months--;

        return (years, months) switch
        {
            (> 0, > 0) => $"{years} yr {months} mo",
            (> 0, _)   => $"{years} yr",
            (_, > 0)   => $"{months} mo",
            _          => "< 1 month"
        };
    }

    private static string FormatDays(decimal? days)
    {
        var value = days ?? 0m;
        return $"{value:0.##} {(value == 1m ? "day" : "days")}";
    }

    private static string FormatDateRange(DateOnly start, string startPart, DateOnly end, string endPart)
    {
        var startStr = startPart == "FullDay" ? start.ToString("d MMM") : $"{start:d MMM} ({startPart})";
        var endStr   = endPart   == "FullDay" ? end.ToString("d MMM yyyy") : $"{end:d MMM yyyy} ({endPart})";
        return start == end ? endStr : $"{startStr} – {endStr}";
    }

    private static string StatusDisplayName(string status) => status switch
    {
        "Active"         => "Active",
        "Suspended"      => "Suspended",
        "Leaving"        => "Leaving",
        "FormerEmployee" => "Former Employee",
        _                => status
    };

    private string WorkingPatternSummary()
    {
        var workingDays = _employee!.WorkingDaysOverride ?? (WorkingDays)Session.WorkingDays;
        var hoursPerDay = _employee.HoursPerDayOverride ?? Session.HoursPerDay;

        return WorkingPatternFormatter.Summarize(workingDays, hoursPerDay);
    }

    private static string ProbationStatusBadgeClass(string status) => status switch
    {
        "Active"    => "bg-primary",
        "ReviewDue" => "bg-warning text-dark",
        "Extended"  => "bg-info text-dark",
        "Passed"    => "bg-success",
        "Failed"    => "bg-danger",
        _           => "bg-secondary"
    };

    private static string ProbationStatusLabel(string status) => status switch
    {
        "ReviewDue" => "Review Due",
        _           => status
    };

    private int OnboardingPercentComplete() =>
        _onboardingStatus is { TotalTasks: > 0 }
            ? (int)Math.Round(_onboardingStatus.CompletedTasks * 100m / _onboardingStatus.TotalTasks)
            : 0;

    private string SalarySummary() =>
        _currentCompensation is not null
            ? $"{_currentCompensation.Salary.ToString("C2", CultureInfo.GetCultureInfo(Session.Locale))} per {SalaryPeriodLabel(_currentCompensation.SalaryType)}"
            : "—";

    private static string SalaryPeriodLabel(string salaryType) => salaryType switch
    {
        "Hourly" => "hour",
        "Daily"  => "day",
        _        => "year"
    };
}
