@using System.ComponentModel.DataAnnotations
@inject DocumentService DocumentService

<SfDialog @bind-Visible="_visible" IsModal="true" Width="540px" ShowCloseIcon="true">
    <DialogEvents Closed="OnDialogClosed" />
    <DialogTemplates>
        <Header>Upload @_request?.DocumentTypeName</Header>
        <Content>
            @if (_error is not null)
            {
                <div class="alert alert-danger alert-dismissible mb-3">
                    @_error
                    <button type="button" class="btn-close" @onclick="@(() => _error = null)"></button>
                </div>
            }
            <EditForm EditContext="_editContext">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Title <span class="text-danger">*</span></label>
                        <HrTextBox @bind-Value="_model.Title" Placeholder="Document title" />
                        <ValidationMessage For="@(() => _model.Title)" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Issue Date</label>
                        <SfDatePicker TValue="DateOnly?"
                                      @bind-Value="_model.IssueDate"
                                      Format="dd/MM/yyyy"
                                      Placeholder="dd/mm/yyyy"
                                      ShowClearButton="true" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Expiry Date</label>
                        <SfDatePicker TValue="DateOnly?"
                                      @bind-Value="_model.ExpiryDate"
                                      Format="dd/MM/yyyy"
                                      Placeholder="dd/mm/yyyy"
                                      ShowClearButton="true" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">File <span class="text-danger">*</span></label>
                        <InputFile class="form-control" OnChange="OnFileSelected"
                                   accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
                        <div class="form-text">Accepted: PDF, Word, JPG, PNG. Max 20 MB.</div>
                        @if (_fileError is not null)
                        {
                            <div class="text-danger small mt-1">@_fileError</div>
                        }
                    </div>
                </div>
            </EditForm>
        </Content>
        <FooterTemplate>
            <SfButton IsPrimary="true" OnClick="SubmitAsync" Disabled="_uploading">
                @if (_uploading)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                Upload
            </SfButton>
            <SfButton OnClick="Cancel">Cancel</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter, EditorRequired] public Guid CompanyId  { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId { get; set; }
    [Parameter]                 public bool IsOpen     { get; set; }
    [Parameter] public EventCallback OnUploaded  { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    private DocumentRequestListItem? _request;
    private bool _visible;

    private readonly RequestedDocumentUploadFormModel _model = new();
    private EditContext _editContext = default!;
    private IBrowserFile? _selectedFile;
    private string? _fileError;
    private bool    _uploading;
    private string? _error;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);
    }

    private sealed class RequestedDocumentUploadFormModel
    {
        [Required(ErrorMessage = "Title is required.")]
        [MaxLength(200)]
        public string? Title { get; set; }

        public DateOnly? IssueDate { get; set; }
        public DateOnly? ExpiryDate { get; set; }
    }

    public void Open(DocumentRequestListItem request)
    {
        _request       = request;
        _model.Title    = request.DocumentTypeName;
        _model.IssueDate = null;
        _model.ExpiryDate = null;
        _editContext   = new EditContext(_model);
        _selectedFile  = null;
        _fileError     = null;
        _error         = null;
        _visible       = true;
        StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        if (!IsOpen && _visible)
            _visible = false;
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _fileError = null;
    }

    private async Task SubmitAsync()
    {
        if (_request is null) return;

        _error = null;
        _fileError = null;

        var valid = _editContext.Validate();
        if (_selectedFile is null)
        {
            _fileError = "Please select a file.";
            valid = false;
        }

        if (!valid) return;

        _uploading = true;
        _error = await DocumentService.UploadRequestedDocumentAsync(
            CompanyId, EmployeeId, _request.Id,
            _model.Title!.Trim(), description: null, _model.IssueDate, _model.ExpiryDate,
            _selectedFile!);
        _uploading = false;

        if (_error is not null) return;

        _visible = false;
        await OnUploaded.InvokeAsync();
    }

    private async Task Cancel()
    {
        _visible = false;
        await OnCancelled.InvokeAsync();
    }

    private async Task OnDialogClosed() => await OnCancelled.InvokeAsync();
}
