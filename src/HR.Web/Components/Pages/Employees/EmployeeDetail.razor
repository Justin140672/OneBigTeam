@page "/companies/{CompanyId:guid}/employees/{Id:guid}"
@rendermode InteractiveServer
@using HR.Web.Models
@using HR.Web.Services
@inject EmployeeService EmployeeService

<PageTitle>@(_employee is not null ? $"{_employee.FirstName} {_employee.LastName}" : "Employee")</PageTitle>

<div class="container py-4">
    @if (_loading)
    {
        <div class="d-flex align-items-center gap-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Loading…</span>
        </div>
    }
    else if (_employee is null)
    {
        <div class="alert alert-danger">Employee not found.</div>
    }
    else
    {
        <div class="d-flex align-items-center gap-3 mb-1">
            <h1 class="mb-0">@_employee.FirstName @_employee.LastName</h1>
            <span class="badge @StatusBadgeClass(_employee.Status)">@_employee.Status</span>
        </div>

        @if (_employee.PositionProfileId.HasValue)
        {
            <p class="text-muted mb-4">@_employee.PositionProfileId
                @if (_employee.DepartmentId.HasValue)
                {
                    <span> · @_employee.DepartmentId</span>
                }
            </p>
        }

        @if (!string.IsNullOrEmpty(_globalError))
        {
            <div class="alert alert-danger">@_globalError</div>
        }

        <ul class="nav nav-tabs mb-4" role="tablist">
            @foreach (var tab in _tabs)
            {
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(tab == _activeTab ? "active" : "")" type="button" role="tab"
                            @onclick="() => _activeTab = tab">@tab</button>
                </li>
            }
        </ul>

        <div class="tab-content">
            @if (_activeTab == "Overview")
            {
                <EmployeeOverviewTab Employee="_employee" />
            }
            else if (_activeTab == "Profile")
            {
                <EmployeeProfileTab Model="_profileModel" />
            }
        </div>

        @if (_activeTab == "Profile")
        {
            <div class="mt-4">
                @if (!string.IsNullOrEmpty(_successMsg))
                {
                    <div class="alert alert-success py-2 mb-3">@_successMsg</div>
                }
                <SfButton IsPrimary="true" Disabled="@_saving" OnClick="SaveProfile">
                    @(_saving ? "Saving…" : "Save")
                </SfButton>
            </div>
        }
    }
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid Id { get; set; }

    private GetEmployeeResponse? _employee;
    private bool _loading = true;
    private string? _globalError;
    private string? _successMsg;
    private bool _saving;

    private readonly string[] _tabs = ["Overview", "Profile"];
    private string _activeTab = "Overview";

    private readonly EmployeeProfileEditModel _profileModel = new();

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _employee = await EmployeeService.GetEmployeeAsync(CompanyId, Id);

        if (_employee is not null)
        {
            _profileModel.FirstName = _employee.FirstName;
            _profileModel.LastName = _employee.LastName;
            _profileModel.WorkEmail = _employee.WorkEmail;
            _profileModel.PersonalEmail = _employee.PersonalEmail;
            _profileModel.StartDate = _employee.StartDate;
        }

        _loading = false;
    }

    private async Task SaveProfile()
    {
        _saving = true;
        _globalError = null;
        _successMsg = null;

        var request = new UpdateEmployeeProfileRequest(
            CompanyId,
            Id,
            _profileModel.FirstName,
            _profileModel.LastName,
            _profileModel.WorkEmail,
            _profileModel.PersonalEmail,
            _profileModel.StartDate);

        var (success, conflictMessage) = await EmployeeService.UpdateEmployeeProfileAsync(CompanyId, Id, request);

        if (success)
        {
            _employee = await EmployeeService.GetEmployeeAsync(CompanyId, Id);
            _successMsg = "Profile saved.";
        }
        else
        {
            _globalError = conflictMessage;
        }

        _saving = false;
    }

    private static string StatusBadgeClass(string status) => status switch
    {
        "Active"     => "bg-success",
        "OnLeave"    => "bg-warning text-dark",
        "Suspended"  => "bg-danger",
        "Terminated" => "bg-secondary",
        _            => "bg-light text-dark"
    };
}
