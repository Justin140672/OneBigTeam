@using System.ComponentModel.DataAnnotations
@using HR.Web.Models
@using HR.Infrastructure.Abstractions
@inject EmployeeService EmployeeService

<SfDialog Visible="IsOpen" IsModal="true" Width="656px" ShowCloseIcon="false">
    <DialogTemplates>
        <Header>Start Leaving Process</Header>
        <Content>
            <HrStepper Steps="_stepLabels" CurrentStep="_step" AriaLabel="Start leaving process progress" />

            <EditForm EditContext="_editContext">
                <DataAnnotationsValidator />

                @if (_step == 1)
                {
                    <div class="mb-3">
                        <label class="form-label">Resignation Received Date <span class="text-danger">*</span></label>
                        <SfDatePicker TValue="DateOnly?"
                                      @bind-Value="_model.ResignationReceivedDate"
                                      Format="dd/MM/yyyy"
                                      Placeholder="dd/mm/yyyy" />
                        <ValidationMessage For="@(() => _model.ResignationReceivedDate)" />
                    </div>
                }
                else if (_step == 2)
                {
                    <p class="text-muted small">
                        Proposed based on this employee's effective notice period
                        (@EffectiveNoticePeriodLength @NoticePeriodUnitLabel(EffectiveNoticePeriodUnit)). Amend if needed.
                    </p>
                    <div class="mb-3">
                        <label class="form-label">Leaving Date <span class="text-danger">*</span></label>
                        <SfDatePicker TValue="DateOnly?"
                                      Value="_model.LeavingDate"
                                      ValueChanged="OnLeavingDateChanged"
                                      Format="dd/MM/yyyy"
                                      Placeholder="dd/mm/yyyy" />
                        <ValidationMessage For="@(() => _model.LeavingDate)" />
                    </div>
                    @if (IsBackdated(_model.LeavingDate))
                    {
                        <div class="mb-3">
                            <SfCheckBox TChecked="bool"
                                        Label="This leaving date is in the past. Confirming will immediately finalise this employee's departure (status will become Former Employee)."
                                        Checked="@_model.ConfirmBackdatedLeavingDate"
                                        CheckedChanged="@((bool v) => _model.ConfirmBackdatedLeavingDate = v)" />
                            <ValidationMessage For="@(() => _model.ConfirmBackdatedLeavingDate)" />
                        </div>
                    }
                }
                else if (_step == 3)
                {
                    <div class="mb-3">
                        <label class="form-label">Last Working Day <span class="text-danger">*</span></label>
                        <SfDatePicker TValue="DateOnly?"
                                      @bind-Value="_model.LastWorkingDay"
                                      Format="dd/MM/yyyy"
                                      Placeholder="dd/mm/yyyy" />
                        <ValidationMessage For="@(() => _model.LastWorkingDay)" />
                    </div>
                }
                else if (_step == 4)
                {
                    <div class="mb-3">
                        <label class="form-label">Leaving Reason <span class="text-danger">*</span></label>
                        <SfDropDownList TValue="string"
                                        TItem="LeavingReasonOption"
                                        DataSource="@_leavingReasonOptions"
                                        @bind-Value="_model.LeavingReason"
                                        Placeholder="Select leaving reason">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                        <ValidationMessage For="@(() => _model.LeavingReason)" />
                    </div>
                }
                else if (_step == 5)
                {
                    <p class="text-muted small">
                        Starting offboarding will begin this employee's leaving process: their status will move
                        toward Leaving (or Former Employee immediately, if the leaving date is backdated), an
                        offboarding checklist will become available for HR to work through, and this action can
                        be amended or cancelled later from the Leaving tab if needed.
                    </p>
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted fw-normal">Resignation Received Date</dt>
                        <dd class="col-sm-7">@_model.ResignationReceivedDate?.ToString("dd MMM yyyy")</dd>
                        <dt class="col-sm-5 text-muted fw-normal">Leaving Date</dt>
                        <dd class="col-sm-7">@_model.LeavingDate?.ToString("dd MMM yyyy")</dd>
                        <dt class="col-sm-5 text-muted fw-normal">Last Working Day</dt>
                        <dd class="col-sm-7">@_model.LastWorkingDay?.ToString("dd MMM yyyy")</dd>
                        <dt class="col-sm-5 text-muted fw-normal">Leaving Reason</dt>
                        <dd class="col-sm-7">@EmployeeLeavingTab.LeavingReasonLabel(_model.LeavingReason ?? string.Empty)</dd>
                    </dl>
                }
            </EditForm>

            @if (!string.IsNullOrEmpty(_globalError))
            {
                <div class="alert alert-danger py-2">@_globalError</div>
            }
        </Content>
        <FooterTemplate>
            @if (_step > 1)
            {
                <SfButton Disabled="@_submitting" OnClick="GoBack">Back</SfButton>
            }
            @if (_step < 5)
            {
                <SfButton IsPrimary="true" Disabled="@_submitting" OnClick="GoNext">Next</SfButton>
            }
            else
            {
                <SfButton IsPrimary="true" Disabled="@_submitting" OnClick="ConfirmAsync">
                    @if (_submitting)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    Confirm
                </SfButton>
            }
            <SfButton Disabled="@_submitting" OnClick="CancelAsync">Cancel</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId { get; set; }
    [Parameter, EditorRequired] public NoticePeriodUnit EffectiveNoticePeriodUnit { get; set; }
    [Parameter, EditorRequired] public int EffectiveNoticePeriodLength { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }
    [Parameter] public EventCallback OnCompleted { get; set; }

    private bool _wasOpen;
    private int _step = 1;
    private bool _submitting;
    private string? _globalError;

    private readonly StartLeavingProcessFormModel _model = new();
    private EditContext _editContext = default!;
    private bool _leavingDateManuallyEdited;

    // Maps each wizard step to the model fields validated before advancing past it, so "Next"
    // gates on DataAnnotations/IValidatableObject messages rather than imperative if-checks.
    private static readonly Dictionary<int, string[]> _stepFields = new()
    {
        [1] = [nameof(StartLeavingProcessFormModel.ResignationReceivedDate)],
        [2] = [nameof(StartLeavingProcessFormModel.LeavingDate), nameof(StartLeavingProcessFormModel.ConfirmBackdatedLeavingDate)],
        [3] = [nameof(StartLeavingProcessFormModel.LastWorkingDay)],
        [4] = [nameof(StartLeavingProcessFormModel.LeavingReason)],
    };

    private static readonly List<string> _stepLabels =
        ["Resignation Date", "Leaving Date", "Last Working Day", "Reason", "Confirm"];

    // No clear button and no "None" item, per this codebase's convention for required dropdowns
    // (see Model.Gender in EmployeeEdit.razor) — the empty default simply shows the Placeholder
    // until the user picks one.
    private static readonly LeavingReasonOption[] _leavingReasonOptions =
    [
        new("Resignation",     EmployeeLeavingTab.LeavingReasonLabel("Resignation")),
        new("Redundancy",      EmployeeLeavingTab.LeavingReasonLabel("Redundancy")),
        new("Dismissal",       EmployeeLeavingTab.LeavingReasonLabel("Dismissal")),
        new("Retirement",      EmployeeLeavingTab.LeavingReasonLabel("Retirement")),
        new("EndOfContract",   EmployeeLeavingTab.LeavingReasonLabel("EndOfContract")),
        new("MutualAgreement", EmployeeLeavingTab.LeavingReasonLabel("MutualAgreement")),
        new("Other",           EmployeeLeavingTab.LeavingReasonLabel("Other")),
    ];

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);
    }

    protected override void OnParametersSet()
    {
        if (IsOpen && !_wasOpen)
            ResetState();

        _wasOpen = IsOpen;
    }

    private void ResetState()
    {
        _step = 1;
        _submitting = false;
        _globalError = null;
        _leavingDateManuallyEdited = false;
        _model.ResignationReceivedDate = null;
        _model.LeavingDate = null;
        _model.ConfirmBackdatedLeavingDate = false;
        _model.LastWorkingDay = null;
        _model.LeavingReason = null;
        _editContext = new EditContext(_model);
    }

    private void OnLeavingDateChanged(DateOnly? value)
    {
        _model.LeavingDate = value;
        _leavingDateManuallyEdited = true;

        // Don't let a stale confirmation silently carry over once the date no longer needs it.
        if (!IsBackdated(_model.LeavingDate))
            _model.ConfirmBackdatedLeavingDate = false;
    }

    private static bool IsBackdated(DateOnly? date) => date is not null && date < DateOnly.FromDateTime(DateTime.Today);

    private void GoNext()
    {
        _globalError = null;

        // Auto-calculate a proposed leaving date the first time step 1 is completed (or any time
        // it's revisited without the user having amended it themselves) — step 2's own editable
        // picker lets HR override this before continuing.
        if (_step == 1 && _model.ResignationReceivedDate is { } received && !_leavingDateManuallyEdited)
            _model.LeavingDate = ComputeProposedLeavingDate(received);

        _editContext.Validate();

        if (_stepFields.TryGetValue(_step, out var fields))
        {
            var firstMessage = fields
                .SelectMany(f => _editContext.GetValidationMessages(_editContext.Field(f)))
                .FirstOrDefault();

            if (firstMessage is not null)
            {
                _globalError = firstMessage;
                return;
            }
        }

        _step++;
    }

    private void GoBack()
    {
        _globalError = null;
        if (_step > 1)
            _step--;
    }

    private DateOnly ComputeProposedLeavingDate(DateOnly resignationDate) => EffectiveNoticePeriodUnit switch
    {
        NoticePeriodUnit.Weeks  => resignationDate.AddDays(EffectiveNoticePeriodLength * 7),
        NoticePeriodUnit.Months => resignationDate.AddMonths(EffectiveNoticePeriodLength),
        _                       => resignationDate
    };

    private static string NoticePeriodUnitLabel(NoticePeriodUnit unit) => unit switch
    {
        NoticePeriodUnit.Weeks  => "Weeks",
        NoticePeriodUnit.Months => "Months",
        _                       => EnumDisplay.Humanize(unit)
    };

    private async Task ConfirmAsync()
    {
        _globalError = null;

        if (!_editContext.Validate())
        {
            _globalError = _editContext.GetValidationMessages().FirstOrDefault()
                ?? "Please correct the highlighted fields below.";
            return;
        }

        _submitting = true;

        var request = new StartLeavingProcessRequest(
            CompanyId,
            EmployeeId,
            _model.ResignationReceivedDate!.Value,
            _model.LeavingDate!.Value,
            _model.LastWorkingDay!.Value,
            _model.LeavingReason!,
            _model.ConfirmBackdatedLeavingDate);

        var (result, error) = await EmployeeService.StartLeavingProcessAsync(CompanyId, EmployeeId, request);

        _submitting = false;

        if (result is null)
        {
            // Left on the confirmation step (rather than closing) so the user can go Back and
            // fix whatever the server rejected, or just retry — matches this codebase's pattern
            // of surfacing server errors inline instead of dismissing an in-progress dialog.
            _globalError = error ?? "Failed to start the leaving process.";
            return;
        }

        await OnCompleted.InvokeAsync();
    }

    private async Task CancelAsync()
    {
        await OnCancelled.InvokeAsync();
    }

    private sealed record LeavingReasonOption(string Value, string Label);

    private sealed class StartLeavingProcessFormModel : IValidatableObject
    {
        [Required(ErrorMessage = "Please select the resignation received date.")]
        public DateOnly? ResignationReceivedDate { get; set; }

        [Required(ErrorMessage = "Please select a leaving date.")]
        public DateOnly? LeavingDate { get; set; }

        public bool ConfirmBackdatedLeavingDate { get; set; }

        [Required(ErrorMessage = "Please select the last working day.")]
        public DateOnly? LastWorkingDay { get; set; }

        [Required(ErrorMessage = "Please select a leaving reason.")]
        public string? LeavingReason { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (LeavingDate is not null && ResignationReceivedDate is not null && LeavingDate < ResignationReceivedDate)
                yield return new ValidationResult(
                    "Leaving date must be on or after the resignation received date.",
                    [nameof(LeavingDate)]);

            if (LeavingDate is not null
                && LeavingDate < DateOnly.FromDateTime(DateTime.Today)
                && !ConfirmBackdatedLeavingDate)
                yield return new ValidationResult(
                    "Please confirm you want to backdate and finalise this employee's departure.",
                    [nameof(ConfirmBackdatedLeavingDate)]);

            if (LastWorkingDay is not null && LeavingDate is not null && LastWorkingDay > LeavingDate)
                yield return new ValidationResult(
                    "Last working day must be on or before the leaving date.",
                    [nameof(LastWorkingDay)]);
        }
    }
}
