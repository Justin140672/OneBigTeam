@inject AssetService AssetService
@inject AppSession Session
@using System.ComponentModel.DataAnnotations
@using HR.Web.Components.Pages.Assets

@if (_loading)
{
    <HrLoadingIndicator Label="Loading assets…" />
}
else
{
    <div class="mb-3 d-flex gap-2">
        <SfButton IsPrimary="true" OnClick="OpenAssignDialog">Assign Asset</SfButton>
        <SfButton OnClick="OpenReturnDialog" Disabled="@(!_assets.Any(a => a.IsAcknowledged))">Return Asset</SfButton>
    </div>

    @if (!string.IsNullOrEmpty(_success))
    {
        <div class="alert alert-success mb-3">@_success</div>
    }

    <HrGrid TValue="EmployeeAssetItem"
            DataSource="@_assets"
            AllowFiltering="false"
            AllowPaging="false"
            AllowSorting="false"
            data-testid="employee-assets-grid">
        <GridColumns>
            <GridColumn HeaderText="Asset">
                <Template>
                    @{
                        var item = (EmployeeAssetItem)context;
                    }
                    <div>
                        <span class="fw-medium asset-title-link" role="button" @onclick="() => ViewAsset(item.AssetId)">@item.AssetNumber</span>
                        <span class="text-muted ms-2">@item.Name</span>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(EmployeeAssetItem.CategoryName)" HeaderText="Category" Width="180" />
            <GridColumn Field="@nameof(EmployeeAssetItem.AssignedAt)" HeaderText="Assigned" Width="140" Format="d" />
            <GridColumn HeaderText="Acknowledgement" Width="180">
                <Template>
                    @{
                        var item = (EmployeeAssetItem)context;
                    }
                    @if (item.IsAcknowledged)
                    {
                        <span class="badge text-bg-success">Acknowledged</span>
                    }
                    else
                    {
                        <span class="badge text-bg-warning">Awaiting acknowledgement</span>
                    }
                </Template>
            </GridColumn>
            <GridColumn HeaderText="" Width="90" AllowSorting="false" AllowFiltering="false" TextAlign="TextAlign.Right">
                <Template>
                    @{
                        var item = (EmployeeAssetItem)context;
                    }
                    <SfButton CssClass="e-outline e-small" title="View" OnClick="() => ViewAsset(item.AssetId)">View</SfButton>
                </Template>
            </GridColumn>
        </GridColumns>
    </HrGrid>
}

@if (_showAssignDialog)
{
    <SfDialog Width="480px" IsModal="true" @bind-Visible="_showAssignDialog" Header="Assign Asset">
        <DialogTemplates>
            <Content>
                <EditForm EditContext="_assignEditContext">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label">Available Asset <span class="text-danger">*</span></label>
                        <SfDropDownList TValue="Guid?"
                                       TItem="AvailableAssetItem"
                                       DataSource="@_availableAssets"
                                       @bind-Value="_assignModel.AssetId"
                                       Placeholder="Select an asset"
                                       AllowFiltering="true">
                            <DropDownListFieldSettings Value="Id" Text="AssetNumber" />
                            <DropDownListTemplates TItem="AvailableAssetItem">
                                <ItemTemplate Context="ddItem">
                                    @{
                                        var a = (AvailableAssetItem)ddItem;
                                    }
                                    <span><strong>@a.AssetNumber</strong> — @a.Name @(a.Manufacturer is not null ? $"({a.Manufacturer})" : "")</span>
                                </ItemTemplate>
                            </DropDownListTemplates>
                        </SfDropDownList>
                        <ValidationMessage For="@(() => _assignModel.AssetId)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes (optional)</label>
                        <HrTextBox @bind-Value="_assignModel.Notes" Multiline="true" Rows="2" />
                        <ValidationMessage For="@(() => _assignModel.Notes)" />
                    </div>
                    @if (!string.IsNullOrEmpty(_dialogError))
                    {
                        <div class="alert alert-danger py-2">@_dialogError</div>
                    }
                </EditForm>
            </Content>
        </DialogTemplates>
        <DialogButtons>
            <DialogButton Content="Assign" IsPrimary="true" OnClick="ConfirmAssignAsync" />
            <DialogButton Content="Cancel" OnClick="CloseAssignDialog" />
        </DialogButtons>
    </SfDialog>
}

<AssetDetailDialog CompanyId="CompanyId"
                   AssetId="_viewedAssetId"
                   IsOpen="_viewDialogOpen"
                   OnClosed="@(() => _viewDialogOpen = false)" />

@if (_showReturnDialog)
{
    <SfDialog Width="480px" IsModal="true" @bind-Visible="_showReturnDialog" Header="Request Return">
        <DialogTemplates>
            <Content>
                <EditForm EditContext="_returnEditContext">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label">Asset <span class="text-danger">*</span></label>
                        <SfDropDownList TValue="Guid?"
                                       TItem="EmployeeAssetItem"
                                       DataSource="@_returnableAssets"
                                       @bind-Value="_returnModel.AssignmentId"
                                       Placeholder="Select an asset to return"
                                       AllowFiltering="true">
                            <DropDownListFieldSettings Value="Id" Text="AssetNumber" />
                            <DropDownListTemplates TItem="EmployeeAssetItem">
                                <ItemTemplate Context="ddItem">
                                    @{
                                        var a = (EmployeeAssetItem)ddItem;
                                    }
                                    <span><strong>@a.AssetNumber</strong> — @a.Name</span>
                                </ItemTemplate>
                            </DropDownListTemplates>
                        </SfDropDownList>
                        <ValidationMessage For="@(() => _returnModel.AssignmentId)" />
                    </div>
                    @if (!string.IsNullOrEmpty(_returnDialogError))
                    {
                        <div class="alert alert-danger py-2">@_returnDialogError</div>
                    }
                </EditForm>
            </Content>
        </DialogTemplates>
        <DialogButtons>
            <DialogButton Content="Request Return" IsPrimary="true" OnClick="ConfirmReturnAsync" Disabled="@_returnSaving" />
            <DialogButton Content="Cancel" OnClick="CloseReturnDialog" Disabled="@_returnSaving" />
        </DialogButtons>
    </SfDialog>
}

@code {
    [Parameter, EditorRequired] public Guid CompanyId  { get; set; }
    [Parameter, EditorRequired] public Guid EmployeeId { get; set; }

    private List<EmployeeAssetItem> _assets = [];
    private List<AvailableAssetItem> _availableAssets = [];
    private bool _loading = true;
    private string? _success;

    private bool _showAssignDialog;
    private readonly AssignAssetFormModel _assignModel = new();
    private EditContext _assignEditContext = default!;
    private string? _dialogError;

    private Guid? _viewedAssetId;
    private bool _viewDialogOpen;

    private bool _showReturnDialog;
    private readonly ReturnAssetFormModel _returnModel = new();
    private EditContext _returnEditContext = default!;
    private string? _returnDialogError;
    private bool _returnSaving;

    protected override void OnInitialized()
    {
        _assignEditContext = new EditContext(_assignModel);
        _returnEditContext = new EditContext(_returnModel);
    }

    private IEnumerable<EmployeeAssetItem> _returnableAssets => _assets.Where(a => a.IsAcknowledged);

    protected override async Task OnInitializedAsync() => await Session.InitialiseAsync();

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = _assets.Count == 0;
        _assets = await AssetService.GetEmployeeAssignmentsAsync(CompanyId, EmployeeId) ?? [];
        _loading = false;
    }

    private void ViewAsset(Guid assetId)
    {
        _viewedAssetId = assetId;
        _viewDialogOpen = true;
    }

    private async Task OpenAssignDialog()
    {
        _assignModel.AssetId = null;
        _assignModel.Notes = null;
        _assignEditContext = new EditContext(_assignModel);
        _dialogError = null;
        _availableAssets = await AssetService.ListAvailableAssetsAsync(CompanyId) ?? [];
        _showAssignDialog = true;
    }

    private void CloseAssignDialog() => _showAssignDialog = false;

    private async Task ConfirmAssignAsync()
    {
        if (!_assignEditContext.Validate())
            return;

        var assignedBy = Session.EmployeeId ?? Session.UserId;
        var ok = await AssetService.AssignAssetAsync(
            CompanyId, _assignModel.AssetId!.Value, EmployeeId, assignedBy, _assignModel.Notes);

        if (!ok)
        {
            _dialogError = "Failed to assign asset. It may already be assigned or unavailable.";
            return;
        }

        _showAssignDialog = false;
        _success = "Asset assigned successfully.";
        await LoadAsync();
    }

    private void OpenReturnDialog()
    {
        _returnModel.AssignmentId = null;
        _returnEditContext = new EditContext(_returnModel);
        _returnDialogError = null;
        _showReturnDialog = true;
    }

    private void CloseReturnDialog() => _showReturnDialog = false;

    private async Task ConfirmReturnAsync()
    {
        // Without this guard, RequestAssetReturnHandler has no idempotency check against the
        // assignment (only that it's still active, which stays true until the return is actually
        // processed later) — a double-click here creates two separate "Return asset" tasks for the
        // same assignment.
        if (_returnSaving)
            return;

        if (!_returnEditContext.Validate())
            return;

        _returnDialogError = null;
        _returnSaving = true;

        try
        {
            var requestedBy = Session.EmployeeId ?? Session.UserId;
            var ok = await AssetService.RequestReturnAsync(CompanyId, _returnModel.AssignmentId!.Value, requestedBy);

            if (!ok)
            {
                _returnDialogError = "Failed to request return. The return may already have been requested.";
                return;
            }

            _showReturnDialog = false;
            _success = "Return requested successfully.";
            await LoadAsync();
        }
        finally
        {
            _returnSaving = false;
        }
    }

    private sealed class AssignAssetFormModel
    {
        [Required(ErrorMessage = "Please select an asset.")]
        public Guid? AssetId { get; set; }

        [MaxLength(2000)]
        public string? Notes { get; set; }
    }

    private sealed class ReturnAssetFormModel
    {
        [Required(ErrorMessage = "Please select an asset.")]
        public Guid? AssignmentId { get; set; }
    }
}
