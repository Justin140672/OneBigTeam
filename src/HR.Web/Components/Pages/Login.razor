@page "/login"
@layout HR.Web.Components.Layout.LoginLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject DevAuthService DevAuth
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Sign in — One Big Team</PageTitle>

<div class="login-card">
    <div class="login-brand">
        <img src="/images/logo.png" alt="One Big Team" class="login-logo-img" />
    </div>

    <h1 class="login-heading">Sign in with your email</h1>
    <p class="login-subheading">Enter your email and password to access your account.</p>

    <EditForm Model="_form" OnValidSubmit="SubmitAsync" FormName="login">
        <DataAnnotationsValidator />

        @if (_error is not null)
        {
            <div class="login-error">
                <i class="fa-solid fa-circle-exclamation"></i> @_error
            </div>
        }

        <div class="login-field">
            <label class="login-label">Email</label>
            <SfTextBox @bind-Value="_form.Email"
                       Placeholder="you@example.com"
                       Type="InputType.Email" />
            <ValidationMessage For="() => _form.Email" class="login-validation" />
        </div>

        <div class="login-field">
            <label class="login-label">Password</label>
            <SfTextBox @bind-Value="_form.Password"
                       Placeholder="••••••••"
                       Type="InputType.Password" />
            <ValidationMessage For="() => _form.Password" class="login-validation" />
        </div>

        <SfButton IsPrimary="true"
                  Type="ButtonType.Submit"
                  Disabled="@_busy"
                  CssClass="login-btn">
            @if (_busy)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            }
            Login
        </SfButton>
    </EditForm>
</div>

@code {
    private readonly LoginForm _form = new();
    private string? _error;
    private bool _busy;

    private async Task SubmitAsync()
    {
        _error = null;
        _busy  = true;

        var personas = await DevAuth.GetPersonasAsync();
        var match    = personas.FirstOrDefault(p =>
            string.Equals(p.Email, _form.Email, StringComparison.OrdinalIgnoreCase));

        if (match is null || _form.Password != "password")
        {
            _error = "Invalid email or password.";
            _busy  = false;
            return;
        }

        var session = await DevAuth.SwitchAsync(match.UserId);
        if (session is null)
        {
            _error = "Sign in failed. Please try again.";
            _busy  = false;
            return;
        }

        // Genuine hard browser navigation via app.js's hardNavigate — see MainLayout.razor's
        // OnPersonaSwitchAsync remarks for why NavigationManager.NavigateTo(forceLoad: true) isn't
        // reliable enough here.
        var query = $"accessToken={Uri.EscapeDataString(session.AccessToken)}&expiresIn={session.ExpiresIn}";
        await JS.InvokeVoidAsync("hardNavigate", $"/dev/persona-cookie?{query}");
    }

    private sealed class LoginForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;
    }
}
