@page "/login"
@layout HR.Web.Components.Layout.LoginLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject AuthService Auth
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject HR.Web.Services.AuthHandoffStore HandoffStore

<PageTitle>Sign in — One Big Team</PageTitle>

<div class="login-card">
    <div class="login-brand">
        <img src="/images/logo.png" alt="One Big Team" class="login-logo-img" />
    </div>

    <h1 class="login-heading">Sign in with your email</h1>
    <p class="login-subheading">Enter your email and password to access your account.</p>

    <EditForm Model="_form" OnValidSubmit="SubmitAsync" FormName="login">
        <DataAnnotationsValidator />

        @if (Verified && _error is null)
        {
            <div class="login-success" data-testid="verified-message">
                <i class="fa-solid fa-circle-check"></i> Your account is verified. Sign in to get started.
            </div>
        }

        @if (PasswordReset && _error is null)
        {
            <div class="login-success" data-testid="password-reset-message">
                <i class="fa-solid fa-circle-check"></i> Your password has been updated. You can now sign in with your new password.
            </div>
        }

        @if (_error is not null)
        {
            <div class="login-error">
                <i class="fa-solid fa-circle-exclamation"></i> @_error
            </div>
        }

        <div class="login-field">
            <label class="login-label">Email</label>
            <HrTextBox @bind-Value="_form.Email"
                       Placeholder="you@example.com"
                       Type="InputType.Email"
                       Input="@(() => _error = null)" />
            <ValidationMessage For="() => _form.Email" class="login-validation" />
        </div>

        <div class="login-field">
            <div class="login-password-row">
                <label class="login-label">Password</label>
                <a href="/forgot-password" class="login-forgot-link" data-testid="forgot-password-link">Forgot password?</a>
            </div>
            <div class="login-password-field">
                <HrTextBox @bind-Value="_form.Password"
                           Placeholder="••••••••"
                           Type="@(_showPassword ? InputType.Text : InputType.Password)"
                           Input="@(() => _error = null)" />
                <button type="button"
                        class="login-password-toggle"
                        aria-pressed="@_showPassword.ToString().ToLowerInvariant()"
                        aria-label="@(_showPassword ? "Hide password" : "Show password")"
                        @onclick="() => _showPassword = !_showPassword">
                    @(_showPassword ? "Hide" : "Show")
                </button>
            </div>
            <ValidationMessage For="() => _form.Password" class="login-validation" />
        </div>

        <SfButton IsPrimary="true"
                  Type="ButtonType.Submit"
                  Disabled="@_busy"
                  CssClass="login-btn">
            @if (_busy)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            }
            Login
        </SfButton>
    </EditForm>

    <nav class="login-legal" aria-label="Legal and policies" data-testid="login-legal">
        <a href="@($"{MarketingBaseUrl}/privacy-policy")">Privacy Policy</a>
        <a href="@($"{MarketingBaseUrl}/acceptable-use-policy")">Acceptable Use</a>
        <a href="@($"{MarketingBaseUrl}/cookie-policy")">Cookies and browser storage</a>
        <a href="@($"{MarketingBaseUrl}/terms-of-service")">Terms of Service</a>
        <a href="@($"{MarketingBaseUrl}/security")">Security</a>
        <a href="@MarketingBaseUrl">Return to the One Big Team website</a>
    </nav>
</div>

@code {
    private string MarketingBaseUrl => HR.Web.Services.MarketingSiteUrl.Resolve(Configuration);

    [SupplyParameterFromQuery(Name = "verified")]
    public bool Verified { get; set; }

    [SupplyParameterFromQuery(Name = "reset")]
    public bool PasswordReset { get; set; }

    private readonly LoginForm _form = new();
    private string? _error;
    private bool _busy;
    private bool _showPassword;

    private async Task SubmitAsync()
    {
        _error = null;
        _busy  = true;

        var (session, error) = await Auth.LoginAsync(_form.Email, _form.Password);
        if (session is null)
        {
            _error = error;
            _busy  = false;
            return;
        }

        // The session never touches the URL: it is stashed server-side and handed to the
        // cookie-setting hop via an opaque, single-use code (see AuthHandoffStore). Genuine hard
        // browser navigation via app.js's hardNavigate guarantees a fresh circuit that will read
        // the session cookie /login-complete sets.
        var code = HandoffStore.Issue(new AuthHandoffStore.Session(
            session.AccessToken, session.RefreshToken, session.ExpiresIn));
        await JS.InvokeVoidAsync("hardNavigate", $"/login-complete?code={Uri.EscapeDataString(code)}");
    }

    private sealed class LoginForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;
    }
}
