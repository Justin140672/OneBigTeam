@page "/verify-email-error"
@layout HR.Web.Components.Layout.LoginLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<PageTitle>Verification link invalid — One Big Team</PageTitle>

<div class="login-card">
    <div class="login-brand">
        <img src="/images/logo.png" alt="One Big Team" class="login-logo-img" />
    </div>

    <h1 class="login-heading">This verification link is invalid or has expired</h1>
    <p class="login-subheading">
        Verification links only work once and expire after a while. Enter your email below and
        we'll send you a fresh one.
    </p>

    <EditForm Model="_form" OnValidSubmit="SubmitAsync" FormName="verify-email-error">
        <DataAnnotationsValidator />

        <div class="login-field">
            <label class="login-label">Email</label>
            <HrTextBox @bind-Value="_form.Email"
                       Placeholder="you@example.com"
                       Type="InputType.Email" />
            <ValidationMessage For="() => _form.Email" class="login-validation" />
        </div>

        <SfButton IsPrimary="true"
                  Type="ButtonType.Submit"
                  CssClass="login-btn">
            Resend verification email
        </SfButton>
    </EditForm>
</div>

@code {
    private readonly ResendForm _form = new();

    private void SubmitAsync()
    {
        // Aspire's own service-discovery config keys (see AppHost.cs's "web.WithReference(marketing)")
        // — not the old hardcoded "Marketing:BaseUrl" appsettings fallback, which never tracked
        // marketing's actual (dynamically-assigned per launch) URL and was frequently wrong,
        // surfacing as ERR_CONNECTION_REFUSED on this exact navigation. Matches the
        // "services:web:https:0"/"...:http:0" pattern already used elsewhere in this codebase
        // (e.g. ResendVerificationHandler).
        var marketingBaseUrl = HR.Web.Services.MarketingSiteUrl.Resolve(Configuration);
        var url = $"{marketingBaseUrl}/check-your-email?email={Uri.EscapeDataString(_form.Email)}";
        Navigation.NavigateTo(url, forceLoad: true);
    }

    private sealed class ResendForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;
    }
}
