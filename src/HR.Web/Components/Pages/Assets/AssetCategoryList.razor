@page "/companies/{CompanyId:guid}/asset-categories"
@rendermode InteractiveServer
@inherits SearchPageBase<AssetCategoryListItemModel>
@inject AssetCategoryService AssetCategoryService
@inject AppSession Session

<PageTitle>Asset Categories</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Asset Categories</h1>
    <p class="text-muted mb-3">Group company assets into categories, such as laptops or phones.</p>

    @if (IsLoading)
    {
        <div class="d-flex align-items-center gap-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Loading asset categories…</span>
        </div>
    }
    else if (Error is not null)
    {
        <div class="alert alert-danger">@Error</div>
    }
    else
    {
        @if (ActionError is not null)
        {
            <div class="alert alert-danger alert-dismissible">
                @ActionError
                <button type="button" class="btn-close" @onclick="ClearActionError"></button>
            </div>
        }

        <HrGrid @ref="Grid"
                TValue="AssetCategoryListItemModel"
                DataSource="@Items"
                Toolbar="@GridToolbar"
                AllowFiltering="true">
            <GridEvents TValue="AssetCategoryListItemModel" OnToolbarClick="OnToolbarClick"
                        RowSelected="OnRowSelected" RowDeselected="OnRowDeselected" />
            <GridPageSettings PageSize="20" />
            <GridColumns>
                <GridColumn Field="@nameof(AssetCategoryListItemModel.Name)" HeaderText="Name" Width="220">
                    <Template>
                        @{
                            var row = (context as AssetCategoryListItemModel)!;
                            <a href="/companies/@CompanyId/asset-categories/@row.Id">@row.Name</a>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(AssetCategoryListItemModel.Description)" HeaderText="Description" Width="300" />
                <GridColumn Field="@nameof(AssetCategoryListItemModel.IsActive)" HeaderText="Status" Width="110">
                    <Template>
                        @{
                            var row = (context as AssetCategoryListItemModel)!;
                            <span class="badge @(row.IsActive ? "bg-success" : "bg-secondary")">
                                @(row.IsActive ? "Active" : "Inactive")
                            </span>
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </HrGrid>
    }
</div>

@code {
    protected override bool SupportsActiveFilter => true;

    protected override Task OnBeforeLoadAsync()
    {
        if (!Session.CanManageEmployees)
            Navigation.NavigateTo(Session.MyProfileUrl, replace: true);
        return Task.CompletedTask;
    }

    protected override void ConfigureToolbar()
    {
        AddToolbarAction(
            id:      "hr-deactivate",
            text:    "Deactivate",
            icon:    "fa-solid fa-circle-xmark",
            onClick: async item =>
            {
                if (!item.IsActive) return;
                await Deactivate(item);
            },
            tooltip: "Deactivate selected asset category");
    }

    protected override async Task<IReadOnlyList<AssetCategoryListItemModel>?> FetchItemsAsync(string? search)
    {
        var result = await AssetCategoryService.ListAssetCategoriesAsync(CompanyId, ShowInactive);
        return result?.Items;
    }

    protected override string LoadErrorMessage => "Failed to load asset categories.";

    protected override string? GetAddUrl()  => $"/companies/{CompanyId}/asset-categories/new";
    protected override string? GetEditUrl(AssetCategoryListItemModel item) => $"/companies/{CompanyId}/asset-categories/{item.Id}";
    protected override string? GetViewUrl(AssetCategoryListItemModel item) => $"/companies/{CompanyId}/asset-categories/{item.Id}/view";

    private async Task Deactivate(AssetCategoryListItemModel item)
    {
        ClearActionError();
        var error = await AssetCategoryService.DeactivateAsync(CompanyId, item.Id);
        if (error is not null)
            SetActionError(error);
        else
            await LoadAsync();
    }
}
