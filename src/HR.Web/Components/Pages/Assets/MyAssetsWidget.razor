@inject AssetService AssetService
@inject AppSession Session

@if (_loading)
{
    <div class="widget-card">
        <div class="widget-header">
            <i class="fa-solid fa-box widget-icon"></i>
            <span class="widget-title">My Assets</span>
        </div>
        <div class="widget-body d-flex align-items-center gap-2 py-3 px-3">
            <HrLoadingIndicator Label="Loading assets…" />
        </div>
    </div>
}
else
{
    <div class="widget-card">
        <div class="widget-header">
            <i class="fa-solid fa-box widget-icon"></i>
            <span class="widget-title">My Assets</span>
            @if (_assets.Count > 0)
            {
                <span class="widget-count-badge">@_assets.Count</span>
            }
            @if (_profileUrl is not null)
            {
                <a href="@_profileUrl" class="widget-view-all ms-auto">
                    View all <i class="fa-solid fa-arrow-right fa-xs"></i>
                </a>
            }
        </div>

        <div class="widget-body">
            @if (_assets.Count == 0)
            {
                <div class="widget-empty">
                    <i class="fa-solid fa-box-open fa-lg mb-2"></i>
                    <p class="mb-0">No assets assigned.</p>
                </div>
            }
            else
            {
                @foreach (var asset in _assets.Take(5))
                {
                    var a = asset;
                    <div class="task-widget-item" @onclick="() => NavigateToAsset(a)">
                        <div class="task-widget-content">
                            <span class="task-widget-title">@a.Name</span>
                            <span class="task-widget-meta">@a.AssetNumber@(a.CategoryName is not null ? $" · {a.CategoryName}" : string.Empty)</span>
                        </div>
                        @if (!a.IsAcknowledged)
                        {
                            <span class="due-badge due-badge--today">Pending</span>
                        }
                        else
                        {
                            <span class="due-badge due-badge--normal">Acknowledged</span>
                        }
                    </div>
                }
            }
        </div>
    </div>
}

<AssetDetailDialog CompanyId="Session.CompanyId"
                   AssetId="_viewedAssetId"
                   IsOpen="_viewDialogOpen"
                   OnClosed="CloseAssetDialogAsync" />

@code {
    private bool _loading = true;
    private List<EmployeeAssetItem> _assets = [];
    private string? _profileUrl;

    private Guid? _viewedAssetId;
    private bool _viewDialogOpen;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.EmployeeId.HasValue)
        {
            _loading = false;
            return;
        }

        _profileUrl = $"/companies/{Session.CompanyId}/employees/{Session.EmployeeId.Value}/profile?tab=assets";

        await LoadAssetsAsync();
        _loading = false;
    }

    private async Task LoadAssetsAsync()
    {
        _assets = await AssetService.GetEmployeeAssignmentsAsync(Session.CompanyId, Session.EmployeeId!.Value) ?? [];
    }

    private void NavigateToAsset(EmployeeAssetItem asset)
    {
        _viewedAssetId = asset.AssetId;
        _viewDialogOpen = true;
    }

    private async Task CloseAssetDialogAsync()
    {
        _viewDialogOpen = false;
        await LoadAssetsAsync();
    }
}
