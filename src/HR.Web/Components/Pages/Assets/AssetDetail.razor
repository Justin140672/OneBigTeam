@page "/companies/{CompanyId:guid}/assets/{Id:guid}/view"
@rendermode InteractiveServer
@inject AssetService AssetService
@inject EmployeeService EmployeeService
@inject AppSession Session
@inject IJSRuntime JS

<PageTitle>@(_asset?.Name ?? "Asset")</PageTitle>

<div class="container py-4" data-testid="asset-detail-page">

    @if (_loading)
    {
        <div class="d-flex align-items-center gap-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Loading…</span>
        </div>
    }
    else if (_asset is null)
    {
        <div class="alert alert-danger">Asset not found.</div>
    }
    else
    {
        <div class="d-flex align-items-center gap-3 mb-1">
            <button class="btn btn-outline-secondary btn-sm" @onclick="GoBack">
                <i class="fa-solid fa-arrow-left me-1"></i>Back
            </button>
            <div>
                <h1 class="mb-0 fs-4" data-testid="asset-title">@_asset.AssetNumber — @_asset.Name</h1>
            </div>
            <span class="ms-2 @StatusBadgeClass" data-testid="asset-status-badge">@_asset.Status</span>
        </div>
        <p class="text-muted mb-4">Review this asset's details, assignment, and acknowledgement history.</p>

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Asset Details</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Asset Number</dt>
                            <dd class="col-sm-8" data-testid="asset-number">@_asset.AssetNumber</dd>

                            <dt class="col-sm-4">Name</dt>
                            <dd class="col-sm-8" data-testid="asset-name">@_asset.Name</dd>

                            <dt class="col-sm-4">Category</dt>
                            <dd class="col-sm-8" data-testid="asset-category">@(_asset.CategoryName ?? "—")</dd>

                            <dt class="col-sm-4">Status</dt>
                            <dd class="col-sm-8">
                                <span class="@StatusBadgeClass" data-testid="asset-status">@_asset.Status</span>
                            </dd>
                        </dl>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Specifications</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Manufacturer</dt>
                            <dd class="col-sm-8" data-testid="asset-manufacturer">@(_asset.Manufacturer ?? "—")</dd>

                            <dt class="col-sm-4">Model</dt>
                            <dd class="col-sm-8" data-testid="asset-model">@(_asset.Model ?? "—")</dd>

                            <dt class="col-sm-4">Serial Number</dt>
                            <dd class="col-sm-8" data-testid="asset-serial">@(_asset.SerialNumber ?? "—")</dd>
                        </dl>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Purchase Information</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Purchase Date</dt>
                            <dd class="col-sm-8" data-testid="asset-purchase-date">
                                @(_asset.PurchaseDate.HasValue ? _asset.PurchaseDate.Value.ToString("d MMM yyyy") : "—")
                            </dd>

                            <dt class="col-sm-4">Purchase Price</dt>
                            <dd class="col-sm-8" data-testid="asset-purchase-price">
                                @(_asset.PurchasePrice.HasValue ? _asset.PurchasePrice.Value.ToString("C") : "—")
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Record</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-5">Created</dt>
                            <dd class="col-sm-7" data-testid="asset-created-at">
                                @_asset.CreatedAt.LocalDateTime.ToString("d MMM yyyy HH:mm")
                            </dd>

                            <dt class="col-sm-5">Last Updated</dt>
                            <dd class="col-sm-7" data-testid="asset-updated-at">
                                @_asset.UpdatedAt.LocalDateTime.ToString("d MMM yyyy HH:mm")
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>

        <!-- Assignments Section -->
        <div class="card mt-4" data-testid="asset-assignments-section">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="mb-0">Assignments</h5>
                <div class="d-flex gap-2">
                    @if (_asset.Status == "Available")
                    {
                        <button class="btn btn-primary btn-sm" @onclick="OpenAssignDialog"
                                data-testid="assign-to-employee-btn">
                            <i class="fa-solid fa-user-plus me-1"></i>Assign to Employee
                        </button>
                    }
                    @if (_asset.Status == "Assigned" && ActiveAssignment is not null)
                    {
                        <button class="btn btn-warning btn-sm" @onclick="RequestReturnAsync"
                                disabled="@_returnRequesting"
                                data-testid="request-return-btn">
                            <i class="fa-solid fa-rotate-left me-1"></i>Request Return
                        </button>
                    }
                </div>
            </div>
            <div class="card-body p-0">
                @if (_assignmentsLoading)
                {
                    <div class="d-flex align-items-center gap-2 p-3">
                        <div class="spinner-border spinner-border-sm" role="status"></div>
                        <span>Loading assignments…</span>
                    </div>
                }
                else if (_assignments.Count == 0)
                {
                    <p class="text-muted p-3 mb-0">No assignments recorded for this asset.</p>
                }
                else
                {
                    <HrGrid TValue="AssetAssignmentItem"
                            DataSource="@_assignments"
                            AllowFiltering="false"
                            AllowPaging="false"
                            AllowSorting="false"
                            data-testid="asset-assignments-grid">
                        <GridColumns>
                            <GridColumn Field="@nameof(AssetAssignmentItem.EmployeeId)" HeaderText="Employee ID" Width="260" />
                            <GridColumn Field="@nameof(AssetAssignmentItem.AssignedAt)" HeaderText="Assigned Date" Width="160" Format="d" />
                            <GridColumn Field="@nameof(AssetAssignmentItem.ReturnedAt)" HeaderText="Returned Date" Width="160" Format="d" />
                            <GridColumn HeaderText="Acknowledged" Width="160">
                                <Template>
                                    @{
                                        var item = (AssetAssignmentItem)context;
                                    }
                                    @if (item.AcknowledgedAt.HasValue)
                                    {
                                        <span class="badge text-bg-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-warning">Pending</span>
                                    }
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(AssetAssignmentItem.Notes)" HeaderText="Notes" />
                        </GridColumns>
                    </HrGrid>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_assignSuccess))
        {
            <div class="alert alert-success mt-3" data-testid="assign-success-message">@_assignSuccess</div>
        }
        @if (!string.IsNullOrEmpty(_assignError))
        {
            <div class="alert alert-danger mt-3" data-testid="assign-error-message">@_assignError</div>
        }
    }
</div>

@if (_showAssignDialog)
{
    <SfDialog Width="480px" IsModal="true" @bind-Visible="_showAssignDialog" Header="Assign to Employee"
              CssClass="assign-to-employee-dialog">
        <DialogTemplates>
            <Content>
                <div class="mb-3">
                    <label class="form-label">Employee</label>
                    <SfDropDownList TValue="Guid?"
                                   TItem="EmployeeListItemModel"
                                   DataSource="@_employees"
                                   @bind-Value="_selectedEmployeeId"
                                   Placeholder="Select an employee"
                                   AllowFiltering="true">
                        <DropDownListFieldSettings Value="Id" Text="WorkEmail" />
                        <DropDownListTemplates TItem="EmployeeListItemModel">
                            <ItemTemplate>
                                @{
                                    var e = (EmployeeListItemModel)context;
                                }
                                <span><strong>@e.FirstName @e.LastName</strong> <span class="text-muted ms-1">@e.WorkEmail</span></span>
                            </ItemTemplate>
                        </DropDownListTemplates>
                    </SfDropDownList>
                </div>
                <div class="mb-3">
                    <label class="form-label">Notes (optional)</label>
                    <SfTextBox @bind-Value="_assignNotes" Multiline="true" Rows="2" />
                </div>
                @if (!string.IsNullOrEmpty(_dialogError))
                {
                    <div class="alert alert-danger py-2">@_dialogError</div>
                }
            </Content>
        </DialogTemplates>
        <DialogButtons>
            <DialogButton Content="Assign" IsPrimary="true" OnClick="ConfirmAssignAsync" />
            <DialogButton Content="Cancel" OnClick="CloseAssignDialog" />
        </DialogButtons>
    </SfDialog>
}

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid Id { get; set; }

    private AssetDetailModel? _asset;
    private bool _loading = true;
    private List<AssetAssignmentItem> _assignments = [];
    private bool _assignmentsLoading = true;

    private bool _showAssignDialog;
    private Guid? _selectedEmployeeId;
    private string? _assignNotes;
    private string? _dialogError;
    private List<EmployeeListItemModel> _employees = [];
    private string? _assignSuccess;
    private string? _assignError;
    private bool _returnRequesting;

    private AssetAssignmentItem? ActiveAssignment =>
        _assignments.FirstOrDefault(a => a.ReturnedAt is null);

    private string StatusBadgeClass => _asset?.Status switch
    {
        "Available"        => "badge text-bg-success",
        "Assigned"         => "badge text-bg-primary",
        "Retired"          => "badge text-bg-secondary",
        "UnderMaintenance" => "badge text-bg-warning",
        _                  => "badge text-bg-light"
    };

    protected override async Task OnInitializedAsync() => await Session.InitialiseAsync();

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _asset = await AssetService.GetAssetAsync(CompanyId, Id);
        _loading = false;

        _assignmentsLoading = true;
        _assignments = await AssetService.GetAssetAssignmentsAsync(CompanyId, Id) ?? [];
        _assignmentsLoading = false;
    }

    private async Task GoBack() => await JS.InvokeVoidAsync("history.back");

    private async Task OpenAssignDialog()
    {
        _selectedEmployeeId = null;
        _assignNotes = null;
        _dialogError = null;
        var result = await EmployeeService.ListEmployeesAsync(CompanyId, pageSize: 200);
        _employees = result?.Items ?? [];
        _showAssignDialog = true;
    }

    private void CloseAssignDialog() => _showAssignDialog = false;

    private async Task ConfirmAssignAsync()
    {
        if (_selectedEmployeeId is null)
        {
            _dialogError = "Please select an employee.";
            return;
        }

        var assignedBy = Session.EmployeeId ?? Session.UserId;
        var ok = await AssetService.AssignAssetAsync(
            CompanyId, Id, _selectedEmployeeId.Value, assignedBy, _assignNotes);

        if (!ok)
        {
            _dialogError = "Failed to assign asset. It may already be assigned or unavailable.";
            return;
        }

        _showAssignDialog = false;
        _assignSuccess = "Asset assigned successfully.";
        _assignError = null;

        // Reload the asset (status changes to Assigned) and assignments list
        _asset = await AssetService.GetAssetAsync(CompanyId, Id);
        _assignments = await AssetService.GetAssetAssignmentsAsync(CompanyId, Id) ?? [];
    }

    private async Task RequestReturnAsync()
    {
        var assignment = ActiveAssignment;
        if (assignment is null) return;

        _returnRequesting = true;
        _assignSuccess = null;
        _assignError = null;

        var requestedBy = Session.EmployeeId ?? Session.UserId;
        var ok = await AssetService.RequestReturnAsync(CompanyId, assignment.Id, requestedBy);

        _returnRequesting = false;

        if (!ok)
        {
            _assignError = "Failed to request return. The return may already have been requested.";
            return;
        }

        _assignSuccess = "Return requested successfully.";
        _assignments = await AssetService.GetAssetAssignmentsAsync(CompanyId, Id) ?? [];
    }
}
