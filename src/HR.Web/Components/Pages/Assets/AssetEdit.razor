@page "/companies/{CompanyId:guid}/assets/new"
@page "/companies/{CompanyId:guid}/assets/{Id:guid}"
@rendermode InteractiveServer
@inject AssetService AssetService
@inject AssetCategoryService AssetCategoryService
@inherits EditPageBase<AssetEditModel, Guid>

<PageTitle>@PageTitle</PageTitle>

<div class="container py-4">
    <SfBreadcrumb Class="mb-3">
        <BreadcrumbItems>
            <BreadcrumbItem Text="Assets" Url="@($"/companies/{CompanyId}/assets")" />
            <BreadcrumbItem Text="@PageTitle" />
        </BreadcrumbItems>
    </SfBreadcrumb>

    @if (IsLoading)
    {
        <HrLoadingIndicator />
    }
    else
    {
        <h1 class="mb-1">@PageTitle</h1>
        <p class="text-muted mb-4">Record the details, category, and assignment for this asset.</p>

        @if (!string.IsNullOrEmpty(GlobalError))
        {
            <div class="alert alert-danger">@GlobalError</div>
        }

        <EditForm EditContext="EditContext">
            <DataAnnotationsValidator />
            <div class="row">
                <div class="col-lg-8">
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Asset Details</h5>
                        </div>
                        <div class="card-body @(IsViewMode ? "view-mode" : "")">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Asset Number <span class="text-danger">*</span></label>
                                    <HrTextBox @bind-Value="Model.AssetNumber" Placeholder="e.g. ASSET-001" />
                                    <ValidationMessage For="@(() => Model.AssetNumber)" />
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label">Name <span class="text-danger">*</span></label>
                                    <HrTextBox @bind-Value="Model.Name" Placeholder="e.g. Dell Laptop" />
                                    <ValidationMessage For="@(() => Model.Name)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Category <span class="text-danger">*</span></label>
                                    <SfDropDownList TValue="Guid?" TItem="AssetCategoryListItemModel"
                                                   DataSource="@_categories"
                                                   @bind-Value="Model.CategoryId"
                                                   Placeholder="Select category">
                                        <DropDownListFieldSettings Value="Id" Text="Name" />
                                    </SfDropDownList>
                                    <ValidationMessage For="@(() => Model.CategoryId)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Manufacturer</label>
                                    <HrTextBox @bind-Value="Model.Manufacturer" Placeholder="e.g. Dell" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Model</label>
                                    <HrTextBox @bind-Value="Model.Model" Placeholder="e.g. XPS 15" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Serial Number</label>
                                    <HrTextBox @bind-Value="Model.SerialNumber" Placeholder="e.g. SN123456" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Purchase Date</label>
                                    <SfDatePicker TValue="DateOnly?" @bind-Value="Model.PurchaseDate" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Purchase Price</label>
                                    <SfNumericTextBox TValue="decimal?" @bind-Value="Model.PurchasePrice"
                                                      Format="N2" Placeholder="0.00" ShowSpinButton="false" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        @if (!IsViewMode)
                        {
                            <SfButton IsPrimary="true" Disabled="@Saving" OnClick="SaveAsync">
                                @if (Saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                Save
                            </SfButton>
                        }
                        <SfButton OnClick="RequestClose" Disabled="@Saving">Close</SfButton>
                    </div>
                </div>
            </div>
        </EditForm>
    }

    <UnsavedChangesDialog Visible="ShowUnsavedChangesDialog"
                          OnSaveAndClose="ConfirmSaveAndCloseAsync"
                          OnDiscard="DiscardChangesAndClose"
                          OnCancel="CancelCloseDialog" />
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid? Id { get; set; }

    private string PageTitle => IsNew ? "Add Asset"
        : Model.Name.Trim().Length > 0 ? Model.Name
        : IsViewMode ? "View Asset" : "Edit Asset";

    private List<AssetCategoryListItemModel> _categories = [];

    protected override IEditService<AssetEditModel, Guid> Service => AssetService;
    protected override Guid GetCompanyId() => CompanyId;
    protected override Guid? GetId() => Id;

    protected override async Task OnLoadedAsync()
    {
        var categoriesResult = await AssetCategoryService.ListAssetCategoriesAsync(CompanyId);
        _categories = categoriesResult?.Items ?? [];
    }

    protected override string? ListUrl => $"/companies/{CompanyId}/assets";
}
