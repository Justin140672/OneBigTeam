@page "/companies/{CompanyId:guid}/assets/new"
@page "/companies/{CompanyId:guid}/assets/{Id:guid}"
@rendermode InteractiveServer
@inject AssetService AssetService
@inject AssetCategoryService AssetCategoryService
@inject NavigationManager Navigation

<PageTitle>@PageTitle</PageTitle>

<div class="container py-4">
    <SfBreadcrumb Class="mb-3">
        <BreadcrumbItems>
            <BreadcrumbItem Text="Assets" Url="@($"/companies/{CompanyId}/assets")" />
            <BreadcrumbItem Text="@PageTitle" />
        </BreadcrumbItems>
    </SfBreadcrumb>

    @if (_loading)
    {
        <div class="d-flex align-items-center gap-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Loading…</span>
        </div>
    }
    else
    {
        <h1 class="mb-4">@PageTitle</h1>

        @if (!string.IsNullOrEmpty(_globalError))
        {
            <div class="alert alert-danger">@_globalError</div>
        }

        <div class="row">
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Asset Details</h5>
                    </div>
                    <div class="card-body @(_isViewMode ? "view-mode" : "")">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Asset Number <span class="text-danger">*</span></label>
                                <HrTextBox @bind-Value="_model.AssetNumber" Placeholder="e.g. ASSET-001" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Name <span class="text-danger">*</span></label>
                                <HrTextBox @bind-Value="_model.Name" Placeholder="e.g. Dell Laptop" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Category <span class="text-danger">*</span></label>
                                <SfDropDownList TValue="Guid" TItem="AssetCategoryListItemModel"
                                               DataSource="@_categories"
                                               @bind-Value="_model.CategoryId"
                                               Placeholder="Select category">
                                    <DropDownListFieldSettings Value="Id" Text="Name" />
                                </SfDropDownList>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Manufacturer</label>
                                <HrTextBox @bind-Value="_model.Manufacturer" Placeholder="e.g. Dell" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Model</label>
                                <HrTextBox @bind-Value="_model.Model" Placeholder="e.g. XPS 15" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Serial Number</label>
                                <HrTextBox @bind-Value="_model.SerialNumber" Placeholder="e.g. SN123456" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Purchase Date</label>
                                <SfDatePicker TValue="DateOnly?" @bind-Value="_model.PurchaseDate" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Purchase Price</label>
                                <SfNumericTextBox TValue="decimal?" @bind-Value="_model.PurchasePrice"
                                                  Format="N2" Placeholder="0.00" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    @if (!_isViewMode)
                    {
                        @if (!string.IsNullOrEmpty(_successMsg))
                        {
                            <div class="alert alert-success py-2 mb-0 d-flex align-items-center">@_successMsg</div>
                        }
                        <SfButton IsPrimary="true" Disabled="@_saving" OnClick="Save">
                            @if (_saving)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            Save
                        </SfButton>
                    }
                    <SfButton OnClick="Cancel" Disabled="@_saving">@(_isViewMode ? "Close" : "Cancel")</SfButton>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid? Id { get; set; }

    private bool _isViewMode;
    private bool IsNew => Id is null || Id == Guid.Empty;
    private string PageTitle => IsNew ? "Add Asset"
        : _model.Name.Trim().Length > 0 ? _model.Name
        : _isViewMode ? "View Asset" : "Edit Asset";

    private bool _loading = true;
    private bool _saving;
    private string? _globalError;
    private string? _successMsg;

    private readonly AssetEditModel _model = new();
    private List<AssetCategoryListItemModel> _categories = [];

    protected override async Task OnParametersSetAsync()
    {
        _isViewMode = Navigation.Uri.Contains("/view", StringComparison.OrdinalIgnoreCase);
        _loading = true;
        _globalError = null;
        _successMsg = null;

        var categoriesResult = await AssetCategoryService.ListAssetCategoriesAsync(CompanyId);
        _categories = categoriesResult?.Items ?? [];

        if (!IsNew)
        {
            var list = await AssetService.ListAssetsAsync(CompanyId);
            var existing = list?.Items.FirstOrDefault(e => e.Id == Id);
            if (existing is not null)
            {
                _model.AssetNumber = existing.AssetNumber;
                _model.CategoryId = existing.CategoryId;
                _model.Name = existing.Name;
                _model.Manufacturer = existing.Manufacturer;
                _model.Model = existing.Model;
                _model.SerialNumber = existing.SerialNumber;
                _model.PurchaseDate = existing.PurchaseDate;
                _model.PurchasePrice = existing.PurchasePrice;
            }
        }

        _loading = false;
    }

    private async Task Save()
    {
        _saving = true;
        _globalError = null;
        _successMsg = null;

        if (IsNew)
        {
            var request = new CreateAssetRequest(
                CompanyId,
                _model.AssetNumber.Trim(),
                _model.CategoryId,
                _model.Name.Trim(),
                string.IsNullOrWhiteSpace(_model.Manufacturer) ? null : _model.Manufacturer.Trim(),
                string.IsNullOrWhiteSpace(_model.Model) ? null : _model.Model.Trim(),
                string.IsNullOrWhiteSpace(_model.SerialNumber) ? null : _model.SerialNumber.Trim(),
                _model.PurchaseDate,
                _model.PurchasePrice);

            var (created, error) = await AssetService.CreateAssetAsync(CompanyId, request);
            _saving = false;

            if (created is not null)
                Navigation.NavigateTo($"/companies/{CompanyId}/assets", forceLoad: true);
            else
                _globalError = error ?? "Failed to create asset.";
        }
        else
        {
            var request = new UpdateAssetRequest(
                CompanyId,
                Id!.Value,
                _model.AssetNumber.Trim(),
                _model.CategoryId,
                _model.Name.Trim(),
                string.IsNullOrWhiteSpace(_model.Manufacturer) ? null : _model.Manufacturer.Trim(),
                string.IsNullOrWhiteSpace(_model.Model) ? null : _model.Model.Trim(),
                string.IsNullOrWhiteSpace(_model.SerialNumber) ? null : _model.SerialNumber.Trim(),
                _model.PurchaseDate,
                _model.PurchasePrice);

            var (updated, error) = await AssetService.UpdateAssetAsync(CompanyId, Id!.Value, request);
            _saving = false;

            if (updated is not null)
                Navigation.NavigateTo($"/companies/{CompanyId}/assets", forceLoad: true);
            else
                _globalError = error ?? "Failed to save asset.";
        }
    }

    private void Cancel() => Navigation.NavigateTo($"/companies/{CompanyId}/assets");
}
