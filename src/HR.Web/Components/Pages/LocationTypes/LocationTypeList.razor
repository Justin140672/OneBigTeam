@page "/companies/{CompanyId:guid}/location-types"
@rendermode InteractiveServer
@inherits SearchPageBase<LocationTypeListItemModel>
@inject LocationTypeService LocationTypeService
@inject AppSession Session

<PageTitle>Location Types</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Location Types</h1>
    <p class="text-muted mb-3">Define the location types available when setting up locations, such as office or warehouse.</p>

    @if (IsLoading)
    {
        <HrLoadingIndicator Label="Loading location types…" />
    }
    else if (Error is not null)
    {
        <div class="alert alert-danger">@Error</div>
    }
    else
    {
        @if (ActionError is not null)
        {
            <div class="alert alert-danger alert-dismissible">
                @ActionError
                <button type="button" class="btn-close" @onclick="ClearActionError"></button>
            </div>
        }

        <HrGrid @ref="Grid"
                TValue="LocationTypeListItemModel"
                DataSource="@Items"
                Toolbar="@GridToolbar"
                AllowFiltering="true">
            <GridEvents TValue="LocationTypeListItemModel" OnToolbarClick="OnToolbarClick"
                        RowSelected="OnRowSelected" RowDeselected="OnRowDeselected" />
            <GridPageSettings PageSize="20" />
            <GridColumns>
                <GridColumn Field="@nameof(LocationTypeListItemModel.Name)" HeaderText="Name" Width="220">
                    <Template>
                        @{
                            var row = (context as LocationTypeListItemModel)!;
                            <a href="/companies/@CompanyId/location-types/@row.Id">@row.Name</a>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(LocationTypeListItemModel.Description)" HeaderText="Description" Width="300" />
                <GridColumn Field="@nameof(LocationTypeListItemModel.IsActive)" HeaderText="Status" Width="110">
                    <Template>
                        @{
                            var row = (context as LocationTypeListItemModel)!;
                            <ActiveStatusBadge IsActive="row.IsActive" />
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </HrGrid>
    }
</div>

<HrConfirmDialog Visible="@(_deactivateTarget is not null)"
                 Title="Deactivate Location Type"
                 Message="@($"Are you sure you want to deactivate '{_deactivateTarget?.Name}'?")"
                 ConfirmText="Deactivate"
                 CancelText="Cancel"
                 Busy="_deactivating"
                 OnConfirmed="ConfirmDeactivateAsync"
                 OnCancelled="@(() => _deactivateTarget = null)" />

@code {
    private LocationTypeListItemModel? _deactivateTarget;
    private bool _deactivating;

    protected override bool SupportsActiveFilter => true;

    protected override Task OnBeforeLoadAsync()
    {
        if (!Session.CanManageEmployees)
            Navigation.NavigateTo(Session.MyProfileUrl, replace: true);
        return Task.CompletedTask;
    }

    protected override void ConfigureToolbar()
    {
        AddToolbarAction(
            id:      "hr-deactivate",
            text:    "Deactivate",
            icon:    "fa-solid fa-circle-xmark",
            onClick: item =>
            {
                if (!item.IsActive) return Task.CompletedTask;
                _deactivateTarget = item;
                return Task.CompletedTask;
            },
            tooltip: "Deactivate selected location type");
    }

    protected override async Task<IReadOnlyList<LocationTypeListItemModel>?> FetchItemsAsync(string? search)
    {
        var result = await LocationTypeService.ListLocationTypesAsync(CompanyId, ShowInactive);
        return result?.Items;
    }

    protected override string LoadErrorMessage => "Failed to load location types.";

    protected override string? GetAddUrl()  => $"/companies/{CompanyId}/location-types/new";
    protected override string? GetEditUrl(LocationTypeListItemModel item) => $"/companies/{CompanyId}/location-types/{item.Id}";
    protected override string? GetViewUrl(LocationTypeListItemModel item) => $"/companies/{CompanyId}/location-types/{item.Id}/view";

    private async Task ConfirmDeactivateAsync()
    {
        if (_deactivateTarget is null) return;
        _deactivating = true;
        await Deactivate(_deactivateTarget);
        _deactivating = false;
        _deactivateTarget = null;
    }

    private async Task Deactivate(LocationTypeListItemModel item)
    {
        ClearActionError();
        var error = await LocationTypeService.DeactivateAsync(CompanyId, item.Id);
        if (error is not null)
            SetActionError(error);
        else
            await LoadAsync();
    }
}
