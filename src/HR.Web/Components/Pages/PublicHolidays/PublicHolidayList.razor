@page "/companies/{CompanyId:guid}/public-holidays"
@rendermode InteractiveServer
@inherits SearchPageBase<PublicHolidayListItemModel>
@inject PublicHolidayService PublicHolidayService
@inject AppSession Session

<PageTitle>Public Holidays</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Public Holidays</h1>
    <p class="text-muted mb-3">Manage the public holidays observed by your company.</p>

    @if (IsLoading)
    {
        <HrLoadingIndicator Label="Loading public holidays…" />
    }
    else if (Error is not null)
    {
        <div class="alert alert-danger">@Error</div>
    }
    else
    {
        <HrGrid @ref="Grid"
                TValue="PublicHolidayListItemModel"
                DataSource="@Items"
                Toolbar="@GridToolbar"
                AllowFiltering="true">
            <GridEvents TValue="PublicHolidayListItemModel" OnToolbarClick="OnToolbarClick"
                        RowSelected="OnRowSelected" RowDeselected="OnRowDeselected" />
            <GridPageSettings PageSize="20" />
            <GridColumns>
                <GridColumn Field="@nameof(PublicHolidayListItemModel.Year)" HeaderText="Year" Width="90" />
                <GridColumn Field="@nameof(PublicHolidayListItemModel.Date)" HeaderText="Date" Width="140" Format="d" />
                <GridColumn Field="@nameof(PublicHolidayListItemModel.Name)" HeaderText="Name" Width="260">
                    <Template>
                        @{
                            var row = (context as PublicHolidayListItemModel)!;
                            <a href="/companies/@CompanyId/public-holidays/@row.Id">@row.Name</a>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(PublicHolidayListItemModel.CountryCode)" HeaderText="Country" Width="110" />
            </GridColumns>
        </HrGrid>
    }
</div>

@code {
    protected override Task OnBeforeLoadAsync()
    {
        if (!Session.CanManageEmployees)
            Navigation.NavigateTo(Session.MyProfileUrl, replace: true);
        return Task.CompletedTask;
    }

    protected override async Task<IReadOnlyList<PublicHolidayListItemModel>?> FetchItemsAsync(string? search)
    {
        var result = await PublicHolidayService.ListAsync(CompanyId);
        return result?.Items;
    }

    protected override string LoadErrorMessage => "Failed to load public holidays.";

    protected override string? GetAddUrl() => $"/companies/{CompanyId}/public-holidays/new";

    protected override string? GetEditUrl(PublicHolidayListItemModel item) =>
        $"/companies/{CompanyId}/public-holidays/{item.Id}";

    protected override string? GetViewUrl(PublicHolidayListItemModel item) =>
        $"/companies/{CompanyId}/public-holidays/{item.Id}/view";
}
