@page "/companies/{CompanyId:guid}/public-holidays/new"
@page "/companies/{CompanyId:guid}/public-holidays/{Id:guid}"
@page "/companies/{CompanyId:guid}/public-holidays/{Id:guid}/view"
@rendermode InteractiveServer
@inject PublicHolidayService PublicHolidayService
@inherits EditPageBase<PublicHolidayEditModel, Guid>

<PageTitle>@PageTitle</PageTitle>

<div class="container py-4">
    <SfBreadcrumb Class="mb-3">
        <BreadcrumbItems>
            <BreadcrumbItem Text="Public Holidays" Url="@($"/companies/{CompanyId}/public-holidays")" />
            <BreadcrumbItem Text="@PageTitle" />
        </BreadcrumbItems>
    </SfBreadcrumb>

    @if (IsLoading)
    {
        <HrLoadingIndicator />
    }
    else
    {
        <h1 class="mb-1">@PageTitle</h1>
        <p class="text-muted mb-4">Set the date and name of this public holiday.</p>

        @if (!string.IsNullOrEmpty(GlobalError))
        {
            <div class="alert alert-danger">@GlobalError</div>
        }

        <EditForm EditContext="EditContext">
            <DataAnnotationsValidator />
            <div class="row">
                <div class="col-lg-7">
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Public Holiday Details</h5>
                        </div>
                        <div class="card-body @(IsViewMode ? "view-mode" : "")">
                            <div class="mb-3">
                                <label class="form-label">Date <span class="text-danger">*</span></label>
                                <SfDatePicker TValue="DateTime?" @bind-Value="Model.Date" Placeholder="Select date" Format="dd/MM/yyyy" />
                                <ValidationMessage For="@(() => Model.Date)" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Name <span class="text-danger">*</span></label>
                                <HrTextBox @bind-Value="Model.Name" Placeholder="e.g. Christmas Day" />
                                <ValidationMessage For="@(() => Model.Name)" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Country Code <span class="text-danger">*</span></label>
                                <HrTextBox @bind-Value="Model.CountryCode" Placeholder="e.g. GB" />
                                <ValidationMessage For="@(() => Model.CountryCode)" />
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        @if (!IsViewMode)
                        {
                            <SfButton IsPrimary="true" Disabled="@Saving" OnClick="SaveAsync">
                                @if (Saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                Save
                            </SfButton>
                        }
                        <SfButton OnClick="RequestClose" Disabled="@Saving">Close</SfButton>
                    </div>
                </div>
            </div>
        </EditForm>
    }

    <UnsavedChangesDialog Visible="ShowUnsavedChangesDialog"
                          OnSaveAndClose="ConfirmSaveAndCloseAsync"
                          OnDiscard="DiscardChangesAndClose"
                          OnCancel="CancelCloseDialog" />
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid? Id { get; set; }

    private string PageTitle => IsNew ? "Add Public Holiday"
        : IsViewMode ? "View Public Holiday" : "Edit Public Holiday";

    protected override IEditService<PublicHolidayEditModel, Guid> Service => PublicHolidayService;
    protected override Guid GetCompanyId() => CompanyId;
    protected override Guid? GetId() => Id;

    protected override string? ListUrl => $"/companies/{CompanyId}/public-holidays";
}
