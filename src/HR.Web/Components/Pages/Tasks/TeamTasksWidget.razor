@inject TaskService TaskService
@inject AppSession Session

@if (Session.EmployeeId.HasValue)
{
    @if (_loading)
    {
        <div class="widget-card">
            <div class="widget-header">
                <i class="fa-solid fa-users widget-icon"></i>
                <span class="widget-title">Team Tasks</span>
            </div>
            <div class="widget-body d-flex align-items-center gap-2 py-3 px-3">
                <div class="spinner-border spinner-border-sm" role="status"></div>
                <span class="text-muted">Loading tasks…</span>
            </div>
        </div>
    }
    else
    {
        <div class="widget-card">
            <div class="widget-header">
                <i class="fa-solid fa-users widget-icon"></i>
                <span class="widget-title">Team Tasks</span>
                @if (_active.Count > 0)
                {
                    <span class="widget-count-badge">@_active.Count</span>
                }
            </div>

            @if (_active.Count > 0)
            {
                <div class="widget-stats">
                    @if (_overdue > 0)
                    {
                        <div class="widget-stat widget-stat--danger">
                            <i class="fa-solid fa-triangle-exclamation fa-xs"></i>
                            <span class="widget-stat-value">@_overdue</span>
                            <span class="widget-stat-label">overdue</span>
                        </div>
                    }
                    @if (_inProgress > 0)
                    {
                        <div class="widget-stat">
                            <span class="widget-stat-value">@_inProgress</span>
                            <span class="widget-stat-label">in progress</span>
                        </div>
                    }
                </div>
            }

            <div class="widget-body">
                @if (_active.Count == 0)
                {
                    <div class="widget-empty">
                        <i class="fa-solid fa-circle-check fa-lg mb-2"></i>
                        <p class="mb-0">All caught up!</p>
                    </div>
                }
                else
                {
                    @foreach (var task in _active.Take(5))
                    {
                        var t = task;
                        var (dueLabel, dueCss) = DueBadge(t.DueDate);
                        <div class="task-widget-item task-widget-item--static">
                            <span class="priority-pip priority-pip--@DuePip(t.DueDate)" title="@t.Priority priority"></span>
                            <div class="task-widget-content">
                                <span class="task-widget-title">@t.Title</span>
                                <span class="task-widget-meta">@t.AssignedTo</span>
                            </div>
                            @if (dueLabel is not null)
                            {
                                <span class="due-badge due-badge--@dueCss">@dueLabel</span>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }
}

@code {
    private bool _loading = true;
    private List<TaskListItem> _active = [];
    private int _overdue;
    private int _inProgress;
    private DateOnly _today;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.EmployeeId.HasValue)
        {
            _loading = false;
            return;
        }

        _today = DateOnly.FromDateTime(DateTime.UtcNow);

        var result = await TaskService.GetTeamTasksAsync(Session.CompanyId, Session.EmployeeId.Value);
        var all    = result?.Items ?? [];

        _active = all
            .Where(t => t.Status is "Open" or "InProgress")
            .OrderBy(UrgencyOrder)
            .ThenBy(t => t.DueDate ?? DateOnly.MaxValue)
            .ThenByDescending(t => PriorityValue(t.Priority))
            .ToList();

        _overdue    = _active.Count(t => t.DueDate.HasValue && t.DueDate.Value < _today);
        _inProgress = _active.Count(t => t.Status == "InProgress");
        _loading    = false;
    }

    private int UrgencyOrder(TaskListItem t) =>
        t.DueDate is null         ? 3 :
        t.DueDate.Value < _today  ? 0 :
        t.DueDate.Value == _today ? 1 : 2;

    private static int PriorityValue(string p) => p switch
    {
        "Critical" => 4, "High" => 3, "Medium" => 2, _ => 1,
    };

    private (string? Label, string Css) DueBadge(DateOnly? due)
    {
        if (due is null)                    return (null,       "");
        if (due.Value < _today)             return ("Overdue",  "overdue");
        if (due.Value == _today)            return ("Today",    "today");
        if (due.Value == _today.AddDays(1)) return ("Tomorrow", "soon");
        return (due.Value.ToString("d MMM"),                    "normal");
    }

    private string DuePip(DateOnly? due) =>
        due is null                           ? "low" :
        due.Value < _today                    ? "critical" :
        due.Value == _today                   ? "high" :
        due.Value == _today.AddDays(1)        ? "medium" :
        "low";

}
