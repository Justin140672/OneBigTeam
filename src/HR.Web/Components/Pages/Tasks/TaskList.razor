@inject NavigationManager Navigation

<HrGrid TValue="TaskListItem"
        DataSource="@Tasks"
        AllowFiltering="false"
        AllowPaging="false"
        AllowSorting="false"
        Toolbar="@_toolbar">
    <GridEvents TValue="TaskListItem"
                OnToolbarClick="OnToolbarClickAsync"
                RowSelected="OnRowSelected"
                RowDeselected="OnRowDeselected" />
    <GridColumns>
        <GridColumn HeaderText="Task">
            <Template>
                @{
                    var item = (TaskListItem)context;
                }
                <div class="task-cell">
                    @if (CompanyId != Guid.Empty)
                    {
                        <a href="/companies/@CompanyId/tasks/@item.Id" class="task-title task-title-link">@item.Title</a>
                    }
                    else
                    {
                        <span class="task-title">@item.Title</span>
                    }
                    @if (item.Description is not null)
                    {
                        <span class="task-description">@item.Description</span>
                    }
                </div>
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Status" Width="140">
            <Template>
                @{
                    var item = (TaskListItem)context;
                }
                <span class="task-status-badge task-status-badge--@item.Status.ToLowerInvariant()">
                    @StatusLabel(item.Status)
                </span>
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(TaskListItem.Priority)" HeaderText="Priority" Width="120" />
        <GridColumn Field="@nameof(TaskListItem.DueDate)" HeaderText="Due Date" Width="140" Format="d" />
        @if (ShowAssignedTo)
        {
            <GridColumn Field="@nameof(TaskListItem.AssignedTo)" HeaderText="Assigned To" Width="180" />
        }
    </GridColumns>
</HrGrid>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<TaskListItem> Tasks { get; set; } = [];

    [Parameter]
    public Guid CompanyId { get; set; }

    [Parameter]
    public bool ShowAssignedTo { get; set; } = true;

    private TaskListItem? _selected;

    private IEnumerable<object> _toolbar => CompanyId != Guid.Empty
        ? new List<object>
          {
              new ItemModel { Id = "hr-view", Text = "View", PrefixIcon = "fa-solid fa-eye", TooltipText = "View task", Disabled = _selected is null }
          }
        : [];

    private void OnRowSelected(RowSelectEventArgs<TaskListItem> args)
    {
        _selected = args.Data;
        StateHasChanged();
    }

    private void OnRowDeselected(RowDeselectEventArgs<TaskListItem> args)
    {
        _selected = null;
        StateHasChanged();
    }

    private Task OnToolbarClickAsync(ClickEventArgs args)
    {
        if (args.Item.Id == "hr-view" && _selected is not null)
            Navigation.NavigateTo($"/companies/{CompanyId}/tasks/{_selected.Id}");
        return Task.CompletedTask;
    }

    private static string StatusLabel(string status) => status switch
    {
        "Open"       => "Not Started",
        "InProgress" => "In Progress",
        "Completed"  => "Completed",
        "Cancelled"  => "Cancelled",
        _            => status
    };
}
