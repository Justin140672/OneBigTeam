@inject NavigationManager Navigation

<HrGrid TValue="TaskListItem"
        DataSource="@Tasks"
        AllowFiltering="false"
        AllowPaging="false"
        AllowSorting="false">
    <GridColumns>
        <GridColumn HeaderText="Task">
            <Template>
                @{
                    var item = (TaskListItem)context;
                }
                <div class="task-cell">
                    @if (OnViewTask.HasDelegate)
                    {
                        <span class="task-title task-title-link" role="button" @onclick="() => OnViewTask.InvokeAsync(item.Id)">@item.Title</span>
                    }
                    else if (CompanyId != Guid.Empty)
                    {
                        <a href="/companies/@CompanyId/tasks/@item.Id" class="task-title task-title-link">@item.Title</a>
                    }
                    else
                    {
                        <span class="task-title">@item.Title</span>
                    }
                    @if (item.Description is not null)
                    {
                        <span class="task-description">@item.Description</span>
                    }
                </div>
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Status" Width="140">
            <Template>
                @{
                    var item = (TaskListItem)context;
                }
                <span class="task-status-badge task-status-badge--@item.Status.ToLowerInvariant()">
                    @StatusLabel(item.Status)
                </span>
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(TaskListItem.Priority)" HeaderText="Priority" Width="120" />
        <GridColumn Field="@nameof(TaskListItem.DueDate)" HeaderText="Due Date" Width="140" Format="d" />
        @if (ShowAssignedTo)
        {
            <GridColumn Field="@nameof(TaskListItem.AssignedTo)" HeaderText="Assigned To" Width="180" />
        }
        <GridColumn HeaderText="" Width="90" AllowSorting="false" AllowFiltering="false" TextAlign="TextAlign.Right">
            <Template>
                @{
                    var item = (TaskListItem)context;
                }
                <SfButton CssClass="e-outline e-small" title="View" OnClick="() => ViewTaskAsync(item.Id)">
                    <i class="fa-solid fa-eye"></i>
                </SfButton>
            </Template>
        </GridColumn>
    </GridColumns>
</HrGrid>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<TaskListItem> Tasks { get; set; } = [];

    [Parameter]
    public Guid CompanyId { get; set; }

    [Parameter]
    public bool ShowAssignedTo { get; set; } = true;

    // When set, "View" opens the task in a dialog instead of navigating to the full task page.
    [Parameter]
    public EventCallback<Guid> OnViewTask { get; set; }

    private async Task ViewTaskAsync(Guid taskId)
    {
        if (OnViewTask.HasDelegate)
            await OnViewTask.InvokeAsync(taskId);
        else
            Navigation.NavigateTo($"/companies/{CompanyId}/tasks/{taskId}");
    }

    private static string StatusLabel(string status) => status switch
    {
        "Open"       => "Not Started",
        "InProgress" => "In Progress",
        "Completed"  => "Completed",
        "Cancelled"  => "Cancelled",
        _            => status
    };
}
