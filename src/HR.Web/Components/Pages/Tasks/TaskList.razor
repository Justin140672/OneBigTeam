@using HR.Web.Models
@inject TaskService TaskService

<HrGrid TValue="TaskListItem"
        DataSource="@Tasks"
        AllowFiltering="false"
        AllowPaging="false"
        AllowSorting="false">
    <GridColumns>
        <GridColumn HeaderText="Task">
            <Template>
                @{
                    var item = (TaskListItem)context;
                }
                <div class="task-cell">
                    <span class="task-title">@item.Title</span>
                    @if (item.Description is not null)
                    {
                        <span class="task-description">@item.Description</span>
                    }
                </div>
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Status" Width="140">
            <Template>
                @{
                    var item = (TaskListItem)context;
                }
                <span class="task-status-badge task-status-badge--@item.Status.ToLowerInvariant()">
                    @StatusLabel(item.Status)
                </span>
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(TaskListItem.Priority)" HeaderText="Priority" Width="120" />
        <GridColumn Field="@nameof(TaskListItem.DueDate)" HeaderText="Due Date" Width="140" Format="d" />
        @if (ShowAssignedTo)
        {
            <GridColumn Field="@nameof(TaskListItem.AssignedTo)" HeaderText="Assigned To" Width="180" />
        }
        @if (CompanyId != Guid.Empty)
        {
            <GridColumn HeaderText="" Width="110" AllowFiltering="false" AllowSorting="false" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                <Template>
                    @{
                        var item = (TaskListItem)context;
                    }
                    @if (item.Status is "Open" or "InProgress")
                    {
                        @if (item.Source == "Leave")
                        {
                            <button class="btn btn-sm btn-outline-primary"
                                    @onclick="() => BeginLeaveReview(item)"
                                    @onclick:stopPropagation="true">
                                Review
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-success"
                                    @onclick="() => BeginComplete(item)"
                                    @onclick:stopPropagation="true">
                                Complete
                            </button>
                        }
                    }
                </Template>
            </GridColumn>
        }
    </GridColumns>
</HrGrid>

@if (CompanyId != Guid.Empty)
{
    <LeaveReviewDialog @bind-Visible="_leaveReviewVisible"
                       Task="_leaveReviewTask"
                       CompanyId="CompanyId"
                       OnReviewed="OnTaskCompleted" />

    <SfDialog @bind-Visible="_confirmVisible" IsModal="true" Width="420px" ShowCloseIcon="true">
        <DialogEvents Closed="CancelComplete" />
        <DialogTemplates>
            <Header>@_pendingTask?.Title</Header>
            <Content>
                @if (_pendingTask?.Description is not null)
                {
                    <p class="mb-3">@_pendingTask.Description</p>
                    <hr class="my-3" />
                }
                <p class="mb-0 text-muted">Mark this task as complete?</p>
                @if (_completeError is not null)
                {
                    <div class="alert alert-danger mt-3 mb-0">@_completeError</div>
                }
            </Content>
            <FooterTemplate>
                <SfButton IsPrimary="true" Disabled="@_completing" OnClick="ConfirmCompleteAsync">
                    @if (_completing)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    Complete
                </SfButton>
                <SfButton Disabled="@_completing" OnClick="CancelComplete">Cancel</SfButton>
            </FooterTemplate>
        </DialogTemplates>
    </SfDialog>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<TaskListItem> Tasks { get; set; } = [];

    [Parameter]
    public Guid CompanyId { get; set; }

    [Parameter]
    public bool ShowAssignedTo { get; set; } = true;

    [Parameter]
    public EventCallback OnTaskCompleted { get; set; }

    private bool _confirmVisible;
    private bool _completing;
    private string? _completeError;
    private TaskListItem? _pendingTask;

    private bool _leaveReviewVisible;
    private TaskListItem? _leaveReviewTask;

    private static string StatusLabel(string status) => status switch
    {
        "Open"       => "Not Started",
        "InProgress" => "In Progress",
        "Completed"  => "Completed",
        "Cancelled"  => "Cancelled",
        _            => status
    };

    private void BeginLeaveReview(TaskListItem task)
    {
        _leaveReviewTask = task;
        _leaveReviewVisible = true;
    }

    private void BeginComplete(TaskListItem task)
    {
        _pendingTask = task;
        _completeError = null;
        _confirmVisible = true;
    }

    private void CancelComplete()
    {
        _confirmVisible = false;
        _pendingTask = null;
        _completeError = null;
    }

    private async Task ConfirmCompleteAsync()
    {
        if (_pendingTask is null) return;

        _completing = true;
        _completeError = null;

        var success = await TaskService.CompleteTaskAsync(CompanyId, _pendingTask.Id);

        _completing = false;

        if (success)
        {
            _confirmVisible = false;
            _pendingTask = null;
            await OnTaskCompleted.InvokeAsync();
        }
        else
        {
            _completeError = "Failed to complete the task. Please try again.";
        }
    }
}
