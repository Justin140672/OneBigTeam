@using HR.Web.Components.Pages.Employees
@inject TaskService TaskService
@inject AppSession Session

<SfDialog Visible="Visible" IsModal="true" Width="720px" ShowCloseIcon="true" CssClass="task-view-dialog">
    <DialogEvents Closed="HandleDialogClosed" />
    <DialogTemplates>
        <Header><span data-testid="task-title">@(_task?.Title ?? "Task")</span></Header>
        <Content>
            @if (_loading)
            {
                <HrLoadingIndicator Label="Loading task…" />
            }
            else if (_task is null)
            {
                <div class="alert alert-danger mb-0">Task not found.</div>
            }
            else
            {
                <div class="card mb-3">
                    <div class="card-body">
                        @if (_task.Description is not null)
                        {
                            <p class="mb-3">@_task.Description</p>
                            <hr class="my-3" />
                        }
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted fw-normal">Source</dt>
                            <dd class="col-sm-8">@_task.Source</dd>

                            <dt class="col-sm-4 text-muted fw-normal">Priority</dt>
                            <dd class="col-sm-8">@_task.Priority</dd>

                            <dt class="col-sm-4 text-muted fw-normal">Due Date</dt>
                            <dd class="col-sm-8">@(_task.DueDate?.ToString("d MMM yyyy") ?? "—")</dd>

                            <dt class="col-sm-4 text-muted fw-normal">Created</dt>
                            <dd class="col-sm-8">@_task.CreatedAt.ToString("d MMM yyyy")</dd>

                            @if (_task.CompletedAt.HasValue)
                            {
                                <dt class="col-sm-4 text-muted fw-normal">Completed</dt>
                                <dd class="col-sm-8">@_task.CompletedAt.Value.ToString("d MMM yyyy")</dd>
                            }
                        </dl>
                    </div>
                </div>

                @if (_task.Status is "Open" or "InProgress")
                {
                    @if (_task.ActionType == "Approve" && _task.Source == "Leave")
                    {
                        <LeaveTaskPanel CompanyId="CompanyId" Task="_task" OnCompleted="OnActionCompletedAsync" />
                    }
                    else if (_task.ActionType == "Review" && _task.Source == "Probation")
                    {
                        <ProbationReviewPanel CompanyId="CompanyId" Task="_task" OnCompleted="OnActionCompletedAsync" />
                    }
                    else if (_task.ActionType == "Review" && _task.Source == "Sickness")
                    {
                        <ReturnToWorkReviewPanel CompanyId="CompanyId" Task="_task" OnCompleted="OnActionCompletedAsync" />
                    }
                    else if (_task.ActionType == "Review" && _task.Source == "Document")
                    {
                        <ProfilePhotoReviewPanel CompanyId="CompanyId" Task="_task" OnCompleted="OnActionCompletedAsync" />
                    }
                    else if (_task.ActionType == "Upload" && _task.Source == "Document")
                    {
                        <DocumentUploadTaskPanel CompanyId="CompanyId"
                                                 EmployeeId="@(_task.AssignedEmployeeId ?? Session.EmployeeId ?? Guid.Empty)"
                                                 Task="_task"
                                                 OnCompleted="OnActionCompletedAsync" />
                    }
                    else if (_task.ActionType == "Acknowledge" && _task.Source == "Asset")
                    {
                        <AssetAcknowledgementTaskPanel CompanyId="CompanyId"
                                                       Task="_task"
                                                       OnCompleted="OnActionCompletedAsync" />
                    }
                    else if (_task.ActionType == "Acknowledge" && _task.Source == "Document")
                    {
                        <SharedCompanyDocumentAcknowledgementTaskPanel CompanyId="CompanyId"
                                                                        Task="_task"
                                                                        OnCompleted="OnActionCompletedAsync" />
                    }
                    else if (_task.ActionType == "Return" && _task.Source == "Asset")
                    {
                        <AssetReturnTaskPanel CompanyId="CompanyId"
                                              Task="_task"
                                              OnCompleted="OnActionCompletedAsync" />
                    }
                    else
                    {
                        <CompleteTaskPanel CompanyId="CompanyId" Task="_task" OnCompleted="OnActionCompletedAsync" />
                    }
                }
            }
        </Content>
        <FooterTemplate>
            <SfButton OnClick="HandleDialogClosed">Close</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter] public Guid? TaskId { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private bool Visible;
    private bool _loading;
    private TaskDetailModel? _task;
    private Guid? _loadedTaskId;

    protected override async Task OnParametersSetAsync()
    {
        Visible = IsOpen;

        if (IsOpen && TaskId.HasValue && TaskId != _loadedTaskId)
        {
            _loadedTaskId = TaskId;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _task = await TaskService.GetTaskAsync(CompanyId, TaskId!.Value);
        _loading = false;
    }

    // Every panel above (LeaveTaskPanel, ProbationReviewPanel, DocumentUploadTaskPanel,
    // CompleteTaskPanel, etc.) only ever invokes OnCompleted once its task's terminal action has
    // actually finished server-side — none of them use it as a mid-flow "refresh and keep going"
    // signal (confirmed by reading each panel's own call site). This used to call LoadAsync()
    // instead, which re-fetched the now-completed task and re-rendered this same dialog with its
    // action panel gone (none of the ActionType/Source branches above match a completed task) —
    // visually indistinguishable from "a second, empty dialog" popping up rather than the dialog
    // just closing, for every task type uniformly. Close it instead, matching what completing a
    // task actually means from here.
    private async Task OnActionCompletedAsync() => await HandleDialogClosed();

    private async Task HandleDialogClosed()
    {
        _loadedTaskId = null;
        await OnClosed.InvokeAsync();
    }
}
