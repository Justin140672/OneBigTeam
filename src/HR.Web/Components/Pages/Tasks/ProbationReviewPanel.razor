@using System.ComponentModel.DataAnnotations
@using HR.Web.Models
@inject ProbationService ProbationService
@inject TaskService TaskService

<div class="card" data-testid="probation-review-panel">
    <div class="card-header fw-medium">Complete Probation Review</div>
    <div class="card-body">
        @if (_justCompleted)
        {
            <div class="d-flex align-items-center gap-2 mb-3">
                <i class="fa-solid fa-circle-check text-success fs-5"></i>
                <span class="fw-medium">Review completed.</span>
                @if (_successOutcome is not null)
                {
                    <span>Outcome: <strong data-testid="review-outcome">@_successOutcome</strong></span>
                }
            </div>
            <SfButton CssClass="e-outline e-small" OnClick="DismissAsync">Done</SfButton>
        }
        else
        {
            @if (_review is not null)
            {
                <dl class="row mb-3 small">
                    <dt class="col-sm-4 text-muted fw-normal">Review Type</dt>
                    <dd class="col-sm-8" data-testid="review-type">@FormatReviewType(_review.ReviewType)</dd>

                    <dt class="col-sm-4 text-muted fw-normal">Due Date</dt>
                    <dd class="col-sm-8">@_review.DueDate.ToString("d MMM yyyy")</dd>

                    <dt class="col-sm-4 text-muted fw-normal">Probation Period</dt>
                    <dd class="col-sm-8">@_review.RecordStartDate.ToString("d MMM yyyy") – @_review.RecordExpectedEndDate.ToString("d MMM yyyy")</dd>
                </dl>
                <hr class="my-3" />
            }
            <EditForm EditContext="_editContext">
                <DataAnnotationsValidator />
                @if (_review?.ReviewType is "FinalDecision")
                {
                    <div class="mb-3">
                        <label class="form-label fw-medium">Outcome <span class="text-danger">*</span></label>
                        <SfDropDownList TValue="string" TItem="OutcomeOption"
                                        DataSource="@OutcomeOptions"
                                        @bind-Value="_model.Outcome"
                                        Placeholder="Select outcome…">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                        <ValidationMessage For="@(() => _model.Outcome)" />
                    </div>
                    @if (_model.Outcome == "Extend")
                    {
                        <div class="mb-3">
                            <label class="form-label fw-medium">New Probation End Date <span class="text-danger">*</span></label>
                            <SfDatePicker TValue="DateOnly?" @bind-Value="_model.ExtensionDate" Format="dd/MM/yyyy" />
                            <ValidationMessage For="@(() => _model.ExtensionDate)" />
                        </div>
                    }
                }
                <div class="mb-3">
                    <label class="form-label fw-medium">
                        @NotesLabel(_model.Outcome)
                        @if (_model.Outcome is "Fail" or "Extend")
                        {
                            <span class="text-danger"> *</span>
                        }
                        else
                        {
                            <span class="text-muted fw-normal"> (optional)</span>
                        }
                    </label>
                    <HrTextBox @bind-Value="_model.Notes"
                               Multiline="true"
                               Rows="3"
                               Placeholder="@NotesPlaceholder(_model.Outcome)" />
                    <ValidationMessage For="@(() => _model.Notes)" />
                </div>
            </EditForm>
            @if (_error is not null)
            {
                <div class="alert alert-danger mb-3">@_error</div>
            }
            <SfButton CssClass="e-success"
                    OnClick="CompleteReviewAsync"
                    Disabled="@_submitting">
                @if (_submitting)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                <i class="fa-solid fa-check me-1"></i>Complete Review
            </SfButton>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public TaskDetailModel Task { get; set; } = null!;
    [Parameter] public EventCallback OnCompleted { get; set; }

    private ProbationReviewDetailModel? _review;
    private readonly ProbationReviewFormModel _model = new();
    private EditContext _editContext = default!;
    private string? _error;
    private bool _submitting;
    private bool _justCompleted;
    private string? _successOutcome;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);
    }

    private sealed class ProbationReviewFormModel : IValidatableObject
    {
        public bool IsFinalDecision { get; set; }
        public string? Outcome { get; set; }
        public DateOnly? ExtensionDate { get; set; }
        public string? Notes { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (IsFinalDecision && string.IsNullOrWhiteSpace(Outcome))
            {
                yield return new ValidationResult("An outcome is required for a Final Decision review.", [nameof(Outcome)]);
                yield break;
            }

            if (Outcome == "Extend")
            {
                if (!ExtensionDate.HasValue)
                    yield return new ValidationResult("A new probation end date is required when extending.", [nameof(ExtensionDate)]);
                else if (ExtensionDate <= DateOnly.FromDateTime(DateTime.Today))
                    yield return new ValidationResult("The new probation end date must be in the future.", [nameof(ExtensionDate)]);
            }

            if (Outcome is "Fail" or "Extend" && string.IsNullOrWhiteSpace(Notes))
                yield return new ValidationResult(
                    Outcome == "Extend" ? "An extension reason is required." : "A reason is required when failing probation.",
                    [nameof(Notes)]);
        }
    }

    private static readonly OutcomeOption[] OutcomeOptions =
    [
        new("Pass", "Pass"),
        new("Fail", "Fail"),
        new("Extend", "Extend probation")
    ];

    private sealed record OutcomeOption(string Value, string Label);

    protected override async Task OnParametersSetAsync()
    {
        if (_justCompleted) return;

        if (Task.SourceEntityId.HasValue)
            _review = await ProbationService.GetProbationReviewAsync(CompanyId, Task.SourceEntityId.Value);

        _model.IsFinalDecision = _review?.ReviewType is "FinalDecision";
    }

    private async Task CompleteReviewAsync()
    {
        if (_review is null) return;

        if (!_editContext.Validate())
            return;

        _submitting = true;
        _error = null;

        var outcomeDecision = _model.Outcome == "Extend"
            ? $"Extend|{_model.ExtensionDate!.Value:yyyy-MM-dd}"
            : string.IsNullOrWhiteSpace(_model.Outcome) ? null : _model.Outcome;

        var success = await TaskService.CompleteTaskAsync(CompanyId, Task.Id, outcomeDecision, _model.Notes);

        _submitting = false;

        if (success)
        {
            _justCompleted = true;
            _successOutcome = _model.Outcome switch
            {
                "Pass"   => "Passed",
                "Fail"   => "Failed",
                "Extend" => "Extended",
                _        => null
            };
        }
        else
        {
            _error = "Failed to complete the review. Please try again.";
        }
    }

    private async Task DismissAsync() => await OnCompleted.InvokeAsync();

    private static string NotesLabel(string? outcome) => outcome switch
    {
        "Fail"   => "Reason for failure",
        "Extend" => "Extension reason",
        _        => "Notes"
    };

    private static string NotesPlaceholder(string? outcome) => outcome switch
    {
        "Fail"   => "Enter the reason for failing probation…",
        "Extend" => "Enter the reason for extending probation…",
        _        => "Enter your review notes…"
    };

    private static string FormatReviewType(string reviewType) => reviewType switch
    {
        "ManagerCheckIn" => "Manager Check-in",
        "HrReview"       => "HR Review",
        "FinalDecision"  => "Final Decision",
        _                => reviewType
    };
}
