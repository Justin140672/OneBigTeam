@inject TaskService TaskService
@inject AppSession Session

@if (Session.CanManageEmployees)
{
    @if (_loading)
    {
        <div class="widget-card">
            <div class="widget-header">
                <i class="fa-solid fa-inbox widget-icon"></i>
                <span class="widget-title">HR Inbox</span>
            </div>
            <div class="widget-body d-flex align-items-center gap-2 py-3 px-3">
                <HrLoadingIndicator Label="Loading inbox…" />
            </div>
        </div>
    }
    else
    {
        <div class="widget-card">
            <div class="widget-header">
                <i class="fa-solid fa-inbox widget-icon"></i>
                <span class="widget-title">HR Inbox</span>
                @if (_items.Count > 0)
                {
                    <span class="widget-count-badge">@_items.Count</span>
                }
                <a href="/companies/@Session.CompanyId/hr/inbox" class="widget-view-all ms-auto">
                    View all <i class="fa-solid fa-arrow-right fa-xs"></i>
                </a>
            </div>

            @if (_overdue > 0)
            {
                <div class="widget-stats">
                    <div class="widget-stat widget-stat--danger">
                        <i class="fa-solid fa-triangle-exclamation fa-xs"></i>
                        <span class="widget-stat-value">@_overdue</span>
                        <span class="widget-stat-label">overdue</span>
                    </div>
                </div>
            }

            <div class="widget-body">
                @if (_items.Count == 0)
                {
                    <div class="widget-empty">
                        <i class="fa-solid fa-circle-check fa-lg mb-2"></i>
                        <p class="mb-0">Inbox clear</p>
                    </div>
                }
                else
                {
                    @foreach (var task in _items.Take(5))
                    {
                        var t = task;
                        var (dueLabel, dueCss) = DueBadge(t.DueDate);
                        <div class="task-widget-item" @onclick="() => NavigateToTask(t)">
                            <span class="priority-pip priority-pip--@DuePip(t.DueDate)" title="@t.Priority priority"></span>
                            <div class="task-widget-content">
                                <span class="task-widget-title">@t.Title</span>
                                <span class="task-widget-meta">@t.Source</span>
                            </div>
                            @if (dueLabel is not null)
                            {
                                <span class="due-badge due-badge--@dueCss">@dueLabel</span>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }

    <TaskViewDialog CompanyId="Session.CompanyId"
                    TaskId="_selectedTaskId"
                    IsOpen="_dialogOpen"
                    OnClosed="CloseTaskDialogAsync" />
}

@code {
    private bool _loading = true;
    private List<UnassignedTaskItem> _items = [];
    private int _overdue;
    private DateOnly _today;

    private Guid? _selectedTaskId;
    private bool _dialogOpen;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.CanManageEmployees)
        {
            _loading = false;
            return;
        }

        _today = DateOnly.FromDateTime(DateTime.UtcNow);
        await LoadTasksAsync();
        _loading = false;
    }

    private async Task LoadTasksAsync()
    {
        var result = await TaskService.GetUnassignedTasksAsync(Session.CompanyId);
        _items = result?.Items.ToList() ?? [];

        _overdue = _items.Count(t => t.DueDate.HasValue && t.DueDate.Value < _today);
    }

    private (string? Label, string Css) DueBadge(DateOnly? due)
    {
        if (due is null)                    return (null,       "");
        if (due.Value < _today)             return ("Overdue",  "overdue");
        if (due.Value == _today)            return ("Today",    "today");
        if (due.Value == _today.AddDays(1)) return ("Tomorrow", "soon");
        return (due.Value.ToString("d MMM"),                    "normal");
    }

    private string DuePip(DateOnly? due) =>
        due is null                    ? "low" :
        due.Value < _today             ? "critical" :
        due.Value == _today            ? "high" :
        due.Value == _today.AddDays(1) ? "medium" :
        "low";

    private void NavigateToTask(UnassignedTaskItem task)
    {
        _selectedTaskId = task.Id;
        _dialogOpen = true;
    }

    private async Task CloseTaskDialogAsync()
    {
        _dialogOpen = false;
        await LoadTasksAsync();
    }
}
