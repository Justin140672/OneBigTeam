@inject AppSession Session
<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Company Profile</h5>
    </div>
    <div class="card-body">
        <div class="mb-4">
            <HrTextField Id="company-name" Label="Name" Required="true" LabelClass="form-label fw-semibold"
                         Disabled="@Session.IsReadOnly" @bind-Value="Model.Name" Placeholder="Company name" />
        </div>

        @if (Model.Addresses.Count == 0)
        {
            <p class="text-muted">No addresses found.</p>
        }

        <div class="row g-3">
            @foreach (var (addr, i) in Model.Addresses.Select((a, i) => (a, i)))
            {
                <div class="col-md-6">
                    <fieldset class="border rounded p-3 h-100">
                        <legend class="text-uppercase text-muted small fw-normal mb-3">@EnumDisplay.Humanize(addr.Type)</legend>
                        <div class="row g-3">
                            <div class="col-12">
                                <HrTextField Id="@($"addr-{i}-line1")" Label="Address Line 1" Required="true"
                                             Disabled="@Session.IsReadOnly" @bind-Value="addr.Line1" Placeholder="Line 1" />
                            </div>
                            <div class="col-12">
                                <HrTextField Id="@($"addr-{i}-line2")" Label="Address Line 2"
                                             Disabled="@Session.IsReadOnly" @bind-Value="addr.Line2" Placeholder="Line 2" />
                            </div>
                            <div class="col-md-6">
                                <HrTextField Id="@($"addr-{i}-city")" Label="Town/City" Required="true"
                                             Disabled="@Session.IsReadOnly" @bind-Value="addr.City" Placeholder="City" />
                            </div>
                            <div class="col-md-6">
                                <HrTextField Id="@($"addr-{i}-region")" Label="County/Region"
                                             Disabled="@Session.IsReadOnly" @bind-Value="addr.Region" Placeholder="County" />
                            </div>
                            <div class="col-md-6">
                                <HrTextField Id="@($"addr-{i}-postcode")" Label="Postcode"
                                             Disabled="@Session.IsReadOnly" @bind-Value="addr.PostalCode" Placeholder="Postal Code" />
                            </div>
                            @* Country Code deliberately not shown — UK-only customers for now (same
                               reasoning as the removed Settings tab's TimeZone/Locale), so it's
                               always "GB", set in code (CompanyEdit.razor's LoadAsync /
                               CompanyProvisioner's default address) rather than user-editable. *@
                        </div>
                    </fieldset>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public GetCompanyResponse? Company { get; set; }
    [Parameter, EditorRequired] public CompanyDetailsEditModel Model { get; set; } = default!;
}
