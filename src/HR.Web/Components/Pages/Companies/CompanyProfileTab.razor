<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Company Profile</h5>
    </div>
    <div class="card-body">
        <div class="mb-4">
            <label class="form-label fw-semibold">Name</label>
            <HrTextBox @bind-Value="Model.Name" Placeholder="Company name" />
            <ValidationMessage For="@(() => Model.Name)" />
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">Status</label>
            <p class="mb-0">
                <ActiveStatusBadge IsActive="Company.IsActive" />
            </p>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public GetCompanyResponse? Company { get; set; }
    [Parameter, EditorRequired] public CompanyDetailsEditModel Model { get; set; } = default!;
}
