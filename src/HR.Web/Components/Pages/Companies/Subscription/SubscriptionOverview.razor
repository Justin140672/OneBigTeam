@page "/subscription"
@rendermode InteractiveServer
@using HR.Web.Components.Controls
@using HR.Web.Components.Pages.Companies
@inject SubscriptionService SubscriptionService
@inject NavigationManager NavigationManager
@inject AppSession Session

<PageTitle>Subscription</PageTitle>

<div class="container-fluid py-4">
    <HubBreadcrumb CompanyId="@Session.CompanyId" CurrentPage="Subscription" />
    <h1 class="mb-1">Subscription</h1>

    @if (_isLoading)
    {
        <HrLoadingIndicator Label="Loading subscription…" />
    }
    else
    {
        @if (_infoMessage is not null)
        {
            <div class="alert alert-success">@_infoMessage</div>
        }

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Subscription Details</h5>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Plan</label>
                        <p class="mb-0">@PlanDisplayHelper.GetDisplayName(_details?.PlanName)</p>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Status</label>
                        <p class="mb-0">@StatusDisplay</p>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Active Employees</label>
                        <p class="mb-0">@(_details?.ActiveEmployeeCount ?? 0)</p>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Next Billing Date</label>
                        <p class="mb-0">@NextBillingDateDisplay</p>
                    </div>

                    @if (_status?.Status == SubscriptionStatus.Trial)
                    {
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Trial Days Remaining</label>
                            <p class="mb-0">@_status.TrialDaysRemaining</p>
                        </div>
                    }

                    @if (_details?.CancelAtPeriodEnd == true)
                    {
                        <div class="col-12">
                            <div class="alert alert-warning mb-0">
                                Your subscription will end on @NextBillingDateDisplay.
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="mt-4">
            <div class="d-flex flex-wrap gap-2 align-items-center">
                @if (_status?.Status is SubscriptionStatus.Trial or SubscriptionStatus.TrialExpired)
                {
                    <SfButton IsPrimary="true" Disabled="@_checkoutBusy" OnClick="StartCheckoutAsync">
                        @if (_checkoutBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Start subscription
                    </SfButton>
                }

                @if (_details?.CancelAtPeriodEnd == true)
                {
                    <SfButton IsPrimary="true" Disabled="@_resumeBusy" OnClick="ResumeAsync">
                        @if (_resumeBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Resume subscription
                    </SfButton>
                }
                else
                {
                    <span title="@CancelUnavailableReason">
                        <SfButton Disabled="@(!CancelIsAvailable || _cancelBusy)" OnClick="RequestCancelAsync">
                            @if (_cancelBusy)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            Cancel subscription
                        </SfButton>
                    </span>
                    @if (!CancelIsAvailable)
                    {
                        <span class="text-muted small">@CancelUnavailableReason</span>
                    }
                }

                <span title="@ManageBillingUnavailableReason">
                    <SfButton Disabled="@(!ManageBillingIsAvailable || _manageBillingBusy)" OnClick="ManageBillingAsync">
                        @if (_manageBillingBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Manage billing
                    </SfButton>
                </span>
                @if (!ManageBillingIsAvailable)
                {
                    <span class="text-muted small">@ManageBillingUnavailableReason</span>
                }
            </div>

            @if (_actionError is not null)
            {
                <div class="alert alert-danger mt-3 d-flex justify-content-between align-items-center">
                    <span>@_actionError</span>
                    @if (_retryAction is not null)
                    {
                        <SfButton CssClass="ms-3" OnClick="RetryAsync">Retry</SfButton>
                    }
                </div>
            }
        </div>

        @if (Session.CompanyId != Guid.Empty)
        {
            <OrganisationDataExportPanel CompanyId="Session.CompanyId" />
        }
    }
</div>

<HrDestructiveConfirmDialog Visible="_showCancelConfirm"
                             Title="Cancel subscription"
                             Message="Are you sure you want to cancel your subscription? You'll keep access until the end of your current billing period, then your account will move to read-only."
                             ConfirmText="Cancel subscription"
                             CancelText="Keep subscription"
                             Busy="_cancelBusy"
                             OnConfirmed="ConfirmCancelAsync"
                             OnCancelled="() => _showCancelConfirm = false" />

@code {
    private GetSubscriptionStatusResponse? _status;
    private GetSubscriptionDetailsResponse? _details;
    private bool _isLoading = true;

    private bool _checkoutBusy;
    private bool _cancelBusy;
    private bool _resumeBusy;
    private bool _manageBillingBusy;

    private bool _showCancelConfirm;

    private string? _infoMessage;
    private string? _actionError;
    private Func<Task>? _retryAction;

    private string StatusDisplay =>
        _status is not null ? EnumDisplay.Humanize(_status.Status) : "Unknown";

    private string NextBillingDateDisplay =>
        _details?.NextBillingDate is { } date ? date.ToLocalTime().ToString("d") : "Not yet billed";

    // "Available" here means the action makes business sense right now, independent of whether an
    // API call is currently in flight (that's covered separately by the *_Busy flags above/spinner
    // state) — this is the "unavailable by design" case called out in the styling/UX conventions.
    private bool CancelIsAvailable =>
        _details is not null && _details.Status == SubscriptionStatus.Active && _details.CancelAtPeriodEnd == false;

    private string? CancelUnavailableReason => CancelIsAvailable
        ? null
        : _details is null
            ? "Cancelling is unavailable because your subscription details could not be loaded."
            : "Cancelling is unavailable because you don't have an active paid subscription.";

    private bool ManageBillingIsAvailable =>
        _details is not null && _details.Status != SubscriptionStatus.Trial;

    private string? ManageBillingUnavailableReason => ManageBillingIsAvailable
        ? null
        : _details is null
            ? "Billing management is unavailable because your subscription details could not be loaded."
            : "Billing management is not available while you're on a trial — start a subscription first.";

    protected override async Task OnInitializedAsync()
    {
        // ADM (Subscription & Billing restriction): Company-Administrator-only, enforced server-side
        // too — the subscription:manage API policy no longer grants HR Administrator (see
        // 30-administrative-role-separation-matrix.md). CanManageCompany is true iff the user holds
        // the CompanyAdministrator role. Bail before any load if the guard redirects.
        await Session.InitialiseAsync();
        if (!AppSession.GuardAccess(NavigationManager, Session.CanManageCompany))
            return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        StateHasChanged();

        var statusTask = SubscriptionService.GetStatusAsync();
        var detailsTask = SubscriptionService.GetDetailsAsync();

        await Task.WhenAll(statusTask, detailsTask);

        _status = await statusTask;
        _details = await detailsTask;
        _isLoading = false;
    }

    private async Task RetryAsync()
    {
        var action = _retryAction;
        _actionError = null;
        _retryAction = null;
        if (action is not null)
            await action();
    }

    private async Task StartCheckoutAsync()
    {
        _actionError = null;
        _infoMessage = null;
        _checkoutBusy = true;

        var response = await SubscriptionService.CreateCheckoutSessionAsync();

        if (response is null)
        {
            _actionError = "We couldn't start checkout just now. This may be a temporary problem — please try again.";
            _retryAction = StartCheckoutAsync;
            _checkoutBusy = false;
            return;
        }

        NavigationManager.NavigateTo(response.CheckoutUrl, forceLoad: true);
    }

    private void RequestCancelAsync() => _showCancelConfirm = true;

    private async Task ConfirmCancelAsync()
    {
        _actionError = null;
        _infoMessage = null;
        _cancelBusy = true;

        var response = await SubscriptionService.CancelAsync();
        if (response is null)
        {
            _showCancelConfirm = false;
            _actionError = "We couldn't cancel your subscription just now. This may be a temporary problem — please try again.";
            _retryAction = ConfirmCancelAsync;
            _cancelBusy = false;
            return;
        }

        _details = _details is null ? null : _details with { CancelAtPeriodEnd = response.CancelAtPeriodEnd };
        _infoMessage = "Your subscription is scheduled to be cancelled at the end of the current billing period.";
        _cancelBusy = false;
        _showCancelConfirm = false;
    }

    private async Task ResumeAsync()
    {
        _actionError = null;
        _infoMessage = null;
        _resumeBusy = true;

        var response = await SubscriptionService.ResumeAsync();
        if (response is null)
        {
            _actionError = "We couldn't resume your subscription just now. This may be a temporary problem — please try again.";
            _retryAction = ResumeAsync;
            _resumeBusy = false;
            return;
        }

        _details = _details is null ? null : _details with { CancelAtPeriodEnd = response.CancelAtPeriodEnd };
        _infoMessage = "Your subscription has been resumed.";
        _resumeBusy = false;
    }

    private async Task ManageBillingAsync()
    {
        if (!ManageBillingIsAvailable)
            return;

        _actionError = null;
        _infoMessage = null;
        _manageBillingBusy = true;

        var response = await SubscriptionService.GetBillingPortalAsync();
        if (response is null)
        {
            _actionError = "We couldn't open the billing portal just now. This may be a temporary problem — please try again.";
            _retryAction = ManageBillingAsync;
            _manageBillingBusy = false;
            return;
        }

        NavigationManager.NavigateTo(response.PortalUrl, forceLoad: true);
    }
}
