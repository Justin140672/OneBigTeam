@page "/companies/{Id:guid}/edit"
@page "/companies/{Id:guid}/view"
@rendermode InteractiveServer
@inject CompanyService CompanyService
@inject NavigationManager Navigation
@inject AppSession Session
@using HR.SharedKernel

<PageTitle>Edit Company</PageTitle>

<div class="container py-4">
    @if (_loading)
    {
        <div class="d-flex align-items-center gap-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Loading…</span>
        </div>
    }
    else if (_company is null)
    {
        <div class="alert alert-danger">Company not found.</div>
    }
    else
    {
        <div class="d-flex align-items-center gap-3 mb-4">
            <h1 class="mb-0">@_company.Name</h1>
            <span class="badge @(_company.IsActive ? "bg-success" : "bg-secondary")">
                @(_company.IsActive ? "Active" : "Inactive")
            </span>
        </div>

        @if (!string.IsNullOrEmpty(_globalError))
        {
            <div class="alert alert-danger">@_globalError</div>
        }

        <SfTab>
            <TabItems>
                <TabItem>
                    <ChildContent><TabHeader Text="Profile" /></ChildContent>
                    <ContentTemplate>
                        <div class="mt-4 @(_isViewMode ? "view-mode" : "")"><CompanyProfileTab Company="_company" Model="_profile" /></div>
                    </ContentTemplate>
                </TabItem>
                <TabItem>
                    <ChildContent><TabHeader Text="Addresses" /></ChildContent>
                    <ContentTemplate>
                        <div class="mt-4 @(_isViewMode ? "view-mode" : "")"><CompanyAddressesTab Addresses="_addresses" /></div>
                    </ContentTemplate>
                </TabItem>
                <TabItem>
                    <ChildContent><TabHeader Text="Settings" /></ChildContent>
                    <ContentTemplate>
                        <div class="mt-4 @(_isViewMode ? "view-mode" : "")"><CompanySettingsTab Model="_settings" /></div>
                    </ContentTemplate>
                </TabItem>
                <TabItem>
                    <ChildContent><TabHeader Text="Branding" /></ChildContent>
                    <ContentTemplate>
                        <div class="mt-4 @(_isViewMode ? "view-mode" : "")"><CompanyBrandingTab Model="_branding" /></div>
                    </ContentTemplate>
                </TabItem>
            </TabItems>
        </SfTab>

        <div class="mt-4 d-flex gap-2 align-items-center">
            @if (!_isViewMode)
            {
                @if (!string.IsNullOrEmpty(_successMsg))
                {
                    <div class="alert alert-success py-2 mb-0 d-flex align-items-center">@_successMsg</div>
                }
                <SfButton IsPrimary="true" Disabled="@_saving" OnClick="SaveAll">
                    @(_saving ? "Saving…" : "Save")
                </SfButton>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private bool _isViewMode;
    private GetCompanyResponse? _company;
    private bool _loading = true;
    private string? _globalError;
    private string? _successMsg;
    private bool _saving;
    private readonly CompanyProfileEditModel _profile = new();
    private List<CompanyAddressEditModel> _addresses = [];
    private readonly CompanySettingsEditModel _settings = new();
    private readonly CompanyBrandingEditModel _branding = new();

    protected override async Task OnInitializedAsync()
    {
        _isViewMode = Navigation.Uri.Contains("/view", StringComparison.OrdinalIgnoreCase);

        // Editing (not just viewing) company settings/profile/branding is admin-only,
        // matching the "company:manage" policy that guards the underlying save endpoints.
        await Session.InitialiseAsync();
        if (!_isViewMode && !Session.CanManageCompany)
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        _company = await CompanyService.GetCompanyAsync(Id);
        if (_company is not null)
        {
            _profile.Name = _company.Name;
            _addresses = _company.Addresses.Select(a => new CompanyAddressEditModel
            {
                Type = a.Type,
                Line1 = a.Line1,
                Line2 = a.Line2,
                City = a.City,
                Region = a.Region,
                PostalCode = a.PostalCode,
                CountryCode = a.CountryCode
            }).ToList();

            var settings = await CompanyService.GetCompanySettingsAsync(Id);
            if (settings is not null)
            {
                _settings.TimeZone = settings.TimeZone;
                _settings.Locale = settings.Locale;
                _settings.WorkingWeek = Enum.GetValues<WorkingDays>()
                    .Where(day => day != WorkingDays.None && ((WorkingDays)settings.WorkingDays).HasFlag(day))
                    .Select(day => day.ToString())
                    .ToHashSet();
                _settings.HoursPerDay = settings.HoursPerDay;
                _settings.LeaveYearStartMonth = settings.LeaveYearStartMonth;
                _settings.DefaultHolidayAllowance = settings.DefaultHolidayAllowance;
                _settings.ProbationMonths = settings.ProbationMonths;
                _settings.ExcludePublicHolidaysFromLeave = settings.ExcludePublicHolidaysFromLeave;
                _settings.ExcludePublicHolidaysFromSickness = settings.ExcludePublicHolidaysFromSickness;
                _settings.FitNoteRequiredAfterDays = settings.FitNoteRequiredAfterDays;
                _settings.ReturnToWorkRequiredAfterDays = settings.ReturnToWorkRequiredAfterDays;
            }
        }
        _loading = false;
    }

    private async Task SaveAll()
    {
        _saving = true;
        _globalError = null;
        _successMsg = null;

        var profileReq = new UpdateCompanyRequest(
            Id, _profile.Name,
            _addresses.Select(a => new UpdateCompanyAddressRequest(
                a.Type, a.Line1, a.Line2, a.City, a.Region, a.PostalCode, a.CountryCode)).ToList(),
            new UpdateCompanyBrandingRequest(_branding.PrimaryColor, _branding.SecondaryColor, _branding.AccentColor));

        var workingDays = _settings.WorkingWeek
            .Aggregate(WorkingDays.None, (acc, day) =>
                Enum.TryParse<WorkingDays>(day, out var wd) ? acc | wd : acc);

        var settingsReq = new UpdateCompanySettingsRequest(
            Id, _settings.TimeZone, _settings.Locale,
            workingDays, _settings.HoursPerDay,
            _settings.LeaveYearStartMonth, _settings.DefaultHolidayAllowance,
            _settings.ProbationMonths, _settings.ExcludePublicHolidaysFromLeave,
            _settings.ExcludePublicHolidaysFromSickness, _settings.FitNoteRequiredAfterDays,
            _settings.ReturnToWorkRequiredAfterDays);

        var companyResult = await CompanyService.UpdateCompanyAsync(Id, profileReq);
        var settingsResult = await CompanyService.UpdateCompanySettingsAsync(Id, settingsReq);

        if (companyResult is null || settingsResult is null)
            _globalError = "One or more sections failed to save.";
        else
            _successMsg = "Company saved successfully.";

        _saving = false;
    }
}
