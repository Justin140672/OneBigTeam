@page "/companies/{Id:guid}/edit"
@page "/companies/{Id:guid}/view"
@rendermode InteractiveServer
@inject CompanyService CompanyService
@inject AppSession Session
@inherits EditPageBase<CompanyDetailsEditModel>
@using HR.Infrastructure.Abstractions
@using HR.SharedKernel

<PageTitle>Edit Company</PageTitle>

<div class="container py-4">
    @if (IsLoading)
    {
        <HrLoadingIndicator />
    }
    else if (_company is null)
    {
        <div class="alert alert-danger">Company not found.</div>
    }
    else
    {
        <div class="d-flex align-items-center gap-3 mb-1">
            <h1 class="mb-0">@_company.Name</h1>
        </div>
        <p class="text-muted mb-4">Manage this company's profile and addresses.</p>

        @if (!string.IsNullOrEmpty(GlobalError))
        {
            <div class="alert alert-danger">@GlobalError</div>
        }

        <SfTab>
            <TabItems>
                <TabItem>
                    <ChildContent><TabHeader Text="Profile" /></ChildContent>
                    <ContentTemplate>
                        <div class="mt-4 @(IsViewMode ? "view-mode" : "")">
                            <EditForm EditContext="EditContext">
                                <DataAnnotationsValidator />
                                <NestedDataAnnotationsValidator />
                                <CompanyProfileTab Company="_company" Model="Model" />
                            </EditForm>
                        </div>
                    </ContentTemplate>
                </TabItem>
            </TabItems>
        </SfTab>

        @* Branding: hidden per product decision, not removed — CompanyBrandingTab itself is
           untouched, just not shown as its own tab for now. *@
        <div style="display:none" aria-hidden="true">
            <CompanyBrandingTab CompanyId="Id" Company="_company" CanEdit="!IsViewMode" />
        </div>

        <div class="mt-4 d-flex gap-2 align-items-center">
            @if (!string.IsNullOrEmpty(SuccessMsg))
            {
                <div class="alert alert-success py-2 mb-0 d-flex align-items-center">@SuccessMsg</div>
            }
            <div class="ms-auto d-flex gap-2">
                @if (!IsViewMode)
                {
                    <SfButton IsPrimary="true" Disabled="@(Saving || Session.IsReadOnly)" OnClick="SaveAsync">
                        @(Saving ? "Saving…" : "Save")
                    </SfButton>
                }
                <SfButton OnClick="RequestClose" Disabled="@Saving">Close</SfButton>
            </div>
        </div>
    }

    <NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges" />

    <UnsavedChangesDialog Visible="ShowUnsavedChangesDialog"
                          OnSaveAndClose="ConfirmSaveAndCloseAsync"
                          OnDiscard="DiscardChangesAndClose"
                          OnCancel="CancelCloseDialog" />
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private GetCompanyResponse? _company;

    protected override async Task LoadAsync()
    {
        // Editing (not just viewing) company profile/addresses is admin-only, matching the
        // "company:manage" policy that guards the underlying save endpoints.
        await Session.InitialiseAsync();
        if (!IsViewMode && !Session.CanManageCompany)
        {
            Navigation.NavigateTo(Session.MyProfileUrl, replace: true);
            return;
        }

        _company = await CompanyService.GetCompanyAsync(Id);
        if (_company is not null)
        {
            Model.Name = _company.Name;
            Model.Addresses = _company.Addresses.Select(a => new CompanyAddressEditModel
            {
                Type = a.Type,
                Line1 = a.Line1,
                Line2 = a.Line2,
                City = a.City,
                Region = a.Region,
                PostalCode = a.PostalCode,
                // Country Code is no longer user-editable (UK-only customers for now — see
                // CompanyProfileTab.razor's remarks) — always "GB" regardless of whatever the
                // stored value actually is, so existing addresses from before this change (or a
                // freshly provisioned company's default address) still save correctly.
                CountryCode = "GB",
                PostcodeRegexPattern = Session.PostcodeRegex
            }).ToList();
        }
    }

    protected override async Task<string?> SaveCoreAsync()
    {
        var profileReq = new UpdateCompanyRequest(
            Id, Model.Name,
            Model.Addresses.Select(a => new UpdateCompanyAddressRequest(
                a.Type, a.Line1, a.Line2, a.City, a.Region, a.PostalCode, a.CountryCode)).ToList());

        var (companyResult, companyError) = await CompanyService.UpdateCompanyAsync(Id, profileReq);
        if (companyResult is null)
            return companyError ?? "Failed to save company profile.";

        return null;
    }

    // No list page to navigate to on save — this page shows an inline success banner instead.
    protected override Task OnSavedAsync()
    {
        SuccessMsg = "Company saved successfully.";
        return Task.CompletedTask;
    }

    // Close navigates to the dashboard — there's no dedicated "company list" page.
    protected override string? ListUrl => "/";
}
