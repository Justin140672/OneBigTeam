@using HR.Web.Models

<div class="card">
    <div class="card-body">
        <h5 class="card-title mb-3">Brand Colors</h5>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label fw-semibold d-block mb-2">Primary Color</label>
                <SfColorPicker @bind-Value="Model.PrimaryColor" Mode="ColorPickerMode.Palette" ModeSwitcher="false" ShowButtons="false" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold d-block mb-2">Secondary Color</label>
                <SfColorPicker @bind-Value="Model.SecondaryColor" Mode="ColorPickerMode.Palette" ModeSwitcher="false" ShowButtons="false" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold d-block mb-2">Accent Color</label>
                <SfColorPicker @bind-Value="Model.AccentColor" Mode="ColorPickerMode.Palette" ModeSwitcher="false" ShowButtons="false" />
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CompanyBrandingEditModel Model { get; set; } = default!;
}
