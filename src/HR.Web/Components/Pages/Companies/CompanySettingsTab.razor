@inject CompanyService CompanyService
@inject AppSession Session
@inherits EditSectionBase<CompanySettingsEditModel>

@if (IsLoading)
{
    <HrLoadingIndicator />
}
else
{
    @if (!string.IsNullOrEmpty(GlobalError))
    {
        <div class="alert alert-danger mb-3">@GlobalError</div>
    }

    <EditForm EditContext="EditContext">
        <DataAnnotationsValidator />
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Company Settings</h5>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-12">
                        <label class="form-label fw-semibold">Regional</label>
                    </div>
                    <div class="col-md-4">
                        <HrTextBox @bind-Value="Model.TimeZone" Placeholder="Time Zone" />
                    </div>
                    <div class="col-md-4">
                        <HrTextBox @bind-Value="Model.Locale" Placeholder="Locale" />
                    </div>
                    @if (Session.CanManageEmployees)
                    {
                        <div class="col-12">
                            <hr />
                            <h6>Employee Timeline</h6>
                            <SfButton OnClick="OpenTimelineBackfillDialog">Backfill Employee Timeline…</SfButton>
                            <div class="form-text">
                                Generates historical timeline entries from existing employee data. Safe to re-run.
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </EditForm>

    <BackfillEmployeeTimelineDialog CompanyId="CompanyId"
                                     IsOpen="_timelineBackfillDialogOpen"
                                     OnClosed="@(() => _timelineBackfillDialogOpen = false)"
                                     OnCommitted="HandleTimelineBackfillCommittedAsync" />
}

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }

    protected override object? LoadKey => CompanyId;

    private bool _timelineBackfillDialogOpen;

    private void OpenTimelineBackfillDialog() => _timelineBackfillDialogOpen = true;

    private Task HandleTimelineBackfillCommittedAsync() => Task.CompletedTask;

    protected override async Task LoadAsync()
    {
        var settings = await CompanyService.GetCompanySettingsAsync(CompanyId);
        if (settings is not null)
        {
            Model.TimeZone = settings.TimeZone;
            Model.Locale = settings.Locale;
        }
    }

    protected override async Task<string?> SaveCoreAsync()
    {
        var request = new UpdateCompanySettingsRequest(CompanyId, Model.TimeZone, Model.Locale);

        var result = await CompanyService.UpdateCompanySettingsAsync(CompanyId, request);
        return result is not null ? null : "Failed to save company settings.";
    }
}
