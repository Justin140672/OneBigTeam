@using HR.Web.Models
@using HR.Web.Services
@inject EmployeeNumberBackfillService BackfillService

<SfDialog @bind-Visible="Visible" IsModal="true" Width="800px" ShowCloseIcon="true" CssClass="backfill-employee-numbers-dialog">
    <DialogEvents Closed="HandleDialogClosed" />
    <DialogTemplates>
        <Header>Backfill Employee Numbers</Header>
        <Content>
            @if (_loadingPreview)
            {
                <HrLoadingIndicator />
            }
            else
            {
                @if (_globalError is not null)
                {
                    <div class="alert alert-danger mb-3">@_globalError</div>
                }

                @if (_result is not null)
                {
                    <div class="alert alert-success mb-3">
                        Successfully assigned employee numbers to @_result.TotalCount employee(s).
                    </div>
                }
                else if (_globalError is null)
                {
                    @if (_candidates.Count == 0)
                    {
                        <p class="text-muted">There are no employees missing an employee number.</p>
                    }
                    else
                    {
                        <p class="text-muted">
                            The following @_candidates.Count employee(s) are missing an employee number and will be
                            assigned the number shown below, in start-date order.
                        </p>

                        <HrGrid TValue="BackfillCandidatePreviewModel" DataSource="@_candidates" AllowPaging="true" AllowSorting="true" class="mb-3">
                            <GridPageSettings PageSize="20" />
                            <GridColumns>
                                <GridColumn Field="@nameof(BackfillCandidatePreviewModel.FirstName)" HeaderText="First Name" Width="150" />
                                <GridColumn Field="@nameof(BackfillCandidatePreviewModel.LastName)" HeaderText="Last Name" Width="150" />
                                <GridColumn Field="@nameof(BackfillCandidatePreviewModel.StartDate)" HeaderText="Start Date" Width="130" Format="dd/MM/yyyy" />
                                <GridColumn Field="@nameof(BackfillCandidatePreviewModel.PredictedEmployeeNumber)" HeaderText="Predicted Employee Number" Width="180" />
                            </GridColumns>
                        </HrGrid>
                    }
                }
            }
        </Content>
        <FooterTemplate>
            @if (_result is null && (_loadingPreview || _candidates.Count > 0))
            {
                <SfButton IsPrimary="true"
                          Disabled="@(_loadingPreview || _committing || _globalError is not null)"
                          OnClick="ConfirmCommitAsync">
                    @if (_committing)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    Confirm Backfill
                </SfButton>
            }
            <SfButton OnClick="HandleCloseAsync">@(_result is null ? "Cancel" : "Close")</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }
    [Parameter] public EventCallback OnCommitted { get; set; }

    private bool Visible { get; set; }
    private bool _loadingPreview;
    private bool _committing;
    private List<BackfillCandidatePreviewModel> _candidates = [];
    private CommitBackfillEmployeeNumbersResponse? _result;
    private string? _globalError;

    protected override async Task OnParametersSetAsync()
    {
        var wasOpen = Visible;
        Visible = IsOpen;

        if (IsOpen && !wasOpen)
        {
            _result = null;
            _globalError = null;
            _candidates = [];
            await LoadPreviewAsync();
        }
    }

    private async Task LoadPreviewAsync()
    {
        _loadingPreview = true;
        try
        {
            var (result, error) = await BackfillService.PreviewAsync(CompanyId);
            if (result is null)
            {
                _globalError = error ?? "Unable to preview the employee number backfill.";
                _candidates = [];
                return;
            }

            _candidates = result.Candidates.ToList();
        }
        finally
        {
            _loadingPreview = false;
        }
    }

    private async Task ConfirmCommitAsync()
    {
        if (_candidates.Count == 0) return;

        _globalError = null;
        _committing = true;
        try
        {
            var (result, error) = await BackfillService.CommitAsync(CompanyId);

            if (result is null)
            {
                _globalError = error ?? "Unable to complete the employee number backfill.";
                return;
            }

            _result = result;
            await OnCommitted.InvokeAsync();
        }
        finally
        {
            _committing = false;
        }
    }

    private async Task HandleCloseAsync()
    {
        Visible = false;
        await OnClosed.InvokeAsync();
    }

    private Task HandleDialogClosed() => HandleCloseAsync();
}
