@page "/companies/{CompanyId:guid}/onboarding-templates/new"
@page "/companies/{CompanyId:guid}/onboarding-templates/{Id:guid}"
@page "/companies/{CompanyId:guid}/onboarding-templates/{Id:guid}/view"
@rendermode InteractiveServer
@inject OnboardingTemplateService OnboardingTemplateService
@inherits EditPageBase<OnboardingTemplateEditModel>

<PageTitle>@PageTitle</PageTitle>

<div class="container py-4">
    <HubBreadcrumb CompanyId="CompanyId"
                   Parent="@(("Onboarding Templates", $"/companies/{CompanyId}/onboarding-templates"))"
                   CurrentPage="@PageTitle" />

    @if (IsLoading)
    {
        <HrLoadingIndicator />
    }
    else
    {
        <h1 class="mb-1">@PageTitle</h1>
        <p class="text-muted mb-4">Define the name and the onboarding checklist tasks for this template.</p>

        @if (!string.IsNullOrEmpty(GlobalError))
        {
            <div class="alert alert-danger">@GlobalError</div>
        }

        <EditForm EditContext="EditContext">
            <DataAnnotationsValidator />
            <div class="row">
                <div class="col-lg-8">
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Template Details</h5>
                        </div>
                        <div class="card-body @(IsViewMode ? "view-mode" : "")">
                            <HrTextField Label="Name" Required="true"
                                         @bind-Value="Model.Name" Placeholder="e.g. Standard Engineering Onboarding" />
                            <HrTextField Label="Description"
                                         @bind-Value="Model.Description" Placeholder="Optional description" />
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header d-flex align-items-center">
                            <i class="fa-solid fa-list-check text-muted me-2"></i>
                            <h5 class="mb-0">Checklist Tasks</h5>
                            @if (!IsViewMode)
                            {
                                <div class="ms-auto">
                                    <SfButton CssClass="e-primary e-small" OnClick="AddTask">
                                        <i class="fa-solid fa-plus me-1"></i> Add Task
                                    </SfButton>
                                </div>
                            }
                        </div>
                        <div class="card-body">
                            <div class="hr-visually-hidden" aria-live="polite" aria-atomic="true" role="status">@_reorderAnnouncement</div>
                            @if (Model.Tasks.Count == 0)
                            {
                                <p class="text-muted small mb-0">No tasks configured for this template yet.</p>
                            }
                            else
                            {
                                <ul class="task-list list-unstyled mb-0">
                                    @for (var i = 0; i < Model.Tasks.Count; i++)
                                    {
                                        var index = i;
                                        var task = Model.Tasks[index];
                                        var expanded = ReferenceEquals(_expandedTask, task);
                                        var panelId = $"onboarding-task-panel-{index}";
                                        var titleText = string.IsNullOrWhiteSpace(task.Title) ? "Untitled task" : task.Title;
                                        <li class="task-item @(expanded ? "expanded" : "")">
                                            <div class="task-summary">
                                                <button type="button" class="task-disclosure" aria-expanded="@expanded"
                                                        aria-controls="@panelId" @onclick="() => ToggleExpand(task)">
                                                    <i class="fa-solid fa-chevron-right task-chevron"></i>
                                                    <span class="task-title-text">@titleText</span>
                                                    <span class="task-meta">@DueLabel(task)</span>
                                                    <span class="task-meta">@AssigneeLabel(task.AssignTo)</span>
                                                    <span class="task-meta task-priority">@task.Priority</span>
                                                </button>
                                                @if (!IsViewMode)
                                                {
                                                    <div class="task-move-controls">
                                                        <button type="button" class="task-icon-btn" @ref="_upRefs[index]"
                                                                aria-label="@($"Move '{titleText}' up")" disabled="@(index == 0)"
                                                                @onclick="() => MoveUp(index)">
                                                            <i class="fa-solid fa-arrow-up"></i>
                                                        </button>
                                                        <button type="button" class="task-icon-btn" @ref="_downRefs[index]"
                                                                aria-label="@($"Move '{titleText}' down")" disabled="@(index == Model.Tasks.Count - 1)"
                                                                @onclick="() => MoveDown(index)">
                                                            <i class="fa-solid fa-arrow-down"></i>
                                                        </button>
                                                        <label class="task-position">
                                                            <span class="hr-visually-hidden">Position for @titleText</span>
                                                            <input type="number" class="form-control form-control-sm task-position-input"
                                                                   min="1" max="@Model.Tasks.Count" value="@(index + 1)"
                                                                   @onchange="e => MoveToPosition(index, e.Value?.ToString())" />
                                                        </label>
                                                        <span class="task-position-of">of @Model.Tasks.Count</span>
                                                        <button type="button" class="task-icon-btn task-icon-btn-danger"
                                                                aria-label="@($"Remove '{titleText}'")" @onclick="() => RemoveTask(index)">
                                                            <i class="fa-solid fa-trash"></i>
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                            @if (expanded)
                                            {
                                                <div class="task-panel @(IsViewMode ? "view-mode" : "")" id="@panelId"
                                                     role="region" aria-label="@($"Edit task: {titleText}")">
                                                    <div class="row g-2">
                                                        <div class="col-md-8">
                                                            <HrTextField Label="Title" Required="true" LabelClass="form-label small"
                                                                         @bind-Value="task.Title" Placeholder="Task title" />
                                                        </div>
                                                        <div class="col-md-4">
                                                            <HrNumericField TValue="int" Label="Due Days After Start" LabelClass="form-label small"
                                                                            @bind-Value="task.DueDaysAfterStart" Min="0" />
                                                        </div>
                                                    </div>
                                                    <div class="row g-2 mt-1">
                                                        <div class="col-md-8">
                                                            <HrTextField Label="Description" LabelClass="form-label small"
                                                                         @bind-Value="task.Description" Placeholder="Optional description" />
                                                        </div>
                                                        <div class="col-md-2">
                                                            <HrDropDownField TValue="string" TItem="OptionChoice" Label="Priority"
                                                                             LabelClass="form-label small" AllowFiltering="false"
                                                                             DataSource="@PriorityOptions" ValueField="Value" TextField="Label"
                                                                             @bind-Value="task.Priority" />
                                                        </div>
                                                        <div class="col-md-2">
                                                            <HrDropDownField TValue="string" TItem="OptionChoice" Label="Assign To"
                                                                             LabelClass="form-label small" AllowFiltering="false"
                                                                             DataSource="@AssignToOptions" ValueField="Value" TextField="Label"
                                                                             @bind-Value="task.AssignTo" />
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>

                    <div class="d-flex gap-2 align-items-center mt-3 justify-content-end">
                        @if (!IsViewMode)
                        {
                            <SfButton IsPrimary="true" Disabled="@Saving" OnClick="SaveAsync">
                                @if (Saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                Save
                            </SfButton>
                        }
                        <SfButton OnClick="RequestClose" Disabled="@Saving">Close</SfButton>
                    </div>
                </div>
            </div>
        </EditForm>
    }

    <NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges" />

    <UnsavedChangesDialog Visible="ShowUnsavedChangesDialog"
                          OnSaveAndClose="ConfirmSaveAndCloseAsync"
                          OnDiscard="DiscardChangesAndClose"
                          OnCancel="CancelCloseDialog" />
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid? Id { get; set; }

    private bool IsNew => Id is null || Id == Guid.Empty;
    private string PageTitle => IsNew ? "Add Onboarding Template"
        : Model.Name.Trim().Length > 0 ? Model.Name
        : IsViewMode ? "View Onboarding Template" : "Edit Onboarding Template";

    public sealed record OptionChoice(string Value, string Label);

    private static readonly OptionChoice[] PriorityOptions =
    [
        new("Low", "Low"),
        new("Medium", "Medium"),
        new("High", "High"),
        new("Critical", "Critical"),
    ];

    private static readonly OptionChoice[] AssignToOptions =
    [
        new("Unassigned", "Unassigned"),
        new("NewHire", "New Hire"),
        new("Manager", "Manager"),
    ];

    protected override async Task LoadAsync()
    {
        if (!IsNew)
        {
            var template = await OnboardingTemplateService.GetOnboardingTemplateAsync(CompanyId, Id!.Value);
            if (template is not null)
            {
                Model.Name = template.Name;
                Model.Description = template.Description;
                Model.Tasks = template.Tasks
                    .OrderBy(t => t.DisplayOrder)
                    .Select(t => new OnboardingTemplateTaskEditModel
                    {
                        Id = t.Id,
                        Title = t.Title,
                        Description = t.Description,
                        Priority = t.Priority,
                        AssignTo = t.AssignTo,
                        DueDaysAfterStart = t.DueDaysAfterStart,
                        DisplayOrder = t.DisplayOrder,
                    })
                    .ToList();
            }
        }
    }

    private readonly Dictionary<int, ElementReference> _upRefs = new();
    private readonly Dictionary<int, ElementReference> _downRefs = new();
    private OnboardingTemplateTaskEditModel? _expandedTask;
    private string? _reorderAnnouncement;
    private int? _pendingFocusIndex;

    private void ToggleExpand(OnboardingTemplateTaskEditModel task)
        => _expandedTask = ReferenceEquals(_expandedTask, task) ? null : task;

    private static string DueLabel(OnboardingTemplateTaskEditModel t)
        => t.DueDaysAfterStart == 0
            ? "Due on start date"
            : $"Due {t.DueDaysAfterStart} day{(t.DueDaysAfterStart == 1 ? "" : "s")} after start";

    private static string AssigneeLabel(string value)
        => AssignToOptions.FirstOrDefault(o => o.Value == value)?.Label ?? value;

    private static string TitleOf(OnboardingTemplateTaskEditModel t)
        => string.IsNullOrWhiteSpace(t.Title) ? "Untitled task" : t.Title;

    private void AddTask()
    {
        var task = new OnboardingTemplateTaskEditModel { DisplayOrder = Model.Tasks.Count };
        Model.Tasks.Add(task);
        _expandedTask = task;
    }

    private void RemoveTask(int index)
    {
        if (ReferenceEquals(_expandedTask, Model.Tasks[index])) _expandedTask = null;
        Model.Tasks.RemoveAt(index);
        RenumberTasks();
    }

    private void MoveUp(int index)
    {
        if (index <= 0) return;
        (Model.Tasks[index - 1], Model.Tasks[index]) = (Model.Tasks[index], Model.Tasks[index - 1]);
        RenumberTasks();
        AfterMove(index - 1);
    }

    private void MoveDown(int index)
    {
        if (index >= Model.Tasks.Count - 1) return;
        (Model.Tasks[index + 1], Model.Tasks[index]) = (Model.Tasks[index], Model.Tasks[index + 1]);
        RenumberTasks();
        AfterMove(index + 1);
    }

    private void MoveToPosition(int index, string? raw)
    {
        if (!int.TryParse(raw, out var oneBased)) return;
        var target = Math.Clamp(oneBased - 1, 0, Model.Tasks.Count - 1);
        if (target == index) return;
        var task = Model.Tasks[index];
        Model.Tasks.RemoveAt(index);
        Model.Tasks.Insert(target, task);
        RenumberTasks();
        AfterMove(target);
    }

    private void AfterMove(int newIndex)
    {
        _reorderAnnouncement =
            $"Moved '{TitleOf(Model.Tasks[newIndex])}' to position {newIndex + 1} of {Model.Tasks.Count}";
        _pendingFocusIndex = newIndex;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingFocusIndex is int idx)
        {
            _pendingFocusIndex = null;
            // First task has "Move up" disabled, last has "Move down" disabled — focus the
            // button that's still operable so repeated presses keep working.
            var refs = idx == 0 ? _downRefs : _upRefs;
            if (refs.TryGetValue(idx, out var el))
            {
                try { await el.FocusAsync(); } catch { /* element gone after a later render */ }
            }
        }
    }

    private void RenumberTasks()
    {
        for (var i = 0; i < Model.Tasks.Count; i++)
            Model.Tasks[i].DisplayOrder = i;
    }

    protected override async Task<string?> SaveCoreAsync()
    {
        var taskItems = Model.Tasks
            .Select(t => new UpdateOnboardingTemplateTaskItem(
                t.Id,
                t.Title.Trim(),
                string.IsNullOrWhiteSpace(t.Description) ? null : t.Description.Trim(),
                t.Priority,
                t.AssignTo,
                t.DueDaysAfterStart,
                t.DisplayOrder))
            .ToList();

        if (IsNew)
        {
            var createRequest = new CreateOnboardingTemplateRequest(
                CompanyId,
                Model.Name.Trim(),
                string.IsNullOrWhiteSpace(Model.Description) ? null : Model.Description.Trim());

            var (created, createError) = await OnboardingTemplateService.CreateAsync(CompanyId, createRequest);
            if (created is null)
                return createError ?? "Failed to create onboarding template.";

            if (taskItems.Count == 0)
                return null;

            var updateRequest = new UpdateOnboardingTemplateRequest(
                CompanyId,
                created.Id,
                created.Name,
                created.Description,
                taskItems);

            var (_, updateError) = await OnboardingTemplateService.UpdateAsync(CompanyId, created.Id, updateRequest);
            return updateError;
        }
        else
        {
            var request = new UpdateOnboardingTemplateRequest(
                CompanyId,
                Id!.Value,
                Model.Name.Trim(),
                string.IsNullOrWhiteSpace(Model.Description) ? null : Model.Description.Trim(),
                taskItems);

            var (updated, error) = await OnboardingTemplateService.UpdateAsync(CompanyId, Id!.Value, request);
            return updated is not null ? null : error ?? "Failed to save onboarding template.";
        }
    }

    protected override string? ListUrl => $"/companies/{CompanyId}/onboarding-templates";
}
