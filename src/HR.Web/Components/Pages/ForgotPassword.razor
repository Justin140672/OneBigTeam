@page "/forgot-password"
@layout HR.Web.Components.Layout.LoginLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject PasswordResetService PasswordResetService

<PageTitle>Reset your password — One Big Team</PageTitle>

<div class="login-card">
    <div class="login-brand">
        <img src="/images/logo.png" alt="One Big Team" class="login-logo-img" />
    </div>

    @if (_submitted)
    {
        <h1 class="login-heading">Check your email</h1>
        <p class="login-subheading">
            If an account exists for <strong>@_form.Email</strong>, we've sent a link to reset
            your password. The link expires after a while, so use it soon.
        </p>

        <a href="/login" class="login-back-link" data-testid="back-to-login">Back to sign in</a>
    }
    else
    {
        <h1 class="login-heading">Reset your password</h1>
        <p class="login-subheading">Enter your email and we'll send you a link to reset your password.</p>

        <EditForm Model="_form" OnValidSubmit="SubmitAsync" FormName="forgot-password">
            <DataAnnotationsValidator />

            <div class="login-field">
                <label class="login-label">Email</label>
                <SfTextBox @bind-Value="_form.Email"
                           Placeholder="you@example.com"
                           Type="InputType.Email" />
                <ValidationMessage For="() => _form.Email" class="login-validation" />
            </div>

            <SfButton IsPrimary="true"
                      Type="ButtonType.Submit"
                      Disabled="@_busy"
                      CssClass="login-btn">
                @if (_busy)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                }
                Send reset link
            </SfButton>
        </EditForm>

        <a href="/login" class="login-back-link">Back to sign in</a>
    }
</div>

@code {
    private readonly ForgotPasswordForm _form = new();
    private bool _busy;
    private bool _submitted;

    private async Task SubmitAsync()
    {
        _busy = true;

        // Always shows the same "check your email" confirmation regardless of the actual result
        // — RequestPasswordResetHandler itself never reveals whether the email matched an
        // account (standard practice to avoid email enumeration), so there's nothing more
        // specific to tell the user here even on a request failure.
        await PasswordResetService.RequestResetAsync(_form.Email);

        _busy = false;
        _submitted = true;
    }

    private sealed class ForgotPasswordForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;
    }
}
