@page "/"
@rendermode InteractiveServer
@using HR.Web.Components.Pages.Tasks
@using HR.Web.Components.Pages.Probation
@using HR.Web.Components.Pages.Assets
@using HR.Web.Components.Pages.Sickness
@using HR.Web.Components.Pages.Recruitment
@using HR.Web.Components.Pages.Leave
@using HR.Web.Components.Pages.Employees
@using HR.Web.Components.Pages.Onboarding
@inject AppSession Session
@inject NavigationManager Navigation

<PageTitle>Dashboard</PageTitle>

@if (_ready)
{
    <div class="container-fluid py-4">
        <div class="dashboard-greeting mb-4">
            <h1 class="dashboard-heading">@Greeting(), @Session.FirstName</h1>
            <p class="text-muted mb-0">@DateTime.Now.ToString("dddd, d MMMM yyyy")</p>
        </div>

        <div class="dashboard-overview-row">
            <HeadcountByDepartmentChart />
            <HiringPipelineChart />
            <NewHiresTrendChart />
        </div>

        <section class="dashboard-section">
            <h2 class="dashboard-section-title">Tasks &amp; Leave</h2>
            <div class="dashboard-detail-grid">
                <HrInboxWidget />
                <MyTasksWidget />
                <MyOnboardingTasksWidget />
                <TeamTasksWidget />
                <LeaveRequestsWidget />
            </div>
        </section>

        <section class="dashboard-section">
            <h2 class="dashboard-section-title">People &amp; Wellbeing</h2>
            <div class="dashboard-detail-grid">
                <UpcomingProbationReviewsWidget />
                <TeamOnboardingWidget />
                <RecruitmentSummaryWidget />
                <MyAssetsWidget />
                <CurrentSicknessAbsenceWidget />
                <TeamSicknessTodayWidget />
                <OverdueReturnToWorkReviewsWidget />
                <MissingFitNotesWidget />
            </div>
        </section>
    </div>
}

@code {
    // Any authenticated employee lands on the dashboard — manager/HR-only widgets self-gate
    // on Session.CanManageEmployees (see RecruitmentSummaryWidget, HrInboxWidget,
    // UpcomingProbationReviewsWidget, and the overview charts). A signed-in user with no
    // linked employee record has nowhere else to land — MyProfileUrl already falls back to
    // "/" for that case, so no redirect is needed here.

    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        await Session.InitialiseAsync();

        // Company-Administrator-only users have no HR permissions and no dashboard to see —
        // send them straight to the Company edit screen instead.
        if (Session.CanManageCompany && !Session.CanManageEmployees)
        {
            Navigation.NavigateTo($"/companies/{Session.CompanyId}/edit", replace: true);
            return;
        }

        _ready = true;
    }

    private static string Greeting()
    {
        var hour = DateTime.Now.Hour;
        return hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    }
}
