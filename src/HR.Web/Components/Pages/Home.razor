@page "/"
@rendermode InteractiveServer
@using HR.Web.Components.Pages.Tasks
@using HR.Web.Components.Pages.Notifications
@using HR.Web.Components.Pages.Probation
@using HR.Web.Components.Pages.Assets
@inject AppSession Session

<PageTitle>Dashboard</PageTitle>

<div class="container-fluid py-4">
    <div class="dashboard-greeting mb-4">
        <h1 class="dashboard-heading">@Greeting(), @Session.FirstName</h1>
        <p class="text-muted mb-0">@DateTime.Now.ToString("dddd, d MMMM yyyy")</p>
    </div>

    <div class="row g-4">
        <div class="col-xl-5 col-lg-6">
            <MyTasksWidget />
        </div>
        <div class="col-xl-5 col-lg-6">
            <TeamTasksWidget />
        </div>
        <div class="col-xl-5 col-lg-6">
            <RecentNotificationsWidget />
        </div>
        <div class="col-xl-5 col-lg-6">
            <UpcomingProbationReviewsWidget />
        </div>
        <div class="col-xl-5 col-lg-6">
            <MyAssetsWidget />
        </div>
    </div>
</div>

@code {
    private static string Greeting()
    {
        var hour = DateTime.Now.Hour;
        return hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    }
}
