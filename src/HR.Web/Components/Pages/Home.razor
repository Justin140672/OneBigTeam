@page "/"
@rendermode InteractiveServer
@inject AppSession Session
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Dashboard</PageTitle>

<div class="app-loading">
    <div class="app-loading-spinner">
        <div class="spinner-border text-primary" role="status"></div>
        <span class="app-loading-label">Loading…</span>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await Session.InitialiseAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (!Session.IsLoaded)
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        var targetUrl = Session.LandingUrl;
        if (targetUrl != "/getting-started")
        {
            var lastDashboard = await JS.InvokeAsync<string>("getLastDashboard");

            if (!string.IsNullOrEmpty(lastDashboard) && Session.IsDashboardAvailable(lastDashboard))
                targetUrl = AppSession.DashboardUrl(lastDashboard) ?? targetUrl;
        }

        if (new Uri(Navigation.Uri).AbsolutePath != "/") return;

        Navigation.NavigateTo(targetUrl, replace: true);
    }
}
