@page "/"
@rendermode InteractiveServer
@using HR.Web.Components.Pages.Tasks
@using HR.Web.Components.Pages.Probation
@using HR.Web.Components.Pages.Assets
@using HR.Web.Components.Pages.Sickness
@using HR.Web.Components.Pages.Recruitment
@inject AppSession Session
@inject NavigationManager Navigation

<PageTitle>Dashboard</PageTitle>

<div class="container-fluid py-4">
    <div class="dashboard-greeting mb-4">
        <h1 class="dashboard-heading">@Greeting(), @Session.FirstName</h1>
        <p class="text-muted mb-0">@DateTime.Now.ToString("dddd, d MMMM yyyy")</p>
    </div>

    <section class="dashboard-section">
        <h2 class="dashboard-section-title">Tasks &amp; Inbox</h2>
        <div class="row g-4">
            <div class="col-xl-5 col-lg-6">
                <HrInboxWidget />
            </div>
            <div class="col-xl-5 col-lg-6">
                <MyTasksWidget />
            </div>
            <div class="col-xl-5 col-lg-6">
                <TeamTasksWidget />
            </div>
        </div>
    </section>

    <section class="dashboard-section">
        <h2 class="dashboard-section-title">People</h2>
        <div class="row g-4">
            <div class="col-xl-5 col-lg-6">
                <UpcomingProbationReviewsWidget />
            </div>
            <div class="col-xl-5 col-lg-6">
                <RecruitmentSummaryWidget />
            </div>
            <div class="col-xl-5 col-lg-6">
                <MyAssetsWidget />
            </div>
        </div>
    </section>

    <section class="dashboard-section">
        <h2 class="dashboard-section-title">Sickness &amp; Absence</h2>
        <div class="row g-4">
            <div class="col-xl-5 col-lg-6">
                <CurrentSicknessAbsenceWidget />
            </div>
            <div class="col-xl-5 col-lg-6">
                <TeamSicknessTodayWidget />
            </div>
            <div class="col-xl-5 col-lg-6">
                <OverdueReturnToWorkReviewsWidget />
            </div>
            <div class="col-xl-5 col-lg-6">
                <MissingFitNotesWidget />
            </div>
        </div>
    </section>
</div>

@code {
    protected override void OnInitialized()
    {
        if (!Session.CanManageEmployees)
            Navigation.NavigateTo(Session.MyProfileUrl, replace: true);
    }

    private static string Greeting()
    {
        var hour = DateTime.Now.Hour;
        return hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    }
}
