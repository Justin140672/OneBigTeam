@page "/"
@rendermode InteractiveServer
@inject AppSession Session
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Dashboard</PageTitle>

<div class="app-loading">
    <div class="app-loading-spinner">
        <div class="spinner-border text-primary" role="status"></div>
        <span class="app-loading-label">Loading…</span>
    </div>
</div>

@code {
    // Pure redirect shim — this route must stay alive because several existing call sites
    // hardcode NavigateTo("/") as "somewhere safe for any authenticated user":
    // MainLayout.OnPersonaSwitchAsync, Login.razor, TaskView.GoBack, MyProfile.razor's
    // cross-tenant guard, and AppSession.MyProfileUrl's own fallback for users with no
    // linked employee. Session.LandingUrl already encodes the full priority order
    // (HR Administrator > Recruiter > Manager > Company Administrator > own profile).
    //
    // The localStorage "last selected dashboard" override can only be read once JS interop is
    // available, which isn't the case yet in OnInitializedAsync (mirrors how MainLayout reads
    // the "theme" localStorage key in its own OnAfterRenderAsync) — so the redirect itself
    // happens in OnAfterRenderAsync(firstRender) below, not here.
    protected override async Task OnInitializedAsync()
    {
        await Session.InitialiseAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var lastDashboard = await JS.InvokeAsync<string>("getLastDashboard");

        // Fall back to the priority-ordered LandingUrl when there's no stored preference, or the
        // stored dashboard is no longer one the user is authorized for (e.g. a role was removed).
        var targetUrl = !string.IsNullOrEmpty(lastDashboard) && Session.IsDashboardAvailable(lastDashboard)
            ? AppSession.DashboardUrl(lastDashboard) ?? Session.LandingUrl
            : Session.LandingUrl;

        Navigation.NavigateTo(targetUrl, replace: true);
    }
}
