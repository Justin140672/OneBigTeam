@page "/companies/{CompanyId:guid}/vacancies"
@rendermode InteractiveServer
@inherits SearchPageBase<VacancyListItemModel>
@inject VacancyService VacancyService
@inject AppSession Session

<PageTitle>Vacancies</PageTitle>

<div class="container-fluid py-4">
    <a href="/dashboard/recruitment" class="text-decoration-none text-muted small">← Recruitment Dashboard</a>
    <h1 class="mb-1">Vacancies</h1>
    <p class="text-muted mb-3">Track open roles and their hiring progress.</p>

    <div class="mb-3 col-md-4 px-0">
        <HrTextBox Value="@SearchTerm"
                   ValueChanged="@OnSearchChanged"
                   Placeholder="Search by title or position profile" />
    </div>

    @if (IsLoading)
    {
        <HrLoadingIndicator Label="Loading vacancies…" />
    }
    else if (Error is not null)
    {
        <div class="alert alert-danger">@Error</div>
    }
    else
    {
        @if (ActionError is not null)
        {
            <div class="alert alert-danger alert-dismissible">
                @ActionError
                <button type="button" class="btn-close" @onclick="ClearActionError"></button>
            </div>
        }

        <HrGrid @ref="Grid"
                TValue="VacancyListItemModel"
                DataSource="@Items"
                Toolbar="@GridToolbar"
                AllowFiltering="true">
            <GridEvents TValue="VacancyListItemModel" OnToolbarClick="OnToolbarClick"
                        RowSelected="OnRowSelected" RowDeselected="OnRowDeselected" />
            <GridPageSettings PageSize="20" />
            <GridColumns>
                <GridColumn Field="@nameof(VacancyListItemModel.EffectiveTitle)" HeaderText="Title" Width="240">
                    <Template>
                        @{
                            var row = (context as VacancyListItemModel)!;
                        }
                        <a href="/companies/@CompanyId/vacancies/@row.Id">@row.EffectiveTitle</a>
                        @if (row.AdvertTitle is null)
                        {
                            <span class="text-muted fst-italic ms-1">(from Position Profile)</span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(VacancyListItemModel.PositionProfileTitle)" HeaderText="Position Profile" Width="200" />
                <GridColumn Field="@nameof(VacancyListItemModel.EffectiveLocation)" HeaderText="Location" Width="200" />
                <GridColumn Field="@nameof(VacancyListItemModel.ApplicationCount)" HeaderText="Applications" Width="120" TextAlign="TextAlign.Center" />
                <GridColumn Field="@nameof(VacancyListItemModel.Status)" HeaderText="Status" Width="130">
                    <Template>
                        @{
                            var row = (context as VacancyListItemModel)!;
                        }
                        <StatusBadge Variant="@StatusVariant(row.Status)">@EnumDisplay.Humanize(row.Status)</StatusBadge>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(VacancyListItemModel.OpenedAt)" HeaderText="Opened" Width="130" Format="d" />
                <GridColumn Field="@nameof(VacancyListItemModel.ClosedAt)" HeaderText="Closed" Width="130" Format="d" />
            </GridColumns>
        </HrGrid>
    }
</div>

@code {
    protected override Task OnBeforeLoadAsync()
    {
        if (!Session.IsRecruiter)
        {
            Navigation.NavigateTo(Session.MyProfileUrl, replace: true);
        }

        return Task.CompletedTask;
    }

    // Both search and the active/inactive ("exclude Closed") filter are now server-side (see
    // ListVacanciesRequest.Search/ExcludeClosed) — matching every other SearchPageBase list page
    // (e.g. EmployeeList, UserAdministrationList), which bind DataSource straight to the base
    // class's own Items and never filter client-side. Vacancy used to be the one exception,
    // reinventing filtering via a locally computed property bound to DataSource — a real bug, not
    // just a style inconsistency: Syncfusion's SfGrid rebinds and silently drops its own internal
    // row-selection state whenever DataSource's object reference changes, which a freshly
    // recomputed "Items.Where(...).ToList()" does on every single access — including the very
    // re-render OnRowSelected triggers right after a row is selected. The toolbar's Edit button
    // still looked enabled (driven by the base class's separate _hasSelection field, never reset
    // by this), but Grid.GetSelectedRecordsAsync() came back empty by click time, so
    // OnToolbarClick's "hr-edit" case silently no-opped.
    protected override async Task<IReadOnlyList<VacancyListItemModel>?> FetchItemsAsync(string? search)
    {
        var result = await VacancyService.ListVacanciesAsync(CompanyId, excludeClosed: !ShowInactive, search: search);
        return result?.Items;
    }

    // Vacancy doesn't have a plain IsActive bool like most SupportsActiveFilter entities (it has a
    // 5-value Status), so "inactive" here specifically means Closed — passed to the server as
    // ExcludeClosed above, same as ListDepartmentsRequest's ShowInactive.
    protected override bool SupportsActiveFilter => true;

    protected override string LoadErrorMessage => "Failed to load vacancies.";

    protected override string? GetAddUrl() => $"/companies/{CompanyId}/vacancies/new";
    protected override string? GetEditUrl(VacancyListItemModel item) => $"/companies/{CompanyId}/vacancies/{item.Id}";
    protected override string? GetViewUrl(VacancyListItemModel item) => $"/companies/{CompanyId}/vacancies/{item.Id}/view";

    private static StatusBadgeVariant StatusVariant(string status) => status switch
    {
        "Open" => StatusBadgeVariant.Success,
        "OnHold" => StatusBadgeVariant.Warning,
        "Closed" => StatusBadgeVariant.Secondary,
        "Cancelled" => StatusBadgeVariant.Danger,
        _ => StatusBadgeVariant.Info,
    };
}
