@page "/companies/{CompanyId:guid}/vacancies"
@rendermode InteractiveServer
@inherits SearchPageBase<VacancyListItemModel>
@inject VacancyService VacancyService
@inject PositionProfileService PositionProfileService
@inject DepartmentService DepartmentService
@inject AppSession Session

<PageTitle>Vacancies</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Vacancies</h1>
    <p class="text-muted mb-3">Track open roles and their hiring progress.</p>

    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <label class="form-label">Position Profile</label>
            <SfDropDownList TValue="Guid?" TItem="PositionProfileListItemModel"
                            DataSource="@_positionProfiles"
                            Value="@_positionProfileFilter"
                            Placeholder="All position profiles"
                            AllowFiltering="true"
                            ShowClearButton="true">
                <DropDownListFieldSettings Value="Id" Text="Title" />
                <DropDownListEvents TValue="Guid?" TItem="PositionProfileListItemModel" ValueChange="OnPositionProfileFilterChanged" />
            </SfDropDownList>
        </div>
        <div class="col-md-3">
            <label class="form-label">Department</label>
            <SfDropDownList TValue="Guid?" TItem="DepartmentListItemModel"
                            DataSource="@_departments"
                            Value="@_departmentFilter"
                            Placeholder="All departments"
                            AllowFiltering="true"
                            ShowClearButton="true">
                <DropDownListFieldSettings Value="Id" Text="Name" />
                <DropDownListEvents TValue="Guid?" TItem="DepartmentListItemModel" ValueChange="OnDepartmentFilterChanged" />
            </SfDropDownList>
        </div>
    </div>

    @if (IsLoading)
    {
        <HrLoadingIndicator Label="Loading vacancies…" />
    }
    else if (Error is not null)
    {
        <div class="alert alert-danger">@Error</div>
    }
    else
    {
        @if (ActionError is not null)
        {
            <div class="alert alert-danger alert-dismissible">
                @ActionError
                <button type="button" class="btn-close" @onclick="ClearActionError"></button>
            </div>
        }

        <HrGrid @ref="Grid"
                TValue="VacancyListItemModel"
                DataSource="@Items"
                Toolbar="@GridToolbar"
                AllowFiltering="true">
            <GridEvents TValue="VacancyListItemModel" OnToolbarClick="OnToolbarClick"
                        RowSelected="OnRowSelected" RowDeselected="OnRowDeselected" />
            <GridPageSettings PageSize="20" />
            <GridColumns>
                <GridColumn Field="@nameof(VacancyListItemModel.EffectiveTitle)" HeaderText="Title" Width="240">
                    <Template>
                        @{
                            var row = (context as VacancyListItemModel)!;
                        }
                        <a href="/companies/@CompanyId/vacancies/@row.Id">@row.EffectiveTitle</a>
                        @if (row.AdvertTitle is null)
                        {
                            <span class="text-muted fst-italic ms-1">(from Position Profile)</span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(VacancyListItemModel.PositionProfileTitle)" HeaderText="Position Profile" Width="200" />
                <GridColumn Field="@nameof(VacancyListItemModel.EffectiveLocation)" HeaderText="Location" Width="200" />
                <GridColumn Field="@nameof(VacancyListItemModel.Status)" HeaderText="Status" Width="130">
                    <Template>
                        @{
                            var row = (context as VacancyListItemModel)!;
                        }
                        <StatusBadge Variant="@StatusVariant(row.Status)">@row.Status</StatusBadge>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(VacancyListItemModel.OpenedAt)" HeaderText="Opened" Width="130" Format="d" />
                <GridColumn Field="@nameof(VacancyListItemModel.ClosedAt)" HeaderText="Closed" Width="130" Format="d" />
            </GridColumns>
        </HrGrid>
    }
</div>

@code {
    private List<PositionProfileListItemModel> _positionProfiles = [];
    private List<DepartmentListItemModel> _departments = [];
    private Guid? _positionProfileFilter;
    private Guid? _departmentFilter;

    protected override async Task OnBeforeLoadAsync()
    {
        if (!Session.IsRecruiter)
        {
            Navigation.NavigateTo(Session.MyProfileUrl, replace: true);
            return;
        }

        var positionProfilesTask = PositionProfileService.ListPositionProfilesAsync(CompanyId);
        var departmentsTask = DepartmentService.ListDepartmentsAsync(CompanyId);
        await Task.WhenAll(positionProfilesTask, departmentsTask);

        _positionProfiles = (await positionProfilesTask)?.Items.ToList() ?? [];
        _departments = (await departmentsTask)?.Items ?? [];
    }

    // Explicit typed ValueChange handlers rather than @bind-Value + a separate inline ValueChange
    // lambda — the two can fire in an order where the reload runs before the bound field has
    // actually been updated, reloading with the *previous* filter value (see EmployeeEdit.razor's
    // OnPositionProfileChanged for the same established pattern: set the field from args.Value
    // first, then reload, so there's no ambiguity about ordering).
    private async Task OnPositionProfileFilterChanged(ChangeEventArgs<Guid?, PositionProfileListItemModel> args)
    {
        _positionProfileFilter = args.Value;
        await LoadAsync();
    }

    private async Task OnDepartmentFilterChanged(ChangeEventArgs<Guid?, DepartmentListItemModel> args)
    {
        _departmentFilter = args.Value;
        await LoadAsync();
    }

    protected override async Task<IReadOnlyList<VacancyListItemModel>?> FetchItemsAsync(string? search)
    {
        var result = await VacancyService.ListVacanciesAsync(
            CompanyId, positionProfileId: _positionProfileFilter, departmentId: _departmentFilter);
        return result?.Items;
    }

    protected override string LoadErrorMessage => "Failed to load vacancies.";

    protected override string? GetAddUrl() => $"/companies/{CompanyId}/vacancies/new";
    protected override string? GetEditUrl(VacancyListItemModel item) => $"/companies/{CompanyId}/vacancies/{item.Id}";
    protected override string? GetViewUrl(VacancyListItemModel item) => $"/companies/{CompanyId}/vacancies/{item.Id}/view";

    private static StatusBadgeVariant StatusVariant(string status) => status switch
    {
        "Open" => StatusBadgeVariant.Success,
        "OnHold" => StatusBadgeVariant.Warning,
        "Closed" => StatusBadgeVariant.Secondary,
        "Cancelled" => StatusBadgeVariant.Danger,
        _ => StatusBadgeVariant.Info,
    };
}
