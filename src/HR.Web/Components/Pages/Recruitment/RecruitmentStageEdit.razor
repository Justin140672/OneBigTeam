@page "/companies/{CompanyId:guid}/recruitment-stages/new"
@page "/companies/{CompanyId:guid}/recruitment-stages/{Id:guid}"
@page "/companies/{CompanyId:guid}/recruitment-stages/{Id:guid}/view"
@rendermode InteractiveServer
@inject RecruitmentStageService RecruitmentStageService
@inject AppSession Session
@inject NavigationManager Navigation
@inherits EditPageBase<RecruitmentStageEditModel, Guid>

<PageTitle>@PageTitle</PageTitle>

<div class="container py-4">
    <SfBreadcrumb Class="mb-3">
        <BreadcrumbItems>
            <BreadcrumbItem Text="Administration" Url="@($"/companies/{CompanyId}/administration")" />
            <BreadcrumbItem Text="Recruitment Stages" Url="@($"/companies/{CompanyId}/recruitment-stages")" />
            <BreadcrumbItem Text="@PageTitle" />
        </BreadcrumbItems>
    </SfBreadcrumb>

    @if (IsLoading)
    {
        <HrLoadingIndicator />
    }
    else
    {
        <h1 class="mb-1">@PageTitle</h1>
        <p class="text-muted mb-4">Set the name and, if this is a final pipeline stage, which outcome it represents.</p>

        @if (!string.IsNullOrEmpty(GlobalError))
        {
            <div class="alert alert-danger">@GlobalError</div>
        }

        <EditForm EditContext="EditContext">
            <DataAnnotationsValidator />
            <div class="row">
                <div class="col-lg-7">
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Stage Details</h5>
                        </div>
                        <div class="card-body @(IsViewMode ? "view-mode" : "")">
                            <div class="mb-3">
                                <label class="form-label">Name <span class="text-danger">*</span></label>
                                <HrTextBox @bind-Value="Model.Name" Placeholder="e.g. Screening, Interview, Offered" />
                                <ValidationMessage For="@(() => Model.Name)" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Terminal Outcome <span class="text-danger">*</span></label>
                                <SfDropDownList TValue="RecruitmentStageTerminalOutcome" TItem="Option"
                                                DataSource="@_terminalOutcomeOptions"
                                                @bind-Value="Model.TerminalOutcome">
                                    <DropDownListFieldSettings Value="Value" Text="Label" />
                                </SfDropDownList>
                                <div class="form-text">
                                    Non-terminal stages should stay "None". Exactly one active stage must be marked
                                    "Hired" and exactly one active stage must be marked "Rejected".
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-3 justify-content-end">
                        @if (!IsViewMode)
                        {
                            <SfButton IsPrimary="true" Disabled="@Saving" OnClick="SaveAsync">
                                @if (Saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                Save
                            </SfButton>
                        }
                        <SfButton OnClick="RequestClose" Disabled="@Saving">Close</SfButton>
                    </div>
                </div>
            </div>
        </EditForm>
    }

    <NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges" />

    <UnsavedChangesDialog Visible="ShowUnsavedChangesDialog"
                          OnSaveAndClose="ConfirmSaveAndCloseAsync"
                          OnDiscard="DiscardChangesAndClose"
                          OnCancel="CancelCloseDialog" />
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid? Id { get; set; }

    private string PageTitle => IsNew ? "Add Recruitment Stage"
        : Model.Name.Trim().Length > 0 ? Model.Name
        : IsViewMode ? "View Recruitment Stage" : "Edit Recruitment Stage";

    // Required dropdown — no ShowClearButton/"None" clear affordance, per this codebase's
    // convention for required fields. "None" is instead a genuine, explicit list item here since
    // it's a real, meaningful value (a non-terminal stage), not a placeholder for "unset".
    private static readonly Option[] _terminalOutcomeOptions =
    [
        new(RecruitmentStageTerminalOutcome.None, "None"),
        new(RecruitmentStageTerminalOutcome.Hired, "Hired"),
        new(RecruitmentStageTerminalOutcome.Rejected, "Rejected"),
    ];

    protected override IEditService<RecruitmentStageEditModel, Guid> Service => RecruitmentStageService;
    protected override Guid GetCompanyId() => CompanyId;
    protected override Guid? GetId() => Id;

    protected override string? ListUrl => $"/companies/{CompanyId}/recruitment-stages";

    // Recruiter-only, matching RecruitmentStageList.razor's guard and the backend's
    // recruitment:manage policy — this page previously had no client-side check at all, so anyone
    // could reach it directly by URL even though the list page and dashboard button were gated.
    protected override Task OnLoadedAsync()
    {
        if (!Session.CanManageRecruitment)
            Navigation.NavigateTo("/access-denied", replace: true);
        return Task.CompletedTask;
    }

    private sealed record Option(RecruitmentStageTerminalOutcome Value, string Label);
}
