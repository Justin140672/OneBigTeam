@page "/companies/{CompanyId:guid}/recruitment-stages/new"
@page "/companies/{CompanyId:guid}/recruitment-stages/{Id:guid}"
@page "/companies/{CompanyId:guid}/recruitment-stages/{Id:guid}/view"
@rendermode InteractiveServer
@inject RecruitmentStageService RecruitmentStageService
@inject AppSession Session
@inherits EditPageBase<RecruitmentStageEditModel, Guid>

<PageTitle>@PageTitle</PageTitle>

<div class="container py-4">
    <SfBreadcrumb Class="mb-3">
        <BreadcrumbItems>
            <BreadcrumbItem Text="Recruitment Stages" Url="@($"/companies/{CompanyId}/recruitment-stages")" />
            <BreadcrumbItem Text="@PageTitle" />
        </BreadcrumbItems>
    </SfBreadcrumb>

    @if (IsLoading)
    {
        <HrLoadingIndicator />
    }
    else
    {
        <h1 class="mb-1">@PageTitle</h1>
        <p class="text-muted mb-4">Set the stage name and choose whether it marks a candidate as hired or rejected.</p>

        <SaveConflictBanner Visible="SaveConflict" Disabled="@Saving" OnReload="ReloadLatestValuesAsync"
                            Message="Someone else changed this recruitment stage while you were editing. Your changes have not been saved." />

        @if (!SaveConflict && !string.IsNullOrEmpty(GlobalError))
        {
            <div class="alert alert-danger">@GlobalError</div>
        }

        <EditForm EditContext="EditContext">
            <DataAnnotationsValidator />
            <div class="row">
                <div class="col-lg-7">
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Stage Details</h5>
                        </div>
                        <div class="card-body @(IsViewMode ? "view-mode" : "")">
                            <div class="mb-3">
                                <HrTextField Label="Name" Required="true" Id="stage-name" @bind-Value="Model.Name"
                                             Placeholder="e.g. Screening, Interview, Offered" />
                            </div>
                            <div class="mb-3">
                                <HrDropDownField TValue="RecruitmentStageTerminalOutcome" TItem="Option"
                                                 Label="Terminal Outcome" Required="true" Id="stage-terminal-outcome"
                                                 DataSource="@_terminalOutcomeOptions"
                                                 @bind-Value="Model.TerminalOutcome"
                                                 ValueField="Value" TextField="Label"
                                                 HelpText="Non-terminal stages should stay &quot;None&quot;. Exactly one active stage must be marked &quot;Hired&quot; and exactly one active stage must be marked &quot;Rejected&quot;." />
                            </div>
                            @if (!Model.IsTerminal)
                            {
                                <div class="mb-3">
                                    <HrDropDownField TValue="RecruitmentStagePurpose?" TItem="PurposeOption"
                                                     Label="Purpose" Id="stage-purpose"
                                                     DataSource="@_purposeOptions"
                                                     @bind-Value="Model.Purpose"
                                                     ValueField="Value" TextField="Label"
                                                     HelpText="Tags this stage as the one recruitment dashboard metrics count for new applications, interviews or offers. Optional; more than one stage may share a purpose. Terminal stages cannot have a purpose." />
                                </div>
                            }
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-3 justify-content-end">
                        @if (!IsViewMode)
                        {
                            <SfButton IsPrimary="true" Disabled="@(Saving || IsSubscriptionReadOnly)" OnClick="SaveAsync">
                                @if (Saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                Save
                            </SfButton>
                        }
                        <SfButton OnClick="RequestClose" Disabled="@Saving">@(IsViewMode ? "Back to recruitment stages" : "Cancel")</SfButton>
                    </div>
                </div>
            </div>
        </EditForm>
    }

    <NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges" />

    <UnsavedChangesDialog Visible="ShowUnsavedChangesDialog"
                          Message="You have unsaved changes. Save them, discard them, or stay on this page to keep editing."
                          StayText="Stay on page"
                          DiscardText="Discard changes"
                          OnSaveAndClose="ConfirmSaveAndCloseAsync"
                          OnDiscard="DiscardChangesAndClose"
                          OnCancel="CancelCloseDialog" />
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid? Id { get; set; }

    private string PageTitle => IsNew ? "Add Recruitment Stage"
        : Model.Name.Trim().Length > 0 ? Model.Name
        : IsViewMode ? "View Recruitment Stage" : "Edit Recruitment Stage";

    private static readonly Option[] _terminalOutcomeOptions =
    [
        new(RecruitmentStageTerminalOutcome.None, "None"),
        new(RecruitmentStageTerminalOutcome.Hired, "Hired"),
        new(RecruitmentStageTerminalOutcome.Rejected, "Rejected"),
    ];

    private static readonly PurposeOption[] _purposeOptions =
    [
        new(null, "None"),
        new(RecruitmentStagePurpose.NewApplication, "New application"),
        new(RecruitmentStagePurpose.Interview, "Interview"),
        new(RecruitmentStagePurpose.Offer, "Offer"),
        new(RecruitmentStagePurpose.CvReview, "CV review"),
    ];

    protected override IEditService<RecruitmentStageEditModel, Guid> Service => RecruitmentStageService;
    protected override Guid GetCompanyId() => CompanyId;
    protected override Guid? GetId() => Id;

    protected override string? ListUrl => $"/companies/{CompanyId}/recruitment-stages";

    protected override string? InvalidFieldFocusScope => "form";

    protected override Task OnLoadedAsync()
    {
        if (!Session.CanManageRecruitment)
            Navigation.NavigateTo("/access-denied", replace: true);
        return Task.CompletedTask;
    }

    private sealed record Option(RecruitmentStageTerminalOutcome Value, string Label);

    private sealed record PurposeOption(RecruitmentStagePurpose? Value, string Label);
}
