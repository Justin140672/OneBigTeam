@inject VacancyService VacancyService
@inject AppSession Session

@if (Session.CanManageEmployees || Session.IsRecruiter)
{
    <div class="widget-card chart-tile">
        <div class="widget-header">
            <i class="fa-solid fa-filter widget-icon"></i>
            <span class="widget-title">Hiring Pipeline</span>
            <a href="/companies/@Session.CompanyId/candidates" class="widget-view-all ms-auto">
                View all<i class="fa-solid fa-arrow-right fa-xs" aria-hidden="true"></i>
            </a>
        </div>

        <div class="widget-body">
            @if (_loading)
            {
                <HrLoadingIndicator Label="Loading pipeline…" />
            }
            else if (_data.Count == 0)
            {
                <div class="widget-empty">
                    <i class="fa-solid fa-user-tie fa-lg mb-2"></i>
                    <p class="mb-0">No applications in the pipeline</p>
                </div>
            }
            else
            {
                <SfAccumulationChart Title="" Height="280px" Background="transparent">
                    <AccumulationChartLegendSettings Visible="true" Position="LegendPosition.Right" />
                    <AccumulationChartSeriesCollection>
                        <AccumulationChartSeries DataSource="@_data"
                                                  XName="@nameof(FunnelStage.Label)"
                                                  YName="@nameof(FunnelStage.Value)"
                                                  PointColorMapping="@nameof(FunnelStage.Fill)"
                                                  Type="AccumulationType.Funnel">
                            <AccumulationDataLabelSettings Visible="true" Name="@nameof(FunnelStage.Value)" />
                        </AccumulationChartSeries>
                    </AccumulationChartSeriesCollection>
                    <AccumulationChartEvents OnPointClick="OnStageClicked" />
                </SfAccumulationChart>

                @* DSH-07: text alternative for the Syncfusion funnel (SVG has no accessible data). *@
                <details class="chart-data-table">
                    <summary>View pipeline as a table</summary>
                    <div class="dashboard-scroll-x">
                        <table>
                            <caption>Applications by pipeline stage</caption>
                            <thead>
                                <tr><th scope="col">Stage</th><th scope="col">Applications</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var stage in _data)
                                {
                                    <tr><td>@stage.Label</td><td>@stage.Value</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }
        </div>
    </div>

    <ApplicationsByStatusDialog CompanyId="Session.CompanyId"
                                 StageId="_selectedStageId"
                                 StageName="_selectedStageName"
                                 IsOpen="_dialogOpen"
                                 OnClosed="@(() => _dialogOpen = false)" />
}

@code {
    private static readonly string[] Palette =
    [
        "#0f766e", "#0d9488", "#eab308", "#f97316", "#6366f1", "#16a34a"
    ];

    private bool _loading = true;
    private List<FunnelStage> _data = [];
    private Guid? _selectedStageId;
    private string? _selectedStageName;
    private bool _dialogOpen;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.CanManageEmployees && !Session.IsRecruiter)
        {
            _loading = false;
            return;
        }

        // GetPipelineSummary already returns the company's active, non-terminal stages in
        // DisplayOrder (Rejected/Hired etc. excluded server-side) — no client-side reordering needed.
        var result = await VacancyService.GetPipelineSummaryAsync(Session.CompanyId);

        _data = (result?.Items ?? [])
            .Select((item, index) => new FunnelStage(
                item.StageId,
                item.Status,
                item.ApplicationCount,
                Palette[index % Palette.Length]))
            .ToList();

        _loading = false;
    }

    private void OnStageClicked(AccumulationPointEventArgs args)
    {
        if (args.PointIndex < 0 || args.PointIndex >= _data.Count) return;

        _selectedStageId = _data[args.PointIndex].StageId;
        _selectedStageName = _data[args.PointIndex].Label;
        _dialogOpen = true;
    }

    // "Status" here holds the stage's display name (GetPipelineSummary's PipelineSummaryItem.Status
    // field name is retained as-is from the backend, but functionally it is the stage's Name).
    private sealed record FunnelStage(Guid StageId, string Label, int Value, string Fill);
}
