@page "/companies/{CompanyId:guid}/recruitment-stages"
@rendermode InteractiveServer
@inherits SearchPageBase<RecruitmentStageListItem>
@inject RecruitmentStageService RecruitmentStageService
@inject AppSession Session

<PageTitle>Recruitment Stages</PageTitle>

<div class="container-fluid py-4">
    <HubBreadcrumb CompanyId="@CompanyId" CurrentPage="Recruitment Stages" />
    <a href="/dashboard/recruitment" class="text-decoration-none text-muted small">← Recruitment Dashboard</a>
    <h1 class="mb-1">Recruitment Stages</h1>
    <p class="text-muted mb-3">Configure the pipeline stages applicants move through, and mark which stages represent a Hired or Rejected outcome.</p>

    @if (IsLoading)
    {
        <HrLoadingIndicator Label="Loading recruitment stages…" />
    }
    else if (Error is not null)
    {
        <div class="alert alert-danger">@Error</div>
    }
    else
    {
        @if (ActionError is not null)
        {
            <div class="alert alert-danger alert-dismissible">
                @ActionError
                <button type="button" class="btn-close" @onclick="ClearActionError"></button>
            </div>
        }

        <HrGrid @ref="Grid"
                TValue="RecruitmentStageListItem"
                DataSource="@Items"
                Toolbar="@GridToolbar"
                AllowPaging="true"
                AllowSorting="true">
            <GridEvents TValue="RecruitmentStageListItem" OnToolbarClick="OnToolbarClick"
                        RowSelected="OnRowSelected" RowDeselected="OnRowDeselected" />
            <GridPageSettings PageSize="20" />
            <GridColumns>
                <GridColumn Field="@nameof(RecruitmentStageListItem.DisplayOrder)" HeaderText="Order" Width="90" />
                <GridColumn Field="@nameof(RecruitmentStageListItem.Name)" HeaderText="Name" Width="220">
                    <Template>
                        @{
                            var row = (context as RecruitmentStageListItem)!;
                            <a href="/companies/@CompanyId/recruitment-stages/@row.Id">@row.Name</a>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(RecruitmentStageListItem.IsActive)" HeaderText="Status" Width="110">
                    <Template>
                        @{
                            var row = (context as RecruitmentStageListItem)!;
                            <ActiveStatusBadge IsActive="row.IsActive" />
                        }
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Terminal Outcome" Width="150">
                    <Template>
                        @{
                            var row = (context as RecruitmentStageListItem)!;
                        }
                        <StatusBadge Variant="@TerminalOutcomeVariant(row.TerminalOutcome)">@row.TerminalOutcome</StatusBadge>
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Purpose" Width="140">
                    <Template>
                        @{
                            var row = (context as RecruitmentStageListItem)!;
                        }
                        @if (row.Purpose is { } purpose)
                        {
                            <StatusBadge Variant="StatusBadgeVariant.Info">@PurposeLabel(purpose)</StatusBadge>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Reorder" Width="140">
                    <Template>
                        @{
                            var row = (context as RecruitmentStageListItem)!;
                        }
                        <SfButton CssClass="e-outline e-small me-1"
                                Disabled="@(row.DisplayOrder <= 1)"
                                OnClick="() => MoveUpAsync(row)" title="Move up">
                            <i class="fa-solid fa-arrow-up"></i>
                        </SfButton>
                        <SfButton CssClass="e-outline e-small"
                                Disabled="@(row.DisplayOrder >= Items.Count)"
                                OnClick="() => MoveDownAsync(row)" title="Move down">
                            <i class="fa-solid fa-arrow-down"></i>
                        </SfButton>
                    </Template>
                </GridColumn>
            </GridColumns>
        </HrGrid>

        <p class="text-muted small mt-2">@Items.Count stage(s)</p>
    }
</div>

<SfDialog Visible="_deactivateConfirmOpen" IsModal="true" Width="420px" ShowCloseIcon="false">
    <DialogTemplates>
        <Header>Deactivate Stage</Header>
        <Content>
            @if (_deactivateTarget is not null)
            {
                <p>
                    "@_deactivateTarget.Name" is currently the stage of
                    @_deactivateUsage?.ActiveVacancyCount active vacanc@(_deactivateUsage?.ActiveVacancyCount == 1 ? "y" : "ies")@(":")
                </p>
                @if (_deactivateUsage?.VacancyLabels.Count > 0)
                {
                    <ul>
                        @foreach (var label in _deactivateUsage.VacancyLabels)
                        {
                            <li>@label</li>
                        }
                    </ul>
                }
                <p class="mb-0">
                    You can still deactivate it — applications already on this stage will not be affected —
                    but it will no longer be selectable for new moves. Continue?
                </p>
            }
        </Content>
        <FooterTemplate>
            <SfButton CssClass="e-danger" Disabled="_deactivating" OnClick="ConfirmDeactivateAsync">Deactivate</SfButton>
            <SfButton Disabled="_deactivating" OnClick="CancelDeactivate">Cancel</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<HrConfirmDialog Visible="@(_simpleDeactivateTarget is not null)"
                 Title="Deactivate Stage"
                 Message="@($"Are you sure you want to deactivate '{_simpleDeactivateTarget?.Name}'?")"
                 ConfirmText="Deactivate"
                 CancelText="Cancel"
                 Busy="_deactivating"
                 OnConfirmed="ConfirmSimpleDeactivateAsync"
                 OnCancelled="@(() => _simpleDeactivateTarget = null)" />

@code {
    private bool _deactivateConfirmOpen;
    private bool _deactivating;
    private RecruitmentStageListItem? _deactivateTarget;
    private GetRecruitmentStageUsageResponse? _deactivateUsage;
    private RecruitmentStageListItem? _simpleDeactivateTarget;
    protected override bool SupportsActiveFilter => true;

    protected override Task OnBeforeLoadAsync()
    {
        // Recruiter-only, matching the backend's recruitment:manage policy (CreateRecruitmentStage/
        // UpdateRecruitmentStage/ReorderRecruitmentStages/SetRecruitmentStageActiveStatus) — an HR
        // Administrator does not automatically get recruitment access, by deliberate design (see
        // IdentityModule.cs's recruitment:manage policy comment). CanManageEmployees was too broad
        // here and let HR Administrators reach this page directly even though the Recruitment
        // Dashboard's own "Recruitment Settings" button is already Recruiter-only.
        if (!Session.CanManageRecruitment)
            Navigation.NavigateTo("/access-denied", replace: true);
        return Task.CompletedTask;
    }

    protected override void ConfigureToolbar()
    {
        AddToolbarAction(
            id:      "hr-activate",
            text:    "Activate",
            icon:    "fa-solid fa-circle-check",
            onClick: async item =>
            {
                if (item.IsActive) return;
                await SetActiveStatus(item, true);
            },
            tooltip: "Activate selected stage");

        AddToolbarAction(
            id:      "hr-deactivate",
            text:    "Deactivate",
            icon:    "fa-solid fa-circle-xmark",
            onClick: async item =>
            {
                if (!item.IsActive) return;
                await SetActiveStatus(item, false);
            },
            tooltip: "Deactivate selected stage");
    }

    protected override async Task<IReadOnlyList<RecruitmentStageListItem>?> FetchItemsAsync(string? search)
    {
        var result = await RecruitmentStageService.ListStagesAsync(CompanyId);
        var items = result?.Items;
        if (items is null) return null;

        var ordered = items.OrderBy(i => i.DisplayOrder).ToList();
        return ShowInactive ? ordered : ordered.Where(i => i.IsActive).ToList();
    }

    protected override string LoadErrorMessage => "Failed to load recruitment stages.";

    protected override string? GetAddUrl()  => $"/companies/{CompanyId}/recruitment-stages/new";
    protected override string? GetEditUrl(RecruitmentStageListItem item) => $"/companies/{CompanyId}/recruitment-stages/{item.Id}";
    protected override string? GetViewUrl(RecruitmentStageListItem item) => $"/companies/{CompanyId}/recruitment-stages/{item.Id}/view";

    private static string PurposeLabel(RecruitmentStagePurpose purpose) => purpose switch
    {
        RecruitmentStagePurpose.NewApplication => "New application",
        RecruitmentStagePurpose.Interview => "Interview",
        RecruitmentStagePurpose.Offer => "Offer",
        _ => purpose.ToString(),
    };

    private static StatusBadgeVariant TerminalOutcomeVariant(RecruitmentStageTerminalOutcome outcome) => outcome switch
    {
        RecruitmentStageTerminalOutcome.Hired => StatusBadgeVariant.Success,
        RecruitmentStageTerminalOutcome.Rejected => StatusBadgeVariant.Danger,
        _ => StatusBadgeVariant.Secondary,
    };

    private async Task SetActiveStatus(RecruitmentStageListItem item, bool isActive)
    {
        ClearActionError();

        // Deactivating never breaks anything (the stage row is preserved, just hidden from new
        // selection — see SetRecruitmentStageActiveStatusHandler), but if any active vacancy's
        // applications currently sit on this stage, warn the user first rather than deactivating
        // silently. Activating never needs this check.
        if (!isActive)
        {
            var usage = await RecruitmentStageService.GetUsageAsync(CompanyId, item.Id);
            if (usage is { InUse: true })
            {
                _deactivateTarget = item;
                _deactivateUsage = usage;
                _deactivateConfirmOpen = true;
                return;
            }

            // Not in use — still confirm before deactivating, just without the usage warning.
            _simpleDeactivateTarget = item;
            return;
        }

        await ApplyActiveStatusAsync(item, isActive);
    }

    private async Task ConfirmDeactivateAsync()
    {
        if (_deactivateTarget is null) return;

        _deactivating = true;
        await ApplyActiveStatusAsync(_deactivateTarget, false);
        _deactivating = false;
        _deactivateConfirmOpen = false;
        _deactivateTarget = null;
        _deactivateUsage = null;
    }

    private void CancelDeactivate()
    {
        _deactivateConfirmOpen = false;
        _deactivateTarget = null;
        _deactivateUsage = null;
    }

    private async Task ConfirmSimpleDeactivateAsync()
    {
        if (_simpleDeactivateTarget is null) return;

        _deactivating = true;
        await ApplyActiveStatusAsync(_simpleDeactivateTarget, false);
        _deactivating = false;
        _simpleDeactivateTarget = null;
    }

    private async Task ApplyActiveStatusAsync(RecruitmentStageListItem item, bool isActive)
    {
        var (result, error) = await RecruitmentStageService.SetActiveStatusAsync(CompanyId, item.Id, isActive);
        if (result is null)
            SetActionError(error);
        else
            await LoadAsync();
    }

    // Move-up/down is the reorder mechanism (no drag-drop precedent found in this codebase's grid
    // usage) — recompute the full ordered id list (including inactive stages, since the reorder
    // endpoint reassigns DisplayOrder 1..N by list position for every stage) and send it whole.
    private async Task MoveUpAsync(RecruitmentStageListItem item) => await MoveAsync(item, -1);

    private async Task MoveDownAsync(RecruitmentStageListItem item) => await MoveAsync(item, 1);

    private async Task MoveAsync(RecruitmentStageListItem item, int delta)
    {
        ClearActionError();

        // Reorder must operate on the full set (active + inactive) in true DisplayOrder, regardless
        // of the current "show inactive" filter applied to Items — the endpoint requires every one
        // of the company's stages to be present in the submitted list, with no omissions.
        var all = await RecruitmentStageService.ListStagesAsync(CompanyId);
        if (all?.Items is null) return;

        var ordered = all.Items.OrderBy(i => i.DisplayOrder).ToList();
        var index = ordered.FindIndex(i => i.Id == item.Id);
        if (index < 0) return;

        // The swap target must be the nearest neighbour that's actually VISIBLE in the current grid
        // (active-only unless "Show inactive" is on), not simply the physically adjacent stage in
        // raw DisplayOrder. Otherwise, when an inactive stage happens to sit immediately next to this
        // one, swapping with it silently reassigns DisplayOrder server-side while leaving the visible
        // grid's row order completely unchanged — "Move up"/"Move down" then appears to do nothing.
        bool IsVisible(RecruitmentStageListItem candidate) => ShowInactive || candidate.IsActive;

        var targetIndex = index + delta;
        while (targetIndex >= 0 && targetIndex < ordered.Count && !IsVisible(ordered[targetIndex]))
            targetIndex += delta;

        if (targetIndex < 0 || targetIndex >= ordered.Count) return;

        var orderedIds = ordered.Select(i => i.Id).ToList();
        (orderedIds[index], orderedIds[targetIndex]) = (orderedIds[targetIndex], orderedIds[index]);

        var (result, error) = await RecruitmentStageService.ReorderAsync(CompanyId, orderedIds);
        if (result is null)
            SetActionError(error);
        else
            await LoadAsync();
    }
}
