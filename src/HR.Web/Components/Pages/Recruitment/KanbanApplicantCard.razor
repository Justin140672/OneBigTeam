@* Card template used inside VacancyKanbanBoard's SfKanban. Rendered once per applicant. *@
<div class="kanban-applicant-card @StageCssClass" @onclick="() => OnOpen.InvokeAsync(Applicant)">
    <div class="kanban-applicant-card__top">
        <ProfilePhotoAvatar PhotoUrl="@Applicant.CandidatePhotoUrl" Initials="@Initials" SizePx="36" />
        <div class="kanban-applicant-card__name-block">
            <div class="kanban-applicant-card__name">@Applicant.CandidateFullName</div>
            <div class="kanban-applicant-card__vacancy text-muted">@Applicant.VacancyTitle</div>
        </div>
        <StatusBadge Variant="@StatusVariant">@Applicant.StageName</StatusBadge>
    </div>
    <div class="kanban-applicant-card__meta">
        <span><i class="fa-regular fa-calendar me-1"></i>Applied @Applicant.AppliedAt.ToString("d MMM yyyy")</span>
        <span><i class="fa-regular fa-user me-1"></i>@RecruiterName</span>
        @if (Applicant.IsWithdrawn)
        {
            <span class="kanban-applicant-card__withdrawn"><i class="fa-solid fa-circle-minus me-1"></i>Withdrawn</span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public KanbanApplicantModel Applicant { get; set; } = default!;
    [Parameter] public string RecruiterName { get; set; } = "Unassigned";
    // StageId -> TerminalOutcome lookup result for this applicant's current stage, resolved by the
    // parent board (see VacancyKanbanBoard's _stageOutcomes) — None for non-terminal stages.
    [Parameter] public RecruitmentStageTerminalOutcome TerminalOutcome { get; set; } = RecruitmentStageTerminalOutcome.None;
    [Parameter] public EventCallback<KanbanApplicantModel> OnOpen { get; set; }

    private string Initials =>
        $"{(Applicant.CandidateFirstName.Length > 0 ? Applicant.CandidateFirstName[0] : '?')}{(Applicant.CandidateLastName.Length > 0 ? Applicant.CandidateLastName[0] : '?')}"
            .ToUpperInvariant();

    // Withdrawn/Rejected/Hired get a visually distinct accent — see StatusBadge for the badge itself,
    // this is the card container accent (danger/success border). IsWithdrawn takes priority over
    // the stage's terminal outcome since a withdrawn application can sit under any stage (see
    // Applicant.IsWithdrawn's remarks) and that fact is more relevant to a recruiter scanning the
    // board than which stage it happened to be on when withdrawn. Withdrawn now shares Rejected's
    // "danger" treatment (same as VacancyApplicationsTab's grid StatusVariant) rather than a
    // separate muted/secondary style, so both views are visually consistent.
    private string StageCssClass =>
        Applicant.IsWithdrawn ? "kanban-applicant-card--danger"
        : TerminalOutcome switch
        {
            RecruitmentStageTerminalOutcome.Hired => "kanban-applicant-card--success",
            RecruitmentStageTerminalOutcome.Rejected => "kanban-applicant-card--danger",
            _ => string.Empty,
        };

    private StatusBadgeVariant StatusVariant =>
        Applicant.IsWithdrawn ? StatusBadgeVariant.Danger
        : TerminalOutcome switch
        {
            RecruitmentStageTerminalOutcome.Hired => StatusBadgeVariant.Success,
            RecruitmentStageTerminalOutcome.Rejected => StatusBadgeVariant.Danger,
            _ => StatusBadgeVariant.Info,
        };
}
