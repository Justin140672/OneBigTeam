@page "/companies/{CompanyId:guid}/vacancies/{VacancyId:guid}/kanban"
@rendermode InteractiveServer
@inject AppSession Session
@inject NavigationManager Navigation

<PageTitle>Recruitment Kanban</PageTitle>

<div class="container-fluid py-4">
    <a href="/companies/@CompanyId/vacancies/@VacancyId" class="text-decoration-none text-muted small kanban-back-link">← Back to Vacancy</a>
    <h1 class="mb-3 mt-1">Recruitment Kanban</h1>

    <VacancyKanbanBoard CompanyId="CompanyId" VacancyId="VacancyId" @bind-SearchText="_searchText" />
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid VacancyId { get; set; }

    private string _searchText = string.Empty;

    // Recruiter-only, matching the backend's GetRecruitmentKanban policy (recruitment:manage) —
    // the Kanban board is an operational recruiting tool, not general vacancy visibility.
    protected override void OnInitialized()
    {
        if (!Session.IsRecruiter)
            Navigation.NavigateTo(Session.MyProfileUrl, replace: true);
    }
}
