@using HR.Infrastructure.Abstractions
@using HR.Modules.Tasks.Contracts
@using HR.Web.Components.Pages.Dashboards
@inject VacancyService VacancyService
@inject InterviewService InterviewService
@inject TaskService TaskService
@inject WidgetSourceLoader SourceLoader
@inject NavigationManager Navigation
@inject AppSession Session

@if (Session.CanManageEmployees || Session.IsRecruiter)
{
    @if (_loading)
    {
        <div class="widget-card">
            <div class="widget-header">
                <i class="fa-solid fa-user-tie widget-icon"></i>
                <span class="widget-title">Recruitment</span>
            </div>
            <div class="widget-body d-flex align-items-center gap-2 py-3 px-3">
                <HrLoadingIndicator />
            </div>
        </div>
    }
    else
    {
        <div class="widget-card">
            <div class="widget-header">
                <i class="fa-solid fa-user-tie widget-icon"></i>
                <span class="widget-title">Recruitment</span>
                <a href="/companies/@Session.CompanyId/vacancies" class="widget-view-all ms-auto">
                    View all<i class="fa-solid fa-arrow-right fa-xs" aria-hidden="true"></i>
                </a>
            </div>

            @foreach (var name in FailedSources())
            {
                var n = name;
                <WidgetSourceWarning SourceName="@n" Retrying="_retrying.Contains(n)" OnRetry="() => RetryAsync(n)" />
            }

            <div class="widget-kpi-row">
                <div class="widget-kpi widget-kpi--link" @onclick="NavigateToVacancies">
                    <span class="widget-kpi-value">@Display(_vacanciesRes, _openVacancies)</span>
                    <span class="widget-kpi-label">Open Vacancies</span>
                </div>
                <div class="widget-kpi">
                    <span class="widget-kpi-value">@Display(_interviewsRes, _interviewsToday)</span>
                    <span class="widget-kpi-label">Interviews Today</span>
                </div>
                <div class="widget-kpi @(_feedbackRes.IsLoaded && _outstandingFeedbackTasks > 0 ? "widget-kpi--danger" : "")">
                    <span class="widget-kpi-value">@Display(_feedbackRes, _outstandingFeedbackTasks)</span>
                    <span class="widget-kpi-label">Outstanding Feedback Tasks</span>
                </div>
            </div>
        </div>
    }
}

@code {
    private const string SrcVacancies = "Open vacancies";
    private const string SrcInterviews = "Interviews today";
    private const string SrcFeedback = "Feedback tasks";
    private const string WidgetName = "Recruitment summary";

    private readonly string[] _sourceNames = [SrcVacancies, SrcInterviews, SrcFeedback];
    private readonly HashSet<string> _retrying = [];

    private bool _loading = true;

    private WidgetResult<ListVacanciesResponse?> _vacanciesRes = WidgetResult<ListVacanciesResponse?>.Loading(SrcVacancies);
    private WidgetResult<GetInterviewsTodayCountResponse?> _interviewsRes = WidgetResult<GetInterviewsTodayCountResponse?>.Loading(SrcInterviews);
    private WidgetResult<GetOutstandingTaskCountResponse?> _feedbackRes = WidgetResult<GetOutstandingTaskCountResponse?>.Loading(SrcFeedback);

    private int _openVacancies;
    private int _interviewsToday;
    private int _outstandingFeedbackTasks;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.CanManageEmployees && !Session.IsRecruiter)
        {
            _loading = false;
            return;
        }

        await Task.WhenAll(_sourceNames.Select(LoadSourceAsync));
        _loading = false;
    }

    private async Task LoadSourceAsync(string name)
    {
        switch (name)
        {
            case SrcVacancies:
                _vacanciesRes = await SourceLoader.LoadAsync(WidgetName, name,
                    () => VacancyService.ListVacanciesOrThrowAsync(Session.CompanyId, status: "Open"));
                _openVacancies = _vacanciesRes.IsLoaded ? _vacanciesRes.Value?.Items.Count ?? 0 : 0;
                break;
            case SrcInterviews:
                _interviewsRes = await SourceLoader.LoadAsync(WidgetName, name,
                    () => InterviewService.GetInterviewsTodayCountOrThrowAsync(Session.CompanyId));
                _interviewsToday = _interviewsRes.IsLoaded ? _interviewsRes.Value?.Count ?? 0 : 0;
                break;
            case SrcFeedback:
                _feedbackRes = await SourceLoader.LoadAsync(WidgetName, name,
                    () => TaskService.GetOutstandingTaskCountOrThrowAsync(
                        Session.CompanyId, TaskSource.Recruitment, TaskActionType.Complete));
                _outstandingFeedbackTasks = _feedbackRes.IsLoaded ? _feedbackRes.Value?.Count ?? 0 : 0;
                break;
        }
    }

    private async Task RetryAsync(string name)
    {
        _retrying.Add(name);
        StateHasChanged();
        await LoadSourceAsync(name);
        _retrying.Remove(name);
    }

    private IEnumerable<string> FailedSources()
    {
        if (_vacanciesRes.IsFailed) yield return SrcVacancies;
        if (_interviewsRes.IsFailed) yield return SrcInterviews;
        if (_feedbackRes.IsFailed) yield return SrcFeedback;
    }

    private static string Display<T>(WidgetResult<T> result, int value) => result.IsFailed ? "—" : value.ToString();

    private void NavigateToVacancies() =>
        Navigation.NavigateTo($"/companies/{Session.CompanyId}/vacancies");
}
