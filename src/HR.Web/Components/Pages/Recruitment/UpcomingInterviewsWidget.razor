@inject InterviewService InterviewService
@inject NavigationManager Navigation
@inject AppSession Session

@if (Session.CanManageEmployees || Session.IsRecruiter)
{
    @if (_loading)
    {
        <div class="widget-card">
            <div class="widget-header">
                <i class="fa-solid fa-calendar-check widget-icon"></i>
                <span class="widget-title">Upcoming Interviews</span>
            </div>
            <div class="widget-body d-flex align-items-center gap-2 py-3 px-3">
                <HrLoadingIndicator />
            </div>
        </div>
    }
    else
    {
        <div class="widget-card">
            <div class="widget-header">
                <i class="fa-solid fa-calendar-check widget-icon"></i>
                <span class="widget-title">Upcoming Interviews</span>
                @if (_items.Count > 0)
                {
                    <span class="widget-count-badge">@_items.Count</span>
                }
            </div>

            <div class="widget-body">
                @if (_items.Count == 0)
                {
                    <div class="widget-empty">
                        <i class="fa-solid fa-circle-check fa-lg mb-2"></i>
                        <p class="mb-0">No upcoming interviews</p>
                    </div>
                }
                else
                {
                    @foreach (var item in _items.Take(6))
                    {
                        var interview = item;
                        var url = $"/companies/{Session.CompanyId}/vacancies/{interview.VacancyId}";
                        <div @key="interview.InterviewId" class="task-widget-item" @onclick="() => Navigation.NavigateTo(url)">
                            <div class="task-widget-content">
                                <span class="task-widget-title">@interview.CandidateName</span>
                                <span class="task-widget-meta">@interview.VacancyTitle@(interview.Location is null ? "" : $" · {interview.Location}")</span>
                            </div>
                            <span class="due-badge due-badge--normal">@interview.ScheduledAt.ToLocalTime().ToString("d MMM, HH:mm")</span>
                        </div>
                    }
                }
            </div>
        </div>
    }
}

@code {
    private bool _loading = true;
    private IReadOnlyList<UpcomingInterviewItem> _items = [];

    protected override async Task OnInitializedAsync()
    {
        if (!Session.CanManageEmployees && !Session.IsRecruiter)
        {
            _loading = false;
            return;
        }

        var result = await InterviewService.GetUpcomingInterviewsAsync(Session.CompanyId);
        _items = result?.Items ?? [];
        _loading = false;
    }
}
