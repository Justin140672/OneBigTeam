@inject ApplicationService ApplicationService
@inject RecruitmentStageService RecruitmentStageService
@inject VacancyService VacancyService
@inject NavigationManager Navigation
@inject AppSession Session

@if (Session.CanManageEmployees || Session.IsRecruiter)
{
    @if (_loading)
    {
        <div class="widget-card">
            <div class="widget-header">
                <i class="fa-solid fa-file-signature widget-icon"></i>
                <span class="widget-title">Offers &amp; Recent Hires</span>
            </div>
            <div class="widget-body d-flex align-items-center gap-2 py-3 px-3">
                <HrLoadingIndicator />
            </div>
        </div>
    }
    else
    {
        <div class="widget-card">
            <div class="widget-header">
                <i class="fa-solid fa-file-signature widget-icon"></i>
                <span class="widget-title">Offers &amp; Recent Hires</span>
                @if (_offers.Count > 0)
                {
                    <span class="widget-count-badge">@_offers.Count</span>
                }
            </div>

            <div class="widget-body">
                <div class="task-widget-section-label">Offers Awaiting Response</div>
                @if (_offers.Count == 0)
                {
                    <div class="widget-empty">
                        <i class="fa-solid fa-circle-check fa-lg mb-2"></i>
                        <p class="mb-0">No offers awaiting a response</p>
                    </div>
                }
                else
                {
                    @foreach (var item in _offers.Take(5))
                    {
                        var app = item;
                        var url = $"/companies/{Session.CompanyId}/vacancies/{app.VacancyId}";
                        <div class="task-widget-item" @onclick="() => Navigation.NavigateTo(url)">
                            <div class="task-widget-content">
                                <span class="task-widget-title">@app.CandidateName</span>
                                <span class="task-widget-meta">@app.VacancyTitle</span>
                            </div>
                            <span class="due-badge due-badge--soon">Offered</span>
                        </div>
                    }
                }

                @if (_recentHires.Count > 0)
                {
                    <div class="task-widget-section-label mt-2">Recently Hired</div>
                    @foreach (var item in _recentHires.Take(5))
                    {
                        var app = item;
                        var url = $"/companies/{Session.CompanyId}/vacancies/{app.VacancyId}";
                        <div class="task-widget-item" @onclick="() => Navigation.NavigateTo(url)">
                            <div class="task-widget-content">
                                <span class="task-widget-title">@app.CandidateName</span>
                                <span class="task-widget-meta">@app.VacancyTitle</span>
                            </div>
                            <span class="due-badge due-badge--approved">Hired</span>
                        </div>
                    }
                }
            </div>
        </div>
    }
}

@code {
    private bool _loading = true;
    private IReadOnlyList<RecruitmentMetricApplicationItem> _offers = [];
    private IReadOnlyList<ApplicationByStatusItem> _recentHires = [];

    protected override async Task OnInitializedAsync()
    {
        if (!Session.CanManageEmployees && !Session.IsRecruiter)
        {
            _loading = false;
            return;
        }

        var stagesResult = await RecruitmentStageService.ListStagesAsync(Session.CompanyId);
        var stages = stagesResult?.Items ?? [];

        // "Hired" has a reliable data-driven signal — the stage(s) whose TerminalOutcome == Hired
        // (there is normally exactly one, enforced by HireCandidateHandler's "no active 'Hired'
        // terminal recruitment stage configured" check).
        //
        // DSH-04: "Offers awaiting response" now comes from the authoritative metric endpoint
        // (applications across every stage carrying purpose = Offer), replacing the old
        // last-non-terminal-stage-by-DisplayOrder inference.
        var hiredStageIds = stages.Where(s => s.TerminalOutcome == RecruitmentStageTerminalOutcome.Hired).Select(s => s.Id).ToList();

        var offersTask = VacancyService.GetOffersAwaitingResponseMetricAsync(Session.CompanyId);

        var hireTasks = hiredStageIds.Select(id => ApplicationService.GetApplicationsByStatusAsync(Session.CompanyId, id)).ToList();

        var offersResult = await offersTask;
        var hireResults = await Task.WhenAll(hireTasks);

        _offers = offersResult?.Items ?? [];
        // "Recent hires" stands in for "upcoming start dates" — Recruitment doesn't own an
        // Employee start date once hired, so the most recent hire transitions are the closest
        // proxy available without crossing into the Employees module's data.
        _recentHires = hireResults.Where(r => r is not null).SelectMany(r => r!.Items).ToList();
        _loading = false;
    }
}
