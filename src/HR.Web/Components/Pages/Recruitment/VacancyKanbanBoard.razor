@using Syncfusion.Blazor.Inputs
@inject RecruitmentKanbanService KanbanService
@inject RecruitmentStageService RecruitmentStageService
@inject CandidateService CandidateService
@inject NavigationManager Navigation

<div class="vacancy-kanban-board" data-testid="vacancy-kanban-board">
    @if (ShowToolbar)
    {
        <div class="vacancy-kanban-board__toolbar mb-3">
            <HrTextBox Placeholder="Search by name or email…"
                       Value="@SearchText"
                       ValueChange="OnSearchChanged"
                       CssClass="vacancy-kanban-board__search"
                       data-testid="kanban-search-box" />
            @if (_vacancyTitle is not null)
            {
                <a href="/companies/@CompanyId/vacancies/@VacancyId" class="vacancy-kanban-board__vacancy-link">@_vacancyTitle</a>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger alert-dismissible" data-testid="kanban-error">
            @_error
            <button type="button" class="btn-close" @onclick="() => _error = null"></button>
        </div>
    }

    @if (_loading)
    {
        <HrLoadingIndicator Label="Loading Kanban board…" />
    }
    else
    {
        <SfKanban TValue="KanbanApplicantModel"
                  DataSource="@FilteredCards"
                  KeyField="StageKey"
                  Height="640px"
                  CssClass="vacancy-kanban-board__kanban">
            <KanbanCardSettings>
                <Template>
                    @{
                        var applicant = (KanbanApplicantModel)context;
                    }
                    <KanbanApplicantCard Applicant="applicant"
                                         RecruiterName="@RecruiterName(applicant)"
                                         TerminalOutcome="@StageOutcome(applicant.StageId)"
                                         OnOpen="OpenApplicant" />
                </Template>
            </KanbanCardSettings>
            <KanbanColumns>
                @foreach (var column in VisibleColumns)
                {
                    <KanbanColumn HeaderText="@column.StageName" KeyField="@(new List<string> { column.StageId.ToString() })" ShowItemCount="true" />
                }
            </KanbanColumns>
            <KanbanEvents TValue="KanbanApplicantModel" DragStop="OnDragStopAsync" CardClick="OnCardClickAsync" />
        </SfKanban>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public Guid VacancyId { get; set; }

    // Session-scoped "remember filters" — the search text lives in the parent (Dashboard) when this
    // component is reused there, so it survives switching between Kanban/List views without a new
    // persistence mechanism. Falls back to local state when used standalone (e.g. the Vacancy Detail
    // tab) via the getter/setter pair below.
    [Parameter] public string SearchText { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SearchTextChanged { get; set; }

    // UI-only toggle (no backend change) — the Kanban response already tags every column with
    // IsTerminal (see KanbanColumnModel), so hiding Hired/Rejected columns is a pure client-side
    // filter of the already-loaded _columns/FilteredCards. Defaults to false (terminal columns
    // hidden) per the dashboard redesign brief, so a recruiter's default board view stays focused
    // on in-flight applicants; callers that want the old "always show everything" behaviour can
    // pass ShowTerminalStages="true".
    //
    // IMPORTANT for any embedding site: this parameter's default is "hide terminal columns," which
    // is only correct for RecruitmentDashboard.razor's own "Show Hired / Rejected columns"
    // checkbox-driven usage. VacancyDetail.razor's Kanban tab and the standalone VacancyKanbanPage
    // route both predate this parameter and have no toggle of their own — they must always pass
    // ShowTerminalStages="true" explicitly to preserve their original "show every configured
    // stage, including Hired/Rejected" behaviour. Omitting it there silently drops the Hired/
    // Rejected columns entirely (not just hides applicants in them) — this exact regression broke
    // VacancyKanbanBoardTests.Board_RendersOneColumnPerConfiguredStage_InDisplayOrder_
    // IncludingEmptyColumns when this parameter was first introduced.
    [Parameter] public bool ShowTerminalStages { get; set; }

    // UI-only toggle — when the board is embedded in a page that already renders its own search
    // box / vacancy context above the board (RecruitmentDashboard.razor's unified toolbar row),
    // the board's own internal toolbar would be a redundant duplicate. Defaults to true so
    // standalone callers (VacancyDetail's Kanban tab, VacancyKanbanPage) keep their existing
    // toolbar unchanged.
    [Parameter] public bool ShowToolbar { get; set; } = true;

    private bool _loading = true;
    private string? _error;
    private string? _vacancyTitle;
    private List<KanbanApplicantModel> _cards = [];
    private List<KanbanColumnModel> _columns = [];
    private Dictionary<Guid, string> _candidateEmails = [];

    // StageId -> TerminalOutcome lookup for Hired=success/Rejected=danger card accent styling — the
    // Kanban response's KanbanColumn.IsTerminal alone can't distinguish Hired from Rejected, so this
    // is built once per board load from the ticket #100 stages list endpoint instead (better UX than
    // falling back to a generic "terminal" accent for both outcomes).
    private Dictionary<Guid, RecruitmentStageTerminalOutcome> _stageOutcomes = [];

    protected override async Task OnParametersSetAsync()
    {
        if (_prevVacancyId != VacancyId)
        {
            _prevVacancyId = VacancyId;
            await LoadAsync();
        }
    }

    private Guid _prevVacancyId;

    private Task LoadAsync() => LoadAsync(showSpinner: true);

    // Full three-way load (Kanban + candidates + stages) — required on initial load since none of
    // _candidateEmails / _stageOutcomes are populated yet. Drag-and-drop reloads use the lighter
    // ReloadKanbanOnlyAsync below instead, since candidates/stages don't change when a card moves.
    private async Task LoadAsync(bool showSpinner)
    {
        if (showSpinner) _loading = true;
        _error = null;

        var kanbanTask = KanbanService.GetKanbanAsync(CompanyId, VacancyId);
        // Bulk-loaded once so the search box can match candidate email — the Kanban response itself
        // only carries name/stage/dates (see GetRecruitmentKanbanResponse), no email or employee
        // number field. See report: this is a known contract gap for ticket #69's email/employee
        // number search scope.
        var candidatesTask = CandidateService.ListCandidatesAsync(CompanyId, pageSize: 200);
        // Only needed for the StageId -> TerminalOutcome lookup used by card styling — reused rather
        // than re-fetched from scratch every board load isn't worth the added caching complexity
        // here since a Kanban board load is already a multi-request operation.
        var stagesTask = RecruitmentStageService.ListStagesAsync(CompanyId);

        await Task.WhenAll(kanbanTask, candidatesTask, stagesTask);

        var kanban = await kanbanTask;
        if (kanban is null)
        {
            _error = "Failed to load the recruitment Kanban board.";
            _cards = [];
            _columns = [];
            if (showSpinner) _loading = false;
            return;
        }

        _vacancyTitle = kanban.VacancyTitle;
        _columns = kanban.Columns.ToList();
        _cards = kanban.Columns.SelectMany(c => c.Applicants).ToList();

        var candidates = (await candidatesTask)?.Items ?? [];
        _candidateEmails = candidates.ToDictionary(c => c.Id, c => c.Email);

        var stages = (await stagesTask)?.Items ?? [];
        _stageOutcomes = stages.ToDictionary(s => s.Id, s => s.TerminalOutcome);

        if (showSpinner) _loading = false;
    }

    // Kanban-only reload used after drag-and-drop — reuses the already-cached _candidateEmails and
    // _stageOutcomes dictionaries instead of re-fetching candidates/stages, since neither changes
    // when a card's stage moves. Swapping the whole board out for a spinner on every drop would be
    // jarring, so the refresh always happens quietly (no spinner) and the grid just re-renders with
    // the corrected (or confirmed) card positions once the fresh data arrives.
    private async Task ReloadKanbanOnlyAsync()
    {
        _error = null;

        var kanban = await KanbanService.GetKanbanAsync(CompanyId, VacancyId);
        if (kanban is null)
        {
            _error = "Failed to load the recruitment Kanban board.";
            _cards = [];
            _columns = [];
            return;
        }

        _vacancyTitle = kanban.VacancyTitle;
        _columns = kanban.Columns.ToList();
        _cards = kanban.Columns.SelectMany(c => c.Applicants).ToList();
    }

    private RecruitmentStageTerminalOutcome StageOutcome(Guid stageId) =>
        _stageOutcomes.GetValueOrDefault(stageId, RecruitmentStageTerminalOutcome.None);

    private IEnumerable<KanbanColumnModel> VisibleColumns =>
        ShowTerminalStages ? _columns : _columns.Where(c => !c.IsTerminal);

    private IEnumerable<KanbanApplicantModel> FilteredCards
    {
        get
        {
            var visibleStageIds = VisibleColumns.Select(c => c.StageId).ToHashSet();
            var cards = _cards.Where(c => visibleStageIds.Contains(c.StageId));

            if (string.IsNullOrWhiteSpace(SearchText))
                return cards;

            var term = SearchText.Trim();
            return cards.Where(c =>
                c.CandidateFullName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (_candidateEmails.TryGetValue(c.CandidateId, out var email) &&
                 email.Contains(term, StringComparison.OrdinalIgnoreCase)));
        }
    }

    private static string RecruiterName(KanbanApplicantModel applicant) =>
        applicant.AssignedRecruiterAgencyName ?? "Unassigned";

    private async Task OnSearchChanged(Syncfusion.Blazor.Inputs.ChangedEventArgs args)
    {
        SearchText = args.Value ?? string.Empty;
        await SearchTextChanged.InvokeAsync(SearchText);
    }

    private async Task OpenApplicant(KanbanApplicantModel applicant)
    {
        // Carry a returnUrl so CandidateDetail.razor's "Close" button comes back to wherever this
        // board is actually embedded (the standalone Kanban route, the Vacancy Detail tab, or the
        // Recruitment Dashboard's Board view) instead of always falling back to the plain Candidate
        // List — previously the card click had no memory of where it was opened from.
        var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);

        var candidateUrl = $"/companies/{CompanyId}/candidates/{applicant.CandidateId}" +
            $"?returnUrl={Uri.EscapeDataString(returnUrl)}";
        Navigation.NavigateTo(candidateUrl);
    }

    private Task OnCardClickAsync(CardClickEventArgs<KanbanApplicantModel> args) =>
        args.Data is null ? Task.CompletedTask : OpenApplicant(args.Data);

    // Judgement call: DragStop (not DragStart/Dragging) is the hook — by the time it fires, Syncfusion
    // has already updated args.Data's KeyField (StageKey) to the target column's key, and
    // args.PreviousCardData holds the pre-drag record, so both the "from" and "to" stage are available
    // without any extra bookkeeping. Ticket #99/#101 deleted the whole client-side transition graph
    // (ApplicationStatusTransitionRules) since the server now validates transitions dynamically
    // per-company (arbitrary stage configuration, no fixed pipeline) — there is no equivalent
    // client-side rule left to pre-check, so every drop is sent straight to the server and its 422
    // response (if any) is surfaced via _error.
    //
    // Unlike an earlier version of this handler, args.Cancel is NOT set unconditionally on every
    // drop anymore. That unconditional-cancel-and-full-reload approach was a workaround for a real
    // symptom (a duplicated/stuck card after drop) — but the actual root cause turned out to be that
    // KanbanApplicantModel had no field named "Id" (see its remarks), which Syncfusion's Kanban
    // engine needs to reconcile a dragged card against a freshly reloaded DataSource. Without it,
    // replacing the DataSource after every drop couldn't be matched back to the card mid-drag,
    // leaving its drag clone stuck floating instead of settling into the target column (reproduced
    // via DraggingCard_MovesApplicationToTargetStage_AndPersistsAcrossReload). Now that every card
    // has a stable Id, the widget can complete its own drop normally: we let it, then only correct
    // the board (via a full reload) if the server actually rejects the move.
    private async Task OnDragStopAsync(Syncfusion.Blazor.Kanban.DragEventArgs<KanbanApplicantModel> args)
    {
        var moved = args.Data?.FirstOrDefault();
        var previous = args.PreviousCardData?.FirstOrDefault();

        if (moved is null || previous is null)
            return;

        // SfKanban mutates the dropped card's bound KeyField (StageKey) to the target column's key
        // on drop — moved.StageId itself is never touched by the widget and still reflects the
        // *source* stage at this point, so the actual target must be read back out of StageKey
        // instead (see KanbanApplicantModel.StageKey's remarks for why it was silently unsettable
        // before, which made every drag a no-op that only looked like it worked client-side).
        if (!Guid.TryParse(moved.StageKey, out var targetStageId) || targetStageId == previous.StageId)
            return;

        var (result, error) = await KanbanService.MoveApplicationStageAsync(CompanyId, VacancyId, moved.ApplicationId, targetStageId);

        if (result is null)
        {
            _error = error ?? "Failed to move applicant to the new stage.";
            // Server rejected the move — cancel the widget's own optimistic placement and resync
            // with the server's real (unchanged) state so the card snaps back to where it actually is.
            args.Cancel = true;
            await ReloadKanbanOnlyAsync();
            return;
        }

        _error = null;
        // Success: the widget already placed the card in its target column itself. Still refresh in
        // the background so stage name/badge/terminal-outcome styling (which the widget doesn't know
        // about) catch up with the move.
        await ReloadKanbanOnlyAsync();
    }
}
