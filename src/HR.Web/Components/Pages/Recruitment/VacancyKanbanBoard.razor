@inject AppSession Session
@using Syncfusion.Blazor.Inputs
@inject RecruitmentKanbanService KanbanService
@inject RecruitmentStageService RecruitmentStageService
@inject CandidateService CandidateService
@inject NavigationManager Navigation

@* Plain HTML5 drag-and-drop board — replaces an earlier SfKanban-based implementation. SfKanban's
   own JS drag engine couldn't be made to reliably complete a drop under Blazor Server's re-render
   cycle (drags would stick mid-air instead of settling into the target column, reproduced by
   DraggingCard_MovesApplicationToTargetStage_AndPersistsAcrossReload); native draggable/dragover/
   drop DOM events are handled entirely by Blazor's own event dispatch, with no separate JS-side
   drag state to fall out of sync with the server-rendered DOM. *@
<div class="vacancy-kanban-board" data-testid="vacancy-kanban-board">
    @if (ShowToolbar)
    {
        <div class="vacancy-kanban-board__toolbar mb-3">
            <HrTextBox Placeholder="Search by name or email…"
                       Value="@SearchText"
                       ValueChange="OnSearchChanged"
                       CssClass="vacancy-kanban-board__search"
                       data-testid="kanban-search-box" />
            @if (_vacancyTitle is not null)
            {
                <a href="/companies/@CompanyId/vacancies/@VacancyId" class="vacancy-kanban-board__vacancy-link">@_vacancyTitle</a>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger alert-dismissible" data-testid="kanban-error">
            @_error
            <button type="button" class="btn-close" @onclick="() => _error = null"></button>
        </div>
    }

    @if (_loading)
    {
        <HrLoadingIndicator Label="Loading Kanban board…" />
    }
    else
    {
        @* "dragging" is toggled exactly twice per drag (once in OnDragStart, once in OnDragEnd) —
           both are already .NET-bound handlers that fire a single time per drag session, unlike
           dragover which fires continuously. The actual per-column highlight below is pure CSS
           (:hover), so this does NOT add a per-dragover .NET round trip and does NOT reintroduce
           the mid-drag re-render bug described in the comment above _draggedCard. *@
        <div class="vacancy-kanban-board__columns @(_draggedCard is not null ? "dragging" : "")" data-testid="kanban-columns"
             tabindex="0" role="group" aria-label="Recruitment pipeline columns">
            @foreach (var column in VisibleColumns)
            {
                var col = column;
                var cards = CardsFor(col).ToList();
                <div class="vacancy-kanban-board__column"
                     data-testid="kanban-column" data-stage-id="@col.StageId"
                     @ondragover:preventDefault="true"
                     @ondrop="() => OnDropAsync(col.StageId)" @ondrop:preventDefault="true">
                    <div class="vacancy-kanban-board__column-header" data-testid="kanban-column-header">
                        <span class="vacancy-kanban-board__column-title">@col.StageName</span>
                        <span class="vacancy-kanban-board__column-count" data-testid="kanban-column-count">@cards.Count</span>
                    </div>
                    <div class="vacancy-kanban-board__column-content">
                        @if (cards.Count == 0)
                        {
                            <div class="vacancy-kanban-board__column-empty">No candidates at this stage</div>
                        }
                        else
                        {
                            @foreach (var candidate in cards)
                            {
                                var app = candidate;
                                <div class="vacancy-kanban-board__draggable" draggable="@(Session.IsReadOnly ? "false" : "true")"
                                     @ondragstart="() => OnDragStart(app)"
                                     @ondragend="OnDragEnd">
                                    <KanbanCandidateCard Candidate="app"
                                                         RecruiterName="@RecruiterName(app)"
                                                         TerminalOutcome="@StageOutcome(app.StageId)"
                                                         OnOpen="OpenCandidate"
                                                         AvailableStages="@VisibleColumns.Where(c => c.StageId != app.StageId).ToList()"
                                                         OnMoveToStage="(stageId) => MoveApplicationAsync(app, stageId)"
                                                         OnReviewCv="ReviewCv" />
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public Guid VacancyId { get; set; }

    [Parameter] public string SearchText { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SearchTextChanged { get; set; }

    // UI-only toggle (no backend change) — the Kanban response already tags every column with
    // IsTerminal (see KanbanColumnModel), so hiding Hired/Rejected columns is a pure client-side
    // filter of the already-loaded _columns/FilteredCards. Defaults to false (terminal columns
    // hidden) per the dashboard redesign brief, so a recruiter's default board view stays focused
    // on in-flight candidates; callers that want the old "always show everything" behaviour can
    // pass ShowTerminalStages="true".
    //
    // IMPORTANT for any embedding site: this parameter's default is "hide terminal columns," which
    // is only correct for RecruitmentDashboard.razor's own "Show Hired / Rejected columns"
    // checkbox-driven usage. The standalone VacancyKanbanPage route predates this parameter and has
    // no toggle of its own — it must always pass ShowTerminalStages="true" explicitly to preserve
    // its original "show every configured stage, including Hired/Rejected" behaviour. Omitting it
    // there silently drops the Hired/Rejected columns entirely (not just hides candidates in them)
    // — this exact regression broke VacancyKanbanBoardTests.Board_RendersOneColumnPerConfiguredStage_
    // InDisplayOrder_IncludingEmptyColumns when this parameter was first introduced.
    [Parameter] public bool ShowTerminalStages { get; set; }

    [Parameter] public bool ShowToolbar { get; set; } = true;

    private bool _loading = true;
    private string? _error;
    private string? _vacancyTitle;
    private List<KanbanCandidateModel> _cards = [];
    private List<KanbanColumnModel> _columns = [];
    private Dictionary<Guid, string> _candidateEmails = [];

    // StageId -> TerminalOutcome lookup for Hired=success/Rejected=danger card accent styling — the
    // Kanban response's KanbanColumn.IsTerminal alone can't distinguish Hired from Rejected, so this
    // is built once per board load from the ticket #100 stages list endpoint instead (better UX than
    // falling back to a generic "terminal" accent for both outcomes).
    private Dictionary<Guid, RecruitmentStageTerminalOutcome> _stageOutcomes = [];

    // Drag state — which card is currently being dragged. A plain component field since the whole
    // interaction is native HTML5 drag events dispatched straight to Blazor; there is no separate
    // client-side widget state to keep in sync with.
    //
    // Deliberately NOT tracking a "drag over" column for hover highlighting: that would need
    // dragenter/dragleave bound to .NET handlers, and every such server round-trip re-renders the
    // component mid-drag. A native HTML5 drag session is cancelled by the browser if the DOM under
    // the pointer is mutated while it's in progress — exactly what a mid-drag Blazor re-render risks
    // — which is what caused every drag to visually "bounce back" to its origin instead of dropping.
    private KanbanCandidateModel? _draggedCard;

    protected override async Task OnParametersSetAsync()
    {
        if (_prevVacancyId != VacancyId)
        {
            _prevVacancyId = VacancyId;
            await LoadAsync();
        }
    }

    private Guid _prevVacancyId;

    private Task LoadAsync() => LoadAsync(showSpinner: true);

    private async Task LoadAsync(bool showSpinner)
    {
        if (showSpinner) _loading = true;
        _error = null;

        var kanbanTask = KanbanService.GetKanbanAsync(CompanyId, VacancyId);
        var candidatesTask = CandidateService.ListAllCandidatesAsync(CompanyId);
        var stagesTask = RecruitmentStageService.ListStagesAsync(CompanyId);

        await Task.WhenAll(kanbanTask, candidatesTask, stagesTask);

        var kanban = await kanbanTask;
        if (kanban is null)
        {
            _error = "Failed to load the recruitment Kanban board.";
            _cards = [];
            _columns = [];
            if (showSpinner) _loading = false;
            return;
        }

        _vacancyTitle = kanban.VacancyTitle;
        _columns = kanban.Columns.ToList();
        _cards = kanban.Columns.SelectMany(c => c.Candidates).ToList();

        var candidates = await candidatesTask ?? [];
        _candidateEmails = candidates.ToDictionary(c => c.Id, c => c.Email);

        var stages = (await stagesTask)?.Items ?? [];
        _stageOutcomes = stages.ToDictionary(s => s.Id, s => s.TerminalOutcome);

        if (showSpinner) _loading = false;
    }

    private async Task ReloadKanbanOnlyAsync()
    {
        _error = null;

        var kanban = await KanbanService.GetKanbanAsync(CompanyId, VacancyId);
        if (kanban is null)
        {
            _error = "Failed to load the recruitment Kanban board.";
            _cards = [];
            _columns = [];
            return;
        }

        _vacancyTitle = kanban.VacancyTitle;
        _columns = kanban.Columns.ToList();
        _cards = kanban.Columns.SelectMany(c => c.Candidates).ToList();
    }

    private RecruitmentStageTerminalOutcome StageOutcome(Guid stageId) =>
        _stageOutcomes.GetValueOrDefault(stageId, RecruitmentStageTerminalOutcome.None);

    private IEnumerable<KanbanColumnModel> VisibleColumns =>
        ShowTerminalStages ? _columns : _columns.Where(c => !c.IsTerminal);

    private IEnumerable<KanbanCandidateModel> FilteredCards
    {
        get
        {
            var visibleStageIds = VisibleColumns.Select(c => c.StageId).ToHashSet();
            var cards = _cards.Where(c => visibleStageIds.Contains(c.StageId) && !c.IsWithdrawn);

            if (string.IsNullOrWhiteSpace(SearchText))
                return cards;

            var term = SearchText.Trim();
            return cards.Where(c =>
                c.CandidateFullName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (_candidateEmails.TryGetValue(c.CandidateId, out var email) &&
                 email.Contains(term, StringComparison.OrdinalIgnoreCase)));
        }
    }

    private IEnumerable<KanbanCandidateModel> CardsFor(KanbanColumnModel column) =>
        FilteredCards.Where(c => c.StageId == column.StageId);

    private static string RecruiterName(KanbanCandidateModel candidate) =>
        candidate.AssignedRecruiterAgencyName ?? "Unassigned";

    private async Task OnSearchChanged(Syncfusion.Blazor.Inputs.ChangedEventArgs args)
    {
        SearchText = args.Value ?? string.Empty;
        await SearchTextChanged.InvokeAsync(SearchText);
    }

    private async Task OpenCandidate(KanbanCandidateModel candidate)
    {
        if (_columns.Any(c => c.StageId == candidate.StageId && c.Purpose == RecruitmentStagePurpose.CvReview))
        {
            ReviewCv(candidate);
            return;
        }

        var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);

        var candidateUrl = $"/companies/{CompanyId}/candidates/{candidate.CandidateId}" +
            $"?returnUrl={Uri.EscapeDataString(returnUrl)}";
        Navigation.NavigateTo(candidateUrl);
    }

    private void ReviewCv(KanbanCandidateModel candidate)
    {
        var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo(
            $"/companies/{CompanyId}/vacancies/{VacancyId}/applications/{candidate.ApplicationId}/review-cv" +
            $"?returnUrl={Uri.EscapeDataString(returnUrl)}");
    }

    private void OnDragStart(KanbanCandidateModel candidate) => _draggedCard = candidate;

    private void OnDragEnd() => _draggedCard = null;

    private async Task OnDropAsync(Guid targetStageId)
    {
        var moved = _draggedCard;
        _draggedCard = null;

        if (moved is null)
            return;

        await MoveApplicationAsync(moved, targetStageId);
    }

    private async Task MoveApplicationAsync(KanbanCandidateModel candidate, Guid targetStageId)
    {
        if (candidate.StageId == targetStageId)
            return;

        var (result, error) = await KanbanService.MoveApplicationStageAsync(CompanyId, VacancyId, candidate.ApplicationId, targetStageId);

        await ReloadKanbanOnlyAsync();

        _error = result is null ? (error ?? "Failed to move candidate to the new stage.") : null;
    }
}
