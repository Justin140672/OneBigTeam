@page "/companies/{CompanyId:guid}/external-recruiters"
@rendermode InteractiveServer
@inherits SearchPageBase<ExternalRecruiterListItemModel>
@inject ExternalRecruiterService ExternalRecruiterService
@inject AppSession Session

<PageTitle>External Recruiters</PageTitle>

<div class="container-fluid py-4">
    <a href="/dashboard/recruitment" class="text-decoration-none text-muted small">← Recruitment Dashboard</a>
    <h1 class="mb-1">External Recruiters</h1>
    <p class="text-muted mb-3">Manage recruitment agencies and their contacts.</p>

    @if (IsLoading)
    {
        <HrLoadingIndicator Label="Loading external recruiters…" />
    }
    else if (Error is not null)
    {
        <div class="alert alert-danger">@Error</div>
    }
    else
    {
        @if (ActionError is not null)
        {
            <div class="alert alert-danger alert-dismissible">
                @ActionError
                <button type="button" class="btn-close" @onclick="ClearActionError"></button>
            </div>
        }

        <HrGrid @ref="Grid"
                TValue="ExternalRecruiterListItemModel"
                DataSource="@Items"
                Toolbar="@GridToolbar"
                AllowFiltering="true">
            <GridEvents TValue="ExternalRecruiterListItemModel" OnToolbarClick="OnToolbarClick"
                        RowSelected="OnRowSelected" RowDeselected="OnRowDeselected" />
            <GridPageSettings PageSize="20" />
            <GridColumns>
                <GridColumn HeaderText="Agency" Width="220">
                    <Template>
                        @{
                            var row = (context as ExternalRecruiterListItemModel)!;
                            <a href="/companies/@CompanyId/external-recruiters/@row.Id/view">@row.AgencyName</a>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(ExternalRecruiterListItemModel.ContactName)" HeaderText="Contact" Width="180" />
                <GridColumn Field="@nameof(ExternalRecruiterListItemModel.ContactEmail)" HeaderText="Email" Width="220">
                    <Template>
                        @{
                            var row = (context as ExternalRecruiterListItemModel)!;
                        }
                        @if (!string.IsNullOrWhiteSpace(row.ContactEmail))
                        {
                            <a href="mailto:@row.ContactEmail">@row.ContactEmail</a>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(ExternalRecruiterListItemModel.ContactTelephone)" HeaderText="Telephone" Width="160">
                    <Template>
                        @{
                            var row = (context as ExternalRecruiterListItemModel)!;
                        }
                        @if (!string.IsNullOrWhiteSpace(row.ContactTelephone))
                        {
                            <a href="tel:@row.ContactTelephone">@row.ContactTelephone</a>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(ExternalRecruiterListItemModel.LinkedVacancyCount)" HeaderText="Vacancies" Width="120" />
                <GridColumn Field="@nameof(ExternalRecruiterListItemModel.IsActive)" HeaderText="Status" Width="110">
                    <Template>
                        @{
                            var row = (context as ExternalRecruiterListItemModel)!;
                            <ActiveStatusBadge IsActive="row.IsActive" />
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </HrGrid>

        <p class="text-muted small mt-2">@Items.Count recruiter(s)</p>
    }
</div>

@code {
    protected override bool SupportsActiveFilter => true;

    protected override Task OnBeforeLoadAsync()
    {
        if (!Session.IsRecruiter)
            Navigation.NavigateTo(Session.MyProfileUrl, replace: true);
        return Task.CompletedTask;
    }

    protected override void ConfigureToolbar()
    {
        if (!Session.IsRecruiter) return;

        AddToolbarAction(
            id:      "hr-activate",
            text:    "Activate",
            icon:    "fa-solid fa-circle-check",
            onClick: async item =>
            {
                if (item.IsActive) return;
                await SetActiveStatus(item, true);
            },
            tooltip: "Activate selected recruiter");

        AddToolbarAction(
            id:      "hr-deactivate",
            text:    "Deactivate",
            icon:    "fa-solid fa-circle-xmark",
            onClick: async item =>
            {
                if (!item.IsActive) return;
                await SetActiveStatus(item, false);
            },
            tooltip: "Deactivate selected recruiter");
    }

    protected override async Task<IReadOnlyList<ExternalRecruiterListItemModel>?> FetchItemsAsync(string? search)
    {
        var result = await ExternalRecruiterService.ListExternalRecruitersAsync(
            CompanyId, search, isActive: ShowInactive ? null : true, pageSize: 200);
        return result?.Items;
    }

    protected override string LoadErrorMessage => "Failed to load external recruiters.";

    protected override string? GetAddUrl() => Session.IsRecruiter ? $"/companies/{CompanyId}/external-recruiters/new" : null;
    protected override string? GetEditUrl(ExternalRecruiterListItemModel item) =>
        Session.IsRecruiter ? $"/companies/{CompanyId}/external-recruiters/{item.Id}" : null;
    protected override string? GetViewUrl(ExternalRecruiterListItemModel item) => $"/companies/{CompanyId}/external-recruiters/{item.Id}/view";

    private async Task SetActiveStatus(ExternalRecruiterListItemModel item, bool isActive)
    {
        ClearActionError();
        var (result, error) = await ExternalRecruiterService.SetActiveStatusAsync(CompanyId, item.Id, isActive);
        if (result is null)
            SetActionError(error);
        else
            await LoadAsync();
    }
}
