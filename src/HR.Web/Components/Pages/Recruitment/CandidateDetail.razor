@using HR.SharedKernel
@page "/companies/{CompanyId:guid}/candidates/new"
@page "/companies/{CompanyId:guid}/candidates/{Id:guid}"
@page "/companies/{CompanyId:guid}/candidates/{Id:guid}/view"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@inject CandidateService CandidateService
@inject AppSession Session
@inherits EditPageBase<CandidateEditModel, Guid>

<PageTitle>@PageTitle</PageTitle>

<div class="container py-4">
    <SfBreadcrumb Class="mb-3">
        <BreadcrumbItems>
            <BreadcrumbItem Text="@(string.IsNullOrWhiteSpace(ReturnUrl) && ResolvedOrigin == CandidateReturnDestination.Dashboard ? "Recruitment Dashboard" : "Candidates")"
                            Url="@(string.IsNullOrWhiteSpace(ReturnUrl) && ResolvedOrigin == CandidateReturnDestination.Dashboard ? OriginListUrl : $"/companies/{CompanyId}/candidates")" />
            <BreadcrumbItem Text="@PageTitle" />
        </BreadcrumbItems>
    </SfBreadcrumb>

    @if (IsLoading)
    {
        <HrLoadingIndicator />
    }
    else
    {
        <h1 class="mb-1">@PageTitle</h1>
        <p class="text-muted mb-4">Record the candidate's contact details.</p>

        <SaveConflictBanner Visible="SaveConflict" Disabled="@Saving" OnReload="ReloadLatestValuesAsync"
                            Message="Someone else changed this candidate while you were editing. Your changes have not been saved." />

        @if (!SaveConflict && !string.IsNullOrEmpty(GlobalError))
        {
            <div class="alert alert-danger">@GlobalError</div>
        }

        @if (_candidate?.EmployeeId is not null)
        {
            <div class="alert alert-success d-flex align-items-center gap-2">
                <i class="fa-solid fa-circle-check"></i>
                <span>This candidate was hired and linked to an employee (ID: @_candidate.EmployeeId).</span>
            </div>
        }

        @if (_candidate is not null && !_candidate.IsActive)
        {
            <div class="alert alert-secondary d-flex align-items-center gap-2">
                <i class="fa-solid fa-circle-xmark"></i>
                <span>
                    This candidate is <strong>inactive</strong>@(_candidate.DeactivatedAt is not null ? $" (deactivated {_candidate.DeactivatedAt.Value.LocalDateTime:d})" : "").
                    @if (!string.IsNullOrWhiteSpace(_candidate.DeactivationReason))
                    {
                        <span> Reason: @_candidate.DeactivationReason</span>
                    }
                </span>
            </div>
        }

        @if (_actionError is not null)
        {
            <div class="alert alert-danger alert-dismissible">
                @_actionError
                <button type="button" class="btn-close" @onclick="@(() => _actionError = null)"></button>
            </div>
        }

        <div class="row">
            <div class="col-lg-8">
                <EditForm EditContext="EditContext">
                    <DataAnnotationsValidator />
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Candidate Details</h5>
                        </div>
                        <div class="card-body @(IsViewMode ? "view-mode" : "")">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">First Name <span class="text-danger">*</span></label>
                                    <HrTextBox @bind-Value="Model.FirstName" Placeholder="First name" />
                                    <ValidationMessage For="@(() => Model.FirstName)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Last Name <span class="text-danger">*</span></label>
                                    <HrTextBox @bind-Value="Model.LastName" Placeholder="Last name" />
                                    <ValidationMessage For="@(() => Model.LastName)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Email <span class="text-danger">*</span></label>
                                    <HrTextBox @bind-Value="Model.Email" Placeholder="candidate@example.com" />
                                    <ValidationMessage For="@(() => Model.Email)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Phone</label>
                                    <HrTextBox @bind-Value="Model.Phone" Placeholder="e.g. 07700 900000" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Legacy resume URL</label>
                                    <HrTextBox @bind-Value="Model.ResumeUrl" Placeholder="Link to CV / resume" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-3 justify-content-end">
                        @if (!IsNew && _candidate is not null)
                        {
                            @if (_candidate.IsActive)
                            {
                                <SfButton CssClass="e-danger" Disabled="@(Saving || _actionBusy)" OnClick="@(() => _showDeactivateDialog = true)">
                                    Deactivate
                                </SfButton>
                            }
                            else
                            {
                                <SfButton Disabled="@(Saving || _actionBusy)" OnClick="@(() => _showReactivateDialog = true)">
                                    Reactivate
                                </SfButton>
                            }
                        }
                        @if (!IsViewMode)
                        {
                            <SfButton IsPrimary="true" Disabled="@Saving" OnClick="SaveAsync">
                                @if (Saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                Save
                            </SfButton>
                        }
                        <SfButton OnClick="RequestClose" Disabled="@Saving">Close</SfButton>
                    </div>
                </EditForm>

                @if (!IsNew && _candidate is not null)
                {
                    @* Internal recruitment Ticket 2: deliberately OUTSIDE the EditForm so its buttons can't
                       submit the candidate form, and nothing here touches Model (dirty tracking). *@
                    <div class="card mt-4 mb-4" data-testid="candidate-cv-card">
                        <div class="card-header">
                            <h5 class="mb-0">CV documents</h5>
                        </div>
                        <div class="card-body">
                            @if (_cvError is not null)
                            {
                                <div class="alert alert-danger" data-testid="candidate-cv-error">@_cvError</div>
                            }
                            @if (_cvSuccess is not null)
                            {
                                <div class="alert alert-success" data-testid="candidate-cv-success">@_cvSuccess</div>
                            }

                            @if (_cvDocuments is null)
                            {
                                <p class="text-muted">CV documents could not be loaded.</p>
                            }
                            else if (_cvDocuments.Count == 0)
                            {
                                <p class="text-muted" data-testid="candidate-cv-empty">No CV has been uploaded for this candidate.</p>
                            }
                            else
                            {
                                <ul class="list-group mb-3">
                                    @foreach (var doc in _cvDocuments)
                                    {
                                        <li class="list-group-item" data-testid="candidate-cv-row">
                                            <div class="d-flex flex-wrap align-items-center gap-2">
                                                <a href="@CandidateService.GetCandidateDocumentProxyUrl(CompanyId, Id!.Value, doc.Id)"
                                                   target="_blank" rel="noopener">@doc.FileName</a>
                                                @if (doc.IsCurrentCv)
                                                {
                                                    <span class="badge bg-success" data-testid="candidate-cv-current-badge">Current CV</span>
                                                }
                                            </div>
                                            <div class="small text-muted">
                                                Uploaded @doc.CreatedAt.LocalDateTime.ToString("d MMM yyyy, HH:mm") · @FormatFileSize(doc.FileSize)
                                            </div>
                                            @if (doc.ReferencingApplicationCount > 0)
                                            {
                                                <div class="small text-muted" data-testid="candidate-cv-referenced">
                                                    Submitted with @doc.ReferencingApplicationCount application(s)
                                                </div>
                                            }
                                        </li>
                                    }
                                </ul>
                            }

                            @if (!string.IsNullOrWhiteSpace(_candidate.ResumeUrl))
                            {
                                <p data-testid="candidate-cv-legacy-link">
                                    <a href="@_candidate.ResumeUrl" target="_blank" rel="noopener">Legacy CV link</a>
                                    <span class="text-muted small"> (legacy link recorded on the candidate record — not an uploaded document)</span>
                                </p>
                            }

                            @if (CanUploadCv)
                            {
                                <div class="mt-3">
                                    <InputFile @key="_cvFileInputKey" class="form-control" OnChange="OnCvFileSelected"
                                               accept=".pdf,.doc,.docx" data-testid="candidate-cv-file-input" />
                                    <div class="form-text">
                                        PDF, DOC or DOCX, up to 20 MB. Uploading a replacement makes it the candidate's current CV;
                                        earlier CVs are kept and applications continue to show the CV they were submitted with.
                                    </div>
                                    <div class="mt-2">
                                        <SfButton IsPrimary="true" Disabled="@(_cvBusy || _selectedCvFile is null)"
                                                  OnClick="UploadCvAsync" data-testid="candidate-cv-upload">
                                            @if (_cvBusy)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                            }
                                            @(_cvDocuments is { Count: > 0 } ? "Upload replacement CV" : "Upload CV")
                                        </SfButton>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges" />

    <UnsavedChangesDialog Visible="ShowUnsavedChangesDialog"
                          OnSaveAndClose="ConfirmSaveAndCloseAsync"
                          OnDiscard="DiscardChangesAndClose"
                          OnCancel="CancelCloseDialog" />

    @if (_showDeactivateDialog)
    {
        <SfDialog Visible="_showDeactivateDialog" IsModal="true" Width="420px" ShowCloseIcon="false">
            <DialogTemplates>
                <Header>Deactivate Candidate</Header>
                <Content>
                    <p>Are you sure you want to deactivate @Model.FirstName @Model.LastName?</p>
                    <EditForm EditContext="_deactivateEditContext">
                        <DataAnnotationsValidator />
                        <label class="form-label">Reason <span class="text-danger">*</span></label>
                        <HrTextBox @bind-Value="_deactivateModel.Reason" Multiline="true" Rows="3"
                                   Maxlength="1000" Placeholder="Explain why this candidate is being deactivated" />
                        <ValidationMessage For="@(() => _deactivateModel.Reason)" class="text-danger small" />
                    </EditForm>
                </Content>
                <FooterTemplate>
                    <SfButton IsPrimary="true" CssClass="e-danger" Disabled="_actionBusy" OnClick="ConfirmDeactivateAsync">
                        @if (_actionBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Deactivate
                    </SfButton>
                    <SfButton Disabled="_actionBusy" OnClick="@(() => _showDeactivateDialog = false)">Cancel</SfButton>
                </FooterTemplate>
            </DialogTemplates>
        </SfDialog>
    }

    <HrConfirmDialog Visible="_showReactivateDialog"
                     Title="Reactivate Candidate"
                     Message="@($"Are you sure you want to reactivate {Model.FirstName} {Model.LastName}?")"
                     ConfirmText="Reactivate"
                     CancelText="Cancel"
                     DangerConfirm="false"
                     Busy="_actionBusy"
                     OnConfirmed="ConfirmReactivateAsync"
                     OnCancelled="@(() => _showReactivateDialog = false)" />
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid? Id { get; set; }

    // Set when this page is reached from the Recruitment Kanban board (see
    // VacancyKanbanBoard.OpenCandidate) so "Close" returns there instead of always falling back to
    // the plain Candidate List — the board can be embedded in three different places (standalone
    // route, Vacancy Detail tab, or the Recruitment Dashboard's Board view), so this carries
    // whichever one the user actually came from.
    [SupplyParameterFromQuery(Name = "returnUrl")]
    [Parameter]
    public string? ReturnUrl { get; set; }

    // Which screen launched the Add Candidate editor (Dashboard vs Candidates list), carried as a
    // whitelisted "origin" query value — NOT an arbitrary URL — so Save/Close returns to the
    // correct launch point. Unrecognized/missing values safely fall back to the Candidates list.
    [SupplyParameterFromQuery(Name = "origin")]
    [Parameter]
    public string? Origin { get; set; }

    private CandidateReturnDestination ResolvedOrigin => Origin switch
    {
        "dashboard" => CandidateReturnDestination.Dashboard,
        _ => CandidateReturnDestination.CandidatesList
    };

    private string OriginListUrl => ResolvedOrigin switch
    {
        CandidateReturnDestination.Dashboard => "/dashboard/recruitment",
        _ => $"/companies/{CompanyId}/candidates"
    };

    private GetCandidateResponse? _candidate;
    private string? _actionError;
    private bool _actionBusy;

    private bool _showDeactivateDialog;
    private readonly DeactivateCandidateFormModel _deactivateModel = new();
    private EditContext _deactivateEditContext = default!;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _deactivateEditContext = new EditContext(_deactivateModel);
    }

    private bool _showReactivateDialog;

    private string PageTitle => IsNew ? "Add Candidate"
        : Model.FirstName.Trim().Length > 0 ? $"{Model.FirstName} {Model.LastName}"
        : IsViewMode ? "View Candidate" : "Edit Candidate";

    protected override IEditService<CandidateEditModel, Guid> Service => CandidateService;
    protected override Guid GetCompanyId() => CompanyId;
    protected override Guid? GetId() => Id;

    protected override async Task OnLoadedAsync()
    {
        if (!AppSession.GuardAccess(Navigation, Session.CanViewCandidates))
            return;

        if (!IsNew)
        {
            _candidate = await CandidateService.GetCandidateAsync(CompanyId, Id!.Value);
            await LoadCvDocumentsAsync();
        }
    }

    // ── CV documents (internal recruitment Ticket 2) ────────────────────────────

    private List<CandidateDocumentListItemModel>? _cvDocuments = [];
    private IBrowserFile? _selectedCvFile;
    private int _cvFileInputKey;
    private bool _cvBusy;
    private string? _cvError;
    private string? _cvSuccess;

    // GetCandidateResponse exposes no purge flag, so IsActive is the only lifecycle gate here.
    private bool CanUploadCv => Session.CanManageRecruitment && _candidate is { IsActive: true };

    private async Task LoadCvDocumentsAsync()
    {
        var response = await CandidateService.ListCandidateDocumentsAsync(CompanyId, Id!.Value);
        // API order is newest first — keep it.
        _cvDocuments = response?.Items.Where(d => d.Kind == "Cv").ToList();
    }

    private void OnCvFileSelected(InputFileChangeEventArgs e)
    {
        _selectedCvFile = e.File;
        _cvError = null;
        _cvSuccess = null;
    }

    private async Task UploadCvAsync()
    {
        if (_selectedCvFile is null || _cvBusy)
            return;

        _cvBusy = true;
        _cvError = null;
        _cvSuccess = null;

        var file = _selectedCvFile;
        var (_, error) = await CandidateService.UploadCandidateDocumentAsync(
            CompanyId, Id!.Value, file.Name, "Cv", file);

        if (error is not null)
        {
            _cvError = error;
        }
        else
        {
            _cvSuccess = "CV uploaded. It is now the candidate's current CV.";
            await LoadCvDocumentsAsync();
        }

        // Re-key the InputFile so the same file can be picked again.
        _selectedCvFile = null;
        _cvFileInputKey++;
        _cvBusy = false;
    }

    private static string FormatFileSize(long bytes) =>
        bytes < 1024 ? $"{bytes} B"
        : bytes < 1024 * 1024 ? $"{bytes / 1024.0:0.#} KB"
        : $"{bytes / (1024.0 * 1024.0):0.#} MB";

    protected override string? ListUrl => !string.IsNullOrWhiteSpace(ReturnUrl)
        ? ReturnUrl
        : OriginListUrl;

    private async Task ConfirmDeactivateAsync()
    {
        if (!_deactivateEditContext.Validate())
            return;

        _actionError = null;
        _actionBusy = true;

        var (result, error) = await CandidateService.DeactivateCandidateAsync(CompanyId, Id!.Value, FormText.Required(_deactivateModel.Reason!));

        _actionBusy = false;

        if (error is not null)
        {
            _actionError = error;
            return;
        }

        _showDeactivateDialog = false;
        _deactivateModel.Reason = null;
        _deactivateEditContext = new EditContext(_deactivateModel);
        _candidate = await CandidateService.GetCandidateAsync(CompanyId, Id!.Value);
    }

    private sealed class DeactivateCandidateFormModel
    {
        [Required(ErrorMessage = "A reason is required.")]
        [MaxLength(1000)]
        public string? Reason { get; set; }
    }

    private async Task ConfirmReactivateAsync()
    {
        _actionError = null;
        _actionBusy = true;

        var (result, error) = await CandidateService.ReactivateCandidateAsync(CompanyId, Id!.Value);

        _actionBusy = false;

        if (error is not null)
        {
            _actionError = error;
            return;
        }

        _showReactivateDialog = false;
        _candidate = await CandidateService.GetCandidateAsync(CompanyId, Id!.Value);
    }
}
