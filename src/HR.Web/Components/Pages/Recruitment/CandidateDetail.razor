@using HR.SharedKernel
@using HR.SharedKernel.Http
@page "/companies/{CompanyId:guid}/candidates/new"
@page "/companies/{CompanyId:guid}/candidates/{Id:guid}"
@page "/companies/{CompanyId:guid}/candidates/{Id:guid}/view"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@inject CandidateService CandidateService
@inject ApplicationService ApplicationService
@inject AppSession Session
@inherits EditPageBase<CandidateEditModel, Guid>

<PageTitle>@PageTitle</PageTitle>

<div class="container py-4">
    <SfBreadcrumb Class="mb-3">
        <BreadcrumbItems>
            <BreadcrumbItem Text="@(string.IsNullOrWhiteSpace(ReturnUrl) && ResolvedOrigin == CandidateReturnDestination.Dashboard ? "Recruitment Dashboard" : "Candidates")"
                            Url="@(string.IsNullOrWhiteSpace(ReturnUrl) && ResolvedOrigin == CandidateReturnDestination.Dashboard ? OriginListUrl : $"/companies/{CompanyId}/candidates")" />
            <BreadcrumbItem Text="@PageTitle" />
        </BreadcrumbItems>
    </SfBreadcrumb>

    @if (IsLoading)
    {
        <HrLoadingIndicator />
    }
    else
    {
        <h1 class="mb-1">@PageTitle</h1>
        <p class="text-muted mb-4">Record the candidate's contact details.</p>

        <SaveConflictBanner Visible="SaveConflict" Disabled="@Saving" OnReload="ReloadLatestValuesAsync"
                            Message="Someone else changed this candidate while you were editing. Your changes have not been saved." />

        @if (!SaveConflict && !string.IsNullOrEmpty(GlobalError))
        {
            <div class="alert alert-danger">@GlobalError</div>
        }

        @* Internal recruitment Ticket 6: internal applicants are linked to their employee record at
           apply time, so EmployeeId alone does NOT mean "hired". Internal status comes only from the
           applications' IsInternal flag (Source == Internal). *@
        @if (IsInternalApplicant)
        {
            <div class="alert alert-info d-flex align-items-center gap-2" data-testid="candidate-internal-applicant-alert">
                <i class="fa-solid fa-id-badge"></i>
                <span>This candidate is a current employee (internal applicant).</span>
            </div>
        }
        else if (_candidate?.EmployeeId is not null && _applications is null)
        {
            @* Applications couldn't be loaded, so we can't tell hired vs internal — stay neutral. *@
            <div class="alert alert-secondary d-flex align-items-center gap-2" data-testid="candidate-employee-linked-alert">
                <i class="fa-solid fa-link"></i>
                <span>This candidate is linked to an employee record.</span>
            </div>
        }
        else if (_candidate?.EmployeeId is not null)
        {
            <div class="alert alert-success d-flex align-items-center gap-2" data-testid="candidate-hired-alert">
                <i class="fa-solid fa-circle-check"></i>
                <span>This candidate was hired and linked to an employee (ID: @_candidate.EmployeeId).</span>
            </div>
        }

        @if (_candidate is not null && !_candidate.IsActive)
        {
            <div class="alert alert-secondary d-flex align-items-center gap-2">
                <i class="fa-solid fa-circle-xmark"></i>
                <span>
                    This candidate is <strong>inactive</strong>@(_candidate.DeactivatedAt is not null ? $" (deactivated {_candidate.DeactivatedAt.Value.LocalDateTime:d})" : "").
                    @if (!string.IsNullOrWhiteSpace(_candidate.DeactivationReason))
                    {
                        <span> Reason: @_candidate.DeactivationReason</span>
                    }
                </span>
            </div>
        }

        @if (_actionError is not null)
        {
            <div class="alert alert-danger alert-dismissible">
                @_actionError
                <button type="button" class="btn-close" @onclick="@(() => _actionError = null)"></button>
            </div>
        }

        <div class="row">
            <div class="col-lg-8">
                <EditForm EditContext="EditContext">
                    <DataAnnotationsValidator />
                    @if (IsNew)
                    {
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">Candidate Details</h5>
                            </div>
                            <div class="card-body">
                                <div class="row g-3 mb-3" data-testid="new-candidate-fields">
                                    <div class="col-md-6">
                                        <label class="form-label" for="new-candidate-first-name">First name <span class="text-danger">*</span></label>
                                        <HrTextBox ID="new-candidate-first-name" @bind-Value="Model.FirstName" Maxlength="100" Placeholder="First name"
                                                   data-testid="new-candidate-first-name" />
                                        <ValidationMessage For="@(() => Model.FirstName)" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="new-candidate-last-name">Last name <span class="text-danger">*</span></label>
                                        <HrTextBox ID="new-candidate-last-name" @bind-Value="Model.LastName" Maxlength="100" Placeholder="Last name"
                                                   data-testid="new-candidate-last-name" />
                                        <ValidationMessage For="@(() => Model.LastName)" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="new-candidate-email">Email <span class="text-danger">*</span></label>
                                        <HrTextBox ID="new-candidate-email" @bind-Value="Model.Email" Maxlength="256" Placeholder="candidate@example.com"
                                                   data-testid="new-candidate-email" />
                                        <ValidationMessage For="@(() => Model.Email)" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="new-candidate-phone">Phone (optional)</label>
                                        <HrTextBox ID="new-candidate-phone" @bind-Value="Model.Phone" Maxlength="30" Placeholder="e.g. 07700 900000"
                                                   data-testid="new-candidate-phone" />
                                        <ValidationMessage For="@(() => Model.Phone)" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label" for="new-candidate-cv-input">CV (optional)</label>
                                        @* Kept rendered while a file is selected — Blazor Server streams the file from
                                           this input element at submit time, so it must stay in the DOM. *@
                                        <InputFile @key="_newCvInputKey" id="new-candidate-cv-input" class="form-control"
                                                   OnChange="OnNewCvSelected" accept=".pdf,.doc,.docx" disabled="@Saving"
                                                   data-testid="new-candidate-cv-input" />
                                        <div class="form-text">PDF, DOC or DOCX, up to 20 MB. Uploaded as the candidate's current CV.</div>
                                        @if (_newCvFile is not null)
                                        {
                                            <div class="add-candidate-cv-selected" data-testid="new-candidate-cv-selected">
                                                <i class="fa-solid fa-file-lines"></i>
                                                <span data-testid="new-candidate-cv-file-name">@_newCvFile.Name</span>
                                                <span class="text-muted small">(@FormatFileSize(_newCvFile.Size))</span>
                                                <SfButton CssClass="e-flat e-small" Disabled="@Saving" OnClick="RemoveNewCv"
                                                          data-testid="new-candidate-cv-remove">
                                                    <i class="fa-solid fa-xmark me-1"></i>Remove
                                                </SfButton>
                                            </div>
                                        }
                                        @if (_newCvError is not null)
                                        {
                                            <div class="text-danger small mt-1" data-testid="new-candidate-cv-error">@_newCvError</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Candidate Details</h5>
                        </div>
                        <div class="card-body @(IsViewMode ? "view-mode" : "")">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">First Name <span class="text-danger">*</span></label>
                                    <HrTextBox @bind-Value="Model.FirstName" Placeholder="First name" />
                                    <ValidationMessage For="@(() => Model.FirstName)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Last Name <span class="text-danger">*</span></label>
                                    <HrTextBox @bind-Value="Model.LastName" Placeholder="Last name" />
                                    <ValidationMessage For="@(() => Model.LastName)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Email <span class="text-danger">*</span></label>
                                    <HrTextBox @bind-Value="Model.Email" Placeholder="candidate@example.com" />
                                    <ValidationMessage For="@(() => Model.Email)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Phone</label>
                                    <HrTextBox @bind-Value="Model.Phone" Placeholder="e.g. 07700 900000" />
                                </div>
                            </div>
                        </div>
                    </div>
                    }

                    <div class="d-flex gap-2 mt-3 justify-content-end">
                        @if (!IsNew && _candidate is not null)
                        {
                            @if (_candidate.IsActive)
                            {
                                <SfButton CssClass="e-danger" Disabled="@(Saving || _actionBusy)" OnClick="@(() => _showDeactivateDialog = true)">
                                    Deactivate
                                </SfButton>
                            }
                            else
                            {
                                <SfButton Disabled="@(Saving || _actionBusy)" OnClick="@(() => _showReactivateDialog = true)">
                                    Reactivate
                                </SfButton>
                            }
                        }
                        @if (!IsViewMode)
                        {
                            <SfButton IsPrimary="true" Disabled="@(Saving || IsSubscriptionReadOnly)" OnClick="SaveAsync">
                                @if (Saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                @(IsNew ? "Add" : "Save")
                            </SfButton>
                        }
                        <SfButton OnClick="RequestClose" Disabled="@Saving">@(IsNew ? "Cancel" : "Close")</SfButton>
                    </div>
                </EditForm>

                @if (!IsNew && _candidate is not null)
                {
                    @* Internal recruitment Ticket 2: deliberately OUTSIDE the EditForm so its buttons can't
                       submit the candidate form, and nothing here touches Model (dirty tracking). *@
                    <div class="card mt-4 mb-4" data-testid="candidate-cv-card">
                        <div class="card-header">
                            <h5 class="mb-0">CV documents</h5>
                        </div>
                        <div class="card-body">
                            @if (_cvError is not null)
                            {
                                <div class="alert alert-danger" data-testid="candidate-cv-error">@_cvError</div>
                            }
                            @if (_cvSuccess is not null)
                            {
                                <div class="alert alert-success" data-testid="candidate-cv-success">@_cvSuccess</div>
                            }

                            @if (_cvDocuments is null)
                            {
                                <p class="text-muted">CV documents could not be loaded.</p>
                            }
                            else if (_cvDocuments.Count == 0)
                            {
                                <p class="text-muted" data-testid="candidate-cv-empty">No CV has been uploaded for this candidate.</p>
                            }
                            else
                            {
                                <div class="d-flex justify-content-end mb-2">
                                    <SfButton CssClass="e-small e-flat" Disabled="@(_cvBusy || _cvRefreshing)"
                                              OnClick="RefreshCvDocumentsAsync" data-testid="candidate-documents-refresh">
                                        Refresh
                                    </SfButton>
                                </div>
                                <ul class="list-group mb-3">
                                    @foreach (var doc in _cvDocuments)
                                    {
                                        <li class="list-group-item" data-testid="candidate-cv-row">
                                            <div class="d-flex flex-wrap align-items-center gap-2">
                                                @if (doc.IsDownloadable)
                                                {
                                                    <a href="@CandidateService.GetCandidateDocumentProxyUrl(CompanyId, Id!.Value, doc.Id)"
                                                       target="_blank" rel="noopener">@doc.FileName</a>
                                                }
                                                else
                                                {
                                                    @* Malware-scan gate: no href, so this never navigates to the download proxy.
                                                       Kept as an <a> (role=link, aria-disabled) so the file name stays in the
                                                       same position/element for assistive tech and existing row locators. *@
                                                    <a role="link" aria-disabled="true" class="candidate-document__file--disabled"
                                                       title="@DownloadDisabledReason(doc.ScanStatus)"
                                                       data-testid="candidate-document-download-disabled">@doc.FileName</a>
                                                }
                                                @if (doc.IsCurrentCv)
                                                {
                                                    <span class="badge bg-success" data-testid="candidate-cv-current-badge">Current CV</span>
                                                }
                                                <span class="badge @ScanBadgeCssClass(doc.ScanStatus)"
                                                      data-testid="candidate-document-scan-status"
                                                      data-scan-status="@(doc.ScanStatus ?? string.Empty)"
                                                      title="@ScanBadgeTitle(doc.ScanStatus)">
                                                    @ScanBadgeText(doc.ScanStatus)
                                                </span>
                                            </div>
                                            <div class="small text-muted">
                                                Uploaded @doc.CreatedAt.LocalDateTime.ToString("d MMM yyyy, HH:mm") · @FormatFileSize(doc.FileSize)
                                            </div>
                                            @if (doc.ReferencingApplicationCount > 0)
                                            {
                                                <div class="small text-muted" data-testid="candidate-cv-referenced">
                                                    Submitted with @doc.ReferencingApplicationCount application(s)
                                                </div>
                                            }
                                        </li>
                                    }
                                </ul>
                            }

                            @if (CanUploadCv)
                            {
                                <div class="mt-3">
                                    <InputFile @key="_cvFileInputKey" class="form-control" OnChange="OnCvFileSelected"
                                               accept=".pdf,.doc,.docx" data-testid="candidate-cv-file-input" />
                                    <div class="form-text">
                                        PDF, DOC or DOCX, up to 20 MB. Uploading a replacement makes it the candidate's current CV;
                                        earlier CVs are kept and applications continue to show the CV they were submitted with.
                                    </div>
                                    <div class="mt-2">
                                        <SfButton IsPrimary="true" Disabled="@(_cvBusy || _selectedCvFile is null)"
                                                  OnClick="UploadCvAsync" data-testid="candidate-cv-upload">
                                            @if (_cvBusy)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                            }
                                            @(_cvDocuments is { Count: > 0 } ? "Upload replacement CV" : "Upload CV")
                                        </SfButton>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    @* Internal recruitment Ticket 6: the candidate's application history across every
                       vacancy. Outside the EditForm like the CV card; read-only. *@
                    <div class="card mb-4" data-testid="candidate-applications-card">
                        <div class="card-header">
                            <h5 class="mb-0">Applications</h5>
                        </div>
                        <div class="card-body">
                            @if (_applications is null)
                            {
                                <p class="text-muted mb-0" data-testid="candidate-applications-error">Applications could not be loaded.</p>
                            }
                            else if (_applications.Count == 0)
                            {
                                <p class="text-muted mb-0" data-testid="candidate-applications-empty">This candidate has no applications.</p>
                            }
                            else
                            {
                                <ul class="list-group">
                                    @foreach (var application in _applications)
                                    {
                                        <li class="list-group-item" data-testid="candidate-application-row"
                                            data-application-id="@application.ApplicationId"
                                            data-internal="@(application.IsInternal ? "true" : "false")">
                                            <div class="candidate-application__header">
                                                <span class="candidate-application__vacancy"
                                                      data-testid="candidate-application-vacancy">@application.VacancyTitle</span>
                                                <InternalApplicationBadge IsInternal="@application.IsInternal" />
                                                @if (application.IsWithdrawn)
                                                {
                                                    <span data-testid="candidate-application-withdrawn">
                                                        <StatusBadge Variant="StatusBadgeVariant.Secondary">Withdrawn</StatusBadge>
                                                    </span>
                                                }
                                            </div>
                                            <div class="small text-muted">
                                                Stage: <span data-testid="candidate-application-stage">@(application.CurrentStageName ?? "Unknown")</span>
                                                · Applied <span data-testid="candidate-application-applied">@application.AppliedAt.LocalDateTime.ToString("d MMM yyyy")</span>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges" />

    <UnsavedChangesDialog Visible="ShowUnsavedChangesDialog"
                          OnSaveAndClose="ConfirmSaveAndCloseAsync"
                          OnDiscard="DiscardChangesAndClose"
                          OnCancel="CancelCloseDialog" />

    @if (_showDeactivateDialog)
    {
        <SfDialog Visible="_showDeactivateDialog" IsModal="true" Width="420px" ShowCloseIcon="false">
            <DialogTemplates>
                <Header>Deactivate Candidate</Header>
                <Content>
                    <p>Are you sure you want to deactivate @Model.FirstName @Model.LastName?</p>
                    <EditForm EditContext="_deactivateEditContext">
                        <DataAnnotationsValidator />
                        <label class="form-label">Reason <span class="text-danger">*</span></label>
                        <HrTextBox @bind-Value="_deactivateModel.Reason" Multiline="true" Rows="3"
                                   Maxlength="1000" Placeholder="Explain why this candidate is being deactivated" />
                        <ValidationMessage For="@(() => _deactivateModel.Reason)" class="text-danger small" />
                    </EditForm>
                </Content>
                <FooterTemplate>
                    <SfButton IsPrimary="true" CssClass="e-danger" Disabled="@(_actionBusy)" OnClick="ConfirmDeactivateAsync">
                        @if (_actionBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Deactivate
                    </SfButton>
                    <SfButton Disabled="_actionBusy" OnClick="@(() => _showDeactivateDialog = false)">Cancel</SfButton>
                </FooterTemplate>
            </DialogTemplates>
        </SfDialog>
    }

    <HrConfirmDialog Visible="_showReactivateDialog"
                     Title="Reactivate Candidate"
                     Message="@($"Are you sure you want to reactivate {Model.FirstName} {Model.LastName}?")"
                     ConfirmText="Reactivate"
                     CancelText="Cancel"
                     DangerConfirm="false"
                     Busy="_actionBusy"
                     OnConfirmed="ConfirmReactivateAsync"
                     OnCancelled="@(() => _showReactivateDialog = false)" />
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid? Id { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    [Parameter]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "origin")]
    [Parameter]
    public string? Origin { get; set; }

    private CandidateReturnDestination ResolvedOrigin => Origin switch
    {
        "dashboard" => CandidateReturnDestination.Dashboard,
        _ => CandidateReturnDestination.CandidatesList
    };

    private string OriginListUrl => ResolvedOrigin switch
    {
        CandidateReturnDestination.Dashboard => "/dashboard/recruitment",
        _ => $"/companies/{CompanyId}/candidates"
    };

    private GetCandidateResponse? _candidate;
    private string? _actionError;
    private bool _actionBusy;

    private bool _showDeactivateDialog;
    private readonly DeactivateCandidateFormModel _deactivateModel = new();
    private EditContext _deactivateEditContext = default!;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _deactivateEditContext = new EditContext(_deactivateModel);
    }

    private bool _showReactivateDialog;

    private string PageTitle => IsNew ? "Add Candidate"
        : Model.FirstName.Trim().Length > 0 ? $"{Model.FirstName} {Model.LastName}"
        : IsViewMode ? "View Candidate" : "Edit Candidate";

    protected override IEditService<CandidateEditModel, Guid> Service => CandidateService;
    protected override Guid GetCompanyId() => CompanyId;
    protected override Guid? GetId() => Id;

    protected override async Task OnLoadedAsync()
    {
        if (!AppSession.GuardAccess(Navigation, Session.CanViewCandidates))
            return;

        if (!IsNew)
        {
            _candidate = await CandidateService.GetCandidateAsync(CompanyId, Id!.Value);
            await LoadCvDocumentsAsync();
            await LoadApplicationsAsync();
        }
    }

    // ── Application history (internal recruitment Ticket 6) ─────────────────────

    private List<ApplicationSearchItemModel>? _applications = [];

    private bool IsInternalApplicant => _applications?.Any(a => a.IsInternal) == true;

    private async Task LoadApplicationsAsync()
    {
        var response = await ApplicationService.SearchApplicationsForCandidateAsync(CompanyId, Id!.Value, pageSize: 200);
        _applications = response?.Items
            .OrderByDescending(a => a.AppliedAt)
            .ToList();
    }

    // ── CV documents (internal recruitment Ticket 2) ────────────────────────────

    private List<CandidateDocumentListItemModel>? _cvDocuments = [];
    private IBrowserFile? _selectedCvFile;
    private int _cvFileInputKey;
    private bool _cvBusy;
    private string? _cvError;
    private string? _cvSuccess;

    private bool CanUploadCv => Session.CanManageRecruitment && _candidate is { IsActive: true };

    private async Task LoadCvDocumentsAsync()
    {
        var response = await CandidateService.ListCandidateDocumentsAsync(CompanyId, Id!.Value);
        _cvDocuments = response?.Items.Where(d => d.Kind == "Cv").ToList();
        StartScanPollingIfNeeded();
    }


    private const int ScanPollIntervalMs = 3_000;
    private const int ScanPollMaxAttempts = 10;
    private CancellationTokenSource? _scanPollCts;
    private bool _cvRefreshing;

    private bool AnyScanInProgress =>
        _cvDocuments?.Any(d => CandidateDocumentScanStatuses.IsInProgress(d.ScanStatus)) == true;

    private async Task RefreshCvDocumentsAsync()
    {
        if (_cvRefreshing || _cvBusy) return;
        _cvRefreshing = true;
        try
        {
            await LoadCvDocumentsAsync();
        }
        finally
        {
            _cvRefreshing = false;
        }
    }

    private void StartScanPollingIfNeeded()
    {
        StopScanPolling();
        if (!AnyScanInProgress)
            return;

        var cts = new CancellationTokenSource();
        _scanPollCts = cts;
        _ = PollScanStatusAsync(cts);
    }

    private void StopScanPolling()
    {
        var cts = _scanPollCts;
        _scanPollCts = null;
        if (cts is null) return;
        cts.Cancel();
        cts.Dispose();
    }

    private async Task PollScanStatusAsync(CancellationTokenSource cts)
    {
        var token = cts.Token;
        try
        {
            for (var attempt = 0; attempt < ScanPollMaxAttempts && !token.IsCancellationRequested; attempt++)
            {
                await Task.Delay(ScanPollIntervalMs, token);
                if (_cvRefreshing || _cvBusy) continue;

                var response = await CandidateService.ListCandidateDocumentsAsync(CompanyId, Id!.Value);
                if (token.IsCancellationRequested) return;
                if (response is not null)
                {
                    await InvokeAsync(() =>
                    {
                        if (token.IsCancellationRequested) return;
                        _cvDocuments = response.Items.Where(d => d.Kind == "Cv").ToList();
                        StateHasChanged();
                    });
                }

                if (!AnyScanInProgress) break;
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
        finally
        {
            if (ReferenceEquals(_scanPollCts, cts))
            {
                _scanPollCts = null;
                cts.Dispose();
            }
        }
    }

    public override void Dispose()
    {
        StopScanPolling();
        base.Dispose();
    }

    private static string ScanBadgeText(string? status) =>
        CandidateDocumentScanStatuses.IsClean(status) ? "Checked"
        : CandidateDocumentScanStatuses.IsInProgress(status) ? "Security check pending"
        : CandidateDocumentScanStatuses.IsInfected(status) ? "Quarantined — malware detected"
        : "Security check failed";

    private static string ScanBadgeCssClass(string? status) =>
        CandidateDocumentScanStatuses.IsClean(status) ? "candidate-document__scan--clean"
        : CandidateDocumentScanStatuses.IsInProgress(status) ? "bg-info text-dark"
        : CandidateDocumentScanStatuses.IsInfected(status) ? "bg-danger"
        : "bg-warning text-dark";

    private static string ScanBadgeTitle(string? status) =>
        CandidateDocumentScanStatuses.IsClean(status)
            ? "This file passed the malware check."
            : DownloadDisabledReason(status);

    private static string DownloadDisabledReason(string? status) =>
        CandidateDocumentScanStatuses.IsInProgress(status)
            ? "This file is being security checked and can be opened once the check completes."
        : CandidateDocumentScanStatuses.IsInfected(status)
            ? "This file failed a malware check and has been quarantined. It cannot be opened."
        : CandidateDocumentScanStatuses.IsClean(status)
            ? "This file is not currently available to download."
            : "This file could not be security checked and cannot be opened. Upload it again.";

    private void OnCvFileSelected(InputFileChangeEventArgs e)
    {
        _selectedCvFile = e.File;
        _cvError = null;
        _cvSuccess = null;
    }

    private async Task UploadCvAsync()
    {
        if (_selectedCvFile is null || _cvBusy)
            return;

        _cvBusy = true;
        _cvError = null;
        _cvSuccess = null;

        var file = _selectedCvFile;
        var (_, error) = await CandidateService.UploadCandidateDocumentAsync(
            CompanyId, Id!.Value, file.Name, "Cv", file);

        if (error is not null)
        {
            _cvError = error;
        }
        else
        {
            _cvSuccess = "CV uploaded. It is now the candidate's current CV.";
            await LoadCvDocumentsAsync();
        }

        _selectedCvFile = null;
        _cvFileInputKey++;
        _cvBusy = false;
    }

    private static readonly string[] _allowedCvExtensions = [".pdf", ".doc", ".docx"];
    private IBrowserFile? _newCvFile;
    private string? _newCvError;
    private int _newCvInputKey;
    private Guid? _createdCandidateId;

    private void OnNewCvSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();

        string? error = null;
        if (!_allowedCvExtensions.Contains(extension))
            error = "The CV must be a PDF, DOC or DOCX file.";
        else if (file.Size > CandidateService.MaxCandidateDocumentBytes)
            error = "The CV file is larger than the 20 MB limit.";
        else if (file.Size == 0)
            error = "The selected CV file is empty.";

        if (error is not null)
        {
            ClearNewCv();
            _newCvError = error;
            return;
        }

        _newCvFile = file;
        _newCvError = null;
    }

    private void RemoveNewCv() => ClearNewCv();

    private void ClearNewCv()
    {
        _newCvFile = null;
        _newCvError = null;
        _newCvInputKey++;
    }

    protected override async Task<string?> SaveCoreAsync()
    {
        if (!IsNew || (_newCvFile is null && _createdCandidateId is null))
            return await base.SaveCoreAsync();

        if (_createdCandidateId is null)
        {
            var request = new CreateCandidateRequest(
                CompanyId, FormText.Required(Model.FirstName), FormText.Required(Model.LastName),
                FormText.Required(Model.Email), FormText.Optional(Model.Phone));
            var (created, createError) = await CandidateService.CreateCandidateAsync(CompanyId, request);
            if (created is null)
                return createError ?? "Failed to save.";
            _createdCandidateId = created.Id;
        }

        if (_newCvFile is null)
            return null;

        var (_, uploadError) = await CandidateService.UploadCandidateDocumentAsync(
            CompanyId, _createdCandidateId.Value, _newCvFile.Name, "Cv", _newCvFile);

        return uploadError is null
            ? null
            : $"The candidate was created, but the CV could not be uploaded: {uploadError} Press Add to retry the upload, or remove the CV and press Add to finish.";
    }

    private static string FormatFileSize(long bytes) =>
        bytes < 1024 ? $"{bytes} B"
        : bytes < 1024 * 1024 ? $"{bytes / 1024.0:0.#} KB"
        : $"{bytes / (1024.0 * 1024.0):0.#} MB";

    protected override string? ListUrl => ReturnUrlValidator.ValidateInternalPathAllowingBaseRelative(ReturnUrl) ?? OriginListUrl;

    private async Task ConfirmDeactivateAsync()
    {
        if (!_deactivateEditContext.Validate())
            return;

        _actionError = null;
        _actionBusy = true;

        var (result, error) = await CandidateService.DeactivateCandidateAsync(CompanyId, Id!.Value, FormText.Required(_deactivateModel.Reason!));

        _actionBusy = false;

        if (error is not null)
        {
            _actionError = error;
            return;
        }

        _showDeactivateDialog = false;
        _deactivateModel.Reason = null;
        _deactivateEditContext = new EditContext(_deactivateModel);
        _candidate = await CandidateService.GetCandidateAsync(CompanyId, Id!.Value);
    }

    private sealed class DeactivateCandidateFormModel
    {
        [Required(ErrorMessage = "A reason is required.")]
        [MaxLength(1000)]
        public string? Reason { get; set; }
    }

    private async Task ConfirmReactivateAsync()
    {
        _actionError = null;
        _actionBusy = true;

        var (result, error) = await CandidateService.ReactivateCandidateAsync(CompanyId, Id!.Value);

        _actionBusy = false;

        if (error is not null)
        {
            _actionError = error;
            return;
        }

        _showReactivateDialog = false;
        _candidate = await CandidateService.GetCandidateAsync(CompanyId, Id!.Value);
    }
}
