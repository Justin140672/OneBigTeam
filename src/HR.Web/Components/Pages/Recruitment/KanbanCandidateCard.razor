@* Card template used inside VacancyKanbanBoard's drag-and-drop columns. Rendered once per candidate.
   The vacancy title and a plain stage-name badge were deliberately removed from this card (kept on
   the underlying KanbanCandidateModel DTO for other consumers, e.g. drill-down dialogs): the board is
   already filtered to a single vacancy, and every card already sits inside a column labelled with its
   stage name, so repeating both on every card was pure redundancy. The Hired/Rejected accent (border +
   badge) is still shown since that status is not otherwise visible once a card leaves the "current
   stage" column context. *@
<div class="kanban-candidate-card @StageCssClass" @onclick="() => OnOpen.InvokeAsync(Candidate)"
     role="group" aria-label="@($"{Candidate.CandidateFullName}, {Candidate.StageName}")"
     data-testid="kanban-candidate-card" data-application-id="@Candidate.ApplicationId">
    <div class="kanban-candidate-card__top">
        <ProfilePhotoAvatar PhotoUrl="@Candidate.CandidatePhotoUrl" Initials="@Initials" SizePx="36" />
        <div class="kanban-candidate-card__name-block">
            <button type="button" class="kanban-candidate-card__name"
                    aria-label="@($"Open {Candidate.CandidateFullName}, {Candidate.StageName}")"
                    @onclick="() => OnOpen.InvokeAsync(Candidate)" @onclick:stopPropagation="true">@Candidate.CandidateFullName</button>
            @if (Candidate.IsInternal)
            {
                <div class="kanban-candidate-card__internal">
                    <InternalApplicationBadge />
                </div>
            }
        </div>
        @if (TerminalOutcome != RecruitmentStageTerminalOutcome.None)
        {
            @* Stable hook: an "Internal" badge can render before this one on the card. *@
            <span data-testid="kanban-card-terminal-status"><StatusBadge Variant="@StatusVariant">@TerminalOutcome</StatusBadge></span>
        }
        @if (!IsTerminalStage)
        {
        <div class="kanban-candidate-card__actions">
            <button type="button" class="kanban-candidate-card__move-btn"
                    title="Move to stage…" aria-label="@($"Move {Candidate.CandidateFullName} to stage…")" aria-haspopup="true"
                    aria-expanded="@(_menuOpen ? "true" : "false")"
                    data-testid="kanban-card-move-stage-btn"
                    @onclick="ToggleMenu" @onclick:stopPropagation="true">
                <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
            </button>
            @if (_menuOpen)
            {
                <div class="kanban-candidate-card__move-menu" role="menu" aria-label="@($"Move {Candidate.CandidateFullName} to stage")"
                     data-testid="kanban-card-move-stage-menu">
                    @switch (PrimaryAction)
                    {
                        case KanbanCardAction.RecordOfferResponse:
                            <button type="button" role="menuitem" data-testid="kanban-card-record-offer-response"
                                    @onclick="() => Invoke(OnRecordOfferResponse)" @onclick:stopPropagation="true">
                                Record Offer Response
                            </button>
                            break;
                        case KanbanCardAction.Hire:
                            <button type="button" role="menuitem" data-testid="kanban-card-hire"
                                    @onclick="() => Invoke(OnHire)" @onclick:stopPropagation="true">
                                Hire
                            </button>
                            break;
                        case KanbanCardAction.Appoint:
                            <button type="button" role="menuitem" data-testid="kanban-card-appoint"
                                    @onclick="() => Invoke(OnAppoint)" @onclick:stopPropagation="true">
                                Appoint
                            </button>
                            break;
                        case KanbanCardAction.MakeOffer:
                            <button type="button" role="menuitem" data-testid="kanban-card-make-offer"
                                    @onclick="() => Invoke(OnMakeOffer)" @onclick:stopPropagation="true">
                                Make Offer
                            </button>
                            break;
                        case KanbanCardAction.RecordOutcome:
                            <button type="button" role="menuitem" data-testid="kanban-card-record-outcome"
                                    @onclick="() => Invoke(OnRecordOutcome)" @onclick:stopPropagation="true">
                                Record Outcome
                            </button>
                            break;
                        case KanbanCardAction.MoveToNextInterviewStage:
                            <button type="button" role="menuitem" data-testid="kanban-card-next-interview-stage"
                                    @onclick="MoveToNextInterviewStage" @onclick:stopPropagation="true">
                                Move to @Candidate.NextInterviewStageName
                            </button>
                            break;
                        case KanbanCardAction.ScheduleInterview:
                            <button type="button" role="menuitem" data-testid="kanban-card-schedule-interview"
                                    @onclick="() => Invoke(OnScheduleInterview)" @onclick:stopPropagation="true">
                                Schedule Interview
                            </button>
                            break;
                        case KanbanCardAction.ReviewCv:
                            <button type="button" role="menuitem" data-testid="kanban-card-review-cv"
                                    @onclick="() => Invoke(OnReviewCv)" @onclick:stopPropagation="true">
                                Review CV
                            </button>
                            break;
                    }
                    @if (ShowNoFurtherInterviewStage)
                    {
                        <span class="kanban-candidate-card__move-menu-empty" data-testid="kanban-card-no-further-interview-stage">
                            There is no further interview stage in this recruitment pipeline.
                        </span>
                        @if (KanbanCardActionResolver.ShowAddInterviewStageLink(Candidate, IsInterviewStage, CanManageStages))
                        {
                            <a role="menuitem" href="@AddInterviewStageUrl" data-testid="kanban-card-add-interview-stage"
                               @onclick:stopPropagation="true">Add another interview stage</a>
                        }
                    }
                    <hr class="kanban-candidate-card__move-menu-divider" role="separator" />
                    @if (AvailableStages.Count == 0)
                    {
                        <span class="kanban-candidate-card__move-menu-empty">No other stages available</span>
                    }
                    else
                    {
                        @foreach (var stage in AvailableStages)
                        {
                            var s = stage;
                            <button type="button" role="menuitem"
                                    @onclick="() => SelectStage(s.StageId)" @onclick:stopPropagation="true">
                                @s.StageName
                            </button>
                        }
                    }
                    <hr class="kanban-candidate-card__move-menu-divider" role="separator" />
                    <button type="button" role="menuitem" data-testid="kanban-card-reject"
                            @onclick="() => Invoke(OnReject)" @onclick:stopPropagation="true">
                        Reject
                    </button>
                    <button type="button" role="menuitem" data-testid="kanban-card-withdraw"
                            @onclick="() => Invoke(OnWithdraw)" @onclick:stopPropagation="true">
                        Withdraw
                    </button>
                </div>
            }
        </div>
        }
    </div>
    <div class="kanban-candidate-card__meta">
        <span><i class="fa-regular fa-calendar me-1" aria-hidden="true"></i>Applied @Candidate.AppliedAt.ToString("d MMM yyyy")</span>
        <span><i class="fa-regular fa-user me-1" aria-hidden="true"></i>@RecruiterName</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public KanbanCandidateModel Candidate { get; set; } = default!;
    [Parameter] public string RecruiterName { get; set; } = "Unassigned";
    [Parameter] public RecruitmentStageTerminalOutcome TerminalOutcome { get; set; } = RecruitmentStageTerminalOutcome.None;
    [Parameter] public EventCallback<KanbanCandidateModel> OnOpen { get; set; }

    [Parameter] public IReadOnlyList<KanbanColumnModel> AvailableStages { get; set; } = [];
    [Parameter] public EventCallback<Guid> OnMoveToStage { get; set; }

    [Parameter] public EventCallback<KanbanCandidateModel> OnReviewCv { get; set; }
    [Parameter] public EventCallback<KanbanCandidateModel> OnScheduleInterview { get; set; }
    [Parameter] public bool IsInterviewStage { get; set; }
    [Parameter] public EventCallback<KanbanCandidateModel> OnRecordOutcome { get; set; }
    [Parameter] public EventCallback<KanbanCandidateModel> OnMakeOffer { get; set; }
    [Parameter] public EventCallback<KanbanCandidateModel> OnRecordOfferResponse { get; set; }
    [Parameter] public EventCallback<KanbanCandidateModel> OnHire { get; set; }
    [Parameter] public EventCallback<KanbanCandidateModel> OnAppoint { get; set; }
    [Parameter] public EventCallback<KanbanCandidateModel> OnReject { get; set; }
    [Parameter] public EventCallback<KanbanCandidateModel> OnWithdraw { get; set; }
    [Parameter] public bool IsOfferStage { get; set; }
    [Parameter] public bool IsTerminalStage { get; set; }
    [Parameter] public bool CanAppointInternal { get; set; }
    [Parameter] public bool CanManageStages { get; set; }
    [Parameter] public string AddInterviewStageUrl { get; set; } = string.Empty;

    private bool ShowNoFurtherInterviewStage =>
        KanbanCardActionResolver.ShowNoFurtherInterviewStage(Candidate, IsInterviewStage);

    private KanbanCardAction PrimaryAction =>
        KanbanCardActionResolver.Resolve(Candidate, IsInterviewStage, IsOfferStage, CanAppointInternal);

    private bool _menuOpen;

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    private async Task Invoke(EventCallback<KanbanCandidateModel> callback)
    {
        _menuOpen = false;
        await callback.InvokeAsync(Candidate);
    }

    private async Task MoveToNextInterviewStage()
    {
        _menuOpen = false;
        if (Candidate.NextInterviewStageId is { } stageId)
            await OnMoveToStage.InvokeAsync(stageId);
    }

    private async Task SelectStage(Guid stageId)
    {
        _menuOpen = false;
        await OnMoveToStage.InvokeAsync(stageId);
    }

    private string Initials =>
        $"{(Candidate.CandidateFirstName.Length > 0 ? Candidate.CandidateFirstName[0] : '?')}{(Candidate.CandidateLastName.Length > 0 ? Candidate.CandidateLastName[0] : '?')}"
            .ToUpperInvariant();

    // Rejected/Hired get a visually distinct accent — see StatusBadge for the badge itself, this is
    // the card container accent (danger/success border). Withdrawn applications never reach this
    // card at all (VacancyKanbanBoard.FilteredCards excludes them from the board entirely), so there
    // is no IsWithdrawn branch here to maintain.
    private string StageCssClass => TerminalOutcome switch
    {
        RecruitmentStageTerminalOutcome.Hired => "kanban-candidate-card--success",
        RecruitmentStageTerminalOutcome.Rejected => "kanban-candidate-card--danger",
        _ => string.Empty,
    };

    private StatusBadgeVariant StatusVariant => TerminalOutcome switch
    {
        RecruitmentStageTerminalOutcome.Hired => StatusBadgeVariant.Success,
        RecruitmentStageTerminalOutcome.Rejected => StatusBadgeVariant.Danger,
        _ => StatusBadgeVariant.Info,
    };
}
