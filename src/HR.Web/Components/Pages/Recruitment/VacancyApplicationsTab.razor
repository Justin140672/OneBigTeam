@* Internal recruitment Ticket 7: an INTERNAL application is completed by appointing the existing
   employee (the backend rejects Hire for internal applications). Position profile, department and
   location are derived server-side from the vacancy and only shown here for confirmation. *@
<SfDialog Width="560px" IsModal="true" @bind-Visible="_showAppointDialog" Header="Complete internal appointment" CssClass="appoint-candidate-dialog">
    <DialogTemplates>
        <Content>
            <div data-testid="appoint-candidate-dialog">
                <EditForm EditContext="_appointEditContext">
                    <DataAnnotationsValidator />
                    <div class="alert alert-info py-2" data-testid="appoint-existing-employee-notice">
                        @_appointCandidateName is an existing employee. Their existing employee record will be updated — no new employee will be created. Employee number, start date, continuous service and system access stay the same.
                    </div>
                    @if (_appointPending)
                    {
                        <div class="alert alert-warning py-2" data-testid="appoint-pending-notice">
                            Appointment in progress — a previous attempt did not finish. Appointing again will complete it.
                        </div>
                    }
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Position Profile</label>
                            <div class="p-2 rounded border bg-light" data-testid="appoint-derived-position-profile">@_derivedPositionProfileName</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Department</label>
                            <div class="p-2 rounded border bg-light" data-testid="appoint-derived-department">@_derivedDepartmentName</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Location</label>
                            <div class="p-2 rounded border bg-light" data-testid="appoint-derived-location">@_derivedLocationName</div>
                        </div>
                        <div class="col-12">
                            <div class="form-text mt-0">Derived from the vacancy's position profile — the employee is moved to this profile, department and location.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Effective Date <span class="text-danger">*</span></label>
                            <SfDatePicker TValue="DateOnly?" @bind-Value="_appointModel.EffectiveDate" Format="dd/MM/yyyy" data-testid="appoint-effective-date" />
                            <ValidationMessage For="@(() => _appointModel.EffectiveDate)" />
                            @if (_appointModel.IsFutureDated)
                            {
                                <div class="form-text" data-testid="appoint-future-date-hint">The change will be applied automatically on this date.</div>
                            }
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Manager <span class="text-danger">*</span></label>
                            <SfDropDownList @ref="_appointManagerDropdown"
                                            TValue="Guid?"
                                            TItem="ManagerOption"
                                            DataSource="@_appointManagerOptions"
                                            @bind-Value="_appointModel.ManagerId"
                                            Placeholder="Select a manager"
                                            AllowFiltering="true"
                                            data-testid="appoint-manager">
                                <DropDownListFieldSettings Value="Id" Text="Name" />
                                <DropDownListEvents TValue="Guid?" TItem="ManagerOption" Filtering="OnAppointManagerFilteringAsync" />
                            </SfDropDownList>
                            <ValidationMessage For="@(() => _appointModel.ManagerId)" />
                        </div>
                        @if (_appointModel.IsBackdated)
                        {
                            <div class="col-12" data-testid="appoint-confirm-backdated">
                                <SfCheckBox TChecked="bool" @bind-Checked="_appointModel.ConfirmBackdated"
                                            Label="I confirm this backdated appointment should apply immediately" />
                                <ValidationMessage For="@(() => _appointModel.ConfirmBackdated)" />
                            </div>
                        }
                        <div class="col-12" data-testid="appoint-change-compensation">
                            <SfCheckBox TChecked="bool" @bind-Checked="_appointModel.ChangeCompensation" Label="Change compensation" />
                        </div>
                        @if (_appointModel.ChangeCompensation)
                        {
                            <div class="col-md-4">
                                <label class="form-label">Salary Type <span class="text-danger">*</span></label>
                                <SfDropDownList TValue="string" TItem="string" DataSource="@_appointSalaryTypeOptions"
                                                @bind-Value="_appointModel.SalaryType" data-testid="appoint-salary-type" />
                                <ValidationMessage For="@(() => _appointModel.SalaryType)" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Salary <span class="text-danger">*</span></label>
                                <SfNumericTextBox TValue="decimal?" @bind-Value="_appointModel.Salary" Format="n2" Min="0" ShowSpinButton="false" data-testid="appoint-salary" />
                                <ValidationMessage For="@(() => _appointModel.Salary)" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Currency <span class="text-danger">*</span></label>
                                <HrTextBox @bind-Value="_appointModel.Currency" Placeholder="e.g. GBP" data-testid="appoint-currency" />
                                <ValidationMessage For="@(() => _appointModel.Currency)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Hours per Week</label>
                                <SfNumericTextBox TValue="decimal?" @bind-Value="_appointModel.HoursPerWeek" Format="n2" Min="0" ShowSpinButton="false" data-testid="appoint-hours-per-week" />
                                <ValidationMessage For="@(() => _appointModel.HoursPerWeek)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">FTE</label>
                                <SfNumericTextBox TValue="decimal?" @bind-Value="_appointModel.Fte" Format="n2" Min="0" Max="1" Step="0.1m" ShowSpinButton="false" data-testid="appoint-fte" />
                                <ValidationMessage For="@(() => _appointModel.Fte)" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Compensation Notes</label>
                                <HrTextBox @bind-Value="_appointModel.CompensationNotes" Multiline="true" Rows="2" data-testid="appoint-compensation-notes" />
                                <ValidationMessage For="@(() => _appointModel.CompensationNotes)" />
                            </div>
                        }
                    </div>
                    @if (_dialogError is not null)
                    {
                        <div class="alert alert-danger py-2 mt-3" role="alert" data-testid="appoint-error">@_dialogError</div>
                    }
                </EditForm>
            </div>
        </Content>
        <FooterTemplate>
            @* Disabled while in flight so a double click can't submit twice. *@
            <SfButton IsPrimary="true" Disabled="_appointing" OnClick="ConfirmAppointAsync" data-testid="appoint-confirm">
                @if (_appointing)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                Appoint
            </SfButton>
            <SfButton Disabled="_appointing" OnClick="() => _showAppointDialog = false" data-testid="appoint-cancel">Cancel</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<SfDialog Width="520px" IsModal="true" @bind-Visible="_showOfferDialog" Header="Make an Offer" CssClass="offer-candidate-dialog">
    <DialogTemplates>
        <Content>
            <EditForm EditContext="_offerEditContext">
                <DataAnnotationsValidator />
                <div class="alert alert-light border py-2" data-testid="offer-position-profile-context">
                    <div class="fw-semibold">@(_offerProfileTitle ?? "Position Profile")</div>
                    <div class="text-muted small">
                        Salary range:
                        @if (_offerSalaryMin is not null || _offerSalaryMax is not null)
                        {
                            <span>@FormatMoney(_offerSalaryMin) – @FormatMoney(_offerSalaryMax)</span>
