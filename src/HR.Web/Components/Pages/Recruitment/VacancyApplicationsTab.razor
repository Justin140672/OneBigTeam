                        <ValidationMessage For="@(() => _offerModel.OfferedSalaryFrequency)" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Proposed Start Date</label>
                        <SfDatePicker TValue="DateOnly?" @bind-Value="_offerModel.ProposedStartDate" data-testid="offer-proposed-start-date" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Offer Date</label>
                        <SfDatePicker TValue="DateOnly?" @bind-Value="_offerModel.OfferDate" data-testid="offer-date" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Offer Notes</label>
                        <HrTextBox @bind-Value="_offerModel.OfferNotes" Multiline="true" Rows="3" data-testid="offer-notes" />
                        <ValidationMessage For="@(() => _offerModel.OfferNotes)" />
