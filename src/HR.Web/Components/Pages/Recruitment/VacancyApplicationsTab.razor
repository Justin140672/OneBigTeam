        _appointEmployeeId = row.EmployeeId;
        _appointPending = row.InternalAppointmentStatus == "Pending";
        _appointCandidateName = $"{row.CandidateFirstName} {row.CandidateLastName}".Trim();

        _appointModel.EffectiveDate = row.OfferedStartDate ?? DateOnly.FromDateTime(DateTime.Today);
        _appointModel.ConfirmBackdated = false;
        _appointModel.ManagerId = null;
        _appointModel.ChangeCompensation = false;
        _appointModel.SalaryType = "Annual";
        _appointModel.Salary = row.OfferedSalary;
        _appointModel.Currency = "GBP";
        _appointModel.HoursPerWeek = null;
        _appointModel.Fte = null;
        _appointModel.CompensationNotes = null;
        _appointEditContext = new EditContext(_appointModel);

        _derivedPositionProfileName = string.Empty;
        _derivedDepartmentName = string.Empty;
        _derivedLocationName = string.Empty;

        var vacancyTask = VacancyService.GetVacancyAsync(CompanyId, VacancyId);
        var managerTask = EmployeeService.ListSelectableEmployeesAsync(CompanyId, pageSize: 50);
        await Task.WhenAll(vacancyTask, managerTask);

        var vacancy = await vacancyTask;
        _derivedPositionProfileName = vacancy?.PositionProfileTitle ?? vacancy?.EffectiveTitle ?? "(unknown)";
        _derivedLocationName = vacancy?.EffectiveLocation ?? "(none set)";
        _derivedDepartmentName = "(none set)";
        if (vacancy?.PositionProfileDepartmentId is Guid departmentId)
        {
            var department = await DepartmentService.GetDepartmentAsync(CompanyId, departmentId);
            _derivedDepartmentName = department?.Name ?? "(unknown)";
        }

        _appointManagerOptions = BuildAppointManagerOptions((await managerTask)?.Items);

        _appointModel.ManagerId = NoManagerOption.Id;
        if (vacancy is not null && vacancy.HiringManagerId != Guid.Empty && vacancy.HiringManagerId != _appointEmployeeId)
        {
            if (_appointManagerOptions.Any(o => o.Id == vacancy.HiringManagerId))
            {
                _appointModel.ManagerId = vacancy.HiringManagerId;
            }
            else
            {
                var hiringManager = await EmployeeDirectoryService.GetAsync(CompanyId, vacancy.HiringManagerId);
                if (hiringManager is not null)
                {
                    _appointManagerOptions.Insert(1, new ManagerOption(hiringManager.Id, $"{hiringManager.FirstName} {hiringManager.LastName}"));
                    _appointModel.ManagerId = hiringManager.Id;
                }
            }
        }

        _showAppointDialog = true;
    }

    private List<ManagerOption> BuildAppointManagerOptions(IEnumerable<EmployeeListItemModel>? employees) =>
        (employees ?? [])
            .Where(e => e.Status != "Draft" && e.Status != "FormerEmployee")
            .Where(e => e.Id != _appointEmployeeId)
            .Select(e => new ManagerOption(e.Id, $"{e.FirstName} {e.LastName}"))
            .OrderBy(e => e.Name)
            .Prepend(NoManagerOption)
            .ToList();

