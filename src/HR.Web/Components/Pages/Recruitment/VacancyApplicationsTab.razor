    }

    private async Task ConfirmAppointAsync()
    {
        if (_activeApplication is null || _appointing)
            return;

        _dialogError = null;
        if (!_appointEditContext.Validate())
        {
            _dialogError = _appointEditContext.GetValidationMessages().FirstOrDefault()
                ?? "Please correct the highlighted fields below.";
            return;
        }

        var noManager = _appointModel.ManagerId == NoManagerOption.Id;
        var changeComp = _appointModel.ChangeCompensation;
        var request = new AppointInternalCandidateRequest(
            EffectiveDate: _appointModel.EffectiveDate,
            ConfirmBackdatedEffectiveDate: _appointModel.IsBackdated && _appointModel.ConfirmBackdated,
            ManagerId: noManager ? null : _appointModel.ManagerId,
            NoManager: noManager,
            CreateCompensationChange: changeComp,
            CompensationSalaryType: changeComp ? _appointModel.SalaryType : null,
            CompensationSalary: changeComp ? _appointModel.Salary : null,
            CompensationCurrency: changeComp ? _appointModel.Currency?.Trim().ToUpperInvariant() : null,
            CompensationHoursPerWeek: changeComp ? _appointModel.HoursPerWeek : null,
            CompensationFte: changeComp ? _appointModel.Fte : null,
            CompensationNotes: changeComp ? FormText.Optional(_appointModel.CompensationNotes) : null);

        _appointing = true;
        try
        {
            var (result, error) = await ApplicationService.AppointInternalCandidateAsync(
                CompanyId, VacancyId, _activeApplication.Id, request);

            if (result is null)
            {
                _dialogError = error;
                return;
            }

            _showAppointDialog = false;
            _actionSuccess = null;
            _actionError = null;
            _appointSuccess = new AppointSuccessInfo(result.EmployeeId, _appointCandidateName, result.IsApplied, result.EffectiveDate);
        }
        finally
        {
            _appointing = false;
        }

        await LoadAsync();
    }

    // Row-level actions (Schedule Interview/Offer/Hire/Reject/Withdraw) moved into the grid toolbar
    // rather than a dedicated Actions column, matching the toolbar pattern used elsewhere in the app
    // (see SearchPageBase's selection-dependent toolbar buttons). Enabled state tracks the current
    // row selection and that row's eligibility (IsActive/HasPendingInterview), same rules as before.
    private IEnumerable<object> GridToolbar
    {
        get
        {
            var active = _selectedRow is not null && IsActive(_selectedRow);
            var pendingInterview = _selectedRow is not null && HasPendingInterview(_selectedRow);
            var onOfferStage = _selectedRow is not null && IsOnOfferStage(_selectedRow);
            var enabled = active && !pendingInterview;

            // An offer's already been made once on the Offer stage — Schedule Interview/Offer/
            // Reject stop making sense there (Hire and Withdraw remain valid).
            var enabledPreOffer = enabled && !onOfferStage;
            var canRecordOfferResponse = _selectedRow?.OfferResponseStatus == "AwaitingResponse";

            var items = new List<object>
            {
                new ItemModel { Id = "app-schedule", Text = "Schedule Interview", PrefixIcon = "fa-solid fa-calendar-plus", Disabled = !enabledPreOffer, TooltipText = "Schedule an interview for the selected application" },
                new ItemModel { Id = "app-offer",     Text = "Offer",              PrefixIcon = "fa-solid fa-file-signature", Disabled = !enabledPreOffer, TooltipText = "Make an offer to the selected candidate" },
                new ItemModel { Id = "app-offer-response", Text = "Record Offer Response", PrefixIcon = "fa-solid fa-reply", Disabled = !canRecordOfferResponse, TooltipText = "Record the candidate's response to the standing offer" },
                new ItemModel { Id = "app-hire",      Text = "Hire",               PrefixIcon = "fa-solid fa-user-check", Disabled = !CanHire(_selectedRow), TooltipText = "Hire the selected candidate" },
                new ItemModel { Id = "app-reject",    Text = "Reject",             PrefixIcon = "fa-solid fa-user-xmark", Disabled = !enabledPreOffer, TooltipText = "Reject the selected candidate" },
                new ItemModel { Id = "app-withdraw",  Text = "Withdraw",           PrefixIcon = "fa-solid fa-arrow-rotate-left", Disabled = _selectedRow is null, TooltipText = "Withdraw the selected application" },
            };

            if (_canAppoint)
            {
                items.Insert(4, new ItemModel { Id = "app-appoint", Text = "Appoint", PrefixIcon = "fa-solid fa-user-tie", Disabled = !CanAppoint(_selectedRow), TooltipText = "Complete internal appointment" });
            }

            return items;
        }
    }

    // Internal recruitment Ticket 7: Hire is for EXTERNAL applications only; INTERNAL applications
    // are completed via Appoint instead. Both share Hire's eligibility (active, no pending interview).
    // A "Pending" appointment (an earlier attempt that didn't finish) keeps Appoint enabled so a
    // retry can complete it; a "Completed" one disables it.
    private bool CanHire(ApplicationListItemModel? row) =>
        row is not null && !row.IsInternal && IsActive(row) && !HasPendingInterview(row);

    private bool CanAppoint(ApplicationListItemModel? row) =>
        _canAppoint && row is not null && row.IsInternal && row.InternalAppointmentStatus != "Completed" && !row.IsWithdrawn &&
        (row.InternalAppointmentStatus == "Pending" || (IsActive(row) && !HasPendingInterview(row)));

    private SelectedApplicationMarker? _selectionMarker;

    private async Task OnRowSelected(RowSelectEventArgs<ApplicationListItemModel> args)
    {
        _selectedRow = args.Data;
        await RefreshToolbarStateAsync();
        _selectionMarker?.Set(_selectedRow?.Id);
    }

    private async Task OnRowDeselected(RowDeselectEventArgs<ApplicationListItemModel> args)
    {
        _selectedRow = null;
        await RefreshToolbarStateAsync();
        _selectionMarker?.Set(null);
    }

    private async Task RefreshToolbarStateAsync()
    {
        if (_grid is null) return;

        var active = _selectedRow is not null && IsActive(_selectedRow);
        var pendingInterview = _selectedRow is not null && HasPendingInterview(_selectedRow);
        var onOfferStage = _selectedRow is not null && IsOnOfferStage(_selectedRow);
        var enabled = active && !pendingInterview;
        var enabledPreOffer = enabled && !onOfferStage;

        await _grid.EnableToolbarItemsAsync(["app-schedule", "app-offer", "app-reject"], enabledPreOffer);
        await _grid.EnableToolbarItemsAsync(["app-hire"], CanHire(_selectedRow));
        if (_canAppoint) await _grid.EnableToolbarItemsAsync(["app-appoint"], CanAppoint(_selectedRow));
        await _grid.EnableToolbarItemsAsync(["app-withdraw"], _selectedRow is not null);
        await _grid.EnableToolbarItemsAsync(["app-offer-response"], _selectedRow?.OfferResponseStatus == "AwaitingResponse");
    }

    private async Task OnToolbarClick(ClickEventArgs args)
    {
        if (_selectedRow is null) return;
        var row = _selectedRow;

        switch (args.Item.Id)
        {
            case "app-schedule":
                await OpenScheduleDialog(row);
                break;
            case "app-offer":
                await OpenOfferDialog(row);
                break;
            case "app-offer-response":
                OpenOfferResponseDialog(row);
                break;
            case "app-hire":
                if (CanHire(row)) await OpenHireDialog(row);
                break;
            case "app-appoint":
                if (CanAppoint(row)) await OpenAppointDialog(row);
                break;
            case "app-reject":
                OpenRejectDialog(row);
                break;
            case "app-withdraw":
                await WithdrawAsync(row);
                break;
        }
    }

    private async Task OnHireManagerFilteringAsync(Syncfusion.Blazor.DropDowns.FilteringEventArgs args)
    {
        args.PreventDefaultAction = true;
        var result = await EmployeeService.ListSelectableEmployeesAsync(CompanyId, search: args.Text, pageSize: 50);
        _hireManagerOptions = (result?.Items ?? [])
            .Where(e => e.Status != "Draft" && e.Status != "FormerEmployee")
            .Select(e => new ManagerOption(e.Id, $"{e.FirstName} {e.LastName}"))
            .OrderBy(e => e.Name)
            .Prepend(new ManagerOption(Guid.Empty, "No Manager"))
            .ToList();
        await _hireManagerDropdown.FilterAsync(_hireManagerOptions, new Query());
    }

    private sealed record ManagerOption(Guid Id, string Name);

    private async Task ConfirmHireAsync()
    {
        var employeeNumberRequired = _hireEmployeeNumberMode != EmployeeNumberMode.Automatic;

        if (_activeApplication is null)
            return;

        if (_hireOfferBlockedMessage is not null)
        {
            _dialogError = _hireOfferBlockedMessage;
            return;
        }

        if (!_hireEditContext.Validate())
        {
            _dialogError = _hireEditContext.GetValidationMessages().FirstOrDefault()
                ?? "Please correct the highlighted fields below.";
            return;
        }

        var request = new HireCandidateRequest(
            CompanyId, VacancyId, _activeApplication.Id,
            _hireModel.StartDate, _hireModel.DateOfBirth!.Value, _hireModel.Nationality!, _hireModel.Gender!,
            FormText.Optional(_hireModel.GenderOther),
            employeeNumberRequired ? FormText.Required(_hireModel.EmployeeNumber!) : string.Empty, _hireModel.EmploymentTypeId!.Value,
            _hireModel.ManagerId == Guid.Empty ? null : _hireModel.ManagerId,
            FormText.Optional(_hireModel.AddressLine1),
            FormText.Optional(_hireModel.AddressLine2),
            FormText.Optional(_hireModel.City),
            FormText.Optional(_hireModel.County),
            FormText.Optional(_hireModel.PostCode));

        var (result, error) = await ApplicationService.HireCandidateAsync(CompanyId, VacancyId, _activeApplication.Id, request);

        if (result is null)
        {
            _dialogError = error;
            return;
        }

        _showHireDialog = false;
        _actionSuccess = $"Candidate hired as employee {result.EmployeeId}.";
        _actionError = null;
        await LoadAsync();
    }
}
