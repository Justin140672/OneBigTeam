    private KanbanCardAction ActionFor(ApplicationListItemModel? row)
    {
        if (row is null || !IsActive(row)) return KanbanCardAction.None;

        return KanbanCardActionResolver.Resolve(
            row, Stage(row.CurrentStageId) is { Purpose: RecruitmentStagePurpose.Interview }, IsOnOfferStage(row), _canAppoint);
    }

