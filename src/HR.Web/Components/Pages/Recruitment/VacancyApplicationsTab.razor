    private Guid? _currentCvCandidateId;
    private bool _attachCurrentCv = true;
    private int _cvLookupRequestId;

    private CandidateDocumentListItemModel? CurrentCvForSelection =>
        _currentCv is not null && _currentCvCandidateId is not null && _currentCvCandidateId == _addModel.CandidateId
            ? _currentCv
            : null;

    private IBrowserFile? _newCvFile;
    private string? _newCvError;
    private int _newCvInputKey;
    private static readonly string[] _allowedCvExtensions = [".pdf", ".doc", ".docx"];

    private DuplicateCandidateModel? _duplicateCandidate;

    private sealed record SourceOption(string Value, string Label);
    private static readonly List<SourceOption> _sourceOptions =
    [
        new("Unspecified", "Unspecified"),
        new("Direct", "Direct"),
        new("Referral", "Referral"),
        new("ExternalRecruiter", "External Recruiter"),
        new("JobBoard", "Job Board"),
        new("CareersSite", "Careers Site"),
    ];
    private List<ExternalRecruiterListItemModel> _activeRecruitersForSource = [];
    private Guid? _vacancyAssignedRecruiterId;

    private bool _recruiterNotAssignedWarning =>
        _addModel.Source == "ExternalRecruiter" &&
        _addModel.SourceRecruiterId is Guid id &&
        id != _vacancyAssignedRecruiterId;

    private readonly Dictionary<Guid, GetApplicationResponse> _sourceDetails = [];

    private static string SourceLabel(string? source) =>
        _sourceOptions.FirstOrDefault(o => o.Value == source)?.Label ?? source ?? "Unspecified";

    private bool _showScheduleDialog;
    private List<EmployeeListItemModel> _employees = [];
    private ApplicationListItemModel? _activeApplication;
    private readonly ScheduleInterviewFormModel _scheduleModel = new();
    private EditContext _scheduleEditContext = default!;

    protected override void OnInitialized()
    {
        _scheduleEditContext = new EditContext(_scheduleModel);
        _addEditContext = new EditContext(_addModel);
        _hireEditContext = new EditContext(_hireModel);
        _appointEditContext = new EditContext(_appointModel);
        _offerEditContext = new EditContext(_offerModel);
        _offerResponseEditContext = new EditContext(_offerResponseModel);
    }

    private bool _showOfferDialog;
    private readonly OfferFormModel _offerModel = new();
    private EditContext _offerEditContext = default!;
    private string? _offerProfileTitle;
    private decimal? _offerSalaryMin;
    private decimal? _offerSalaryMax;
    private string? _offerSalaryType;
    private static readonly string[] _salaryFrequencyOptions = ["None", "Annual", "Hourly", "Daily"];

    private bool _showOfferResponseDialog;
    private readonly OfferResponseFormModel _offerResponseModel = new();
    private EditContext _offerResponseEditContext = default!;
    private static readonly string[] _offerResponseOptions = ["Accepted", "Declined", "Withdrawn"];

    private bool _hireOfferAccepted;
    private bool _hireStartDateOptional;
    private string? _hireOfferBlockedMessage;
    private decimal? _hireOfferedSalary;
    private string? _hireOfferedSalaryFrequency;

    public sealed class OfferFormModel
    {
        public decimal? OfferedSalary { get; set; }
        public string? OfferedSalaryFrequency { get; set; } = "None";
        public DateOnly? ProposedStartDate { get; set; }
        public DateOnly? OfferDate { get; set; }
        [MaxLength(2000, ErrorMessage = "Offer notes cannot exceed 2000 characters.")]
        public string? OfferNotes { get; set; }
    }

    public sealed class OfferResponseFormModel
    {
        [Required(ErrorMessage = "Please select a response.")]
        public string? Status { get; set; }
    }

    private static string FormatMoney(decimal? value) => value is null ? "—" : value.Value.ToString("C0");

    private static string FormatOfferedSalary(decimal? salary, string? frequency)
    {
        if (salary is null) return "salary not recorded";
        var suffix = frequency switch
        {
            "Annual" => " /year",
            "Hourly" => " /hour",
            "Daily" => " /day",
            _ => "",
        };
        return salary.Value.ToString("C0") + suffix;
    }

    private static StatusBadgeVariant OfferResponseVariant(string? status) => status switch
    {
        "Accepted" => StatusBadgeVariant.Success,
        "Declined" or "Withdrawn" => StatusBadgeVariant.Danger,
        "AwaitingResponse" => StatusBadgeVariant.Warning,
        _ => StatusBadgeVariant.Secondary,
    };

    private static string OfferResponseLabel(string? status) => status switch
    {
        "AwaitingResponse" => "Awaiting response",
        _ => status ?? "—",
    };

    private async Task OpenOfferDialog(ApplicationListItemModel row)
    {
        _dialogError = null;
        _activeApplication = row;
        _offerModel.OfferedSalary = null;
        _offerModel.OfferedSalaryFrequency = "None";
        _offerModel.ProposedStartDate = null;
        _offerModel.OfferDate = DateOnly.FromDateTime(DateTime.Today);
        _offerModel.OfferNotes = null;
        _offerProfileTitle = null;
        _offerSalaryMin = _offerSalaryMax = null;
        _offerSalaryType = null;

        var vacancy = await VacancyService.GetVacancyAsync(CompanyId, VacancyId);
        _offerProfileTitle = vacancy?.PositionProfileTitle ?? vacancy?.EffectiveTitle;
        if (vacancy is not null)
        {
            var profile = await PositionProfileService.GetPositionProfileAsync(CompanyId, vacancy.PositionProfileId);
            _offerSalaryMin = profile?.SalaryMin;
            _offerSalaryMax = profile?.SalaryMax;
            _offerSalaryType = profile?.SalaryType;
        }

        _offerModel.OfferedSalary = _offerSalaryMin;

        _offerEditContext = new EditContext(_offerModel);
        _showOfferDialog = true;
    }

    private async Task ConfirmOfferAsync()
    {
        if (_activeApplication is null || !_offerEditContext.Validate())
            return;

        var freq = _offerModel.OfferedSalaryFrequency is null or "None" ? null : _offerModel.OfferedSalaryFrequency;
        var request = new OfferCandidateRequest(
            CompanyId, VacancyId, _activeApplication.Id,
            _offerModel.OfferedSalary, freq, _offerModel.ProposedStartDate, _offerModel.OfferDate,
            FormText.Optional(_offerModel.OfferNotes));

        var (result, error) = await ApplicationService.OfferCandidateAsync(CompanyId, VacancyId, _activeApplication.Id, request);
        if (result is null)
        {
            _dialogError = error;
            return;
        }

        _showOfferDialog = false;
        _actionSuccess = "Offer made to candidate.";
        _actionError = null;
        await LoadAsync();
    }

    private void OpenOfferResponseDialog(ApplicationListItemModel row)
    {
        _dialogError = null;
        _activeApplication = row;
        _offerResponseModel.Status = null;
        _offerResponseEditContext = new EditContext(_offerResponseModel);
        _showOfferResponseDialog = true;
    }

    private async Task ConfirmOfferResponseAsync()
    {
        if (_activeApplication is null || !_offerResponseEditContext.Validate())
            return;

        var (result, error) = await ApplicationService.RespondToOfferAsync(
            CompanyId, VacancyId, _activeApplication.Id, _offerResponseModel.Status!);
        if (result is null)
        {
            _dialogError = error;
            return;
        }

        _showOfferResponseDialog = false;
        _actionSuccess = $"Offer response recorded: {EnumDisplay.Humanize(result.OfferResponseStatus)}.";
        _actionError = null;
        await LoadAsync();
    }

    public enum AddCandidateMode { Existing, New }

    public sealed class AddApplicationFormModel : IValidatableObject
    {
        public AddCandidateMode Mode { get; set; } = AddCandidateMode.Existing;

        public Guid? CandidateId { get; set; }

        // New mode (internal recruitment Ticket 3).
        [MaxLength(100, ErrorMessage = "First name cannot exceed 100 characters.")]
        public string? FirstName { get; set; }

        [MaxLength(100, ErrorMessage = "Last name cannot exceed 100 characters.")]
        public string? LastName { get; set; }

        [MaxLength(256, ErrorMessage = "Email cannot exceed 256 characters.")]
        public string? Email { get; set; }

        [MaxLength(30, ErrorMessage = "Phone cannot exceed 30 characters.")]
        public string? Phone { get; set; }

        [MaxLength(500, ErrorMessage = "Resume URL cannot exceed 500 characters.")]

        public string Source { get; set; } = "Unspecified";

        public Guid? SourceRecruiterId { get; set; }

        [MaxLength(2000)]
        public string? Notes { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (Mode == AddCandidateMode.Existing)
            {
                if (CandidateId is null)
                    yield return new ValidationResult("Please select a candidate.", [nameof(CandidateId)]);
            }
            else
            {
                if (string.IsNullOrWhiteSpace(FirstName))
                    yield return new ValidationResult("First name is required.", [nameof(FirstName)]);

                if (string.IsNullOrWhiteSpace(LastName))
                    yield return new ValidationResult("Last name is required.", [nameof(LastName)]);

                if (string.IsNullOrWhiteSpace(Email))
                    yield return new ValidationResult("Email is required.", [nameof(Email)]);
                else if (!new EmailAddressAttribute().IsValid(Email.Trim()))
                    yield return new ValidationResult("Enter a valid email address.", [nameof(Email)]);
            }

            if (Source == "ExternalRecruiter" && SourceRecruiterId is null)
                yield return new ValidationResult(
                    "Please select a recruiter, or choose a different source.",
                    [nameof(SourceRecruiterId)]);
        }
    }

