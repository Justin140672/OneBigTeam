    <DialogButtons>
        <DialogButton Content="Make Offer" IsPrimary="true" OnClick="ConfirmOfferAsync" />
        <DialogButton Content="Cancel" OnClick="() => _showOfferDialog = false" />
    </DialogButtons>
</SfDialog>

<SfDialog Width="420px" IsModal="true" @bind-Visible="_showOfferResponseDialog" Header="Record Offer Response" CssClass="offer-response-dialog">
    <DialogTemplates>
        <Content>
            <EditForm EditContext="_offerResponseEditContext">
