    // Toolbar enablement comes from KanbanCardActionResolver (the same resolver as the Kanban card)
    // fed with the stage-specific interview state returned by the applications list API.
    private IEnumerable<object> GridToolbar
    {
        get
        {
            var action = ActionFor(_selectedRow);
            var active = _selectedRow is not null && IsActive(_selectedRow);

            var items = new List<object>
            {
                new ItemModel { Id = "app-review-cv", Text = "Review CV", PrefixIcon = "fa-solid fa-file-lines", Disabled = action != KanbanCardAction.ReviewCv, TooltipText = "Review the CV for the selected application" },
                new ItemModel { Id = "app-schedule", Text = "Schedule Interview", PrefixIcon = "fa-solid fa-calendar-plus", Disabled = !CanSchedule(_selectedRow), TooltipText = "Schedule an interview for the selected application" },
                new ItemModel { Id = "app-record-outcome", Text = "Record Outcome", PrefixIcon = "fa-solid fa-clipboard-check", Disabled = !CanRecordOutcome(_selectedRow), TooltipText = "Record the outcome of the pending interview" },
                new ItemModel { Id = "app-next-stage", Text = "Next Interview Stage", PrefixIcon = "fa-solid fa-forward", Disabled = action != KanbanCardAction.MoveToNextInterviewStage, TooltipText = "Move the candidate to the next interview stage" },
                new ItemModel { Id = "app-offer",     Text = "Offer",              PrefixIcon = "fa-solid fa-file-signature", Disabled = action != KanbanCardAction.MakeOffer, TooltipText = "Make an offer to the selected candidate" },
                new ItemModel { Id = "app-offer-response", Text = "Record Offer Response", PrefixIcon = "fa-solid fa-reply", Disabled = action != KanbanCardAction.RecordOfferResponse, TooltipText = "Record the candidate's response to the standing offer" },
                new ItemModel { Id = "app-hire",      Text = "Hire",               PrefixIcon = "fa-solid fa-user-check", Disabled = action != KanbanCardAction.Hire, TooltipText = "Hire the selected candidate" },
                new ItemModel { Id = "app-reject",    Text = "Reject",             PrefixIcon = "fa-solid fa-user-xmark", Disabled = !active, TooltipText = "Reject the selected candidate (cancels any pending interview)" },
                new ItemModel { Id = "app-withdraw",  Text = "Withdraw",           PrefixIcon = "fa-solid fa-arrow-rotate-left", Disabled = !active, TooltipText = "Withdraw the selected application" },
            };

            if (_canAppoint)
            {
                items.Insert(6, new ItemModel { Id = "app-appoint", Text = "Appoint", PrefixIcon = "fa-solid fa-user-tie", Disabled = action != KanbanCardAction.Appoint, TooltipText = "Complete internal appointment" });
            }

            return items;
        }
    }

    private bool CanHire(ApplicationListItemModel? row) => ActionFor(row) == KanbanCardAction.Hire;

    private bool CanAppoint(ApplicationListItemModel? row) => ActionFor(row) == KanbanCardAction.Appoint;

