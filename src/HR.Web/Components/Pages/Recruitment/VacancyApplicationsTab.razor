    private void SetAddMode(AddCandidateMode mode)
    {
        if (_adding || _addModel.Mode == mode)
            return;

        _addModel.Mode = mode;
        _dialogError = null;
        _duplicateCandidate = null;

        if (mode == AddCandidateMode.Existing)
            ClearNewCv();

        foreach (var field in new[] { nameof(AddApplicationFormModel.CandidateId), nameof(AddApplicationFormModel.FirstName),
                                      nameof(AddApplicationFormModel.LastName), nameof(AddApplicationFormModel.Email) })
        {
            _addEditContext.NotifyFieldChanged(new FieldIdentifier(_addModel, field));
        }
    }

    private void OnNewCvSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();

        string? error = null;
        if (!_allowedCvExtensions.Contains(extension) || !CandidateService.IsPdfContentType(file.ContentType))
            error = "The CV must be a PDF file.";
        else if (file.Size > CandidateService.MaxCandidateDocumentBytes)
            error = "The CV file is larger than the 20 MB limit.";
        else if (file.Size == 0)
            error = "The selected CV file is empty.";

        if (error is not null)
        {
            ClearNewCv();
            _newCvError = error;
            return;
        }

        _newCvFile = file;
        _newCvError = null;
    }

    private void RemoveNewCv() => ClearNewCv();

    private void ClearNewCv()
    {
        _newCvFile = null;
        _newCvError = null;
        _newCvInputKey++;
    }

    private static string FormatFileSize(long bytes) =>
        bytes < 1024 ? $"{bytes} B"
        : bytes < 1024 * 1024 ? $"{bytes / 1024.0:0.#} KB"
        : $"{bytes / (1024.0 * 1024.0):0.#} MB";

    private async Task SelectDuplicateCandidateAsync()
    {
        if (_adding || _duplicateCandidate is not { IsActive: true } duplicate)
            return;

        if (_candidates.All(c => c.Id != duplicate.CandidateId))
        {
            _candidates = _candidates
                .Prepend(new CandidateListItemModel(
                    duplicate.CandidateId, duplicate.FirstName, duplicate.LastName, duplicate.Email,
                    Phone: null, CreatedAt: default, IsActive: true))
                .ToList();
        }

        SetAddMode(AddCandidateMode.Existing);
        _addModel.CandidateId = duplicate.CandidateId;
        _addEditContext.NotifyFieldChanged(new FieldIdentifier(_addModel, nameof(AddApplicationFormModel.CandidateId)));
        await OnCandidateSelectedAsync();
    }

    private async Task ConfirmAddAsync()
    {
        if (_adding)
            return;

        if (!_addEditContext.Validate())
            return;

        var source = _addModel.Source == "Unspecified" ? null : _addModel.Source;
        var sourceExternalRecruiterId = _addModel.Source == "ExternalRecruiter" ? _addModel.SourceRecruiterId : null;

        _adding = true;
        _dialogError = null;
        var succeeded = false;
        try
        {
            if (_addModel.Mode == AddCandidateMode.Existing)
            {
                var cvDocumentId = _attachCurrentCv ? CurrentCvForSelection?.Id : null;
                var (created, error) = await ApplicationService.CreateApplicationAsync(
                    CompanyId, VacancyId, _addModel.CandidateId!.Value, _addModel.Notes,
                    source: source,
                    sourceExternalRecruiterId: sourceExternalRecruiterId,
                    cvDocumentId: cvDocumentId);

                if (created is null)
                    _dialogError = error ?? "Failed to create application.";
                else
                    succeeded = true;
            }
            else
            {
                _duplicateCandidate = null;
                var request = new CreateCandidateApplicationRequest(
                    FormText.Required(_addModel.FirstName!),
                    FormText.Required(_addModel.LastName!),
                    FormText.Required(_addModel.Email!),
                    FormText.Optional(_addModel.Phone),
                    FormText.Optional(_addModel.Notes),
                    source,
                    sourceExternalRecruiterId);

                var result = await ApplicationService.CreateCandidateApplicationAsync(CompanyId, VacancyId, request, _newCvFile);

                if (result.Duplicate is not null)
                    _duplicateCandidate = result.Duplicate;
                else if (result.Created is null)
                    _dialogError = result.Error ?? "Failed to add the candidate.";
                else
                    succeeded = true;
            }
        }
        finally
        {
            _adding = false;
        }

        if (!succeeded)
            return;

        _showAddDialog = false;
        _actionSuccess = "Candidate added to vacancy.";
        _actionError = null;
        await LoadAsync();
    }

