@using Syncfusion.Blazor.Data
@inject ApplicationService ApplicationService
@inject CandidateService CandidateService
@inject EmployeeService EmployeeService
@inject VacancyService VacancyService
@inject EmploymentTypeService EmploymentTypeService
@inject ExternalRecruiterService ExternalRecruiterService
@inject RecruitmentStageService RecruitmentStageService
@inject IJSRuntime JS

<div data-testid="vacancy-applications-tab">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Applications</h5>
        <SfButton IsPrimary="true" OnClick="OpenAddDialog" data-testid="add-application-btn">
            <i class="fa-solid fa-plus me-1"></i>Add Candidate
        </SfButton>
    </div>

    @if (!string.IsNullOrEmpty(_actionError))
    {
        <div class="alert alert-danger alert-dismissible">
            @_actionError
            <button type="button" class="btn-close" @onclick="() => _actionError = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(_actionSuccess))
    {
        <div class="alert alert-success">@_actionSuccess</div>
    }

    @if (_loading)
    {
        <HrLoadingIndicator />
    }
    else if (_applications.Count == 0)
    {
        <p class="text-muted">No applications yet for this vacancy.</p>
    }
    else
    {
        <HrGrid TValue="ApplicationListItemModel"
                DataSource="@_applications"
                AllowFiltering="false"
                AllowPaging="false">
            <GridColumns>
                <GridColumn HeaderText="Candidate" Width="200">
                    <Template>
                        @{
                            var row = (ApplicationListItemModel)context;
                            <a href="/companies/@CompanyId/candidates/@row.CandidateId">@row.CandidateFirstName @row.CandidateLastName</a>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(ApplicationListItemModel.CandidateEmail)" HeaderText="Email" Width="200" />
                <GridColumn HeaderText="Status" Width="140">
                    <Template>
                        @{
                            var row = (ApplicationListItemModel)context;
                        }
                        <StatusBadge Variant="@StatusVariant(row)">@StageName(row.CurrentStageId)</StatusBadge>
                        @if (row.IsWithdrawn)
                        {
                            <span class="text-muted ms-1">(Withdrawn)</span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(ApplicationListItemModel.AppliedAt)" HeaderText="Applied" Width="130" Format="d" />
                <GridColumn HeaderText="Source" Width="220">
                    <Template>
                        @{
                            var row = (ApplicationListItemModel)context;
                            _sourceDetails.TryGetValue(row.Id, out var detail);
                        }
                        @if (detail?.Source is null or "Unspecified")
                        {
                            <span class="text-muted">—</span>
                        }
                        else if (detail.Source == "ExternalRecruiter")
                        {
                            <span>Source: External Recruiter@(detail.SourceExternalRecruiterAgencyName is null ? "" : $" ({detail.SourceExternalRecruiterAgencyName})")</span>
                        }
                        else
                        {
                            <span>Source: @SourceLabel(detail.Source)</span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Actions" Width="260">
                    <Template>
                        @{
                            var row = (ApplicationListItemModel)context;
                        }
                        <div class="d-flex gap-1 flex-wrap">
                            @if (IsActive(row))
                            {
                                <SfButton CssClass="e-small" OnClick="() => OpenScheduleDialog(row)">Schedule Interview</SfButton>
                                <SfButton CssClass="e-small" IsPrimary="true" OnClick="() => OfferAsync(row)">Offer</SfButton>
                                <SfButton CssClass="e-small" IsPrimary="true" OnClick="() => OpenHireDialog(row)">Hire</SfButton>
                                <SfButton CssClass="e-small" OnClick="() => OpenRejectDialog(row)">Reject</SfButton>
                                <SfButton CssClass="e-small" OnClick="() => WithdrawAsync(row)">Withdraw</SfButton>
                            }
                        </div>
                    </Template>
                </GridColumn>
            </GridColumns>
        </HrGrid>
    }
</div>

<SfDialog Width="480px" IsModal="true" @bind-Visible="_showAddDialog" Header="Add Candidate" CssClass="add-application-dialog">
    <DialogTemplates>
        <Content>
            <div class="mb-3">
                <label class="form-label">Candidate</label>
                <SfDropDownList @ref="_candidateDropdown"
                                TValue="Guid?" TItem="CandidateListItemModel"
                                DataSource="@_candidates" @bind-Value="_selectedCandidateId"
                                Placeholder="Select a candidate" AllowFiltering="true">
                    <DropDownListFieldSettings Value="Id" Text="FullName" />
                    <DropDownListEvents TValue="Guid?" TItem="CandidateListItemModel" Filtering="OnCandidateFilteringAsync" />
                    <DropDownListTemplates TItem="CandidateListItemModel">
                        <ItemTemplate>
                            @{ var c = (CandidateListItemModel)context; }
                            <span><strong>@c.FirstName @c.LastName</strong> <span class="text-muted ms-1">@c.Email</span></span>
                        </ItemTemplate>
                    </DropDownListTemplates>
                </SfDropDownList>
            </div>
            <div class="mb-3">
                <label class="form-label">Source (optional)</label>
                <SfDropDownList TValue="string" TItem="SourceOption" DataSource="@_sourceOptions"
                                @bind-Value="_selectedSource" Placeholder="Select a source"
                                ValueChange="OnSourceChanged">
                    <DropDownListFieldSettings Value="Value" Text="Label" />
                </SfDropDownList>
            </div>
            @if (_selectedSource == "ExternalRecruiter")
            {
                <div class="mb-3">
                    <label class="form-label">Recruiter</label>
                    <SfDropDownList TValue="Guid?" TItem="ExternalRecruiterListItemModel"
                                    DataSource="@_activeRecruitersForSource" @bind-Value="_selectedSourceRecruiterId"
                                    Placeholder="Select a recruiter" AllowFiltering="true"
                                    ValueChange="OnSourceRecruiterChanged">
                        <DropDownListFieldSettings Value="Id" Text="AgencyName" />
                        <DropDownListTemplates TItem="ExternalRecruiterListItemModel">
                            <ItemTemplate>
                                @{ var r = (ExternalRecruiterListItemModel)context; }
                                <span>
                                    @r.AgencyName
                                    @if (_vacancyAssignedRecruiterId == r.Id)
                                    {
                                        <span class="text-muted ms-1">(assigned to this vacancy)</span>
                                    }
                                </span>
                            </ItemTemplate>
                        </DropDownListTemplates>
                    </SfDropDownList>
                    @if (_recruiterNotAssignedWarning)
                    {
                        <div class="form-text text-warning" data-testid="recruiter-not-assigned-warning">
                            <i class="fa-solid fa-triangle-exclamation me-1"></i>This recruiter isn't currently assigned to this vacancy.
                        </div>
                    }
                </div>
            }
            <div class="mb-3">
                <label class="form-label">Notes (optional)</label>
                <SfTextBox @bind-Value="_addNotes" Multiline="true" Rows="2" />
            </div>
            @if (_dialogError is not null)
            {
                <div class="alert alert-danger py-2">@_dialogError</div>
            }
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Add" IsPrimary="true" OnClick="ConfirmAddAsync" />
        <DialogButton Content="Cancel" OnClick="() => _showAddDialog = false" />
    </DialogButtons>
</SfDialog>

<SfDialog Width="480px" IsModal="true" @bind-Visible="_showScheduleDialog" Header="Schedule Interview" CssClass="schedule-interview-dialog">
    <DialogTemplates>
        <Content>
            <div class="mb-3">
                <label class="form-label">Interviewer</label>
                <SfDropDownList TValue="Guid?" TItem="EmployeeListItemModel"
                                DataSource="@_employees" @bind-Value="_interviewerId"
                                Placeholder="Select interviewer" AllowFiltering="true">
                    <DropDownListFieldSettings Value="Id" Text="FullName" />
                    <DropDownListTemplates TItem="EmployeeListItemModel">
                        <ItemTemplate>
                            @{ var e = (EmployeeListItemModel)context; }
                            <span>@e.FirstName @e.LastName</span>
                        </ItemTemplate>
                    </DropDownListTemplates>
                </SfDropDownList>
            </div>
            <div class="mb-3">
                <label class="form-label">Scheduled At</label>
                <SfDateTimePicker TValue="DateTime?" @bind-Value="_scheduledAt" Format="dd/MM/yyyy HH:mm" />
            </div>
            <div class="mb-3">
                <label class="form-label">Duration (minutes)</label>
                <SfNumericTextBox TValue="int?" @bind-Value="_durationMinutes" ShowSpinButton="false" />
            </div>
            <div class="mb-3">
                <label class="form-label">Location</label>
                <SfTextBox @bind-Value="_location" Placeholder="e.g. Remote" />
            </div>
            @if (_dialogError is not null)
            {
                <div class="alert alert-danger py-2">@_dialogError</div>
            }
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Schedule" IsPrimary="true" OnClick="ConfirmScheduleAsync" />
        <DialogButton Content="Cancel" OnClick="() => _showScheduleDialog = false" />
    </DialogButtons>
</SfDialog>

<SfDialog Width="420px" IsModal="true" @bind-Visible="_showRejectDialog" Header="Reject Candidate" CssClass="reject-candidate-dialog">
    <DialogTemplates>
        <Content>
            <div class="mb-3">
                <label class="form-label">Reason (optional)</label>
                <SfTextBox @bind-Value="_rejectionReason" Multiline="true" Rows="2" />
            </div>
            @if (_dialogError is not null)
            {
                <div class="alert alert-danger py-2">@_dialogError</div>
            }
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Reject" IsPrimary="true" OnClick="ConfirmRejectAsync" />
        <DialogButton Content="Cancel" OnClick="() => _showRejectDialog = false" />
    </DialogButtons>
</SfDialog>

<SfDialog Width="520px" IsModal="true" @bind-Visible="_showHireDialog" Header="Hire Candidate" CssClass="hire-candidate-dialog">
    <DialogTemplates>
        <Content>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Start Date <span class="text-danger">*</span></label>
                    <SfDatePicker TValue="DateOnly?" @bind-Value="_startDate" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Date of Birth <span class="text-danger">*</span></label>
                    <SfDatePicker TValue="DateOnly?" @bind-Value="_dateOfBirth" Format="dd/MM/yyyy" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Nationality <span class="text-danger">*</span></label>
                    <SfDropDownList TValue="string" TItem="NationalityListItem"
                                    DataSource="@_nationalities" @bind-Value="_nationality"
                                    Placeholder="Select nationality" AllowFiltering="true">
                        <DropDownListFieldSettings Value="Name" Text="Name" />
                    </SfDropDownList>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Gender <span class="text-danger">*</span></label>
                    <SfDropDownList TValue="string" TItem="string" DataSource="@_genderOptions" @bind-Value="_gender" Placeholder="Select gender" />
                    @if (_gender == "Other")
                    {
                        <div class="mt-2">
                            <SfTextBox @bind-Value="_genderOther" Placeholder="Please specify" />
                        </div>
                    }
                </div>
                <div class="col-md-6">
                    <label class="form-label">Employee Number <span class="text-danger">*</span></label>
                    <SfTextBox @bind-Value="_employeeNumber" Placeholder="e.g. EMP-001" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Employment Type <span class="text-danger">*</span></label>
                    <SfDropDownList TValue="Guid?"
                                    TItem="EmploymentTypeListItemModel"
                                    DataSource="@_employmentTypes"
                                    @bind-Value="_employmentTypeId"
                                    Placeholder="Select type">
                        <DropDownListFieldSettings Value="Id" Text="Name" />
                    </SfDropDownList>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Position Profile</label>
                    <div class="p-2 rounded border bg-light" data-testid="hire-derived-position-profile">@_derivedPositionProfileName</div>
                    <div class="form-text">Derived from the vacancy — the employee is assigned to this profile (and its department/location) automatically.</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Location</label>
                    <div class="p-2 rounded border bg-light" data-testid="hire-derived-location">@_derivedLocationName</div>
                    <div class="form-text">Derived from the vacancy's position profile.</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Manager</label>
                    <SfDropDownList @ref="_hireManagerDropdown"
                                    TValue="Guid?"
                                    TItem="ManagerOption"
                                    DataSource="@_hireManagerOptions"
                                    @bind-Value="_managerId"
                                    Placeholder="None"
                                    AllowFiltering="true">
                        <DropDownListFieldSettings Value="Id" Text="Name" />
                        <DropDownListEvents TValue="Guid?" TItem="ManagerOption" Filtering="OnHireManagerFilteringAsync" />
                    </SfDropDownList>
                </div>
            </div>
            @if (_dialogError is not null)
            {
                <div class="alert alert-danger py-2 mt-3">@_dialogError</div>
            }
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Hire" IsPrimary="true" OnClick="ConfirmHireAsync" />
        <DialogButton Content="Cancel" OnClick="() => _showHireDialog = false" />
    </DialogButtons>
</SfDialog>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid VacancyId { get; set; }

    private bool _loading = true;
    private List<ApplicationListItemModel> _applications = [];
    // Ticket #99: the company's own configured pipeline, used to resolve CurrentStageId -> display
    // name/IsTerminal/TerminalOutcome for the Status column and to drive action-button visibility.
    private List<RecruitmentStageListItem> _stages = [];
    private string? _actionError;
    private string? _actionSuccess;
    private string? _dialogError;

    private bool _showAddDialog;
    private SfDropDownList<Guid?, CandidateListItemModel> _candidateDropdown = default!;
    private List<CandidateListItemModel> _candidates = [];
    private Guid? _selectedCandidateId;
    private string? _addNotes;

    // Ticket #78 — application source. Options mirror Domain.ApplicationSource with display-friendly
    // labels; "Unspecified" is treated the same as "not selected" (Source sent as null either way).
    private sealed record SourceOption(string Value, string Label);
    private static readonly List<SourceOption> _sourceOptions =
    [
        new("Unspecified", "Unspecified"),
        new("Direct", "Direct"),
        new("Referral", "Referral"),
        new("ExternalRecruiter", "External Recruiter"),
        new("JobBoard", "Job Board"),
        new("CareersSite", "Careers Site"),
    ];
    private string _selectedSource = "Unspecified";
    private List<ExternalRecruiterListItemModel> _activeRecruitersForSource = [];
    // Ticket #81: the removed VacancyRecruiterAssignment table (many-to-many with history) is
    // replaced by this single optional field mirroring Vacancy.AssignedRecruiterId.
    private Guid? _vacancyAssignedRecruiterId;
    private Guid? _selectedSourceRecruiterId;
    private bool _recruiterNotAssignedWarning;

    // Per-application Source detail, looked up lazily since ListApplicationsForVacancy's own
    // response doesn't include Source (only GetApplication does) — see LoadAsync.
    private readonly Dictionary<Guid, GetApplicationResponse> _sourceDetails = [];

    private static string SourceLabel(string? source) =>
        _sourceOptions.FirstOrDefault(o => o.Value == source)?.Label ?? source ?? "Unspecified";

    private bool _showScheduleDialog;
    private List<EmployeeListItemModel> _employees = [];
    private ApplicationListItemModel? _activeApplication;
    private Guid? _interviewerId;
    private DateTime? _scheduledAt;
    private int? _durationMinutes;
    private string? _location;

    private bool _showRejectDialog;
    private string? _rejectionReason;

    private bool _showHireDialog;
    private List<NationalityListItem> _nationalities = [];
    private List<EmploymentTypeListItemModel> _employmentTypes = [];
    private DateOnly? _startDate;
    private DateOnly? _dateOfBirth;
    private string _nationality = string.Empty;
    private string _gender = string.Empty;
    private string? _genderOther;
    private string _employeeNumber = string.Empty;
    private Guid? _employmentTypeId;
    private Guid? _managerId;
    // Derived read-only display fields — populated from the Vacancy's linked Position Profile
    // (GetVacancyResponse) when the Hire dialog opens. The employee is always assigned to this
    // Position Profile (and its Department/Location) automatically by HireCandidateHandler; these are
    // shown to HR only for confirmation, they are not submitted as independent request fields.
    private string _derivedLocationName = string.Empty;
    private string _derivedPositionProfileName = string.Empty;
    private SfDropDownList<Guid?, ManagerOption> _hireManagerDropdown = default!;
    private List<ManagerOption> _hireManagerOptions = [];

    private static readonly string[] _genderOptions = ["Male", "Female", "Non-binary", "Prefer not to say", "Other"];

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;

        if (_stages.Count == 0)
        {
            var stagesResult = await RecruitmentStageService.ListStagesAsync(CompanyId);
            _stages = stagesResult?.Items.ToList() ?? [];
        }

        var result = await ApplicationService.ListApplicationsForVacancyAsync(CompanyId, VacancyId);
        _applications = result?.Items ?? [];

        // Source isn't in ListApplicationsForVacancy's response — fetch each application's detail
        // in parallel to populate the "Source" column. Application lists per vacancy are small, so
        // an N+1 here is an acceptable trade-off against extending the list endpoint's contract.
        _sourceDetails.Clear();
        var detailTasks = _applications.Select(a => ApplicationService.GetApplicationAsync(CompanyId, VacancyId, a.Id)).ToList();
        var details = await Task.WhenAll(detailTasks);
        foreach (var detail in details)
        {
            if (detail is not null) _sourceDetails[detail.Id] = detail;
        }

        _loading = false;
    }

    private string StageName(Guid stageId) =>
        _stages.FirstOrDefault(s => s.Id == stageId)?.Name ?? "Unknown";

    private RecruitmentStageListItem? Stage(Guid stageId) =>
        _stages.FirstOrDefault(s => s.Id == stageId);

    private StatusBadgeVariant StatusVariant(ApplicationListItemModel row)
    {
        if (row.IsWithdrawn) return StatusBadgeVariant.Secondary;

        var stage = Stage(row.CurrentStageId);
        return stage?.TerminalOutcome switch
        {
            RecruitmentStageTerminalOutcome.Hired => StatusBadgeVariant.Success,
            RecruitmentStageTerminalOutcome.Rejected => StatusBadgeVariant.Danger,
            _ => StatusBadgeVariant.Info,
        };
    }

    // Ticket #99 judgement call: since the pipeline is now fully data-driven (companies can freely
    // insert/reorder/rename stages), there is no reliable data-driven signal for "eligible for
    // Schedule Interview / Offer / Reject / Withdraw" beyond what the backend handlers themselves
    // enforce — OfferCandidateHandler/HireCandidateHandler/RejectCandidateHandler/WithdrawApplication
    // all only require the application to be non-withdrawn and not already on a terminal stage (see
    // each handler's remarks). So all these actions are surfaced together for any active
    // (non-withdrawn, non-terminal-stage) application; the backend remains the source of truth and
    // will reject anything that's actually invalid for the current stage.
    private bool IsActive(ApplicationListItemModel row) =>
        !row.IsWithdrawn && Stage(row.CurrentStageId) is { IsTerminal: false };

    private async Task OpenAddDialog()
    {
        _dialogError = null;
        _selectedCandidateId = null;
        _addNotes = null;
        _selectedSource = "Unspecified";
        _selectedSourceRecruiterId = null;
        _recruiterNotAssignedWarning = false;

        // ListCandidatesValidator caps PageSize at 100 (InclusiveBetween(1, 100)) — requesting
        // more than that fails FluentValidation validation, and CandidateService.ListCandidatesAsync
        // swallows that failure (catch (HttpRequestException) { return null; }), so this silently
        // returned zero candidates on every single open regardless of how many actually exist.
        var result = await CandidateService.ListCandidatesAsync(CompanyId, pageSize: 100);
        _candidates = result?.Items ?? [];

        // Only active recruiters are selectable, per ticket #78. This vacancy's currently-assigned
        // agency (Vacancy.AssignedRecruiterId, ticket #81 — replaces the removed
        // VacancyRecruiterAssignment table) is cross-referenced (not filtered to) so the full active
        // list stays selectable — see the ItemTemplate's "(assigned to this vacancy)" hint above.
        var activeRecruitersTask = ExternalRecruiterService.ListExternalRecruitersAsync(CompanyId, isActive: true, pageSize: 200);
        var vacancyTask = VacancyService.GetVacancyAsync(CompanyId, VacancyId);
        await Task.WhenAll(activeRecruitersTask, vacancyTask);

        _activeRecruitersForSource = (await activeRecruitersTask)?.Items.ToList() ?? [];
        _vacancyAssignedRecruiterId = (await vacancyTask)?.AssignedRecruiterId;

        _showAddDialog = true;
    }

    private void OnSourceChanged(ChangeEventArgs<string, SourceOption> args)
    {
        _selectedSource = args.Value;
        if (_selectedSource != "ExternalRecruiter")
        {
            _selectedSourceRecruiterId = null;
            _recruiterNotAssignedWarning = false;
        }
    }

    // Warns (does not block) when the chosen recruiter isn't this vacancy's currently-assigned agency
    // (Vacancy.AssignedRecruiterId) — per the ticket, this is advisory only.
    private void OnSourceRecruiterChanged(ChangeEventArgs<Guid?, ExternalRecruiterListItemModel> args)
    {
        _selectedSourceRecruiterId = args.Value;
        _recruiterNotAssignedWarning = args.Value is Guid id && id != _vacancyAssignedRecruiterId;
    }

    // Candidates are searched server-side as the user types rather than filtered against the
    // initial 100-row page above — otherwise a candidate outside that first page (e.g. sorted
    // later alphabetically once the table grows) could never be found no matter what's typed.
    private async Task OnCandidateFilteringAsync(Syncfusion.Blazor.DropDowns.FilteringEventArgs args)
    {
        args.PreventDefaultAction = true;
        var result = await CandidateService.ListCandidatesAsync(CompanyId, search: args.Text, pageSize: 50);
        _candidates = result?.Items ?? [];
        await _candidateDropdown.FilterAsync(_candidates, new Query());
    }

    private async Task ConfirmAddAsync()
    {
        if (_selectedCandidateId is null)
        {
            _dialogError = "Please select a candidate.";
            return;
        }

        if (_selectedSource == "ExternalRecruiter" && _selectedSourceRecruiterId is null)
        {
            _dialogError = "Please select a recruiter, or choose a different source.";
            return;
        }

        var (created, error) = await ApplicationService.CreateApplicationAsync(
            CompanyId, VacancyId, _selectedCandidateId.Value, _addNotes,
            source: _selectedSource == "Unspecified" ? null : _selectedSource,
            sourceExternalRecruiterId: _selectedSource == "ExternalRecruiter" ? _selectedSourceRecruiterId : null);
        if (created is null)
        {
            _dialogError = error;
            return;
        }

        _showAddDialog = false;
        _actionSuccess = "Candidate added to vacancy.";
        _actionError = null;
        await LoadAsync();
    }

    private async Task OpenScheduleDialog(ApplicationListItemModel row)
    {
        _dialogError = null;
        _activeApplication = row;
        _interviewerId = null;
        _scheduledAt = DateTime.Today.AddDays(3).AddHours(10);
        _durationMinutes = 30;
        _location = null;

        if (_employees.Count == 0)
        {
            var result = await EmployeeService.ListEmployeesAsync(CompanyId, pageSize: 200);
            _employees = result?.Items.ToList() ?? [];
        }

        _showScheduleDialog = true;
    }

    private async Task ConfirmScheduleAsync()
    {
        if (_activeApplication is null || _interviewerId is null || _scheduledAt is null)
        {
            _dialogError = "Please select an interviewer and a scheduled time.";
            return;
        }

        var (result, error) = await InterviewServiceScheduleAsync();

        if (result is null)
        {
            _dialogError = error;
            return;
        }

        _showScheduleDialog = false;
        _actionSuccess = "Interview scheduled.";
        _actionError = null;
        await LoadAsync();
    }

    [Inject] private InterviewService InterviewService { get; set; } = default!;

    private Task<(ScheduleInterviewResponse? Result, string? Error)> InterviewServiceScheduleAsync() =>
        InterviewService.ScheduleInterviewAsync(
            CompanyId, VacancyId, _activeApplication!.Id,
            new ScheduleInterviewRequest(
                CompanyId, VacancyId, _activeApplication.Id, _interviewerId!.Value,
                // _scheduledAt is Kind=Unspecified (bound straight from the picker), so
                // `new DateTimeOffset(_scheduledAt)` resolves its offset from the server's local
                // time zone — +01:00 for any date in BST. Postgres's timestamptz columns only
                // accept offset-zero DateTimeOffsets (Npgsql rejects anything else outright), so
                // normalize to UTC here. ToUniversalTime() keeps the same absolute instant — it
                // only changes the offset, not the wall-clock moment being saved.
                new DateTimeOffset(_scheduledAt!.Value).ToUniversalTime(), _durationMinutes,
                string.IsNullOrWhiteSpace(_location) ? null : _location.Trim()));

    private void OpenRejectDialog(ApplicationListItemModel row)
    {
        _dialogError = null;
        _activeApplication = row;
        _rejectionReason = null;
        _showRejectDialog = true;
    }

    private async Task ConfirmRejectAsync()
    {
        if (_activeApplication is null) return;

        var (result, error) = await ApplicationService.RejectCandidateAsync(CompanyId, VacancyId, _activeApplication.Id, _rejectionReason);
        if (result is null)
        {
            _dialogError = error;
            return;
        }

        _showRejectDialog = false;
        _actionSuccess = "Candidate rejected.";
        _actionError = null;
        await LoadAsync();
    }

    private async Task OfferAsync(ApplicationListItemModel row)
    {
        _actionError = null;
        var (result, error) = await ApplicationService.OfferCandidateAsync(CompanyId, VacancyId, row.Id);
        if (result is null)
        {
            _actionError = error;
            return;
        }

        _actionSuccess = "Offer made to candidate.";
        await LoadAsync();
    }

    private async Task WithdrawAsync(ApplicationListItemModel row)
    {
        _actionError = null;
        var (result, error) = await ApplicationService.WithdrawApplicationAsync(CompanyId, VacancyId, row.Id);
        if (result is null)
        {
            _actionError = error;
            return;
        }

        _actionSuccess = "Application withdrawn.";
        await LoadAsync();
    }

    private async Task OpenHireDialog(ApplicationListItemModel row)
    {
        _dialogError = null;
        _activeApplication = row;
        _startDate = DateOnly.FromDateTime(DateTime.Today);
        _dateOfBirth = null;
        _nationality = string.Empty;
        _gender = string.Empty;
        _genderOther = null;
        _employeeNumber = string.Empty;
        _employmentTypeId = null;
        _managerId = Guid.Empty;
        _derivedLocationName = string.Empty;
        _derivedPositionProfileName = string.Empty;

        if (_nationalities.Count == 0)
        {
            var result = await EmployeeService.ListNationalitiesAsync();
            _nationalities = result?.Items.ToList() ?? [];
        }

        var vacancyTask = VacancyService.GetVacancyAsync(CompanyId, VacancyId);
        var employmentTypeTask = EmploymentTypeService.ListEmploymentTypesAsync(CompanyId);
        var managerTask = EmployeeService.ListEmployeesAsync(CompanyId, pageSize: 50);

        await Task.WhenAll(vacancyTask, employmentTypeTask, managerTask);

        // Position Profile/Department/Location are no longer entered manually — they are derived
        // server-side by HireCandidateHandler from the Vacancy's own linked Position Profile. These
        // two fields are shown read-only here purely so HR can confirm what will be assigned.
        var vacancy = await vacancyTask;
        _derivedPositionProfileName = vacancy?.PositionProfileTitle ?? vacancy?.EffectiveTitle ?? "(unknown)";
        _derivedLocationName = vacancy?.EffectiveLocation ?? "(none set)";

        _employmentTypes = (await employmentTypeTask)?.Items ?? [];
        _hireManagerOptions = ((await managerTask)?.Items ?? [])
            .Where(e => e.Status != "Draft" && e.Status != "FormerEmployee")
            .Select(e => new ManagerOption(e.Id, $"{e.FirstName} {e.LastName}"))
            .OrderBy(e => e.Name)
            .Prepend(new ManagerOption(Guid.Empty, "No Manager"))
            .ToList();

        _showHireDialog = true;
    }

    // Same pattern as OnCandidateFilteringAsync above / EmployeeEmploymentTab.OnManagerFilteringAsync
    // — the manager list can't be preloaded in one bounded page, so search server-side as typed.
    private async Task OnHireManagerFilteringAsync(Syncfusion.Blazor.DropDowns.FilteringEventArgs args)
    {
        args.PreventDefaultAction = true;
        var result = await EmployeeService.ListEmployeesAsync(CompanyId, search: args.Text, pageSize: 50);
        _hireManagerOptions = (result?.Items ?? [])
            .Where(e => e.Status != "Draft" && e.Status != "FormerEmployee")
            .Select(e => new ManagerOption(e.Id, $"{e.FirstName} {e.LastName}"))
            .OrderBy(e => e.Name)
            .Prepend(new ManagerOption(Guid.Empty, "No Manager"))
            .ToList();
        await _hireManagerDropdown.FilterAsync(_hireManagerOptions, new Query());
    }

    private sealed record ManagerOption(Guid Id, string Name);

    private async Task ConfirmHireAsync()
    {
        if (_activeApplication is null || _startDate is null || _dateOfBirth is null ||
            string.IsNullOrWhiteSpace(_nationality) || string.IsNullOrWhiteSpace(_gender) ||
            string.IsNullOrWhiteSpace(_employeeNumber) || _employmentTypeId is null)
        {
            _dialogError = "Please complete all required fields.";
            return;
        }

        var request = new HireCandidateRequest(
            CompanyId, VacancyId, _activeApplication.Id,
            _startDate.Value, _dateOfBirth.Value, _nationality, _gender,
            string.IsNullOrWhiteSpace(_genderOther) ? null : _genderOther.Trim(),
            _employeeNumber.Trim(), _employmentTypeId.Value,
            _managerId == Guid.Empty ? null : _managerId);

        var (result, error) = await ApplicationService.HireCandidateAsync(CompanyId, VacancyId, _activeApplication.Id, request);

        if (result is null)
        {
            _dialogError = error;
            return;
        }

        _showHireDialog = false;
        _actionSuccess = $"Candidate hired as employee {result.EmployeeId}.";
        _actionError = null;
        await LoadAsync();
    }
}
