                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Offered Salary</label>
                        <SfNumericTextBox TValue="decimal?" @bind-Value="_offerModel.OfferedSalary" Format="c0" Min="0" ShowSpinButton="false" data-testid="offer-salary" />
                        <ValidationMessage For="@(() => _offerModel.OfferedSalary)" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Salary Frequency</label>
                        <SfDropDownList TValue="string" TItem="string" DataSource="@_salaryFrequencyOptions"
