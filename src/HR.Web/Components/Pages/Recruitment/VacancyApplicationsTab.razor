    private async Task OnRowSelected(RowSelectEventArgs<ApplicationListItemModel> args)
    {
        _selectedRow = args.Data;
        await RefreshToolbarStateAsync();
        _selectionMarker?.Set(_selectedRow?.Id);
    }

    private async Task OnRowDeselected(RowDeselectEventArgs<ApplicationListItemModel> args)
    {
        _selectedRow = null;
        await RefreshToolbarStateAsync();
        _selectionMarker?.Set(null);
    }

    private async Task RefreshToolbarStateAsync()
    {
        if (_grid is null) return;

        var action = ActionFor(_selectedRow);
        var active = _selectedRow is not null && IsActive(_selectedRow);

        await _grid.EnableToolbarItemsAsync(["app-review-cv"], action == KanbanCardAction.ReviewCv);
        await _grid.EnableToolbarItemsAsync(["app-schedule"], CanSchedule(_selectedRow));
        await _grid.EnableToolbarItemsAsync(["app-record-outcome"], CanRecordOutcome(_selectedRow));
        await _grid.EnableToolbarItemsAsync(["app-next-stage"], action == KanbanCardAction.MoveToNextInterviewStage);
        await _grid.EnableToolbarItemsAsync(["app-offer"], action == KanbanCardAction.MakeOffer);
        await _grid.EnableToolbarItemsAsync(["app-hire"], action == KanbanCardAction.Hire);
        if (_canAppoint) await _grid.EnableToolbarItemsAsync(["app-appoint"], action == KanbanCardAction.Appoint);
        await _grid.EnableToolbarItemsAsync(["app-reject"], active);
        await _grid.EnableToolbarItemsAsync(["app-withdraw"], active);
        await _grid.EnableToolbarItemsAsync(["app-offer-response"], action == KanbanCardAction.RecordOfferResponse);
    }

    private async Task OnToolbarClick(ClickEventArgs args)
    {
        if (_selectedRow is null) return;
        var row = _selectedRow;

        switch (args.Item.Id)
        {
            case "app-schedule":
                await OpenScheduleDialog(row);
                break;
            case "app-next-stage":
                await MoveToNextInterviewStageAsync(row);
                break;
            case "app-record-outcome":
                await OpenRecordOutcomeDialogAsync(row);
                break;
            case "app-review-cv":
                Navigation.NavigateTo($"/companies/{CompanyId}/vacancies/{VacancyId}/applications/{row.Id}/review-cv?returnUrl={Uri.EscapeDataString($"companies/{CompanyId}/vacancies/{VacancyId}")}");
                break;
            case "app-offer":
                await OpenOfferDialog(row);
                break;
            case "app-offer-response":
                OpenOfferResponseDialog(row);
                break;
            case "app-hire":
                if (CanHire(row)) await OpenHireDialog(row);
                break;
            case "app-appoint":
                if (CanAppoint(row)) await OpenAppointDialog(row);
                break;
            case "app-reject":
                OpenRejectDialog(row);
                break;
            case "app-withdraw":
                await WithdrawAsync(row);
                break;
        }
    }

