@using HR.SharedKernel
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Syncfusion.Blazor.Data
@using Syncfusion.Blazor.Navigations
@inject ApplicationService ApplicationService
@inject RecruitmentKanbanService KanbanService
@inject CandidateService CandidateService
@inject EmployeeService EmployeeService
@inject VacancyService VacancyService
@inject EmploymentTypeService EmploymentTypeService
@inject ExternalRecruiterService ExternalRecruiterService
@inject RecruitmentStageService RecruitmentStageService
@inject PositionProfileService PositionProfileService
@inject CompanyService CompanyService
@inject DepartmentService DepartmentService
@inject EmployeeDirectoryService EmployeeDirectoryService
@inject UserService UserService
@inject AppSession Session
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div data-testid="vacancy-applications-tab">
    <SelectedApplicationMarker @ref="_selectionMarker" />
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Applications</h5>
        <SfButton IsPrimary="true" Disabled="@Session.IsReadOnly" OnClick="OpenAddDialog" data-testid="add-application-btn">
            <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Add Candidate
        </SfButton>
    </div>

    @if (!string.IsNullOrEmpty(_actionError))
    {
        <div class="alert alert-danger alert-dismissible" role="alert">
            @_actionError
            <button type="button" class="btn-close" aria-label="Dismiss error" @onclick="() => _actionError = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(_actionSuccess))
    {
        <div class="alert alert-success" role="status">@_actionSuccess</div>
    }
    @if (_appointSuccess is not null)
    {
        @* Internal recruitment Ticket 7: an internal appointment updates the EXISTING employee record,
           so link to that profile rather than reporting a new employee id. *@
        <div class="alert alert-success alert-dismissible appoint-success" role="status" data-testid="appoint-success">
            <span>
                Internal appointment completed@(_appointSuccess.IsApplied ? "" : $" — the change takes effect on {FormatUkDate(_appointSuccess.EffectiveDate)}").
            </span>
            @* Only link to the full employee record when the user can open it (HR Administrator via
               employee:manage, or the appointee themself) — a Recruiter-only appointer would otherwise
               land on an access-denied page, so they see the employee's name instead. *@
            @if (_canViewEmployeeProfile || _appointSuccess.EmployeeId == Session.EmployeeId)
            {
                <a href="/companies/@CompanyId/employees/@_appointSuccess.EmployeeId" data-testid="appoint-employee-link">View employee profile</a>
            }
            else
            {
                <span class="fw-semibold" data-testid="appoint-employee-name">@_appointSuccess.EmployeeName</span>
            }
            <button type="button" class="btn-close" aria-label="Dismiss" @onclick="() => _appointSuccess = null"></button>
        </div>
    }

    @* Internal recruitment Ticket 6: server-side Internal/External filter. Explicit "All" item rather
       than a clear button. Rendered outside the loading/empty branches so it stays usable when a
       filter matches nothing. data-testid is on the wrapper so E2E can scope the combobox. *@
    <div class="application-type-filter" data-testid="application-type-filter">
        <label class="form-label mb-0" for="application-type-filter">Application type</label>
        <SfDropDownList TValue="ApplicationTypeFilter" TItem="ApplicationTypeFilterOption"
                        Width="180px"
                        DataSource="@_applicationTypeOptions"
                        Value="@_applicationType" ValueChanged="OnApplicationTypeChangedAsync"
                        HtmlAttributes="@_applicationTypeFilterAttributes">
            <DropDownListFieldSettings Value="Value" Text="Label" />
        </SfDropDownList>
        <SearchResultsAnnouncer Count="@_applications.Count" Noun="application" />
    </div>

    @if (_loading)
    {
        <HrLoadingIndicator />
    }
    else if (_applications.Count == 0)
    {
        <p class="text-muted" data-testid="applications-empty">
            @(_applicationType switch
            {
                ApplicationTypeFilter.Internal => "No internal applications for this vacancy.",
                ApplicationTypeFilter.External => "No external applications for this vacancy.",
                _ => "No applications yet for this vacancy.",
            })
        </p>
    }
    else
    {
        <HrGrid @ref="_grid"
                TValue="ApplicationListItemModel"
                DataSource="@_applications"
                Toolbar="@GridToolbar"
                AllowFiltering="false"
                AllowPaging="false">
            <GridEvents TValue="ApplicationListItemModel" OnToolbarClick="OnToolbarClick"
                        RowSelected="OnRowSelected" RowDeselected="OnRowDeselected"
                        RowDataBound="OnApplicationRowDataBound" />
            <GridColumns>
                <GridColumn HeaderText="Candidate" Width="200">
                    <Template>
                        @{
                            var row = (ApplicationListItemModel)context;
                        }
                        @* Internal recruitment Ticket 6: the Internal badge sits in the Candidate cell
                           (not a new column — E2E addresses later cells by index). *@
                        <span class="application-candidate-cell" data-testid="application-candidate-cell">
                            <a href="/companies/@CompanyId/candidates/@row.CandidateId"
                               data-testid="application-candidate-link">@row.CandidateFirstName @row.CandidateLastName</a>
                            <InternalApplicationBadge IsInternal="@row.IsInternal" />
                        </span>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(ApplicationListItemModel.CandidateEmail)" HeaderText="Email" Width="200" />
                <GridColumn HeaderText="Status" Width="220">
                    <Template>
                        @{
                            var row = (ApplicationListItemModel)context;
                        }
                        @* Stable hook for the STAGE badge: the Candidate cell can render an "Internal" badge before it,
                           so a row-level ".badge" first-match is not the stage. *@
                        <span data-testid="application-stage-badge"><StatusBadge Variant="@StatusVariant(row)">@StageName(row.CurrentStageId)</StatusBadge></span>
                        @if (row.IsWithdrawn)
                        {
                            <span class="text-muted ms-1">(Withdrawn)</span>
                        }
                        @if (row.OfferResponseStatus is not null)
                        {
                            <span class="ms-1" data-testid="offer-response-badge">
                                <StatusBadge Variant="@OfferResponseVariant(row.OfferResponseStatus)">Offer: @OfferResponseLabel(row.OfferResponseStatus)</StatusBadge>
                            </span>
                        }
                        @if (row.IsInternal && row.InternalAppointmentStatus == "Pending")
                        {
                            @* Internal recruitment Ticket 7: an earlier Appoint didn't finish; Appoint stays
                               enabled so a retry can complete it. *@
                            <span class="ms-1" data-testid="appointment-pending-hint">
                                <StatusBadge Variant="StatusBadgeVariant.Warning">Appointment in progress</StatusBadge>
                            </span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Interview Outcome" Width="150">
                    <Template>
                        @{
                            var row = (ApplicationListItemModel)context;
                            var stageOutcome = row.CurrentStageHasPendingInterview ? "Pending" : row.CurrentStageInterviewOutcome;
                        }
                        @if (stageOutcome is not null)
                        {
                            <StatusBadge Variant="@InterviewOutcomeVariant(stageOutcome)">@stageOutcome</StatusBadge>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(ApplicationListItemModel.AppliedAt)" HeaderText="Applied" Width="130" Format="d" />
                <GridColumn HeaderText="Source" Width="220">
                    <Template>
                        @{
                            var row = (ApplicationListItemModel)context;
                            _sourceDetails.TryGetValue(row.Id, out var detail);
                        }
                        @if (detail?.Source is null or "Unspecified")
                        {
                            <span class="text-muted">—</span>
                        }
                        else if (detail.Source == "ExternalRecruiter")
                        {
                            <span>External Recruiter@(detail.SourceExternalRecruiterAgencyName is null ? "" : $" ({detail.SourceExternalRecruiterAgencyName})")</span>
                        }
                        else
                        {
                            <span>@SourceLabel(detail.Source)</span>
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </HrGrid>
    }
</div>

<SfDialog Width="560px" IsModal="true" @bind-Visible="_showAddDialog" Header="Add Candidate" CssClass="add-application-dialog">
    <DialogTemplates>
        <Content>
            <EditForm EditContext="_addEditContext">
                <DataAnnotationsValidator />
                @* Internal recruitment Ticket 3: pick an existing candidate, or create a new one (and
                   their application) without leaving the vacancy. Deliberately NOT a ".mb-3" group —
                   E2E locates the Recruiter field via ".add-application-dialog .mb-3" + text filter. *@
                <div class="add-candidate-mode" role="group" aria-label="Candidate type">
                    <SfButton IsPrimary="@(_addModel.Mode == AddCandidateMode.Existing)"
                              aria-pressed="@(_addModel.Mode == AddCandidateMode.Existing ? "true" : "false")"
                              Disabled="_adding"
                              OnClick="() => SetAddMode(AddCandidateMode.Existing)"
                              data-testid="add-candidate-mode-existing">
                        <i class="fa-solid fa-user-check me-1" aria-hidden="true"></i>Select existing candidate
                    </SfButton>
                    <SfButton IsPrimary="@(_addModel.Mode == AddCandidateMode.New)"
                              aria-pressed="@(_addModel.Mode == AddCandidateMode.New ? "true" : "false")"
                              Disabled="_adding"
                              OnClick="() => SetAddMode(AddCandidateMode.New)"
                              data-testid="add-candidate-mode-new">
                        <i class="fa-solid fa-user-plus me-1" aria-hidden="true"></i>Create new candidate
                    </SfButton>
                </div>
                @if (_addModel.Mode == AddCandidateMode.Existing)
                {
                    <div class="mb-3" data-testid="add-application-candidate-field">
                        <label id="add-application-candidate-label" for="add-application-candidate" class="form-label">Candidate <span class="text-danger">*</span></label>
                        <SfDropDownList @ref="_candidateDropdown"
                                        TValue="Guid?" TItem="CandidateListItemModel"
                                        DataSource="@_candidates"
                                        @bind-Value="_addModel.CandidateId" @bind-Value:after="OnCandidateSelectedAsync"
                                        Placeholder="Select a candidate" AllowFiltering="true"
                                        HtmlAttributes="@Aria(_addEditContext, _addModel, "add-application-candidate", nameof(AddApplicationFormModel.CandidateId), "Candidate", required: true)">
                            <DropDownListFieldSettings Value="Id" Text="FullName" />
                            <DropDownListEvents TValue="Guid?" TItem="CandidateListItemModel" Filtering="OnCandidateFilteringAsync" />
                            <DropDownListTemplates TItem="CandidateListItemModel">
                                <ItemTemplate Context="ddItem">
                                    @{ var c = (CandidateListItemModel)ddItem; }
                                    <span>@c.FirstName @c.LastName</span>
                                </ItemTemplate>
                            </DropDownListTemplates>
                        </SfDropDownList>
                        <div id="add-application-candidate-error" role="alert">
                            <ValidationMessage For="@(() => _addModel.CandidateId)" />
                        </div>
                    </div>
                    @if (CurrentCvForSelection is { } currentCv)
                    {
                        <div class="mb-3" data-testid="attach-current-cv">
                            <HrCheckBoxField Id="attach-current-cv-input"
                                             Label="@($"Attach current CV ({currentCv.FileName})")"
                                             @bind-Checked="_attachCurrentCv"
                                             Disabled="_adding" />
                        </div>
                    }
                }
                else
                {
                    <div class="row g-3 mb-3" data-testid="new-candidate-fields">
                        <div class="col-md-6">
                            <HrTextField Label="First name" Required="true" Id="new-candidate-first-name"
                                         @bind-Value="_addModel.FirstName" Maxlength="100" Autocomplete="given-name"
                                         HtmlAttributes="@(new Dictionary<string, object> { ["data-testid"] = "new-candidate-first-name" })" />
                        </div>
                        <div class="col-md-6">
                            <HrTextField Label="Last name" Required="true" Id="new-candidate-last-name"
                                         @bind-Value="_addModel.LastName" Maxlength="100" Autocomplete="family-name"
                                         HtmlAttributes="@(new Dictionary<string, object> { ["data-testid"] = "new-candidate-last-name" })" />
                        </div>
                        <div class="col-md-6">
                            <HrTextField Label="Email" Required="true" Id="new-candidate-email" Type="InputType.Email"
                                         @bind-Value="_addModel.Email" Maxlength="256" Autocomplete="email"
                                         HtmlAttributes="@(new Dictionary<string, object> { ["data-testid"] = "new-candidate-email" })" />
                        </div>
                        <div class="col-md-6">
                            <HrTextField Label="Phone (optional)" Id="new-candidate-phone" Type="InputType.Tel"
                                         @bind-Value="_addModel.Phone" Maxlength="30" Autocomplete="tel"
                                         HtmlAttributes="@(new Dictionary<string, object> { ["data-testid"] = "new-candidate-phone" })" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="new-candidate-cv-input">CV file (PDF) <span class="text-muted">(optional)</span></label>
                            @* Kept rendered while a file is selected — Blazor Server streams the file from
                               this input element at submit time, so it must stay in the DOM. *@
                            <InputFile @key="_newCvInputKey" id="new-candidate-cv-input" class="form-control"
                                       OnChange="OnNewCvSelected" accept=".pdf,application/pdf" disabled="@_adding"
                                       aria-describedby="@NewCvDescribedBy" aria-invalid="@(_newCvError is not null ? "true" : null)"
                                       aria-busy="@(_adding && _newCvFile is not null ? "true" : null)"
                                       data-testid="new-candidate-cv-input" />
                            <div id="new-candidate-cv-help" class="form-text">PDF, up to 20 MB. Uploaded as the candidate's current CV and submitted with this application.</div>
                            <div class="visually-hidden" role="status" aria-live="polite" aria-atomic="true">@(_newCvFile is null ? "" : $"Selected CV: {_newCvFile.Name}, {FormatFileSize(_newCvFile.Size)}")</div>
                            @if (_newCvFile is not null)
                            {
                                <div class="add-candidate-cv-selected" data-testid="new-candidate-cv-selected">
                                    <i class="fa-solid fa-file-lines" aria-hidden="true"></i>
                                    <span data-testid="new-candidate-cv-file-name">@_newCvFile.Name</span>
                                    <span class="text-muted small">(@FormatFileSize(_newCvFile.Size))</span>
                                    <SfButton CssClass="e-flat e-small" Disabled="_adding" OnClick="RemoveNewCv"
                                              aria-label="@($"Remove selected CV {_newCvFile.Name}")"
                                              data-testid="new-candidate-cv-remove">
                                        <i class="fa-solid fa-xmark me-1" aria-hidden="true"></i>Remove
                                    </SfButton>
                                </div>
                                @if (_adding)
                                {
                                    <div class="small text-muted" role="status" data-testid="new-candidate-cv-busy">Uploading CV...</div>
                                }
                            }
                            @if (_newCvError is not null)
                            {
                                <div id="new-candidate-cv-error" class="text-danger small mt-1" role="alert" data-testid="new-candidate-cv-error">@_newCvError</div>
                            }
                        </div>
                    </div>
                }
                <div class="mb-3" data-testid="add-application-source-field">
                    <label id="add-application-source-label" for="add-application-source" class="form-label">Source (optional)</label>
                    <SfDropDownList TValue="string" TItem="SourceOption" DataSource="@_sourceOptions"
                                    @bind-Value="_addModel.Source" Placeholder="Select a source"
                                    ValueChange="OnSourceChanged"
                                    HtmlAttributes="@Aria(_addEditContext, _addModel, "add-application-source", nameof(AddApplicationFormModel.Source), "Source")">
                        <DropDownListFieldSettings Value="Value" Text="Label" />
                    </SfDropDownList>
                </div>
                @if (_addModel.Source == "ExternalRecruiter")
                {
                    <div class="mb-3" data-testid="add-application-recruiter-field">
                        <label id="add-application-recruiter-label" for="add-application-recruiter" class="form-label">Recruiter <span class="text-danger">*</span></label>
                        <SfDropDownList TValue="Guid?" TItem="ExternalRecruiterListItemModel"
                                        DataSource="@_activeRecruitersForSource" @bind-Value="_addModel.SourceRecruiterId"
                                        Placeholder="Select a recruiter" AllowFiltering="true"
                                        HtmlAttributes="@Aria(_addEditContext, _addModel, "add-application-recruiter", nameof(AddApplicationFormModel.SourceRecruiterId), "Recruiter", required: true, help: _recruiterNotAssignedWarning ? "add-application-recruiter-help" : null)">
                            <DropDownListFieldSettings Value="Id" Text="AgencyName" />
                            <DropDownListTemplates TItem="ExternalRecruiterListItemModel">
                                <ItemTemplate Context="ddItem">
                                    @{ var r = (ExternalRecruiterListItemModel)ddItem; }
                                    <span>
                                        @r.AgencyName
                                        @if (_vacancyAssignedRecruiterId == r.Id)
                                        {
                                            <span class="text-muted ms-1">(assigned to this vacancy)</span>
                                        }
                                    </span>
                                </ItemTemplate>
                            </DropDownListTemplates>
                        </SfDropDownList>
                        <div id="add-application-recruiter-error" role="alert">
                            <ValidationMessage For="@(() => _addModel.SourceRecruiterId)" />
                        </div>
                        @if (_recruiterNotAssignedWarning)
                        {
                            <div id="add-application-recruiter-help" class="form-text text-warning-emphasis" data-testid="recruiter-not-assigned-warning">
                                <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>This recruiter isn't currently assigned to this vacancy.
                            </div>
                        }
                    </div>
                }
                <div class="mb-3">
                    <HrTextField Label="Notes (optional)" Id="add-application-notes"
                                 @bind-Value="_addModel.Notes" Multiline="true" Rows="2" />
                </div>
                @if (_duplicateCandidate is { } duplicate)
                {
                    <div class="alert alert-warning py-2" role="alert" data-testid="duplicate-candidate-alert">
                        <div>
                            A candidate with this email already exists:
                            <strong data-testid="duplicate-candidate-name">@duplicate.FullName</strong>
                            (<span data-testid="duplicate-candidate-email">@duplicate.Email</span>).
                        </div>
                        @if (duplicate.IsActive)
                        {
                            <div class="mt-2">
                                <SfButton IsPrimary="true" CssClass="e-small" Disabled="_adding"
                                          OnClick="SelectDuplicateCandidateAsync"
                                          data-testid="select-existing-candidate-btn">
                                    Select existing candidate
                                </SfButton>
                            </div>
                        }
                        else
                        {
                            <div class="mt-1" data-testid="duplicate-candidate-inactive">
                                This candidate is inactive and must be reactivated before they can be added to a vacancy.
                                <a href="/companies/@CompanyId/candidates/@duplicate.CandidateId" target="_blank" rel="noopener"
                                   data-testid="duplicate-candidate-details-link">View candidate details</a>
                            </div>
                        }
                    </div>
                }
                @if (_dialogError is not null)
                {
                    <div class="alert alert-danger py-2" role="alert" data-testid="add-application-error">@_dialogError</div>
                }
            </EditForm>
        </Content>
        <FooterTemplate>
            @* Disabled while a request is in flight so a double click can't submit twice (a second
               new-candidate submit would otherwise trip the duplicate-email protection). *@
            <SfButton IsPrimary="true" Disabled="@(_adding || Session.IsReadOnly)" OnClick="ConfirmAddAsync" data-testid="add-application-submit">
                @if (_adding)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                Add
            </SfButton>
            <SfButton Disabled="_adding" OnClick="() => _showAddDialog = false" data-testid="add-application-cancel">Cancel</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<ScheduleInterviewDialog @ref="_scheduleDialog" CompanyId="CompanyId" VacancyId="VacancyId" OnScheduled="OnInterviewScheduledAsync" />
<RecordInterviewOutcomeDialog @ref="_recordOutcomeDialog" CompanyId="CompanyId" VacancyId="VacancyId" OnRecorded="OnOutcomeRecordedAsync" />

<SfDialog Width="420px" IsModal="true" @bind-Visible="_showRejectDialog" Header="Reject Candidate" CssClass="reject-candidate-dialog">
    <DialogTemplates>
        <Content>
            <div class="mb-3">
                <HrTextField Label="Reason (optional)" Id="reject-reason"
                             Value="_rejectionReason" ValueChanged="@(v => _rejectionReason = v)" Multiline="true" Rows="2" />
            </div>
            @if (_dialogError is not null)
            {
                <div class="alert alert-danger py-2" role="alert">@_dialogError</div>
            }
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Reject" IsPrimary="true" OnClick="ConfirmRejectAsync" />
        <DialogButton Content="Cancel" OnClick="() => _showRejectDialog = false" />
    </DialogButtons>
</SfDialog>

<HireCandidateDialog @ref="_hireDialog" CompanyId="CompanyId" VacancyId="VacancyId" OnHired="OnHiredAsync" />

<AppointInternalCandidateDialog @ref="_appointDialog" CompanyId="CompanyId" VacancyId="VacancyId" OnAppointed="OnAppointedAsync" />

<OfferCandidateDialog @ref="_offerDialog" CompanyId="CompanyId" VacancyId="VacancyId" OnOffered="OnOfferedAsync" />

<RecordOfferResponseDialog @ref="_offerResponseDialog" CompanyId="CompanyId" VacancyId="VacancyId" OnRecorded="OnOfferResponseRecordedAsync" />

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid VacancyId { get; set; }

    private bool _loading = true;
    private List<ApplicationListItemModel> _applications = [];
    private HrGrid<ApplicationListItemModel>? _grid;
    private ApplicationListItemModel? _selectedRow;
    private List<RecruitmentStageListItem> _stages = [];
    private string? _actionError;
    private string? _actionSuccess;
    private string? _dialogError;

    private static readonly Dictionary<string, object> _applicationTypeFilterAttributes = new()
    {
        ["id"] = "application-type-filter",
        ["aria-label"] = "Application type",
    };

    private static Dictionary<string, object> Aria(
        EditContext context, object model, string id, string property, string label,
        bool required = false, string? help = null, string? testId = null)
    {
        var attributes = FieldAria.Build(context, model, id, property, required);
        attributes["aria-label"] = label;
        attributes["aria-labelledby"] = $"{id}-label";

        var describedBy = new List<string>(2);
        if (help is not null) describedBy.Add(help);
        if (attributes.TryGetValue("aria-describedby", out var existing)) describedBy.Add((string)existing);
        if (describedBy.Count > 0) attributes["aria-describedby"] = string.Join(' ', describedBy);

        if (testId is not null) attributes["data-testid"] = testId;
        return attributes;
    }

    private string NewCvDescribedBy => _newCvError is null ? "new-candidate-cv-help" : "new-candidate-cv-help new-candidate-cv-error";

    private bool _showAddDialog;
    private SfDropDownList<Guid?, CandidateListItemModel> _candidateDropdown = default!;
    private List<CandidateListItemModel> _candidates = [];
    private readonly AddApplicationFormModel _addModel = new();
    private EditContext _addEditContext = default!;
    private int _candidateFilterRequestId;

    private bool _adding;

    private CandidateDocumentListItemModel? _currentCv;
    private Guid? _currentCvCandidateId;
    private bool _attachCurrentCv = true;
    private int _cvLookupRequestId;

    private CandidateDocumentListItemModel? CurrentCvForSelection =>
        _currentCv is not null && _currentCvCandidateId is not null && _currentCvCandidateId == _addModel.CandidateId
            ? _currentCv
            : null;

    private IBrowserFile? _newCvFile;
    private string? _newCvError;
    private int _newCvInputKey;
    private static readonly string[] _allowedCvExtensions = [".pdf"];

    private DuplicateCandidateModel? _duplicateCandidate;

    private sealed record SourceOption(string Value, string Label);
    private static readonly List<SourceOption> _sourceOptions =
    [
        new("Unspecified", "Unspecified"),
        new("Direct", "Direct"),
        new("Referral", "Referral"),
        new("ExternalRecruiter", "External Recruiter"),
        new("JobBoard", "Job Board"),
        new("CareersSite", "Careers Site"),
    ];
    private List<ExternalRecruiterListItemModel> _activeRecruitersForSource = [];
    private Guid? _vacancyAssignedRecruiterId;

    private bool _recruiterNotAssignedWarning =>
        _addModel.Source == "ExternalRecruiter" &&
        _addModel.SourceRecruiterId is Guid id &&
        id != _vacancyAssignedRecruiterId;

    private readonly Dictionary<Guid, GetApplicationResponse> _sourceDetails = [];

    private static string SourceLabel(string? source) =>
        _sourceOptions.FirstOrDefault(o => o.Value == source)?.Label ?? source ?? "Unspecified";

    private ScheduleInterviewDialog? _scheduleDialog;
    private RecordInterviewOutcomeDialog? _recordOutcomeDialog;
    private List<EmployeeListItemModel> _employees = [];
    private ApplicationListItemModel? _activeApplication;

    protected override void OnInitialized()
    {
        _addEditContext = new EditContext(_addModel);
    }

    private OfferCandidateDialog? _offerDialog;




    private static StatusBadgeVariant OfferResponseVariant(string? status) => status switch
    {
        "Accepted" => StatusBadgeVariant.Success,
        "Declined" or "Withdrawn" => StatusBadgeVariant.Danger,
        "AwaitingResponse" => StatusBadgeVariant.Warning,
        _ => StatusBadgeVariant.Secondary,
    };

    private static string OfferResponseLabel(string? status) => status switch
    {
        "AwaitingResponse" => "Awaiting response",
        _ => status ?? "—",
    };

    private async Task OpenOfferDialog(ApplicationListItemModel row)
    {
        if (_offerDialog is not null) await _offerDialog.OpenAsync(row.Id);
    }

    private async Task OnOfferedAsync()
    {
        _actionSuccess = "Offer made to candidate.";
        _actionError = null;
        await LoadAsync();
    }

