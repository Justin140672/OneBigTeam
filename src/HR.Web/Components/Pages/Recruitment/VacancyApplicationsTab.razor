    private async Task OnCandidateSelectedAsync()
    {
        var requestId = ++_cvLookupRequestId;
        _currentCv = null;
        _currentCvCandidateId = null;
        _attachCurrentCv = true;

        if (_addModel.CandidateId is not Guid candidateId)
            return;

        var documents = await CandidateService.ListCandidateDocumentsAsync(CompanyId, candidateId);
        if (requestId != _cvLookupRequestId || _addModel.CandidateId != candidateId)
            return;

        _currentCv = documents?.Items.FirstOrDefault(d => d.IsCurrentCv);
        _currentCvCandidateId = _currentCv is null ? null : candidateId;
