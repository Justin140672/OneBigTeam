    public sealed class AddApplicationFormModel : IValidatableObject
    {
        public AddCandidateMode Mode { get; set; } = AddCandidateMode.Existing;

        public Guid? CandidateId { get; set; }

        // New mode (internal recruitment Ticket 3).
        [MaxLength(100, ErrorMessage = "First name cannot exceed 100 characters.")]
        public string? FirstName { get; set; }

        [MaxLength(100, ErrorMessage = "Last name cannot exceed 100 characters.")]
        public string? LastName { get; set; }

        [MaxLength(256, ErrorMessage = "Email cannot exceed 256 characters.")]
        public string? Email { get; set; }

        [MaxLength(30, ErrorMessage = "Phone cannot exceed 30 characters.")]
        public string? Phone { get; set; }

        [MaxLength(500, ErrorMessage = "Resume URL cannot exceed 500 characters.")]

        public string Source { get; set; } = "Unspecified";

        public Guid? SourceRecruiterId { get; set; }

        [MaxLength(2000)]
        public string? Notes { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (Mode == AddCandidateMode.Existing)
            {
                if (CandidateId is null)
                    yield return new ValidationResult("Please select a candidate.", [nameof(CandidateId)]);
            }
            else
            {
                if (string.IsNullOrWhiteSpace(FirstName))
                    yield return new ValidationResult("First name is required.", [nameof(FirstName)]);

                if (string.IsNullOrWhiteSpace(LastName))
                    yield return new ValidationResult("Last name is required.", [nameof(LastName)]);

                if (string.IsNullOrWhiteSpace(Email))
                    yield return new ValidationResult("Email is required.", [nameof(Email)]);
                else if (!new EmailAddressAttribute().IsValid(Email.Trim()))
                    yield return new ValidationResult("Enter a valid email address.", [nameof(Email)]);
            }

            if (Source == "ExternalRecruiter" && SourceRecruiterId is null)
                yield return new ValidationResult(
                    "Please select a recruiter, or choose a different source.",
                    [nameof(SourceRecruiterId)]);
        }
    }

