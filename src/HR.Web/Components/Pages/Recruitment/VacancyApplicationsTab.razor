        public string? CompensationNotes { get; set; }

        public bool IsBackdated => EffectiveDate is { } d && d < DateOnly.FromDateTime(DateTime.Today);
        public bool IsFutureDated => EffectiveDate is { } d && d > DateOnly.FromDateTime(DateTime.Today);

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (IsBackdated && !ConfirmBackdated)
                yield return new ValidationResult(
                    "The effective date is in the past — confirm the backdated appointment to continue.",
                    [nameof(ConfirmBackdated)]);

            if (!ChangeCompensation)
                yield break;

            if (SalaryType is not ("Annual" or "Hourly" or "Daily"))
                yield return new ValidationResult("Please select a salary type.", [nameof(SalaryType)]);

            if (Salary is null or <= 0)
                yield return new ValidationResult("Please enter a salary greater than zero.", [nameof(Salary)]);

            if (string.IsNullOrWhiteSpace(Currency) || Currency.Trim().Length != 3)
                yield return new ValidationResult("Please enter a 3-letter currency code, e.g. GBP.", [nameof(Currency)]);

            if (HoursPerWeek is <= 0)
                yield return new ValidationResult("Hours per week must be greater than zero.", [nameof(HoursPerWeek)]);

            if (Fte is < 0 or > 1)
                yield return new ValidationResult("FTE must be between 0 and 1.", [nameof(Fte)]);
        }
    }

