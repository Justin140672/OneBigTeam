    private async Task OpenHireDialog(ApplicationListItemModel row)
    {
        _dialogError = null;
        _activeApplication = row;
        _startDate = DateOnly.FromDateTime(DateTime.Today);
        _dateOfBirth = null;
        _nationality = string.Empty;
        _gender = string.Empty;
        _genderOther = null;
        _employeeNumber = string.Empty;
        _employmentTypeId = null;
        _managerId = Guid.Empty;
        _derivedLocationName = string.Empty;
        _derivedPositionProfileName = string.Empty;
        _addressLine1 = null;
        _addressLine2 = null;
        _city = null;
        _county = null;
        _postCode = null;

        if (_nationalities.Count == 0)
        {
            var result = await EmployeeService.ListNationalitiesAsync();
            _nationalities = result?.Items.ToList() ?? [];
        }

        // Same rule as Employee Edit (see EmployeeEdit.razor): when the company's Employee Number
        // Mode is Automatic, the field isn't shown at all — a number is generated when the
        // employee is created (here: hired), so there's nothing for the recruiter to enter.
        var hrSettings = await CompanyService.GetHrSettingsAsync(CompanyId);
        _hireEmployeeNumberMode = hrSettings?.EmployeeNumberMode ?? EmployeeNumberMode.Manual;

        var vacancyTask = VacancyService.GetVacancyAsync(CompanyId, VacancyId);
        var employmentTypeTask = EmploymentTypeService.ListEmploymentTypesAsync(CompanyId);
        var managerTask = EmployeeService.ListEmployeesAsync(CompanyId, pageSize: 50);

        await Task.WhenAll(vacancyTask, employmentTypeTask, managerTask);

        // Position Profile/Department/Location are no longer entered manually — they are derived
        // server-side by HireCandidateHandler from the Vacancy's own linked Position Profile. These
        // two fields are shown read-only here purely so HR can confirm what will be assigned.
        var vacancy = await vacancyTask;
        _derivedPositionProfileName = vacancy?.PositionProfileTitle ?? vacancy?.EffectiveTitle ?? "(unknown)";
        _derivedLocationName = vacancy?.EffectiveLocation ?? "(none set)";

        _employmentTypes = (await employmentTypeTask)?.Items ?? [];
        _hireManagerOptions = ((await managerTask)?.Items ?? [])
            .Where(e => e.Status != "Draft" && e.Status != "FormerEmployee")
            .Select(e => new ManagerOption(e.Id, $"{e.FirstName} {e.LastName}"))
            .OrderBy(e => e.Name)
            .Prepend(new ManagerOption(Guid.Empty, "No Manager"))
            .ToList();

        _showHireDialog = true;
    }

    // Row-level actions (Schedule Interview/Offer/Hire/Reject/Withdraw) moved into the grid toolbar
    // rather than a dedicated Actions column, matching the toolbar pattern used elsewhere in the app
    // (see SearchPageBase's selection-dependent toolbar buttons). Enabled state tracks the current
    // row selection and that row's eligibility (IsActive/HasPendingInterview), same rules as before.
    private IEnumerable<object> GridToolbar
    {
        get
        {
            var active = _selectedRow is not null && IsActive(_selectedRow);
            var pendingInterview = _selectedRow is not null && HasPendingInterview(_selectedRow);
            var onOfferStage = _selectedRow is not null && IsOnOfferStage(_selectedRow);
            var enabled = active && !pendingInterview;

            // An offer's already been made once on the Offer stage — Schedule Interview/Offer/
            // Reject stop making sense there (Hire and Withdraw remain valid).
            var enabledPreOffer = enabled && !onOfferStage;

            return new List<object>
            {
                new ItemModel { Id = "app-schedule", Text = "Schedule Interview", PrefixIcon = "fa-solid fa-calendar-plus", Disabled = !enabledPreOffer, TooltipText = "Schedule an interview for the selected application" },
                new ItemModel { Id = "app-offer",     Text = "Offer",              PrefixIcon = "fa-solid fa-file-signature", Disabled = !enabledPreOffer, TooltipText = "Make an offer to the selected candidate" },
                new ItemModel { Id = "app-hire",      Text = "Hire",               PrefixIcon = "fa-solid fa-user-check", Disabled = !enabled, TooltipText = "Hire the selected candidate" },
                new ItemModel { Id = "app-reject",    Text = "Reject",             PrefixIcon = "fa-solid fa-user-xmark", Disabled = !enabledPreOffer, TooltipText = "Reject the selected candidate" },
                new ItemModel { Id = "app-withdraw",  Text = "Withdraw",           PrefixIcon = "fa-solid fa-arrow-rotate-left", Disabled = _selectedRow is null, TooltipText = "Withdraw the selected application" },
            };
        }
    }

    private async Task OnRowSelected(RowSelectEventArgs<ApplicationListItemModel> args)
    {
        _selectedRow = args.Data;
        await RefreshToolbarStateAsync();
    }

    private async Task OnRowDeselected(RowDeselectEventArgs<ApplicationListItemModel> args)
    {
        _selectedRow = null;
        await RefreshToolbarStateAsync();
    }

    // Same rationale as SearchPageBase.OnRowSelected/OnRowDeselected: re-assigning the Toolbar
    // parameter only sets the *initial* Disabled state, so selection changes after first render
    // need this explicit interop call per button to actually update the DOM.
    private async Task RefreshToolbarStateAsync()
    {
        if (_grid is null) return;

        var active = _selectedRow is not null && IsActive(_selectedRow);
        var pendingInterview = _selectedRow is not null && HasPendingInterview(_selectedRow);
        var onOfferStage = _selectedRow is not null && IsOnOfferStage(_selectedRow);
        var enabled = active && !pendingInterview;
        var enabledPreOffer = enabled && !onOfferStage;

        await _grid.EnableToolbarItemsAsync(["app-schedule", "app-offer", "app-reject"], enabledPreOffer);
        await _grid.EnableToolbarItemsAsync(["app-hire"], enabled);
        await _grid.EnableToolbarItemsAsync(["app-withdraw"], _selectedRow is not null);
    }

    private async Task OnToolbarClick(ClickEventArgs args)
    {
        if (_selectedRow is null) return;
        var row = _selectedRow;

        switch (args.Item.Id)
        {
            case "app-schedule":
                await OpenScheduleDialog(row);
                break;
            case "app-offer":
                await OfferAsync(row);
                break;
            case "app-hire":
                await OpenHireDialog(row);
                break;
            case "app-reject":
                OpenRejectDialog(row);
                break;
            case "app-withdraw":
                await WithdrawAsync(row);
                break;
        }
    }

    // Same pattern as OnCandidateFilteringAsync above / EmployeeEmploymentTab.OnManagerFilteringAsync
    // — the manager list can't be preloaded in one bounded page, so search server-side as typed.
    private async Task OnHireManagerFilteringAsync(Syncfusion.Blazor.DropDowns.FilteringEventArgs args)
    {
        args.PreventDefaultAction = true;
        var result = await EmployeeService.ListEmployeesAsync(CompanyId, search: args.Text, pageSize: 50);
        _hireManagerOptions = (result?.Items ?? [])
            .Where(e => e.Status != "Draft" && e.Status != "FormerEmployee")
            .Select(e => new ManagerOption(e.Id, $"{e.FirstName} {e.LastName}"))
            .OrderBy(e => e.Name)
            .Prepend(new ManagerOption(Guid.Empty, "No Manager"))
            .ToList();
        await _hireManagerDropdown.FilterAsync(_hireManagerOptions, new Query());
    }

    private sealed record ManagerOption(Guid Id, string Name);

    private async Task ConfirmHireAsync()
    {
        var employeeNumberRequired = _hireEmployeeNumberMode != EmployeeNumberMode.Automatic;

        if (_activeApplication is null || _startDate is null || _dateOfBirth is null ||
            string.IsNullOrWhiteSpace(_nationality) || string.IsNullOrWhiteSpace(_gender) ||
            (employeeNumberRequired && string.IsNullOrWhiteSpace(_employeeNumber)) || _employmentTypeId is null)
        {
            _dialogError = "Please complete all required fields.";
            return;
        }

        var request = new HireCandidateRequest(
            CompanyId, VacancyId, _activeApplication.Id,
            _startDate.Value, _dateOfBirth.Value, _nationality, _gender,
            string.IsNullOrWhiteSpace(_genderOther) ? null : _genderOther.Trim(),
            employeeNumberRequired ? _employeeNumber.Trim() : string.Empty, _employmentTypeId.Value,
            _managerId == Guid.Empty ? null : _managerId,
            // Not yet consumed server-side — see HireCandidateRequest's remarks above.
            string.IsNullOrWhiteSpace(_addressLine1) ? null : _addressLine1.Trim(),
            string.IsNullOrWhiteSpace(_addressLine2) ? null : _addressLine2.Trim(),
            string.IsNullOrWhiteSpace(_city) ? null : _city.Trim(),
            string.IsNullOrWhiteSpace(_county) ? null : _county.Trim(),
            string.IsNullOrWhiteSpace(_postCode) ? null : _postCode.Trim());

        var (result, error) = await ApplicationService.HireCandidateAsync(CompanyId, VacancyId, _activeApplication.Id, request);

        if (result is null)
        {
            _dialogError = error;
            return;
        }

        _showHireDialog = false;
        _actionSuccess = $"Candidate hired as employee {result.EmployeeId}.";
        _actionError = null;
        await LoadAsync();
    }
}
