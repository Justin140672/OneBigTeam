@using HR.SharedKernel
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Syncfusion.Blazor.Data
@using Syncfusion.Blazor.Navigations
@inject ApplicationService ApplicationService
@inject CandidateService CandidateService
@inject EmployeeService EmployeeService
@inject VacancyService VacancyService
@inject EmploymentTypeService EmploymentTypeService
@inject ExternalRecruiterService ExternalRecruiterService
@inject RecruitmentStageService RecruitmentStageService
@inject PositionProfileService PositionProfileService
@inject CompanyService CompanyService
@inject DepartmentService DepartmentService
@inject EmployeeDirectoryService EmployeeDirectoryService
@inject UserService UserService
@inject AppSession Session
@inject IJSRuntime JS

<div data-testid="vacancy-applications-tab">
    <SelectedApplicationMarker @ref="_selectionMarker" />
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Applications</h5>
        <SfButton IsPrimary="true" OnClick="OpenAddDialog" data-testid="add-application-btn">
            <i class="fa-solid fa-plus me-1"></i>Add Candidate
        </SfButton>
    </div>

    @if (!string.IsNullOrEmpty(_actionError))
    {
        <div class="alert alert-danger alert-dismissible">
            @_actionError
            <button type="button" class="btn-close" @onclick="() => _actionError = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(_actionSuccess))
    {
        <div class="alert alert-success">@_actionSuccess</div>
    }
    @if (_appointSuccess is not null)
    {
        @* Internal recruitment Ticket 7: an internal appointment updates the EXISTING employee record,
           so link to that profile rather than reporting a new employee id. *@
        <div class="alert alert-success alert-dismissible appoint-success" data-testid="appoint-success">
            <span>
                Internal appointment completed@(_appointSuccess.IsApplied ? "" : $" — the change takes effect on {FormatUkDate(_appointSuccess.EffectiveDate)}").
            </span>
            @* Only link to the full employee record when the user can open it (HR Administrator via
               employee:manage, or the appointee themself) — a Recruiter-only appointer would otherwise
               land on an access-denied page, so they see the employee's name instead. *@
            @if (_canViewEmployeeProfile || _appointSuccess.EmployeeId == Session.EmployeeId)
            {
                <a href="/companies/@CompanyId/employees/@_appointSuccess.EmployeeId" data-testid="appoint-employee-link">View employee profile</a>
            }
            else
            {
                <span class="fw-semibold" data-testid="appoint-employee-name">@_appointSuccess.EmployeeName</span>
            }
            <button type="button" class="btn-close" aria-label="Dismiss" @onclick="() => _appointSuccess = null"></button>
        </div>
    }

    @* Internal recruitment Ticket 6: server-side Internal/External filter. Explicit "All" item rather
       than a clear button. Rendered outside the loading/empty branches so it stays usable when a
       filter matches nothing. data-testid is on the wrapper so E2E can scope the combobox. *@
    <div class="application-type-filter" data-testid="application-type-filter">
        <label class="form-label mb-0" for="application-type-filter">Application type</label>
        <SfDropDownList TValue="ApplicationTypeFilter" TItem="ApplicationTypeFilterOption"
                        ID="application-type-filter" Width="180px"
                        DataSource="@_applicationTypeOptions"
                        Value="@_applicationType" ValueChanged="OnApplicationTypeChangedAsync">
            <DropDownListFieldSettings Value="Value" Text="Label" />
        </SfDropDownList>
    </div>

    @if (_loading)
    {
        <HrLoadingIndicator />
    }
    else if (_applications.Count == 0)
    {
        <p class="text-muted" data-testid="applications-empty">
            @(_applicationType switch
            {
                ApplicationTypeFilter.Internal => "No internal applications for this vacancy.",
                ApplicationTypeFilter.External => "No external applications for this vacancy.",
                _ => "No applications yet for this vacancy.",
            })
        </p>
    }
    else
    {
        <HrGrid @ref="_grid"
                TValue="ApplicationListItemModel"
                DataSource="@_applications"
                Toolbar="@GridToolbar"
                AllowFiltering="false"
                AllowPaging="false">
            <GridEvents TValue="ApplicationListItemModel" OnToolbarClick="OnToolbarClick"
                        RowSelected="OnRowSelected" RowDeselected="OnRowDeselected"
                        RowDataBound="OnApplicationRowDataBound" />
            <GridColumns>
                <GridColumn HeaderText="Candidate" Width="200">
                    <Template>
                        @{
                            var row = (ApplicationListItemModel)context;
                        }
                        @* Internal recruitment Ticket 6: the Internal badge sits in the Candidate cell
                           (not a new column — E2E addresses later cells by index). *@
                        <span class="application-candidate-cell" data-testid="application-candidate-cell">
                            <a href="/companies/@CompanyId/candidates/@row.CandidateId"
                               data-testid="application-candidate-link">@row.CandidateFirstName @row.CandidateLastName</a>
                            <InternalApplicationBadge IsInternal="@row.IsInternal" />
                        </span>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(ApplicationListItemModel.CandidateEmail)" HeaderText="Email" Width="200" />
                <GridColumn HeaderText="Status" Width="220">
                    <Template>
                        @{
                            var row = (ApplicationListItemModel)context;
                        }
                        @* Stable hook for the STAGE badge: the Candidate cell can render an "Internal" badge before it,
                           so a row-level ".badge" first-match is not the stage. *@
                        <span data-testid="application-stage-badge"><StatusBadge Variant="@StatusVariant(row)">@StageName(row.CurrentStageId)</StatusBadge></span>
                        @if (row.IsWithdrawn)
                        {
                            <span class="text-muted ms-1">(Withdrawn)</span>
                        }
                        @if (row.OfferResponseStatus is not null)
                        {
                            <span class="ms-1" data-testid="offer-response-badge">
                                <StatusBadge Variant="@OfferResponseVariant(row.OfferResponseStatus)">Offer: @OfferResponseLabel(row.OfferResponseStatus)</StatusBadge>
                            </span>
                        }
                        @if (row.IsInternal && row.InternalAppointmentStatus == "Pending")
                        {
                            @* Internal recruitment Ticket 7: an earlier Appoint didn't finish; Appoint stays
                               enabled so a retry can complete it. *@
                            <span class="ms-1" data-testid="appointment-pending-hint">
                                <StatusBadge Variant="StatusBadgeVariant.Warning">Appointment in progress</StatusBadge>
                            </span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Interview Outcome" Width="150">
                    <Template>
                        @{
                            var row = (ApplicationListItemModel)context;
                        }
                        @if (row.InterviewOutcome is not null)
                        {
                            <StatusBadge Variant="@InterviewOutcomeVariant(row.InterviewOutcome)">@row.InterviewOutcome</StatusBadge>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(ApplicationListItemModel.AppliedAt)" HeaderText="Applied" Width="130" Format="d" />
                <GridColumn HeaderText="Source" Width="220">
                    <Template>
                        @{
                            var row = (ApplicationListItemModel)context;
                            _sourceDetails.TryGetValue(row.Id, out var detail);
                        }
                        @if (detail?.Source is null or "Unspecified")
                        {
                            <span class="text-muted">—</span>
                        }
                        else if (detail.Source == "ExternalRecruiter")
                        {
                            <span>Source: External Recruiter@(detail.SourceExternalRecruiterAgencyName is null ? "" : $" ({detail.SourceExternalRecruiterAgencyName})")</span>
                        }
                        else
                        {
                            <span>Source: @SourceLabel(detail.Source)</span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="" Width="110">
                    <Template>
                        @{
                            var row = (ApplicationListItemModel)context;
                        }
                        <a href="/companies/@CompanyId/vacancies/@VacancyId/applications/@row.Id/review-cv?returnUrl=@Uri.EscapeDataString($"companies/{CompanyId}/vacancies/{VacancyId}")"
                           data-testid="review-cv-link">Review CV</a>
                    </Template>
                </GridColumn>
            </GridColumns>
        </HrGrid>
    }
</div>

<SfDialog Width="560px" IsModal="true" @bind-Visible="_showAddDialog" Header="Add Candidate" CssClass="add-application-dialog">
    <DialogTemplates>
        <Content>
            <EditForm EditContext="_addEditContext">
                <DataAnnotationsValidator />
                @* Internal recruitment Ticket 3: pick an existing candidate, or create a new one (and
                   their application) without leaving the vacancy. Deliberately NOT a ".mb-3" group —
                   E2E locates the Recruiter field via ".add-application-dialog .mb-3" + text filter. *@
                <div class="add-candidate-mode" role="group" aria-label="Candidate type">
                    <SfButton IsPrimary="@(_addModel.Mode == AddCandidateMode.Existing)"
                              aria-pressed="@(_addModel.Mode == AddCandidateMode.Existing ? "true" : "false")"
                              Disabled="_adding"
                              OnClick="() => SetAddMode(AddCandidateMode.Existing)"
                              data-testid="add-candidate-mode-existing">
                        <i class="fa-solid fa-user-check me-1"></i>Select existing candidate
                    </SfButton>
                    <SfButton IsPrimary="@(_addModel.Mode == AddCandidateMode.New)"
                              aria-pressed="@(_addModel.Mode == AddCandidateMode.New ? "true" : "false")"
                              Disabled="_adding"
                              OnClick="() => SetAddMode(AddCandidateMode.New)"
                              data-testid="add-candidate-mode-new">
                        <i class="fa-solid fa-user-plus me-1"></i>Create new candidate
                    </SfButton>
                </div>
                @if (_addModel.Mode == AddCandidateMode.Existing)
                {
                    <div class="mb-3" data-testid="add-application-candidate-field">
                        <label class="form-label">Candidate <span class="text-danger">*</span></label>
                        <SfDropDownList @ref="_candidateDropdown"
                                        TValue="Guid?" TItem="CandidateListItemModel"
                                        DataSource="@_candidates"
                                        @bind-Value="_addModel.CandidateId" @bind-Value:after="OnCandidateSelectedAsync"
                                        Placeholder="Select a candidate" AllowFiltering="true">
                            <DropDownListFieldSettings Value="Id" Text="FullName" />
                            <DropDownListEvents TValue="Guid?" TItem="CandidateListItemModel" Filtering="OnCandidateFilteringAsync" />
                            <DropDownListTemplates TItem="CandidateListItemModel">
                                <ItemTemplate Context="ddItem">
                                    @{ var c = (CandidateListItemModel)ddItem; }
                                    <span>@c.FirstName @c.LastName</span>
                                </ItemTemplate>
                            </DropDownListTemplates>
                        </SfDropDownList>
                        <ValidationMessage For="@(() => _addModel.CandidateId)" />
                    </div>
                    @if (CurrentCvForSelection is { } currentCv)
                    {
                        <div class="mb-3" data-testid="attach-current-cv">
                            <SfCheckBox TChecked="bool" ID="attach-current-cv-input"
                                        Label="@($"Attach current CV ({currentCv.FileName})")"
                                        @bind-Checked="_attachCurrentCv"
                                        Disabled="_adding" />
                        </div>
                    }
                }
                else
                {
                    <div class="row g-3 mb-3" data-testid="new-candidate-fields">
                        <div class="col-md-6">
                            <label class="form-label" for="new-candidate-first-name">First name <span class="text-danger">*</span></label>
                            <HrTextBox ID="new-candidate-first-name" @bind-Value="_addModel.FirstName" Maxlength="100"
                                       data-testid="new-candidate-first-name" />
                            <ValidationMessage For="@(() => _addModel.FirstName)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="new-candidate-last-name">Last name <span class="text-danger">*</span></label>
                            <HrTextBox ID="new-candidate-last-name" @bind-Value="_addModel.LastName" Maxlength="100"
                                       data-testid="new-candidate-last-name" />
                            <ValidationMessage For="@(() => _addModel.LastName)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="new-candidate-email">Email <span class="text-danger">*</span></label>
                            <HrTextBox ID="new-candidate-email" @bind-Value="_addModel.Email" Maxlength="256"
                                       data-testid="new-candidate-email" />
                            <ValidationMessage For="@(() => _addModel.Email)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="new-candidate-phone">Phone (optional)</label>
                            <HrTextBox ID="new-candidate-phone" @bind-Value="_addModel.Phone" Maxlength="30"
                                       data-testid="new-candidate-phone" />
                            <ValidationMessage For="@(() => _addModel.Phone)" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="new-candidate-cv-input">CV (optional)</label>
                            @* Kept rendered while a file is selected — Blazor Server streams the file from
                               this input element at submit time, so it must stay in the DOM. *@
                            <InputFile @key="_newCvInputKey" id="new-candidate-cv-input" class="form-control"
                                       OnChange="OnNewCvSelected" accept=".pdf,.doc,.docx" disabled="@_adding"
                                       data-testid="new-candidate-cv-input" />
                            <div class="form-text">PDF, DOC or DOCX, up to 20 MB. Uploaded as the candidate's current CV and submitted with this application.</div>
                            @if (_newCvFile is not null)
                            {
                                <div class="add-candidate-cv-selected" data-testid="new-candidate-cv-selected">
                                    <i class="fa-solid fa-file-lines"></i>
                                    <span data-testid="new-candidate-cv-file-name">@_newCvFile.Name</span>
                                    <span class="text-muted small">(@FormatFileSize(_newCvFile.Size))</span>
                                    <SfButton CssClass="e-flat e-small" Disabled="_adding" OnClick="RemoveNewCv"
                                              data-testid="new-candidate-cv-remove">
                                        <i class="fa-solid fa-xmark me-1"></i>Remove
                                    </SfButton>
                                </div>
                            }
                            @if (_newCvError is not null)
                            {
                                <div class="text-danger small mt-1" data-testid="new-candidate-cv-error">@_newCvError</div>
                            }
                        </div>
                    </div>
                }
                <div class="mb-3" data-testid="add-application-source-field">
                    <label class="form-label">Source (optional)</label>
                    <SfDropDownList TValue="string" TItem="SourceOption" DataSource="@_sourceOptions"
                                    @bind-Value="_addModel.Source" Placeholder="Select a source"
                                    ValueChange="OnSourceChanged">
                        <DropDownListFieldSettings Value="Value" Text="Label" />
                    </SfDropDownList>
                </div>
                @if (_addModel.Source == "ExternalRecruiter")
                {
                    <div class="mb-3" data-testid="add-application-recruiter-field">
                        <label class="form-label">Recruiter <span class="text-danger">*</span></label>
                        <SfDropDownList TValue="Guid?" TItem="ExternalRecruiterListItemModel"
                                        DataSource="@_activeRecruitersForSource" @bind-Value="_addModel.SourceRecruiterId"
                                        Placeholder="Select a recruiter" AllowFiltering="true">
                            <DropDownListFieldSettings Value="Id" Text="AgencyName" />
                            <DropDownListTemplates TItem="ExternalRecruiterListItemModel">
                                <ItemTemplate Context="ddItem">
                                    @{ var r = (ExternalRecruiterListItemModel)ddItem; }
                                    <span>
                                        @r.AgencyName
                                        @if (_vacancyAssignedRecruiterId == r.Id)
                                        {
                                            <span class="text-muted ms-1">(assigned to this vacancy)</span>
                                        }
                                    </span>
                                </ItemTemplate>
                            </DropDownListTemplates>
                        </SfDropDownList>
                        <ValidationMessage For="@(() => _addModel.SourceRecruiterId)" />
                        @if (_recruiterNotAssignedWarning)
                        {
                            <div class="form-text text-warning-emphasis" data-testid="recruiter-not-assigned-warning">
                                <i class="fa-solid fa-triangle-exclamation me-1"></i>This recruiter isn't currently assigned to this vacancy.
                            </div>
                        }
                    </div>
                }
                <div class="mb-3">
                    <label class="form-label">Notes (optional)</label>
                    <HrTextBox @bind-Value="_addModel.Notes" Multiline="true" Rows="2" />
                    <ValidationMessage For="@(() => _addModel.Notes)" />
                </div>
                @if (_duplicateCandidate is { } duplicate)
                {
                    <div class="alert alert-warning py-2" role="alert" data-testid="duplicate-candidate-alert">
                        <div>
                            A candidate with this email already exists:
                            <strong data-testid="duplicate-candidate-name">@duplicate.FullName</strong>
                            (<span data-testid="duplicate-candidate-email">@duplicate.Email</span>).
                        </div>
                        @if (duplicate.IsActive)
                        {
                            <div class="mt-2">
                                <SfButton IsPrimary="true" CssClass="e-small" Disabled="_adding"
                                          OnClick="SelectDuplicateCandidateAsync"
                                          data-testid="select-existing-candidate-btn">
                                    Select existing candidate
                                </SfButton>
                            </div>
                        }
                        else
                        {
                            <div class="mt-1" data-testid="duplicate-candidate-inactive">
                                This candidate is inactive and must be reactivated before they can be added to a vacancy.
                                <a href="/companies/@CompanyId/candidates/@duplicate.CandidateId" target="_blank" rel="noopener"
                                   data-testid="duplicate-candidate-details-link">View candidate details</a>
                            </div>
                        }
                    </div>
                }
                @if (_dialogError is not null)
                {
                    <div class="alert alert-danger py-2" role="alert" data-testid="add-application-error">@_dialogError</div>
                }
            </EditForm>
        </Content>
        <FooterTemplate>
            @* Disabled while a request is in flight so a double click can't submit twice (a second
               new-candidate submit would otherwise trip the duplicate-email protection). *@
            <SfButton IsPrimary="true" Disabled="_adding" OnClick="ConfirmAddAsync" data-testid="add-application-submit">
                @if (_adding)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                Add
            </SfButton>
            <SfButton Disabled="_adding" OnClick="() => _showAddDialog = false" data-testid="add-application-cancel">Cancel</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<SfDialog Width="480px" IsModal="true" @bind-Visible="_showScheduleDialog" Header="Schedule Interview" CssClass="schedule-interview-dialog">
    <DialogTemplates>
        <Content>
            <EditForm EditContext="_scheduleEditContext">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label">Interviewer <span class="text-danger">*</span></label>
                    <SfDropDownList TValue="Guid?" TItem="EmployeeListItemModel"
                                    DataSource="@_employees" @bind-Value="_scheduleModel.InterviewerId"
                                    Placeholder="Select interviewer" AllowFiltering="true">
                        <DropDownListFieldSettings Value="Id" Text="FullName" />
                        <DropDownListTemplates TItem="EmployeeListItemModel">
                            <ItemTemplate Context="employeeItem">
                                @{ var e = (EmployeeListItemModel)employeeItem; }
                                <span>@e.FirstName @e.LastName</span>
                            </ItemTemplate>
                        </DropDownListTemplates>
                    </SfDropDownList>
                    <ValidationMessage For="@(() => _scheduleModel.InterviewerId)" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Scheduled At <span class="text-danger">*</span></label>
                    <SfDateTimePicker TValue="DateTime?" @bind-Value="_scheduleModel.ScheduledAt" Format="dd/MM/yyyy HH:mm" />
                    <ValidationMessage For="@(() => _scheduleModel.ScheduledAt)" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Duration (minutes)</label>
                    <SfNumericTextBox TValue="int?" @bind-Value="_scheduleModel.DurationMinutes" ShowSpinButton="false" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Location</label>
                    <HrTextBox @bind-Value="_scheduleModel.Location" Placeholder="e.g. Remote" />
                </div>
            </EditForm>
            @if (_dialogError is not null)
            {
                <div class="alert alert-danger py-2">@_dialogError</div>
            }
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Schedule" IsPrimary="true" OnClick="ConfirmScheduleAsync" />
        <DialogButton Content="Cancel" OnClick="() => _showScheduleDialog = false" />
    </DialogButtons>
</SfDialog>

<SfDialog Width="420px" IsModal="true" @bind-Visible="_showRejectDialog" Header="Reject Candidate" CssClass="reject-candidate-dialog">
    <DialogTemplates>
        <Content>
            <div class="mb-3">
                <label class="form-label">Reason (optional)</label>
                <HrTextBox @bind-Value="_rejectionReason" Multiline="true" Rows="2" />
            </div>
            @if (_dialogError is not null)
            {
                <div class="alert alert-danger py-2">@_dialogError</div>
            }
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Reject" IsPrimary="true" OnClick="ConfirmRejectAsync" />
        <DialogButton Content="Cancel" OnClick="() => _showRejectDialog = false" />
    </DialogButtons>
</SfDialog>

<SfDialog Width="520px" IsModal="true" @bind-Visible="_showHireDialog" Header="Hire Candidate" CssClass="hire-candidate-dialog">
    <DialogTemplates>
        <Content>
            <EditForm EditContext="_hireEditContext">
                <DataAnnotationsValidator />
                @if (_hireOfferAccepted)
                {
                    <div class="alert alert-info py-2" data-testid="hire-offer-accepted-context">
                        Offer accepted: @FormatOfferedSalary(_hireOfferedSalary, _hireOfferedSalaryFrequency) – will seed first compensation record.
                    </div>
                }
                @if (_hireOfferBlockedMessage is not null)
                {
                    <div class="alert alert-warning py-2" data-testid="hire-offer-blocked">@_hireOfferBlockedMessage</div>
                }
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Start Date @if (!_hireStartDateOptional) {<span class="text-danger">*</span>}</label>
                        <SfDatePicker TValue="DateOnly?" @bind-Value="_hireModel.StartDate" data-testid="hire-start-date" />
                        <ValidationMessage For="@(() => _hireModel.StartDate)" />
                        @if (_hireStartDateOptional)
                        {
                            <div class="form-text">Leave blank to use the accepted offer's proposed start date.</div>
                        }
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Date of Birth <span class="text-danger">*</span></label>
                        <SfDatePicker TValue="DateOnly?" @bind-Value="_hireModel.DateOfBirth" Format="dd/MM/yyyy" />
                        <ValidationMessage For="@(() => _hireModel.DateOfBirth)" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Nationality <span class="text-danger">*</span></label>
                        <SfDropDownList TValue="string" TItem="NationalityListItem"
                                        DataSource="@_nationalities" @bind-Value="_hireModel.Nationality"
                                        Placeholder="Select nationality" AllowFiltering="true">
                            <DropDownListFieldSettings Value="Name" Text="Name" />
                        </SfDropDownList>
                        <ValidationMessage For="@(() => _hireModel.Nationality)" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Gender <span class="text-danger">*</span></label>
                        <SfDropDownList TValue="string" TItem="string" DataSource="@_genderOptions" @bind-Value="_hireModel.Gender" Placeholder="Select gender" />
                        <ValidationMessage For="@(() => _hireModel.Gender)" />
                        @if (_hireModel.Gender == "Other")
                        {
                            <div class="mt-2">
                                <HrTextBox @bind-Value="_hireModel.GenderOther" Placeholder="Please specify" />
                                <ValidationMessage For="@(() => _hireModel.GenderOther)" />
                            </div>
                        }
                    </div>
                    @if (_hireEmployeeNumberMode == EmployeeNumberMode.Automatic)
                    {
                        <div class="col-md-6">
                            <label class="form-label">Employee Number</label>
                            <p class="text-muted small mb-0">An employee number will be assigned automatically when this candidate is hired.</p>
                        </div>
                    }
                    else
                    {
                        <div class="col-md-6">
                            <label class="form-label">Employee Number <span class="text-danger">*</span></label>
                            <HrTextBox @bind-Value="_hireModel.EmployeeNumber" Placeholder="e.g. EMP-001" />
                            <ValidationMessage For="@(() => _hireModel.EmployeeNumber)" />
                        </div>
                    }
                    <div class="col-md-6">
                        <label class="form-label">Employment Type <span class="text-danger">*</span></label>
                        <SfDropDownList TValue="Guid?"
                                        TItem="EmploymentTypeListItemModel"
                                        DataSource="@_employmentTypes"
                                        @bind-Value="_hireModel.EmploymentTypeId"
                                        Placeholder="Select type">
                            <DropDownListFieldSettings Value="Id" Text="Name" />
                        </SfDropDownList>
                        <ValidationMessage For="@(() => _hireModel.EmploymentTypeId)" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Position Profile</label>
                        <div class="p-2 rounded border bg-light" data-testid="hire-derived-position-profile">@_derivedPositionProfileName</div>
                        <div class="form-text">Derived from the vacancy — the employee is assigned to this profile (and its department/location) automatically.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Location</label>
                        <div class="p-2 rounded border bg-light" data-testid="hire-derived-location">@_derivedLocationName</div>
                        <div class="form-text">Derived from the vacancy's position profile.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Manager</label>
