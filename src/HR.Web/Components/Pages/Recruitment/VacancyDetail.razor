@page "/companies/{CompanyId:guid}/vacancies/new"
@page "/companies/{CompanyId:guid}/vacancies/{Id:guid}"
@page "/companies/{CompanyId:guid}/vacancies/{Id:guid}/view"
@rendermode InteractiveServer
@inject VacancyService VacancyService
@inject DepartmentService DepartmentService
@inject EmployeeService EmployeeService
@inject PositionProfileService PositionProfileService
@inject LocationService LocationService
@inject ExternalRecruiterService ExternalRecruiterService
@inject AppSession Session
@inject IJSRuntime JS

@inherits EditPageBase<VacancyEditModel, Guid>

<PageTitle>@PageTitle</PageTitle>

<div class="container py-4">
    <SfBreadcrumb Class="mb-3">
        <BreadcrumbItems>
            <BreadcrumbItem Text="Vacancies" Url="@($"/companies/{CompanyId}/vacancies")" />
            <BreadcrumbItem Text="@PageTitle" />
        </BreadcrumbItems>
    </SfBreadcrumb>

    @if (IsLoading)
    {
        <HrLoadingIndicator />
    }
    else if (IsNew)
    {
        <h1 class="mb-1">Add Vacancy</h1>
        <p class="text-muted mb-4">Create a new vacancy for a role you're hiring for.</p>

        @if (!string.IsNullOrEmpty(GlobalError))
        {
            <div class="alert alert-danger" role="alert">@GlobalError</div>
        }

        <EditForm EditContext="EditContext">
            <DataAnnotationsValidator />
            @RenderDetailsCard()
            <div class="d-flex gap-2 mt-3 justify-content-end">
                <SfButton IsPrimary="true" Disabled="@(Saving || IsSubscriptionReadOnly)" OnClick="SaveAsync">
                    @if (Saving)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    Save
                </SfButton>
                <SfButton OnClick="RequestClose" Disabled="@Saving">@(IsViewMode ? "Back to vacancies" : "Cancel")</SfButton>
            </div>
        </EditForm>
    }
    else
    {
        <div class="d-flex align-items-center gap-3 mb-1">
            <h1 class="mb-0 fs-4">@(_vacancy?.EffectiveTitle ?? PageTitle)</h1>
            @if (_vacancy is not null)
            {
                <StatusBadge Variant="@StatusVariant(_vacancy.Status)">@EnumDisplay.Humanize(_vacancy.Status)</StatusBadge>
            }
            <div class="vacancy-header-actions">
                @if (CanPublish)
                {
                    <SfButton IsPrimary="true" OnClick="PublishVacancyAsync" Disabled="@(_publishing || Session.IsReadOnly)">
                        @if (_publishing)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Publish Vacancy
                    </SfButton>
                }
                @if (Session.CanManageRecruitment && _vacancy is not null && _vacancy.Status != "Draft")
                {
                    <SfButton OnClick="@(() => Navigation.NavigateTo($"/companies/{CompanyId}/vacancies/{Id}/kanban"))">
                        View Kanban Board
                    </SfButton>
                }
                @if (CanClose)
                {
                    <SfButton CssClass="e-danger e-outline close-vacancy-btn" OnClick="@(() => _showCloseConfirm = true)" Disabled="@(_closing || Session.IsReadOnly)"
                              HtmlAttributes="@(new Dictionary<string, object> { ["id"] = "close-vacancy-btn", ["data-testid"] = "close-vacancy-btn" })">
                        @if (_closing)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Close Vacancy
                    </SfButton>
                }
            </div>
        </div>
        <p class="text-muted mb-3">Manage this vacancy's details, applications, and interviews.</p>

        <SaveConflictBanner Visible="SaveConflict" Disabled="@Saving" OnReload="ReloadLatestValuesAsync"
                            Message="Someone else changed this vacancy while you were editing. Your changes have not been saved." />
        @if (!SaveConflict && !string.IsNullOrEmpty(GlobalError))
        {
            <div class="alert alert-danger mb-3" role="alert">@GlobalError</div>
        }
        @if (!string.IsNullOrEmpty(_closeError))
        {
            <div class="alert alert-danger mb-3" role="alert">@_closeError</div>
        }
        @if (!string.IsNullOrEmpty(_publishError))
        {
            <div class="alert alert-danger mb-3" role="alert">@_publishError</div>
        }

        <SfTab @bind-SelectedItem="_selectedTabIndex">
            <TabItems>
                <TabItem>
                    <ChildContent><TabHeader Text="Overview" /></ChildContent>
                    <ContentTemplate>
                        <EditForm EditContext="EditContext">
                            <DataAnnotationsValidator />
                            <div class="mt-4">
                                @RenderDetailsCard()
                                <div class="d-flex gap-2 mt-3 justify-content-end">
                                    @if (!IsViewMode)
                                    {
                                        <SfButton IsPrimary="true" Disabled="@(Saving || IsSubscriptionReadOnly)" OnClick="SaveAsync">
                                            @if (Saving)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                            }
                                            Save
                                        </SfButton>
                                    }
                                    <SfButton OnClick="RequestClose" Disabled="@Saving">@(IsViewMode ? "Back to vacancies" : "Cancel")</SfButton>
                                </div>
                            </div>
                        </EditForm>
                    </ContentTemplate>
                </TabItem>

                @if (_vacancy is not null && _vacancy.Status != "Draft")
                {
                    <TabItem>
                        <ChildContent><TabHeader Text="Applications" /></ChildContent>
                        <ContentTemplate>
                            <div class="mt-4">
                                <VacancyApplicationsTab CompanyId="CompanyId" VacancyId="Id!.Value" />
                            </div>
                        </ContentTemplate>
                    </TabItem>

                    <TabItem>
                        <ChildContent><TabHeader Text="Interviews" /></ChildContent>
                        <ContentTemplate>
                            <div class="mt-4">
                                <VacancyInterviewsTab CompanyId="CompanyId" VacancyId="Id!.Value" />
                            </div>
                        </ContentTemplate>
                    </TabItem>
                }
            </TabItems>
        </SfTab>
    }

    <NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges" />

    <div data-testid="close-vacancy-confirm-dialog">
        <HrConfirmDialog Visible="_showCloseConfirm"
                         Title="Close vacancy"
                         Message="Closing this vacancy sets its status to Closed and records today as the closing date, so it stops accepting new applications. Existing applications, interviews and pipeline activity are not changed or deleted and stay available to view. This cannot be undone from this page."
                         ConfirmText="Close vacancy"
                         CancelText="Cancel"
                         DangerConfirm="true"
                         Busy="_closing"
                         OnConfirmed="ConfirmCloseVacancyAsync"
                         OnCancelled="CancelCloseVacancyAsync" />
    </div>

    <UnsavedChangesDialog Visible="ShowUnsavedChangesDialog"
                          Message="You have unsaved changes. Save them, discard them, or stay on this page to keep editing."
                          StayText="Stay on page"
                          DiscardText="Discard changes"
                          OnSaveAndClose="ConfirmSaveAndCloseAsync"
                          OnDiscard="DiscardChangesAndClose"
                          OnCancel="CancelCloseDialog" />
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid? Id { get; set; }

    private GetVacancyResponse? _vacancy;
    private List<DepartmentListItemModel> _departments = [];
    private List<EmployeeListItemModel> _employees = [];
    private int _employeeTotalPages;
    private SfDropDownList<Guid?, EmployeeListItemModel> _hiringManagerDropdown = default!;
    private int _hiringManagerFilterRequestId;

    private async Task OnHiringManagerFilteringAsync(Syncfusion.Blazor.DropDowns.FilteringEventArgs args)
    {
        args.PreventDefaultAction = true;
        var requestId = ++_hiringManagerFilterRequestId;
        var result = await EmployeeService.ListSelectableEmployeesAsync(CompanyId, search: args.Text, pageSize: 50);
        if (requestId != _hiringManagerFilterRequestId) return;
        await _hiringManagerDropdown.FilterAsync(result?.Items.ToList() ?? [], new Syncfusion.Blazor.Data.Query());
    }
    private List<LocationListItemModel> _locations = [];
    private List<PositionProfileListItemModel> _positionProfiles = [];
    private List<ExternalRecruiterListItemModel> _externalRecruiters = [];
    private GetPositionProfileResponse? _selectedProfileDefaults;
    private bool _closing;
    private bool _showCloseConfirm;
    private string? _closeError;
    private bool _publishing;
    private string? _publishError;

    private int _selectedTabIndex;

    private string PageTitle => IsNew ? "Add Vacancy"
        : _vacancy is not null ? _vacancy.EffectiveTitle
        : IsViewMode ? "View Vacancy" : "Edit Vacancy";

    private bool CanClose => _vacancy is not null && _vacancy.Status is not ("Closed" or "Cancelled") && !IsViewMode;
    private bool CanPublish => _vacancy is not null && _vacancy.Status is "Draft" or "OnHold" && !IsViewMode;

    // Locked (CanChangePositionProfile == false) unless the user is requesting an authorised
    // correction — gated behind the same Recruiter role that already owns UpdateVacancy
    // ("recruitment:manage" on the API side), so re-enabling the dropdown here can never grant more
    // access than the endpoint itself would allow.
    private bool CanRequestCorrection => Session.CanManageRecruitment && _vacancy is not null && !_vacancy.CanChangePositionProfile;
    private bool CanEditPositionProfile => IsNew || (_vacancy?.CanChangePositionProfile ?? false)
        || (Model.IsAuthorisedCorrection && CanRequestCorrection);

    protected override IEditService<VacancyEditModel, Guid> Service => VacancyService;
    protected override Guid GetCompanyId() => CompanyId;
    protected override Guid? GetId() => Id;

    protected override async Task OnLoadedAsync()
    {
        if (!AppSession.GuardAccess(Navigation, Session.CanManageRecruitment))
            return;

        var deptResult = await DepartmentService.ListDepartmentsAsync(CompanyId);
        _departments = deptResult?.Items ?? [];

        var empResult = await EmployeeService.ListSelectableEmployeesAsync(CompanyId, pageSize: 200);
        _employees = empResult?.Items.ToList() ?? [];
        _employeeTotalPages = empResult?.TotalPages ?? 0;

        var locationResult = await LocationService.ListLocationsAsync(CompanyId);
        _locations = locationResult?.Items ?? [];

        var profileResult = await PositionProfileService.ListPositionProfilesAsync(CompanyId);
        _positionProfiles = profileResult?.Items.ToList() ?? [];

        if (IsNew)
        {
            var activelyHeldProfileIds = _employees
                .Where(e => e.Status == "Active" && e.PositionProfileId is not null)
                .Select(e => e.PositionProfileId!.Value)
                .ToHashSet();

            var vacanciesResult = await VacancyService.ListVacanciesAsync(CompanyId, excludeClosed: true);
            var profileIdsWithLiveVacancy = (vacanciesResult?.Items ?? [])
                .Where(v => v.Status != "Cancelled")
                .Select(v => v.PositionProfileId)
                .ToHashSet();

            _positionProfiles = _positionProfiles
                .Where(p => !activelyHeldProfileIds.Contains(p.Id) && !profileIdsWithLiveVacancy.Contains(p.Id))
                .ToList();
        }

        var recruitersResult = await ExternalRecruiterService.ListExternalRecruitersAsync(CompanyId, isActive: true, pageSize: 200);
        _externalRecruiters = (recruitersResult?.Items.ToList() ?? [])
            .OrderBy(r => r.AgencyName)
            .Prepend(new ExternalRecruiterListItemModel(Guid.Empty, "Not assigned", null, null, null, true, 0, DateTimeOffset.MinValue))
            .ToList();

        if (!IsNew)
        {
            _vacancy = await VacancyService.GetVacancyAsync(CompanyId, Id!.Value);

            if (_vacancy is { } loadedVacancy)
            {
                for (var employeePage = 2;
                     employeePage <= _employeeTotalPages && _employees.All(e => e.Id != loadedVacancy.HiringManagerId);
                     employeePage++)
                {
                    var nextPage = await EmployeeService.ListSelectableEmployeesAsync(CompanyId, pageNumber: employeePage, pageSize: 200);
                    if (nextPage is null)
                        break;
                    _employees.AddRange(nextPage.Items);
                }
            }

            if (_vacancy?.PositionProfileId is { } profileId && _positionProfiles.All(p => p.Id != profileId))
            {
                var profile = await PositionProfileService.GetPositionProfileAsync(CompanyId, profileId);
                if (profile is not null)
                {
                    var departmentName = profile.DepartmentId is { } deptId
                        ? _departments.FirstOrDefault(d => d.Id == deptId)?.Name
                        : null;

                    _positionProfiles.Add(new PositionProfileListItemModel(
                        profile.Id, departmentName, profile.Title,
                        profile.IsActive, profile.SalaryMin, profile.SalaryMax, profile.SalaryType,
                        profile.NoticePeriodUnitOverride, profile.NoticePeriodLengthOverride,
                        _locations.FirstOrDefault(l => l.Id == profile.LocationId)?.Name));
                }
            }

            if (_vacancy?.AssignedRecruiterId is { } assignedRecruiterId && _externalRecruiters.All(r => r.Id != assignedRecruiterId))
            {
                var recruiter = await ExternalRecruiterService.GetExternalRecruiterAsync(CompanyId, assignedRecruiterId);
                if (recruiter is not null)
                {
                    _externalRecruiters.Add(new ExternalRecruiterListItemModel(
                        recruiter.Id, recruiter.AgencyName, recruiter.ContactName, recruiter.ContactEmail,
                        recruiter.ContactTelephone, recruiter.IsActive, 0, recruiter.CreatedAt));
                }
            }
        }
    }

    protected override string? ListUrl => $"/companies/{CompanyId}/vacancies";

    private async Task CancelCloseVacancyAsync()
    {
        _showCloseConfirm = false;
        await JS.InvokeVoidAsync("hrFocusById", "close-vacancy-btn");
    }

    private async Task ConfirmCloseVacancyAsync()
    {
        await CloseVacancyAsync();
        _showCloseConfirm = false;
    }

    private async Task CloseVacancyAsync()
    {
        if (_vacancy is null) return;

        _closing = true;
        _closeError = null;
        StateHasChanged();

        var (result, error) = await VacancyService.CloseVacancyAsync(CompanyId, _vacancy.Id);

        _closing = false;

        if (result is null)
        {
            _closeError = error;
            return;
        }

        _vacancy = await VacancyService.GetVacancyAsync(CompanyId, _vacancy.Id);
    }

    private async Task PublishVacancyAsync()
    {
        if (_vacancy is null) return;

        _publishing = true;
        _publishError = null;
        StateHasChanged();

        var (result, error) = await VacancyService.PublishVacancyAsync(CompanyId, _vacancy.Id);

        _publishing = false;

        if (result is null)
        {
            _publishError = error;
            return;
        }

        _vacancy = await VacancyService.GetVacancyAsync(CompanyId, _vacancy.Id);
    }

    private static StatusBadgeVariant StatusVariant(string status) => status switch
    {
        "Open" => StatusBadgeVariant.Success,
        "OnHold" => StatusBadgeVariant.Warning,
        "Closed" => StatusBadgeVariant.Secondary,
        "Cancelled" => StatusBadgeVariant.Danger,
        _ => StatusBadgeVariant.Info,
    };

    // Position Profile is selected first and drives the rest of the form. Department and location are
    // both derived entirely from the linked Position Profile (shown read-only below) — there's no
    // vacancy-level department or location to populate here anymore. AdvertTitle is a deliberate,
    // genuinely-optional override, so it's intentionally left untouched here — it should stay empty
    // unless the user explicitly types something.
    private async Task OnPositionProfileChangedAsync(Guid? value)
    {
        Model.PositionProfileId = value;
        _selectedProfileDefaults = null;

        if (value is Guid profileId)
        {
            _selectedProfileDefaults = await PositionProfileService.GetPositionProfileAsync(CompanyId, profileId);
        }
    }

    private string? PositionProfileHelpText =>
        IsNew ? "Select the position profile first — it sets defaults for the fields below."
        : _vacancy is not null && !_vacancy.CanChangePositionProfile
            ? "Position Profile cannot be changed after the vacancy has applications or has moved past Draft status" + (CanRequestCorrection ? ", unless you request an authorised correction below." : ".")
        : null;

    private Dictionary<string, object> HiringManagerAttributes
    {
        get
        {
            var attrs = FieldAria.Build(EditContext, Model, "vacancy-hiring-manager", nameof(Model.HiringManagerId), required: true);
            attrs["aria-label"] = "Hiring Manager";
            attrs["aria-labelledby"] = "vacancy-hiring-manager-label";
            return attrs;
        }
    }

    protected override string? InvalidFieldFocusScope => "form";

    private void OnAuthorisedCorrectionToggled(bool value)
    {
        Model.IsAuthorisedCorrection = value;
        if (!Model.IsAuthorisedCorrection)
        {
            Model.CorrectionReason = null;
            // Revert to the vacancy's actual current Position Profile — the dropdown was only
            // unlocked to allow a correction, so unchecking the box should not leave a pending
            // change that would still be sent because it was selected while unlocked.
            Model.PositionProfileId = _vacancy?.PositionProfileId ?? Model.PositionProfileId;
        }
    }

    private string? SelectedProfileDepartmentName =>
        _selectedProfileDefaults?.DepartmentId is { } deptId
            ? _departments.FirstOrDefault(d => d.Id == deptId)?.Name
            : null;

    private string? SelectedProfileLocationName =>
        _selectedProfileDefaults?.LocationId is { } locationId
            ? _locations.FirstOrDefault(l => l.Id == locationId)?.Name
            : null;

    private string? LinkedProfileDepartmentName =>
        _vacancy?.PositionProfileDepartmentId is { } deptId
            ? _departments.FirstOrDefault(d => d.Id == deptId)?.Name
            : null;

    private static string ProfileSalaryRangeSummary(GetPositionProfileResponse profile) => (profile.SalaryMin, profile.SalaryMax) switch
    {
        (not null, not null) => $"{profile.SalaryMin:N0} - {profile.SalaryMax:N0}",
        (not null, null) => $"From {profile.SalaryMin:N0}",
        (null, not null) => $"Up to {profile.SalaryMax:N0}",
        _ => string.Empty
    };

    private RenderFragment RenderDetailsCard() => @<div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Position Profile</h5>
                </div>
                <div class="card-body @(IsViewMode ? "view-mode" : "")">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <HrDropDownField TValue="Guid?" TItem="PositionProfileListItemModel"
                                             Label="Position Profile" Required="true" Id="vacancy-position-profile"
                                             DataSource="@_positionProfiles"
                                             Value="Model.PositionProfileId"
                                             ValueChanged="OnPositionProfileChangedAsync"
                                             ValueExpression="@(() => Model.PositionProfileId)"
                                             ValueField="Id" TextField="DisplayLabel"
                                             Placeholder="Select position profile"
                                             Disabled="@(!CanEditPositionProfile || IsViewMode)"
                                             HelpText="@PositionProfileHelpText" />
                        </div>
                    </div>

                    @if (CanRequestCorrection && !IsViewMode)
                    {
                        <div class="row g-3 mt-1" data-testid="position-profile-correction-section">
                            <div class="col-12">
                                <HrCheckBoxField Label="This is an authorised correction" Id="isAuthorisedCorrection"
                                                 Checked="Model.IsAuthorisedCorrection"
                                                 CheckedChanged="OnAuthorisedCorrectionToggled" />
                            </div>
                            @if (Model.IsAuthorisedCorrection)
                            {
                                <div class="col-md-8">
                                    <HrTextField Label="Correction Reason" Required="true" Id="vacancy-correction-reason"
                                                 @bind-Value="Model.CorrectionReason" Placeholder="Explain why this correction is required" />
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            @if (_selectedProfileDefaults is not null)
            {
                <div class="card mb-4" data-testid="position-profile-defaults-summary">
                    <div class="card-header">
                        <h5 class="mb-0">From Position Profile</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0 small">
                            <dt class="col-5 text-muted fw-normal">Department</dt>
                            <dd class="col-7">@(SelectedProfileDepartmentName ?? "None")</dd>
                            <dt class="col-5 text-muted fw-normal">Location</dt>
                            <dd class="col-7">@(SelectedProfileLocationName ?? "None")</dd>
                            @if (_selectedProfileDefaults.SalaryMin is not null || _selectedProfileDefaults.SalaryMax is not null)
                            {
                                <dt class="col-5 text-muted fw-normal">Salary Range</dt>
                                <dd class="col-7">@ProfileSalaryRangeSummary(_selectedProfileDefaults)</dd>
                            }
                        </dl>
                    </div>
                </div>
            }

            @if (_vacancy is not null)
            {
                <div class="card mb-4" data-testid="linked-position-profile-card">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <h5 class="mb-0">Linked Position Profile</h5>
                        <a href="/companies/@CompanyId/position-profiles/@_vacancy.PositionProfileId/view">View Position Profile</a>
                    </div>
                    <div class="card-body">
                        @if (_vacancy.PositionProfileTitle is null)
                        {
                            <p class="text-muted mb-0">No position profile linked.</p>
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="fw-semibold">@_vacancy.PositionProfileTitle</span>
                                @if (_vacancy.PositionProfileIsActive == false)
                                {
                                    <ActiveStatusBadge IsActive="false" />
                                }
                            </div>
                            <dl class="row mb-0 small">
                                <dt class="col-5 text-muted fw-normal">Department</dt>
                                <dd class="col-7">@(LinkedProfileDepartmentName ?? "None")</dd>
                                <dt class="col-5 text-muted fw-normal">Location</dt>
                                <dd class="col-7">@(_vacancy.EffectiveLocation ?? "None")</dd>
                            </dl>
                        }
                    </div>
                </div>
            }

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Recruitment Advert Details</h5>
                </div>
                <div class="card-body @(IsViewMode ? "view-mode" : "")">
                    <div class="form-text mb-3">The role itself (title, department, location, job description) is defined by the Position Profile above. These fields are only for recruitment-specific advert wording — e.g. a tailored posting title/description.</div>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <HrTextField Label="Advert Title" Id="vacancy-advert-title"
                                         @bind-Value="Model.AdvertTitle" Placeholder="e.g. Senior Software Engineer"
                                         ReadOnly="@IsViewMode" />
                        </div>
                        <div class="col-md-4">
                            <label id="vacancy-hiring-manager-label" for="vacancy-hiring-manager" class="form-label">Hiring Manager <span class="text-danger">*</span></label>
                            <SfDropDownList @ref="_hiringManagerDropdown"
                                            TValue="Guid?"
                                            TItem="EmployeeListItemModel"
                                            DataSource="@_employees"
                                            @bind-Value="Model.HiringManagerId"
                                            Placeholder="Select hiring manager"
                                            AllowFiltering="true"
                                            Enabled="@(!IsViewMode)"
                                            HtmlAttributes="@HiringManagerAttributes">
                                <DropDownListFieldSettings Value="Id" Text="FullName" />
                                <DropDownListEvents TValue="Guid?" TItem="EmployeeListItemModel" Filtering="OnHiringManagerFilteringAsync" />
                                <DropDownListTemplates TItem="EmployeeListItemModel">
                                    <ItemTemplate>
                                        @{
                                            var e = (EmployeeListItemModel)context;
                                        }
                                        <span>@e.FullName</span>
                                    </ItemTemplate>
                                </DropDownListTemplates>
                            </SfDropDownList>
                            <div id="vacancy-hiring-manager-error" role="alert">
                                <ValidationMessage For="@(() => Model.HiringManagerId)" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <HrDropDownField TValue="Guid" TItem="ExternalRecruiterListItemModel"
                                             Label="Recruitment Agency" Id="vacancy-recruitment-agency"
                                             DataSource="@_externalRecruiters"
                                             @bind-Value="Model.AssignedRecruiterId"
                                             ValueField="Id" TextField="AgencyName"
                                             Placeholder="Not assigned"
                                             Disabled="@IsViewMode" />
                        </div>
                        <div class="col-12">
                            <HrTextField Label="Advert Description" Id="vacancy-advert-description"
                                         @bind-Value="Model.AdvertDescription" Multiline="true" Rows="4" ReadOnly="@IsViewMode" />
                        </div>
                        <div class="col-12">
                            <HrCheckBoxField Label="Advertise this vacancy to employees" Id="isAdvertisedInternally"
                                             HtmlAttributes="@(new Dictionary<string, object> { ["data-testid"] = "vacancy-advertise-internally" })"
                                             @bind-Checked="Model.IsAdvertisedInternally"
                                             Disabled="@IsViewMode"
                                             HelpText="Shows the vacancy in the internal vacancy list" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>;
}
