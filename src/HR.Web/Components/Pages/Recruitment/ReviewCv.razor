@page "/companies/{CompanyId:guid}/vacancies/{VacancyId:guid}/applications/{ApplicationId:guid}/review-cv"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@inject ApplicationService ApplicationService
@inject CandidateService CandidateService
@inject VacancyService VacancyService
@inject AppSession Session
@inject NavigationManager Navigation

<PageTitle>Review CV</PageTitle>

<div class="container py-4" data-testid="review-cv-page">
    <a href="@BackTarget" class="text-decoration-none text-muted small">← Back</a>
    <h1 class="mb-3 mt-1">Review CV</h1>

    @if (_loading)
    {
        <HrLoadingIndicator />
    }
    else if (_app is null)
    {
        <div class="alert alert-danger">This application could not be loaded.</div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_globalError))
        {
            <div class="alert alert-danger">@_globalError</div>
        }
        @if (!string.IsNullOrEmpty(_success))
        {
            <div class="alert alert-success">@_success</div>
        }

        <div class="row g-4">
            <div class="col-lg-5">
                <div class="card mb-4">
                    <div class="card-header"><h5 class="mb-0">Candidate</h5></div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-5">Name</dt>
                            <dd class="col-7" data-testid="review-cv-candidate-name">@_app.CandidateFirstName @_app.CandidateLastName</dd>
                            <dt class="col-5">Email</dt>
                            <dd class="col-7">@_app.CandidateEmail</dd>
                            <dt class="col-5">Position</dt>
                            <dd class="col-7" data-testid="review-cv-position">@(_vacancyTitle ?? "—")</dd>
                            <dt class="col-5">Current stage</dt>
                            <dd class="col-7" data-testid="review-cv-current-stage">@_app.CurrentStageName</dd>
                            @if (!string.IsNullOrWhiteSpace(_app.Source) && _app.Source != "Unspecified")
                            {
                                <dt class="col-5">Source</dt>
                                <dd class="col-7">
                                    @if (_app.Source == "ExternalRecruiter")
                                    {
                                        <text>External Recruiter@(_app.SourceExternalRecruiterAgencyName is null ? "" : $" ({_app.SourceExternalRecruiterAgencyName})")</text>
                                    }
                                    else
                                    {
                                        @_app.Source
                                    }
                                </dd>
                            }
                        </dl>
                        @if (_app.WithdrawnAt is not null)
                        {
                            <div class="alert alert-warning mt-3 mb-0">This candidate has withdrawn their application.</div>
                        }
                    </div>
                </div>

                <div class="card">
                    <div class="card-header"><h5 class="mb-0">CV review notes</h5></div>
                    <div class="card-body">
                        @if (_app.CvReviewedAt is not null)
                        {
                            <p class="text-muted small mb-2">Last reviewed @_app.CvReviewedAt.Value.LocalDateTime.ToString("g")</p>
                        }
                        <div data-testid="review-cv-notes">
                            <HrTextBox @bind-Value="_notes" Multiline="true" Rows="10" Maxlength="4000"
                                       Placeholder="Record your assessment of this CV" />
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <SfButton IsPrimary="true" Disabled="@(_busy || _app.WithdrawnAt is not null)" OnClick="SaveNotesAsync" data-testid="review-cv-save-notes">Save Notes</SfButton>
                            <SfButton Disabled="@(_busy || _app.WithdrawnAt is not null)" OnClick="MoveForwardAsync" data-testid="review-cv-move-forward">Move Forward</SfButton>
                            <SfButton CssClass="e-danger" Disabled="@(_busy || _app.WithdrawnAt is not null)" OnClick="@(() => _showRejectDialog = true)" data-testid="review-cv-reject">Reject</SfButton>
                            <SfButton Disabled="@_busy" OnClick="Close" data-testid="review-cv-close">Close</SfButton>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0" data-testid="review-cv-panel-title">@CvPanelTitle</h5>
                        @if (DisplayedCvDocumentId is not null && IsDisplayedCvClean)
                        {
                            <a href="@CvProxyUrl" target="_blank" rel="noopener">Open in new tab / Download</a>
                        }
                    </div>
                    <div class="card-body">
                        @if (DisplayedCvDocumentId is not null)
                        {
                            @if (_app.CvDocumentId is not null)
                            {
                                <p class="small text-muted" data-testid="review-cv-submitted-file-name">@_app.CvFileName</p>
                            }
                            else
                            {
                                @* Internal recruitment Ticket 1: no CV was captured with this application, so the
                                   document below is the candidate's CURRENT CV — never present it as submitted. *@
                                <div class="alert alert-warning" role="alert" data-testid="review-cv-no-submitted-cv">
                                    No CV was captured with this application. The document shown is the candidate's
                                    current CV@(_app.CurrentCandidateCvUploadedAt is DateTimeOffset uploadedAt ? $" (uploaded {uploadedAt.LocalDateTime:d MMM yyyy})" : ""),
                                    which may differ from the CV they applied with.
                                </div>
                                <p class="small text-muted" data-testid="review-cv-current-file-name">@_app.CurrentCandidateCvFileName</p>
                            }

                            @if (!IsDisplayedCvClean)
                            {
                                @* Malware-scan gate: only a Clean CV is embedded or linked. Anything else
                                   (including a missing/unknown status) fails closed with an explanation. *@
                                @if (CandidateDocumentScanStatuses.IsInProgress(DisplayedCvScanStatus))
                                {
                                    <div class="alert alert-info d-flex flex-wrap align-items-center justify-content-between gap-2" role="status"
                                         data-testid="review-cv-scan-status" data-scan-status="@(DisplayedCvScanStatus ?? string.Empty)">
                                        <span>This CV is being security checked. It will be viewable once the check completes.</span>
                                        <SfButton CssClass="e-small" Disabled="@_busy" OnClick="CheckScanAgainAsync"
                                                  data-testid="review-cv-scan-refresh">Check again</SfButton>
                                    </div>
                                }
                                else if (CandidateDocumentScanStatuses.IsInfected(DisplayedCvScanStatus))
                                {
                                    <div class="alert alert-danger" role="alert"
                                         data-testid="review-cv-scan-status" data-scan-status="@(DisplayedCvScanStatus ?? string.Empty)">
                                        This CV failed a malware check and has been quarantined. It cannot be opened. Ask the candidate for a new copy.
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-warning" role="alert"
                                         data-testid="review-cv-scan-status" data-scan-status="@(DisplayedCvScanStatus ?? string.Empty)">
                                        This CV could not be security checked and cannot be opened. Upload it again.
                                    </div>
                                }
                            }
                            else if (string.Equals(DisplayedCvContentType, "application/pdf", StringComparison.OrdinalIgnoreCase))
                            {
                                <object data="@CvProxyUrl" type="application/pdf" class="review-cv__viewer">
                                    <p>Your browser can't display this PDF inline. <a href="@CvProxyUrl" target="_blank" rel="noopener">Download it to view.</a></p>
                                </object>
                            }
                            else
                            {
                                <p>This file type can't be previewed. <a href="@CvProxyUrl" target="_blank" rel="noopener">Download it to view.</a></p>
                            }
                        }
                        else
                        {
                            <p class="text-muted">No CV has been uploaded for this candidate.</p>
                        }

                        @if (!string.IsNullOrWhiteSpace(_legacyResumeUrl))
                        {
                            <p class="mt-3" data-testid="review-cv-legacy-link">
                                <a href="@_legacyResumeUrl" target="_blank" rel="noopener">Legacy CV link</a>
                                <span class="text-muted small"> (legacy link recorded on the candidate record)</span>
                            </p>
                        }

                        @if (_app.WithdrawnAt is null)
                        {
                            @* Internal recruitment Ticket 2: application-scoped CV actions. Uploading adds the file
                               to the candidate's CV history AND records it as this application's submitted CV;
                               other applications keep their own CV. *@
                            <div class="border-top pt-3 mt-3" data-testid="review-cv-application-actions">
                                <h6>@(HasSubmittedCv ? "Replace CV for this application" : "Upload CV for this application")</h6>
                                <InputFile @key="_fileInputKey" class="form-control" OnChange="OnFileSelected"
                                           accept=".pdf,.doc,.docx" data-testid="review-cv-replace-file-input" />
                                <div class="form-text">
                                    The file is added to the candidate's CV history and recorded as the CV for this
                                    application only. Other applications keep their own CV. PDF, DOC or DOCX, up to 20 MB.
                                </div>
                                <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                                    <SfButton IsPrimary="true" Disabled="@(_busy || _selectedFile is null)" OnClick="ReplaceApplicationCvAsync"
                                              data-testid="review-cv-replace-submit">
                                        @(HasSubmittedCv ? "Replace CV" : "Upload CV")
                                    </SfButton>
                                    @if (CanUseCurrentCandidateCv)
                                    {
                                        <SfButton Disabled="@_busy" OnClick="UseCurrentCandidateCvAsync" data-testid="review-cv-use-current">
                                            Use candidate's current CV for this application
                                        </SfButton>
                                    }
                                </div>
                                <div class="mt-2">
                                    <a href="@ManageCandidateCvsUrl" data-testid="review-cv-manage-candidate-cvs">Manage candidate CVs</a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<SfDialog Width="420px" IsModal="true" @bind-Visible="_showRejectDialog" Header="Reject Candidate" CssClass="review-cv-reject-dialog">
    <DialogTemplates>
        <Content>
            <label class="form-label">Reason (optional)</label>
            <div data-testid="review-cv-reject-reason">
                <HrTextBox @bind-Value="_rejectionReason" Multiline="true" Rows="3" />
            </div>
            @if (_dialogError is not null)
            {
                <div class="alert alert-danger py-2 mt-2">@_dialogError</div>
            }
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Reject" IsPrimary="true" OnClick="ConfirmRejectAsync" />
        <DialogButton Content="Cancel" OnClick="@(() => _showRejectDialog = false)" />
    </DialogButtons>
</SfDialog>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid VacancyId { get; set; }
    [Parameter] public Guid ApplicationId { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    [Parameter]
    public string? ReturnUrl { get; set; }

    private bool _loading = true;
    private bool _busy;
    private GetApplicationResponse? _app;
    private string? _vacancyTitle;
    private string? _legacyResumeUrl;
    private string _notes = string.Empty;
    private string? _globalError;
    private string? _success;

    private bool _showRejectDialog;
    private string? _rejectionReason;
    private string? _dialogError;

    private IBrowserFile? _selectedFile;
    private int _fileInputKey;

    private bool HasSubmittedCv => _app?.CvDocumentId is not null;

    // Offered only when the candidate has a current CV that isn't already this application's CV.
    private bool CanUseCurrentCandidateCv => _app?.CurrentCandidateCvDocumentId is Guid currentId
        && currentId != _app.CvDocumentId;

    // CandidateDetail's Close honours returnUrl, so this brings the user back to this review page.
    private string ManageCandidateCvsUrl => _app is null
        ? string.Empty
        : $"/companies/{CompanyId}/candidates/{_app.CandidateId}?returnUrl={Uri.EscapeDataString("/" + Navigation.ToBaseRelativePath(Navigation.Uri))}";

    private string BackTarget => string.IsNullOrWhiteSpace(ReturnUrl)
        ? $"/companies/{CompanyId}/vacancies/{VacancyId}"
        : (ReturnUrl.StartsWith('/') ? ReturnUrl : "/" + ReturnUrl);

    // Internal recruitment Ticket 1: prefer the CV submitted with this application; fall back to the
    // candidate's current CV only when none was captured (labelled as such in the markup).
    private Guid? DisplayedCvDocumentId => _app?.CvDocumentId ?? _app?.CurrentCandidateCvDocumentId;

    private string? DisplayedCvContentType => _app?.CvDocumentId is not null
        ? _app.CvContentType
        : _app?.CurrentCandidateCvContentType;

    private string CvPanelTitle => _app?.CvDocumentId is not null
        ? "Submitted CV"
        : _app?.CurrentCandidateCvDocumentId is not null ? "Candidate's current CV" : "CV";

    // Scan state of whichever CV is displayed (submitted, else current). Only "Clean" is viewable.
    private string? DisplayedCvScanStatus => _app?.CvDocumentId is not null
        ? _app.CvScanStatus
        : _app?.CurrentCandidateCvScanStatus;

    private bool IsDisplayedCvClean => CandidateDocumentScanStatuses.IsClean(DisplayedCvScanStatus);

    private string CvProxyUrl => _app is not null && DisplayedCvDocumentId is Guid docId
        ? CandidateService.GetCandidateDocumentProxyUrl(CompanyId, _app.CandidateId, docId)
        : string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (!AppSession.GuardAccess(Navigation, Session.CanManageRecruitment))
            return;

        await LoadAsync();
    }

    private async Task LoadAsync(bool showLoading = true)
    {
        if (showLoading) _loading = true;

        _app = await ApplicationService.GetApplicationAsync(CompanyId, VacancyId, ApplicationId);
        if (_app is not null)
        {
            _notes = _app.CvReviewNotes ?? string.Empty;

            var vacancy = await VacancyService.GetVacancyAsync(CompanyId, VacancyId);
            _vacancyTitle = vacancy?.EffectiveTitle ?? vacancy?.PositionProfileTitle;

            // Ticket 2: always load the candidate — the legacy link is shown whether or not a document CV exists.
            var candidate = await CandidateService.GetCandidateAsync(CompanyId, _app.CandidateId);
            _legacyResumeUrl = candidate?.ResumeUrl;
        }

        _loading = false;
    }

    private void OnFileSelected(InputFileChangeEventArgs e) => _selectedFile = e.File;

    private async Task SaveNotesAsync()
    {
        _busy = true;
        _globalError = null;
        _success = null;

        var (result, error) = await ApplicationService.SaveCvReviewNotesAsync(CompanyId, VacancyId, ApplicationId, _notes);
        _busy = false;

        if (error is not null)
        {
            _globalError = error;
            return;
        }

        _success = "CV review notes saved.";
        _app = await ApplicationService.GetApplicationAsync(CompanyId, VacancyId, ApplicationId);
        if (_app is not null) _notes = _app.CvReviewNotes ?? string.Empty;
    }

    private async Task MoveForwardAsync()
    {
        _busy = true;
        _globalError = null;
        _success = null;

        var (result, error) = await ApplicationService.MoveApplicationForwardAsync(CompanyId, VacancyId, ApplicationId, _notes);
        _busy = false;

        if (error is not null)
        {
            _globalError = error;
            return;
        }

        Navigation.NavigateTo(BackTarget);
    }

    private async Task ConfirmRejectAsync()
    {
        _dialogError = null;
        _busy = true;

        var (result, error) = await ApplicationService.RejectCandidateAsync(
            CompanyId, VacancyId, ApplicationId, _rejectionReason);
        _busy = false;

        if (error is not null)
        {
            _dialogError = error;
            return;
        }

        _showRejectDialog = false;
        Navigation.NavigateTo(BackTarget);
    }

    // Internal recruitment Ticket 2: upload a CV to the candidate's history, then record it as THIS
    // application's submitted CV. The uploaded document is never deleted, even if step 2 fails.
    private async Task ReplaceApplicationCvAsync()
    {
        if (_selectedFile is null || _app is null || _busy) return;

        _busy = true;
        _globalError = null;
        _success = null;

        var file = _selectedFile;
        var hadSubmittedCv = HasSubmittedCv;
        var expectedVersion = _app.Version;

        var (newDoc, uploadError) = await CandidateService.UploadCandidateDocumentAsync(
            CompanyId, _app.CandidateId, file.Name, "Cv", file);

        ResetFileInput();

        if (newDoc is null)
        {
            _busy = false;
            _globalError = uploadError ?? "Upload failed.";
            return;
        }

        var (_, attachError) = await ApplicationService.SetApplicationCvAsync(
            CompanyId, VacancyId, ApplicationId, newDoc.Id, expectedVersion);

        if (attachError is not null)
        {
            _globalError = $"The new CV \"{file.Name}\" was uploaded and is now the candidate's current CV, but it could not be recorded against this application: {attachError} Reload the page and use \"Use candidate's current CV for this application\" to try again.";
        }
        else
        {
            _success = hadSubmittedCv ? "CV replaced for this application." : "CV uploaded for this application.";
        }

        // Reload either way so the page reflects the true state (new current CV, version, etc.).
        await ReloadApplicationAsync();
        _busy = false;
    }

    private async Task UseCurrentCandidateCvAsync()
    {
        if (_app?.CurrentCandidateCvDocumentId is not Guid currentCvId || _busy) return;

        _busy = true;
        _globalError = null;
        _success = null;

        var (_, error) = await ApplicationService.SetApplicationCvAsync(
            CompanyId, VacancyId, ApplicationId, currentCvId, _app.Version);

        if (error is not null)
        {
            _busy = false;
            _globalError = error;
            return;
        }

        _success = "The candidate's current CV is now recorded for this application.";
        await ReloadApplicationAsync();
        _busy = false;
    }

    // Reloads the page data without discarding unsaved review notes typed into the notes box.
    private async Task ReloadApplicationAsync()
    {
        var notes = _notes;
        await LoadAsync(showLoading: false);
        _notes = notes;
    }

    // "Check again" on the pending-scan alert: re-fetch the application to pick up the latest scan state.
    private async Task CheckScanAgainAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await ReloadApplicationAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void ResetFileInput()
    {
        _selectedFile = null;
        _fileInputKey++;
    }

    private void Close() => Navigation.NavigateTo(BackTarget);
}
