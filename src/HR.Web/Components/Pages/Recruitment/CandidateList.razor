@page "/companies/{CompanyId:guid}/candidates"
@rendermode InteractiveServer
@inherits SearchPageBase<CandidateListItemModel>
@inject CandidateService CandidateService
@inject AppSession Session

<PageTitle>Candidates</PageTitle>

<div class="container-fluid py-4">
    <a href="/dashboard/recruitment" class="text-decoration-none text-muted small">← Recruitment Dashboard</a>
    <h1 class="mb-1">Candidates</h1>
    <p class="text-muted mb-3">Manage candidates across all your open vacancies.</p>

    @if (IsLoading)
    {
        <HrLoadingIndicator Label="Loading candidates…" />
    }
    else if (Error is not null)
    {
        <div class="alert alert-danger">@Error</div>
    }
    else
    {
        @if (ActionError is not null)
        {
            <div class="alert alert-danger alert-dismissible">
                @ActionError
                <button type="button" class="btn-close" @onclick="ClearActionError"></button>
            </div>
        }

        <HrGrid @ref="Grid"
                TValue="CandidateListItemModel"
                DataSource="@Items"
                Toolbar="@GridToolbar"
                AllowFiltering="true">
            <GridEvents TValue="CandidateListItemModel" OnToolbarClick="OnToolbarClick"
                        RowSelected="OnRowSelected" RowDeselected="OnRowDeselected" />
            <GridPageSettings PageSize="20" />
            <GridColumns>
                <GridColumn HeaderText="Name" Width="220">
                    <Template>
                        @{
                            var row = (context as CandidateListItemModel)!;
                            <a href="/companies/@CompanyId/candidates/@row.Id">@row.FirstName @row.LastName</a>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(CandidateListItemModel.Email)" HeaderText="Email" Width="220" />
                <GridColumn Field="@nameof(CandidateListItemModel.Phone)" HeaderText="Phone" Width="160" />
                <GridColumn Field="@nameof(CandidateListItemModel.CreatedAt)" HeaderText="Added" Width="140" Format="d" />
            </GridColumns>
        </HrGrid>
    }
</div>

@code {
    protected override Task OnBeforeLoadAsync()
    {
        if (!Session.IsRecruiter)
            Navigation.NavigateTo(Session.MyProfileUrl, replace: true);
        return Task.CompletedTask;
    }

    protected override async Task<IReadOnlyList<CandidateListItemModel>?> FetchItemsAsync(string? search)
    {
        var result = await CandidateService.ListCandidatesAsync(CompanyId, search, pageSize: 100);
        return result?.Items;
    }

    protected override string LoadErrorMessage => "Failed to load candidates.";

    protected override string? GetAddUrl() => $"/companies/{CompanyId}/candidates/new";
    protected override string? GetEditUrl(CandidateListItemModel item) => $"/companies/{CompanyId}/candidates/{item.Id}";
    protected override string? GetViewUrl(CandidateListItemModel item) => $"/companies/{CompanyId}/candidates/{item.Id}/view";
}
