@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Syncfusion.Blazor.Data
@inject ApplicationService ApplicationService
@inject CompanyService CompanyService
@inject EmployeeService EmployeeService
@inject EmployeeDirectoryService EmployeeDirectoryService
@inject EmploymentTypeService EmploymentTypeService
@inject VacancyService VacancyService

<SfDialog Width="min(900px, calc(100vw - 2rem))" IsModal="true" @bind-Visible="_visible" Header="Hire Candidate" CssClass="hire-candidate-dialog">
    <DialogTemplates>
        <Content>
            <EditForm EditContext="_editContext" class="hire-form">
                <DataAnnotationsValidator />
                @if (_offerAccepted)
                {
                    <div class="alert alert-info py-2" role="status" data-testid="hire-offer-accepted-context">
                        Offer accepted: @FormatOfferedSalary(_offeredSalary, _offeredSalaryFrequency) – will seed first compensation record.
                    </div>
                }
                @if (_offerBlockedMessage is not null)
                {
                    <div class="alert alert-warning py-2" role="alert" data-testid="hire-offer-blocked">@_offerBlockedMessage</div>
                }
                @if (_error is not null)
                {
                    <div class="alert alert-danger py-2 hire-error" role="alert" aria-live="assertive">@_error</div>
                }

                <section class="card hire-section" aria-labelledby="hire-personal-heading">
                    <div class="card-header">
                        <h5 id="hire-personal-heading" class="mb-0">Personal Information</h5>
                    </div>
                    <div class="card-body">
                        <p class="hire-section-description">The candidate's core employee record information.</p>
                        <div class="row g-3">
                        <div class="col-md-6">
                            <HrDateField TValue="DateOnly?" Label="Start Date" Required="@(!_startDateOptional)" Id="hire-start-date"
                                         @bind-Value="_model.StartDate"
                                         HtmlAttributes="@(new Dictionary<string, object> { ["data-testid"] = "hire-start-date" })"
                                         HelpText="@(_startDateOptional ? "Leave blank to use the accepted offer's proposed start date." : null)" />
                        </div>
                        <div class="col-md-6">
                            <HrDateField TValue="DateOnly?" Label="Date of Birth" Required="true" Id="hire-date-of-birth"
                                         @bind-Value="_model.DateOfBirth" Format="dd/MM/yyyy" />
                        </div>
                        <div class="col-md-6">
                            <HrDropDownField TValue="string" TItem="NationalityListItem" Label="Nationality" Required="true" Id="hire-nationality"
                                             DataSource="@_nationalities" @bind-Value="_model.Nationality"
                                             ValueField="Name" TextField="Name" Placeholder="Select nationality" />
                        </div>
                        <div class="col-md-6">
                            <label id="hire-gender-label" for="hire-gender" class="form-label">Gender <span class="text-danger">*</span></label>
                            <SfDropDownList TValue="string" TItem="string" DataSource="@_genderOptions" @bind-Value="_model.Gender" Placeholder="Select gender"
                                            HtmlAttributes="@Aria("hire-gender", nameof(HireCandidateFormModel.Gender), "Gender", required: true)" />
                            <div id="hire-gender-error" role="alert"><ValidationMessage For="@(() => _model.Gender)" /></div>
                            @if (_model.Gender == "Other")
                            {
                                <div class="mt-2">
                                    <HrTextField Label="Please specify gender" Id="hire-gender-other"
                                                 @bind-Value="_model.GenderOther" Placeholder="Please specify" />
                                </div>
                            }
                        </div>
                        </div>
                    </div>
                </section>

                <section class="card hire-section" aria-labelledby="hire-employment-heading">
                    <div class="card-header">
                        <h5 id="hire-employment-heading" class="mb-0">Employment Details</h5>
                    </div>
                    <div class="card-body">
                        <p class="hire-section-description">Role details come from the vacancy. Review them before creating the employee.</p>
                        <div class="row g-3">
                        @if (_employeeNumberMode == EmployeeNumberMode.Automatic)
                        {
                            <div class="col-md-6">
                                <span class="form-label d-block">Employee Number</span>
                                <div class="hire-derived-value">Assigned automatically</div>
                            </div>
                        }
                        else
                        {
                            <div class="col-md-6">
                                <HrTextField Label="Employee Number" Required="true" Id="hire-employee-number"
                                             @bind-Value="_model.EmployeeNumber" Placeholder="e.g. EMP-001" />
                            </div>
                        }
                        <div class="col-md-6">
                            <span id="hire-derived-employment-type-label" class="form-label d-block">Employment Type</span>
                            @if (_vacancyEmploymentTypeId is null)
                            {
                                <div class="hire-derived-value hire-derived-value--warning" role="alert" aria-labelledby="hire-derived-employment-type-label" data-testid="hire-employment-type-required">Employment type required</div>
                                <div id="hire-derived-employment-type-help" class="form-text">Set an employment type on the vacancy before hiring.</div>
                            }
                            else
                            {
                                <div class="hire-derived-value" role="group" aria-labelledby="hire-derived-employment-type-label" aria-describedby="hire-derived-employment-type-help" data-testid="hire-derived-employment-type">@_derivedEmploymentTypeName</div>
                                <div id="hire-derived-employment-type-help" class="form-text">From the vacancy</div>
                            }
                        </div>
                        <div class="col-md-6">
                            <span id="hire-derived-position-profile-label" class="form-label d-block">Position Profile</span>
                            <div class="hire-derived-value" role="group" aria-labelledby="hire-derived-position-profile-label" aria-describedby="hire-derived-position-profile-help" data-testid="hire-derived-position-profile">@_derivedPositionProfileName</div>
                            <div id="hire-derived-position-profile-help" class="form-text">Includes the assigned department</div>
                        </div>
                        <div class="col-md-6">
                            <span id="hire-derived-location-label" class="form-label d-block">Location</span>
                            <div class="hire-derived-value" role="group" aria-labelledby="hire-derived-location-label" aria-describedby="hire-derived-location-help" data-testid="hire-derived-location">@_derivedLocationName</div>
                            <div id="hire-derived-location-help" class="form-text">From the position profile</div>
                        </div>
                        <div class="col-md-6">
                            <label id="hire-manager-label" for="hire-manager" class="form-label">Manager</label>
                            <SfDropDownList @ref="_managerDropdown" TValue="Guid?" TItem="ManagerOption"
                                            DataSource="@_managerOptions" @bind-Value="_model.ManagerId" Placeholder="None"
                                            AllowFiltering="true"
                                            HtmlAttributes="@Aria("hire-manager", nameof(HireCandidateFormModel.ManagerId), "Manager")">
                                <DropDownListFieldSettings Value="Id" Text="Name" />
                                <DropDownListEvents TValue="Guid?" TItem="ManagerOption" Filtering="OnHireManagerFilteringAsync" />
                            </SfDropDownList>
                            <div id="hire-manager-help" class="form-text" data-testid="hire-manager-help">@_managerHelpText</div>
                        </div>
                        </div>
                    </div>
                </section>

                <section class="card hire-section hire-section--address" aria-labelledby="hire-contact-heading">
                    <div class="card-header">
                        <h5 id="hire-contact-heading" class="mb-0">Contact Details</h5>
                    </div>
                    <div class="card-body">
                        <p class="hire-section-description">Home address required for the new employee's personal record.</p>
                        <div class="row g-3">
                        <div class="col-md-6">
                            <HrTextField Label="Address Line 1" Required="true" Id="hire-address-line-1" Autocomplete="address-line1"
                                         @bind-Value="_model.AddressLine1" Placeholder="Street address" />
                        </div>
                        <div class="col-md-6">
                            <HrTextField Label="Address Line 2" Id="hire-address-line-2" Autocomplete="address-line2"
                                         @bind-Value="_model.AddressLine2" Placeholder="Apartment, suite, etc." />
                        </div>
                        <div class="col-md-5">
                            <HrTextField Label="City" Required="true" Id="hire-city" Autocomplete="address-level2"
                                         @bind-Value="_model.City" Placeholder="e.g. London" />
                        </div>
                        <div class="col-md-4">
                            <HrTextField Label="County / State" Id="hire-county" Autocomplete="address-level1"
                                         @bind-Value="_model.County" Placeholder="e.g. Greater London" />
                        </div>
                        <div class="col-md-3">
                            <HrTextField Label="Post Code" Required="true" Id="hire-post-code" Autocomplete="postal-code"
                                         @bind-Value="_model.PostCode" Placeholder="e.g. SW1A 1AA" />
                        </div>
                        </div>
                    </div>
                </section>
            </EditForm>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="@(_isSubmitting ? "Hiring…" : "Hire employee")" IsPrimary="true" Disabled="@_isSubmitting" OnClick="ConfirmAsync" />
        <DialogButton Content="Cancel" Disabled="@_isSubmitting" OnClick="() => _visible = false" />
    </DialogButtons>
</SfDialog>

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter, EditorRequired] public Guid VacancyId { get; set; }
    [Parameter] public EventCallback<Guid> OnHired { get; set; }

    private static readonly string[] _genderOptions = ["Male", "Female", "Non-binary", "Prefer not to say", "Other"];

    private bool _visible;
    private Guid _applicationId;
    private string? _error;
    private List<NationalityListItem> _nationalities = [];
    private Guid? _vacancyEmploymentTypeId;
    private string _derivedEmploymentTypeName = string.Empty;
    private Guid _hiringManagerId;
    private string _managerHelpText = string.Empty;
    private readonly HireCandidateFormModel _model = new();
    private EditContext _editContext = default!;
    private EmployeeNumberMode _employeeNumberMode = EmployeeNumberMode.Manual;
    private string _derivedLocationName = string.Empty;
    private string _derivedPositionProfileName = string.Empty;
    private SfDropDownList<Guid?, ManagerOption> _managerDropdown = default!;
    private List<ManagerOption> _managerOptions = [];
    private bool _offerAccepted;
    private bool _startDateOptional;
    private string? _offerBlockedMessage;
    private decimal? _offeredSalary;
    private string? _offeredSalaryFrequency;
    private bool _isSubmitting;

    private sealed record ManagerOption(Guid Id, string Name);

    protected override void OnInitialized() => _editContext = new EditContext(_model);

    public async Task OpenAsync(Guid applicationId, string? offerResponseStatus, decimal? offeredSalary, DateOnly? offeredStartDate)
    {
        _error = null;
        _isSubmitting = false;
        _applicationId = applicationId;

        _offerAccepted = offerResponseStatus == "Accepted";
        _offeredSalary = offeredSalary;
        _offeredSalaryFrequency = "Annual";
        _offerBlockedMessage = offerResponseStatus switch
        {
            "Declined" => "The candidate declined the offer — record a new offer before hiring.",
            "Withdrawn" => "The offer was withdrawn — record a new offer before hiring.",
            _ => null,
        };
        _startDateOptional = _offerAccepted && offeredStartDate is not null;
        _model.StartDateRequired = !_startDateOptional;

        _model.StartDate = offeredStartDate ?? DateOnly.FromDateTime(DateTime.Today);
        _model.DateOfBirth = null;
        _model.Nationality = null;
        _model.Gender = null;
        _model.GenderOther = null;
        _model.EmployeeNumber = null;
        _model.ManagerId = Guid.Empty;
        _vacancyEmploymentTypeId = null;
        _derivedEmploymentTypeName = string.Empty;
        _hiringManagerId = Guid.Empty;
        _managerHelpText = string.Empty;
        _model.AddressLine1 = null;
        _model.AddressLine2 = null;
        _model.City = null;
        _model.County = null;
        _model.PostCode = null;
        _derivedLocationName = string.Empty;
        _derivedPositionProfileName = string.Empty;

        if (_nationalities.Count == 0)
        {
            var result = await EmployeeService.ListNationalitiesAsync();
            _nationalities = result?.Items.ToList() ?? [];
        }

        var hrSettings = await CompanyService.GetHrSettingsAsync(CompanyId);
        _employeeNumberMode = hrSettings?.EmployeeNumberMode ?? EmployeeNumberMode.Manual;
        _model.EmployeeNumberRequired = _employeeNumberMode != EmployeeNumberMode.Automatic;
        _editContext = new EditContext(_model);

        var vacancyTask = VacancyService.GetVacancyAsync(CompanyId, VacancyId);
        var employmentTypeTask = EmploymentTypeService.ListEmploymentTypesAsync(CompanyId);
        var managerTask = EmployeeService.ListSelectableEmployeesAsync(CompanyId, pageSize: 50);

        await Task.WhenAll(vacancyTask, employmentTypeTask, managerTask);

        var vacancy = await vacancyTask;
        _derivedPositionProfileName = vacancy?.PositionProfileTitle ?? vacancy?.EffectiveTitle ?? "(unknown)";
        _derivedLocationName = vacancy?.EffectiveLocation ?? "(none set)";

        _vacancyEmploymentTypeId = vacancy?.EmploymentTypeId;
        if (_vacancyEmploymentTypeId is { } employmentTypeId)
        {
            var employmentTypes = (await employmentTypeTask)?.Items ?? [];
            _derivedEmploymentTypeName = employmentTypes.FirstOrDefault(t => t.Id == employmentTypeId)?.Name ?? "(unknown)";
        }

        _managerOptions = ToManagerOptions((await managerTask)?.Items);
        await PreselectHiringManagerAsync(vacancy?.HiringManagerId);

        _visible = true;
        StateHasChanged();
    }

    private async Task PreselectHiringManagerAsync(Guid? hiringManagerId)
    {
        if (hiringManagerId is not { } id || id == Guid.Empty)
        {
            _managerHelpText = "The vacancy has no hiring manager. Choose a manager or leave as No Manager.";
            return;
        }

        _hiringManagerId = id;

        var option = _managerOptions.FirstOrDefault(m => m.Id == id);
        if (option is null)
        {
            var hiringManager = await EmployeeDirectoryService.GetAsync(CompanyId, id);
            if (hiringManager is not null)
            {
                option = new ManagerOption(hiringManager.Id, hiringManager.DisplayName);
                _managerOptions = _managerOptions.Append(option).ToList();
            }
        }

        if (option is null)
        {
            _managerHelpText = "The vacancy's hiring manager is not an eligible manager. Choose a manager or leave as No Manager.";
            return;
        }

        _model.ManagerId = option.Id;
        _managerHelpText = $"Defaults to the vacancy's hiring manager ({option.Name}). Choose another manager or No Manager to override.";
    }

    private static List<ManagerOption> ToManagerOptions(IEnumerable<EmployeeListItemModel>? items) =>
        (items ?? [])
            .Where(e => e.Status != "FormerEmployee")
            .Select(e => new ManagerOption(e.Id, e.FullName))
            .OrderBy(e => e.Name)
            .Prepend(new ManagerOption(Guid.Empty, "No Manager"))
            .ToList();

    private async Task OnHireManagerFilteringAsync(Syncfusion.Blazor.DropDowns.FilteringEventArgs args)
    {
        args.PreventDefaultAction = true;
        var result = await EmployeeService.ListSelectableEmployeesAsync(CompanyId, search: args.Text, pageSize: 50);
        _managerOptions = ToManagerOptions(result?.Items);
        await _managerDropdown.FilterAsync(_managerOptions, new Query());
    }

    private async Task ConfirmAsync()
    {
        if (_isSubmitting)
            return;

        var employeeNumberRequired = _employeeNumberMode != EmployeeNumberMode.Automatic;

        if (_offerBlockedMessage is not null)
        {
            _error = _offerBlockedMessage;
            return;
        }

        if (_vacancyEmploymentTypeId is null)
        {
            _error = "Employment type required. Set an employment type on the vacancy before hiring.";
            return;
        }

        if (!_editContext.Validate())
        {
            _error = _editContext.GetValidationMessages().FirstOrDefault()
                ?? "Please correct the highlighted fields below.";
            return;
        }

        var selectedManagerId = _model.ManagerId ?? Guid.Empty;

        var request = new HireCandidateRequest(
            CompanyId, VacancyId, _applicationId,
            _model.StartDate, _model.DateOfBirth!.Value, _model.Nationality!, _model.Gender!,
            FormText.Optional(_model.GenderOther),
            employeeNumberRequired ? FormText.Required(_model.EmployeeNumber!) : string.Empty,
            OverrideManager: selectedManagerId != _hiringManagerId,
            ManagerId: selectedManagerId == Guid.Empty ? null : selectedManagerId,
            AddressLine1: FormText.Required(_model.AddressLine1!),
            AddressLine2: FormText.Optional(_model.AddressLine2),
            City: FormText.Required(_model.City!),
            County: FormText.Optional(_model.County),
            PostCode: FormText.Required(_model.PostCode!));

        _isSubmitting = true;
        _error = null;
        try
        {
            var (result, error) = await ApplicationService.HireCandidateAsync(CompanyId, VacancyId, _applicationId, request);

            if (result is null)
            {
                _error = error ?? "The employee could not be created. Please try again.";
                return;
            }

            _visible = false;
            await OnHired.InvokeAsync(result.EmployeeId);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private Dictionary<string, object> Aria(string id, string property, string label, bool required = false)
    {
        var attributes = FieldAria.Build(_editContext, _model, id, property, required);
        attributes["aria-label"] = label;
        attributes["aria-labelledby"] = $"{id}-label";
        return attributes;
    }

    private static string FormatOfferedSalary(decimal? salary, string? frequency)
    {
        if (salary is null) return "salary not recorded";
        var suffix = frequency switch
        {
            "Annual" => " /year",
            "Hourly" => " /hour",
            "Daily" => " /day",
            _ => "",
        };
        return salary.Value.ToString("C0") + suffix;
    }

    public sealed class HireCandidateFormModel : IValidatableObject
    {
        public DateOnly? StartDate { get; set; }

        public bool StartDateRequired { get; set; } = true;

        [Required(ErrorMessage = "Please select a date of birth.")]
        public DateOnly? DateOfBirth { get; set; }

        [Required(ErrorMessage = "Please select a nationality.")]
        public string? Nationality { get; set; }

        [Required(ErrorMessage = "Please select a gender.")]
        public string? Gender { get; set; }

        [MaxLength(100)]
        public string? GenderOther { get; set; }

        [MaxLength(50)]
        public string? EmployeeNumber { get; set; }

        public Guid? ManagerId { get; set; }

        [Required(ErrorMessage = "Please enter address line 1.")]
        [MaxLength(200)] public string? AddressLine1 { get; set; }
        [MaxLength(200)] public string? AddressLine2 { get; set; }
        [Required(ErrorMessage = "Please enter a city.")]
        [MaxLength(100)] public string? City { get; set; }
        [MaxLength(100)] public string? County { get; set; }
        [Required(ErrorMessage = "Please enter a post code.")]
        [MaxLength(20)] public string? PostCode { get; set; }

        public bool EmployeeNumberRequired { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (EmployeeNumberRequired && string.IsNullOrWhiteSpace(EmployeeNumber))
                yield return new ValidationResult(
                    "Please enter an employee number.",
                    [nameof(EmployeeNumber)]);

            if (StartDateRequired && StartDate is null)
                yield return new ValidationResult(
                    "Please select a start date.",
                    [nameof(StartDate)]);
        }
    }
}
