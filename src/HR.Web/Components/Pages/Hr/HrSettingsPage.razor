@page "/companies/{Id:guid}/hr-settings"
@rendermode InteractiveServer
@inject CompanyService CompanyService
@inject AppSession Session
@inherits EditPageBase<HrSettingsEditModel>
@using HR.Infrastructure.Abstractions
@using HR.SharedKernel
@using HR.Modules.Companies.Contracts

<PageTitle>HR Settings</PageTitle>

<div class="container py-4 hr-settings-page">
    @if (IsLoading)
    {
        <HrLoadingIndicator />
    }
    else
    {
        <h1 class="mb-1">HR Settings</h1>
        <p class="text-muted mb-4">Manage HR policy settings for this company.</p>

        @if (!string.IsNullOrEmpty(GlobalError))
        {
            <div class="alert alert-danger">@GlobalError</div>
        }

        <EditForm EditContext="EditContext">
            <DataAnnotationsValidator />

            <SfTab @bind-SelectedItem="_activeTabIndex" OverflowMode="OverflowMode.Scrollable" CssClass="hr-settings-tabs">
                <TabItems>
                    <TabItem>
                        <ChildContent>
                            <TabHeader Text="Working & Leave" IconCss="@ErrorIconCss(0)" />
                        </ChildContent>
                        <ContentTemplate>
                            <div class="card mt-3">
                                <div class="card-body">
                                    <div class="row g-4">
                                        <div class="col-12">
                                            <label class="form-label fw-semibold">Working Week</label>
                                            <div class="d-flex flex-wrap gap-3 mt-1">
                                                @foreach (var day in AllDays)
                                                {
                                                    <SfCheckBox TChecked="bool" Label="@day"
                                                                Checked="@Model.WorkingWeek.Contains(day)"
                                                                CheckedChanged="@(e => ToggleDay(day, e))" />
                                                }
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">Hours Per Day</label>
                                            <SfNumericTextBox TValue="decimal" @bind-Value="Model.HoursPerDay"
                                                              ShowSpinButton="false"
                                                              Min="0.5m" Max="24m" Step="0.5m" />
                                            <ValidationMessage For="@(() => Model.HoursPerDay)" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">Leave Year Start Month</label>
                                            <SfDropDownList TValue="int" TItem="MonthItem"
                                                            @bind-Value="Model.LeaveYearStartMonth"
                                                            DataSource="@Months">
                                                <DropDownListFieldSettings Value="Number" Text="Name" />
                                            </SfDropDownList>
                                            <div class="form-text">The month each employee's annual leave allowance resets.</div>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">Default Holiday Allowance (days)</label>
                                            <SfNumericTextBox TValue="decimal" @bind-Value="Model.DefaultHolidayAllowance"
                                                              ShowSpinButton="false"
                                                              Min="0" Max="365" />
                                            <ValidationMessage For="@(() => Model.DefaultHolidayAllowance)" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">Probation Months</label>
                                            <SfNumericTextBox TValue="int" @bind-Value="Model.ProbationMonths"
                                                              ShowSpinButton="false"
                                                              Min="0" Max="24" />
                                            <ValidationMessage For="@(() => Model.ProbationMonths)" />
                                        </div>
                                        <div class="col-12">
                                            <SfCheckBox TChecked="bool" Label="Exclude public holidays from leave"
                                                        Checked="@Model.ExcludePublicHolidaysFromLeave"
                                                        CheckedChanged="@((bool v) => Model.ExcludePublicHolidaysFromLeave = v)" />
                                        </div>
                                        <div class="col-12">
                                            <SfCheckBox TChecked="bool" Label="Display salary to employees on their profile"
                                                        Checked="@Model.DisplaySalaryOnEmployeeProfile"
                                                        CheckedChanged="@((bool v) => Model.DisplaySalaryOnEmployeeProfile = v)" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </ContentTemplate>
                    </TabItem>

                    <TabItem>
                        <ChildContent>
                            <TabHeader Text="Sickness" IconCss="@ErrorIconCss(1)" />
                        </ChildContent>
                        <ContentTemplate>
                            <div class="card mt-3">
                                <div class="card-body">
                                    <div class="row g-4">
                                        <div class="col-12">
                                            <SfCheckBox TChecked="bool" Label="Exclude public holidays from sickness"
                                                        Checked="@Model.ExcludePublicHolidaysFromSickness"
                                                        CheckedChanged="@((bool v) => Model.ExcludePublicHolidaysFromSickness = v)" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Fit Note Required After (Days)</label>
                                            <SfNumericTextBox TValue="int" @bind-Value="Model.FitNoteRequiredAfterDays"
                                                              ShowSpinButton="false"
                                                              Min="1" />
                                            <ValidationMessage For="@(() => Model.FitNoteRequiredAfterDays)" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Return-to-Work Review Required After (Days)</label>
                                            <SfNumericTextBox TValue="int" @bind-Value="Model.ReturnToWorkRequiredAfterDays"
                                                              ShowSpinButton="false"
                                                              Min="1" />
                                            <ValidationMessage For="@(() => Model.ReturnToWorkRequiredAfterDays)" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </ContentTemplate>
                    </TabItem>

                    <TabItem>
                        <ChildContent>
                            <TabHeader Text="Documents" IconCss="@ErrorIconCss(2)" />
                        </ChildContent>
                        <ContentTemplate>
                            <div class="card mt-3">
                                <div class="card-body">
                                    <div class="row g-4">
                                        <div class="col-12">
                                            <label class="form-label">Default Acknowledgement Statement</label>
                                            <HrTextBox @bind-Value="Model.DefaultAcknowledgementStatement"
                                                       Placeholder="I confirm that I have read and understood this document."
                                                       Multiline="true"
                                                       Maxlength="2000" />
                                            <div class="form-text">
                                                Shown to employees by default when a shared document requires acknowledgement and no
                                                document-specific statement is set. Plain text only — line breaks are preserved but no
                                                formatting/markup.
                                            </div>
                                            <div class="text-muted small text-end">@(Model.DefaultAcknowledgementStatement?.Length ?? 0) / 2000</div>
                                            <ValidationMessage For="@(() => Model.DefaultAcknowledgementStatement)" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Acknowledgement Reminder Interval (days)</label>
                                            <SfNumericTextBox TValue="int" @bind-Value="Model.AcknowledgementReminderIntervalDays"
                                                              ShowSpinButton="false"
                                                              Min="1" />
                                            <ValidationMessage For="@(() => Model.AcknowledgementReminderIntervalDays)" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </ContentTemplate>
                    </TabItem>

                    <TabItem>
                        <ChildContent>
                            <TabHeader Text="Leaving Process" IconCss="@ErrorIconCss(3)" />
                        </ChildContent>
                        <ContentTemplate>
                            <div class="card mt-3">
                                <div class="card-body">
                                    <div class="row g-4">
                                        <div class="col-md-4">
                                            <label class="form-label">Default Notice Period <span class="text-danger">*</span></label>
                                            <SfDropDownList TValue="string" TItem="NoticePeriodPresetItem"
                                                            Value="_selectedNoticePeriodPreset"
                                                            ValueChanged="@OnNoticePeriodPresetChanged"
                                                            DataSource="@NoticePeriodPresets">
                                                <DropDownListFieldSettings Value="Value" Text="Label" />
                                            </SfDropDownList>
                                        </div>
                                        @if (_selectedNoticePeriodPreset == CustomPresetValue)
                                        {
                                            <div class="col-md-4">
                                                <label class="form-label">Unit <span class="text-danger">*</span></label>
                                                <SfDropDownList TValue="NoticePeriodUnit" TItem="NoticePeriodUnitOption"
                                                                @bind-Value="Model.NoticePeriodUnit"
                                                                DataSource="@NoticePeriodUnitOptions">
                                                    <DropDownListFieldSettings Value="Value" Text="Label" />
                                                </SfDropDownList>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Length</label>
                                                <SfNumericTextBox TValue="int" @bind-Value="Model.NoticePeriodLength"
                                                                  ShowSpinButton="false"
                                                                  Min="1" />
                                                <ValidationMessage For="@(() => Model.NoticePeriodLength)" />
                                            </div>
                                        }
                                        <div class="col-12">
                                            <SfCheckBox TChecked="bool" Label="Automatically disable system access on the employee's leaving date"
                                                        Checked="@Model.AutoDisableAccessOnLeavingDate"
                                                        CheckedChanged="@((bool v) => Model.AutoDisableAccessOnLeavingDate = v)" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </ContentTemplate>
                    </TabItem>

                    <TabItem>
                        <ChildContent>
                            <TabHeader Text="Employee Numbering" IconCss="@ErrorIconCss(4)" />
                        </ChildContent>
                        <ContentTemplate>
                            <div class="card mt-3">
                                <div class="card-body">
                                    <div class="row g-4">
                                        <div class="col-md-4">
                                            <label class="form-label">Numbering Mode</label>
                                            <SfDropDownList TValue="EmployeeNumberMode" TItem="EmployeeNumberModeOption"
                                                            @bind-Value="Model.EmployeeNumberMode"
                                                            DataSource="@EmployeeNumberModeOptions">
                                                <DropDownListFieldSettings Value="Value" Text="Label" />
                                            </SfDropDownList>
                                        </div>
                                        @if (Model.EmployeeNumberMode == EmployeeNumberMode.Automatic)
                                        {
                                            <div class="col-md-4">
                                                <label class="form-label">Prefix</label>
                                                <HrTextBox @bind-Value="Model.EmployeeNumberPrefix" Placeholder="Prefix (e.g. EMP-)" />
                                                <div class="form-text">
                                                    Changing the prefix only affects employee numbers assigned in the future —
                                                    existing employees' numbers are never changed retroactively.
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Next Number</label>
                                                <SfNumericTextBox TValue="int" @bind-Value="Model.NextEmployeeNumber"
                                                                  ShowSpinButton="false"
                                                                  Min="1" />
                                                <ValidationMessage For="@(() => Model.NextEmployeeNumber)" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Minimum Numeric Length</label>
                                                <SfNumericTextBox TValue="int" @bind-Value="Model.EmployeeNumberMinimumLength"
                                                                  ShowSpinButton="false"
                                                                  Min="1" Max="10" />
                                                <ValidationMessage For="@(() => Model.EmployeeNumberMinimumLength)" />
                                            </div>
                                            <div class="col-12">
                                                <p class="text-muted mb-0">Preview: <strong>@PreviewEmployeeNumber</strong></p>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </ContentTemplate>
                    </TabItem>

                    <TabItem>
                        <ChildContent>
                            <TabHeader Text="Asset Numbering" IconCss="@ErrorIconCss(5)" />
                        </ChildContent>
                        <ContentTemplate>
                            <div class="card mt-3">
                                <div class="card-body">
                                    <div class="row g-4">
                                        <div class="col-md-4">
                                            <label class="form-label">Numbering Mode</label>
                                            <SfDropDownList TValue="AssetNumberMode" TItem="AssetNumberModeOption"
                                                            @bind-Value="Model.AssetNumberMode"
                                                            DataSource="@AssetNumberModeOptions">
                                                <DropDownListFieldSettings Value="Value" Text="Label" />
                                            </SfDropDownList>
                                        </div>
                                        @if (Model.AssetNumberMode == AssetNumberMode.Automatic)
                                        {
                                            <div class="col-md-4">
                                                <label class="form-label">Prefix</label>
                                                <HrTextBox @bind-Value="Model.AssetNumberPrefix" Placeholder="Prefix (e.g. AST-)" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Next Number</label>
                                                <SfNumericTextBox TValue="int" @bind-Value="Model.NextAssetNumber"
                                                                  ShowSpinButton="false"
                                                                  Min="1" />
                                                <ValidationMessage For="@(() => Model.NextAssetNumber)" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Minimum Numeric Length</label>
                                                <SfNumericTextBox TValue="int" @bind-Value="Model.AssetNumberMinimumLength"
                                                                  ShowSpinButton="false"
                                                                  Min="1" Max="10" />
                                                <ValidationMessage For="@(() => Model.AssetNumberMinimumLength)" />
                                            </div>
                                            <div class="col-12">
                                                <p class="text-muted mb-0">Preview: <strong>@PreviewAssetNumber</strong></p>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </ContentTemplate>
                    </TabItem>
                </TabItems>
            </SfTab>
        </EditForm>

        @if (_showRenumberWarning)
        {
            <SfDialog IsModal="true" Width="440px" Visible="true" ShowCloseIcon="false">
                <DialogTemplates>
                    <Header>Renumber existing employees?</Header>
                    <Content>
                        Changing the employee number prefix or minimum length while in Automatic mode will
                        automatically renumber all existing employees to the new format. This cannot be undone.
                        Do you want to continue?
                    </Content>
                </DialogTemplates>
                <DialogButtons>
                    <DialogButton Content="Cancel" OnClick="CancelRenumberWarning" />
                    <DialogButton Content="Continue" IsPrimary="true" OnClick="ConfirmRenumberWarningAsync" />
                </DialogButtons>
            </SfDialog>
        }

        <div class="hr-settings-footer mt-4 d-flex gap-2 align-items-center">
            @if (!string.IsNullOrEmpty(SuccessMsg))
            {
                <div class="alert alert-success py-2 mb-0 d-flex align-items-center">@SuccessMsg</div>
            }
            <div class="ms-auto d-flex gap-2">
                <SfButton IsPrimary="true" Disabled="@Saving" OnClick="SaveClickedAsync">
                    @(Saving ? "Saving…" : "Save")
                </SfButton>
                <SfButton OnClick="RequestClose" Disabled="@Saving">Cancel</SfButton>
            </div>
        </div>
    }

    <NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges" />

    <UnsavedChangesDialog Visible="ShowUnsavedChangesDialog"
                          OnSaveAndClose="ConfirmSaveAndCloseAsync"
                          OnDiscard="DiscardChangesAndClose"
                          OnCancel="CancelCloseDialog" />
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    // Selected tab persists across a hard page refresh via this query param (see
    // SyncActiveTabFromQuery/OnAfterRenderAsync below) — 1-based in the URL for readability,
    // 0-based internally to match SfTab's SelectedItem index.
    [SupplyParameterFromQuery(Name = "tab")]
    [Parameter]
    public int? Tab { get; set; }

    private static readonly string[] AllDays = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];

    private static readonly List<MonthItem> Months = Enumerable.Range(1, 12)
        .Select(m => new MonthItem(m, System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)))
        .ToList();

    private const string CustomPresetValue = "custom";

    private static readonly List<NoticePeriodPresetItem> NoticePeriodPresets =
    [
        new("1w", "1 week", NoticePeriodUnit.Weeks, 1),
        new("2w", "2 weeks", NoticePeriodUnit.Weeks, 2),
        new("1m", "1 month", NoticePeriodUnit.Months, 1),
        new("2m", "2 months", NoticePeriodUnit.Months, 2),
        new("3m", "3 months", NoticePeriodUnit.Months, 3),
        new("6m", "6 months", NoticePeriodUnit.Months, 6),
        new(CustomPresetValue, "Custom duration", null, null),
    ];

    private static readonly List<NoticePeriodUnitOption> NoticePeriodUnitOptions =
    [
        new(NoticePeriodUnit.Weeks, "Weeks"),
        new(NoticePeriodUnit.Months, "Months"),
    ];

    private string _selectedNoticePeriodPreset = CustomPresetValue;

    private static readonly List<EmployeeNumberModeOption> EmployeeNumberModeOptions =
    [
        new(EmployeeNumberMode.Manual, "Manual"),
        new(EmployeeNumberMode.Automatic, "Automatic"),
    ];

    private string PreviewEmployeeNumber =>
        $"{Model.EmployeeNumberPrefix}{Model.NextEmployeeNumber.ToString().PadLeft(Model.EmployeeNumberMinimumLength, '0')}";

    private static readonly List<AssetNumberModeOption> AssetNumberModeOptions =
    [
        new(AssetNumberMode.Manual, "Manual"),
        new(AssetNumberMode.Automatic, "Automatic"),
    ];

    private string PreviewAssetNumber =>
        $"{Model.AssetNumberPrefix}{Model.NextAssetNumber.ToString().PadLeft(Model.AssetNumberMinimumLength, '0')}";

    // ── Tabs ─────────────────────────────────────────────────────────────────────────────────

    private int _activeTabIndex;

    // Guards against EditPageBase's OnParametersSetAsync re-running LoadAsync() (which would
    // overwrite in-progress edits with server data) every time we update the "?tab=" query
    // string ourselves after a tab switch. LoadAsync() should only ever run once per real page
    // visit — a fresh navigation to this route (including a hard refresh) — not on every
    // parameter set caused by our own replace-navigation below.
    private bool _initialised;

    // Maps each validated field to the tab it lives on, so the tab header can show an error
    // badge and a failed save can jump to the first tab containing an invalid field.
    private static readonly (int Tab, string Field)[] TabFieldMap =
    [
        (0, nameof(HrSettingsEditModel.HoursPerDay)),
        (0, nameof(HrSettingsEditModel.DefaultHolidayAllowance)),
        (0, nameof(HrSettingsEditModel.ProbationMonths)),
        (1, nameof(HrSettingsEditModel.FitNoteRequiredAfterDays)),
        (1, nameof(HrSettingsEditModel.ReturnToWorkRequiredAfterDays)),
        (2, nameof(HrSettingsEditModel.DefaultAcknowledgementStatement)),
        (2, nameof(HrSettingsEditModel.AcknowledgementReminderIntervalDays)),
        (3, nameof(HrSettingsEditModel.NoticePeriodLength)),
        (4, nameof(HrSettingsEditModel.NextEmployeeNumber)),
        (4, nameof(HrSettingsEditModel.EmployeeNumberMinimumLength)),
        (5, nameof(HrSettingsEditModel.NextAssetNumber)),
        (5, nameof(HrSettingsEditModel.AssetNumberMinimumLength)),
    ];

    private HashSet<int> _tabsWithErrors = [];

    private string? ErrorIconCss(int tabIndex) =>
        _tabsWithErrors.Contains(tabIndex) ? "fa-solid fa-circle-exclamation hr-settings-tab-error-icon" : null;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        EditContext.OnValidationStateChanged += (_, _) =>
        {
            RecomputeTabErrors();
            StateHasChanged();
        };
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_initialised)
        {
            SyncActiveTabFromQuery();
            return;
        }

        _initialised = true;
        await base.OnParametersSetAsync();
        SyncActiveTabFromQuery();
    }

    private void SyncActiveTabFromQuery()
    {
        if (Tab is >= 1 and <= 6)
            _activeTabIndex = Tab.Value - 1;

        _lastSyncedTabIndex = _activeTabIndex;
    }

    // Tracks the last tab index reflected in the URL, so OnAfterRenderAsync only pushes a new
    // "?tab=" query value when the user actually switches tabs (SfTab's @bind-SelectedItem),
    // not on every render.
    private int _lastSyncedTabIndex;

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (_activeTabIndex != _lastSyncedTabIndex)
        {
            _lastSyncedTabIndex = _activeTabIndex;
            var uri = Navigation.GetUriWithQueryParameter("tab", _activeTabIndex + 1);

            // This only updates the "?tab=" query string to reflect the already-active tab — not
            // a real navigation away from the page — so it must not trip the unsaved-changes
            // guard (which would otherwise pop the "unsaved changes" dialog every time the user
            // switches tabs while mid-edit).
            SuppressNextNavigationGuard();
            Navigation.NavigateTo(uri, replace: true);
        }

        return Task.CompletedTask;
    }

    private void RecomputeTabErrors()
    {
        _tabsWithErrors = TabFieldMap
            .Where(m => EditContext.GetValidationMessages(new FieldIdentifier(Model, m.Field)).Any())
            .Select(m => m.Tab)
            .ToHashSet();
    }

    private bool _showRenumberWarning;

    // True when the user has changed the Employee or Asset numbering FORMAT (prefix or minimum
    // length) while staying in Automatic mode — a Manual<->Automatic mode switch alone doesn't
    // count. The backend performs the actual renumber of existing records synchronously on save,
    // so this is purely a confirmation gate in front of that existing behaviour.
    private bool IsRenumberingFormatChange() =>
        (Model.EmployeeNumberMode == EmployeeNumberMode.Automatic
            && Model.EmployeeNumberOriginalMode == EmployeeNumberMode.Automatic
            && (Model.EmployeeNumberPrefix != Model.EmployeeNumberOriginalPrefix
                || Model.EmployeeNumberMinimumLength != Model.EmployeeNumberOriginalMinimumLength))
        || (Model.AssetNumberMode == AssetNumberMode.Automatic
            && Model.AssetNumberOriginalMode == AssetNumberMode.Automatic
            && (Model.AssetNumberPrefix != Model.AssetNumberOriginalPrefix
                || Model.AssetNumberMinimumLength != Model.AssetNumberOriginalMinimumLength));

    private async Task SaveClickedAsync()
    {
        if (IsRenumberingFormatChange())
        {
            _showRenumberWarning = true;
            return;
        }

        await SaveClickedCoreAsync();
    }

    private void CancelRenumberWarning() => _showRenumberWarning = false;

    private async Task ConfirmRenumberWarningAsync()
    {
        _showRenumberWarning = false;
        await SaveClickedCoreAsync();
    }

    private async Task SaveClickedCoreAsync()
    {
        await SaveAsync();

        // On failure, jump to the first tab (in tab order) containing an invalid field so the
        // user immediately sees the problem. If the failure was a server-side error with no
        // associated field (GlobalError set but no field-level messages), leave the tab as-is.
        if (GlobalError is not null && _tabsWithErrors.Count > 0)
            _activeTabIndex = _tabsWithErrors.Min();
    }

    protected override async Task LoadAsync()
    {
        // HR-policy settings are HR Administrator territory only, matching the "hr-settings:manage"
        // policy that guards the underlying save endpoint.
        await Session.InitialiseAsync();
        if (!Session.IsHrAdministrator)
        {
            Navigation.NavigateTo(Session.MyProfileUrl, replace: true);
            return;
        }

        var settings = await CompanyService.GetHrSettingsAsync(Id);
        if (settings is not null)
        {
            Model.WorkingWeek = Enum.GetValues<WorkingDays>()
                .Where(day => day != WorkingDays.None && ((WorkingDays)settings.WorkingDays).HasFlag(day))
                .Select(day => day.ToString())
                .ToHashSet();
            Model.HoursPerDay = settings.HoursPerDay;
            Model.LeaveYearStartMonth = settings.LeaveYearStartMonth;
            Model.DefaultHolidayAllowance = settings.DefaultHolidayAllowance;
            Model.ProbationMonths = settings.ProbationMonths;
            Model.ExcludePublicHolidaysFromLeave = settings.ExcludePublicHolidaysFromLeave;
            Model.ExcludePublicHolidaysFromSickness = settings.ExcludePublicHolidaysFromSickness;
            Model.DisplaySalaryOnEmployeeProfile = settings.DisplaySalaryOnEmployeeProfile;
            Model.FitNoteRequiredAfterDays = settings.FitNoteRequiredAfterDays;
            Model.ReturnToWorkRequiredAfterDays = settings.ReturnToWorkRequiredAfterDays;
            Model.DefaultAcknowledgementStatement = settings.DefaultAcknowledgementStatement;
            Model.AcknowledgementReminderIntervalDays = settings.AcknowledgementReminderIntervalDays;
            Model.NoticePeriodUnit = settings.NoticePeriodUnit;
            Model.NoticePeriodLength = settings.NoticePeriodLength;
            Model.AutoDisableAccessOnLeavingDate = settings.AutoDisableAccessOnLeavingDate;
            Model.EmployeeNumberMode = settings.EmployeeNumberMode;
            Model.EmployeeNumberPrefix = settings.EmployeeNumberPrefix;
            Model.NextEmployeeNumber = settings.NextEmployeeNumber;
            Model.EmployeeNumberMinimumLength = settings.EmployeeNumberMinimumLength;
            Model.AssetNumberMode = settings.AssetNumberMode;
            Model.AssetNumberPrefix = settings.AssetNumberPrefix;
            Model.NextAssetNumber = settings.NextAssetNumber;
            Model.AssetNumberMinimumLength = settings.AssetNumberMinimumLength;
            Model.AssetNumberOriginalMode = Model.AssetNumberMode;
            Model.AssetNumberOriginalPrefix = Model.AssetNumberPrefix;
            Model.AssetNumberOriginalMinimumLength = Model.AssetNumberMinimumLength;

            Model.EmployeeNumberOriginalMode = Model.EmployeeNumberMode;
            Model.EmployeeNumberOriginalPrefix = Model.EmployeeNumberPrefix;
            Model.EmployeeNumberOriginalMinimumLength = Model.EmployeeNumberMinimumLength;

            var matchedPreset = NoticePeriodPresets.FirstOrDefault(p =>
                p.Unit == settings.NoticePeriodUnit && p.Length == settings.NoticePeriodLength);
            _selectedNoticePeriodPreset = matchedPreset?.Value ?? CustomPresetValue;
        }
    }

    protected override async Task<string?> SaveCoreAsync()
    {
        var workingDays = Model.WorkingWeek
            .Aggregate(WorkingDays.None, (acc, day) =>
                Enum.TryParse<WorkingDays>(day, out var wd) ? acc | wd : acc);

        var request = new UpdateHrSettingsRequest(
            Id, workingDays, Model.HoursPerDay,
            Model.LeaveYearStartMonth, Model.DefaultHolidayAllowance,
            Model.ProbationMonths, Model.ExcludePublicHolidaysFromLeave,
            Model.ExcludePublicHolidaysFromSickness, Model.DisplaySalaryOnEmployeeProfile,
            Model.FitNoteRequiredAfterDays,
            Model.ReturnToWorkRequiredAfterDays,
            Model.DefaultAcknowledgementStatement,
            Model.AcknowledgementReminderIntervalDays,
            Model.NoticePeriodUnit,
            Model.NoticePeriodLength,
            Model.AutoDisableAccessOnLeavingDate,
            Model.EmployeeNumberMode,
            string.IsNullOrWhiteSpace(Model.EmployeeNumberPrefix) ? null : Model.EmployeeNumberPrefix.Trim(),
            Model.NextEmployeeNumber,
            Model.EmployeeNumberMinimumLength,
            Model.AssetNumberMode,
            string.IsNullOrWhiteSpace(Model.AssetNumberPrefix) ? null : Model.AssetNumberPrefix.Trim(),
            Model.NextAssetNumber,
            Model.AssetNumberMinimumLength);

        var result = await CompanyService.UpdateHrSettingsAsync(Id, request);
        return result is not null ? null : "Failed to save HR settings.";
    }

    // Save navigates to the HR Dashboard — this page is only ever reachable by an HR
    // Administrator (see the IsHrAdministrator guard above), so the target is unambiguous. Left as
    // EditPageBase's default OnSavedAsync (navigate to TargetListUrl via NavigateToList()) rather
    // than a raw Navigation.NavigateTo call here: ConfirmSaveAndCloseAsync (the "unsaved changes"
    // dialog's Save option) always issues its own follow-up NavigateToList() call after SaveAsync
    // succeeds, targeting ListUrl — bypassing that mechanism with a direct call risked two
    // stacked forceLoad navigations to two different URLs on that path (see the
    // _navigatedThisSave fix elsewhere in EditPageBase for the general form of this bug). Routing
    // both Save and Close to the dashboard keeps this page's navigation behaviour uniform and safe
    // regardless of which path triggered it.
    protected override string? ListUrl => "/dashboard/hr";

    private void ToggleDay(string day, bool isChecked)
    {
        if (isChecked) Model.WorkingWeek.Add(day);
        else Model.WorkingWeek.Remove(day);
    }

    private void OnNoticePeriodPresetChanged(string value)
    {
        _selectedNoticePeriodPreset = value;
        var preset = NoticePeriodPresets.FirstOrDefault(p => p.Value == value);
        if (preset is { Unit: not null, Length: not null })
        {
            Model.NoticePeriodUnit = preset.Unit.Value;
            Model.NoticePeriodLength = preset.Length.Value;
        }
    }

    private sealed record MonthItem(int Number, string Name);

    private sealed record NoticePeriodPresetItem(string Value, string Label, NoticePeriodUnit? Unit, int? Length);

    private sealed record NoticePeriodUnitOption(NoticePeriodUnit Value, string Label);

    private sealed record EmployeeNumberModeOption(EmployeeNumberMode Value, string Label);

    private sealed record AssetNumberModeOption(AssetNumberMode Value, string Label);
}
