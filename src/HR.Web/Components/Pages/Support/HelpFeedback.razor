@page "/companies/{CompanyId:guid}/support"
@rendermode InteractiveServer
@using System.Diagnostics
@inject SupportService SupportService
@inject AppSession Session
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Help & Feedback</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Help &amp; Feedback</h1>
    <p class="text-muted mb-4">Report a problem, request a feature, or ask a question — our team will follow up here.</p>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">New Submission</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(_globalError))
                    {
                        <div class="alert alert-danger">@_globalError</div>
                    }

                    <EditForm EditContext="_editContext" OnValidSubmit="SubmitAsync">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label">Type <span class="text-danger">*</span></label>
                            <SfDropDownList TValue="string" TItem="TypeOption"
                                            DataSource="@_typeOptions"
                                            @bind-Value="_model.Type"
                                            Placeholder="Select a type">
                                <DropDownListFieldSettings Value="Value" Text="Label" />
                            </SfDropDownList>
                            <ValidationMessage For="@(() => _model.Type)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Title <span class="text-danger">*</span></label>
                            <HrTextBox @bind-Value="_model.Title" Placeholder="Short summary" />
                            <ValidationMessage For="@(() => _model.Title)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Description <span class="text-danger">*</span></label>
                            <HrTextBox @bind-Value="_model.Description" Multiline="true" CssClass="support-description"
                                       Placeholder="Please describe the problem, feature, or question in detail" />
                            <ValidationMessage For="@(() => _model.Description)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Priority <span class="text-danger">*</span></label>
                            <SfDropDownList TValue="string" TItem="string"
                                            DataSource="@SupportRequestOptions.Priorities"
                                            @bind-Value="_model.Priority"
                                            Placeholder="Select a priority">
                            </SfDropDownList>
                            <ValidationMessage For="@(() => _model.Priority)" />
                        </div>

                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="includeDiagnostics" @bind="_model.IncludeDiagnostics" />
                            <label class="form-check-label" for="includeDiagnostics">
                                Include diagnostics (page URL, browser, app version) to help us investigate
                            </label>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Screenshots (optional)</label>
                            <div class="support-dropzone" @ondragover="OnDragOver" @ondragover:preventDefault="true"
                                 @ondrop="OnDropAsync" @ondrop:preventDefault="true">
                                <InputFile OnChange="OnFilesSelected" multiple accept=".png,.jpg,.jpeg,.gif,.webp"
                                           class="support-dropzone-input" />
                                <div class="support-dropzone-label">
                                    <i class="fa-solid fa-cloud-arrow-up me-2"></i>
                                    Drag &amp; drop screenshots here, or click to browse
                                </div>
                            </div>

                            @if (_selectedFiles.Count > 0)
                            {
                                <div class="support-file-preview-list">
                                    @foreach (var file in _selectedFiles)
                                    {
                                        var f = file;
                                        <div class="support-file-preview-item">
                                            <i class="fa-solid fa-file-image me-2"></i>
                                            <span class="support-file-preview-name">@f.Name</span>
                                            <span class="text-muted ms-2">(@FormatSize(f.Size))</span>
                                            <button type="button" class="btn-close ms-auto" @onclick="() => RemoveFile(f)"></button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="d-flex justify-content-end">
                            <SfButton IsPrimary="true" Disabled="@_submitting" type="submit">
                                @if (_submitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                Submit
                            </SfButton>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h5 class="mb-0">My Submissions</h5>
                    <div class="support-status-filter">
                        <SfDropDownList TValue="string" TItem="string"
                                        DataSource="@_statusFilterOptions"
                                        Value="@_statusFilter"
                                        ValueChanged="OnStatusFilterChangedAsync">
                        </SfDropDownList>
                    </div>
                </div>
                <div class="card-body">
                    @if (_listLoading)
                    {
                        <HrLoadingIndicator Label="Loading submissions…" />
                    }
                    else if (_listError is not null)
                    {
                        <div class="alert alert-danger">@_listError</div>
                    }
                    else if (_submissions.Count == 0)
                    {
                        <p class="text-muted mb-0">No submissions yet.</p>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var item in _submissions)
                            {
                                <a class="list-group-item list-group-item-action" href="/companies/@CompanyId/support/@item.Id">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <div class="fw-semibold">@item.Title</div>
                                            <div class="text-muted small">@item.ReferenceNumber &middot; @SupportRequestOptions.TypeLabel(item.Type)</div>
                                        </div>
                                        <span class="badge @StatusBadgeClass(item.Status)">@EnumDisplay.Humanize(item.Status)</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.LatestResponseSnippet))
                                    {
                                        <div class="text-muted small mt-1">@item.LatestResponseSnippet</div>
                                    }
                                </a>
                            }
                        </div>
                        <p class="text-muted mt-3 mb-0">@_submissions.Count submission(s)</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }

    private const string AllStatusesOption = "All statuses";

    private readonly SubmitSupportRequestFormModel _model = new();
    private EditContext _editContext = default!;
    private readonly List<IBrowserFile> _selectedFiles = [];
    private bool _submitting;
    private string? _globalError;

    private readonly List<string> _statusFilterOptions = [AllStatusesOption, .. SupportRequestOptions.Statuses];
    private string _statusFilter = AllStatusesOption;

    private static readonly List<TypeOption> _typeOptions =
        SupportRequestOptions.Types.Select(t => new TypeOption(t, SupportRequestOptions.TypeLabel(t))).ToList();

    private sealed record TypeOption(string Value, string Label);

    private bool _listLoading = true;
    private string? _listError;
    private List<SupportRequestListItem> _submissions = [];

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);
    }

    protected override async Task OnParametersSetAsync()
    {
        // OBT-IAM-09: gate on support:manage — not company:manage — so a Company-Administrator-only
        // account (no longer granted support:manage) is denied.
        if (!Session.IsHrAdministrator && !Session.CanManageSupport)
        {
            Navigation.NavigateTo("/access-denied", replace: true);
            return;
        }

        await LoadSubmissionsAsync();
    }

    private async Task LoadSubmissionsAsync()
    {
        _listLoading = true;
        _listError = null;
        StateHasChanged();

        var status = _statusFilter == AllStatusesOption ? null : _statusFilter;
        var result = await SupportService.ListSupportRequestsAsync(CompanyId, status);

        if (result is null)
            _listError = "Failed to load submissions.";
        else
            _submissions = result;

        _listLoading = false;
    }

    private async Task OnStatusFilterChangedAsync(string value)
    {
        _statusFilter = value;
        await LoadSubmissionsAsync();
    }

    private void OnFilesSelected(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(20))
            _selectedFiles.Add(file);
    }

    private void OnDragOver()
    {
        // Presence of the handler is enough to enable dropping; browsers require dragover to be
        // handled (and prevented, via @ondragover:preventDefault above) for drop to fire at all.
    }

    private Task OnDropAsync()
    {
        // The actual file payload from a native drag-and-drop drop event isn't exposed to
        // Blazor's InputFile — browsers only deliver dropped files via the underlying <input
        // type="file"> element's own change event, which InputFile already wires up via
        // OnFilesSelected. The dropzone below still visually accepts the drop (via
        // ondragover/ondrop preventDefault) so the file picker click area functions as the
        // drop target, matching the "drag-and-drop + browse" requirement without needing custom
        // JS interop to read the DataTransfer object.
        return Task.CompletedTask;
    }

    private void RemoveFile(IBrowserFile file) => _selectedFiles.Remove(file);

    private static string FormatSize(long bytes) =>
        bytes < 1024 ? $"{bytes} B" :
        bytes < 1024 * 1024 ? $"{bytes / 1024.0:0.#} KB" :
        $"{bytes / (1024.0 * 1024.0):0.#} MB";

    private async Task SubmitAsync()
    {
        _globalError = null;

        if (!_editContext.Validate())
        {
            _globalError = "Please correct the highlighted fields below.";
            return;
        }

        _submitting = true;
        StateHasChanged();

        string? pageUrl = null;
        string? browser = null;
        string? appVersion = null;
        string? correlationId = null;
        List<string>? recentClientErrors = null;

        if (_model.IncludeDiagnostics)
        {
            pageUrl = Navigation.Uri;
            try { browser = await JS.InvokeAsync<string>("getBrowserInfo"); } catch { }
            appVersion = typeof(Program).Assembly.GetName().Version?.ToString();
            // Prefer the real distributed-tracing correlation ID (same one that ties this
            // request's server-side logs/traces together) over a random GUID, so staff can
            // actually cross-reference this submission against telemetry.
            correlationId = Activity.Current?.Id ?? Activity.Current?.RootId;
            try { recentClientErrors = (await JS.InvokeAsync<string[]>("getRecentClientErrors", 10)).ToList(); } catch { }
        }

        var (created, error) = await SupportService.SubmitSupportRequestAsync(
            CompanyId, _model.Type!, _model.Title.Trim(), _model.Description.Trim(), _model.Priority!,
            _model.IncludeDiagnostics, pageUrl, browser, appVersion, correlationId, recentClientErrors, _selectedFiles);

        _submitting = false;

        if (created is null)
        {
            _globalError = error ?? "Failed to submit request.";
            return;
        }

        Navigation.NavigateTo($"/companies/{CompanyId}/support/{created.Id}");
    }

    private static string StatusBadgeClass(string status) => status switch
    {
        "Submitted" => "bg-secondary",
        "UnderReview" => "bg-info text-dark",
        "Planned" => "bg-primary",
        "WaitingForCustomer" => "bg-warning text-dark",
        "Resolved" => "bg-success",
        "Closed" => "bg-dark",
        _ => "bg-secondary",
    };
}
