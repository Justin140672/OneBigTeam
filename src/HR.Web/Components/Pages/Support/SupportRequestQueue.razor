@page "/companies/{CompanyId:guid}/support/admin/queue"
@rendermode InteractiveServer
@inherits SearchPageBase<SupportRequestListItem>
@inject SupportService SupportService
@inject AppSession Session

<PageTitle>Support Requests</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Support Requests</h1>
    <p class="text-muted mb-3">
        Staff queue for reviewing support requests submitted by employees of this company.
        Ticket status can only be changed by support staff in the Admin app.
    </p>

    @if (IsLoading)
    {
        <HrLoadingIndicator Label="Loading support requests…" />
    }
    else if (Error is not null)
    {
        <div class="alert alert-danger">@Error</div>
    }
    else
    {
        @if (ActionError is not null)
        {
            <div class="alert alert-danger alert-dismissible">
                @ActionError
                <button type="button" class="btn-close" @onclick="ClearActionError"></button>
            </div>
        }

        <HrGrid @ref="Grid"
                TValue="SupportRequestListItem"
                DataSource="@DisplayedItems"
                Toolbar="@GridToolbar"
                AllowPaging="true"
                AllowSorting="true">
            <GridEvents TValue="SupportRequestListItem" OnToolbarClick="OnToolbarClick"
                        RowSelected="OnRowSelected" RowDeselected="OnRowDeselected" />
            <GridPageSettings PageSize="20" />
            <GridColumns>
                <GridColumn Field="@nameof(SupportRequestListItem.ReferenceNumber)" HeaderText="Reference" Width="140">
                    <Template>
                        @{
                            var row = (context as SupportRequestListItem)!;
                            <a href="/companies/@CompanyId/support/@row.Id">@row.ReferenceNumber</a>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(SupportRequestListItem.Title)" HeaderText="Title" Width="220" />
                <GridColumn Field="@nameof(SupportRequestListItem.Type)" HeaderText="Type" Width="160">
                    <Template>
                        @{
                            var row = (context as SupportRequestListItem)!;
                            @SupportRequestOptions.TypeLabel(row.Type)
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(SupportRequestListItem.Priority)" HeaderText="Priority" Width="110" />
                <GridColumn Field="@nameof(SupportRequestListItem.CreatedAt)" HeaderText="Submitted" Width="150" Format="g" />
                <GridColumn Field="@nameof(SupportRequestListItem.Status)" HeaderText="Status" Width="140">
                    <Template>
                        @{
                            var row = (context as SupportRequestListItem)!;
                        }
                        @EnumDisplay.Humanize(row.Status)
                    </Template>
                </GridColumn>
            </GridColumns>
        </HrGrid>

        <p class="text-muted mt-3">@DisplayedItems.Count support request(s)</p>
    }
</div>

@code {
    // "Closed" is this entity's equivalent of IsActive=false on other list screens — closed
    // tickets drop out of the default view, same as deactivated records elsewhere, via the same
    // shared "Show Inactive"/"Show Active" toolbar toggle (SearchPageBase.ShowInactive).
    private const string ClosedStatus = "Closed";

    protected override bool SupportsActiveFilter => true;

    // Tickets are only ever created by employees via Help & Feedback, never from this staff
    // queue — and status can no longer be changed here at all (see item 22: that's exclusively an
    // Admin app / support-staff action now), so "Add"/"Edit" have nothing to do here either.
    protected override bool IsAddDisabled => true;

    private IReadOnlyList<SupportRequestListItem> DisplayedItems =>
        ShowInactive ? Items : Items.Where(i => i.Status != ClosedStatus).ToList();

    protected override Task OnBeforeLoadAsync()
    {
        if (!Session.IsHrAdministrator && !Session.CanManageCompany)
            Navigation.NavigateTo("/access-denied", replace: true);

        return Task.CompletedTask;
    }

    protected override async Task<IReadOnlyList<SupportRequestListItem>?> FetchItemsAsync(string? search)
    {
        var result = await SupportService.ListSupportRequestsAsync(CompanyId);
        return result;
    }

    protected override string LoadErrorMessage => "Failed to load support requests.";

    protected override string? GetViewUrl(SupportRequestListItem item) =>
        $"/companies/{CompanyId}/support/{item.Id}";
}
