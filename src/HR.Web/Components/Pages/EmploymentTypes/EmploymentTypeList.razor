@page "/companies/{CompanyId:guid}/employment-types"
@rendermode InteractiveServer
@inherits SearchPageBase<EmploymentTypeListItemModel>
@inject EmploymentTypeService EmploymentTypeService
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Employment Types</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-3">Employment Types</h1>

    <div class="form-check form-switch mb-3">
        <input class="form-check-input" type="checkbox" id="showInactive"
               @bind="_showInactive" @bind:after="LoadAsync" />
        <label class="form-check-label" for="showInactive">Show inactive</label>
    </div>

    @if (IsLoading)
    {
        <div class="d-flex align-items-center gap-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Loading employment types…</span>
        </div>
    }
    else if (Error is not null)
    {
        <div class="alert alert-danger">@Error</div>
    }
    else
    {
        @if (ActionError is not null)
        {
            <div class="alert alert-danger alert-dismissible">
                @ActionError
                <button type="button" class="btn-close" @onclick="ClearActionError"></button>
            </div>
        }

        <HrGrid @ref="Grid"
                TValue="EmploymentTypeListItemModel"
                DataSource="@Items"
                Toolbar="@GridToolbar"
                AllowFiltering="false">
            <GridEvents TValue="EmploymentTypeListItemModel" OnToolbarClick="OnToolbarClick"
                        RowSelected="OnRowSelected" RowDeselected="OnRowDeselected" />
            <GridPageSettings PageSize="20" />
            <GridColumns>
                <GridColumn Field="@nameof(EmploymentTypeListItemModel.Name)" HeaderText="Name" Width="220">
                    <Template>
                        @{
                            var row = (context as EmploymentTypeListItemModel)!;
                            <a href="/companies/@CompanyId/employment-types/@row.Id">@row.Name</a>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(EmploymentTypeListItemModel.Description)" HeaderText="Description" Width="300" />
                <GridColumn Field="@nameof(EmploymentTypeListItemModel.IsActive)" HeaderText="Status" Width="110">
                    <Template>
                        @{
                            var row = (context as EmploymentTypeListItemModel)!;
                            <span class="badge @(row.IsActive ? "bg-success" : "bg-secondary")">
                                @(row.IsActive ? "Active" : "Inactive")
                            </span>
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </HrGrid>
    }
</div>

@code {
    private bool _showInactive;

    protected override void ConfigureToolbar()
    {
        AddToolbarAction(
            id:      "hr-deactivate",
            text:    "Deactivate",
            icon:    "fa-solid fa-circle-xmark",
            onClick: async item =>
            {
                if (!item.IsActive) return;
                await Deactivate(item);
            },
            tooltip: "Deactivate selected employment type");
    }

    protected override async Task<IReadOnlyList<EmploymentTypeListItemModel>?> FetchItemsAsync(string? search)
    {
        var result = await EmploymentTypeService.ListEmploymentTypesAsync(CompanyId, _showInactive);
        return result?.Items;
    }

    protected override string LoadErrorMessage => "Failed to load employment types.";

    protected override string? GetAddUrl()  => $"/companies/{CompanyId}/employment-types/new";
    protected override string? GetEditUrl(EmploymentTypeListItemModel item) => $"/companies/{CompanyId}/employment-types/{item.Id}";
    protected override string? GetViewUrl(EmploymentTypeListItemModel item) => $"/companies/{CompanyId}/employment-types/{item.Id}/view";

    private async Task Deactivate(EmploymentTypeListItemModel item)
    {
        ClearActionError();
        var error = await EmploymentTypeService.DeactivateAsync(CompanyId, item.Id);
        if (error is not null)
            SetActionError(error);
        else
            await LoadAsync();
    }
}
