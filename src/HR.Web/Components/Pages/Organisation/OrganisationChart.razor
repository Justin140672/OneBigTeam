@page "/companies/{CompanyId:guid}/organisation-chart"
@rendermode InteractiveServer
@using Syncfusion.Blazor.Diagram
@using Microsoft.AspNetCore.WebUtilities
@inject AppSession Session
@inject NavigationManager Navigation
@inject OrganisationChartService OrganisationChartService
@inject OrganisationHierarchyBuilder HierarchyBuilder
@inject DepartmentService DepartmentService
@inject LocationService LocationService
@inject IJSRuntime JS

<PageTitle>Organisation Chart</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Organisation Chart</h1>
    <p class="text-muted mb-4">Visualise reporting lines and team structure across the company.</p>

    @if (!_loading || _diagramItems.Count > 0)
    {
        <div class="row g-2 align-items-end mb-3">
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Search</label>
                <HrTextBox Value="@_searchTerm"
                           ValueChanged="@OnSearchChanged"
                           Placeholder="Search by name or employee number" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Department</label>
                <SfDropDownList TValue="Guid?" TItem="DepartmentListItemModel"
                                DataSource="@_departments"
                                Value="@_selectedDepartmentId"
                                ValueChanged="@OnDepartmentFilterChanged"
                                Placeholder="All Departments"
                                AllowFiltering="true">
                    <DropDownListFieldSettings Value="Id" Text="Name" />
                </SfDropDownList>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Location</label>
                <SfDropDownList TValue="Guid?" TItem="LocationListItemModel"
                                DataSource="@_locations"
                                Value="@_selectedLocationId"
                                ValueChanged="@OnLocationFilterChanged"
                                Placeholder="All Locations"
                                AllowFiltering="true">
                    <DropDownListFieldSettings Value="Id" Text="Name" />
                </SfDropDownList>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Employment Status</label>
                <SfDropDownList TValue="string" TItem="StatusOption"
                                DataSource="@StatusOptions"
                                Value="@_selectedStatus"
                                ValueChanged="@OnStatusFilterChanged">
                    <DropDownListFieldSettings Value="Value" Text="Label" />
                </SfDropDownList>
            </div>
        </div>
        @if (_searchNotFound)
        {
            <p class="text-muted small mb-3">No employee found matching "@_searchTerm".</p>
        }
    }

    @if (_loading)
    {
        <HrLoadingIndicator Label="Loading organisation chart…" />
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else if (_diagramItems.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="fa-solid fa-sitemap fa-2x text-muted mb-3"></i>
                <p class="text-muted mb-0">No employees match the current filters.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-0 org-chart-canvas">
                <div class="org-chart-zoom-toolbar">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ZoomOut" title="Zoom out">
                        <i class="fa-solid fa-minus"></i>
                    </button>
                    <span class="org-chart-zoom-level">@($"{_currentZoom * 100:0}%")</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ZoomIn" title="Zoom in">
                        <i class="fa-solid fa-plus"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="FitToScreen" title="Fit chart to screen">
                        <i class="fa-solid fa-expand"></i>
                    </button>
                </div>
                <SfDiagramComponent @ref="_diagram" Height="100%" Width="100%"
                                    NodeCreating="OnNodeCreating"
                                    ConnectorCreating="OnConnectorCreating"
                                    Click="OnDiagramClick"
                                    DataLoaded="OnDataLoaded"
                                    InteractionController="DiagramInteractions.Default | DiagramInteractions.ZoomPan">
                    <DataSourceSettings ID="Id" ParentID="ManagerId" DataSource="_diagramItems"></DataSourceSettings>
                    <Layout @bind-Type="_layoutType" @bind-Orientation="_orientation"
                            HorizontalSpacing="30" VerticalSpacing="30" />
                    <SnapSettings Constraints="SnapConstraints.None"></SnapSettings>
                    <ScrollSettings CurrentZoom="_currentZoom" CurrentZoomChanged="OnCurrentZoomChangedAsync" />
                    <DiagramTemplates>
                        <NodeTemplate>
                            @{
                                var node = (context as Node);
                                var item = node?.Data as OrganisationChartDiagramItem;
                            }
                            @if (item is not null)
                            {
                                <div class="org-chart-card @(item.Id == _focusEmployeeId ? "org-chart-card-highlighted" : "")"
                                     @onclick="() => NavigateToEmployee(item)">
                                    <div class="org-chart-avatar">
                                        @if (!string.IsNullOrWhiteSpace(item.ProfilePhotoUrl))
                                        {
                                            <img src="@item.ProfilePhotoUrl" alt="" />
                                        }
                                        else
                                        {
                                            @GetInitials(item.Name)
                                        }
                                    </div>
                                    <div class="org-chart-details">
                                        <div class="org-chart-name">@item.Name</div>
                                        <div class="org-chart-title">@item.JobTitle</div>
                                        <div class="org-chart-department">@item.Department</div>
                                    </div>
                                </div>
                            }
                        </NodeTemplate>
                    </DiagramTemplates>
                </SfDiagramComponent>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }

    private bool _loading = true;
    private string? _error;
    private List<OrganisationChartDiagramItem> _diagramItems = [];
    private List<OrganisationChartEmployeeModel> _employees = [];

    private string? _searchTerm;
    private bool _searchNotFound;

    private List<DepartmentListItemModel> _departments = [];
    private List<LocationListItemModel> _locations = [];
    private Guid? _selectedDepartmentId;
    private Guid? _selectedLocationId;

    // "Active" by default — preserves this page's original "Inactive/leavers excluded" behaviour
    // out of the box, while letting HR widen or change it (e.g. to review who's on leave, or
    // check a leaver's old reporting line). Empty string = no Status filter (all statuses).
    private string _selectedStatus = "Active";

    private static readonly List<StatusOption> StatusOptions =
    [
        new("Active", "Active only"),
        new("", "All Statuses"),
        new("OnLeave", "On Leave"),
        new("Suspended", "Suspended"),
        new("Terminated", "Terminated"),
        new("Draft", "Draft"),
    ];

    private sealed record StatusOption(string Value, string Label);

    private LayoutType _layoutType = LayoutType.OrganizationalChart;
    private LayoutOrientation _orientation = LayoutOrientation.TopToBottom;

    private SfDiagramComponent? _diagram;

    // Set from "?employeeId=" when arriving via the Employee Overview's "View Org Chart" button —
    // drives both the highlighted card border (NodeTemplate above) and the auto-centering once
    // the diagram finishes laying itself out (OnDataLoaded).
    private string? _focusEmployeeId;

    private IReadOnlyList<OrganisationChartNode> _tree = [];

    // Absolute zoom scale (1.0 = 100%), two-way bound to <ScrollSettings> so it also picks up
    // zoom changes from mouse-wheel/pinch, not just our own toolbar buttons. Restored from
    // localStorage on first render (OnAfterRenderAsync) and persisted on every change.
    private double _currentZoom = 1;
    private const double MinZoom = 0.1;
    private const double MaxZoom = 4;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.CanManageEmployees)
        {
            Navigation.NavigateTo(Session.MyProfileUrl, replace: true);
            return;
        }

        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (query.TryGetValue("employeeId", out var employeeId) && Guid.TryParse(employeeId, out var parsed))
            _focusEmployeeId = parsed.ToString();

        var deptTask = DepartmentService.ListDepartmentsAsync(CompanyId);
        var locTask = LocationService.ListLocationsAsync(CompanyId);
        await Task.WhenAll(deptTask, locTask);

        _departments = (await deptTask)?.Items ?? [];
        _locations = (await locTask)?.Items ?? [];

        await LoadChartAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var storedZoom = await JS.InvokeAsync<double?>("getOrgChartZoom");
        if (storedZoom is double zoom && zoom >= MinZoom && zoom <= MaxZoom)
        {
            _currentZoom = zoom;
            StateHasChanged();
        }
    }

    private async Task LoadChartAsync()
    {
        _loading = true;
        StateHasChanged();

        var response = await OrganisationChartService.GetOrganisationChartAsync(
            CompanyId, _selectedDepartmentId, _selectedLocationId,
            string.IsNullOrEmpty(_selectedStatus) ? null : _selectedStatus);

        if (response is null)
        {
            _error = "Failed to load the organisation chart.";
        }
        else
        {
            _error = null;
            _employees = response.Items.ToList();

            // Route the flat API data through the hierarchy builder first so the diagram only
            // ever sees clean, acyclic parent links — dangling/self/circular manager references
            // are already resolved there, not something the diagram itself has to cope with.
            _tree = HierarchyBuilder.Build(response.Items);
            _diagramItems = Flatten(_tree, managerId: null);
        }

        _loading = false;
    }

    private async Task OnDepartmentFilterChanged(Guid? value)
    {
        _selectedDepartmentId = value;
        await LoadChartAsync();
    }

    private async Task OnLocationFilterChanged(Guid? value)
    {
        _selectedLocationId = value;
        await LoadChartAsync();
    }

    private async Task OnStatusFilterChanged(string value)
    {
        _selectedStatus = value;
        await LoadChartAsync();
    }

    private static List<OrganisationChartDiagramItem> Flatten(
        IReadOnlyList<OrganisationChartNode> nodes, string? managerId)
    {
        var items = new List<OrganisationChartDiagramItem>();

        foreach (var node in nodes)
        {
            items.Add(new OrganisationChartDiagramItem
            {
                Id = node.EmployeeId.ToString(),
                ManagerId = managerId,
                Name = node.Name,
                JobTitle = node.JobTitle,
                Department = node.Department,
                ProfilePhotoUrl = node.ProfilePhotoUrl,
            });

            items.AddRange(Flatten(node.DirectReports, node.EmployeeId.ToString()));
        }

        return items;
    }

    // Defines default rendering for each node — an HTML-shaped node so NodeTemplate above (the
    // card markup) is what actually renders, rather than a default diagram shape.
    private void OnNodeCreating(IDiagramObject obj)
    {
        if (obj is not Node node) return;

        if (node.Data is System.Text.Json.JsonElement)
            node.Data = System.Text.Json.JsonSerializer.Deserialize<OrganisationChartDiagramItem>(node.Data.ToString()!);

        node.Width = 220;
        node.Height = 76;
        node.Shape = new Shape { Type = NodeShapes.HTML };
    }

    // Fallback shown when an employee has no uploaded/approved profile photo (ProfilePhotoUrl
    // is null) — the node renders an initials circle instead of the <img>.
    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => $"{parts[0][..1]}{parts[^1][..1]}".ToUpperInvariant(),
        };
    }

    // Clean orthogonal connector lines with no arrowheads, matching a typical org-chart look.
    private void OnConnectorCreating(IDiagramObject obj)
    {
        if (obj is not Connector connector) return;

        connector.Type = ConnectorSegmentType.Orthogonal;
        connector.CornerRadius = 10;
        connector.Style = new ShapeStyle { StrokeWidth = 1 };
        connector.TargetDecorator!.Shape = DecoratorShape.None;
        connector.SourceDecorator!.Shape = DecoratorShape.None;
    }

    // Clicking a card opens that employee's profile. Two paths to the same place: the Diagram's
    // own Click event (ActualObject tells us which node/HTML-shape was hit) and a plain @onclick
    // directly on the card markup in NodeTemplate above — HTML-shaped nodes are just regular
    // Blazor-rendered DOM content, but the Diagram's own pan/zoom interaction layer can sit over
    // that content and swallow the click before it bubbles, depending on version/interaction
    // mode. Keeping both means whichever one the current interaction mode actually delivers is
    // enough; NavigateTo-ing to the same URL twice in one render is harmless.
    private void OnDiagramClick(Syncfusion.Blazor.Diagram.ClickEventArgs args)
    {
        if (args.ActualObject is Node node && node.Data is OrganisationChartDiagramItem item)
            NavigateToEmployee(item);
    }

    private void NavigateToEmployee(OrganisationChartDiagramItem item) =>
        Navigation.NavigateTo($"/companies/{CompanyId}/employees/{item.Id}");

    // Fires once the diagram has finished laying itself out from DataSourceSettings — the
    // earliest safe point at which _diagram.Nodes is actually populated. Centers the viewport on
    // the employee we arrived here to look at, if any.
    private void OnDataLoaded(object args) => CenterOnEmployee(_focusEmployeeId);

    private void CenterOnEmployee(string? employeeId)
    {
        if (_diagram is null || employeeId is null) return;

        var node = _diagram.Nodes.FirstOrDefault(n => n.ID == employeeId);
        if (node is null) return;

        _diagram.BringIntoCenter(new DiagramRect(
            node.OffsetX - node.Width / 2,
            node.OffsetY - node.Height / 2,
            node.Width,
            node.Height));
    }

    // The relative-factor Zoom() call (rather than setting _currentZoom directly) is the
    // documented way to change zoom programmatically; the resulting new zoom level comes back
    // through OnCurrentZoomChangedAsync (ScrollSettings' two-way binding), which is also what
    // keeps _currentZoom in sync with mouse-wheel/pinch zooming.
    private void ZoomIn()
    {
        _diagram?.Zoom(1.2, null!);
    }

    private void ZoomOut()
    {
        _diagram?.Zoom(0.8, null!);
    }

    private void FitToScreen()
    {
        _diagram?.FitToPage(new FitOptions
        {
            Mode = FitMode.Both,
            Region = DiagramRegion.Content,
            CanZoomIn = true,
        });
    }

    // Fires for every zoom change regardless of source (toolbar buttons, mouse wheel, pinch) —
    // keeps _currentZoom (and the % label) accurate and persists it so the chart reopens at the
    // same zoom level next time.
    private async Task OnCurrentZoomChangedAsync(double value)
    {
        _currentZoom = value;
        await JS.InvokeVoidAsync("setOrgChartZoom", value);
    }

    // Live search as the user types — matches by name or employee number and, on a hit,
    // highlights and centers that employee's card using the same mechanism as the "View Org
    // Chart" deep link (CenterOnEmployee/_focusEmployeeId).
    private void OnSearchChanged(string? value)
    {
        _searchTerm = value;

        if (string.IsNullOrWhiteSpace(value))
        {
            _searchNotFound = false;
            _focusEmployeeId = null;
            return;
        }

        var term = value.Trim();
        var match = _employees.FirstOrDefault(e =>
            e.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
            e.EmployeeNumber.Contains(term, StringComparison.OrdinalIgnoreCase));

        if (match is null)
        {
            _searchNotFound = true;
            _focusEmployeeId = null;
            return;
        }

        _searchNotFound = false;
        _focusEmployeeId = match.EmployeeId.ToString();
        CenterOnEmployee(_focusEmployeeId);
    }
}
