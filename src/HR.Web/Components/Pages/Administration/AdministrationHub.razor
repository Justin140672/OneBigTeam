@page "/companies/{CompanyId:guid}/administration"
@rendermode InteractiveServer
@using HR.Web.Services
@inject AppSession Session
@inject NavigationManager Navigation

<PageTitle>Administration</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Administration</h1>
    <p class="text-muted mb-4">Company and HR configuration in one place.</p>

    <div class="row g-3">
        @foreach (var category in _categories)
        {
            <div class="col-md-4">
                <div class="card h-100 administration-hub-card">
                    <div class="card-body">
                        <h6 class="card-title mb-1">@category.Title</h6>
                        <p class="card-text text-muted small mb-2">@category.Explanation</p>
                        <p class="mb-2"><code class="text-muted small">Requires: @category.Requires</code></p>
                        <ul class="list-unstyled mb-0">
                            @foreach (var link in category.Links)
                            {
                                <li class="mb-1">
                                    @if (link.Url is not null)
                                    {
                                        <a href="@link.Url">@link.Text</a>
                                    }
                                    else
                                    {
                                        <span>@link.Text</span>
                                        <span class="badge bg-secondary ms-1">Not yet configurable</span>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }

    private IReadOnlyList<HubCategory> _categories = [];

    protected override async Task OnParametersSetAsync()
    {
        await Session.InitialiseAsync();

        _categories = AdministrationHubCategories.Build(HubCapabilities.From(Session), CompanyId);

        if (_categories.Count == 0)
            AppSession.GuardAccess(Navigation, false);
    }
}
