<div class="card h-100">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h6 class="mb-0">@Task.Name</h6>
        @if (Task.IsCompleted)
        {
            <i class="fa-solid fa-circle-check text-success" title="Completed"></i>
        }
    </div>
    <div class="card-body d-flex flex-column">
        <p class="text-muted small mb-3">@Task.Description</p>
        @if (Task.IsCompleted)
        {
            <span class="badge bg-success align-self-start mt-auto">
                <i class="fa-solid fa-check me-1"></i>Completed
            </span>
        }
        else
        {
            <a href="@ResolvedLinkUrl" class="btn btn-primary btn-sm align-self-start mt-auto">
                @ActionLabel
            </a>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CompanyOnboardingTaskItem Task { get; set; } = default!;
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }

    // Task.LinkUrl contains a "{companyId}" placeholder since HR.Web's routes are company-scoped
    // (e.g. "/companies/{CompanyId:guid}/employees") — substitute the current company id here.
    // "returnUrl" tells the target edit/list page (EditPageBase.TargetListUrl, or the employee
    // list's own "Back to employees" link in invitation mode) to send the user back here instead
    // of its own list page, so completing a task from the checklist returns to the checklist
    // rather than stranding the user on an unrelated list screen.
    //
    // Some task links (e.g. invite-additional-users -> "/companies/{companyId}/employees?mode=invite")
    // already carry their own query string, so a naive "+ \"?returnUrl=...\"" would produce a
    // malformed URL such as "...?mode=invite?returnUrl=...". Join with "&" when a query string is
    // already present, "?" otherwise.
    private string ResolvedLinkUrl
    {
        get
        {
            var url = Task.LinkUrl.Replace("{companyId}", CompanyId.ToString());
            var separator = url.Contains('?') ? "&" : "?";
            return $"{url}{separator}returnUrl=%2Fgetting-started";
        }
    }

    // The import template task streams a file download rather than navigating to a page (see
    // DownloadEmployeeImportTemplateTask.GetLinkUrlAsync), so "Go to task" reads wrong there.
    private string ActionLabel => Task.Key == "download-employee-import-template" ? "Download" : "Go to task";
}
