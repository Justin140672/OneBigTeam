<div class="card h-100">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h6 class="mb-0">@Task.Name</h6>
        @if (Task.IsCompleted)
        {
            <i class="fa-solid fa-circle-check text-success" title="Completed"></i>
        }
    </div>
    <div class="card-body d-flex flex-column">
        <p class="text-muted small mb-3">@Task.Description</p>
        @if (Task.IsCompleted)
        {
            <span class="badge bg-success align-self-start mt-auto">
                <i class="fa-solid fa-check me-1"></i>Completed
            </span>
        }
        else
        {
            <a href="@ResolvedLinkUrl" class="btn btn-primary btn-sm align-self-start mt-auto">
                @ActionLabel
            </a>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CompanyOnboardingTaskItem Task { get; set; } = default!;
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }

    private string ResolvedLinkUrl
    {
        get
        {
            var url = Task.LinkUrl.Replace("{companyId}", CompanyId.ToString());
            var separator = url.Contains('?') ? "&" : "?";
            return $"{url}{separator}returnUrl=%2Fgetting-started";
        }
    }

    private string ActionLabel => Task.Key == "download-employee-import-template" ? "Download" : "Go to task";
}
