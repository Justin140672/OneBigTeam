<div class="card h-100">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h6 class="mb-0">@Task.Name</h6>
        @if (Task.IsCompleted)
        {
            <i class="fa-solid fa-circle-check text-success" title="Completed"></i>
        }
    </div>
    <div class="card-body d-flex flex-column">
        <p class="text-muted small mb-3">@Task.Description</p>
        @if (Task.IsCompleted)
        {
            <span class="badge bg-success align-self-start mt-auto">
                <i class="fa-solid fa-check me-1"></i>Completed
            </span>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2 mt-auto">
                @foreach (var action in Actions)
                {
                    if (action.IsDownload)
                    {
                        <a href="@action.Href" download data-enhance-nav="false"
                           class="btn btn-outline-primary btn-sm" aria-label="@action.AccessibleName">
                            <i class="@action.IconCss me-1" aria-hidden="true"></i>@action.Label
                        </a>
                    }
                    else
                    {
                        <a href="@action.Href" class="btn btn-primary btn-sm">@action.Label</a>
                    }
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CompanyOnboardingTaskItem Task { get; set; } = default!;
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }

    private IReadOnlyList<OnboardingTaskAction> Actions =>
        OnboardingTaskActionPresenter.Present(Task.Key, Task.LinkUrl, CompanyId, Task.IsCompleted);
}
