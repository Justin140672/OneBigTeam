@page "/explore"
@rendermode InteractiveServer
@inject CompanyOnboardingService CompanyOnboardingService
@inject NavigationManager Navigation
@inject AppSession Session

<PageTitle>Explore One Big Team</PageTitle>

<div class="container-fluid py-4">
    @if (_isLoading)
    {
        <HrLoadingIndicator Label="Loading…" />
    }
    else if (_response is null)
    {
        <div class="alert alert-danger">Failed to load the explore cards.</div>
    }
    else
    {
        <h1 class="mb-1">Explore One Big Team</h1>
        <p class="text-muted mb-4">Discover more of what One Big Team can do for you.</p>

        <div class="row g-3">
            @foreach (var card in _response.Cards)
            {
                <div class="col-md-4">
                    <ExploreCard Card="card" CompanyId="Session.CompanyId" />
                </div>
            }
        </div>
    }
</div>

@code {
    private GetCompanyOnboardingExploreCardsResponse? _response;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        if (!(Session.IsHrAdministrator || Session.CanManageCompany))
        {
            Navigation.NavigateTo(Session.MyProfileUrl, replace: true);
            return;
        }

        _response = await CompanyOnboardingService.GetExploreCardsAsync();
        _isLoading = false;
    }
}
