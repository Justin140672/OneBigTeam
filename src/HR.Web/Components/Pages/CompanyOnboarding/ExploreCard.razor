<div class="card h-100">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h6 class="mb-0">@Card.Name</h6>
        @if (Card.IsComingSoon)
        {
            <span class="badge bg-secondary">Coming Soon</span>
        }
    </div>
    <div class="card-body d-flex flex-column">
        <p class="text-muted small mb-3">@Card.Description</p>
        @if (Card.IsComingSoon)
        {
            <button type="button" class="btn btn-outline-secondary btn-sm align-self-start mt-auto" disabled>
                Coming Soon
            </button>
        }
        else
        {
            <a href="@ResolvedLinkUrl" class="btn btn-primary btn-sm align-self-start mt-auto">
                Explore
            </a>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CompanyOnboardingExploreCardItem Card { get; set; } = default!;
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }

    // Card.LinkUrl contains a "{companyId}" placeholder since HR.Web's routes are company-scoped
    // (e.g. "/companies/{CompanyId:guid}/employees") — substitute the current company id here.
    private string ResolvedLinkUrl => Card.LinkUrl.Replace("{companyId}", CompanyId.ToString());
}
