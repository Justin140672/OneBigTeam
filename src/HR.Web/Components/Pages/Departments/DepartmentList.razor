@page "/companies/{CompanyId:guid}/departments"
@rendermode InteractiveServer
@inherits SearchPageBase<DepartmentListItemModel>
@inject DepartmentService DepartmentService
@inject AppSession Session

<PageTitle>Departments</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Departments</h1>
    <p class="text-muted mb-3">Organize your company into departments for structure and reporting.</p>

    @if (IsLoading)
    {
        <HrLoadingIndicator Label="Loading departments…" />
    }
    else if (Error is not null)
    {
        <div class="alert alert-danger">@Error</div>
    }
    else
    {
        @if (ActionError is not null)
        {
            <div class="alert alert-danger alert-dismissible">
                @ActionError
                <button type="button" class="btn-close" @onclick="ClearActionError"></button>
            </div>
        }

        <HrGrid @ref="Grid"
                TValue="DepartmentListItemModel"
                DataSource="@Items"
                Toolbar="@GridToolbar"
                AllowFiltering="true">
            <GridEvents TValue="DepartmentListItemModel" OnToolbarClick="OnToolbarClick"
                        RowSelected="OnRowSelected" RowDeselected="OnRowDeselected" />
            <GridPageSettings PageSize="20" />
            <GridColumns>
                <GridColumn Field="@nameof(DepartmentListItemModel.Name)" HeaderText="Name" Width="220">
                    <Template>
                        @{
                            var row = (context as DepartmentListItemModel)!;
                            <a href="/companies/@CompanyId/departments/@row.Id">@row.Name</a>
                        }
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Parent" Width="200">
                    <Template>
                        @{
                            var row = (context as DepartmentListItemModel)!;
                            @if (row.ParentDepartmentId is not null && _nameMap.TryGetValue(row.ParentDepartmentId.Value, out var parentName))
                            {
                                @parentName
                            }
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(DepartmentListItemModel.IsActive)" HeaderText="Status" Width="110">
                    <Template>
                        @{
                            var row = (context as DepartmentListItemModel)!;
                            <ActiveStatusBadge IsActive="row.IsActive" />
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </HrGrid>
    }
</div>

<HrConfirmDialog Visible="@(_deactivateTarget is not null)"
                 Title="Deactivate Department"
                 Message="@($"Are you sure you want to deactivate '{_deactivateTarget?.Name}'?")"
                 ConfirmText="Deactivate"
                 CancelText="Cancel"
                 Busy="_deactivating"
                 OnConfirmed="ConfirmDeactivateAsync"
                 OnCancelled="@(() => _deactivateTarget = null)" />

@code {
    private Dictionary<Guid, string> _nameMap = new();
    private DepartmentListItemModel? _deactivateTarget;
    private bool _deactivating;

    protected override bool SupportsActiveFilter => true;

    protected override Task OnBeforeLoadAsync()
    {
        if (!Session.CanManageEmployees)
            Navigation.NavigateTo(Session.MyProfileUrl, replace: true);
        return Task.CompletedTask;
    }

    protected override void ConfigureToolbar()
    {
        AddToolbarAction(
            id:      "hr-deactivate",
            text:    "Deactivate",
            icon:    "fa-solid fa-circle-xmark",
            onClick: item =>
            {
                if (!item.IsActive) return Task.CompletedTask;
                _deactivateTarget = item;
                return Task.CompletedTask;
            },
            tooltip: "Deactivate selected department");
    }

    protected override async Task<IReadOnlyList<DepartmentListItemModel>?> FetchItemsAsync(string? search)
    {
        var result = await DepartmentService.ListDepartmentsAsync(CompanyId, ShowInactive);
        if (result is not null)
            _nameMap = result.Items.ToDictionary(d => d.Id, d => d.Name);
        return result?.Items;
    }

    protected override string LoadErrorMessage => "Failed to load departments.";

    protected override bool IsAddDisabled => Session.IsReadOnly;

    protected override string? GetAddUrl()  => $"/companies/{CompanyId}/departments/new";
    protected override string? GetEditUrl(DepartmentListItemModel item) => $"/companies/{CompanyId}/departments/{item.Id}";
    protected override string? GetViewUrl(DepartmentListItemModel item) => $"/companies/{CompanyId}/departments/{item.Id}/view";

    private async Task ConfirmDeactivateAsync()
    {
        if (_deactivateTarget is null) return;
        _deactivating = true;
        await Deactivate(_deactivateTarget);
        _deactivating = false;
        _deactivateTarget = null;
    }

    private async Task Deactivate(DepartmentListItemModel dept)
    {
        ClearActionError();
        var error = await DepartmentService.DeactivateDepartmentAsync(CompanyId, dept.Id);
        if (error is not null)
            SetActionError(error);
        else
            await LoadAsync();
    }
}
