@page "/companies/{CompanyId:guid}/departments"
@rendermode InteractiveServer
@inherits SearchPageBase<DepartmentListItemModel>
@inject DepartmentService DepartmentService

<PageTitle>Departments</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-3">Departments</h1>

    <div class="form-check form-switch mb-3">
        <input class="form-check-input" type="checkbox" id="showInactive"
               @bind="_showInactive" @bind:after="LoadAsync" />
        <label class="form-check-label" for="showInactive">Show inactive</label>
    </div>

    @if (IsLoading)
    {
        <div class="d-flex align-items-center gap-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Loading departments…</span>
        </div>
    }
    else if (Error is not null)
    {
        <div class="alert alert-danger">@Error</div>
    }
    else
    {
        @if (ActionError is not null)
        {
            <div class="alert alert-danger alert-dismissible">
                @ActionError
                <button type="button" class="btn-close" @onclick="ClearActionError"></button>
            </div>
        }

        <HrGrid @ref="Grid"
                TValue="DepartmentListItemModel"
                DataSource="@Items"
                Toolbar="@GridToolbar"
                AllowFiltering="false">
            <GridEvents TValue="DepartmentListItemModel" OnToolbarClick="OnToolbarClick"
                        RowSelected="OnRowSelected" RowDeselected="OnRowDeselected" />
            <GridPageSettings PageSize="20" />
            <GridColumns>
                <GridColumn Field="@nameof(DepartmentListItemModel.Name)" HeaderText="Name" Width="220">
                    <Template>
                        @{
                            var row = (context as DepartmentListItemModel)!;
                            <a href="/companies/@CompanyId/departments/@row.Id">@row.Name</a>
                        }
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Parent" Width="200">
                    <Template>
                        @{
                            var row = (context as DepartmentListItemModel)!;
                            @if (row.ParentDepartmentId is not null && _nameMap.TryGetValue(row.ParentDepartmentId.Value, out var parentName))
                            {
                                @parentName
                            }
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(DepartmentListItemModel.IsActive)" HeaderText="Status" Width="110">
                    <Template>
                        @{
                            var row = (context as DepartmentListItemModel)!;
                            <span class="badge @(row.IsActive ? "bg-success" : "bg-secondary")">
                                @(row.IsActive ? "Active" : "Inactive")
                            </span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="" Width="120" AllowSorting="false">
                    <Template>
                        @{
                            var row = (context as DepartmentListItemModel)!;
                            @if (row.IsActive)
                            {
                                <SfButton CssClass="e-small e-danger" Disabled="@(_deactivating == row.Id)"
                                          OnClick="@(() => ConfirmDeactivate(row))">
                                    @if (_deactivating == row.Id)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    }
                                    Deactivate
                                </SfButton>
                            }
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </HrGrid>
    }
</div>

@code {
    private Dictionary<Guid, string> _nameMap = new();
    private bool _showInactive;
    private Guid? _deactivating;

    protected override async Task<IReadOnlyList<DepartmentListItemModel>?> FetchItemsAsync(string? search)
    {
        var result = await DepartmentService.ListDepartmentsAsync(CompanyId, _showInactive);
        if (result is not null)
            _nameMap = result.Items.ToDictionary(d => d.Id, d => d.Name);
        return result?.Items;
    }

    protected override string LoadErrorMessage => "Failed to load departments.";

    protected override string? GetAddUrl() => $"/companies/{CompanyId}/departments/new";

    protected override string? GetEditUrl(DepartmentListItemModel item) =>
        $"/companies/{CompanyId}/departments/{item.Id}";

    protected override string? GetViewUrl(DepartmentListItemModel item) =>
        $"/companies/{CompanyId}/departments/{item.Id}/view";

    private async Task ConfirmDeactivate(DepartmentListItemModel dept)
    {
        _deactivating = dept.Id;
        ClearActionError();

        var error = await DepartmentService.DeactivateDepartmentAsync(CompanyId, dept.Id);
        _deactivating = null;

        if (error is not null)
            SetActionError(error);
        else
            await LoadAsync();
    }
}
