@page "/companies/{CompanyId:guid}/departments/new"
@page "/companies/{CompanyId:guid}/departments/{Id:guid}"
@page "/companies/{CompanyId:guid}/departments/{Id:guid}/view"
@rendermode InteractiveServer
@inject DepartmentService DepartmentService
@inherits EditPageBase<DepartmentEditModel>

<PageTitle>@PageTitle</PageTitle>

<div class="container py-4">
    <SfBreadcrumb Class="mb-3">
        <BreadcrumbItems>
            <BreadcrumbItem Text="Departments" Url="@($"/companies/{CompanyId}/departments")" />
            <BreadcrumbItem Text="@PageTitle" />
        </BreadcrumbItems>
    </SfBreadcrumb>

    @if (IsLoading)
    {
        <div class="d-flex align-items-center gap-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Loading…</span>
        </div>
    }
    else
    {
        <h1 class="mb-1">@PageTitle</h1>
        <p class="text-muted mb-4">Set the department's name and where it sits in your reporting structure.</p>

        @if (!string.IsNullOrEmpty(GlobalError))
        {
            <div class="alert alert-danger">@GlobalError</div>
        }

        <EditForm EditContext="EditContext">
            <DataAnnotationsValidator />
            <div class="row">
                <div class="col-lg-7">
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Department Details</h5>
                        </div>
                        <div class="card-body @(IsViewMode ? "view-mode" : "")">
                            <div class="mb-3">
                                <label class="form-label">Name <span class="text-danger">*</span></label>
                                <HrTextBox @bind-Value="Model.Name" Placeholder="Department name" />
                                <ValidationMessage For="@(() => Model.Name)" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Description</label>
                                <HrTextBox @bind-Value="Model.Description" Placeholder="Optional description" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Parent Department</label>
                                <SfDropDownList TValue="Guid?"
                                                TItem="DepartmentListItemModel"
                                                DataSource="@_otherDepts"
                                                @bind-Value="Model.ParentDepartmentId"
                                                Placeholder="None"
                                                AllowFiltering="true">
                                    <DropDownListFieldSettings Value="Id" Text="Name" />
                                </SfDropDownList>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <SfButton OnClick="RequestClose" Disabled="@Saving">Close</SfButton>
                        @if (!IsViewMode)
                        {
                            <SfButton IsPrimary="true" Disabled="@Saving" OnClick="SaveAsync">
                                @if (Saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                Save
                            </SfButton>
                        }
                    </div>
                </div>
            </div>
        </EditForm>
    }

    <UnsavedChangesDialog Visible="ShowUnsavedChangesDialog"
                          OnSaveAndClose="ConfirmSaveAndCloseAsync"
                          OnDiscard="DiscardChangesAndClose"
                          OnCancel="CancelCloseDialog" />
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid? Id { get; set; }

    private bool IsNew => Id is null || Id == Guid.Empty;
    private string PageTitle => IsNew ? "Add Department"
        : Model.Name.Trim().Length > 0 ? Model.Name
        : IsViewMode ? "View Department" : "Edit Department";

    private List<DepartmentListItemModel> _otherDepts = [];

    protected override async Task LoadAsync()
    {
        // Load all active departments for the parent picker
        var list = await DepartmentService.ListDepartmentsAsync(CompanyId);
        var all = list?.Items ?? [];

        if (!IsNew)
        {
            var existing = all.FirstOrDefault(d => d.Id == Id);
            if (existing is not null)
            {
                Model.Name = existing.Name;
                Model.ParentDepartmentId = existing.ParentDepartmentId;
                Model.ManagerEmployeeId = existing.ManagerEmployeeId;
            }

            // Exclude self from parent candidates
            _otherDepts = all.Where(d => d.Id != Id).ToList();
        }
        else
        {
            _otherDepts = all;
        }
    }

    protected override async Task<string?> SaveCoreAsync()
    {
        if (IsNew)
        {
            var request = new CreateDepartmentRequest(
                CompanyId,
                Model.Name.Trim(),
                string.IsNullOrWhiteSpace(Model.Description) ? null : Model.Description.Trim(),
                Model.ParentDepartmentId);

            var (created, error) = await DepartmentService.CreateDepartmentAsync(CompanyId, request);
            return created is not null ? null : error ?? "Failed to create department.";
        }
        else
        {
            var request = new UpdateDepartmentRequest(
                CompanyId,
                Id!.Value,
                Model.Name.Trim(),
                string.IsNullOrWhiteSpace(Model.Description) ? null : Model.Description.Trim(),
                Model.ParentDepartmentId,
                Model.ManagerEmployeeId);

            var (updated, error) = await DepartmentService.UpdateDepartmentAsync(CompanyId, Id!.Value, request);
            return updated is not null ? null : error ?? "Failed to save department.";
        }
    }

    protected override string? ListUrl => $"/companies/{CompanyId}/departments";
}
