@page "/invite/{Token}"
@layout HR.Web.Components.Layout.LoginLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@inject InviteService InviteService
@inject NavigationManager Navigation

<PageTitle>Accept Invitation — One Big Team</PageTitle>

<div class="login-card">
    <div class="login-brand">
        <img src="/images/logo.png" alt="One Big Team" class="login-logo-img" />
    </div>

    @if (_success)
    {
        <h1 class="login-heading">Account activated</h1>
        <p class="login-subheading">Your password has been set. You can now sign in.</p>

        <a href="/login" class="login-back-link" data-testid="back-to-login">Back to sign in</a>
    }
    else
    {
        <h1 class="login-heading">Welcome to One Big Team</h1>
        <p class="login-subheading">Set a password to activate your account.</p>

        <EditForm EditContext="_editContext" OnValidSubmit="Submit">
            <DataAnnotationsValidator />

            @if (_error is not null)
            {
                <div class="login-error">
                    <i class="fa-solid fa-circle-exclamation"></i> @_error
                </div>
            }

            <div class="login-field">
                <label class="login-label">Password</label>
                <div class="login-password-field">
                    <HrTextBox @bind-Value="_model.Password"
                               Placeholder="Choose a password"
                               Type="@(_showPassword ? InputType.Text : InputType.Password)"
                               Input="@(() => _error = null)" />
                    <button type="button"
                            class="login-password-toggle"
                            aria-pressed="@_showPassword.ToString().ToLowerInvariant()"
                            aria-label="@(_showPassword ? "Hide password" : "Show password")"
                            @onclick="() => _showPassword = !_showPassword">
                        @(_showPassword ? "Hide" : "Show")
                    </button>
                </div>
                <ValidationMessage For="@(() => _model.Password)" class="login-validation" />
            </div>

            <div class="login-field">
                <label class="login-label">Confirm password</label>
                <HrTextBox @bind-Value="_model.Confirm"
                           Placeholder="Repeat password"
                           Type="@(_showPassword ? InputType.Text : InputType.Password)"
                           Input="@(() => _error = null)" />
                <ValidationMessage For="@(() => _model.Confirm)" class="login-validation" />
            </div>

            <SfButton IsPrimary="true"
                      Type="ButtonType.Submit"
                      Disabled="@_saving"
                      CssClass="login-btn">
                @if (_saving)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                }
                Activate account
            </SfButton>
        </EditForm>
    }
</div>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    private readonly AcceptInviteFormModel _model = new();
    private EditContext _editContext = default!;

    private bool _saving;
    private bool _success;
    private bool _showPassword;
    private string? _error;

    protected override void OnInitialized() => _editContext = new EditContext(_model);

    private async Task Submit()
    {
        _error = null;

        _saving = true;
        var (success, error) = await InviteService.AcceptInviteAsync(Token, _model.Password);
        _saving = false;

        if (success)
            _success = true;
        else
            _error = error;
    }

    public sealed class AcceptInviteFormModel
    {
        [Required(ErrorMessage = "Password is required.")]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters.")]
        public string Password { get; set; } = string.Empty;
        [Required(ErrorMessage = "Please confirm your password.")]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match.")]
        public string Confirm { get; set; } = string.Empty;
    }
}
