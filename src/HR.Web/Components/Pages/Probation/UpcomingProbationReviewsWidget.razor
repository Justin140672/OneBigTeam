@inject ProbationService ProbationService
@inject NavigationManager Navigation
@inject AppSession Session

@if (Session.CanManageEmployees || Session.IsManager)
{
    @if (_loading)
    {
        <div class="widget-card">
            <div class="widget-header">
                <i class="fa-solid fa-clipboard-list widget-icon"></i>
                <span class="widget-title">Upcoming Probation Reviews</span>
            </div>
            <div class="widget-body d-flex align-items-center gap-2 py-3 px-3">
                <HrLoadingIndicator />
            </div>
        </div>
    }
    else
    {
        <div class="widget-card">
            <div class="widget-header">
                <i class="fa-solid fa-clipboard-list widget-icon"></i>
                <span class="widget-title">Upcoming Probation Reviews</span>
                @if (_items.Count > 0)
                {
                    <span class="widget-count-badge">@_items.Count</span>
                }
            </div>

            @if (_overdue > 0 || _dueSoon > 0)
            {
                <div class="widget-stats">
                    @if (_overdue > 0)
                    {
                        <div class="widget-stat widget-stat--danger">
                            <i class="fa-solid fa-triangle-exclamation fa-xs"></i>
                            <span class="widget-stat-value">@_overdue</span>
                            <span class="widget-stat-label">overdue</span>
                        </div>
                    }
                    @if (_dueSoon > 0)
                    {
                        <div class="widget-stat">
                            <span class="widget-stat-value">@_dueSoon</span>
                            <span class="widget-stat-label">due this week</span>
                        </div>
                    }
                </div>
            }

            <div class="widget-body">
                @if (_items.Count == 0)
                {
                    <div class="widget-empty">
                        <i class="fa-solid fa-circle-check fa-lg mb-2"></i>
                        <p class="mb-0">No upcoming reviews</p>
                    </div>
                }
                else
                {
                    @foreach (var item in _items.Take(5))
                    {
                        var r = item;
                        var (dueLabel, dueCss) = DueBadge(r.DueDate);
                        var name = EmployeeName(r.EmployeeId);
                        <div @key="r.ReviewId" class="task-widget-item"
                             @onclick="() => OnReviewClicked(r)">
                            <span class="priority-pip priority-pip--@DuePip(r.DueDate)"></span>
                            <div class="task-widget-content">
                                <span class="task-widget-title">@name</span>
                                <span class="task-widget-meta">@FormatReviewType(r.ReviewType)</span>
                            </div>
                            <span class="due-badge due-badge--@dueCss">@dueLabel</span>
                        </div>
                    }
                }
            </div>
        </div>
    }
}

@code {
    [Parameter] public EventCallback<Guid> OnOpenTask { get; set; }

    private bool _loading = true;
    private IReadOnlyList<UpcomingProbationReviewItem> _items = [];
    private IReadOnlyDictionary<Guid, string> _employeeNames = new Dictionary<Guid, string>();
    private int _overdue;
    private int _dueSoon;
    private DateOnly _today;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.CanManageEmployees && !Session.IsManager)
        {
            _loading = false;
            return;
        }

        _today = DateOnly.FromDateTime(DateTime.UtcNow);

        var reviewsTask   = ProbationService.GetUpcomingReviewsAsync(Session.CompanyId);
        var employeesTask = Session.GetEmployeeNamesAsync();

        await Task.WhenAll(reviewsTask, employeesTask);

        _items = await reviewsTask;
        _employeeNames = await employeesTask;

        _overdue  = _items.Count(r => r.DueDate < _today);
        _dueSoon  = _items.Count(r => r.DueDate >= _today && r.DueDate <= _today.AddDays(7));
        _loading  = false;
    }

    // Opens the review task dialog when one exists (the normal case — GenerateDueProbationReviewsJob
    // always creates one per review), falling back to the employee's Probation tab for the rare
    // review that predates task creation and has no open task to show.
    private async Task OnReviewClicked(UpcomingProbationReviewItem item)
    {
        if (item.TaskId is { } taskId && OnOpenTask.HasDelegate)
        {
            await OnOpenTask.InvokeAsync(taskId);
            return;
        }

        Navigation.NavigateTo($"/companies/{Session.CompanyId}/employees/{item.EmployeeId}?tab=probation");
    }

    private string EmployeeName(Guid employeeId) =>
        _employeeNames.TryGetValue(employeeId, out var name) ? name : "Employee";

    private static string FormatReviewType(string reviewType) => reviewType switch
    {
        "ManagerCheckIn"        => "Manager Check-in",
        "HrReview"              => "HR Review",
        "FinalDecision"         => "Final Decision",
        "ExtensionConfirmation" => "Extension",
        _                       => reviewType
    };

    private (string Label, string Css) DueBadge(DateOnly due)
    {
        if (due < _today)              return ("Overdue",  "overdue");
        if (due == _today)             return ("Today",    "today");
        if (due == _today.AddDays(1))  return ("Tomorrow", "soon");
        if (due <= _today.AddDays(7))  return (due.ToString("d MMM"), "soon");
        return (due.ToString("d MMM"),                                 "normal");
    }

    private string DuePip(DateOnly due) =>
        due < _today                   ? "critical" :
        due == _today                  ? "high" :
        due <= _today.AddDays(7)       ? "medium" :
        "low";
}
