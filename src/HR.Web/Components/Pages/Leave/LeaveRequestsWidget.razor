@using HR.Web.Components.Pages.Dashboards
@inject LeaveService LeaveService
@inject WidgetSourceLoader SourceLoader
@inject AppSession Session

@if (_loading)
{
    <div class="widget-card">
        <div class="widget-header">
            <i class="fa-solid fa-plane-departure widget-icon"></i>
            <div>
                <span class="widget-title">Leave Requests</span>
                @if (Session.IsHrAdministrator)
                {
                    <span class="widget-subtitle">Approved requests hide once leave starts</span>
                }
            </div>
        </div>
        <div class="widget-body d-flex align-items-center gap-2 py-3 px-3">
            <HrLoadingIndicator Label="Loading leave requests…" />
        </div>
    </div>
}
else
{
    <div class="widget-card">
        <div class="widget-header">
            <i class="fa-solid fa-plane-departure widget-icon"></i>
            <div>
                <span class="widget-title">Leave Requests</span>
                @if (Session.IsHrAdministrator)
                {
                    <span class="widget-subtitle">Approved requests hide once leave starts</span>
                }
            </div>
            @if (_items.Count > 0)
            {
                <span class="widget-count-badge ms-auto">@_items.Count</span>
            }
        </div>

        @if (_result.IsFailed)
        {
            <WidgetSourceWarning SourceName="Leave requests" Retrying="_retrying" OnRetry="RetryAsync" />
        }
        else
        {
        <div class="widget-body">
            @if (_items.Count == 0)
            {
                <div class="widget-empty">
                    <i class="fa-solid fa-circle-check fa-lg mb-2"></i>
                    <p class="mb-0">No recent leave requests</p>
                </div>
            }
            else
            {
                @foreach (var item in _items.Take(5))
                {
                    var i = item;
                    <div @key="i.LeaveRequestId" class="task-widget-item @(IsActionable(i) ? "" : "task-widget-item--static")" @onclick="() => OnRequestClicked(i)">
                        <div class="task-widget-content">
                            <span class="task-widget-title">@i.EmployeeName</span>
                            <span class="task-widget-meta">@i.LeaveTypeName · @i.StartDate.ToString("d MMM") – @i.EndDate.ToString("d MMM")</span>
                        </div>
                        <span class="due-badge due-badge--@StatusCss(i.Status)">@i.Status</span>
                    </div>
                }
            }
        </div>
        }
    </div>
}

@code {
    [Parameter] public EventCallback<Guid> OnOpenTask { get; set; }

    private bool _loading = true;
    private bool _retrying;
    private WidgetResult<GetRecentLeaveRequestsResponse?> _result = WidgetResult<GetRecentLeaveRequestsResponse?>.Loading("Leave requests");
    private List<RecentLeaveRequestItem> _items = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        _result = await SourceLoader.LoadAsync("Leave Requests", "Leave requests",
            () => LeaveService.GetRecentLeaveRequestsOrThrowAsync(Session.CompanyId));

        _items = _result.IsLoaded ? _result.Value?.Items.ToList() ?? [] : [];
    }

    private async Task RetryAsync()
    {
        _retrying = true;
        StateHasChanged();
        await LoadAsync();
        _retrying = false;
    }

    private static string StatusCss(string status) => status switch
    {
        "Pending"  => "soon",
        "Approved" => "approved",
        "Declined" => "overdue",
        "Rejected" => "overdue",
        _          => "normal",
    };

    // Only a Pending request has an approval decision to make — anything else (Approved, Declined,
    // Rejected, etc.) is a past outcome with nothing actionable behind it, so clicking it does
    // nothing rather than falling through to some other navigation.
    private static bool IsActionable(RecentLeaveRequestItem item) => item.Status == "Pending";

    private async Task OnRequestClicked(RecentLeaveRequestItem item)
    {
        if (!IsActionable(item)) return;

        if (item.TaskId.HasValue && OnOpenTask.HasDelegate)
            await OnOpenTask.InvokeAsync(item.TaskId.Value);
    }
}
