@page "/companies/{CompanyId:guid}/leave-policies"
@rendermode InteractiveServer
@inherits SearchPageBase<LeavePolicyListItemModel>
@inject LeavePolicyService LeavePolicyService
@inject AppSession Session

<PageTitle>Leave Policies</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-1">Leave Policies</h1>
    <p class="text-muted mb-3">Configure the entitlement, carry-over, and balance rules employees are assigned to.</p>

    @if (IsLoading)
    {
        <div class="d-flex align-items-center gap-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Loading leave policies…</span>
        </div>
    }
    else if (Error is not null)
    {
        <div class="alert alert-danger">@Error</div>
    }
    else
    {
        @if (ActionError is not null)
        {
            <div class="alert alert-danger alert-dismissible">
                @ActionError
                <button type="button" class="btn-close" @onclick="ClearActionError"></button>
            </div>
        }

        <HrGrid @ref="Grid"
                TValue="LeavePolicyListItemModel"
                DataSource="@Items"
                Toolbar="@GridToolbar"
                AllowFiltering="true">
            <GridEvents TValue="LeavePolicyListItemModel" OnToolbarClick="OnToolbarClick"
                        RowSelected="OnRowSelected" RowDeselected="OnRowDeselected" />
            <GridPageSettings PageSize="20" />
            <GridColumns>
                <GridColumn Field="@nameof(LeavePolicyListItemModel.Name)" HeaderText="Name" Width="220">
                    <Template>
                        @{
                            var row = (context as LeavePolicyListItemModel)!;
                            <a href="/companies/@CompanyId/leave-policies/@row.Id">@row.Name</a>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(LeavePolicyListItemModel.Description)" HeaderText="Description" Width="280" />
                <GridColumn Field="@nameof(LeavePolicyListItemModel.CarryOverDays)" HeaderText="Carry Over Days" Width="150" />
                <GridColumn Field="@nameof(LeavePolicyListItemModel.AllowNegativeBalance)" HeaderText="Allow Negative" Width="150">
                    <Template>
                        @{
                            var row = (context as LeavePolicyListItemModel)!;
                            <span class="badge @(row.AllowNegativeBalance ? "bg-warning text-dark" : "bg-secondary")">
                                @(row.AllowNegativeBalance ? "Yes" : "No")
                            </span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(LeavePolicyListItemModel.IsActive)" HeaderText="Status" Width="110">
                    <Template>
                        @{
                            var row = (context as LeavePolicyListItemModel)!;
                            <span class="badge @(row.IsActive ? "bg-success" : "bg-secondary")">
                                @(row.IsActive ? "Active" : "Inactive")
                            </span>
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </HrGrid>
    }
</div>

@code {
    protected override bool SupportsActiveFilter => true;

    protected override Task OnBeforeLoadAsync()
    {
        if (!Session.CanManageEmployees)
            Navigation.NavigateTo(Session.MyProfileUrl, replace: true);
        return Task.CompletedTask;
    }

    protected override async Task<IReadOnlyList<LeavePolicyListItemModel>?> FetchItemsAsync(string? search)
    {
        var result = await LeavePolicyService.ListLeavePoliciesAsync(CompanyId, activeOnly: !ShowInactive);
        return result?.Items;
    }

    protected override string LoadErrorMessage => "Failed to load leave policies.";

    protected override string? GetAddUrl()  => $"/companies/{CompanyId}/leave-policies/new";
    protected override string? GetEditUrl(LeavePolicyListItemModel item) => $"/companies/{CompanyId}/leave-policies/{item.Id}";
    protected override string? GetViewUrl(LeavePolicyListItemModel item) => $"/companies/{CompanyId}/leave-policies/{item.Id}/view";
}
