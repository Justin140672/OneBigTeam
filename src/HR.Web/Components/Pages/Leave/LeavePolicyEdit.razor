@page "/companies/{CompanyId:guid}/leave-policies/new"
@page "/companies/{CompanyId:guid}/leave-policies/{Id:guid}"
@page "/companies/{CompanyId:guid}/leave-policies/{Id:guid}/view"
@rendermode InteractiveServer
@inject LeavePolicyService LeavePolicyService
@inject NavigationManager Navigation

<PageTitle>@PageTitle</PageTitle>

<div class="container py-4">
    <SfBreadcrumb Class="mb-3">
        <BreadcrumbItems>
            <BreadcrumbItem Text="Leave Policies" Url="@($"/companies/{CompanyId}/leave-policies")" />
            <BreadcrumbItem Text="@PageTitle" />
        </BreadcrumbItems>
    </SfBreadcrumb>

    @if (_loading)
    {
        <div class="d-flex align-items-center gap-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Loading…</span>
        </div>
    }
    else
    {
        <h1 class="mb-1">@PageTitle</h1>
        <p class="text-muted mb-4">Set the entitlement, carry-over, and balance rules this policy applies.</p>

        @if (!string.IsNullOrEmpty(_globalError))
        {
            <div class="alert alert-danger">@_globalError</div>
        }

        <div class="row">
            <div class="col-lg-7">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Leave Policy Details</h5>
                    </div>
                    <div class="card-body @(_isViewMode ? "view-mode" : "")">
                        <div class="mb-3">
                            <label class="form-label">Name <span class="text-danger">*</span></label>
                            <HrTextBox @bind-Value="_model.Name" Placeholder="e.g. Standard Policy" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <HrTextBox @bind-Value="_model.Description" Placeholder="Optional description" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Carry Over Days <span class="text-danger">*</span></label>
                            <SfNumericTextBox TValue="int" @bind-Value="_model.CarryOverDays"
                                             Min="0" Step="1" />
                        </div>
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="allowNegativeBalance"
                                       @bind="_model.AllowNegativeBalance" />
                                <label class="form-check-label" for="allowNegativeBalance">Allow negative balance</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    @if (!_isViewMode)
                    {
                        @if (!string.IsNullOrEmpty(_successMsg))
                        {
                            <div class="alert alert-success py-2 mb-0 d-flex align-items-center">@_successMsg</div>
                        }
                        <SfButton IsPrimary="true" Disabled="@_saving" OnClick="Save">
                            @if (_saving)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            Save
                        </SfButton>
                    }
                    <SfButton OnClick="Cancel" Disabled="@_saving">@(_isViewMode ? "Close" : "Cancel")</SfButton>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid? Id { get; set; }

    private bool _isViewMode;
    private bool IsNew => Id is null || Id == Guid.Empty;
    private string PageTitle => IsNew ? "Add Leave Policy"
        : _model.Name.Trim().Length > 0 ? _model.Name
        : _isViewMode ? "View Leave Policy" : "Edit Leave Policy";

    private bool _loading = true;
    private bool _saving;
    private string? _globalError;
    private string? _successMsg;

    private readonly LeavePolicyEditModel _model = new();

    protected override async Task OnParametersSetAsync()
    {
        _isViewMode = Navigation.Uri.Contains("/view", StringComparison.OrdinalIgnoreCase);
        _loading = true;
        _globalError = null;
        _successMsg = null;

        if (!IsNew)
        {
            var list = await LeavePolicyService.ListLeavePoliciesAsync(CompanyId);
            var existing = list?.Items.FirstOrDefault(p => p.Id == Id);
            if (existing is not null)
            {
                _model.Name = existing.Name;
                _model.Description = existing.Description;
                _model.CarryOverDays = existing.CarryOverDays;
                _model.AllowNegativeBalance = existing.AllowNegativeBalance;
            }
        }

        _loading = false;
    }

    private async Task Save()
    {
        _saving = true;
        _globalError = null;
        _successMsg = null;

        if (IsNew)
        {
            var request = new CreateLeavePolicyRequest(
                CompanyId,
                _model.Name.Trim(),
                string.IsNullOrWhiteSpace(_model.Description) ? null : _model.Description.Trim(),
                _model.CarryOverDays,
                _model.AllowNegativeBalance);

            var (created, error) = await LeavePolicyService.CreateAsync(CompanyId, request);
            _saving = false;

            if (created is not null)
                Navigation.NavigateTo($"/companies/{CompanyId}/leave-policies", forceLoad: true);
            else
                _globalError = error ?? "Failed to create leave policy.";
        }
        else
        {
            var request = new UpdateLeavePolicyRequest(
                CompanyId,
                Id!.Value,
                _model.Name.Trim(),
                string.IsNullOrWhiteSpace(_model.Description) ? null : _model.Description.Trim(),
                _model.CarryOverDays,
                _model.AllowNegativeBalance);

            var (updated, error) = await LeavePolicyService.UpdateAsync(CompanyId, Id!.Value, request);
            _saving = false;

            if (updated is not null)
                Navigation.NavigateTo($"/companies/{CompanyId}/leave-policies", forceLoad: true);
            else
                _globalError = error ?? "Failed to save leave policy.";
        }
    }

    private void Cancel() => Navigation.NavigateTo($"/companies/{CompanyId}/leave-policies");
}
