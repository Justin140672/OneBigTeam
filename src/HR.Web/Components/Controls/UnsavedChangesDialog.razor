@* Kept mounted and toggled via Visible (not wrapped in @if) so Syncfusion's SfDialog runs its
   normal open/close lifecycle — including returning keyboard focus to whatever was focused when
   it opened (the control/nav-link that triggered the unsaved-changes check), the same reasoning
   as HrConfirmDialog (see that file's header comment). An @if wrapper tears the dialog out of the
   render tree before that focus-restoration can run, dropping focus to <body>.
   Escape key, the close icon, and a backdrop click all behave as Cancel — matching
   HrConfirmDialog's soft-cancel convention — except while Busy, when they're ignored so an
   in-progress Save/Discard can't be raced by a stray close. *@
<SfDialog CssClass="hr-dialog" Visible="Visible" IsModal="true" Width="420px" ShowCloseIcon="true">
    <DialogEvents Closed="HandleClosed" />
    <DialogTemplates>
        <Header>Unsaved Changes</Header>
        <Content>You have unsaved changes. Do you want to save them before leaving?</Content>
        <FooterTemplate>
            @* Footer order matches the other shared dialogs: least-committal action first,
               primary/confirming action ("Save") rightmost. *@
            <SfButton Disabled="_busy" OnClick="HandleCancelClicked">Cancel</SfButton>
            <SfButton CssClass="e-danger e-outline" Disabled="_busy" OnClick="HandleDiscardClicked">Discard Changes</SfButton>
            <SfButton IsPrimary="true" Disabled="_busy" OnClick="HandleSaveClicked">
                @if (_busy)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                Save
            </SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnSaveAndClose { get; set; }
    [Parameter] public EventCallback OnDiscard { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    // Local-only busy flag covering the async Save/Discard round-trip (validation, the HTTP
    // call, and any resulting navigation) so a slow response can't be raced by a duplicate
    // click — mirrors HrConfirmDialog's Busy handling, but tracked internally here since none of
    // the ~39 call sites pass their own Saving/Busy state in as a parameter.
    private bool _busy;

    // The footer Cancel button and the close-icon/Escape/backdrop path both need to end in
    // OnCancel — but the footer button already invokes it directly, and SfDialog's Closed event
    // then fires anyway once Visible flips to false in response, which would invoke OnCancel a
    // second time. Mirrors HrConfirmDialog's/EditDialogBase's _suppressNextClosedEvent guard.
    private bool _suppressNextClosed;

    private Task HandleClosed()
    {
        if (_suppressNextClosed)
        {
            _suppressNextClosed = false;
            return Task.CompletedTask;
        }

        return _busy ? Task.CompletedTask : OnCancel.InvokeAsync();
    }

    private Task HandleCancelClicked()
    {
        _suppressNextClosed = true;
        return OnCancel.InvokeAsync();
    }

    private async Task HandleSaveClicked()
    {
        _suppressNextClosed = true;
        _busy = true;
        try
        {
            await OnSaveAndClose.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task HandleDiscardClicked()
    {
        _suppressNextClosed = true;
        _busy = true;
        try
        {
            await OnDiscard.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
