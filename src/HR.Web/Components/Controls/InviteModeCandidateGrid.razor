@using HR.Web.Models
@using HR.Web.Services
@using Syncfusion.Blazor.Buttons
@inject UserAdministrationService UserAdministrationService

<div class="invite-mode-candidate-grid">
    @if (_loading)
    {
        <HrLoadingIndicator Label="Loading invitable employees…" />
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else
    {
        <div class="d-flex align-items-center gap-2 mb-2">
            <SfButton CssClass="e-small" OnClick="SelectAllEligibleAsync">Select all eligible</SfButton>
            <SfButton CssClass="e-small" OnClick="ClearSelectionAsync">Clear selection</SfButton>
            <span class="text-muted">@SelectedCount selected</span>
            <span class="ms-auto">
                <SfButton id="invite-mode-invite-selected-btn" IsPrimary="true" Disabled="@(SelectedCount == 0)" OnClick="InviteSelectedClickedAsync">
                    Invite selected (@SelectedCount)
                </SfButton>
            </span>
        </div>

        @* Selection is owned by this component (_selectedIds, keyed by EmployeeId) and rendered
           through the checkbox template below — NOT Syncfusion row selection. SfGrid's
           SelectRowsAsync(int[]) only applies to the CURRENT page's row indexes, so the previous
           "select every eligible index" pass silently skipped every eligible employee past page 1
           (PageSize=20), and its indexes were into the unsorted/unfiltered source list, so they
           pointed at the wrong rows as soon as the grid was sorted or filtered. PersistSelection
           also requires a primary-key column, which this grid never had. Rendering the checkbox
           from server-side state keeps it correct across paging, sorting and filtering, with no
           JS-interop selection round-trip to race. *@
        <HrGrid TValue="InvitableEmployeeModel"
                DataSource="@_candidates"
                class="invite-mode-grid"
                AllowPaging="true"
                AllowSorting="true"
                AllowFiltering="true"
                AllowSelection="false">
            <GridPageSettings PageSize="20" />
            <GridColumns>
                <GridColumn HeaderText="Select" Width="70" AllowSorting="false" AllowFiltering="false">
                    <Template>
                        @{
                            var row = (context as InvitableEmployeeModel)!;
                        }
                        <SfCheckBox TChecked="bool"
                                    Checked="@_selectedIds.Contains(row.EmployeeId)"
                                    CheckedChanged="@((bool isChecked) => OnRowCheckedChanged(row.EmployeeId, isChecked))"
                                    HtmlAttributes="@(new Dictionary<string, object> { ["aria-label"] = $"Select {row.Name}" })" />
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(InvitableEmployeeModel.Name)" HeaderText="Employee" Width="220">
                    <Template>
                        @{
                            var row = (context as InvitableEmployeeModel)!;
                            <a href="/companies/@CompanyId/employees/@row.EmployeeId">@row.Name</a>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(InvitableEmployeeModel.WorkEmail)" HeaderText="Work Email" Width="220">
                    <Template>
                        @{
                            var row = (context as InvitableEmployeeModel)!;
                        }
                        @if (string.IsNullOrWhiteSpace(row.WorkEmail))
                        {
                            <span class="text-danger">
                                No work email —
                                <a href="/companies/@CompanyId/employees/@row.EmployeeId">correct this employee's record</a>
                            </span>
                        }
                        else
                        {
                            @row.WorkEmail
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(InvitableEmployeeModel.PositionTitle)" HeaderText="Position" Width="180" />
            </GridColumns>
        </HrGrid>

        <div class="invite-mode-grid-summary mb-2">@_candidates.Count candidate(s)</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter] public bool CanManageUsers { get; set; }
    [Parameter] public EventCallback<(List<InvitationRecipientCandidate> Recipients, List<InvitationExclusionCandidate> Excluded)> OnInviteSelectedRequested { get; set; }

    private bool _loading = true;
    private string? _error;
    private List<InvitableEmployeeModel> _candidates = [];

    // The authoritative selection, across every page/sort/filter of the grid.
    private readonly HashSet<Guid> _selectedIds = [];

    // Employees the admin has explicitly unchecked during this page visit — never re-auto-selected
    // for the lifetime of this component instance (e.g. across ReloadAsync after a batch is sent).
    private readonly HashSet<Guid> _userDeselected = [];
    private Guid? _loadedForCompanyId;

    private int SelectedCount => _selectedIds.Count;

    // Blazor invokes OnParametersSetAsync on every parent re-render that reaches this component
    // (e.g. any StateHasChanged() in EmployeeList.razor for pagination, selection summaries,
    // etc.), not just when CompanyId actually changes. Only reload when the company we last
    // loaded for has changed — otherwise every unrelated parent re-render would wipe _loading
    // back to true, hide the grid/button behind the loading indicator, and reset the selection.
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedForCompanyId == CompanyId)
            return;

        _loadedForCompanyId = CompanyId;
        await LoadCandidatesAsync();
    }

    private async Task LoadCandidatesAsync()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        var result = await UserAdministrationService.GetInvitableEmployeesAsync(CompanyId);
        if (result is null)
        {
            _error = "Failed to load invitable employees.";
            _loading = false;
            return;
        }

        _candidates = result;

        // Preselect every eligible employee (has a work email) the admin hasn't explicitly
        // unchecked. Done on the data, not the grid, so it covers every page at once.
        _selectedIds.Clear();
        foreach (var id in EligibleIds())
            _selectedIds.Add(id);

        _loading = false;
    }

    public async Task ReloadAsync()
    {
        await LoadCandidatesAsync();
        StateHasChanged();
    }

    private IEnumerable<Guid> EligibleIds() =>
        _candidates
            .Where(c => !string.IsNullOrWhiteSpace(c.WorkEmail) && !_userDeselected.Contains(c.EmployeeId))
            .Select(c => c.EmployeeId);

    private void OnRowCheckedChanged(Guid employeeId, bool isChecked)
    {
        if (isChecked)
        {
            _selectedIds.Add(employeeId);
            _userDeselected.Remove(employeeId);
        }
        else
        {
            _selectedIds.Remove(employeeId);
            _userDeselected.Add(employeeId);
        }
    }

    private Task SelectAllEligibleAsync()
    {
        _userDeselected.Clear();
        _selectedIds.Clear();
        foreach (var id in EligibleIds())
            _selectedIds.Add(id);
        StateHasChanged();
        return Task.CompletedTask;
    }

    public Task ClearSelectionAsync()
    {
        _selectedIds.Clear();
        _userDeselected.Clear();
        foreach (var candidate in _candidates)
            _userDeselected.Add(candidate.EmployeeId);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task InviteSelectedClickedAsync()
    {
        var selected = _candidates.Where(c => _selectedIds.Contains(c.EmployeeId)).ToList();
        if (selected.Count == 0) return;

        var recipients = new List<InvitationRecipientCandidate>();
        var excluded = new List<InvitationExclusionCandidate>();

        foreach (var row in selected)
        {
            if (string.IsNullOrWhiteSpace(row.WorkEmail))
            {
                excluded.Add(new(row.Name, null, "MissingEmail"));
                continue;
            }
            recipients.Add(new(row.EmployeeId, row.Name, row.WorkEmail));
        }

        await OnInviteSelectedRequested.InvokeAsync((recipients, excluded));
    }
}
