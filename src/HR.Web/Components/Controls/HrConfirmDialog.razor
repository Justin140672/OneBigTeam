@* Kept mounted and toggled via Visible (not wrapped in @if) so Syncfusion's SfDialog runs its
   normal open/close lifecycle — including returning keyboard focus to the element that was
   focused when it opened (NFR-05). An @if wrapper tears the dialog out of the render tree before
   that focus-restoration can run, dropping focus to <body>. This is also referenced by name in
   issue 4's unsaved-changes-dialog focus fix — do not change this mount strategy here. *@
<SfDialog CssClass="hr-dialog" Visible="Visible" IsModal="true" Width="420px" ShowCloseIcon="true">
    <DialogEvents Closed="HandleClosed" />
    <DialogTemplates>
        <Header>@Title</Header>
        <Content>@Message</Content>
        <FooterTemplate>
            @* Footer button order convention used by every shared Hr*Dialog: secondary/cancel
               action first, primary/confirming action rightmost. *@
            <SfButton Disabled="Busy" OnClick="HandleCancelClicked">@CancelText</SfButton>
            <SfButton IsPrimary="true" CssClass="@(DangerConfirm ? "e-danger" : "")" Disabled="Busy" OnClick="HandleConfirmClicked">
                @if (Busy)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                @ConfirmText
            </SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string Title { get; set; } = "Confirm";
    [Parameter] public string Message { get; set; } = "Are you sure?";
    [Parameter] public string ConfirmText { get; set; } = "Yes";
    [Parameter] public string CancelText { get; set; } = "No";
    [Parameter] public bool DangerConfirm { get; set; } = true;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnConfirmed { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    private bool _suppressNextClosed;

    private Task HandleClosed()
    {
        if (_suppressNextClosed)
        {
            _suppressNextClosed = false;
            return Task.CompletedTask;
        }

        return Busy ? Task.CompletedTask : OnCancelled.InvokeAsync();
    }

    private Task HandleCancelClicked()
    {
        _suppressNextClosed = true;
        return OnCancelled.InvokeAsync();
    }

    private Task HandleConfirmClicked()
    {
        _suppressNextClosed = true;
        return OnConfirmed.InvokeAsync();
    }
}
