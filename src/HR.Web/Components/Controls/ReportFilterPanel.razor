@using System.Text.Json
@using HR.Web.Models
@using HR.Web.Services
@inject DepartmentService DepartmentService
@inject LocationService LocationService
@inject PositionProfileService PositionProfileService
@inject EmploymentTypeService EmploymentTypeService
@inject EmployeeService EmployeeService
@inject ReportingService ReportingService

<div class="card mb-3">
    <div class="card-body">
        <div class="report-filter-toolbar d-flex justify-content-end mb-2">
            <SfButton CssClass="e-primary e-small" IconCss="e-icons e-save" OnClick="@(() => _showSaveAs = true)">Save</SfButton>
        </div>
        <div class="row g-3 align-items-end mb-2">
            <div class="col-md-4">
                <label class="form-label">Saved Views</label>
                <SfDropDownList TValue="Guid?"
                                TItem="SavedViewOption"
                                DataSource="@_savedViewOptions"
                                Value="@_selectedViewId"
                                ValueChanged="OnSavedViewSelectedAsync"
                                Placeholder="Select a saved view"
                                AllowFiltering="true"
                                ShowClearButton="true">
                    <DropDownListFieldSettings Value="Id" Text="DisplayText" />
                </SfDropDownList>
            </div>
            @if (_selectedView is not null)
            {
                <div class="col-md-auto d-flex gap-2 pb-1">
                    <SfButton CssClass="e-outline e-small" OnClick="StartRenameAsync">Rename</SfButton>
                    <SfButton CssClass="e-outline e-small" Disabled="_selectedView.IsDefault" OnClick="SetDefaultAsync">Set Default</SfButton>
                    <SfButton CssClass="e-outline e-small e-danger" OnClick="DeleteSelectedViewAsync">Delete</SfButton>
                </div>
            }
        </div>

        @if (_showSaveAs)
        {
            <SfDialog Visible="_showSaveAs" IsModal="true" Width="420px" ShowCloseIcon="true" CssClass="report-save-view-dialog">
                <DialogEvents Closed="@(() => _showSaveAs = false)" />
                <DialogTemplates>
                    <Header>Save current filters as view</Header>
                    <Content>
                        <label class="form-label">View name</label>
                        <HrTextBox @bind-Value="_newViewName" Placeholder="View name" />
                    </Content>
                    <FooterTemplate>
                        <SfButton CssClass="e-success e-small" Disabled="@(string.IsNullOrWhiteSpace(_newViewName))" OnClick="SaveCurrentAsViewAsync">Save</SfButton>
                        <SfButton CssClass="e-outline e-small" OnClick="@(() => _showSaveAs = false)">Cancel</SfButton>
                    </FooterTemplate>
                </DialogTemplates>
            </SfDialog>
        }
        @if (_showRename)
        {
            <div class="row g-3 align-items-end mb-2">
                <div class="col-md-4">
                    <HrTextBox @bind-Value="_renameViewName" Placeholder="View name" />
                </div>
                <div class="col-md-auto pb-1 d-flex gap-2">
                    <SfButton CssClass="e-primary e-small" Disabled="@(string.IsNullOrWhiteSpace(_renameViewName))" OnClick="ConfirmRenameAsync">Save Name</SfButton>
                    <SfButton CssClass="e-outline e-small" OnClick="@(() => _showRename = false)">Cancel</SfButton>
                </div>
            </div>
        }
        @if (_savedViewError is not null)
        {
            <div class="alert alert-danger alert-dismissible py-2">
                @_savedViewError
                <button type="button" class="btn-close" @onclick="@(() => _savedViewError = null)"></button>
            </div>
        }
        <div class="row g-3">
            @if (ShowDepartmentFilter)
            {
                <div class="col-md-3">
                    <label class="form-label">Department</label>
                    <SfDropDownList TValue="Guid?"
                                    TItem="DepartmentListItemModel"
                                    DataSource="@_departments"
                                    @bind-Value="_departmentId"
                                    Placeholder="All Departments"
                                    AllowFiltering="true">
                        <DropDownListFieldSettings Value="Id" Text="Name" />
                    </SfDropDownList>
                </div>
            }
            @if (ShowLocationFilter)
            {
                <div class="col-md-3">
                    <label class="form-label">Location</label>
                    <SfDropDownList TValue="Guid?"
                                    TItem="LocationListItemModel"
                                    DataSource="@_locations"
                                    @bind-Value="_locationId"
                                    Placeholder="All Locations"
                                    AllowFiltering="true">
                        <DropDownListFieldSettings Value="Id" Text="Name" />
                    </SfDropDownList>
                </div>
            }
            @if (ShowPositionProfileFilter)
            {
                <div class="col-md-3">
                    <label class="form-label">Position Profile</label>
                    <SfDropDownList TValue="Guid?"
                                    TItem="PositionProfileListItemModel"
                                    DataSource="@_positionProfiles"
                                    @bind-Value="_positionProfileId"
                                    Placeholder="All Positions"
                                    AllowFiltering="true">
                        <DropDownListFieldSettings Value="Id" Text="Title" />
                    </SfDropDownList>
                </div>
            }
            @if (ShowManagerFilter)
            {
                <div class="col-md-3">
                    <label class="form-label">Manager</label>
                    <SfDropDownList @ref="_managerDropdown"
                                    TValue="Guid?"
                                    TItem="ManagerOption"
                                    DataSource="@_managerOptions"
                                    @bind-Value="_managerId"
                                    Placeholder="All Managers"
                                    AllowFiltering="true">
                        <DropDownListFieldSettings Value="Id" Text="Name" />
                        <DropDownListEvents TValue="Guid?" TItem="ManagerOption" Filtering="OnManagerFilteringAsync" />
                    </SfDropDownList>
                </div>
            }
            @if (ShowEmploymentTypeFilter)
            {
                <div class="col-md-3">
                    <label class="form-label">Employment Type</label>
                    <SfDropDownList TValue="Guid?"
                                    TItem="EmploymentTypeListItemModel"
                                    DataSource="@_employmentTypes"
                                    @bind-Value="_employmentTypeId"
                                    Placeholder="All Employment Types"
                                    AllowFiltering="true">
                        <DropDownListFieldSettings Value="Id" Text="Name" />
                    </SfDropDownList>
                </div>
            }
            @if (ShowStatusFilter)
            {
                <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <SfDropDownList TValue="string?"
                                    TItem="StatusOption"
                                    DataSource="@_statusOptions"
                                    @bind-Value="_employeeStatus"
                                    Placeholder="All Statuses">
                        <DropDownListFieldSettings Value="Value" Text="Label" />
                    </SfDropDownList>
                </div>
            }
            <div class="col-md-3">
                <label class="form-label">@DateRangeStartLabel</label>
                <SfDatePicker TValue="DateOnly?" @bind-Value="_dateRangeStart" Format="dd/MM/yyyy" Placeholder="dd/mm/yyyy" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@DateRangeEndLabel</label>
                <SfDatePicker TValue="DateOnly?" @bind-Value="_dateRangeEnd" Format="dd/MM/yyyy" Placeholder="dd/mm/yyyy" />
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <SfButton CssClass="e-primary e-small" OnClick="ApplyAsync">Apply Filters</SfButton>
            <SfButton CssClass="e-outline e-small" OnClick="ClearAsync">Clear</SfButton>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }

    [Parameter, EditorRequired] public string ReportId { get; set; } = string.Empty;

    [Parameter] public EventCallback<EmployeeDirectoryReportFilter> OnFilterChanged { get; set; }

    // Emits the shared filter criteria shape (Department/Location/PositionProfile/EmploymentType/DateRange)
    // for pages that don't use EmployeeDirectoryReportFilter directly (e.g. Employee Starter/Leaver reports).
    [Parameter] public EventCallback<ReportFilterCriteriaModel> OnCriteriaChanged { get; set; }

    [Parameter] public bool ShowDepartmentFilter { get; set; } = true;
    [Parameter] public bool ShowLocationFilter { get; set; } = true;
    [Parameter] public bool ShowPositionProfileFilter { get; set; } = true;
    [Parameter] public bool ShowManagerFilter { get; set; } = true;
    [Parameter] public bool ShowEmploymentTypeFilter { get; set; } = true;
    [Parameter] public bool ShowStatusFilter { get; set; } = true;
    [Parameter] public string DateRangeStartLabel { get; set; } = "Start Date From";
    [Parameter] public string DateRangeEndLabel { get; set; } = "Start Date To";

    // Optional initial value for the "date range start" filter, applied once on first render only
    // (e.g. the Employee Starters report defaults this to the 1st of the current month). A saved
    // default view, if one is applied during that same initial load, takes precedence.
    [Parameter] public DateOnly? DefaultDateRangeStart { get; set; }

    // Invoked after a saved view is successfully deleted, so the host page can refresh its grid data
    // (deleting a view does not, by itself, change the applied filters/grid contents).
    [Parameter] public EventCallback OnViewDeleted { get; set; }

    private List<DepartmentListItemModel> _departments = [];
    private List<LocationListItemModel> _locations = [];
    private List<PositionProfileListItemModel> _positionProfiles = [];
    private List<EmploymentTypeListItemModel> _employmentTypes = [];
    private List<ManagerOption> _managerOptions = [];
    private Syncfusion.Blazor.DropDowns.SfDropDownList<Guid?, ManagerOption> _managerDropdown = default!;

    private Guid? _departmentId;
    private Guid? _locationId;
    private Guid? _positionProfileId;
    private Guid? _managerId;
    private Guid? _employmentTypeId;
    private string? _employeeStatus;
    private DateOnly? _dateRangeStart;
    private DateOnly? _dateRangeEnd;

    private sealed record ManagerOption(Guid Id, string Name);
    private sealed record StatusOption(string Value, string Label);
    private sealed record SavedViewOption(Guid Id, string DisplayText, SavedReportViewModel View);

    private sealed record SavedFilterState(
        Guid? DepartmentId,
        Guid? LocationId,
        Guid? PositionProfileId,
        Guid? ManagerId,
        Guid? EmploymentTypeId,
        string? EmployeeStatus,
        DateOnly? DateRangeStart,
        DateOnly? DateRangeEnd);

    private List<SavedReportViewModel> _savedViews = [];
    private List<SavedViewOption> _savedViewOptions = [];
    private Guid? _selectedViewId;
    private SavedReportViewModel? _selectedView;
    private string? _savedViewError;
    private bool _showSaveAs;
    private string _newViewName = string.Empty;
    private bool _showRename;
    private string _renameViewName = string.Empty;

    private static readonly StatusOption[] _statusOptions =
    [
        new("Active", "Active"),
        new("Suspended", "Suspended"),
        new("Leaving", "Leaving"),
        new("FormerEmployee", "Former Employee"),
    ];

    private bool _defaultsApplied;

    protected override async Task OnParametersSetAsync()
    {
        if (!_defaultsApplied)
        {
            _defaultsApplied = true;
            _dateRangeStart ??= DefaultDateRangeStart;
        }

        var departmentsTask = DepartmentService.ListDepartmentsAsync(CompanyId);
        var locationsTask = LocationService.ListLocationsAsync(CompanyId);
        var positionProfilesTask = PositionProfileService.ListPositionProfilesAsync(CompanyId);
        var employmentTypesTask = EmploymentTypeService.ListEmploymentTypesAsync(CompanyId);
        var employeesTask = EmployeeService.ListEmployeesAsync(CompanyId, pageSize: 50);

        await Task.WhenAll(departmentsTask, locationsTask, positionProfilesTask, employmentTypesTask, employeesTask);

        _departments = (await departmentsTask)?.Items ?? [];
        _locations = (await locationsTask)?.Items ?? [];
        _positionProfiles = (await positionProfilesTask)?.Items.ToList() ?? [];
        _employmentTypes = (await employmentTypesTask)?.Items ?? [];
        _managerOptions = ((await employeesTask)?.Items ?? [])
            .Select(e => new ManagerOption(e.Id, $"{e.FirstName} {e.LastName}"))
            .OrderBy(m => m.Name)
            .ToList();

        await LoadSavedViewsAsync();
    }

    private async Task LoadSavedViewsAsync()
    {
        if (string.IsNullOrWhiteSpace(ReportId)) return;

        var response = await ReportingService.GetReportViewsAsync(CompanyId, ReportId);
        _savedViews = response?.Views ?? [];
        _savedViewOptions = _savedViews
            .Select(v => new SavedViewOption(v.Id, v.IsDefault ? $"{v.Name} (Default)" : v.Name, v))
            .OrderBy(o => o.View.Name)
            .ToList();
    }

    private async Task OnSavedViewSelectedAsync(Guid? viewId)
    {
        _selectedViewId = viewId;
        _showRename = false;
        _selectedView = _savedViews.FirstOrDefault(v => v.Id == viewId);

        if (_selectedView is null) return;

        try
        {
            var state = JsonSerializer.Deserialize<SavedFilterState>(_selectedView.FilterCriteriaJson);
            if (state is not null)
            {
                _departmentId = state.DepartmentId;
                _locationId = state.LocationId;
                _positionProfileId = state.PositionProfileId;
                _managerId = state.ManagerId;
                _employmentTypeId = state.EmploymentTypeId;
                _employeeStatus = state.EmployeeStatus;
                _dateRangeStart = state.DateRangeStart;
                _dateRangeEnd = state.DateRangeEnd;
            }
        }
        catch (JsonException)
        {
            _savedViewError = "Failed to apply the saved view's filters.";
            return;
        }

        await OnFilterChanged.InvokeAsync(BuildFilter());
        await OnCriteriaChanged.InvokeAsync(BuildCriteria());
    }

    private SavedFilterState BuildSavedFilterState() => new(
        _departmentId, _locationId, _positionProfileId, _managerId,
        _employmentTypeId, _employeeStatus, _dateRangeStart, _dateRangeEnd);

    private async Task SaveCurrentAsViewAsync()
    {
        if (string.IsNullOrWhiteSpace(_newViewName)) return;

        _savedViewError = null;
        var json = JsonSerializer.Serialize(BuildSavedFilterState());
        var request = new SaveReportViewRequest(ReportId, _newViewName.Trim(), json, null);
        var (result, error) = await ReportingService.SaveReportViewAsync(CompanyId, request);

        if (result is null)
        {
            _savedViewError = error ?? "Failed to save the current filters as a view.";
            return;
        }

        _newViewName = string.Empty;
        _showSaveAs = false;
        await LoadSavedViewsAsync();
        _selectedViewId = result.Id;
        _selectedView = _savedViews.FirstOrDefault(v => v.Id == result.Id);
    }

    private void StartRenameAsync()
    {
        if (_selectedView is null) return;
        _renameViewName = _selectedView.Name;
        _showRename = true;
    }

    private async Task ConfirmRenameAsync()
    {
        if (_selectedView is null || string.IsNullOrWhiteSpace(_renameViewName)) return;

        _savedViewError = null;
        var (result, error) = await ReportingService.RenameReportViewAsync(CompanyId, _selectedView.Id, _renameViewName.Trim());

        if (result is null)
        {
            _savedViewError = error ?? "Failed to rename the saved view.";
            return;
        }

        _showRename = false;
        await LoadSavedViewsAsync();
        _selectedView = _savedViews.FirstOrDefault(v => v.Id == result.Id);
    }

    private async Task SetDefaultAsync()
    {
        if (_selectedView is null) return;

        _savedViewError = null;
        var success = await ReportingService.SetDefaultReportViewAsync(CompanyId, _selectedView.Id);

        if (!success)
        {
            _savedViewError = "Failed to set the saved view as default.";
            return;
        }

        await LoadSavedViewsAsync();
        _selectedView = _savedViews.FirstOrDefault(v => v.Id == _selectedViewId);
    }

    private async Task DeleteSelectedViewAsync()
    {
        if (_selectedView is null) return;

        _savedViewError = null;
        var success = await ReportingService.DeleteReportViewAsync(CompanyId, _selectedView.Id);

        if (!success)
        {
            _savedViewError = "Failed to delete the saved view.";
            return;
        }

        // The deleted view was the currently-applied filter set, so reset to a cleared state
        // rather than leaving stale filters from a now-deleted view applied.
        _selectedViewId = null;
        _selectedView = null;
        _showRename = false;
        _departmentId = null;
        _locationId = null;
        _positionProfileId = null;
        _managerId = null;
        _employmentTypeId = null;
        _employeeStatus = null;
        _dateRangeStart = null;
        _dateRangeEnd = null;
        await LoadSavedViewsAsync();
        await OnFilterChanged.InvokeAsync(BuildFilter());
        await OnCriteriaChanged.InvokeAsync(BuildCriteria());
        await OnViewDeleted.InvokeAsync();
    }

    private int _managerFilterRequestId;

    // Requests aren't guaranteed to resolve in the order they were fired — applying every response
    // unconditionally means a late-arriving response for an earlier keystroke can land after the
    // user already picked a manager from a later, faster response, visibly clearing their
    // selection. Only the most recently issued request's response is applied.
    private async Task OnManagerFilteringAsync(Syncfusion.Blazor.DropDowns.FilteringEventArgs args)
    {
        args.PreventDefaultAction = true;
        var requestId = ++_managerFilterRequestId;
        var result = await EmployeeService.ListEmployeesAsync(CompanyId, search: args.Text, pageSize: 50);
        if (requestId != _managerFilterRequestId) return;
        _managerOptions = (result?.Items ?? [])
            .Select(e => new ManagerOption(e.Id, $"{e.FirstName} {e.LastName}"))
            .OrderBy(m => m.Name)
            .ToList();
        await _managerDropdown.FilterAsync(_managerOptions, new Syncfusion.Blazor.Data.Query());
    }

    private async Task ApplyAsync()
    {
        await OnFilterChanged.InvokeAsync(BuildFilter());
        await OnCriteriaChanged.InvokeAsync(BuildCriteria());
    }

    private async Task ClearAsync()
    {
        _departmentId = null;
        _locationId = null;
        _positionProfileId = null;
        _managerId = null;
        _employmentTypeId = null;
        _employeeStatus = null;
        _dateRangeStart = null;
        _dateRangeEnd = null;
        await OnFilterChanged.InvokeAsync(BuildFilter());
        await OnCriteriaChanged.InvokeAsync(BuildCriteria());
    }

    public EmployeeDirectoryReportFilter BuildFilter() => new(
        DepartmentId: _departmentId,
        LocationId: _locationId,
        PositionProfileId: _positionProfileId,
        ManagerId: _managerId,
        EmploymentTypeId: _employmentTypeId,
        DateRangeStart: _dateRangeStart,
        DateRangeEnd: _dateRangeEnd,
        EmployeeStatus: _employeeStatus);

    public ReportFilterCriteriaModel BuildCriteria() => new(
        DepartmentId: _departmentId,
        LocationId: _locationId,
        PositionProfileId: _positionProfileId,
        EmploymentTypeId: _employmentTypeId,
        DateRangeStart: _dateRangeStart,
        DateRangeEnd: _dateRangeEnd);
}
