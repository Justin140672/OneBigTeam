@page "/login"
@layout HR.Admin.Web.Components.Layout.LoginLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject DevAuthService DevAuth
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject HR.Admin.Web.Services.AuthHandoffStore HandoffStore

<PageTitle>Sign in — Admin Portal</PageTitle>

<div class="login-card">
    <h1 class="login-heading">Admin Portal sign in</h1>
    <p class="login-subheading">
        Development sign-in only. Enter the email of a platform-admin-allow-listed account.
    </p>

    <EditForm Model="_form" OnValidSubmit="SubmitAsync" FormName="admin-login">
        <DataAnnotationsValidator />

        @if (_error is not null)
        {
            <div class="login-error">@_error</div>
        }

        <div class="login-field">
            <label class="login-label">Email</label>
            <SfTextBox @bind-Value="_form.Email" Placeholder="you@example.com" Type="InputType.Email" />
            <ValidationMessage For="() => _form.Email" class="login-validation" />
        </div>

        <div class="login-field">
            <label class="login-label">Password</label>
            <SfTextBox @bind-Value="_form.Password" Placeholder="password" Type="InputType.Password" />
            <ValidationMessage For="() => _form.Password" class="login-validation" />
        </div>

        <SfButton IsPrimary="true" Type="ButtonType.Submit" Disabled="@_busy" CssClass="login-btn">
            @if (_busy)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            }
            Sign in
        </SfButton>
    </EditForm>
</div>

@code {
    private readonly LoginForm _form = new();
    private string? _error;
    private bool _busy;

    private async Task SubmitAsync()
    {
        _error = null;
        _busy = true;

        var personas = await DevAuth.GetPersonasAsync();
        var match = personas.FirstOrDefault(p =>
            string.Equals(p.Email, _form.Email, StringComparison.OrdinalIgnoreCase));

        if (match is null || _form.Password != "password")
        {
            _error = "Invalid email or password.";
            _busy = false;
            return;
        }

        var session = await DevAuth.SwitchAsync(match.UserId);
        if (session is null)
        {
            _error = "Sign in failed. Please try again.";
            _busy = false;
            return;
        }

        // The Admin Portal is platform-admin-only. A valid account that isn't on the platform-admin
        // allow-list is rejected here, on the login page, rather than being handed a session cookie
        // and bounced through a dashboard it can't use.
        if (!await DevAuth.IsPlatformAdminAsync(session.AccessToken))
        {
            _error = "This account is not authorised for the Admin Portal.";
            _busy = false;
            return;
        }

        // The session is stashed server-side; only an opaque, single-use code travels in the URL.
        var code = HandoffStore.Issue(new AuthHandoffStore.Session(
            session.AccessToken, session.RefreshToken, session.ExpiresIn));
        await JS.InvokeVoidAsync("eval", $"window.location.href='/dev/persona-cookie?code={Uri.EscapeDataString(code)}'");
    }

    private sealed class LoginForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;
    }
}
