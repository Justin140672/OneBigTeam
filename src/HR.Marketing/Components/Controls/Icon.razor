<i class="icon fa-solid @IconClass @CssClass" aria-hidden="true"></i>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public string? CssClass { get; set; }

    // Accept both existing bare names and Font Awesome's copied CSS classes.
    private string IconClass
    {
        get
        {
            var name = (Name ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .FirstOrDefault(part => part is not ("fa" or "fas" or "fa-solid" or "fa-fw"));
            if (string.IsNullOrWhiteSpace(name) || !name.All(c => char.IsAsciiLetterOrDigit(c) || c == '-'))
                return "fa-circle-question";

            return name.StartsWith("fa-", StringComparison.Ordinal) ? name : $"fa-{name}";
        }
    }
}
