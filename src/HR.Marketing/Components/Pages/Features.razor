@page "/features"
@using HR.Marketing.Services

<SeoHead Title="HR Software Features for SMEs | One Big Team"
         Description="Explore HR software for employee management, leave, absence, recruitment, documents, workflows, reminders and reporting." />

<SiteHeader CurrentPage="features" />

<main>
    <section class="pricing-hero section-band">
        <div class="section-inner hero-copy">
            <h1>Everything you need to manage your people in one place.</h1>
            <p class="hero-text">
                Explore every feature included with your subscription.
            </p>
        </div>
    </section>

    <section class="section pricing-section">
        <div class="section-inner section-inner-wide">
            <div class="card-grid">
                @for (var i = 0; i < FeatureCatalog.All.Count; i++)
                {
                    var feature = FeatureCatalog.All[i];
                    <a class="card" href="/features/@feature.Slug">
                        <span class="card-icon" aria-hidden="true"><Icon Name="@feature.IconName" /></span>
                        <h3>@feature.Title</h3>
                        <p>@feature.Summary</p>
                        <span class="card-arrow" aria-hidden="true"><Icon Name="arrow-right" /></span>
                    </a>
                }
            </div>
        </div>
    </section>

    <section id="contact" class="section final-cta">
        <div class="section-inner cta-panel">
            <h2>Start your free trial today. No setup fees. Cancel anytime.</h2>
            <div class="hero-actions">
                <a class="button button-primary button-large" href="/signup">Start free trial</a>
            </div>
        </div>
    </section>
</main>

<SiteFooter />
