@page "/features"
@using HR.Marketing.Services

<PageTitle>Features | One Big Team</PageTitle>
<HeadContent>
    <meta name="description" content="Explore One Big Team features for employee management, leave, absence, recruitment, documents, workflows, reminders and reporting.">
</HeadContent>

<SiteHeader CurrentPage="features" />

<main>
    <section class="pricing-hero section-band">
        <div class="section-inner hero-copy">
            <p class="eyebrow">Features</p>
            <h1>Everything you need to manage your people in one place.</h1>
            <p class="hero-text">
                Explore every feature included with your subscription.
            </p>
        </div>
    </section>

    <section class="section pricing-section">
        <div class="section-inner section-inner-wide">
            <div class="feature-grid">
                @foreach (var feature in FeatureCatalog.All)
                {
                    <a class="feature-card" href="/features/@feature.Slug">
                        <span class="feature-icon" aria-hidden="true"><i class="@feature.IconClass"></i></span>
                        <h3>@feature.Title</h3>
                        <p>@feature.Summary</p>
                        <span class="feature-arrow" aria-hidden="true"><i class="fa-solid fa-arrow-right"></i></span>
                    </a>
                }
            </div>
        </div>
    </section>

    <section id="contact" class="section final-cta">
        <div class="section-inner cta-panel">
            <p class="eyebrow">Ready to simplify HR?</p>
            <h2>Start your free trial today. No setup fees. Cancel anytime.</h2>
            <div class="hero-actions">
                <a class="button button-primary button-large" href="/contact#contact-form">Start free trial</a>
            </div>
        </div>
    </section>
</main>

<SiteFooter />
