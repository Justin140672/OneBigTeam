@using HR.Marketing.Services

<SeoHead Title="@($"{Document.Title} | One Big Team")"
         Description="@Description" />

<SiteHeader />

<main>
  <section class="section-band legal-hero">
    <div class="section-inner">
      <p class="small-note"><a href="/">&larr; Back to home</a></p>
      <h1>@Document.Title</h1>
      @if (!string.IsNullOrWhiteSpace(Document.LastUpdated))
      {
        <p class="legal-updated">Last updated @Document.LastUpdated</p>
      }
    </div>
  </section>

  <section class="section">
    <div class="section-inner legal-layout">
      @if (Document.Headings.Count > 1)
      {
        <nav class="legal-toc" aria-label="On this page">
          <p class="summary-label">On this page</p>
          <ul>
            @foreach (var heading in Document.Headings)
            {
              <li><a href="#@heading.Id">@heading.Text</a></li>
            }
          </ul>
        </nav>
      }

      <div class="legal-content">
        @((MarkupString)Document.Html)
      </div>
    </div>

    @if (RelatedPages.Length > 0)
    {
      <div class="legal-related">
        <p class="summary-label">Related pages</p>
        <ul>
          @foreach (var (href, label) in RelatedPages)
          {
            <li><a href="@href">@label</a></li>
          }
        </ul>
      </div>
    }
  </section>
</main>

<SiteFooter />

@code {
    /// <summary>Documents/{slug}.md filename (without extension) to load and render.</summary>
    [Parameter, EditorRequired] public string DocumentSlug { get; set; } = string.Empty;

    private MarkdownDocument Document { get; set; } = null!;

    // Cross-links between related legal/trust pages, keyed by document slug. Kept as a small
    // static map here rather than parsing it out of markdown, since the relationships are a
    // handful of fixed pairs rather than derived content.
    private static readonly Dictionary<string, (string Href, string Label)[]> RelatedPagesBySlug = new()
    {
        ["privacy-policy"] =
        [
            ("/security", "Security"),
            ("/subprocessors", "Subprocessors"),
            ("/data-processing-agreement", "Data Processing Agreement"),
        ],
        ["security"] =
        [
            ("/privacy-policy", "Privacy Policy"),
            ("/subprocessors", "Subprocessors"),
        ],
        ["subprocessors"] =
        [
            ("/privacy-policy", "Privacy Policy"),
            ("/security", "Security"),
        ],
        ["data-processing-agreement"] =
        [
            ("/privacy-policy", "Privacy Policy"),
            ("/subprocessors", "Subprocessors"),
        ],
        ["terms-of-service"] =
        [
            ("/acceptable-use-policy", "Acceptable Use Policy"),
            ("/privacy-policy", "Privacy Policy"),
        ],
        ["acceptable-use-policy"] =
        [
            ("/terms-of-service", "Terms of Service"),
        ],
        ["cookie-policy"] =
        [
            ("/privacy-policy", "Privacy Policy"),
        ],
    };

    private (string Href, string Label)[] RelatedPages =>
        RelatedPagesBySlug.TryGetValue(DocumentSlug, out var related) ? related : [];

    private string Description => DocumentSlug switch
    {
        "security" => "Learn how One Big Team protects employee and company data with secure access, isolation and operational safeguards.",
        "privacy-policy" => "Read the One Big Team privacy policy and learn how personal information is collected, used, stored and protected.",
        "subprocessors" => "Review the third-party subprocessors One Big Team uses to provide and secure its HR software service.",
        "data-processing-agreement" => "Read the One Big Team Data Processing Agreement covering data protection responsibilities and processing terms.",
        "terms-of-service" => "Read the terms governing access to and use of the One Big Team HR software service.",
        "cookie-policy" => "Learn how One Big Team uses cookies and similar technologies on its website and HR software service.",
        "acceptable-use-policy" => "Read the acceptable use rules for the One Big Team HR software service.",
        _ => $"Read the {Document.Title} for One Big Team."
    };

    protected override void OnInitialized()
    {
        Document = MarkdownDocumentLoader.Load(DocumentSlug);
    }
}
