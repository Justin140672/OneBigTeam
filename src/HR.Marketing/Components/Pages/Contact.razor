@page "/contact"

<PageTitle>Contact | One Big Team</PageTitle>
<HeadContent>
    <meta name="description" content="Contact One Big Team for simple HR software built for small and medium-sized businesses.">
</HeadContent>

<SiteHeader CurrentPage="contact" />

<main>
  <section class="contact-hero section-band">
    <div class="section-inner two-column">
      <div class="hero-copy">
        <h1>Talk to One Big Team about your HR setup.</h1>
      </div>
      <div class="copy-block">
        <p class="hero-text">
          One Big Team is for small and medium-sized businesses looking to manage
          HR, leave, sickness, documents and recruitment in one place. Tell us
          about your organisation and we will help you understand the best next step.
        </p>
        <div class="hero-actions">
          <a class="button button-primary button-large" href="#contact-form">Send a message</a>
          <a class="button button-secondary button-large" href="/signup">Start free trial</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner contact-grid">
      <div>
        <h2>Tell us what you would like to solve.</h2>
        <p class="estimator-intro">
          Use the form to ask a question or share a little context about your team.
          Name, work email and message are required &mdash; everything else is optional.
          We typically respond within one business day.
        </p>
      </div>

      @if (Status == "success")
      {
        <div class="form-status" role="status" aria-live="polite" tabindex="-1" data-form-status data-status="success">
          Thanks for getting in touch. We've received your message and will get back to you shortly.
        </div>
      }
      else
      {
        <form id="contact-form" class="contact-form" method="post" action="/contact-submit" data-contact-form>
          @if (!string.IsNullOrWhiteSpace(ErrorMessage))
          {
            <div class="form-status form-status-error" role="alert" tabindex="-1" data-form-status data-status="error">
              @ErrorMessage
            </div>
          }

          <div class="form-field">
            <label for="contact-name">Name</label>
            <input id="contact-name" name="name" type="text" autocomplete="name" value="@Name" required>
            <p class="field-error" data-error-for="contact-name">Enter your name.</p>
          </div>

          <div class="form-field">
            <label for="work-email">Work email</label>
            <input id="work-email" name="email" type="email" autocomplete="email" value="@Email" required>
            <p class="field-error" data-error-for="work-email">Enter a valid work email.</p>
          </div>

          <div class="form-field">
            <label for="company-name">Company name <span class="field-optional">(optional)</span></label>
            <input id="company-name" name="company" type="text" autocomplete="organization" value="@Company">
          </div>

          <div class="form-field">
            <label for="employee-count-contact">Approximate employee count <span class="field-optional">(optional)</span></label>
            <input
              id="employee-count-contact"
              name="employee-count"
              type="number"
              min="1"
              step="1"
              inputmode="numeric"
              value="@EmployeeCount"
            >
            <p class="field-error" data-error-for="employee-count-contact">Enter an employee count of 1 or more.</p>
          </div>

          <div class="form-field form-field-full">
            <label for="contact-message">Message</label>
            <textarea id="contact-message" name="message" rows="6" required>@Message</textarea>
            <p class="field-error" data-error-for="contact-message">Enter a short message.</p>
          </div>

          <div class="form-field-honeypot" aria-hidden="true">
            <label for="contact-website">Website</label>
            <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true">
          </div>

          <p class="form-privacy-note">
            We only use these details to respond to your enquiry. See our
            <a href="/privacy-policy">privacy policy</a> for how we handle your information.
          </p>

          <div class="form-submit-row">
            <button class="button button-primary button-large" type="submit" data-contact-submit>Send message</button>
          </div>
        </form>
      }
    </div>
  </section>
</main>

<SiteFooter />

@code {
    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorMessage { get; set; }

    [SupplyParameterFromQuery(Name = "name")]
    public string? Name { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "company")]
    public string? Company { get; set; }

    [SupplyParameterFromQuery(Name = "employeeCount")]
    public string? EmployeeCount { get; set; }

    [SupplyParameterFromQuery(Name = "message")]
    public string? Message { get; set; }
}
