@page "/features/{Slug}"
@using HR.Marketing.Services

@if (feature is null)
{
    <SeoHead Title="Feature not found | One Big Team"
             Description="The requested One Big Team feature page could not be found."
             NoIndex="true" />
    <SiteHeader CurrentPage="features" />
    <main>
        <section class="section">
            <div class="section-inner">
                <h1>Feature not found</h1>
                <p>We couldn't find that feature. <a href="/features">Browse all features</a>.</p>
            </div>
        </section>
    </main>
    <SiteFooter />
}
else
{
    <SeoHead Title="@($"{feature.Title} HR Software | One Big Team")"
             Description="@feature.Summary"
             CanonicalPath="@($"/features/{feature.Slug}")" />

    <SiteHeader CurrentPage="features" />

    <main>
        <section class="pricing-hero section-band">
            <div class="section-inner hero-copy">
                <p class="small-note"><a href="/features">&larr; All features</a></p>
                <div class="feature-title-row">
                    <span class="card-icon feature-icon-large" aria-hidden="true"><Icon Name="@feature.IconName" /></span>
                    <h1>@feature.Title</h1>
                </div>
                <p class="hero-text">@feature.Intro</p>
            </div>
        </section>

        <section class="section pricing-section" id="trial">
            <div class="section-inner">
                <div class="feature-detail">
                    <div class="feature-benefit-column">
                        <h2>What it helps you manage</h2>
                        <ul class="feature-benefits">
                            @foreach (var benefit in feature.Benefits)
                            {
                                <li>@benefit</li>
                            }
                        </ul>
                    </div>
                    <VideoCard Title="@feature.Title"
                               YouTubeId="@feature.YouTubeId"
                               Caption="@($"See {feature.Title} in One Big Team.")" />
                </div>
            </div>
        </section>

        @if (relatedFeatures.Count > 0)
        {
            <section class="section section-muted">
                <div class="section-inner">
                    <div class="section-heading">
                        <h2>Related features</h2>
                    </div>
                    <div class="card-grid">
                        @foreach (var related in relatedFeatures)
                        {
                            <a class="card" href="/features/@related.Slug">
                                <span class="card-icon" aria-hidden="true"><Icon Name="@related.IconName" /></span>
                                <h3>@related.Title</h3>
                                <p>@related.Summary</p>
                            </a>
                        }
                    </div>
                </div>
            </section>
        }

        <section id="contact" class="section final-cta">
            <div class="section-inner cta-panel">
                <h2>Start building one simple people workspace for your growing team.</h2>
                <div class="hero-actions">
                    <a class="button button-primary button-large" href="/signup">Start free trial</a>
                </div>
            </div>
        </section>
    </main>

    <SiteFooter />
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private FeatureInfo? feature;
    private List<FeatureInfo> relatedFeatures = [];

    protected override void OnParametersSet()
    {
        FeatureCatalog.TryGet(Slug, out feature);
        if (feature is null && HttpContext is not null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
        }
        relatedFeatures = feature is null
            ? []
            : FeatureCatalog.All.Where(f => f.Slug != feature.Slug).Take(3).ToList();
    }
}
