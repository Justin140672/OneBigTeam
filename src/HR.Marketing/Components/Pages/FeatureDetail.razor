@page "/features/{Slug}"
@using HR.Marketing.Services

@if (feature is null)
{
    <PageTitle>Features | One Big Team</PageTitle>
    <SiteHeader CurrentPage="features" />
    <main>
        <section class="section">
            <div class="section-inner">
                <h1>Feature not found</h1>
                <p>We couldn't find that feature. <a href="/features">Browse all features</a>.</p>
            </div>
        </section>
    </main>
    <SiteFooter />
}
else
{
    <PageTitle>@feature.Title | One Big Team</PageTitle>
    <HeadContent>
        <meta name="description" content="@feature.Summary">
    </HeadContent>

    <SiteHeader CurrentPage="features" />

    <main>
        <section class="pricing-hero section-band">
            <div class="section-inner hero-copy">
                <p class="small-note"><a href="/features">&larr; All features</a></p>
                <div class="feature-title-row">
                    <span class="card-icon feature-icon-large" aria-hidden="true"><Icon Name="@feature.IconName" /></span>
                    <h1>@feature.Title</h1>
                </div>
                <p class="hero-text">@feature.Intro</p>
            </div>
        </section>

        <section class="section pricing-section" id="trial">
            <div class="section-inner">
                <div class="feature-detail">
                    <ul class="feature-benefits">
                        @foreach (var benefit in feature.Benefits)
                        {
                            <li>@benefit</li>
                        }
                    </ul>
                    <VideoCard Title="@feature.Title"
                               YouTubeId="@feature.YouTubeId"
                               Caption="@($"See {feature.Title} in One Big Team.")" />
                </div>
            </div>
        </section>

        <section id="contact" class="section final-cta">
            <div class="section-inner cta-panel">
                <h2>Start building one simple people workspace for your growing team.</h2>
                <div class="hero-actions">
                    <a class="button button-primary button-large" href="/signup">Start free trial</a>
                </div>
            </div>
        </section>
    </main>

    <SiteFooter />
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    private FeatureInfo? feature;

    protected override void OnParametersSet()
    {
        FeatureCatalog.TryGet(Slug, out feature);
    }
}
