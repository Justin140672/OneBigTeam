@page "/pricing"
@using HR.Marketing.Services
@using Microsoft.Extensions.Options
@inject IOptions<PricingOptions> PricingOptionsAccessor
@inject IMarketingAnalytics Analytics

<PageTitle>Pricing | One Big Team</PageTitle>
<HeadContent>
    <meta name="description" content="Only pay for active employees. Every feature included.">
</HeadContent>

<SiteHeader CurrentPage="pricing" />

<main>
    <section class="pricing-hero section-band">
        <div class="section-inner hero-copy">
            <h1>Simple, transparent pricing.</h1>
            <p class="hero-text">
                Only pay for active employees. Every feature included.
                No setup fees • No contracts • Cancel anytime
            </p>
        </div>
    </section>

    <section class="section pricing-section">
        <div class="section-inner pricing-card-grid">
            <div class="pricing-card">
                <p class="summary-label">Pricing Tiers</p>
                <div class="pricing-headline">From &pound;2</div>
                <div class="pricing-headline">per employee</div>

                <p class="tier-list-intro">
                    Pricing is banded: each employee is charged at the rate for their band, not your whole headcount.
                </p>
                <ul class="tier-list">
                    <li>
                        <span>For your 1st-50th employee</span>
                        <strong>&pound;2.00 each</strong>
                    </li>
                    <li>
                        <span>For your 51st-150th employee</span>
                        <strong>&pound;1.75 each</strong>
                    </li>
                    <li>
                        <span>For each employee beyond 150</span>
                        <strong>&pound;1.50 each</strong>
                    </li>
                </ul>

                <div class="minimum-charge-row">
                    <span>Minimum monthly charge</span>
                    <strong>&pound;20.00/month</strong>
                </div>

                <p>All prices exclude VAT where applicable.</p>

                <p class="tier-worked-example">
                    <strong>Worked example (75 employees):</strong>
                    50 &times; &pound;2.00 = &pound;100.00, plus 25 &times; &pound;1.75 = &pound;43.75.
                    Total: &pound;143.75/month (before VAT and any minimum charge adjustment).
                </p>
            </div>

            <form class="estimator-card"
                  id="calculator"
                  method="get"
                  data-pricing-estimator
                  data-large-org-threshold="@PricingOptionsAccessor.Value.LargeOrganisationThreshold">
                <p class="summary-label">Pricing calculator</p>
                <span class="pricing-section">Monthly price</span>

                <div>
                    <div class="pricing-text" data-monthly-price><span>@FormatCurrency(Result.Monthly)/month</span></div>
                </div>
                <div data-effective-price>Equivalent to @FormatCurrency(Result.EffectivePricePerEmployee) per employee</div>
                <div class="sr-only" role="status" aria-live="polite" data-price-live-region></div>

                <label for="employee-count">Active employees</label>
                <div class="employee-input-row">
                    <input id="employee-count"
                           name="employees"
                           type="number"
                           min="0"
                           step="1"
                           inputmode="numeric"
                           value="@DisplayEmployees"
                           aria-describedby="@(ValidationMessage is null ? "employee-count-help" : "employee-count-help employee-count-error")"
                           aria-invalid="@(ValidationMessage is not null)">
                    <label for="employee-slider" class="sr-only">Active employees (slider)</label>
                    <input id="employee-slider"
                           type="range"
                           min="0"
                           max="1000"
                           step="1"
                           value="@DisplayEmployees"
                           aria-describedby="@(ValidationMessage is null ? "employee-count-help" : "employee-count-help employee-count-error")"
                           aria-invalid="@(ValidationMessage is not null)">
                </div>
                <p id="employee-count-help">
                    Move the slider to estimate your monthly cost.
                </p>
                <p id="employee-count-error" class="field-error" role="alert" hidden="@(ValidationMessage is null)">@ValidationMessage</p>

                <noscript>
                    <button class="button button-secondary" type="submit">Recalculate</button>
                </noscript>

                <div class="calculator-cta">
                    <div class="hero-actions" data-cta-standard hidden="@Cta.IsLargeOrganisation">
                        <a class="button button-primary button-large" href="/signup" data-track-cta="start-trial">Start free trial</a>
                    </div>
                    <p class="cta-supporting-message" aria-live="polite" data-cta-standard-message hidden="@Cta.IsLargeOrganisation">
                        No credit card required. Start using One Big Team in minutes.
                    </p>

                    <div class="hero-actions" data-cta-large hidden="@(!Cta.IsLargeOrganisation)">
                        <a class="button button-primary button-large" href="/contact#contact-form" data-track-cta="contact-sales">Contact sales</a>
                    </div>
                    <p class="cta-supporting-message" aria-live="polite" data-cta-large-message hidden="@(!Cta.IsLargeOrganisation)">
                        Our team will help you set up a custom plan for your organisation.
                    </p>
                </div>

                <p class="small-note">
                    Estimate updates instantly as you type. Billing and payment details are
                    handled inside One Big Team.
                </p>
            </form>
        </div>
    </section>

    <section class="section section-muted">
        <div class="section-inner">
            <div class="section-heading">
                <h2>See how the price scales with your team.</h2>
            </div>

            <div class="pricing-examples-table">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Active employees</th>
                            <th scope="col">Monthly cost</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var example in Examples)
                        {
                            <tr>
                                <td>@example.Employees</td>
                                <td>@FormatCurrency(example.Monthly)@(example.Employees == 10 ? " (minimum charge)" : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="pricing-examples-cards">
                    @foreach (var example in Examples)
                    {
                        <div class="pricing-example-card">
                            <span>@example.Employees employees</span>
                            <strong>@FormatCurrency(example.Monthly)@(example.Employees == 10 ? " (minimum charge)" : "")</strong>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="section-inner">
            <div class="section-heading">
                <h2>Everything included.</h2>
            </div>

            <div class="card-grid included-feature-grid">
                @foreach (var feature in IncludedFeatures)
                {
                    <article class="card">
                        <h3>@feature</h3>
                    </article>
                }
            </div>
        </div>
    </section>

    <section class="section section-muted">
        <div class="section-inner">
            <div class="section-heading">
                <h2>Pricing that grows with your business.</h2>
            </div>

            <div class="benefit-grid">
                <div>
                    <strong>Fair pricing</strong>
                    <p>You only pay for active employees.</p>
                </div>
                <div>
                    <strong>Rewarding growth</strong>
                    <p>The cost per employee decreases as your company grows.</p>
                </div>
                <div>
                    <strong>No feature limits</strong>
                    <p>Every customer receives every feature.</p>
                </div>
                <div>
                    <strong>Simple billing</strong>
                    <p>No contracts. No setup fees. No surprise charges.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="section faq-section">
        <div class="section-inner faq-grid">
            <div>
                <h2>Pricing questions, answered simply.</h2>
            </div>

            <div class="faq-list">
                <details>
                    <summary>How do the pricing tiers work?</summary>
                    <p>
                        Pricing is banded, not flat-rate. Your first 50 employees cost &pound;2.00 each, your
                        next 100 employees (51-150) cost &pound;1.75 each, and each employee beyond 150 costs
                        &pound;1.50 each. Only the employees within a band are charged at that band's rate -
                        for example, a 75-employee organisation pays &pound;100.00 for the first 50 plus
                        &pound;43.75 for the next 25, totalling &pound;143.75/month before VAT.
                    </p>
                </details>
                <details>
                    <summary>Who counts as an active employee?</summary>
                    <p>Employees whose employment has started and who have not left the company.</p>
                </details>
                <details>
                    <summary>Are future starters billed?</summary>
                    <p>No. Employees are billed from their employment start date.</p>
                </details>
                <details>
                    <summary>Are former employees billed?</summary>
                    <p>No. Employees leaving your organisation stop being counted once they are no longer active.</p>
                </details>
                <details>
                    <summary>Are all features included?</summary>
                    <p>Yes. Every customer has access to every feature regardless of company size.</p>
                </details>
                <details>
                    <summary>Is there a minimum contract?</summary>
                    <p>No. You can cancel at any time.</p>
                </details>
                <details>
                    <summary>Is there a free trial?</summary>
                    <p>Yes. Start your free trial without speaking to sales.</p>
                </details>
                <details>
                    <summary>Do I pay for inactive users?</summary>
                    <p>No. Billing is based on active employees, not user accounts.</p>
                </details>
            </div>
        </div>
    </section>

    <section id="contact" class="section final-cta">
        <div class="section-inner cta-panel">
            <h2>Start your free trial today.</h2>
            <div class="hero-actions">
                <a class="button button-primary button-large" href="/signup">Start free trial</a>
                <a class="button button-secondary button-large" href="/#watch">Watch the product video</a>
            </div>
        </div>
    </section>
</main>

<SiteFooter />

@code {
    [SupplyParameterFromQuery(Name = "employees")]
    public string? EmployeesQuery { get; set; }

    private int DisplayEmployees;
    private string? ValidationMessage;

    protected override void OnInitialized()
    {
        var parsed = EmployeeCountInputParser.Parse(EmployeesQuery, fallback: 75);
        DisplayEmployees = EmployeesQuery is null ? 75 : parsed.Value;
        ValidationMessage = parsed.ValidationMessage;

        Analytics.TrackPricingCalculatorViewed();
        Analytics.TrackEmployeeCountChanged(DisplayEmployees, Result.Monthly, Cta.PrimaryLabel);
    }

    private PricingResult Result => PricingCalculator.Calculate(DisplayEmployees);

    private PricingCtaResult Cta => PricingCtaResolver.Resolve(DisplayEmployees, PricingOptionsAccessor.Value.LargeOrganisationThreshold);

    private static readonly (int Employees, decimal Monthly)[] Examples =
    [
        (10, PricingCalculator.Calculate(10).Monthly),
        (25, PricingCalculator.Calculate(25).Monthly),
        (50, PricingCalculator.Calculate(50).Monthly),
        (75, PricingCalculator.Calculate(75).Monthly),
        (100, PricingCalculator.Calculate(100).Monthly),
        (150, PricingCalculator.Calculate(150).Monthly),
        (250, PricingCalculator.Calculate(250).Monthly),
    ];

    private static readonly string[] IncludedFeatures =
    [
        "Employee Management",
        "Leave Management",
        "Recruitment",
        "Onboarding/Offboarding",
        "Documents",
        "Employee Assets",
        "Reporting",
        "HR Workflows",
        "Unlimited Users",
        "Free Upgrades"
    ];

    private static string FormatCurrency(decimal amount) => $"£{amount:0.00}";
}
