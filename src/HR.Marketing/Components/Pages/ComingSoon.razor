@page "/roadmap"
@using HR.Marketing.Services
@inject MarketingContentService MarketingContent

<SeoHead Title="HR Software Product Roadmap | One Big Team"
         Description="See what's coming next to One Big Team, including performance reviews, training, qualifications, integrations and AI assistance." />

<SiteHeader CurrentPage="roadmap" />

    <main>
        <section class="pricing-hero section-band">
            <div class="section-inner hero-copy">
                <h1>Product Roadmap</h1>
                <p class="hero-text">
                    We're continually improving One Big Team. Here's a look at some of the problems
                    we're working on solving next.
                </p>
            </div>
        </section>

        @foreach (var group in groups)
        {
            <section class="section">
                <div class="section-inner">
                    <div class="section-heading">
                        <h2>@group.Label</h2>
                    </div>
                    <div class="card-grid">
                        @foreach (var item in group.Items)
                        {
                            <div class="card">
                                <span class="card-icon" aria-hidden="true"><Icon Name="@item.IconName" /></span>
                                <h3>@item.Title</h3>
                                <p>@item.Description</p>
                            </div>
                        }
                    </div>
                </div>
            </section>
        }

        <section class="section roadmap-disclaimer-section">
            <div class="section-inner">
                <p class="roadmap-disclaimer">
                    This roadmap reflects our current thinking and priorities. Plans may change, and
                    nothing here is a commitment to a specific feature or delivery date.
                </p>
            </div>
        </section>
    </main>

<SiteFooter />

@code {
    private IReadOnlyList<RoadmapGroup> groups = [];

    protected override async Task OnInitializedAsync()
    {
        var content = await MarketingContent.GetContentAsync();
        var upcoming = content.Roadmap
            .Where(item => !string.Equals(item.DeliveryStatus, "Available", StringComparison.OrdinalIgnoreCase))
            .ToList();
        groups = upcoming.Count > 0
            ? [new RoadmapGroup("Coming soon", upcoming)]
            : [];
    }

    private sealed record RoadmapGroup(string Label, IReadOnlyList<MarketingRoadmapContent> Items);
}
