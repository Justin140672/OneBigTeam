@page "/roadmap"
@using HR.Marketing.Services

<SeoHead Title="HR Software Product Roadmap | One Big Team"
         Description="See what's coming next to One Big Team, including AI-powered position profiles, employee webhooks and an AI help assistant." />

<SiteHeader CurrentPage="roadmap" />

    <main>
        <section class="pricing-hero section-band">
            <div class="section-inner hero-copy">
                <h1>Product Roadmap</h1>
                <p class="hero-text">
                    We're continually improving One Big Team. Here's a look at some of the problems
                    we're working on solving next.
                </p>
            </div>
        </section>

        <section class="section">
            <div class="section-inner">
                <div class="section-heading">
                    <h2>Coming soon</h2>
                </div>
                <div class="card-grid">
                    @foreach (var feature in ComingSoonFeatures)
                    {
                        <div class="card">
                            <span class="card-icon" aria-hidden="true"><Icon Name="@feature.IconName" /></span>
                            <h3>@feature.Title</h3>
                            <p>@feature.Description</p>
                        </div>
                    }
                </div>
            </div>
        </section>

        <section class="section roadmap-disclaimer-section">
            <div class="section-inner">
                <p class="roadmap-disclaimer">
                    This roadmap reflects our current thinking and priorities. Plans may change, and
                    nothing here is a commitment to a specific feature or delivery date.
                </p>
            </div>
        </section>
    </main>

<SiteFooter />

@code {
    private static readonly IReadOnlyList<UpcomingFeatureInfo> ComingSoonFeatures =
        UpcomingFeatureCatalog.All
            .Where(feature => feature.Status == UpcomingFeatureStatus.ComingSoon)
            .ToList();
}
