@inject NavigationManager Navigation
@inject IConfiguration Configuration

<header class="site-header">
  <a class="brand" href="/" aria-label="One Big Team home">
    <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
      <rect x="1" y="1" width="30" height="30" rx="9" fill="var(--color-accent-strong)" />
      <path d="M9 20V12.6L16 9l7 3.6V20l-7 3.4-7-3.4Z" fill="none" stroke="var(--color-on-accent)" stroke-width="1.8" stroke-linejoin="round" />
      <path d="M9 12.6 16 16l7-3.4" fill="none" stroke="var(--color-on-accent)" stroke-width="1.8" stroke-linejoin="round" />
      <path d="M16 16v7.4" fill="none" stroke="var(--color-on-accent)" stroke-width="1.8" />
    </svg>
    <span class="brand-word">One Big Team</span>
  </a>

  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">
    <span class="sr-only">Open navigation</span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>

  <nav id="site-navigation" class="site-nav" aria-label="Primary navigation">
    <a href="/" aria-current="@(CurrentPage == "home" ? "page" : null)">Home</a>
    <a href="/features" aria-current="@(CurrentPage == "features" ? "page" : null)">Features</a>
    <a href="/pricing" aria-current="@(CurrentPage == "pricing" ? "page" : null)">Pricing</a>
    <a href="/#about">About</a>
    <a href="/contact" aria-current="@(CurrentPage == "contact" ? "page" : null)">Contact</a>
  </nav>

  <div class="header-actions">
    <a class="login-link" href="@LoginHref">Log in</a>
    <a class="button button-primary" href="@TrialHref">Start free trial</a>
  </div>
</header>

@code {
    /// <summary>Set by each page to highlight the matching nav link via aria-current="page".</summary>
    [Parameter] public string? CurrentPage { get; set; }

    /// <summary>
    /// "Start free trial" links to the real self-service signup page; the SignUp page itself
    /// still exposes its own in-page form (no anchor jump needed since it *is* the destination).
    /// </summary>
    private string TrialHref => CurrentPage == "signup" ? "#" : "/signup";

    private const string FallbackWebAppBaseUrl = "http://localhost:5157";

    private string LoginHref
    {
        get
        {
            var baseUrl =
                Configuration["services:web:https:0"] ??
                Configuration["services:web:http:0"] ??
                FallbackWebAppBaseUrl;

            return $"{baseUrl.TrimEnd('/')}/login";
        }
    }
}
