<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\HR.SharedKernel\HR.SharedKernel.csproj" />
    <ProjectReference Include="..\HR.Modules.Employees.Contracts\HR.Modules.Employees.Contracts.csproj" />
    <ProjectReference Include="..\..\Infrastructure\HR.Infrastructure.Abstractions\HR.Infrastructure.Abstractions.csproj" />
    <ProjectReference Include="..\HR.Modules.Companies.Contracts\HR.Modules.Companies.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FastEndpoints" />
    <PackageReference Include="Hangfire.Core" />
