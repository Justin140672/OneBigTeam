<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\HR.SharedKernel\HR.SharedKernel.csproj" />
    <ProjectReference Include="..\HR.Infrastructure.Abstractions\HR.Infrastructure.Abstractions.csproj" />
    <!-- Security review ticket 6 (P2): reuse the same readiness detail-token gate
         (HealthCheckEndpoints.HasDetailAccess) that already protects /health/ready's detail for the
         /health/background-jobs endpoint mapped below. HR.ServiceDefaults is shared cross-cutting
         infrastructure (not a business module), so this is not a module boundary violation. -->
    <ProjectReference Include="..\..\HR.ServiceDefaults\HR.ServiceDefaults.csproj" />
    <!-- CompanyTimeProvider needs ICompanyTimeZoneReader from Companies module -->
    <ProjectReference Include="..\..\Modules\HR.Modules.Companies.Contracts\HR.Modules.Companies.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HR.Integration.Tests" />
    <InternalsVisibleTo Include="HR.Infrastructure.Tests" />
    <InternalsVisibleTo Include="HR.Modules.Reporting.Tests" />
    <InternalsVisibleTo Include="HR.Architecture.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only used by Security/SupportSessionTokenIssuer to mint the distinctly-signed, short-lived
         "Login as Customer" support-session token (never a real Supabase-issued JWT). -->
