<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Ticket 2: base-code optimistic-concurrency save helper (EF Core) and Result-&gt;IResult
         translator (ASP.NET Core). Kept here so there is one implementation, not one per module. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!-- Ticket 3 (P1) follow-up: relational mapping APIs (ToTable, HasColumnType) for the shared
         idempotency-record configuration. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- Ticket 2 item 3: shared FluentValidation rule requiring a loaded concurrency version
         on every protected update request. -->
    <PackageReference Include="FluentValidation" />
    <!-- Ticket 3 (P1) follow-up item 4: IdempotencyKeyHeaderValidator is a FastEndpoints global
         pre-processor. -->
    <PackageReference Include="FastEndpoints" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HR.SharedKernel.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Update="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Newtonsoft.Json">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
